// C interop: header import, hand-written declarations, exporting a C ABI.
// This file lives in a package listed under [trust] in the root manifest.

use c "sqlite3.h" with { link = "sqlite3" } as sqlite   // declarations generated by the compiler
use std.ffi.{c_int, c_char, CStr, ptr}

// A thin safe wrapper. Everything unsafe is here; callers get a capability-taking API.
struct Database {
    handle: ptr mut sqlite.sqlite3
}

error DbError { OpenFailed { code: int }, QueryFailed { message: String } }

impl Database {
    // Opening a file is I/O, so the safe API takes Fs even though the C code bypasses it;
    // the capability documents the intent and lets tests substitute an in-memory path.
    fn open(fs: Fs, path: Path) -> Database ! DbError {
        let cpath = CStr.from(fs.resolve(path))
        var handle: ptr mut sqlite.sqlite3 = ptr.null()
        let rc = unsafe { sqlite.sqlite3_open(cpath.as_ptr(), ptr.addr_of(mut handle)) }
        if rc != sqlite.SQLITE_OK { return Err(OpenFailed { code: rc.into() }) }
        Ok(Database { handle })
    }
}

impl Drop for Database {
    fn drop(mut self) {
        unsafe { sqlite.sqlite3_close(self.handle) }
    }
}

// Hand-written declaration when no header is available.
extern "C" {
    @blocking                                   // the scheduler moves this call off task threads
    fn compute_heavy(data: ptr[u8], len: c_size) -> c_int
}

// Exporting to C. Types at the boundary must be C-representable.
@repr(c)
struct Pair { a: i32, b: i32 }

@export("sisu_sum_pair")
fn sum_pair(p: Pair) -> i32 { p.a +% p.b }

@export("sisu_checksum")
fn checksum(data: ptr[u8], len: c_size) -> u32 {
    let slice = unsafe { Slice.from_raw(data, len.into()) }
    slice.iter().fold(0u32) { acc, b -> acc *% 31 +% b.into() }
}
