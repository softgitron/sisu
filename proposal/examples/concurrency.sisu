// Structured, colourless concurrency.

use std.task.{scope, channel, select, Mutex}
use std.cap.{Net, Clock}

// Fan out, join all, first error cancels the rest.
fn fetch_all(net: Net, urls: List[Url]) -> List[Bytes] ! HttpError {
    scope { s ->
        let handles = urls.iter().map { url -> s.spawn { net.get(url) } }.collect[List]()
        var out = List.with_capacity(handles.len())
        for h in handles { out.push(h.join()?) }        // ? on a task failure cancels siblings
        Ok(out)
    }
}

// A worker pool over a bounded channel. No goroutine leaks: the scope joins.
fn process_jobs(jobs: List[Job], workers: int) -> List[Outcome] {
    let (tx, rx) = channel[Job](capacity: 32)
    let results = Mutex.new(List.new())
    scope { s ->
        for _ in 0..workers {
            s.spawn {
                for job in rx {                           // ends when tx is closed and drained
                    let outcome = handle(job)
                    results.lock().push(outcome)
                }
            }
        }
        for j in jobs { tx.send(j).expect("workers outlive the sender") }
        tx.close()
    }
    results.into_inner()
}

// Timeouts and cancellation are structural.
fn fetch_with_timeout(net: Net, clock: Clock, url: Url) -> Bytes ! { HttpError, Timeout } {
    scope { s ->
        let h = s.spawn { net.get(url) }
        select {
            r = h.join() -> r?
            _ = clock.after(5.s) -> { s.cancel(); Err(Timeout) }
        }
    }
}

// Supervision: restart a worker that panics, stop on cancellation.
fn supervise(net: Net, port: int) {
    scope { s ->
        loop {
            let worker = s.spawn { serve(net, port) }
            match worker.join() {
                Err(TaskPanicked { message, trace }) -> {
                    log.error("server crashed: {message}\n{trace}; restarting")
                }
                Err(Cancelled) -> break
                Ok(()) -> break
            }
        }
    }
}

// What the type system refuses.
fn refused() {
    var counter = 0
    scope { s ->
        // s.spawn { counter += 1 }
        // error[E0412]: `counter` is modified by a task while borrowed by another
        //   help: wrap it: `let counter = Mutex.new(0)` or `Atomic.new(0)`
        s.spawn { println(counter) }                      // reading a shared borrow is fine
    }

    let cell = Cell.new(0)
    scope { s ->
        // s.spawn { cell.set(1) }
        // error[E0413]: `Cell[int]` is not Sync and cannot be shared between tasks
        //   help: use `Mutex[int]` for shared mutation, or move the value with `own { }`
    }
}

// Generators are lazy iterators compiled to state machines; no runtime needed.
gen fn primes() -> Iter[int] {
    var found = List.new()
    var n = 2
    loop {
        if found.iter().all { p -> n % p != 0 } {
            found.push(n)
            yield n
        }
        n += 1
    }
}

fn gen_demo() {
    for p in primes().take(10) { println(p) }
}
