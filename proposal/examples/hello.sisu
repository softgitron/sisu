# The simplest program. Standard output needs no capability.
def main():
    print("Hei, maailma!")

# A program that touches the world receives `System`, the root of all
# capabilities, and can return an error set. A returned error is printed
# and becomes a non-zero exit status.
def main_with_capabilities(sys: System) -> ! IoError:
    let now = sys.clock.now()
    let name = sys.env.get("USER") ?? "stranger"
    print("Hello, {name}. It is {now:%H:%M}.")
    sys.fs.write_text("greeted.txt", "{name} at {now}")?
    return Ok(())
