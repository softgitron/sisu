# Compile-time evaluation, reflection, derive, checked string DSLs.

# An ordinary function, evaluated at compile time because `const` demands it.
def crc32_table() -> Array[u32, 256]:
    var t = Array.filled(0u32)
    for i in range(256):
        var c = i.to[u32]()
        for _ in range(8):
            c = if c & 1 == 1: 0xEDB88320 ^ (c >> 1) else: c >> 1
        t[i] = c
    return t

const CRC_TABLE: Array[u32, 256] = comptime crc32_table()

# A comptime-only check inside a generic type.
struct RingBuffer[T, const N: int]:
    items: Array[T?, N]
    head: int
    len: int

    def new() -> Self:
        comptime assert N > 0 and N & (N - 1) == 0, "capacity {N} must be a power of two"
        return Self(items=Array.filled(None), head=0, len=0)

# Reflection: a generic JSON encoder with no macro.
def to_json[T](value: T) -> String:
    if comptime reflect.is_int(T) or reflect.is_float(T):
        return "{value}"
    elif comptime reflect.is_str(T):
        return json.quote(value)
    elif comptime reflect.is_list(T):
        return "[" + value.iter().map(to_json(it)).join(",") + "]"
    elif comptime reflect.is_struct(T):
        var out = String("{")
        comptime for i, f in enumerate(reflect.fields_of(T)):
            if i > 0:
                out.push(",")
            out.push("{json.quote(f.name)}:{to_json(value.[f])}")
        out.push("}")
        return out
    else:
        comptime error("to_json: unsupported type {reflect.name_of(T)}")

# A user-defined derive: any trait can provide one.
trait Describe:
    def describe(self) -> String

    comptime def derive(T: type) -> impl Describe for T:
        impl Describe for T:
            def describe(self) -> String:
                var parts = list()
                comptime for f in reflect.fields_of(T):
                    parts.push("{f.name}={self.[f]:?}")
                return "{reflect.name_of(T)}({parts.join(", ")})"

@derive(Describe, Debug)
struct Point:
    x: int
    y: int

# A checked string DSL: the SQL is parsed at compile time, errors point into
# the literal, and the result is a typed query object. No new syntax needed.
const FIND_USER = sql.query("SELECT id, name FROM users WHERE age > {min_age:int}")

def find(db: Db) -> list[(int, String)] ! DbError:
    return db.run(FIND_USER, min_age=18)     # parameter names and types come from the literal

# Conditional compilation: both branches must type-check.
def page_size() -> int:
    return if comptime target.os == "windows": 65536 else: 4096

@cfg(test)
def test_helper() -> Point:
    return Point(x=1, y=2)

test "derive describes fields":
    assert test_helper().describe() == "Point(x=1, y=2)"
