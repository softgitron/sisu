import render

@cfg(feature="fast")
def mode() -> String:
    return "fast"

@cfg(not any(feature="fast"))
def mode() -> String:
    return "careful"

@cfg(feature="verbose")
def report():
    print("verbose")

@cfg(not any(feature="verbose"))
def report():
    print("quiet")

def main():
    print(mode())
    report()
    print(render.show("hello"))
    print(render.features())
