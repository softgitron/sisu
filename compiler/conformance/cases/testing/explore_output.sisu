# explore 20
# Under `--explore N` a test that fails under one of the seeds shows what
# that run printed, the lines that go with its failure, not those of the
# first seed's run, which passed (decision 386; the manual's G14).

test "the second task's value arrives first":
    let (tx, rx) = channel[int](2)
    task.scope do s:
        let one = tx.copy()
        let two = tx.copy()
        s.spawn(own () -> one.send(1))
        s.spawn(own () -> two.send(2))
    let first = rx.recv().or(0)
    print("first came {first}")
    assert first == 2
