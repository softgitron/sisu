# Tests run in parallel, each in an interpreter of its own (17,
# "Isolation and parallelism"), the ones that take the real `System` one
# at a time after the others; each test's output is held and written in
# declaration order, so the run prints the same on any number of threads
# (the runner checks `--jobs 1` against it).

def busy(n: int) -> int:
    var total = 0
    for i in range(0, n):
        total += i % 7
    return total

test "first, slow":
    print("first starts")
    assert busy(20000) > 0
    print("first ends")

test "second, quick":
    print("second")

test "third fails":
    print("third")
    assert busy(10) == 0

test "fourth takes the real System"(sys: System):
    print("fourth sees {len(sys.env.args())} arguments")

test "fifth, quick":
    print("fifth")
