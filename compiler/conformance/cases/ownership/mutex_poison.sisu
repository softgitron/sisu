# D-077: when unwinding drops a guard, the value's `invariant` is checked
# again; a broken one poisons the mutex, and a `Drop` that runs later in
# the unwinding sees it.

struct Account:
    balance: int
    limit: int
    invariant self.balance >= -self.limit

struct Auditor:
    accounts: Shared[Mutex[Account]]

impl Drop for Auditor:
    def drop(mut self):
        print("poisoned: {self.accounts.is_poisoned()}")

def withdraw(m: Shared[Mutex[Account]], amount: int):
    var g = m.lock()
    g.value.balance -= amount
    if g.value.balance < 0:
        panic("overdrawn by {-g.value.balance}")

def main():
    let m = Shared(Mutex(Account(balance=10, limit=5)))
    let auditor = Auditor(accounts=m.copy())
    withdraw(m, 3)
    print(m.lock().value.balance)
    withdraw(m, 100)
