# Results that borrow from borrowed parameters: a borrow returned on one
# path does not block the other path (the third case of non-lexical
# lifetimes), iterating a borrowed list returns borrows of its elements,
# a closure that only reads may be passed to a method of a `mut`
# parameter, and an optional chain through a reference borrows.

def get_or_insert(mut d: dict[String, int], k: str) -> ref int from d:
    if k in d:
        return ref d[k.to_string()]
    d[k.to_string()] = 0
    return ref d[k.to_string()]

def first_even(xs: list[int]) -> ref int?:
    for x in xs:
        if x % 2 == 0:
            return Some(x)
    return None

def sort_down(mut words: list[str]):
    let down = True
    words.sort_by((a, b) -> if down: b.cmp(a) else: a.cmp(b))

struct User:
    name: String
    age: int

def oldest(users: list[User]) -> ref User?:
    return users.iter().max_by(it.age)

def main():
    var d: dict[String, int] = {}
    d["b".to_string()] = 5
    print(get_or_insert(mut d, "a"))
    print(get_or_insert(mut d, "b"))
    print(d)
    let xs = [1, 3, 4, 6]
    print(first_even(xs) ?? 0)
    var words = ["b", "c", "a"]
    sort_down(mut words)
    print(words)
    let team = [User(name="Aino".to_string(), age=27), User(name="Eero".to_string(), age=45)]
    let eldest = oldest(team)
    print(eldest?.name ?? "nobody")
