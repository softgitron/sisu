# The checker does not tell list elements apart: a borrow of `xs[0]` holds
# all of `xs` for the rules, so the assignment to `xs[1]` is rejected
# although it changes another element (a known over-rejection,
# docs/architecture.md). The counterexample mode runs it anyway and
# reaches no conflict: a candidate false positive.

def main():
    var xs = [1, 2, 3]
    let first = ref xs[0]
    xs[1] = 20
    print(first)
    print(xs)
