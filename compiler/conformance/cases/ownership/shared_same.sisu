# `Shared.same(a, b)` (02, "Expressions and statements"; decision 355): the
# identity of shared values, where `==` compares the values they own. A
# copy of a `Shared` is another owner of the same value; a `Weak` made
# into an owner again is the same value too.

@derive(Eq, Debug)
struct Note:
    text: String

def main():
    let a = Shared.new(Note(text="sauna"))
    let b = a.copy()
    let c = Shared.new(Note(text="sauna"))
    print(Shared.same(a, b))
    print(Shared.same(a, c))
    print(a.text == c.text)
    let w = Shared.downgrade(a)
    match w.upgrade():
        case Some(d):
            print(Shared.same(d, b))
        case None:
            print("gone")
    let owners = [a.copy(), c.copy(), b.copy()]
    var same_as_a = 0
    for s in owners:
        if Shared.same(s, a):
            same_as_a += 1
    print(same_as_a)
