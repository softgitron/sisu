def main():
    print(7 // 2)
    print(-7 // 2)
    print(7 % 3)
    print(-7 % 3)
    print(7 % -3)
    print(2 ** 10)
    print(7.0 / 2.0)
    print(-7.5 % 2.0)
    print(1.0 / 3.0)
    print(0.1 + 0.2)
    print(1e100)
    print(9223372036854775807 +% 1)
    print(9223372036854775807 +| 1)
    print(-9223372036854775807 -| 10)
    print(6 & 3)
    print(6 | 3)
    print(6 ^ 3)
    print(1 << 10)
    print(-16 >> 2)
    print(~0)
    print(1 < 2 < 3)
    print(3 > 2 > 2)
    print(abs(-5))
    print(min(3, 4))
    print(max("pear", "apple"))
    print((2.0).sqrt())
    print((3.7.floor(), 3.2.ceil(), 2.5.round(), (-2.5).round()))
    print((3.99).truncate_to_int())
    print(5.to_f64())
