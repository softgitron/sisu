def main():
    let xs = [5, 2, 8, 1, 9, 3]
    print(xs.iter().map(it * 10).collect())
    print(xs.iter().filter(it > 4).map(it.copy()).collect())
    print(range(100).skip(10).take(3).collect())
    print(range(5).enumerate().collect())
    print(xs.iter().count())
    print(xs.iter().fold(0, (acc, x) -> acc + x))
    print(range(1, 6).fold(1, (acc, x) -> acc * x))
    print(xs.iter().any(it > 8))
    print(xs.iter().all(it > 0))
    print(xs.iter().find(it > 6) ?? 0)
    print(xs.iter().max_by(it) ?? 0)
    print(xs.iter().min_by(it) ?? 0)
    print(sum(xs))
    print(sum([0.5, 0.25, 0.125]))
    print(sorted(xs))
    print(sorted(["pear", "apple", "fig"]))
    print(any([False, True]))
    print(all([True, False]))
    print(zip_shortest([1, 2, 3], ["a"]).collect())
    let words = "the cat sat on the mat".split_whitespace().collect()
    print(words)
    let lengths = [len(w) for w in words]
    print(lengths)
    let pairs = [(i, w) for i, w in enumerate(words) if i % 2 == 0]
    print(pairs)
    let nested = [x * y for x in range(1, 3) for y in range(1, 4)]
    print(nested)
    var it_count = 0
    for c in "héllo".chars():
        it_count += 1
    print(it_count)
