def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def depth(n: int) -> int:
    if n == 0:
        return 0
    return depth(n - 1) + 1

def is_even(n: int) -> bool:
    if n == 0:
        return True
    return is_odd(n - 1)

def is_odd(n: int) -> bool:
    if n == 0:
        return False
    return is_even(n - 1)

def main():
    print(fib(20))
    print(depth(50000))
    print(is_even(1001))
