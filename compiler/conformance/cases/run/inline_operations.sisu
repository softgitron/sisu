# The operations the native backend compiles inline (decision 253), at
# their edges: each must do what the interpreter does. The loops' ranges
# and borrowed lists keep their iterators in the frame.

@derive(Eq, Copy)
enum Kind:
    A
    B
    C

@derive(Eq)
enum Element:
    Node(int)
    Leaf(int)
    Pair(int, Kind)
    Named(String)
    Empty

@derive(Eq)
enum Wrap[T]:
    One(T)
    Nothing

pure def mark(b: bool) -> str:
    return if b: "T" else: "F"

def equalities():
    let k = Kind.B
    var line = "".to_string()
    for x in [Kind.A, Kind.B, Kind.C]:
        line += mark(x == k) + mark(x != k) + mark(ref x == ref k)
    print(line)
    let elements = [
        Element.Node(1),
        Element.Node(2),
        Element.Leaf(1),
        Element.Pair(1, Kind.A),
        Element.Pair(1, Kind.B),
        Element.Named("a"),
        Element.Named("b"),
        Element.Empty,
    ]
    var out = "".to_string()
    for x in elements:
        for y in elements:
            out += mark(x == y)
        out += " "
    print(out)
    var different = "".to_string()
    for x in elements:
        different += mark(x != Element.Node(2))
    print(different)
    let numbers: list[int?] = [Some(1), Some(2), None]
    out = "".to_string()
    for x in numbers:
        for y in numbers:
            out += mark(x == y) + mark(x != y)
        out += " "
    print(out)
    let texts: list[String?] = [Some("x"), Some("y"), None]
    out = "".to_string()
    for x in texts:
        for y in texts:
            out += mark(x == y)
        out += " "
    print(out)
    let wrapped = [Wrap.One(Kind.A), Wrap.One(Kind.C), Wrap.Nothing]
    out = "".to_string()
    for x in wrapped:
        for y in wrapped:
            out += mark(x == y)
        out += " "
    print(out)
    let a = "hello"
    let b = "hel" + "lo"
    let c = "help!"
    let r = ref b
    print(
        mark(a == b)
            + mark(a != b)
            + mark(a == c)
            + mark(b != c)
            + mark("" == "")
            + mark(r == "hello")
            + mark(a == "hell")
    )

def lists():
    var xs: list[int] = []
    print("{len(xs)} {xs.is_empty()} {xs.first()} {xs.last()} {xs.pop()}")
    for i in range(20):
        xs.push(i * i)
    print("{len(xs)} {xs.is_empty()} {xs.first()} {xs.last()}")
    var popped = 0
    while let Some(x) = xs.pop():
        popped += x
    print("{popped} {len(xs)} {xs.pop()}")
    var names = ["a".to_string(), "b".to_string()]
    names.push("c".to_string())
    print("{names.first()} {names.last()} {names.pop()} {len(names)}")

def text():
    let s = "héllo"
    var codes: list[u8] = []
    for i in range(s.byte_len()):
        codes.push(s.byte_at(i))
    print("{s.byte_len()} {codes}")
    var total = 0
    for ch in s.chars():
        total += ch.code()
    print(total)

def ranges():
    let top = 9223372036854775807
    var seen: list[int] = []
    for i in range(top - 2, top):
        seen.push(top - i)
    for i in range(top - 5, top, 2):
        seen.push(top - i)
    for i in range(-top + 2, -top - 1, -1):
        seen.push(i + top)
    for i in range(3, 3):
        seen.push(i)
    for i in range(10, 0, -4):
        seen.push(i)
    print(seen)
    let xs = [5, 6, 7]
    var sum = 0
    for x in ref xs:
        sum += x
    for x in ref xs:
        for y in ref xs:
            sum += x * y
    print(sum)

def characters():
    let s = "héllo wörld"
    print(
        [
            s.byte_slice(0, 1),
            s.byte_slice(1, 3),
            s.byte_slice(0, 0),
            s.byte_slice(13, 13),
            s.byte_slice(7, 13),
        ]
    )
    print("".byte_slice(0, 0).byte_len())
    var n = 0
    for c in "a \t\n\u{0b}\u{0c}\rbZ9é\u{85}\u{3000}_".chars():
        n = n * 3 + (if c.is_whitespace(): 1 else: 0) + (if c.is_alphabetic(): 2 else: 0)
    print(n)
    print((char.from_code(65), char.from_code(-1), char.from_code(55296), char.from_code(57343)))
    print(
        (
            char.from_code(57344),
            char.from_code(1114111),
            char.from_code(1114112),
            char.from_code(55295),
        )
    )
    print((max(3, 9), min(3, 9), max(-5, -5), min(-7, 2)))

def sized(a: u8, b: u8, c: i8, d: u64, e: u64):
    print((a ^ b, a & b, a | b, ~c, ~a))
    print((a.to_int(), c.to_int(), d.to_int(), a.cmp(b), d.cmp(e), c.cmp(-3)))

def main():
    equalities()
    lists()
    text()
    ranges()
    characters()
    sized(200, 15, -3, 18446744073709551615, 5)
    sized(0, 255, 127, 0, 18446744073709551615)
