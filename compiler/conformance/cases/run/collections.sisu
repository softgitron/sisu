def main():
    var xs = [5, 3, 8]
    xs.push(1)
    print(xs)
    print(xs[0])
    print(xs[^1])
    print(xs.pop() ?? -1)
    xs.insert(1, 9)
    print(xs)
    print(xs.remove(0))
    print(xs)
    print(xs[1:])
    print(xs[:2])
    print((len(xs), xs.is_empty(), 8 in xs, 4 in xs))
    xs.sort()
    print(xs)
    xs.reverse()
    print(xs)
    xs[0] = 100
    print(xs)
    print((xs.get(1) ?? 0, xs.get(10) ?? 0))
    print((xs.first() ?? 0, xs.last() ?? 0))
    var ys: list[int] = []
    ys.extend([1, 2])
    print(ys)

    var d = {"b": 2, "a": 1}
    d["c"] = 3
    d["a"] = 10
    print(d)
    print(d["b"])
    print(d.get("z") ?? 0)
    print(("a" in d, "z" in d, len(d)))
    print(d.remove("b") ?? 0)
    print([k for k in d.keys()])
    print([v for v in d.values()])
    for k, v in d:
        print("{k} -> {v}")
    var counts: dict[str, int] = {}
    for w in ["x", "y", "x"]:
        counts.entry(w).or_insert(0) += 1
    print(counts)

    var s = {3, 1, 3, 2}
    print(s)
    print((s.add(4), s.add(1)))
    print((s.remove(3), 3 in s))
    print(len(s))

    let t = (1, "two", 3.0)
    print(t)
    print(t.1)
    let (a, b, c) = t
    print(a)
    var p = 1
    var q = 2
    p, q = q, p
    print((p, q))
    let squares = {n: n * n for n in range(4)}
    print(squares)
    let evens = {n for n in range(10) if n % 2 == 0}
    print(evens)
