# Where compile-time code cannot be unfolded (decisions 244 and 251): a
# method of a trait impl is made once, as generic as the impl, so asking
# about a type parameter (the impl's or its own) stops it (`E0609`), and
# so does a provided method in an impl for every type, whose `Self` is a
# parameter. A template without type parameters is made where it is
# declared, so code that cannot be unfolded stops there. A refinement's
# `where` clause does not unfold (`E0900`, naming the place).

struct Point:
    x: int
    y: int

struct Pair[A]:
    a: A

trait Size:
    def size(self) -> int

impl[A] Size for Pair[A]:
    def size(self) -> int:
        return len(reflect.fields_of(A))

trait Probe:
    def probe[T](self, x: T) -> bool

impl Probe for Point:
    def probe[T](self, x: T) -> bool:
        return comptime reflect.is_struct(T)

trait Marker:
    def mark(self) -> int

trait Named:
    def names(self) -> list[String]:
        var out: list[String] = []
        comptime for f in reflect.fields_of(Self):
            out.push(f.name)
        return out

impl[T: Marker] Named for T:
    pass

comptime def count() -> int:
    return 1 + reflect.fields_of(Point)

def unknown(p: Point) -> int:
    comptime for f in reflect.fields_of(p):
        print(f.name)
    return 0

type Small = int where self < len(reflect.fields_of(Point))

def main():
    print(Pair(a=1).size())
