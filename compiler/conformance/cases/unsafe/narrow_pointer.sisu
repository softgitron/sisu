# A pointer to a `@repr(c)` struct of narrow fields (decision 1021): a
# struct lays its fields out at C's offsets in a value too, so `ptr.of` and
# `ptr.of_mut` of one compile natively, and what an exported function reads
# through the pointer, and writes, is the struct's own fields, as C would
# see them; `Layout.of` gives C's size and alignment.
from std.mem import Layout, ptr

@repr(c)
struct Reading:
    sensor: u8
    flags: u8
    delta: i16
    celsius: i32
    ratio: f32

@export("sauna_read")
def read(reading: ptr[Reading]) -> i32:
    # safety: valid, aligned: `reading` points to a live `Reading` that
    #   nothing changes while the reference lives.
    let r = unsafe reading.as_ref()
    return r.celsius + r.delta + r.sensor

def cool(reading: ptr mut Reading, by: i32):
    # safety: valid, aligned, writable: `reading` points to a live `Reading`
    #   that nothing else reaches meanwhile.
    unsafe:
        let r = reading.as_mut()
        r.celsius -= by
        r.flags = 255
        r.delta = -300

def main():
    var reading = Reading(sensor=7, flags=1, delta=-2, celsius=85, ratio=0.5)
    let l = Layout.of[Reading]()
    print("{l.size} {l.align}")
    print(read(ptr.of(ref reading)))
    cool(ptr.of_mut(mut reading), 10)
    print(read(ptr.of(ref reading)))
    print("{reading.flags} {reading.delta} {reading.celsius} {reading.ratio}")
