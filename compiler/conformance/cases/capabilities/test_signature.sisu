# A test takes nothing, one `System` (02; 17, "Isolation and
# parallelism"), which `sisu test` hands it as the real one, or the
# capabilities it names, one of each, which it receives as fresh fakes
# (decision 241). There is nothing to pass for any other parameter
# (E0702): a number, a capability named twice, or a `System` beside
# another parameter.

test "takes nothing":
    assert 1 + 1 == 2

test "takes the real System"(sys: System):
    assert sys.fs.exists("test_signature.sisu")

test "takes a number"(n: int):
    assert n == n

test "takes one capability"(fs: Fs):
    assert not fs.exists("note")

test "takes two systems"(sys: System, again: System):
    assert sys.env.args() == again.env.args()

test "takes a capability twice"(fs: Fs, other: Fs):
    assert not fs.exists("note")
