# `x in xs` is `xs.contains(x)` through the prelude's `Contains` trait
# (02; decision 252): on a type of the program's own that implements it,
# on the std collections that do, through a generic bound, and with `not
# in`; the builtin collections and text keep their own `in`, and
# implement `Contains` too, for generic code.
from std.collections import BitSet, Deque, SortedDict, SortedSet

# The squares below a limit, with no list of them.
struct Squares:
    below: int

impl Contains[int] for Squares:
    pure def contains(self, n: int) -> bool:
        if n < 0 or n >= self.below:
            return False
        var r = 0
        while r * r < n:
            r += 1
        return r * r == n

def count_in[C: Contains[int]](c: C, xs: list[int]) -> int:
    var n = 0
    for x in xs:
        if x in c:
            n += 1
    return n

def main():
    let sq = Squares(below=100)
    print("{49 in sq} {50 in sq} {144 in sq} {50 not in sq}")
    print(count_in(sq, [1, 2, 4, 8, 16, 32, 64]))
    print(count_in([2, 4, 6], [1, 2, 3, 4]))
    print(count_in({3, 5}, [1, 3, 5, 7]))
    var s: SortedSet[int] = SortedSet.new()
    _ = s.insert(7)
    var d: SortedDict[str, int] = SortedDict.new()
    _ = d.insert("k", 1)
    var b = BitSet.new()
    b.insert(130)
    var q: Deque[str] = Deque.new()
    q.push_front("front")
    print("{7 in s} {"k" in d} {"v" in d} {130 in b} {"front" in q} {"back" not in q}")
    print("{"ell" in "hello"} {3 in [1, 2]} {"a" in {"a": 0}}")
