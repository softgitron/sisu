# `@delegate` (03, "Coherence"): a newtype forwards the traits it names to
# one field; a trait that returns `Self` wraps the result back.

@delegate(Add, Sub, PartialOrd, Display, to="value")
struct Meters:
    value: f64

@delegate(Eq, Hash, Display, Len, to="items")
struct Bag:
    items: list[int]
    label: String

def main():
    let a = Meters(value=1.5)
    let b = Meters(value=2.0)
    print(a + b)
    print(b - a)
    print(a < b)
    print("{a:>6}|")
    print("{a:?}")
    let bag = Bag(items=[1, 2], label="x".to_string())
    print(bag)
    print(len(bag))
    print(bag == Bag(items=[1, 2], label="y".to_string()))
