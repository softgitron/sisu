# The fixed operator set through traits (D-022): `Add`, `Sub`, `Mul` with
# another right-hand type, `Neg`; `Display` with a format spec; derived
# `Eq`, `Ord` and `Hash` used by `==`, `<`, `sorted`, sets and dicts.

@derive(Copy, Eq, Hash, Ord)
struct V:
    x: int
    y: int

impl Add for V:
    def add(self, other: V) -> V:
        return V(x=self.x + other.x, y=self.y + other.y)

impl Sub for V:
    def sub(self, other: V) -> V:
        return V(x=self.x - other.x, y=self.y - other.y)

impl Mul[int] for V:
    def mul(self, k: int) -> V:
        return V(x=self.x * k, y=self.y * k)

impl Neg for V:
    def neg(self) -> V:
        return V(x=-self.x, y=-self.y)

impl Display for V:
    def fmt(self, mut f: Formatter):
        f.write("({self.x}, {self.y})")

# Generic code uses the operators through the bounds.
def double[T: Add + Copy](x: T) -> T:
    return x + x

def main():
    let a = V(x=1, y=2)
    let b = V(x=10, y=20)
    print(a + b)
    print(b - a)
    print(a * 3)
    print(-a)
    print("[{a:>10}]")
    print("[{a:<10}]")
    print("{a:?}")
    print(a == V(x=1, y=2))
    print(a != b)
    print(a < b)
    print(sorted([b, a, V(x=1, y=0)]))
    print(len({a, b, a}))
    var d: dict[V, str] = {}
    d[a] = "a"
    d[b] = "b"
    print(d[V(x=1, y=2)])
    print(max(a, b))
    print(double(a))
    print(double(21))
    print(double(1.5))
