# The modules std is split into (11): `std.collections`, `std.num` and
# `std.time` hold what the prelude does not, and name the prelude's
# collections, numbers and times too.
import std.num
from std.collections import Arena, BitSet, Deque, Heap, SortedDict
from std.num import Ratio, checked_mul, gcd, isqrt
from std.time import Duration, Ticker

def main(sys: System):
    var q: Deque[str] = Deque.new()
    q.push_back("b")
    q.push_front("a")
    print("{q.pop_front()} {q.pop_back()} {len(q)}")
    var h: Heap[int] = Heap.new()
    for x in [3, 1, 2]:
        h.push(x)
    print(h.pop())
    var d: SortedDict[str, int] = SortedDict.new()
    _ = d.insert("z", 26)
    _ = d.insert("a", 1)
    print(d.keys())
    var b = BitSet.new()
    b.insert(130)
    print(b.members())
    let r = Ratio.of(3, 4) + Ratio.of(1, 4)
    print("{r} {Ratio.of(1, 3) * Ratio.of(3, 5)} {gcd(84, 36)} {isqrt(99)} {num.lcm(4, 10)}")
    print(checked_mul(3037000500, 3037000500))
    var arena: Arena[str] = Arena()
    let k = arena.insert("kept")
    print(arena[k])
    var t = Ticker.every(
        Clock.frozen_at(DateTime.parse("2026-01-01T00:00:00Z").expect("time")), Duration.seconds(2)
    )
    t.wait().expect("ticks")
    print(t.missed)
