null -> Ok(Null)
 true  -> Ok(Bool(value=True))
-0 -> Ok(Int(value=0))
12 -> Ok(Int(value=12))
-3.25e2 -> Ok(Float(value=-325.0))
1E400 -> Ok(Float(value=inf))
"a\tb\u0041" -> Ok(Str(value="a\tbA"))
[[], {}] -> Ok(Array(items=[Array(items=[]), Object(members=[])]))
{"k": [1, {"n": null}]} -> Ok(Object(members=[("k", Array(items=[Int(value=1), Object(members=[("n", Null)])]))]))
 -> Err(Syntax(at=0, expected="a value"))
[1,] -> Err(Syntax(at=3, expected="a value"))
{"a" 1} -> Err(Syntax(at=5, expected="`:`"))
01 -> Err(Syntax(at=1, expected="the end of the text"))
1. -> Err(Syntax(at=2, expected="a digit"))
- -> Err(Syntax(at=1, expected="a digit"))
"\x" -> Err(Syntax(at=2, expected="an escape"))
"open -> Err(Syntax(at=5, expected="`\"`"))
[1 2] -> Err(Syntax(at=3, expected="`,` or `]`"))
nul -> Err(Syntax(at=3, expected="`null`"))
{"a":1}x -> Err(Syntax(at=7, expected="the end of the text"))
"\ud800x" -> Err(Syntax(at=7, expected="`\\u`"))
{"name":"loop","stops":[{"x":1,"y":2},{"x":3,"y":4}],"speed":2.0,"note":null}
loop 2 4 2.0 None
1.5 Some("hi")
Err(Mismatch(path="$.stops[0].y", expected="an integer"))
Err(Mismatch(path="$.stops", expected="a member"))
Err(Mismatch(path="$", expected="an object"))
Ok([Some(1), None, Some(3)])
Ok(7.0)
