# `std.rand` (11): the generators behind `Rand`. A seeded xoshiro256**
# and a ChaCha20 stream give the same values in every run (ChaCha20's
# block is RFC 8439's test vector); every copy of a generator's handle
# shares its state; `choose`, `sample` and `random_bytes` work over any
# `Rand`.
import std.rand

def main():
    let fast = rand.fast(2026)
    print([fast.bits() for _ in range(3)])
    let copy = fast
    print(copy.bits() != fast.bits())
    let key: list[u32] = [
        0x03020100u32,
        0x07060504u32,
        0x0b0a0908u32,
        0x0f0e0d0cu32,
        0x13121110u32,
        0x17161514u32,
        0x1b1a1918u32,
        0x1f1e1d1cu32,
    ]
    let block = rand.chacha20_block(key, 1u32, [0x09000000u32, 0x4a000000u32, 0u32])
    print([b.to_int() for b in block[0:4]])
    let stream = rand.chacha20(key, [0u32, 0u32, 0u32])
    print([stream.between(0, 100) for _ in range(5)])
    let secure = rand.secure(Rand.seeded(1))
    print(len(rand.random_bytes(secure, 33)))
    let r = rand.fast(7)
    print(rand.choose(r, ["red", "green", "blue"]))
    var picked = rand.sample(r, 1000, 10)
    picked.sort()
    var distinct = True
    for i in range(1, len(picked)):
        if picked[i] == picked[i - 1]:
            distinct = False
    print("{len(picked)} {distinct} {picked[0] >= 0} {picked[9] < 1000}")
    var counts = [0, 0, 0, 0]
    for _ in range(4000):
        counts[r.between(0, 4)] += 1
    print(all([800 < c < 1200 for c in counts]))
