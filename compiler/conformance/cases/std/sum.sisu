# `sum` over every kind of argument it takes (D-074): integers with their
# overflow checked, whose panic names its two sides, floats added pairwise
# in a fixed shape, `f32`s too, and an iterator whose items are taken first
# to last before the sum.

def shown(x: int) -> int:
    print("item {x}")
    return x

def main():
    print(sum([1, 2, 3]))
    let none: list[int] = []
    print(sum(none))
    print(sum([0.1, 0.2, 0.3, 0.4]))
    print(sum([1.0e16, 1.0, -1.0e16, 1.0]))
    let small: list[f32] = [0.5, 0.25, 0.125]
    print(sum(small))
    let tenths: list[f32] = [0.1, 0.2, 0.7, 0.3]
    print(sum(tenths))
    let empty: list[f64] = []
    print(sum(empty))
    print(sum(range(1, 101)))
    print(sum([4, 5, 6].iter().map(shown(it))))
    print(sum([9223372036854775807, 1, -5]))
