# `std.search` (11; D-075): binary search and its bounds, selection in
# place, and the search combinators: `interleave` is fair to an endless
# search, `deepening` gives the shallowest candidates first, and `within`
# gives up after a bounded number of candidates.
import std.search

# Every word over "ab" of length `n`, as a depth-bounded search gives
# them: an endless space walked by depth.
def words(n: int) -> Iter[String]:
    if n == 0:
        yield String.new()
        return
    for w in words(n - 1):
        yield "{w}a"
        yield "{w}b"

def each(own xs: list[str]) -> Iter[str]:
    for x in own xs:
        yield x

def main():
    let xs = [1, 3, 3, 3, 7, 9]
    print(
        "{search.bisect_left(xs, 3)} {search.bisect_right(xs, 3)} {search.binary_search(xs, 7)} {search.binary_search(xs, 4)}"
    )
    print(search.partition_point(xs, (x) -> x < 5))
    var ys = [50, 10, 40, 20, 30, 60, 0]
    search.select_nth(mut ys, 3)
    print(ys[3])
    let evens = range(0, 1000000000).filter(it % 2 == 0)
    let odds = range(0, 1000000000).filter(it % 2 == 1)
    print(search.interleave(evens, odds).take(8).collect())
    print(search.interleave_all([each(["a", "b"]), each(["c"]), each(["d", "e", "f"])]).collect())
    print(search.deepening(words, 2).collect())
    let target = search.within(search.deepening(words, 20), 100, (w) -> w == "bab")
    print(target)
    print(search.within(search.deepening(words, 20), 10, (w) -> w == "bab"))
