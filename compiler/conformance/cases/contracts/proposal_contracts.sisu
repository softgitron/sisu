# Contracts and refinement types.

def binary_search[T: Ord](items: Slice[T], target: T) -> int?:
    requires items.is_sorted()
    ensures match result:
        case Some(i): items[i] == target
        case None: not items.contains(target)
    var lo = 0
    var hi = len(items)
    while lo < hi:
        let mid = lo + (hi - lo) // 2         # no overflow: int is 64-bit and traps anyway
        match items[mid].cmp(target):
            case Less:
                lo = mid + 1
            case Greater:
                hi = mid
            case Equal:
                return Some(mid)
    return None

struct Account:
    balance: Money
    limit: Money
    invariant self.balance >= -self.limit    # checked after construction and every `mut self` method

    def withdraw(mut self, amount: Money):   # fields of a type with an invariant are assigned only in its own methods
        requires amount > Money.ZERO
        ensures self.balance == old(self.balance) - amount
        self.balance -= amount

    def try_withdraw(mut self, amount: Money) -> ! Overdrawn:
        if self.balance - amount < -self.limit:
            return Err(Overdrawn)
        self.balance -= amount                # invariant re-checked when this method returns
        return Ok(())

error Overdrawn:
    Overdrawn

# Refinement types: subtypes of a base type with a predicate.
type Port = int where 1 <= self <= 65535
type Percent = int where 0 <= self <= 100
type NonEmpty[T] = list[T] where not self.is_empty()

def listen(net: Net, port: Port) -> TcpListener ! NetError:
    return net.listen(port)

def demo(net: Net, user_input: int):
    let p: Port = 8080                         # constant: checked at compile time
    let q = Port.try_from(user_input) else:    # runtime: checked at construction
        return
    _ = listen(net, p)
    # listen(net, 70000)                       # compile error: 70000 is not a Port

    let xs: NonEmpty[int] = NonEmpty.try_from([1, 2, 3]).expect("literal is non-empty")
    let first = xs.first()                     # NonEmpty.first returns T, not T?

test "binary search finds every element":
    check(arbitrary[list[int]]) do xs:
        var ordered = xs.copy()
        ordered.sort()
        return ordered.iter().all(binary_search(ordered, it).is_some())
    # Every call inside a test checks `requires` and `ensures` too.

# ---------------------------------------------------------------------------
# What the example leaves undeclared, and a `main` that runs it. Everything
# above is proposal/examples/contracts.sisu unchanged (a test checks).

@derive(Copy, Eq, Ord)
@delegate(Add, Sub, Neg, Display, to="cents")
struct Money:
    cents: int

impl Money:
    const ZERO: Money = Money(cents=0)

type TcpListener = Listener

impl[T: Copy] NonEmpty[T]:
    # The first element: there always is one.
    def first(self) -> T:
        return self[0]

def main():
    let xs = [1, 3, 5, 7, 9]
    print(binary_search(xs, 7))
    print(binary_search(xs, 4))
    var a = Account(balance=Money(cents=100), limit=Money(cents=50))
    a.withdraw(Money(cents=30))
    print(a.balance)
    print(a.try_withdraw(Money(cents=500)))
    print(a.try_withdraw(Money(cents=20)))
    print(a.balance)
    let net = Net.fake()
    demo(net, 8080)
    demo(net, 0)
    print(Percent.try_from(101))
    a.withdraw(Money(cents=200))
