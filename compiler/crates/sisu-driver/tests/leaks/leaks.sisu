# What the native backend's first round leaked (decision 200), what the
# interpreter's host frees without the program seeing it, and what the
# second round left (decisions 220 to 225), each made in a loop: under
# `SISU_RT_ALLOCS` a native run reports the runtime's allocations live at
# exit, which must be none.

trait Shape:
    def area(self) -> int

struct Square:
    side: int
    label: String

impl Shape for Square:
    def area(self) -> int:
        return self.side * self.side

impl Square:
    def consume(own self) -> int:
        return len(self.label)

struct Loud:
    name: String
    tags: list[String]

impl Drop for Loud:
    def drop(mut self):
        if self.name == "last":
            print("dropped {self.name} with {len(self.tags)} tags")

error ParseError:
    Empty
    Bad(text: String)

def parse(text: str) -> int ! ParseError:
    if text.is_empty():
        return Err(Empty)
    return Err(Bad(text=text.to_string()))

def twice(text: str) -> int ! ParseError:
    let n = parse(text)?
    return Ok(n)

def adder(n: int) -> (int) -> int:
    return own (x) -> x + n

def line(a: int, b: int, c: int) -> (int) -> int:
    return own (x) -> a * x * x + b * x + c

def words(own prefix: String) -> Iter[String]:
    var i = 0
    let tail = "{prefix}!"
    while True:
        yield "{prefix}{i}{tail}"
        i += 1

error LoadError:
    Missing(path: String)
    Denied(path: String, who: String)

def load(i: int) -> int ! {ParseError, LoadError}:
    if i % 3 == 0:
        return Err(Denied(path="p{i}", who="w{i}"))
    if i % 3 == 1:
        return Err(Bad(text="b{i}"))
    return Err(Missing(path="m{i}"))

def pair(i: int) -> (String, int) ! ParseError:
    return Ok(("first{i}", twice("t{i}")?))

def count_of[T](xs: list[T]) -> int:
    return len(xs)

def main():
    var total = 0
    for i in range(40):
        # A closure that holds a value (decision 213).
        let f = adder(i)
        total += f(1)
        # A `*rest` pattern (decision 214).
        let xs = ["a".to_string(), "b".to_string(), "c{i}".to_string()]
        match xs:
            case [first, *rest]:
                total += len(first) + len(rest)
            case _:
                pass
        # Return traces, copied, dropped, and taken apart (decision 215).
        let e = twice("x{i}")
        let copy = e.copy()
        total += len("{e}") + len("{copy}")
        match twice("z{i}"):
            case Err(Bad(text)):
                total += len(text)
            case Err(Empty):
                total += 1
            case Ok(n):
                total += n
        # A box whose value moves into a `dyn`, a value an `own self`
        # method takes (not through a `dyn`: a method callable through one
        # takes `self` or `mut self`, E0241), and a box given a value again
        # (decision 216).
        let b: Box[Square] = Box(Square(side=i, label="sq".to_string()))
        let d: Box[dyn Shape] = b
        total += d.area()
        let g = Square(side=2, label="abc".to_string())
        total += g.consume()
        var r = Box("one".to_string())
        let s = r.boxed
        r.boxed = "two{s}".to_string()
        total += len(r.boxed)
        # Fields the drop glue leaves out, and text an intrinsic is given
        # (decision 218).
        let loud = Loud(name="n{i}", tags=["t".to_string()])
        total += len(loud.name)
        # A closure whose environment is three words, a generator left
        # after two items and one never started, a capability's object, a
        # union of error sets a pattern takes a field out of, and an operand
        # a `?` after it leaves behind (decisions 221 to 224).
        let f3 = line(i, 2, 1)
        total += f3(2)
        for w in words("w{i}").take(2):
            total += len(w)
        let unstarted = words("u{i}")
        let fs = Fs.in_memory({"f{i}": "text"})
        let read = fs.read_to_string(Path.new("f{i}")) else: "none"
        total += len(read)
        match load(i):
            case Err(Denied(path, _)):
                total += len(path)
            case Err(Bad(text)):
                total += len(text)
            case _:
                total += 1
        match pair(i):
            case Ok(p):
                total += p.1
            case Err(e):
                total += len("{e}")
        # A `Slice` of a `bytes`, which holds copies of its bytes, and a
        # generic function as a value (decision 225).
        let raw = "r{i}".encode()
        let bytes_seen = raw.as_slice()
        total += len(bytes_seen) + bytes_seen[0].to_int()
        let count: (list[String]) -> int = count_of
        total += count(["p{i}".to_string(), "q".to_string()])
        print("{total}")
    let last = Loud(name="last", tags=["x".to_string(), "y".to_string()])
    print(len(last.name))
