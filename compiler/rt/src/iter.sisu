##! Iterators (`Iter[T]`) over raw memory (decision 423): an iterator's
##! value is the address of an object of eleven words, the items of a fixed
##! size each, as the interpreter's `IterState` gives them (`sisu-interp/
##! src/iter.rs`). The first four words are the header compiled code reads
##! to step a range or a borrowed list's elements without a call (decision
##! 253): the kind (`OTHER`, `RANGE_KIND` or `LIST_KIND`), and a range's
##! current value, end and step, or a list's address, next index and size
##! of an element. Then come the state that gives the other kinds' items,
##! the bytes of an item, and five words the state keeps. The runtime in
##! Rust makes an iterator's object as this module lays it out, and asks it
##! for the next item, for what an `Iterable[T]` argument gives and for
##! every item left, and to drop it; a generator's items and a receiver's
##! values it gives through calls of it, which run the scheduler.

import rt.list
import rt.table
import rt.value
from rt.host import memmove
from rt.host import sisu_rt_alloc
from rt.host import sisu_rt_free
from rt.host import sisu_rt_gen_abandon
from rt.host import sisu_rt_gen_item
from rt.host import sisu_rt_recv_item
from rt.host import sisu_rt_zip_lengths
from rt.types import DICT
from rt.types import DYN
from rt.types import ITER
from rt.types import LIST
from rt.types import RECEIVER
from rt.types import REF
from rt.types import SET
from rt.types import Types
from std.mem import ptr

## The words of an iterator's object: the header's four, its state, the
## bytes of an item, and the first of the five words of its state.
const KIND: int = 0
const A: int = 1
const B: int = 2
const C: int = 3
const STATE: int = 4
const SIZE: int = 5
const P: int = 6
pub(package) const WORDS: int = 11

## The kinds the header gives: the state is the runtime's, a range's, or a
## borrowed list's (`sisu_rt::abi::ITER_OTHER` and its kin).
const OTHER: int = 0
const RANGE_KIND: int = 1
const LIST_KIND: int = 2

## The states: a range of integers and a borrowed list's elements, whose
## state is the header; owned values moved out one by one (the list's three
## words, the next index and the elements' type); the characters and the
## bytes of a text (its bytes' address, their number and the next byte); a
## copy of a `bytes`' bytes, which the iterator owns (the same); an index
## beside each item of another iterator (it, and the next index); the pairs
## of two (each, whether lengths must agree, and the types of their items);
## the values another's references point to, copied (it, and the item's
## type, -1 when no handle needs a count); references into a borrowed dict
## or set (its table, the next entry, and keys 0, values 1 or both 2); the
## entries of a dict or set it owns (its table, the next entry); a
## generator's items (its task); a receiver's values (its channel); and
## none.
pub(package) const S_RANGE: int = 0
pub(package) const S_LIST_REF: int = 1
pub(package) const S_ITEMS: int = 2
pub(package) const S_CHARS: int = 3
pub(package) const S_BYTES: int = 4
pub(package) const S_OWNED_BYTES: int = 5
pub(package) const S_ENUMERATE: int = 6
pub(package) const S_ZIP: int = 7
pub(package) const S_DECAY: int = 8
pub(package) const S_TABLE_REF: int = 9
pub(package) const S_TABLE_OWN: int = 10
pub(package) const S_GEN: int = 11
pub(package) const S_RECV: int = 12
pub(package) const S_DONE: int = 13

## What a generator's or a receiver's call of the runtime in Rust gives: an
## item, written out; the end; otherwise a panic was raised, its status the
## result less this.
const GOT: int = 0
const ENDED: int = 1
const RAISED: int = 2

## A table's parts that references into it give.
const KEYS: int = 0
const VALUES: int = 1

## Word `k` of the iterator at `it`.
##
## Requires:
## - `iterator`: `it` is the address of a live iterator's object
def get(it: ptr mut u8, k: int) -> int:
    # safety: in_bounds, valid, aligned: an iterator's object is eleven
    #   words, by `iterator`.
    return unsafe it.cast[int]().offset(k).read()

## Sets word `k` of the iterator at `it` to `w`.
##
## Requires:
## - `iterator`: `it` is the address of a live iterator's object
def set(it: ptr mut u8, k: int, w: int):
    # safety: in_bounds, valid, aligned, writable: an iterator's object is
    #   eleven words, by `iterator`.
    unsafe it.cast[int]().offset(k).write(w)

## The address word `k` of the iterator at `it` holds.
##
## Requires:
## - `iterator`: `it` is the address of a live iterator's object
def get_ptr(it: ptr mut u8, k: int) -> ptr mut u8:
    # safety: in_bounds, valid, aligned, writable: an iterator's object is
    #   eleven words, by `iterator`.
    return unsafe it.cast[ptr[u8]]().offset(k).read().cast_mut()

## A new iterator's object in the state `state`, of items of `size` bytes,
## its other words 0.
def make(state: int, size: int) -> ptr mut u8:
    # safety: returns_promptly: the runtime in Rust gives the block of eleven
    #   words, which are written here.
    let it = unsafe sisu_rt_alloc(WORDS * 8)
    var k = 0
    while k < WORDS:
        set(it, k, 0)
        k += 1
    set(it, STATE, state)
    set(it, SIZE, size)
    return it

## Writes `None` at the option `out`.
##
## Requires:
## - `option`: `out` has room for an option
def none(out: ptr mut u8):
    # safety: valid, aligned, writable: an option's first word is its tag,
    #   by `option`.
    unsafe out.cast[int]().write(1)

## Writes the tag of `Some` at the option `out`, whose item the caller
## writes after it.
##
## Requires:
## - `option`: `out` has room for an option
def some(out: ptr mut u8):
    # safety: valid, aligned, writable: an option's first word is its tag,
    #   by `option`.
    unsafe out.cast[int]().write(0)

## The bytes of the next character of the `n` bytes at `b` from `pos`, a
## UTF-8 sequence, and its code point; 0 bytes when there is none, or what
## is there is not one.
##
## Requires:
## - `inside`: `b` points to `n` live bytes
def next_char(b: ptr[u8], n: int, pos: int) -> (int, int):
    if pos >= n:
        return (0, 0)
    # safety: in_bounds, valid, aligned: each byte read is before `n`; a
    #   byte needs no alignment.
    unsafe:
        let lead = b.offset(pos).read().to_int()
        if lead < 128:
            return (1, lead)
        var len = 0
        var code = 0
        if lead >= 240 and lead < 248:
            len = 4
            code = lead & 7
        elif lead >= 224:
            len = 3
            code = lead & 15
        elif lead >= 192:
            len = 2
            code = lead & 31
        else:
            return (0, 0)
        if pos + len > n:
            return (0, 0)
        var k = 1
        while k < len:
            let cont = b.offset(pos + k).read().to_int()
            if (cont & 192) != 128:
                return (0, 0)
            code = (code << 6) | (cont & 63)
            k += 1
        let least = if len == 2: 128 elif len == 3: 2048 else: 65536
        if code < least or code > 1114111 or (code >= 55296 and code < 57344):
            return (0, 0)
        return (len, code)

## Writes the next item of the iterator at `it` as an option at `out` (a
## tag word, then the item): its status, as a drop's, 1 when a panic is
## leaving. `mode` is how what it drops is dropped (`value.drop`).
##
## Requires:
## - `typed`: `ts` is the program's table, `it` the address of a live
##   iterator's object, and `out` has room for a tag word and an item
pub(package) def next(ts: Types, it: ptr mut u8, out: ptr mut u8, mode: int) -> int:
    let state = get(it, STATE)
    # safety: in_bounds, valid, aligned, writable: each state's words are
    #   where this module puts them, each address in them is live, and
    #   `out` has room for an item after its tag; returns_promptly: memmove
    #   moves bytes, and the runtime in Rust runs a generator and gives a
    #   channel's value.
    unsafe:
        let item = out.offset(8)
        if state == S_RANGE:
            let (cur, stop, step) = (get(it, A), get(it, B), get(it, C))
            if (step > 0 and cur >= stop) or (step < 0 and cur <= stop):
                none(out)
                return value.OK
            # Past the last value an `int` holds, the range ends: its end
            # becomes its current value, as compiled code ends it.
            let after = cur +% step
            let over = ((cur ^ after) & (step ^ after)) < 0
            set(it, A, if over: stop else: after)
            some(out)
            item.cast[int]().write(cur)
            return value.OK
        if state == S_LIST_REF:
            let l = get_ptr(it, A)
            let i = get(it, B)
            if i >= list.length(l):
                none(out)
                return value.OK
            some(out)
            item.cast[int]().write(list.buffer(l).offset(i * get(it, C)).addr())
            set(it, B, i + 1)
            return value.OK
        if state == S_ITEMS:
            let i = get(it, P + 3)
            if i >= get(it, P + 1):
                none(out)
                return value.OK
            let size = get(it, SIZE)
            some(out)
            _ = memmove(item, get_ptr(it, P).offset(i * size).as_const(), size)
            set(it, P + 3, i + 1)
            return value.OK
        if state == S_CHARS:
            let pos = get(it, P + 2)
            let (len, code) = next_char(get_ptr(it, P).as_const(), get(it, P + 1), pos)
            if len == 0:
                none(out)
                return value.OK
            set(it, P + 2, pos + len)
            some(out)
            item.cast[int]().write(code)
            return value.OK
        if state == S_BYTES or state == S_OWNED_BYTES:
            let pos = get(it, P + 2)
            if pos >= get(it, P + 1):
                none(out)
                return value.OK
            set(it, P + 2, pos + 1)
            some(out)
            item.cast[int]().write(get_ptr(it, P).offset(pos).read().to_int())
            return value.OK
        if state == S_ENUMERATE:
            # The inner item's option at the index's place: its item lands
            # where the pair's second part goes.
            let inner = get_ptr(it, P)
            let st = next(ts, inner, item, mode)
            if st != value.OK:
                return st
            if item.cast[int]().read() != 0:
                none(out)
                return value.OK
            let n = get(it, P + 1)
            some(out)
            item.cast[int]().write(n)
            set(it, P + 1, n + 1)
            return value.OK
        if state == S_ZIP:
            return next_pair(ts, it, out, mode)
        if state == S_DECAY:
            # The reference the inner iterator gives, in the two words of
            # this object's state it leaves free.
            let room = it.offset((P + 2) * 8)
            let st = next(ts, get_ptr(it, P), room, mode)
            if st != value.OK:
                return st
            if room.cast[int]().read() != 0:
                none(out)
                return value.OK
            some(out)
            let source = room.offset(8).cast[ptr[u8]]().read()
            _ = memmove(item, source, get(it, SIZE))
            let t = get(it, P + 1)
            if t >= 0:
                value.retain(ts, item, t)
            return value.OK
        if state == S_TABLE_REF:
            let tb = get_ptr(it, P)
            let i = get(it, P + 1)
            if i >= table.length(tb):
                none(out)
                return value.OK
            some(out)
            let part = get(it, P + 2)
            if part == KEYS:
                item.cast[int]().write(table.key_at(tb, i).addr())
            elif part == VALUES:
                item.cast[int]().write(table.value_at(tb, i).addr())
            else:
                item.cast[int]().write(table.key_at(tb, i).addr())
                item.offset(8).cast[int]().write(table.value_at(tb, i).addr())
            set(it, P + 1, i + 1)
            return value.OK
        if state == S_TABLE_OWN:
            let tb = get_ptr(it, P)
            let i = get(it, P + 1)
            if i >= table.length(tb):
                none(out)
                return value.OK
            some(out)
            _ = memmove(item, table.key_at(tb, i).as_const(), get(it, SIZE))
            set(it, P + 1, i + 1)
            return value.OK
        # A generator inside another iterator's adapter, or given to an
        # intrinsic, runs until it yields; a receiver there gives what is
        # there already, as only `Iter.next` on its own iterator waits.
        if state == S_GEN or state == S_RECV:
            var got = ENDED
            if state == S_GEN:
                got = sisu_rt_gen_item(get(it, P), item, get(it, SIZE))
            else:
                got = sisu_rt_recv_item(get(it, P), item, get(it, SIZE))
            if got == GOT:
                some(out)
                return value.OK
            if got == ENDED:
                none(out)
                return value.OK
            return got - RAISED
        none(out)
        return value.OK

## The next pair of the iterator of pairs at `it` (`zip`), as [`next`]
## writes an item: none when either ends, the item of the other dropped,
## and a panic when the lengths must agree and do not. The first item's
## option is written where the pair's goes, and the second's after the
## first item, over the first item's last word, which is kept aside.
##
## Requires:
## - `typed`: `it` is the address of a live iterator of pairs, and `out`
##   has room for a tag word and a pair
def next_pair(ts: Types, it: ptr mut u8, out: ptr mut u8, mode: int) -> int:
    let (a, b) = (get_ptr(it, P), get_ptr(it, P + 1))
    let sa = get(a, SIZE)
    # safety: in_bounds, valid, aligned, writable: `out` has room for a tag
    #   word and both items, by `typed`; returns_promptly: the runtime in Rust
    #   raises the panic.
    unsafe:
        var st = next(ts, a, out, mode)
        if st != value.OK:
            return st
        let x = out.cast[int]().read() == 0
        let second = out.offset(sa)
        let kept = second.cast[int]().read()
        st = next(ts, b, second, mode)
        let y = second.cast[int]().read() == 0
        second.cast[int]().write(kept)
        if st != value.OK:
            if x:
                st = value.after_part(st, value.drop(ts, out.offset(8), get(it, P + 3), mode))
            return st
        if x and y:
            some(out)
            return value.OK
        if not x and not y:
            none(out)
            return value.OK
        # The item of the longer one is dropped.
        if x:
            st = value.drop(ts, out.offset(8), get(it, P + 3), mode)
        if y:
            st = value.after_part(st, value.drop(ts, second.offset(8), get(it, P + 4), mode))
        if st == value.OK and get(it, P + 2) != 0:
            st = sisu_rt_zip_lengths().to_int()
        if st == value.OK:
            none(out)
        return st

## Drops the iterator at `it` and what it owns: the items it has not given,
## the iterators it holds, a dict's or a set's entries left, a copy of
## bytes; a generator dropped before its end is closed (decision 236). Its
## status, as a drop's.
##
## Requires:
## - `typed`: `it` is the address of a live iterator's object, or 0, dead
##   afterwards
pub(package) def drop(ts: Types, it: ptr mut u8, mode: int) -> int:
    if it.addr() == 0:
        return value.OK
    let status = drop_state(ts, it, mode)
    # safety: returns_promptly: the runtime in Rust frees the object's block.
    unsafe sisu_rt_free(it)
    return status

## Drops what the state of the iterator at `it` owns, but its object.
##
## Requires:
## - `typed`: `it` is the address of a live iterator's object
def drop_state(ts: Types, it: ptr mut u8, mode: int) -> int:
    let state = get(it, STATE)
    # safety: in_bounds: each item left is in the list's buffer;
    #   returns_promptly: the runtime in Rust frees the blocks and closes a
    #   generator.
    unsafe:
        if state == S_ITEMS:
            var status = value.OK
            let e = get(it, P + 4)
            if ts.needs_drop(e):
                let size = ts.size(e)
                var i = get(it, P + 3)
                while i < get(it, P + 1):
                    status = value.after_part(
                        status, value.drop(ts, get_ptr(it, P).offset(i * size), e, mode)
                    )
                    i += 1
            if get(it, P) != 0:
                sisu_rt_free(get_ptr(it, P))
            return status
        if state == S_OWNED_BYTES:
            if get(it, P) != 0:
                sisu_rt_free(get_ptr(it, P))
            return value.OK
        if state == S_TABLE_OWN:
            return table.drop(ts, get_ptr(it, P), get(it, P + 1), mode)
        if state == S_ENUMERATE or state == S_DECAY:
            return drop(ts, get_ptr(it, P), mode)
        if state == S_ZIP:
            let st = drop(ts, get_ptr(it, P), mode)
            return value.after_part(st, drop(ts, get_ptr(it, P + 1), mode))
        if state == S_GEN:
            return sisu_rt_gen_abandon(get(it, P)).to_int()
    return value.OK

## What type `t` refers to, when it is a reference, else -1.
def referent(ts: Types, t: int) -> int:
    if ts.kind(t) == REF:
        return ts.a(t)
    return -1

## A new iterator in the state `state` of the object at `it`, which it
## takes: the object then gives nothing.
##
## Requires:
## - `iterator`: `it` is the address of a live iterator's object
def take(it: ptr mut u8) -> ptr mut u8:
    let out = make(S_DONE, 0)
    var k = 0
    while k < WORDS:
        set(out, k, get(it, k))
        k += 1
    set(it, STATE, S_DONE)
    set(it, KIND, OTHER)
    return out

## The iterator of the items of an `Iterable[T]` argument at `p`, of type
## `arg`: a borrowed or owned list, dict or set, a receiver, or an
## iterator, which it takes. When `T` (`item`, -1 when the call does not
## say) is not a reference, the items of a borrowed collection, or of an
## iterator of references, are copies.
##
## Requires:
## - `typed`: `p` holds a live value of type `arg`; an owned one moves in
pub(package) def iterable(ts: Types, p: ptr mut u8, arg: int, item: int) -> ptr mut u8:
    var base = make(S_DONE, 0)
    var elem = -1
    # An `Iterable[T]` parameter is a `dyn` of what the caller passed
    # (decision 210): what a reference refers to, and its type.
    var q = p
    var inner = -1
    let ak = ts.kind(arg)
    # safety: in_bounds, valid, aligned, writable: a reference's word is its
    #   target's address, a `dyn`'s two words its type and its value's
    #   address, and each value is of its type, by `typed`; returns_promptly:
    #   the runtime in Rust frees the object made first.
    unsafe:
        sisu_rt_free(base)
        if ak == REF:
            let target = ts.a(arg)
            if ts.kind(target) == DYN:
                q = p.offset(8).cast[ptr[u8]]().read().cast_mut()
                inner = p.cast[int]().read()
            else:
                q = p.cast[ptr[u8]]().read().cast_mut()
                inner = target
        if inner >= 0:
            let ik = ts.kind(inner)
            if ik == LIST:
                elem = ts.a(inner)
                base = make(S_LIST_REF, 8)
                set(base, KIND, LIST_KIND)
                set(base, A, q.addr())
                set(base, C, ts.size(elem))
            elif ik == DICT:
                base = table_part(q.cast[ptr[u8]]().read().cast_mut(), 2)
            elif ik == SET:
                elem = ts.a(inner)
                base = table_part(q.cast[ptr[u8]]().read().cast_mut(), KEYS)
            elif ik == RECEIVER:
                base = make(S_RECV, ts.size(ts.a(inner)))
                set(base, P, q.cast[int]().read())
            elif ik == ITER:
                # An iterator behind a reference: its own object, which the
                # reference does not own; its remaining items.
                base = take(q.cast[ptr[u8]]().read().cast_mut())
                elem = referent(ts, ts.a(inner))
            else:
                base = make(S_DONE, 0)
        elif ak == LIST:
            elem = -1
            let e = ts.a(arg)
            base = make(S_ITEMS, ts.size(e))
            _ = memmove(base.offset(P * 8), p.as_const(), 24)
            set(base, P + 4, e)
        elif ak == DICT or ak == SET:
            let tb = p.cast[ptr[u8]]().read().cast_mut()
            base = make(S_TABLE_OWN, table.entry_size(tb) - 8)
            set(base, P, tb.addr())
        elif ak == ITER:
            base = p.cast[ptr[u8]]().read().cast_mut()
            elem = referent(ts, ts.a(arg))
        else:
            base = make(S_DONE, 0)
    # An iterator of references (a generator's of `ref T`, `iter_from` of a
    # program's iterator over a collection) decays as a borrowed
    # collection's items do.
    var refs = False
    if ak == REF:
        let target = ts.a(arg)
        if ts.kind(target) == DYN:
            # safety: valid, aligned: a `dyn`'s first word is its type.
            let held = unsafe p.cast[int]().read()
            refs = ts.kind(held) == ITER and referent(ts, ts.a(held)) >= 0
        else:
            refs = ts.kind(target) == ITER and referent(ts, ts.a(target)) >= 0
    elif ak == ITER:
        refs = referent(ts, ts.a(arg)) >= 0
    let state = get(base, STATE)
    let gives_refs = state == S_LIST_REF
        or (state == S_TABLE_REF and get(base, P + 2) != 2)
        or (refs and state != S_DECAY)
    let wants_ref = item >= 0 and ts.kind(item) == REF
    if gives_refs and not wants_ref:
        let decayed = if item >= 0: item else: elem
        let out = make(S_DECAY, if decayed >= 0: ts.size(decayed) else: 8)
        set(out, P, base.addr())
        set(out, P + 1, decayed)
        return out
    return base

## An iterator of references into the table at `tb`: its keys (`KEYS`),
## its values (`VALUES`) or both (2).
##
## Requires:
## - `table`: `tb` is the address of a live table
pub(package) def table_part(tb: ptr mut u8, part: int) -> ptr mut u8:
    let it = make(S_TABLE_REF, if part == 2: 16 else: 8)
    set(it, P, tb.addr())
    set(it, P + 2, part)
    return it

## Every item left of the iterator at `it`, of type `item` (-1 when the
## call does not say), moved into a new list at `out`; the iterator is
## dropped after, and when a panic stops it, with what it has left, and so
## are the items taken by then (decision 235). Its status, as a drop's.
##
## Requires:
## - `typed`: `it` is the address of a live iterator's object, dead
##   afterwards, and `out` has room for a list
pub(package) def collect(ts: Types, it: ptr mut u8, item: int, out: ptr mut u8, mode: int) -> int:
    let size = get(it, SIZE)
    # safety: in_bounds, valid, aligned, writable: a list is three words, and
    #   the room holds a tag word and an item; returns_promptly: the runtime
    #   in Rust gives and frees the room, and memmove moves the items.
    unsafe:
        let w = out.cast[int]()
        w.write(0)
        w.offset(1).write(0)
        w.offset(2).write(0)
        let room = sisu_rt_alloc(8 + size)
        var st = value.OK
        while True:
            st = next(ts, it, room, mode)
            if st != value.OK or room.cast[int]().read() != 0:
                break
            list.reserve(out, 1, size)
            let n = list.length(out)
            _ = memmove(list.buffer(out).offset(n * size), room.offset(8).as_const(), size)
            list.set_length(out, n + 1)
        sisu_rt_free(room)
        let dropped = drop(ts, it, mode)
        if st == value.OK and dropped == value.OK:
            return value.OK
        st = value.after_part(st, dropped)
        # The items taken by then, first to last, when their type is known.
        if item >= 0 and ts.needs_drop(item):
            var i = 0
            while i < list.length(out):
                st = value.after_part(
                    st, value.drop(ts, list.buffer(out).offset(i * size), item, mode)
                )
                i += 1
        if w.read() != 0:
            sisu_rt_free(list.buffer(out))
        w.write(0)
        w.offset(1).write(0)
        w.offset(2).write(0)
        return st
