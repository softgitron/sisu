##! The words and bytes of values in memory, as the runtime's code reads and
##! writes them: each a load or a store, which the backend compiles inline
##! (decision 335).

from std.mem import ptr

## The word `off` bytes into the value at `p`.
##
## Requires:
## - `inside`: `p` plus `off` bytes is a word of a live value, aligned for
##   one
pub(package) def word(p: ptr mut u8, off: int) -> int:
    # safety: in_bounds, valid, aligned: this function's `inside`.
    return unsafe p.offset(off).cast[int]().read()

## Writes `w` as the word `off` bytes into the value at `p`.
##
## Requires:
## - `inside`: `p` plus `off` bytes is a word this code may write, aligned
##   for one, holding nothing that must be dropped first
pub(package) def set_word(p: ptr mut u8, off: int, w: int):
    # safety: in_bounds, writable, aligned: this function's `inside`.
    unsafe p.offset(off).cast[int]().write(w)

## The address `off` bytes into the memory at `p`.
##
## Requires:
## - `inside`: `p` plus `off` bytes is within the block `p` points into, or
##   one past its end
pub(package) def at(p: ptr mut u8, off: int) -> ptr mut u8:
    # safety: in_bounds: this function's `inside`.
    return unsafe p.offset(off)

## The address that the word `off` bytes into the value at `p` holds: a
## text's bytes, a list's elements, a box's cell.
##
## Requires:
## - `inside`: `p` plus `off` bytes is a word of a live value, aligned for
##   one, holding the address of memory this code may read and write
pub(package) def held(p: ptr mut u8, off: int) -> ptr mut u8:
    # safety: in_bounds, valid, aligned, writable: this function's `inside`.
    return unsafe p.offset(off).cast[ptr[u8]]().read().cast_mut()

## The byte `i` bytes into the memory at `p`, as an `int`.
##
## Requires:
## - `inside`: `p` plus `i` bytes is a byte of live memory
pub(package) def byte(p: ptr mut u8, i: int) -> int:
    # safety: in_bounds, valid, aligned: this function's `inside`; a byte
    #   needs no alignment.
    return unsafe p.offset(i).read().to_int()

## The `f64` at `p`.
##
## Requires:
## - `inside`: `p` holds an `f64`, aligned for one
pub(package) def float(p: ptr mut u8) -> f64:
    # safety: valid, aligned: this function's `inside`.
    return unsafe p.cast[f64]().read()
