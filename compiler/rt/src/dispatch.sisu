##! The intrinsics of lists, dicts and sets, and those that make an
##! iterator or take every item of one, decoded and done here (D-086;
##! decisions 625 and 820). A call of an intrinsic gives the runtime in Rust its
##! descriptor, `u32` words: the intrinsic's number, the number of its
##! arguments and of its type arguments, the type of its result, of each
##! argument and each type argument; and the addresses of its result and
##! of each argument. For the intrinsics numbered here the runtime in Rust
##! reads the number alone and hands the rest to `export_collection`, which
##! reads the types, finds the values behind references, checks what the
##! call asks and does it, by `list.sisu`, `table.sisu` and `iter.sisu`; it asks the
##! runtime in Rust for what is that runtime's own: a panic, whose message
##! its catalog names, the drop of a value, which may run a program's glue
##! on the task's stack, and a view of a list's elements, an object it
##! keeps.

import rt.iter
import rt.list
import rt.search
import rt.table
import rt.value
from rt.host import memmove
from rt.host import sisu_rt_alloc
from rt.host import sisu_rt_drop_value
from rt.host import sisu_rt_f32_add
from rt.host import sisu_rt_free
from rt.host import sisu_rt_list_bounds
from rt.host import sisu_rt_list_view
from rt.host import sisu_rt_missing_key
from rt.host import sisu_rt_range_step
from rt.host import sisu_rt_slice_bounds
from rt.host import sisu_rt_sum_overflow
from rt.host import sisu_rt_unordered
from rt.types import A
from rt.types import CHAR
from rt.types import DICT
from rt.types import DYN
from rt.types import F32
from rt.types import FLOAT
from rt.types import ITER
from rt.types import LIST
from rt.types import PATH
from rt.types import REF
from rt.types import SET
from rt.types import SLICE
from rt.types import STR
from rt.types import STRING
from rt.types import Types
from rt.types import WORDS
from std.mem import ptr

# The intrinsics this module does, by their numbers in the runtime in
# Rust's `abi::Intrinsic`, each after its name (`sisu-rt`'s test
# `the_collections_numbers_are_the_runtimes` holds them to it).

