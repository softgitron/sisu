## The status of a call that did what it asked.
const OK: int = 0

## A bound of `Slice.slice` left out: `int`'s least value.
const OPEN: int = -9223372036854775807 - 1

## `int`'s greatest value.
const MOST: int = 9223372036854775807

## The most room `list.with_capacity` asks for at once, in elements.
const MOST_ROOM: int = 1048576

## A call of an intrinsic: the program's types, its descriptor, the
## address of its result, the block of its arguments' addresses, how what
## it drops is dropped (`value.drop`'s mode), and the descriptor's first
## six words, read once when the call is made (decision 862).
@derive(Copy)
struct Call:
    ts: Types
    desc: ptr[u8]
    ret: ptr mut u8
    args: ptr mut u8
    mode: int
    ## The descriptor's number of words: 4, and one for each argument and
    ## each type argument.
    words: int
    ## Its words 0 to 3: the intrinsic's number, its numbers of arguments
    ## and of type arguments, and the type of its result.
    id: int
    nargs: int
    ntargs: int
    rty: int
    ## Its words 4 and 5, the types of the first two arguments (or the
    ## first type arguments), -1 past its end.
    w4: int
    w5: int

impl Call:
    ## Word `k` of the descriptor, a `u32`: half of the word of eight bytes
    ## it is in, the lower half for an even `k`, as both backends align a
    ## descriptor to eight bytes, lay it out little-endian and give one of
    ## an odd number of words a word of 0 after them (decision 862), and the
    ## runtime's code reads no `u32` of its own (decision 646).
    ##
    ## Requires:
    ## - `call`: the call is the generated code's, whose descriptor has
    ##   word `k` and is aligned to eight bytes
    def word(self, k: int) -> int:
        # safety: in_bounds, valid, aligned: the descriptor's words `k` and
        #   the one beside it in the same word of eight bytes, by `call`.
        let w = unsafe self.desc.offset(8 * (k // 2)).cast[int]().read()
        if k % 2 == 0:
            return w & 4294967295
        return (w >> 32) & 4294967295

    ## Word `k` of the descriptor after its first four, from those read
    ## when the call was made when it is one of them.
    ##
    ## Requires:
    ## - `call`: as `word`
    def after_head(self, k: int) -> int:
        if k == 4:
            return self.w4
        if k == 5:
            return self.w5
        return self.word(k)

    ## The type of the call's result.
    def ret_ty(self) -> int:
        return self.rty

    ## The type of argument `i`, the first two's from the words read when
    ## the call was made, with no call (decision 902).
    ##
    ## Requires:
    ## - `call`: as `word`
    def ty(self, i: int) -> int:
        if i == 0:
            return self.w4
        if i == 1:
            return self.w5
        return self.word(4 + i)

    ## Type argument `k`, which the call has.
    def targ(self, k: int) -> int:
        return self.after_head(4 + self.nargs + k)

    ## The item type of the `Iterable[T]` argument `k`: its type argument
    ## `k`, -1 when the call gives none.
    def item(self, k: int) -> int:
        if k < self.ntargs:
            return self.targ(k)
        return -1

    ## The address argument `i` is at.
    ##
    ## Requires:
    ## - `call`: the call has argument `i`
    def arg(self, i: int) -> ptr mut u8:
        # safety: in_bounds, valid, aligned, writable: the block holds the
        #   address of each argument, which the call may change, by `call`.
        return unsafe self.args.cast[ptr[u8]]().offset(i).read().cast_mut()

    ## The value argument `i` is, or refers to, and its type: a value that
    ## is neither a reference nor a `dyn`, and a reference to one, found
    ## here from the type table's words, the others by `value.target`.
    ##
    ## Requires:
    ## - `call`: the call has argument `i`
    def place(self, i: int) -> (ptr mut u8, int):
        # `ty`, written out: a call of Sisu's convention costs more than it.
        var t = self.w4
        if i == 1:
            t = self.w5
        elif i > 1:
            t = self.word(4 + i)
        # safety: in_bounds, valid, aligned, writable: the block holds the
        #   address of each argument, which the call may change, by `call`; the table has a header of `WORDS` words
        #   for each type, and a reference's word is the address of its
        #   target.
        unsafe:
            let p = self.args.cast[ptr[u8]]().offset(i).read().cast_mut()
            let words = self.ts.words
            let k = words.offset(t * WORDS).read()
            if k == REF:
                let inner = words.offset(t * WORDS + A).read()
                let under = words.offset(inner * WORDS).read()
                if under != REF and under != DYN:
                    return (p.cast[ptr[u8]]().read().cast_mut(), inner)
            elif k != DYN:
                return (p, t)
            return value.target(self.ts, p, t)

    ## The first word of the value argument `i` is or refers to: a dict's or
    ## a set's table, an `int`.
    def first(self, i: int) -> int:
        let (p, _) = self.place(i)
        # safety: valid, aligned: every argument read so is at least a word.
        return unsafe p.cast[int]().read()

    ## The table of the dict or set argument `i` is or refers to.
    def table(self, i: int) -> ptr mut u8:
        let (p, _) = self.place(i)
        # safety: valid, aligned, writable: a dict's and a set's value is its
        #   table's address, which the call may change.
        return unsafe p.cast[ptr[u8]]().read().cast_mut()

    ## Word `k` of the result.
    ##
    ## Requires:
    ## - `room`: the result has room for `k + 1` words
    def set(self, k: int, w: int):
        # safety: in_bounds, aligned, writable: by `room`.
        unsafe self.ret.cast[int]().offset(k).write(w)

    ## An option's `None` as the result.
    def none(self):
        self.set(0, 1)

    ## An option's `Some` of a word as the result.
    def some(self, w: int):
        self.set(0, 0)
        self.set(1, w)

    ## A `bool` as the result.
    def set_bool(self, b: bool):
        self.set(0, if b: 1 else: 0)

## The drop of the value at `p` of type `t`, by the runtime in Rust: its
## status.
##
## Requires:
## - `typed`: `p` holds a live value of type `t`, dead afterwards
def dropped(p: ptr mut u8, t: int) -> int:
    # safety: returns_promptly: the runtime in Rust drops it, running its glue
    #   where the task's stack is needed.
    return unsafe sisu_rt_drop_value(p, t).to_int()

## A block of `n` bytes of scratch room, at least a word.
def scratch(n: int) -> ptr mut u8:
    # safety: returns_promptly: the runtime in Rust gives the block.
    return unsafe sisu_rt_alloc(max(n, 8))

## Frees a block of `scratch`.
def free(p: ptr mut u8):
    # safety: returns_promptly: the runtime in Rust frees the block.
    unsafe sisu_rt_free(p)

## Writes an empty list, or an empty `String`, at `p`: three words of 0.
##
## Requires:
## - `room`: `p` has room for three words
def empty(p: ptr mut u8):
    # safety: in_bounds, aligned, writable: by `room`.
    unsafe:
        let w = p.cast[int]()
        w.write(0)
        w.offset(1).write(0)
        w.offset(2).write(0)

## The bytes of the text at `p` of type `t`, behind any references: their
## address and their number, none for a value that is not a text.
##
## Requires:
## - `typed`: `p` holds a live value of type `t`
def text_of(ts: Types, p: ptr mut u8, t: int) -> (ptr mut u8, int):
    let (q, u) = value.target(ts, p, t)
    let k = ts.kind(u)
    if k != STR and k != STRING and k != PATH:
        return (q, 0)
    # safety: in_bounds, valid, aligned, writable: a text's first two words
    #   are the address of its bytes and their number, which are only read.
    unsafe:
        return (q.cast[ptr[u8]]().read().cast_mut(), q.cast[int]().offset(1).read())

## Writes the UTF-8 bytes of the character `c` at `out`: their number.
##
## Requires:
## - `room`: `out` has room for four bytes
def utf8(c: int, out: ptr mut u8) -> int:
    # safety: in_bounds, writable: by `room`; a byte needs no alignment.
    unsafe:
        if c < 128:
            out.write(u8.wrapping_from(c))
            return 1
        if c < 2048:
            out.write(u8.wrapping_from(192 + c // 64))
            out.offset(1).write(u8.wrapping_from(128 + c % 64))
            return 2
        if c < 65536:
            out.write(u8.wrapping_from(224 + c // 4096))
            out.offset(1).write(u8.wrapping_from(128 + (c // 64) % 64))
            out.offset(2).write(u8.wrapping_from(128 + c % 64))
            return 3
        out.write(u8.wrapping_from(240 + c // 262144))
        out.offset(1).write(u8.wrapping_from(128 + (c // 4096) % 64))
        out.offset(2).write(u8.wrapping_from(128 + (c // 64) % 64))
        out.offset(3).write(u8.wrapping_from(128 + c % 64))
        return 4

## `item in container`: an element of a list, a key of a dict or a set, or
## a piece of a text, a character or a text (`list.contains`, which `in`
## lowers to).
##
## Requires:
## - `typed`: `c` holds a live value of type `ct`, and `x` one of type `xt`
pub(package) def contains(ts: Types, c: ptr mut u8, ct: int, x: ptr mut u8, xt: int) -> bool:
    let (p, t) = value.target(ts, c, ct)
    let k = ts.kind(t)
    if k == LIST or k == SLICE:
        return list.contains(ts, p, ts.a(t), x, xt)
    if k == DICT or k == SET:
        # safety: valid, aligned, writable: a dict's and a set's value is its
        #   table's address, which a lookup only reads.
        return table.find(ts, unsafe p.cast[ptr[u8]]().read().cast_mut(), x, xt) >= 0
    if k != STR and k != STRING and k != PATH:
        return False
    let (hay, n) = text_of(ts, p, t)
    let (q, u) = value.target(ts, x, xt)
    if ts.kind(u) == CHAR:
        let buf = scratch(8)
        # safety: valid, aligned: a character is the word of its code.
        let m = utf8(unsafe q.cast[int]().read(), buf)
        let found = search.find(hay.as_const(), n, buf.as_const(), m) >= 0
        free(buf)
        return found
    let (needle, m) = text_of(ts, q, u)
    return search.find(hay.as_const(), n, needle.as_const(), m) >= 0

## The list intrinsics: the status.
##
## Requires:
## - `call`: `c` is a call of one of the list intrinsics above
def list_call(c: Call, id: int) -> int:
    let ts = c.ts
    if id == LIST_NEW:
        empty(c.ret)
        return OK
    if id == LIST_WITH_CAPACITY:
        empty(c.ret)
        let rt = c.ret_ty()
        if ts.kind(rt) == LIST:
            let room = min(max(c.first(0), 0), MOST_ROOM)
            list.reserve(c.ret, room, ts.size(ts.a(rt)))
        return OK
    if id == LIST_CONTAINS:
        # The container may be a text, a dict or a set too.
        c.set_bool(contains(ts, c.arg(0), c.ty(0), c.arg(1), c.ty(1)))
        return OK
    let (l, lt) = c.place(0)
    let e = ts.a(lt)
    let size = ts.size(e)
    let n = list.length(l)
    if id == LIST_PUSH:
        list.reserve(l, 1, size)
        # safety: in_bounds, writable: the buffer has room for one more
        #   element; returns_promptly: memmove moves its bytes in.
        unsafe:
            _ = memmove(list.buffer(l).offset(n * size), c.arg(1).as_const(), size)
        list.set_length(l, n + 1)
        return OK
    if id == LIST_POP:
        list.pop(ts, l, e, c.ret)
        return OK
    if id == LIST_GET or id == LIST_FIRST or id == LIST_LAST:
        var k = n - 1
        if id == LIST_GET:
            k = c.first(1)
        elif id == LIST_FIRST:
            k = 0
        if k >= 0 and k < n:
            # safety: in_bounds: `k` is an element of the buffer.
            c.some(unsafe list.buffer(l).offset(k * size).addr())
        else:
            c.none()
        return OK
    if id == LIST_IS_EMPTY:
        c.set_bool(n == 0)
        return OK
    if id == LIST_ITER:
        # The iterator of references into the list (decision 646).
        c.set(0, iter.new_list_ref(l, size).addr())
        return OK
    if id == LIST_INSERT:
        let k = c.first(1)
        if k < 0 or k > n:
            # safety: returns_promptly: the runtime in Rust raises the panic.
            let st = unsafe sisu_rt_list_bounds(True, k, n).to_int()
            return value.after_part(st, dropped(c.arg(2), e))
        list.insert(l, k, c.arg(2), size)
        return OK
    if id == LIST_REMOVE:
        let k = c.first(1)
        if k < 0 or k >= n:
            # safety: as above.
            return unsafe sisu_rt_list_bounds(False, k, n).to_int()
        list.remove(l, k, c.ret, size)
        return OK
    if id == LIST_EXTEND:
        list.extend(l, c.arg(1), size)
        return OK
    if id == LIST_REVERSE:
        list.reverse(l, size)
        return OK
    if id == LIST_SWAP:
        let (i, j) = (c.first(1), c.first(2))
        if i < 0 or i >= n:
            # safety: as above.
            return unsafe sisu_rt_list_bounds(False, i, n).to_int()
        if j < 0 or j >= n:
            # safety: as above.
            return unsafe sisu_rt_list_bounds(False, j, n).to_int()
        list.swap(l, i, j, size)
        return OK
    if id == LIST_CLEAR:
        # The list is empty before its old elements are dropped.
        let old = scratch(24)
        # safety: valid, writable: a list is three words; returns_promptly:
        #   memmove moves them aside.
        unsafe:
            _ = memmove(old, l.as_const(), 24)
        empty(l)
        let st = dropped(old, lt)
        free(old)
        return st
    if id == LIST_SLICE or id == LIST_SLICE_MIDDLE:
        var lo = 0
        var hi = 0
        let (a, b) = (c.first(1), c.first(2))
        if id == LIST_SLICE:
            if a < 0 or b < 0:
                # safety: returns_promptly: the runtime in Rust raises the
                #   panic.
                return unsafe sisu_rt_slice_bounds(a, b).to_int()
            lo = min(a, n)
            hi = max(min(b, n), lo)
        else:
            lo = min(a, n)
            hi = max(n - min(b, n), lo)
        if ts.kind(c.ret_ty()) == REF:
            # A `*rest` binding views the elements in place (decision 214).
            # safety: returns_promptly: the runtime in Rust makes the view.
            c.set(0, unsafe sisu_rt_list_view(l, size, lo, hi).addr())
        else:
            list.copies(ts, c.ret, l, e, lo, hi)
        return OK
    if id == LIST_JOIN:
        let (sep, m) = text_of(ts, c.arg(1), c.ty(1))
        empty(c.ret)
        list.join(ts, c.ret, l, e, sep, m)
        return OK
    if id == LIST_SORT:
        if not list.sort(ts, l, e):
            # safety: returns_promptly: the runtime in Rust raises the panic.
            return unsafe sisu_rt_unordered().to_int()
        return OK
    return OK

## The table of the entry at `e`: its first word.
##
## Requires:
## - `entry`: `e` holds a live `Entry`, its table's address and its key
def entry_table(e: ptr mut u8) -> ptr mut u8:
    # safety: valid, aligned, writable: by `entry`; the table is the dict's.
    return unsafe e.cast[ptr[u8]]().read().cast_mut()

## The key of the entry at `e`, after its table's address.
##
## Requires:
## - `entry`: as `entry_table`
def entry_key(e: ptr mut u8) -> ptr mut u8:
    # safety: in_bounds: by `entry`.
    return unsafe e.offset(8)

## The dict and set intrinsics: the status.
##
## Requires:
## - `call`: `c` is a call of one of the dict and set intrinsics above
def table_call(c: Call, id: int) -> int:
    let ts = c.ts
    if id >= DICT_GET_STR:
        return by_text(c, id)
    if id == DICT_NEW or id == SET_NEW:
        let rt = c.ret_ty()
        var val = -1
        if ts.kind(rt) == DICT:
            val = ts.header(rt).b
        c.set(0, table.new(ts, ts.a(rt), val).addr())
        return OK
    if id == ENTRY_OR_INSERT:
        # The entry is the dict's table and the key, moved in.
        let e = c.arg(0)
        let tb = entry_table(e)
        let key = entry_key(e)
        let kt = table.key_type(tb)
        let i = table.find(ts, tb, key, kt)
        if i >= 0:
            c.set(0, table.value_at(tb, i).addr())
            return value.after_part(dropped(c.arg(1), c.ty(1)), dropped(key, kt))
        let k = table.push(ts, tb, key)
        # safety: returns_promptly: memmove moves the value in.
        unsafe:
            _ = memmove(table.value_at(tb, k), c.arg(1).as_const(), table.value_size(tb))
        c.set(0, table.value_at(tb, k).addr())
        return OK
    let tb = c.table(0)
    if id == SET_ITER:
        # The iterator of references to the set's elements (decision 646).
        c.set(0, iter.table_part(tb, 0).addr())
        return OK
    if id == DICT_KEYS or id == DICT_VALUES or id == DICT_ITEMS:
        var part = 2
        if id == DICT_KEYS:
            part = 0
        elif id == DICT_VALUES:
            part = 1
        c.set(0, iter.table_part(tb, part).addr())
        return OK
    if id == DICT_IS_EMPTY or id == SET_IS_EMPTY:
        c.set_bool(table.length(tb) == 0)
        return OK
    if id == DICT_ENTRY:
        c.set(0, tb.addr())
        # safety: in_bounds, writable: an entry has room for the key after its
        #   table's address; returns_promptly: memmove moves the key in.
        unsafe:
            _ = memmove(c.ret.offset(8), c.arg(1).as_const(), ts.size(table.key_type(tb)))
        return OK
    let i = table.find(ts, tb, c.arg(1), c.ty(1))
    if id == DICT_GET:
        if i >= 0:
            c.some(table.value_at(tb, i).addr())
        else:
            c.none()
        return OK
    if id == DICT_CONTAINS or id == SET_CONTAINS:
        c.set_bool(i >= 0)
        return OK
    let (ksize, vsize) = (table.key_size(tb), table.value_size(tb))
    if id == DICT_INSERT:
        # Replaces the value of a key that is there, keeping its key and
        # dropping the one given, and gives the old value.
        if i >= 0:
            c.set(0, 0)
            # safety: in_bounds, writable: the result is an option of a value;
            #   returns_promptly: memmove moves the values.
            unsafe:
                _ = memmove(c.ret.offset(8), table.value_at(tb, i).as_const(), vsize)
                _ = memmove(table.value_at(tb, i), c.arg(2).as_const(), vsize)
            return dropped(c.arg(1), c.ty(1))
        let k = table.push(ts, tb, c.arg(1))
        # safety: returns_promptly: memmove moves the value in.
        unsafe:
            _ = memmove(table.value_at(tb, k), c.arg(2).as_const(), vsize)
        c.none()
        return OK
    if id == DICT_REMOVE or id == SET_REMOVE:
        if i < 0:
            if id == DICT_REMOVE:
                c.none()
            else:
                c.set_bool(False)
            return OK
        let out = scratch(table.pair_room(tb))
        table.remove(tb, i, out)
        if id == DICT_REMOVE:
            c.set(0, 0)
            # safety: in_bounds, writable: the result is an option of a value;
            #   returns_promptly: memmove moves it out.
            unsafe:
                _ = memmove(c.ret.offset(8), out.offset(ksize).as_const(), vsize)
        else:
            c.set_bool(True)
        let st = dropped(out, table.key_type(tb))
        free(out)
        return st
    if id == SET_ADD:
        if i >= 0:
            c.set_bool(False)
            return dropped(c.arg(1), c.ty(1))
        # The key is copied in as the set's key type, and the one given
        # dropped.
        let key = scratch(ksize)
        let (p, t) = c.place(1)
        value.copy(ts, key, p, t)
        _ = table.push(ts, tb, key)
        free(key)
        c.set_bool(True)
        return dropped(c.arg(1), c.ty(1))
    return OK

## The lookups by a `str` of a dict's or a set's `String` keys (decision
## 784), each its lookup by a key of the table's type but for the key
## given, a text whose bytes `table.find` hashes and compares with the
## keys' as `in` does, so no `String` is made: the status.
##
## Requires:
## - `call`: `c` is a call of one of the five intrinsics after `Slice.iter`
##   above, its key a `str` and the table's keys `String`s
def by_text(c: Call, id: int) -> int:
    if id == DICT_GET_STR:
        return table_call(c, DICT_GET)
    if id == DICT_REMOVE_STR:
        return table_call(c, DICT_REMOVE)
    if id == SET_CONTAINS_STR:
        return table_call(c, SET_CONTAINS)
    if id == SET_REMOVE_STR:
        return table_call(c, SET_REMOVE)
    # `dict.index_str`: the value's address, or the panic of a missing key.
    let tb = c.table(0)
    let i = table.find(c.ts, tb, c.arg(1), c.ty(1))
    if i < 0:
        # safety: returns_promptly: the runtime in Rust raises the panic,
        #   naming the key, which is live.
        return unsafe sisu_rt_missing_key(c.arg(1), c.ty(1)).to_int()
    c.set(0, table.value_at(tb, i).addr())
    return OK

## Writes at `p` a slice that views the `n` elements at `at` in place
## (decision 940): their address, their number and a capacity of 0, which
## marks a view, whose drop frees nothing.
##
## Requires:
## - `room`: `p` has room for three words
def view_of(p: ptr mut u8, at: ptr mut u8, n: int):
    # safety: in_bounds, aligned, writable: by `room`.
    unsafe:
        let w = p.cast[int]()
        w.write(at.addr())
        w.offset(1).write(n)
        w.offset(2).write(0)

## The intrinsics of a `Slice`, which views the elements of its list in
## place in a list's layout (decision 940), or holds copies of the bytes
## it was made from in a buffer of its own: the status.
##
## Requires:
## - `call`: `c` is a call of `list.as_slice` or one of `Slice`'s
##   intrinsics above
def slice_call(c: Call, id: int) -> int:
    let ts = c.ts
    let (l, lt) = c.place(0)
    if id == LIST_AS_SLICE:
        view_of(c.ret, list.buffer(l), list.length(l))
        return OK
    if id == SLICE_TO_LIST:
        value.copy_list(ts, c.ret, l, ts.a(lt))
        return OK
    let size = ts.size(ts.a(lt))
    let n = list.length(l)
    if id == SLICE_AT or id == SLICE_GET:
        let k = c.first(1)
        if k >= 0 and k < n:
            # safety: in_bounds: `k` is an element of the buffer.
            let at = unsafe list.buffer(l).offset(k * size).addr()
            if id == SLICE_GET:
                c.some(at)
            else:
                c.set(0, at)
            return OK
        if id == SLICE_GET:
            c.none()
            return OK
        # safety: returns_promptly: the runtime in Rust raises the panic.
        return unsafe sisu_rt_list_bounds(False, k, n).to_int()
    if id == SLICE_IS_EMPTY:
        c.set_bool(n == 0)
        return OK
    if id == SLICE_SLICE or id == SLICE_CUT:
        var lo = c.first(1)
        var hi = c.first(2)
        if lo == OPEN:
            lo = 0
        if hi == OPEN:
            hi = n
        if lo < 0 or hi < lo or hi > n:
            var bad = hi
            if lo < 0 or lo > n:
                bad = lo
            # safety: returns_promptly: the runtime in Rust raises the panic.
            return unsafe sisu_rt_list_bounds(False, bad, n).to_int()
        # safety: in_bounds: `lo` is at most the number of elements.
        view_of(c.ret, unsafe list.buffer(l).offset(lo * size), hi - lo)
        return OK
    if id == SLICE_ITER:
        c.set(0, iter.new_list_ref(l, size).addr())
    return OK

## The iterators' intrinsics: the status.
##
## Requires:
## - `call`: `c` is a call of one of the iterators' intrinsics above
## `sum` (decision 903): every item taken, first to last, then added as
## the runtime in Rust added them, floats pairwise in a fixed shape (D-074)
## and integers with their overflow checked, whose panic names the sum so
## far and the item; its status.
def sum_call(c: Call) -> int:
    let ts = c.ts
    let rt = c.ret_ty()
    let size = ts.size(rt)
    let items = scratch(24)
    var st = iter.collect(
        ts, iter.iterable(ts, c.arg(0), c.ty(0), c.item(0)), c.item(0), items, c.mode
    )
    let n = list.length(items)
    let b = list.buffer(items)
    let k = ts.kind(rt)
    if st == OK and (k == FLOAT or k == F32) and n == 0:
        # No item: 0.0, whose bits are 0.
        c.set(0, 0)
    elif st == OK and k == FLOAT:
        # safety: aligned, writable: the result is an `f64`.
        unsafe c.ret.cast[f64]().write(pairwise(b, size, 0, n))
    elif st == OK and k == F32:
        c.set(0, pairwise32(b, size, 0, n))
    elif st == OK:
        var total = 0
        var i = 0
        while i < n:
            # safety: in_bounds: item `i` of the list, an integer, a `u8`'s
            #   one byte (decision 1020).
            let v = value.int_at(ts, unsafe b.offset(i * size), rt)
            if (v > 0 and total > MOST - v) or (v < 0 and total < OPEN - v):
                # safety: returns_promptly: the runtime in Rust raises the
                #   panic.
                st = unsafe sisu_rt_sum_overflow(total, v).to_int()
                break
            total += v
            i += 1
        if st == OK:
            c.set(0, total)
    # safety: valid, aligned: a list's first word is its buffer's address,
    #   0 for none.
    if unsafe items.cast[int]().read() != 0:
        free(b)
    free(items)
    return st

## The sum of the `n` `f64`s from item `lo` of the items at `b`, `size`
## bytes each: the two halves' sums, the first half the smaller, added.
##
## Requires:
## - `items`: `b` holds items `lo` to `lo + n - 1`, at least one
def pairwise(b: ptr mut u8, size: int, lo: int, n: int) -> f64:
    if n == 1:
        # safety: in_bounds, valid, aligned: by `items`.
        return unsafe b.offset(lo * size).cast[f64]().read()
    let half = n // 2
    return pairwise(b, size, lo, half) + pairwise(b, size, lo + half, n - half)

## `pairwise` of `f32`s, each in the low half of its item's word: the bits
## of their sum, added by the runtime in Rust, since raw memory holds no
## `f32` that this code reads as one.
##
## Requires:
## - `items`: as `pairwise`
def pairwise32(b: ptr mut u8, size: int, lo: int, n: int) -> int:
    if n == 1:
        # safety: in_bounds: by `items`; an `f32` is its four bytes (decision
        #   1020).
        let at = unsafe b.offset(lo * size)
        var bits = 0
        var k = 3
        while k >= 0:
            # safety: in_bounds, valid: the item's bytes, by `items`.
            bits = bits * 256 + unsafe at.offset(k).read().to_int()
            k -= 1
        return bits
    let half = n // 2
    let (x, y) = (pairwise32(b, size, lo, half), pairwise32(b, size, lo + half, n - half))
    # safety: returns_promptly: the runtime in Rust adds them.
    return unsafe sisu_rt_f32_add(x, y)

def iter_call(c: Call, id: int) -> int:
    let ts = c.ts
    if id == RANGE:
        let step = c.first(2)
        if step == 0:
            # safety: returns_promptly: the runtime in Rust raises the panic.
            return unsafe sisu_rt_range_step().to_int()
        c.set(0, iter.new_range(c.first(0), c.first(1), step).addr())
        return OK
    if id == ITER_REF or id == ITER_MUT:
        # An iterator of references into the borrowed collection (decision
        # 781), or of a borrowed receiver's values.
        let (p, t) = c.place(0)
        let k = ts.kind(t)
        if k == LIST or k == SLICE:
            c.set(0, iter.new_list_ref(p, ts.size(ts.a(t))).addr())
        elif k == DICT or k == SET:
            let part = if k == DICT: 2 else: 0
            # safety: valid, aligned, writable: a dict's and a set's value is
            #   its table's address.
            let tb = unsafe p.cast[ptr[u8]]().read().cast_mut()
            c.set(0, iter.table_part(tb, part).addr())
        else:
            # A receiver, the one other value `iter.ref` is lowered for.
            # safety: valid, aligned: a receiver's word is its channel's
            #   number.
            let ch = unsafe p.cast[int]().read()
            c.set(0, iter.new_waiting(ch, ts.size(ts.a(t)), False).addr())
        return OK
    if id == ITER_OWN or id == ITER_OF:
        let rt = c.ret_ty()
        let item = if ts.kind(rt) == ITER: ts.a(rt) else: -1
        c.set(0, iter.iterable(ts, c.arg(0), c.ty(0), item).addr())
        return OK
    if id == SUM:
        return sum_call(c)
    let first = iter.iterable(ts, c.arg(0), c.ty(0), c.item(0))
    if id == ENUMERATE:
        c.set(0, iter.new_enumerate(first).addr())
        return OK
    if id == ZIP or id == ZIP_SHORTEST:
        let second = iter.iterable(ts, c.arg(1), c.ty(1), c.item(1))
        c.set(0, iter.new_zip(ts, first, second, id == ZIP, c.targ(0), c.targ(1)).addr())
        return OK
    if id == ANY or id == ALL:
        let want = id == ANY
        let room = scratch(16)
        var st = OK
        while True:
            st = iter.next(ts, first, room, c.mode)
            if st != OK:
                break
            # safety: in_bounds, valid, aligned: the room holds an option's
            #   tag and a `bool`'s word.
            let (tag, b) = unsafe (room.cast[int]().read(), room.cast[int]().offset(1).read())
            if tag != 0:
                c.set_bool(not want)
                break
            if (b != 0) == want:
                c.set_bool(want)
                break
        free(room)
        return value.after_part(st, iter.drop(ts, first, c.mode))
    if id == ITERABLE_LIST:
        return iter.collect(ts, first, c.item(0), c.ret, c.mode)
    # `reversed` and `sorted`: every item, of the call's type argument.
    let t = c.targ(0)
    if id == SORTED:
        let st = iter.collect(ts, first, t, c.ret, c.mode)
        if st != OK:
            return st
        if not list.sort(ts, c.ret, t):
            # safety: returns_promptly: the runtime in Rust raises the panic.
            let raised = unsafe sisu_rt_unordered().to_int()
            _ = dropped(c.ret, c.ret_ty())
            return raised
        return OK
    let items = scratch(24)
    let st = iter.collect(ts, first, t, items, c.mode)
    if st == OK:
        list.reverse(items, ts.size(t))
        c.set(0, iter.new_items(ts, items, t).addr())
    free(items)
    return st

## A dict or a set of type `t` from a literal's `n` entries at `items`, each
## the key's bytes and then the value's as an entry holds them after its
## hash (`table.pair_room` bytes, decision 1100), moved in, its table's address
## written at `out`: a key given again replaces the value and is itself
## dropped, as `insert` does (decision 646). The status of the drops.
##
## Requires:
## - `typed`: `t` is a dict's or a set's type, `items` holds `n` live
##   entries of its key and value, and `out` has room for a word
pub(package) def literal(ts: Types, t: int, items: ptr mut u8, n: int, out: ptr mut u8) -> int:
    let kt = ts.a(t)
    var vt = -1
    if ts.kind(t) == DICT:
        vt = ts.header(t).b
    let tb = table.new(ts, kt, vt)
    let (ksize, vsize, stride) = (table.key_size(tb), table.value_size(tb), table.pair_room(tb))
    var st = OK
    var i = 0
    while i < n:
        # safety: in_bounds: entry `i` is in `items`, by `typed`.
        let key = unsafe items.offset(i * stride)
        # safety: in_bounds: its value follows its key.
        let val = unsafe key.offset(ksize)
        let j = table.find(ts, tb, key, kt)
        if j >= 0:
            if vsize > 0:
                st = value.after_part(st, dropped(table.value_at(tb, j), vt))
            # safety: returns_promptly: memmove moves the value in.
            unsafe:
                _ = memmove(table.value_at(tb, j), val.as_const(), vsize)
            st = value.after_part(st, dropped(key, kt))
        else:
            let k = table.push(ts, tb, key)
            # safety: returns_promptly: memmove moves the value in.
            unsafe:
                _ = memmove(table.value_at(tb, k), val.as_const(), vsize)
        i += 1
    # safety: valid, aligned, writable: by `typed`.
    unsafe out.cast[int]().write(tb.addr())
    return st

## The generated code's inline lookup of the key at `key`, of type `kt`, in
## the dict or set at `p` (decision 265): for `dict.get` (`want_value`) the
## address of the key's value, for `contains` 1, when the key is there;
## else 0.
##
## Requires:
## - `typed`: `p` holds a live dict or set and `key` a live value of type
##   `kt`
pub(package) def find(ts: Types, p: ptr mut u8, key: ptr mut u8, kt: int, want_value: bool) -> int:
    # safety: valid, aligned, writable: a dict's and a set's value is its
    #   table's address, which a lookup only reads.
    let tb = unsafe p.cast[ptr[u8]]().read().cast_mut()
    let i = table.find(ts, tb, key, kt)
    if i < 0:
        return 0
    if want_value:
        return table.value_at(tb, i).addr()
    return 1

## The generated code's inline removal of the key at `key`, of type `kt`,
## from the dict or set at `p` (decision 861), as `dict.remove` and
## `set.remove` take it out: for a dict (`want_value`) the option of its
## value written at `out`, for a set whether it was there; the key the
## table held is dropped. The status of that drop.
##
## Requires:
## - `typed`: `p` holds a live dict or set, `key` a live value of type `kt`
##   and `out` room for the result
pub(package) def take(
    ts: Types, p: ptr mut u8, key: ptr mut u8, kt: int, want_value: bool, out: ptr mut u8
) -> int:
    # safety: valid, aligned, writable: a dict's and a set's value is its
    #   table's address.
    let tb = unsafe p.cast[ptr[u8]]().read().cast_mut()
    let i = table.find(ts, tb, key, kt)
    let w = out.cast[int]()
    if i < 0:
        # safety: aligned, writable: by `typed`, the result's first word is
        #   an option's tag or a `bool`.
        unsafe w.write(if want_value: 1 else: 0)
        return OK
    let (ksize, vsize) = (table.key_size(tb), table.value_size(tb))
    let room = scratch(table.pair_room(tb))
    table.remove(tb, i, room)
    if want_value:
        # safety: in_bounds, writable: the result is an option of a value;
        #   returns_promptly: memmove moves it out.
        unsafe:
            w.write(0)
            _ = memmove(out.offset(8), room.offset(ksize).as_const(), vsize)
    else:
        # safety: aligned, writable: the result's first word is a `bool`.
        unsafe w.write(1)
    let st = dropped(room, table.key_type(tb))
    free(room)
    return st

## `sisu_rt_dict_slot`'s modes (`abi::SLOT_READ` and its kin): a missing
## key panics, is inserted, or is nothing to drop.
const SLOT_WRITE: int = 1
const SLOT_DROP: int = 2

## The address of the value under the key at `key`, of type `kt` behind
## any references, in the dict at `p`: `d{k}`'s slot (decision 681). A key
## the dict does not hold is appended, a copy of it, for `SLOT_WRITE`,
## whose value the caller writes; is 0 for `SLOT_DROP`; and is -1 for a
## read, whose panic, naming the key, the runtime in Rust raises.
##
## Requires:
## - `typed`: `p` holds a live dict and `key` a live value of type `kt`
pub(package) def slot(ts: Types, p: ptr mut u8, key: ptr mut u8, kt: int, mode: int) -> int:
    # safety: valid, aligned, writable: a dict's value is its table's
    #   address.
    let tb = unsafe p.cast[ptr[u8]]().read().cast_mut()
    let i = table.find(ts, tb, key, kt)
    if i >= 0:
        return table.value_at(tb, i).addr()
    if mode == SLOT_WRITE:
        return table.value_at(tb, table.push_copy(ts, tb, key, kt)).addr()
    if mode == SLOT_DROP:
        return 0
    return -1

## A call of one of the intrinsics above: `desc` its descriptor, `ret` the
## address of its result and `args` the block of its arguments' addresses,
## the types those of the table at `types`, `mode` how what it drops is
## dropped. Its status: 0, or that of the panic it raised.
##
## Requires:
## - `call`: `desc`, `ret` and `args` are a call of the generated code of an
##   intrinsic numbered above, whose arguments are live values of the types
##   its descriptor gives
pub(package) def collection(
    types: ptr[int], desc: ptr[u8], ret: ptr mut u8, args: ptr mut u8, mode: int
) -> int:
    # The descriptor's first words, two to a word of eight bytes, read
    # once (decision 862).
    # safety: in_bounds, valid, aligned: a descriptor has its four words
    #   and is aligned to eight bytes, by `call`.
    let (head, counts) = unsafe (desc.cast[int]().read(), desc.offset(8).cast[int]().read())
    let words = 4 + ((head >> 32) & 4294967295) + (counts & 4294967295)
    var c = Call(
        ts=Types(words=types),
        desc=desc,
        ret=ret,
        args=args,
        mode=mode,
        words=words,
        id=head & 4294967295,
        nargs=(head >> 32) & 4294967295,
        ntargs=counts & 4294967295,
        rty=(counts >> 32) & 4294967295,
        w4=-1,
        w5=-1,
    )
    if words >= 5:
        # safety: in_bounds, valid, aligned: words 4 and 5 (or the 0 after
        #   word 4), in the third word of eight bytes, by `call`.
        let pair = unsafe desc.offset(16).cast[int]().read()
        c.w4 = pair & 4294967295
        if words >= 6:
            c.w5 = (pair >> 32) & 4294967295
    let id = c.id
    if id <= ITER_OF:
        return iter_call(c, id)
    if id >= LIST_NEW and id <= LIST_SORT:
        return list_call(c, id)
    if id >= LIST_AS_SLICE and id <= SLICE_ITER:
        return slice_call(c, id)
    return table_call(c, id)
