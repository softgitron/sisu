##! The runtime in Rust (`crates/sisu-rt`) as the runtime's Sisu code calls
##! it (decision 350): its allocation, which counts the program's blocks;
##! what it keeps as objects of its own, which it alone drops, copies and
##! shows (iterators, channels, the guards of mutexes, `Shared` cells,
##! arenas, the cells of capability handles, return traces, tasks); the
##! program's drop glue, which it calls through the function table; and C's
##! `memmove` and `memcmp`, which move and compare bytes. The code the backend writes for this package makes no call of
##! `sisu_rt_flush` before these, as it does before a program's foreign
##! calls: they are the runtime's own.

from std.mem import ptr

# safety: the runtime in Rust defines each `sisu_rt_` function with this C
#   signature, and C's library `memmove` and `memcmp`; none unwinds, and each
#   returns at once, but `sisu_rt_abort_unwind`, which ends the process.
extern "C":
    ## A block of `bytes` of heap memory, counted among the program's
    ## allocations; null for none.
    pub def sisu_rt_alloc(bytes: int) -> ptr mut u8
    ## The block at `p` (null for none) grown, or made, to `bytes`, keeping
    ## what it held.
    pub def sisu_rt_grow(p: ptr mut u8, bytes: int) -> ptr mut u8
    ## Frees a block of `sisu_rt_alloc`.
    pub def sisu_rt_free(p: ptr mut u8)
    ## A panic while the parts after a panicking one were dropped: the
    ## program aborts with both messages.
    pub def sisu_rt_abort_unwind()
    ## Runs the drop glue at index `glue` of the function table on the value
    ## at `p`; the status.
    pub def sisu_rt_glue(glue: int, p: ptr mut u8) -> u8
    ## Moves the value at `p` of type `t` aside, to be dropped on the task's
    ## stack, since this code runs on the system stack (decision 350).
    pub def sisu_rt_defer(p: ptr mut u8, t: int) -> u8
    ## Drops the value at `p` of a type whose objects the runtime in Rust
    ## keeps; the status.
    pub def sisu_rt_object_drop(p: ptr mut u8, t: int) -> u8
    ## Copies the value at `src` of such a type to `dst`.
    pub def sisu_rt_object_copy(dst: ptr mut u8, src: ptr mut u8, t: int)
    ## One more count for the capability handle at `p` (decision 237).
    pub def sisu_rt_object_retain(p: ptr mut u8, t: int)
    ## The error value at `p` lets go of its return trace, which is gone.
    pub def sisu_rt_trace_release(p: ptr mut u8)
    ## The error value at `p` is a copy: its return trace is held once more.
    pub def sisu_rt_trace_retain(p: ptr mut u8)
    ## Whether the `Shared` cell at `cell` still holds its value.
    pub def sisu_rt_shared_alive(cell: ptr mut u8) -> bool
    ## Appends to the `String` at `out` the `Debug` text of the task whose
    ## number is `task` (`<task PATH>`) and of the arena at `p`.
    pub def sisu_rt_show_task(out: ptr mut u8, task: int)
    pub def sisu_rt_show_arena(out: ptr mut u8, p: ptr mut u8)
    ## The next item of the generator whose task is `task`, `size` bytes,
    ## written at `out`, which it runs to its `yield`: 0 for an item, 1 for
    ## its end, else 2 plus the status of the panic it ended with, raised
    ## (decision 423).
    pub def sisu_rt_gen_item(task: int, out: ptr mut u8, size: int) -> int
    ## The value the channel `chan` holds now, `size` bytes, written at `out`
    ## and taken: 0 for a value, 1 for its end, else 2 plus the status of the
    ## panic raised for a receiver that would wait inside another iterator.
    pub def sisu_rt_recv_item(chan: int, out: ptr mut u8, size: int) -> int
    ## Closes the generator whose task is `task`, dropped before its end
    ## (decision 236): the status of what it drops.
    pub def sisu_rt_gen_abandon(task: int) -> u8
    ## Raises the panic of `zip` given two lengths: its status.
    pub def sisu_rt_zip_lengths() -> u8
    ## Raises the panic of an index `index` outside a list of `len`
    ## elements, of `insert` when `insert` (decision 562): its status.
    pub def sisu_rt_list_bounds(insert: bool, index: int, len: int) -> u8
    ## Raises the panic of a slice whose bounds `start` and `end` are not
    ## both at least 0 (decision 625): its status.
    pub def sisu_rt_slice_bounds(start: int, end: int) -> u8
    ## Raises the panic of a key the dict does not hold, the key at `key`
    ## of type `kt` (decision 784): its status.
    pub def sisu_rt_missing_key(key: ptr mut u8, kt: int) -> u8
    ## Raises the panic of a sort that met two elements without an order:
    ## its status.
    pub def sisu_rt_unordered() -> u8
    ## Raises the panic of a range whose step is 0 (decision 820): its
    ## status.
    pub def sisu_rt_range_step() -> u8
    ## Raises the panic of `sum`'s overflow, the sum so far `total` and the
    ## item `item` (decision 903): its status.
    pub def sisu_rt_sum_overflow(total: int, item: int) -> u8
    ## The bits of the sum of two `f32`s given by their bits, in the low
    ## halves (`sum`, decision 903).
    pub def sisu_rt_f32_add(x: int, y: int) -> int
    ## Drops the value at `p` of type `t`, running its glue on the task's
    ## stack where it needs it: the status.
    pub def sisu_rt_drop_value(p: ptr mut u8, t: int) -> u8
    ## A view of the elements `lo` to `hi`, `size` bytes each, of the list at
    ## `l` (a `*rest` binding, decision 214): the address of its header.
    pub def sisu_rt_list_view(l: ptr mut u8, size: int, lo: int, hi: int) -> ptr mut u8
    ## Copies `n` bytes from `src` to `dst`; the regions may overlap.
    pub def memmove(dst: ptr mut u8, src: ptr[u8], n: int) -> ptr mut u8
    ## The order of the `n` bytes at `a` and at `b`: 0 when they are the same.
    pub def memcmp(a: ptr[u8], b: ptr[u8], n: int) -> i32
