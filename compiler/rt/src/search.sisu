##! Text search (decision 350): where a run of bytes first occurs in
##! another, by Crochemore and Perrin's Two-Way, as the prelude's
##! `str.byte_find` searches a text (`compiler/std/prelude.sisu`): linear in
##! the lengths of the two, in constant space. The runtime in Rust calls it
##! for `in` on texts and for `bytes.find`, `starts_with` and `ends_with`.

from rt.words import byte
from std.mem import ptr

## The critical position and period of the part's maximal suffix, by the
## order of its bytes or by its reverse (`str.maximal_suffix`).
##
## Requires:
## - `inside`: `part` points to `m` live bytes
def maximal_suffix(part: ptr mut u8, m: int, reversed: bool) -> (int, int):
    var cut = -1
    var j = 0
    var k = 1
    var p = 1
    while j + k < m:
        # safety: inside: both positions are below `m`.
        let (a, b) = unsafe (byte(part, j + k), byte(part, cut + k))
        if a == b:
            if k != p:
                k += 1
            else:
                j += p
                k = 1
        elif (a < b) != reversed:
            j += k
            k = 1
            p = j - cut
        else:
            cut = j
            j = cut + 1
            k = 1
            p = 1
    return (cut, p)

## Whether the `count` bytes at positions `a` and `b` of the part are the
## same.
##
## Requires:
## - `inside`: both runs of bytes are within the part's live bytes
def same_run(part: ptr mut u8, a: int, b: int, count: int) -> bool:
    var k = 0
    while k < count:
        # safety: inside: this function's.
        if unsafe byte(part, a + k) != unsafe byte(part, b + k):
            return False
        k += 1
    return True

## The position of the first occurrence of the `m` bytes at `part` in the
## `n` bytes at `text`, or -1; an empty part occurs at 0.
##
## Requires:
## - `inside`: `text` points to `n` live bytes and `part` to `m`
pub(package) def find(text: ptr mut u8, n: int, part: ptr mut u8, m: int) -> int:
    let last = n - m
    if m == 0:
        return if last >= 0: 0 else: -1
    # safety: inside: every position read is below `m` in the part and below
    #   `n` in the text, as the loops' bounds keep them.
    unsafe:
        if m == 1:
            let b = byte(part, 0)
            var i = 0
            while i <= last:
                if byte(text, i) == b:
                    return i
                i += 1
            return -1
        # The critical factorization: the later of the two maximal suffixes,
        # by the order of the bytes and by its reverse. The part is matched
        # right of it first, then left of it.
        let (s1, p1) = maximal_suffix(part, m, False)
        let (s2, p2) = maximal_suffix(part, m, True)
        let (cut, period) = if s1 > s2: (s1, p1) else: (s2, p2)
        var j = 0
        if same_run(part, 0, period, cut + 1):
            # A periodic part: after a whole match of the right side, the
            # bytes a shift by the period keeps are not compared again.
            var memory = -1
            while j <= last:
                var i = max(cut, memory) + 1
                while i < m and byte(part, i) == byte(text, i + j):
                    i += 1
                if i >= m:
                    i = cut
                    while i > memory and byte(part, i) == byte(text, i + j):
                        i -= 1
                    if i <= memory:
                        return j
                    j += period
                    memory = m - period - 1
                else:
                    j += i - cut
                    memory = -1
            return -1
        let shift = max(cut + 1, m - cut - 1) + 1
        while j <= last:
            var i = cut + 1
            while i < m and byte(part, i) == byte(text, i + j):
                i += 1
            if i >= m:
                i = cut
                while i >= 0 and byte(part, i) == byte(text, i + j):
                    i -= 1
                if i < 0:
                    return j
                j += shift
            else:
                j += i - cut
        return -1

## Whether the `n` bytes at `text` start with the `m` at `part`, or end with
## them (`at_end`).
##
## Requires:
## - `inside`: `text` points to `n` live bytes and `part` to `m`
pub(package) def has_edge(text: ptr mut u8, n: int, part: ptr mut u8, m: int, at_end: bool) -> bool:
    if m > n:
        return False
    let start = if at_end: n - m else: 0
    var k = 0
    while k < m:
        # safety: inside: both positions are within the bytes.
        if unsafe byte(text, start + k) != unsafe byte(part, k):
            return False
        k += 1
    return True
