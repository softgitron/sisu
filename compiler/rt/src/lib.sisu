##! The runtime of native code in Sisu (D-086; D-087, step 3): the functions
##! the generated code and the runtime in Rust call by symbol, with Sisu's
##! own convention (decision 189: the result's address, then each
##! argument's, and the status byte), compiled once into an object that every
##! native program is linked with. Each `export_NAME` function of this module
##! is the symbol `sisu_rt_NAME`; what they call is compiled with them. The
##! code is the runtime's own: it counts no frame and passes no yield point,
##! as drop glue does not, and it reaches raw memory only through the
##! operations of std.mem the backend compiles inline. A value is walked by
##! its type in the program's table, which the runtime in Rust lays out in
##! memory when the program starts and passes to each structural operation
##! (`types.sisu`, decision 350). Each function replaces its counterpart in
##! the runtime in Rust (`crates/sisu-rt`), which is deleted.

import rt.floats
import rt.iter
import rt.list
import rt.search
import rt.show
import rt.table
import rt.text
import rt.time
import rt.value
from rt.host import memcmp
from rt.host import memmove
from rt.types import Types
from std.mem import ptr

## Whether the `n` bytes at `a` and `b` are the same: `==` of two texts of
## one length (decision 253), whose lengths the code compares first.
##
## Requires:
## - `readable`: `a` and `b` each point to `n` live bytes
def export_bytes_eq(a: ptr[u8], b: ptr[u8], n: int) -> bool:
    if n == 0:
        return True
    # safety: returns_promptly: memcmp reads the `n` bytes of each, which
    #   this function's `readable` says are live.
    return unsafe memcmp(a, b, n) == 0

## Structural equality of the value at `a` of type `ta` and the value at `b`
## of type `tb` (`value.equal`), in the table at `types`.
##
## Requires:
## - `typed`: `types` is the program's table, and `a` and `b` hold live
##   values of types `ta` and `tb`
def export_value_eq(types: ptr[int], a: ptr mut u8, ta: int, b: ptr mut u8, tb: int) -> bool:
    return value.equal(Types(words=types), a, ta, b, tb)

## The order of the value at `a` of type `ta` and the value at `b` of type
## `tb` (`value.order`): -1, 0 or 1, and 2 for none.
##
## Requires:
## - `typed`: `types` is the program's table, and `a` and `b` hold live
##   values of types `ta` and `tb`
def export_value_cmp(types: ptr[int], a: ptr mut u8, ta: int, b: ptr mut u8, tb: int) -> int:
    return value.order(Types(words=types), a, ta, b, tb)

## The structural hash of the value at `p` of type `t` mixed into `state`
## (`value.hash`, decision 256).
##
## Requires:
## - `typed`: `types` is the program's table, and `p` holds a live value of
##   type `t`
def export_value_hash(types: ptr[int], state: int, p: ptr mut u8, t: int) -> int:
    return value.hash(Types(words=types), state, p, t)

## `.copy()` of the value at `src` of type `t`, written at `dst`
## (`value.copy`).
##
## Requires:
## - `typed`: `types` is the program's table, `src` holds a live value of
##   type `t`, and `dst` has room for one
def export_value_copy(types: ptr[int], dst: ptr mut u8, src: ptr mut u8, t: int):
    value.copy(Types(words=types), dst, src, t)

## The drop of the value at `p` of type `t` (`value.drop`): its status, 1
## when a panic is leaving.
##
## Requires:
## - `typed`: `types` is the program's table, and `p` holds a live value of
##   type `t`, dead afterwards
def export_value_drop(types: ptr[int], p: ptr mut u8, t: int, mode: int) -> int:
    return value.drop(Types(words=types), p, t, mode)

## The drop of the fields the glue of the struct or enum at `p` of type `t`
## leaves out, once the glue has run (`value.drop_rest`): its status.
##
## Requires:
## - `typed`: `types` is the program's table, and `p` holds a live value of
##   type `t` whose glue has run, dead afterwards
def export_value_drop_rest(types: ptr[int], p: ptr mut u8, t: int, mode: int) -> int:
    return value.drop_rest(Types(words=types), p, t, mode)

## One more count for each capability handle the value at `p` of type `t`
## holds (`value.retain`, decision 237).
##
## Requires:
## - `typed`: `types` is the program's table, and `p` holds a live value of
##   type `t`
def export_value_retain(types: ptr[int], p: ptr mut u8, t: int):
    value.retain(Types(words=types), p, t)

## Appends to the `String` at `out` the `Display` text of the value at `p`
## of type `t` (`show.display`, decision 383): `fmt.display` of a value whose
## impl is structural, `print`, `list.join`.
##
## Requires:
## - `typed`: `types` is the program's table, `p` holds a live value of type
##   `t`, and `out` a live `String`
def export_value_display(types: ptr[int], out: ptr mut u8, p: ptr mut u8, t: int):
    show.display(Types(words=types), out, p, t)

## Appends to the `String` at `out` the `Debug` text of the value at `p` of
## type `t` (`show.debug`, decision 383): `fmt.debug`, the sides of a failed
## `assert`, the error `main` returns.
##
## Requires:
## - `typed`: `types` is the program's table, `p` holds a live value of type
##   `t`, and `out` a live `String`
def export_value_debug(types: ptr[int], out: ptr mut u8, p: ptr mut u8, t: int):
    show.debug(Types(words=types), out, p, t)

## Appends the `n` bytes at `b` to the `String` at `t`: `String.push`,
## `fmt.text`, and `fmt.display` of a text (decisions 265 and 351).
##
## Requires:
## - `text`: `t` holds a live `String`, and `b` points to `n` live bytes
def export_text_push(t: ptr mut u8, b: ptr mut u8, n: int):
    if n <= 0:
        return
    # safety: text: this function's; valid, aligned, writable, in_bounds: the
    #   buffer has room for the bytes after its length; returns_promptly:
    #   memmove copies them.
    unsafe:
        let words = t.cast[int]()
        let len = words.offset(1).read()
        var source = b
        if len + n > words.offset(2).read():
            source = text.grow(t, len + n, b)
        let bytes = words.cast[ptr[u8]]().read().cast_mut()
        _ = memmove(bytes.offset(len), source.as_const(), n)
        words.offset(1).write(len + n)

## Appends the decimal digits of `n` to the `String` at `t`, after a `-`
## when it is negative, as `Display` writes an `int`: `fmt.display` of an
## `int` (decisions 265 and 351). The digits are worked out on the negative
## of the magnitude, whose quotient by 10 rounded toward zero is `(m + 9) //
## 10`, so that the most negative `int` needs no positive counterpart.
##
## Requires:
## - `text`: `t` holds a live `String`
def export_text_push_int(t: ptr mut u8, n: int):
    let m = if n < 0: n else: -n
    var digits = 1
    var x = m
    while x <= -10:
        x = (x + 9) // 10
        digits += 1
    let total = digits + (if n < 0: 1 else: 0)
    # safety: text: this function's; valid, aligned, writable, in_bounds: the
    #   buffer has room for `total` bytes after its length, and a byte needs
    #   no alignment.
    unsafe:
        let words = t.cast[int]()
        let len = words.offset(1).read()
        if len + total > words.offset(2).read():
            _ = text.grow(t, len + total, t)
        let bytes = words.cast[ptr[u8]]().read().cast_mut().offset(len)
        if n < 0:
            bytes.write(u8.wrapping_from(45))
        var pos = total - 1
        x = m
        while True:
            let q = (x + 9) // 10
            bytes.offset(pos).write(u8.wrapping_from(48 + q * 10 - x))
            pos -= 1
            x = q
            if x == 0:
                break
        words.offset(1).write(len + total)

## Writes at `dst` a new `String` holding the `n` bytes at `b`, no buffer
## when there are none, else one of at least 16 bytes: `str.to_string` and
## `String.new` (decisions 265 and 351).
##
## Requires:
## - `text`: `dst` has room for a `String`, and `b` points to `n` live bytes
def export_text_from(dst: ptr mut u8, b: ptr mut u8, n: int):
    text.from_bytes(dst, b, n)

## Writes at `dst` a new `String` of the digits of the magnitude whose words
## are `low` and `high`, in `base`, capitals with `upper` (`text.digits`):
## `fmt.digits` and `fmt.wide_digits`.
##
## Requires:
## - `text`: `dst` has room for a `String`
def export_int_digits(dst: ptr mut u8, low: int, high: int, base: int, upper: bool):
    text.digits(dst, low, high, base, upper)

## Writes at `dst` a new `String` of the float whose bits are `bits`, in
## the form `mode` with `precision` digits after the point
## (`floats.write`): `fmt.float_digits`, `fmt.float32_digits` and a float's
## `Debug`.
##
## Requires:
## - `text`: `dst` has room for a `String`
def export_float_digits(dst: ptr mut u8, bits: int, mode: int, precision: int):
    floats.write(dst, bits, mode, precision)

## Appends to the `String` at `out` the time `nanos` by the `n` bytes of
## `strftime` directives at `pat`, or, with `n` -1, its RFC 3339 text
## (`time.sisu`, decision 469): `fmt.strftime` and a `DateTime`'s text.
##
## Requires:
## - `text`: `out` holds a live `String`, and `pat` points to `n` live
##   bytes
def export_time_text(out: ptr mut u8, nanos: int, pat: ptr mut u8, n: int):
    if n < 0:
        time.rfc3339(out, nanos)
    else:
        time.strftime(out, nanos, pat, n)

## Appends to the `String` at `out` the `n` bytes of UTF-8 at `b` quoted
## as `Debug` writes a text (`show.quote_str`, decision 469): a hole's
## name in its panic.
##
## Requires:
## - `text`: `out` holds a live `String`, and `b` points to `n` live bytes
##   of UTF-8
def export_quote(out: ptr mut u8, b: ptr mut u8, n: int):
    show.quote_str(out, b, n)

## The position of the first occurrence of the `m` bytes at `part` in the
## `n` bytes at `text`, or -1 (`search.find`): `in` on texts and
## `bytes.find`.
##
## Requires:
## - `readable`: `text` points to `n` live bytes and `part` to `m`
def export_find(text: ptr[u8], n: int, part: ptr[u8], m: int) -> int:
    return search.find(text, n, part, m)

## Whether the `n` bytes at `text` start with the `m` at `part`, or end with
## them (`at_end`; `search.has_edge`): `bytes.starts_with` and `ends_with`.
##
## Requires:
## - `readable`: `text` points to `n` live bytes and `part` to `m`
def export_has_edge(text: ptr[u8], n: int, part: ptr[u8], m: int, at_end: bool) -> bool:
    return search.has_edge(text, n, part, m, at_end)

## Room in the list at `l` for `extra` more elements of `size` bytes
## (`list.reserve`, decision 385): a push without room, which the generated
## code asks `sisu_rt_list_reserve` for, and every list the runtime builds.
##
## Requires:
## - `list`: `l` holds a live list of elements of `size` bytes
def export_list_grow(l: ptr mut u8, extra: int, size: int):
    list.reserve(l, extra, size)

## `list.pop`: the last element of the list at `l`, of type `e`, moved out
## into the option at `ret` (`list.pop`).
##
## Requires:
## - `typed`: `types` is the program's table, `l` holds a live list of
##   elements of type `e`, and `ret` has room for an option of one
def export_list_pop(types: ptr[int], l: ptr mut u8, e: int, ret: ptr mut u8):
    list.pop(Types(words=types), l, e, ret)

## `list.insert` once its index is checked: the element at `value` moved in
## at index `k` (`list.insert`).
##
## Requires:
## - `list`: `l` holds a live list of elements of `size` bytes, `value` a
##   live element, which moves in, and `0 <= k <= len`
def export_list_insert(l: ptr mut u8, k: int, value: ptr mut u8, size: int):
    list.insert(l, k, value, size)

## `list.remove` once its index is checked: element `k` moved out to `ret`
## (`list.remove`).
##
## Requires:
## - `list`: `l` holds a live list of elements of `size` bytes, `ret` has
##   room for one, and `0 <= k < len`
def export_list_remove(l: ptr mut u8, k: int, ret: ptr mut u8, size: int):
    list.remove(l, k, ret, size)

## `list.extend`: the elements of the list at `other` moved to the end of
## the one at `l` (`list.extend`).
##
## Requires:
## - `list`: `l` and `other` hold live lists of elements of `size` bytes,
##   and `other` is not used again
def export_list_extend(l: ptr mut u8, other: ptr mut u8, size: int):
    list.extend(l, other, size)

## `list.reverse` (`list.reverse`).
##
## Requires:
## - `list`: `l` holds a live list of elements of `size` bytes
def export_list_reverse(l: ptr mut u8, size: int):
    list.reverse(l, size)

## `list.swap` once its indices are checked (`list.swap`).
##
## Requires:
## - `list`: `l` holds a live list of elements of `size` bytes, and `i` and
##   `j` are indices of it
def export_list_swap(l: ptr mut u8, i: int, j: int, size: int):
    list.swap(l, i, j, size)

## A slice of a list: a new list at `dst` of copies of the elements from
## `lo` to `hi` of the one at `l`, of type `e` (`list.copies`).
##
## Requires:
## - `typed`: `types` is the program's table, `l` holds a live list of
##   elements of type `e`, `dst` has room for a list, and
##   `0 <= lo <= hi <= len`
def export_list_copies(types: ptr[int], dst: ptr mut u8, l: ptr mut u8, e: int, lo: int, hi: int):
    list.copies(Types(words=types), dst, l, e, lo, hi)

## Whether the list at `l`, of type `e`, holds an element equal to the
## value at `x` of type `tx`: `in` on a list (`list.contains`).
##
## Requires:
## - `typed`: `types` is the program's table, `l` holds a live list of
##   elements of type `e`, and `x` a live value of type `tx`
def export_list_contains(types: ptr[int], l: ptr mut u8, e: int, x: ptr mut u8, tx: int) -> bool:
    return list.contains(Types(words=types), l, e, x, tx)

## `list.join`: each element's `Display` text, the `n` bytes at `sep`
## between them, appended to the `String` at `out` (`list.join`).
##
## Requires:
## - `typed`: `types` is the program's table, `l` holds a live list of
##   elements of type `e`, `out` a live `String`, and `sep` points to `n`
##   live bytes
def export_list_join(
    types: ptr[int], out: ptr mut u8, l: ptr mut u8, e: int, sep: ptr mut u8, n: int
):
    list.join(Types(words=types), out, l, e, sep, n)

## `list.sort`: the elements of the list at `l`, of type `e`, sorted stably
## by their order; False, leaving it as it was, when two have none
## (`list.sort`).
##
## Requires:
## - `typed`: `types` is the program's table, and `l` holds a live list of
##   elements of type `e`
def export_list_sort(types: ptr[int], l: ptr mut u8, e: int) -> bool:
    return list.sort(Types(words=types), l, e)

## A new table of a dict's keys of type `key` and values of type `val`, or
## of a set's elements (`val` -1), with no entries: its address, the
## dict's or the set's value (`table.new`, decision 422).
##
## Requires:
## - `typed`: `types` is the program's table, which has the types `key` and
##   `val`, when it is not -1
def export_table_new(types: ptr[int], key: int, val: int) -> ptr mut u8:
    return table.new(Types(words=types), key, val)

## The position of the entry of the table at `tb` whose key is the key at
## `k` of type `kt`, or -1 (`table.find`): every lookup of a dict or a set.
##
## Requires:
## - `typed`: `types` is the program's table, `tb` the address of a live
##   table, and `k` holds a live value of type `kt`
def export_table_lookup(types: ptr[int], tb: ptr mut u8, k: ptr mut u8, kt: int) -> int:
    return table.find(Types(words=types), tb, k, kt)

## Appends to the table at `tb` an entry whose key moves in from `k`, which
## it does not hold yet: its position, where the caller writes its value
## (`table.push`).
##
## Requires:
## - `typed`: `types` is the program's table, `tb` the address of a live
##   table, and `k` holds a live key of its key type, which moves in
def export_table_push(types: ptr[int], tb: ptr mut u8, k: ptr mut u8) -> int:
    return table.push(Types(words=types), tb, k)

## Moves entry `i` of the table at `tb` out to `out`, its key and then its
## value, keeping the order of the others (`table.remove`).
##
## Requires:
## - `table`: `tb` is the address of a live table of more than `i` entries,
##   and `out` has room for a key and a value
def export_table_remove(tb: ptr mut u8, i: int, out: ptr mut u8):
    table.remove(tb, i, out)

## Writes the next item of the iterator at `it` as an option at `out`
## (`iter.next`, decision 423): `Iter.next` of one that does not wait, and
## every iterator the runtime in Rust takes items from. Its status, 1 when a
## panic is leaving; `mode` is how what it drops is dropped.
##
## Requires:
## - `typed`: `types` is the program's table, `it` the address of a live
##   iterator's object, and `out` has room for a tag word and an item
def export_iter_next(types: ptr[int], it: ptr mut u8, out: ptr mut u8, mode: int) -> int:
    return iter.next(Types(words=types), it, out, mode)

## Drops the iterator at `it` (0 for none) and what it owns (`iter.drop`):
## its status.
##
## Requires:
## - `typed`: `types` is the program's table, and `it` the address of a live
##   iterator's object, dead afterwards, or 0
def export_iter_drop(types: ptr[int], it: ptr mut u8, mode: int) -> int:
    return iter.drop(Types(words=types), it, mode)

## The iterator of the items of an `Iterable[T]` argument at `p` of type
## `arg`, whose items are of type `item` (-1 when the call does not say;
## `iter.iterable`).
##
## Requires:
## - `typed`: `types` is the program's table, and `p` holds a live value of
##   type `arg`; an owned one moves in
def export_iter_iterable(types: ptr[int], p: ptr mut u8, arg: int, item: int) -> ptr mut u8:
    return iter.iterable(Types(words=types), p, arg, item)

## Every item the iterator at `it` has left, of type `item` (-1 when the
## call does not say), moved into a new list at `out`, the iterator dropped
## after (`iter.collect`): its status.
##
## Requires:
## - `typed`: `types` is the program's table, `it` the address of a live
##   iterator's object, dead afterwards, and `out` has room for a list
def export_iter_collect(
    types: ptr[int], it: ptr mut u8, item: int, out: ptr mut u8, mode: int
) -> int:
    return iter.collect(Types(words=types), it, item, out, mode)
