##! The stage-2 command line (`compiler/stage2/README.md`):
##!
##! ```text
##! sisu2 lir FILE.sir [--release] [--output FILE.lir]   # the LIR of a serialised SIR program
##! sisu2 sir FILE.sir                                   # the program read and written again
##! sisu2 x86 FILE.lir --output FILE.o [--comp-dir DIR] [--std DIR]
##!                                                      # the program compiled to an x86-64 object
##! sisu2 build FILE.sir --output FILE.o [--release] [--comp-dir DIR] [--std DIR] [--times]
##!                                                      # lowered and compiled in one process
##! ```
##!
##! `--library` (with `lir` and `build`) lowers the runtime in Sisu
##! (`compiler/rt`) as a library rather than a program (decision 353): its
##! root module's `export_NAME` functions the global symbols `sisu_rt_NAME`,
##! and no C `main`.
##!
##! `lir` lowers the program (`stage2.lower`) and prints its LIR, or writes
##! it to `--output`. `sir` reads the program (`stage2.read`) and prints it
##! with stage 1's writer, which gives the same bytes back: the reader's
##! check. `x86` compiles a LIR program with the Sisu backend
##! (`stage2.object`) into an ELF object, which the system linker links with
##! the runtime, its line table naming the program's files relative to
##! `--comp-dir` and the standard library's in `--std`. `build` lowers a
##! SIR program and compiles its LIR in this process, without the LIR's
##! text between two (decision 334), the functions compiled on the workers
##! of `std.par`; `--times` prints on standard error how long each took.

import stage1.sir.write
import stage2.gen
import stage2.lir
import stage2.object
import stage2.read
import std.par
from stage2.lir import LirError
from stage2.object import ObjectError
from stage2.read import ReadError

error UsageError:
    Usage(text: String)

## Why a command failed after saying why on standard error.
error CommandError:
    Failed

## Prints a text that ends with a line break, as it is.
def emit(text: str):
    if text.is_empty():
        return
    if text.byte_at(text.byte_len() - 1) == 10:
        print(text.byte_slice(0, text.byte_len() - 1))
    else:
        print(text)

def usage() -> String:
    return "usage: sisu2 lir FILE.sir [--release] [--library] [--output FILE.lir]\n       sisu2 sir FILE.sir\n       sisu2 x86 FILE.lir --output FILE.o [--comp-dir DIR] [--std DIR]\n       sisu2 build FILE.sir --output FILE.o [--release] [--library] [--comp-dir DIR] [--std DIR] [--times]".to_string()

## The bytes as `bytes`, each converted by a table of the 256 values, in
## pieces on the workers of `std.par`.
pure def as_bytes(xs: list[int]) -> bytes:
    var table: list[u8] = []
    for k in range(256):
        table.push(k.to_u8() ?? 0u8)
    var pieces: list[(int, int)] = []
    var at = 0
    while at < len(xs):
        let end = min(at + 1048576, len(xs))
        pieces.push((at, end))
        at = end
    let parts = par.map(pieces, (piece) -> narrow(xs, piece.0, piece.1, table))
    var out: list[u8] = []
    for part in own parts:
        out.extend(part)
    return bytes.from_list(out)

## The bytes of `xs` from `start` to `end`, narrowed by `table`.
pure def narrow(xs: list[int], start: int, end: int, table: list[u8]) -> list[u8]:
    var out: list[u8] = []
    for i in range(start, end):
        out.push(table[xs[i] & 255])
    return out

## Nanoseconds as milliseconds, to a tenth.
pure def millis(ns: int) -> String:
    let tenths = ns // 100000
    return "{tenths // 10}.{tenths % 10}"

## The object the backend compiled, written at `o`, or why it was not.
def write_object(
    sys: System, path: str, compiled: list[int] ! ObjectError, o: str
) -> () ! {IoError, CommandError}:
    match compiled:
        case Ok(code):
            sys.fs.write(Path.new(o), as_bytes(code))?
            return Ok(())
        case Err(ObjectError.BadLir(line, message)):
            print_err("{path}:{line}: {message}")
        case Err(ObjectError.Unsupported(what, function)):
            print_err("x86: not compiled: {what} (in {function})")
    return Err(Failed)

def main(sys: System) -> ! {IoError, UsageError, CommandError}:
    let args = sys.env.args()
    if len(args) < 2:
        return Err(Usage(text=usage()))
    let command = args[0].copy()
    let path = args[1].copy()
    var release = False
    var library = False
    var output: String? = None
    var comp_dir = String.new()
    var std_dir = String.new()
    var times = False
    var i = 2
    while i < len(args):
        if args[i] == "--release":
            release = True
        elif args[i] == "--library":
            library = True
        elif args[i] == "--times":
            times = True
        elif args[i] == "--output" and i + 1 < len(args):
            output = Some(args[i + 1].to_string())
            i += 1
        elif args[i] == "--comp-dir" and i + 1 < len(args):
            comp_dir = args[i + 1].to_string()
            i += 1
        elif args[i] == "--std" and i + 1 < len(args):
            std_dir = args[i + 1].to_string()
            i += 1
        else:
            return Err(Usage(text=usage()))
        i += 1
    if command != "sir" and command != "lir" and command != "x86" and command != "build":
        return Err(Usage(text=usage()))
    if (command == "x86" or command == "build") and output == None:
        return Err(Usage(text=usage()))
    let start = sys.clock.now().unix_nanos()
    let text = sys.fs.read_to_string(Path.new(path))?
    if command == "x86":
        return write_object(sys, path, object.compile(text, comp_dir, std_dir), output ?? "")
    let r = read.read(text)
    if let Err(ReadError.Bad(line, message)) = r:
        print_err("{path}:{line}: {message}")
        return Err(Failed)
    let Ok(read_prog) = r else:
        return Err(Failed)
    # The `@export`s, which stage 1's `sir.Program` has no place for
    # (decision 683).
    let ex = read.exports(text)
    if let Err(ReadError.Bad(line, message)) = ex:
        print_err("{path}:{line}: {message}")
        return Err(Failed)
    let Ok(exports) = ex else:
        return Err(Failed)
    # The runtime profile, which it has no place for either (decision 723).
    let rp = read.runtime(text)
    if let Err(ReadError.Bad(line, message)) = rp:
        print_err("{path}:{line}: {message}")
        return Err(Failed)
    let Ok(profile) = rp else:
        return Err(Failed)
    if command == "sir":
        emit(read.export_lines(write.write(read_prog), profile, exports))
        return Ok(())
    var prog = read_prog
    # The library has no std.par to give its native body (decision 353).
    if not library:
        gen.native_bodies(mut prog)
    let lowered = if library: gen.lower_library_spanned(prog, release) else: gen.lower_spanned(
        prog, exports, release
    )
    let lowered_at = sys.clock.now().unix_nanos()
    if let Err(e) = lowered:
        match e:
            case LirError.Unsupported(what, function):
                if function.is_empty():
                    print_err("lir: not lowered: {what}")
                else:
                    print_err("lir: not lowered: {what} (in {function})")
            case LirError.Internal(what):
                print_err("lir: internal error: {what}")
        return Err(Failed)
    let Ok((lir_text, spans)) = lowered else:
        return Err(Failed)
    if command == "build":
        # The LIR is compiled where it was lowered (decision 334).
        let compiled = object.compile_spanned(lir_text, spans, comp_dir, std_dir)
        let compiled_at = sys.clock.now().unix_nanos()
        if times:
            print_err(
                "sisu2: lowered in {millis(lowered_at - start)} ms, compiled in {millis(compiled_at - lowered_at)} ms"
            )
        return write_object(sys, path, compiled, output ?? "")
    match output:
        case Some(o):
            sys.fs.write_text(Path.new(o), lir_text)?
        case None:
            emit(lir_text)
    return Ok(())
