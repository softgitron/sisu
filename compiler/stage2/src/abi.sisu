pub const SYM_TEXT_PUSH_INT: str = "sisu_rt_text_push_int"
pub const SYM_TEXT_FROM: str = "sisu_rt_text_from"
pub const SYM_TABLE_FIND: str = "sisu_rt_table_find"
pub const SYM_LIST_RESERVE: str = "sisu_rt_list_reserve"
pub const SYM_INTRINSIC: str = "sisu_rt_intrinsic"
pub const SYM_SIZED: str = "sisu_rt_sized"
pub const SYM_WIDE: str = "sisu_rt_wide"
pub const SYM_TABLE: str = "sisu_rt_table"
pub const SYM_DICT_SLOT: str = "sisu_rt_dict_slot"
pub const SYM_TABLE_TAKE: str = "sisu_rt_table_take"
pub const SYM_DEPTH: str = "SISU_RT_DEPTH"
pub const SYM_YIELD: str = "sisu_rt_yield"
