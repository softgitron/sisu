##! The runtime's ABI as the code generator sees it (stage 0's
##! `sisu-rt/src/abi.rs`, the part `sisu-codegen` shares): the statuses, the
##! words of the runtime's data, the numbers of the runtime's operations and
##! intrinsics, and the type table the runtime decodes when a program
##! starts, with its encoding. Every number here is the runtime's, which the
##! executable links; a change there is a change here.

## A function returned normally; a panic is leaving it.
pub const OK: int = 0
pub const UNWINDING: int = 1

## The bytes of a word.
pub const WORD: int = 8

## The runtime's symbols that generated code refers to (`abi::sym`).
pub const SYM_START: str = "sisu_rt_start"
pub const SYM_FRAME: str = "sisu_rt_frame"
pub const SYM_ABORT_UNWIND: str = "sisu_rt_abort_unwind"
## A panic left an exported function of C's convention: its report, and the
## program stops (decision 785).
