## The sized integer types a word holds, by `sisu_rt_sized`'s number; the
## 128-bit ones, by `sisu_rt_wide`'s.
pub pure def sized_types() -> list[str]:
    return ["u8", "u16", "u32", "u64", "i8", "i16", "i32"]

pub pure def wide_types() -> list[str]:
    return ["i128", "u128"]

## `SizedOp`: the operations of the sized integers, by their intrinsics'
## method names, in the runtime's order.
pub pure def sized_op_names() -> list[str]:
    return [
        "add",
        "sub",
        "mul",
        "floordiv",
        "rem",
        "pow",
        "wrap_add",
        "wrap_sub",
        "wrap_mul",
        "sat_add",
        "sat_sub",
        "sat_mul",
        "shl",
        "shr",
        "and",
        "or",
        "xor",
        "not",
        "neg",
        "cmp",
        "to_int",
        "from_literal",
        "widen",
        "from_bits",
        "wrapping_from",
        "to_sized",
        "from_text",
    ]

pub const SIZED_AND: int = 14
pub const SIZED_OR: int = 15
pub const SIZED_XOR: int = 16
pub const SIZED_NOT: int = 17
pub const SIZED_CMP: int = 19
pub const SIZED_TO_INT: int = 20
pub const SIZED_WIDEN: int = 22
pub const SIZED_WRAPPING_FROM: int = 24
pub const SIZED_TO_SIZED: int = 25

## The number of the sized operation `n`, if it is one.
pub pure def sized_op(n: str) -> int?:
    let names = sized_op_names()
    for i in range(len(names)):
        if names[i] == n:
            return Some(i)
    return None

## `sisu_rt_float_op`'s operations.
pub const FLOAT_MOD: int = 0
pub const FLOAT_POW: int = 1
pub const FLOAT_FLOORDIV: int = 2

## The header of an iterator's object that compiled code steps itself
## (decision 253), and the bytes of one kept in a slot of the frame.
pub const ITER_KIND: int = 0
pub const ITER_A: int = 8
pub const ITER_B: int = 16
pub const ITER_C: int = 24
pub const ITER_FRAME: int = 32
pub const ITER_RANGE: int = 1
pub const ITER_LIST_REF: int = 2

## The bytes of a `Mutex`'s header, before its value.
pub const MUTEX_HEADER: int = 32

## Where an error set's words are: the number of its type, the trace, the
## tag, and the payload after them.
pub const ERROR_DECL: int = 0
pub const ERROR_TRACE: int = 8
pub const ERROR_TAG: int = 16
pub const ERROR_PAYLOAD: int = 24

## A part of a tuple: its offset and type.
@derive(Eq, Copy)
pub struct Slot:
    pub offset: int
    pub ty: int

## A named part of a struct or a variant; `glue`: the type's drop glue
## drops it (decision 218).
@derive(Eq)
pub struct Field:
    pub name: String?
    pub offset: int
    pub ty: int
    pub glue: bool

@derive(Eq)
pub struct Variant:
    pub name: String
    pub fields: list[Field]

## What a type is, and where its parts are (`abi::Kind`).
@derive(Eq)
pub enum Kind:
    Unit
    Int
    Sized(String)
    U64
    I128
    U128
    Float
    F32
    Bool
    Char
    Str
    String
    Path
    Bytes
    DateTime
    Ref(int)
    List(int)
    Slice(int)
    Iter(int)
    Option(int)
    Result(int, int)
    Tuple(list[Slot])
    Box(int)
    Struct(name: String, fields: list[Field], glue: int?)
    Enum(name: String, variants: list[Variant], glue: int?, error_: bool)
    ErrSet(list[int])
    Fn
    Opaque(String)
    Const(int)
    Dict(int, int)
    Set(int)
    Entry(int, int)
    Dyn
    Scope
    Handle(int)
    Cancellation
    Sender(int)
    Receiver(int)
    Timer
    Mutex(int)
    Guard(int, int?)
    RwLock(int)
    ReadGuard(int)
    Shared(int)
    Weak(int)
    Cell(int)
    Arena(int)
    ## `ptr[T]` and `ptr mut T`: an address, and what it points to.
    Ptr(int)

## One concrete type of the program: its bytes and kind.
@derive(Eq)
pub struct TypeEntry:
    pub size: int
    pub kind: Kind

## The bytes of the encoded type table, as `abi::encode` writes them.
struct Writer:
    out: list[int]

impl Writer:
    pure def u8(mut self, x: int):
        self.out.push(x & 255)

    pure def u32(mut self, x: int):
        self.out.push(x & 255)
        self.out.push((x >> 8) & 255)
        self.out.push((x >> 16) & 255)
        self.out.push((x >> 24) & 255)

    pure def opt(mut self, x: int?):
        match x:
            case Some(v):
                self.u32(v + 1)
            case None:
                self.u32(0)

    pure def text(mut self, s: str):
        self.u32(s.byte_len())
        for i in range(s.byte_len()):
            self.out.push(s.byte_at(i).to_int())

    pure def fields(mut self, fs: list[Field]):
        self.u32(len(fs))
        for f in fs:
            match f.name:
                case Some(n):
                    self.u8(1)
                    self.text(n)
                case None:
                    self.u8(0)
            self.u32(f.offset)
            self.u32(f.ty)
            self.u8(if f.glue: 1 else: 0)

    ## A kind's code, then the numbers it holds.
    pure def code(mut self, k: int, parts: list[int]):
        self.u8(k)
        for p in parts:
            self.u32(p)

## The type table as bytes, for the program's read-only data.
pub pure def encode(table: list[TypeEntry]) -> list[int]:
    var w = Writer(out=[])
    w.u32(len(table))
    for t in table:
        w.u32(t.size)
        match t.kind:
            case Unit:
                w.u8(0)
            case Int:
                w.u8(1)
            case Sized(n):
                w.u8(2)
                w.text(n)
            case U64:
                w.u8(3)
            case I128:
                w.u8(27)
            case Dyn:
                w.u8(29)
            case U128:
                w.u8(28)
            case Float:
                w.u8(4)
            case F32:
                w.u8(5)
            case Bool:
                w.u8(6)
            case Char:
                w.u8(7)
            case Str:
                w.u8(8)
            case String:
                w.u8(9)
            case Path:
                w.u8(10)
            case Bytes:
                w.u8(42)
            case DateTime:
                w.u8(43)
            case Ref(x):
                w.code(11, [x])
            case List(x):
                w.code(12, [x])
            case Slice(x):
                w.code(47, [x])
            case Iter(x):
                w.code(13, [x])
            case Option(x):
                w.code(14, [x])
            case Result(a, b):
                w.code(15, [a, b])
            case Tuple(slots):
                w.u8(16)
                w.u32(len(slots))
                for s in slots:
                    w.u32(s.offset)
                    w.u32(s.ty)
            case Box(x):
                w.code(17, [x])
            case Struct(name, fields, glue):
                w.u8(18)
                w.text(name)
                w.opt(glue)
                w.fields(fields)
            case Enum(name, variants, glue, error_):
                w.u8(19)
                w.text(name)
                w.opt(glue)
                w.u8(if error_: 1 else: 0)
                w.u32(len(variants))
                for v in variants:
                    w.text(v.name)
                    w.fields(v.fields)
            case ErrSet(members):
                w.u8(20)
                w.u32(len(members))
                for m in members:
                    w.u32(m)
            case Fn:
                w.u8(21)
            case Opaque(n):
                w.u8(22)
                w.text(n)
            case Const(n):
                w.u8(23)
                w.u32(n & 4294967295)
                w.u32((n >> 32) & 4294967295)
            case Dict(k, v):
                w.code(24, [k, v])
            case Set(x):
                w.code(25, [x])
            case Entry(k, v):
                w.code(26, [k, v])
            case Scope:
                w.u8(30)
            case Handle(x):
                w.code(31, [x])
            case Cancellation:
                w.u8(32)
            case Sender(x):
                w.code(33, [x])
            case Receiver(x):
                w.code(34, [x])
            case Timer:
                w.u8(35)
            case Mutex(x):
                w.code(36, [x])
            case Guard(x, check):
                w.code(37, [x])
                w.opt(check)
            case RwLock(x):
                w.code(44, [x])
            case ReadGuard(x):
                w.code(45, [x])
            case Shared(x):
                w.code(38, [x])
            case Weak(x):
                w.code(39, [x])
            case Cell(x):
                w.code(40, [x])
            case Arena(x):
                w.code(41, [x])
            case Ptr(x):
                w.code(46, [x])
    return w.out

## The intrinsics that may wait, whose call records its site first.
pub pure def may_wait(i: int) -> bool:
    return (
        i == I_TASK_SCOPE
            or i == I_TASK_RACE
            or i == I_HANDLE_JOIN
            or i == I_CANCELLATION_WAIT
            or i == I_SENDER_SEND
            or i == I_RECEIVER_RECV
            or i == I_TIMER_WAIT
            or i == I_SELECT_WAIT
            or i == I_GEN_YIELD
            or i == I_MUTEX_LOCK
            or i == I_RW_LOCK_READ
            or i == I_RW_LOCK_WRITE
            or i == I_ITER_NEXT
    )

## Whether argument `k` of intrinsic `i` is an `Iterable[T]` it takes
## (decision 210).
pub pure def takes_iterable(i: int, k: int) -> bool:
    if i == I_ZIP or i == I_ZIP_SHORTEST:
        return k < 2
    let first = (
        i == I_ENUMERATE
            or i == I_REVERSED
            or i == I_ITERABLE_LIST
            or i == I_SORTED
            or i == I_SUM
            or i == I_ANY
            or i == I_ALL
    )
    return first and k == 0

