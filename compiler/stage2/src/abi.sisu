pub const SYM_SHARED_TOUCH: str = "sisu_rt_shared_touch"
pub const SYM_RETAIN: str = "sisu_rt_retain"
## What the program printed, written before a foreign call (decision 302);
## the thread's word of the runtime and the switch between stacks, the
## machine intrinsics `rt.thread_slot` and `rt.switch`.
pub const SYM_FLUSH: str = "sisu_rt_flush"
pub const SYM_THREAD_SLOT: str = "sisu_rt_thread_slot"
pub const SYM_SWITCH: str = "sisu_rt_switch"
## After a call of one of the C functions the debug profile checks, whether
## it refused what it was given (decision 561).
pub const SYM_C_CHECKED: str = "sisu_rt_c_checked"

## The runtime's checked form of the C function `name` called with `params`
## word arguments and `results` word results, if it has one (decision 561):
## the C functions the interpreter emulates on its memory model, as
## `sisu_rt::abi::CHECKED_C` names them.
pub pure def checked_c(name: str, params: int, results: int) -> String?:
    let known = match name:
        case "malloc" | "getenv" | "strlen": params == 1 and results == 1
        case "free": params == 1 and results == 0
        case "memcpy": params == 3 and results == 1
        case _: False
    if not known:
        return None
    return Some("sisu_rt_c_{name}")

## The words of `SISU_RT_STACK` (decisions 203 and 234).
pub const STACK_PROBE: int = 0
pub const STACK_REAL: int = 8
pub const STACK_FLOOR: int = 16
pub const STACK_DIRTY: int = 24
pub const STACK_FAILED: int = 32
pub const STACK_FAILED_LEN: int = 48

## The words of `SISU_RT_SITE`: the file's name and its length, the line
## and column of the call, and flags.
pub const SITE_FILE: int = 0
pub const SITE_FILE_LEN: int = 8
pub const SITE_LINE: int = 16
pub const SITE_COL: int = 24
pub const SITE_FLAGS: int = 32
pub const SITE_PURE: int = 1

## Nested calls beyond this many panic (the interpreter's limit).
pub const MAX_DEPTH: int = 100000

## `flags` of `sisu_rt_start`: `main` returns `T ! E`; takes a `System`;
## was built in the debug profile, whose raw memory the runtime checks
## (decision 543).
pub const ENTRY_RESULT: int = 1
pub const ENTRY_SYSTEM: int = 2
pub const ENTRY_CHECKED: int = 4
## `sisu_rt_start`'s flags: the program's runtime profile is `single`, which
## runs `std.par`'s bodies on the asking thread (decision 783).
pub const ENTRY_SINGLE: int = 8

## `sisu_rt_dict_slot`'s modes.
pub const SLOT_READ: int = 0
pub const SLOT_WRITE: int = 1
pub const SLOT_DROP: int = 2

## The capability handles a `System` holds, in its fields' order (decision
## 101), and the host's object behind each.
pub pure def capabilities() -> list[(str, str)]:
    return [
        ("Fs", "HostFs"),
        ("Net", "HostNet"),
        ("Clock", "HostClock"),
        ("Rand", "HostRand"),
        ("Env", "HostEnv"),
        ("Proc", "HostProc"),
        ("Stdin", "HostStdin"),
    ]

## The host's object behind the capability handle `h`, if `h` is one.
pub pure def host_object(h: str) -> String?:
    for (c, o) in capabilities():
        if c == h:
            return Some(o.to_string())
    return None

## Whether `n` is a capability handle or the host's object behind one.
pub pure def is_capability(n: str) -> bool:
    for (c, o) in capabilities():
        if c == n or o == n:
            return True
    return False

## Whether a type the runtime knows by its name (`Kind.Opaque`) is a
## counted handle: a capability's or a `Cap` (decision 237).
pub pure def counted_handle(name: str) -> bool:
    if name == "Cap":
        return True
    for (c, _) in capabilities():
        if c == name:
            return True
    return False

