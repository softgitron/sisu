# RULES.md, R54: where a parse error stops at another language's spelling,
# the fix writes Sisu's: `and` and `or` for `&&` and `||`, `not` for `!`,
# `ref` for `&`, `i += 1` for `i++`, `var` for `let mut`, `.to_f64()` for
# `as f64`, `print` for `println!`, `range(0, 3)` for `0..3`, `list[int]`
# for `Vec<int>`, `match` for `switch`, `.is_none()` for `is None`, `:` for
# `=>` in a `case`, `#` for `//`, and `None` for `nil`.

def counts():
    var i = 0
    i++
    let mut n = 3
    if n > 1 && i < 2:
        print("both")
    if n > 1 || i < 2:
        print("either")

def casts(x: int) -> f64:
    let ok = !True
    let r = &x
    return x as f64

def ranges():
    println!("hi")
    let r = 0..3
    let v: Vec<int> = [1]

def branches(x: int?):
    switch x:
        case None: pass
    if x is None:
        print("none")
    match x:
        case Some(1) => print("one")
        case _: pass

def comments():
    let x = 1
    // a comment in the C family
    print(x)

def absent() -> int?:
    return nil

def main():
    pass
