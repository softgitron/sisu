# A generic pipeline over channels (RULES.md, R1). What a channel carries
# is `Send`, as the bound asks it: a type parameter that a channel carries
# is bounded by `Send`, which asks each type argument to own what it holds
# besides, so `pipeline` and `relay` send ints and `String`s alike and the
# tasks that receive them may keep them. Stage 0 refused both (E0421: a
# type parameter counted as a view, decision 230).

## Sends each value of `xs` to `workers` tasks through a channel, and gives
## back what they received, in order.
def pipeline[T: Send + Ord](own xs: list[T], workers: int) -> list[T]:
    let tx, rx = channel[T](capacity=2)
    let results = Mutex(list())
    var items = xs
    task.scope do s:
        for _ in range(workers):
            s.spawn do:
                for x in rx:
                    results.lock().push(x)
        while let Some(x) = items.pop():
            tx.send(x).expect("the workers outlive the sender")
        tx.close()
    var out = results.into_inner()
    out.sort()
    return out

## Moves what one channel receives to another, a stage of a longer
## pipeline, whatever flows through it.
def relay[T: Send](rx: Receiver[T], tx: Sender[T]) -> ! {ChannelError, TaskError}:
    for x in rx:
        tx.send(x)?
    tx.close()
    return Ok(())

## A pair of a value and how many times it was seen, a type of the program's
## own sent through the same generic code.
@derive(Eq, Ord, Debug)
struct Count:
    word: String
    times: int

def main():
    print(pipeline([5, 3, 9, 1], 3))
    print(pipeline(["pear".to_string(), "apple".to_string(), "fig".to_string()], 2))
    let counts = [Count(word="b".to_string(), times=2), Count(word="a".to_string(), times=1)]
    print(pipeline(counts, 2))
    let a_tx, a_rx = channel[String](capacity=1)
    let b_tx, b_rx = channel[String](capacity=1)
    let got = task.scope do s:
        s.spawn(() -> relay(a_rx, b_tx))
        s.spawn do:
            for w in ["one", "two", "three"]:
                a_tx.send(w.to_string()).expect("the relay outlives the sender")
            a_tx.close()
        var seen: list[String] = []
        for w in b_rx:
            seen.push(w)
        return seen
    print(got)
