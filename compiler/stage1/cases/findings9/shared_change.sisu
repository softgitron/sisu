# Tasks spawned in a loop that change a captured `var` (RULES.md, R88):
# E0402 names the value they change, `count`, where it named the closure's
# text, and its note says that the tasks run at once and what keeps such a
# value, a `Mutex`.
import std.task

def main():
    var count = 0
    task.scope do s:
        for i in range(3):
            s.spawn do:
                count += 1
    print("{count}")
