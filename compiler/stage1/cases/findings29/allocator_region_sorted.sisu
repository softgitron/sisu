# A list on a borrowed `Region` grown, sorted and searched by the methods
# of the impls over a collection on any allocator (RULES.md, R237): its
# SIR, asked by `findings29/asks.requests`, calls the intrinsics of a list
# on `ref mem.Region`, `list.contains` by the structural fast path among
# them, and the function `list#allocator.sort_by`, which the allocators'
# runtime half runs; a program on `Global` reaches none of them.
from std.mem import Region

def sorted_in(r: ref Region, n: int) -> int:
    var xs: list[int, ref Region] = list.with_allocator(r)
    for i in range(n):
        xs.push(n - i)
    xs.sort_by((a, b) -> a.cmp(b))
    if not xs.contains(1):
        return 0
    return len(xs) + (xs.pop() ?? 0)

def main():
    let region = Region.bump(capacity=1024)
    _ = sorted_in(ref region, 3)
