# A field assigned through a `Shared` is `E0343`, which says that the
# `Shared` holds it, whether the binding is a `var` or not, where `E0341`
# said "not declared with `var`" (RULES.md, R114; chapter 13).
struct Counter:
    n: int

def main():
    var c = Shared(Counter(n=1))
    c.n = 2
    let d = Shared(Counter(n=1))
    d.n = 3
    print(c.n + d.n)
