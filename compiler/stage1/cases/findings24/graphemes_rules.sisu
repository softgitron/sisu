# `graphemes()` by every rule of UAX #29, from Unicode's own data files
# (RULES.md, R205): U+200D joins only pictographs (GB11), a conjunct joins
# across its virama (GB9c), a prepended character keeps what follows it
# (GB9b), a spacing mark stays with its base (GB9a), and regional
# indicators pair from the start of their run (GB12, GB13).
from std.string import Graphemes

def shown(text: str) -> String:
    var parts: list[String] = []
    for g in text.graphemes():
        var codes: list[String] = []
        for c in g.chars():
            codes.push("{c.code():x}")
        parts.push(codes.join(" "))
    return parts.join(" | ")

def main():
    print(shown("a\u{200d}b"))
    print(shown("\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}"))
    print(shown("\u{1f468}\u{301}\u{200d}\u{1f469}"))
    print(shown("\u{915}\u{94d}\u{937}"))
    print(shown("\u{915}\u{94d}\u{200d}\u{937}"))
    print(shown("\u{915}\u{94d}a"))
    print(shown("\u{600}12"))
    print(shown("\u{915}\u{93f}"))
    print(shown("\u{1f1eb}\u{1f1ee}\u{1f1f8}\u{1f1ea}\u{1f1eb}"))
    print(shown("\r\n\u{301}"))
