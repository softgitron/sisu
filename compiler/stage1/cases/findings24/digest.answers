# shop: the API as `sisu doc --digest` writes it

# module `shop`
##! A shop: its items and their prices, and its orders.
##! Re-exports: `Item`: `shop.items.Item`, `Priced`: `shop.items.Priced`, `LIMIT`: `shop.items.LIMIT`, `price_of`: `shop.items.price_of`, `Cost`: `shop.items.prices.Price`, `Cents`: `money.Cents`, `Duration`: `std.core.Duration`, `orders`: `shop.orders`.

## The shop's name.
const NAME: str

# module `shop.items`
##! Items, and what they cost.

## The most items an order holds.
const LIMIT: int

## A thing for sale.
pub view struct Item
    pub name: str
    # private fields

impl Priced for Item

    ## Its price, in cents.
    pub def cost(self) -> int

## What has a price.
pub trait Priced

    ## The price.
    def price(self) -> int

## The price of `item`.
pub def price_of(item: Item) -> Price

# module `shop.items.prices`
##! Prices.

## A price in cents.
pub struct Price
    pub cents: int

# module `shop.orders`
##! Orders of items.

## Why an order fails.
pub error OrderError
    Late
    Empty

## An order's lines.
pub struct Order
    pub lines: list[int]

## The total of an order, from errors of this module, of `money` and of the prelude.
## Capabilities: `fs` (`Fs`).
pub def total(order: Order, fs: Fs, path: Path) -> int ! {IoError, OrderError, money.MoneyError}  # inferred

## Totals an order that is late, through `total`.
## Capabilities: `fs` (`Fs`).
pub def late(order: Order, fs: Fs) -> int ! {IoError, OrderError, money.MoneyError}  # inferred

impl Display for Item
