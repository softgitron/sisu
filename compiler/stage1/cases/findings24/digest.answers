# digest: the API as `sisu doc --digest` writes it

# module `digest`
##! `sisu doc --digest` (RULES.md, R207; 10, "AI-assisted development"): each item's declaration with its inferred error set and contracts, the first paragraph of its doc comment, its capabilities, its typed holes and its first example, as one plain text.

## A sauna's stove.
pub struct Stove
    pub heat: int
    limit: int

    ## The stove one step hotter, never past its limit.
    ## ```
    ## let s = Stove(heat=60, limit=90)
    ## assert s.hotter().heat == 65
    ## ```
    pub def hotter(self) -> Stove

error StoveError
    TooHot(heat: int)

## Checks the heat.
pub def measure(heat: int) -> int ! StoveError  # inferred
    requires heat >= 0

## The log of the stove, written to `fs`.
## Capabilities: `fs` (`Fs`).
pub def save(fs: Fs, s: Stove) -> ! IoError

## The stove's next setting, not written yet.
## Unfinished: `todo("plan")`.
pub def plan(s: Stove) -> int

def main()
