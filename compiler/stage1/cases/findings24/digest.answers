# std: the API as `sisu doc --digest` writes it

# module `std.time`
##! `std.time` (11): `DateTime`, `Duration`, `Timer`, `TimeError` and the test clock `TestClock` are the prelude's, which this module also names; `Ticker` and `Timeline` (N-35, D-075) are written here, over a `Clock`, so the same code keeps real time in production and is deterministic under the test clock.
##! Re-exports: `DateTime`: `std.core.DateTime`, `Duration`: `std.core.Duration`, `Timer`: `std.core.Timer`, `TimeError`: `std.core.TimeError`, `TestClock`: `std.core.TestClock`, `Clock`: `std.core.Clock`.

## A periodic ticker that does not drift (N-35): its `n`-th tick is at `start + n * period` whatever each iteration took, so a slow iteration does not push the ticks after it back. A tick that passes while the loop is busy is skipped, not fired late, and counted in `missed`.
## ```
## let clock = Clock.frozen_at(DateTime.parse("2026-01-01T00:00:00Z").expect("a time"))
## let start = clock.now()
## var t = Ticker.every(clock, Duration.seconds(1))
## t.wait().expect("not cancelled")
## t.wait().expect("not cancelled")
## assert clock.now() - start == Duration.seconds(2)
## clock.advance(Duration.millis(3500))
## t.wait().expect("not cancelled")
## assert clock.now() - start == Duration.seconds(6)
## assert t.missed == 3
## ```
pub struct Ticker
    pub missed: int
    # private fields

    ## Ticks every `period`, the first a period from now.
    ## Capabilities: `clock` (`Clock`).
    pub def every(clock: Clock, period: Duration) -> Ticker
        requires period > Duration.seconds(0)

    ## Waits for the next tick still ahead, skipping those that passed.
    ## Capabilities: `self` (`Clock`).
    pub def wait(mut self) -> ! TaskError

## Virtual time (Sonic Pi's model, N-35): `sleep(d)` moves the timeline's own time on by exactly `d` and then waits for the clock to reach it, so the time spent between sleeps does not accumulate as drift.
## ```
## let clock = Clock.frozen_at(DateTime.parse("2026-01-01T00:00:00Z").expect("a time"))
## var tl = Timeline.start(clock)
## let t0 = tl.now
## tl.sleep(Duration.millis(250)).expect("not cancelled")
## clock.advance(Duration.millis(100))
## tl.sleep(Duration.millis(250)).expect("not cancelled")
## assert tl.now - t0 == Duration.millis(500)
## assert clock.now() - t0 == Duration.millis(500)
## ```
pub struct Timeline
    pub now: DateTime
    # private fields

    ## A timeline whose time starts at the clock's.
    ## Capabilities: `clock` (`Clock`).
    pub def start(clock: Clock) -> Timeline

    ## Moves the timeline on by `d`, and waits until the clock is there.
    ## Capabilities: `self` (`Clock`).
    pub def sleep(mut self, d: Duration) -> ! TaskError

## A point on a clock's time line, to measure how long something took (11, `std.time`): `Instant.now(clock)` reads the clock, `elapsed` is the time since, and the difference of two is a `Duration`; an instant is ordered but is not a civil time, and shows as its nanoseconds on its clock. Its readings are the clock's monotonic ones (`ClockOps.monotonic`, decision 643): on the host's clock the time since the run's first reading, which a change of the system's time does not move, and on the test clock its time, so that the test clock makes them deterministic; a recorded run replays them. Two instants of different clocks do not compare.
## ```
## let clock = Clock.frozen_at(DateTime.parse("2026-01-01T00:00:00Z").expect("a time"))
## let start = Instant.now(clock)
## clock.advance(Duration.millis(1500))
## assert start.elapsed(clock) == Duration.millis(1500)
## let later = Instant.now(clock)
## assert later > start and later.since(start) == Duration.millis(1500)
## assert start + Duration.seconds(2) > later
## ```
@derive(Copy, Eq, Ord, Hash, Debug)
pub struct Instant
    # private fields

impl Add[Duration] for Instant
impl Sub[Duration] for Instant
impl Display for Instant

    ## The clock's monotonic reading now.
    ## Capabilities: `clock` (`Clock`).
    pub def now(clock: Clock) -> Instant

    ## The time from this instant to the clock's time now.
    ## Capabilities: `clock` (`Clock`).
    pub def elapsed(self, clock: Clock) -> Duration

    ## The time from `earlier` to this instant, negative when `earlier` is the later one.
    pub pure def since(self, earlier: Instant) -> Duration

## A time zone (11, `std.time`): the offset from UTC of its standard time and, when it has one, of its daylight time with the days that start and end it, each with the abbreviation it is shown with. `Zone.named` gives the zones of the table above by their names in the tz database, with each zone's history from the database (`zone_history`, below), so that a time before today's rules came into force has the offset the zone's clocks showed then (stage 1's RULES.md, R206).
## ```
## let helsinki = Zone.named("Europe/Helsinki").expect("a zone")
## let summer = DateTime.parse("2026-07-01T12:00:00Z").expect("a time")
## let winter = DateTime.parse("2026-01-15T12:00:00Z").expect("a time")
## assert helsinki.offset_at(summer) == Duration.hours(3)
## assert helsinki.abbreviation_at(winter) == "EET"
## assert helsinki.format(summer) == "2026-07-01T15:00:00+03:00"
## assert helsinki.local(summer).hour() == 15
## let before = DateTime.parse("1950-07-01T12:00:00Z").expect("a time")
## assert helsinki.offset_at(before) == Duration.hours(2)
## assert Zone.named("Mars/Olympus").is_err()
## ```
@derive(Eq)
pub struct Zone
    pub name: String
    # private fields

impl Debug for Zone

    ## UTC itself.
    pub pure def utc() -> Zone

    ## A zone of one offset, `seconds` east of UTC, named `UTC+HH:MM`.
    pub pure def fixed(seconds: int) -> Zone

    ## The zone named `name` in the tz database, of the ones the table knows; `InvalidTime` for another name.
    pub pure def named(name: str) -> Zone ! TimeError

    ## The offset from UTC the zone's clocks show at `t`.
    pub pure def offset_at(self, t: DateTime) -> Duration

    ## The abbreviation the zone's time is shown with at `t`, as `EEST`.
    pub pure def abbreviation_at(self, t: DateTime) -> String

    ## The zone's wall-clock time at `t`, as a `DateTime` whose parts (`hour`, `day`, ...) are the local ones: `t` moved by its offset.
    pub pure def local(self, t: DateTime) -> DateTime

    ## `t` as RFC 3339 writes it in the zone, its local time and offset: `2026-07-01T15:00:00+03:00`.
    pub pure def format(self, t: DateTime) -> String

## The days of `month` (1 for January to 12) in `year` of the proleptic Gregorian calendar: 29 for February of a leap year (one divisible by 4, and by 400 when by 100), 28 for another, 30 for April, June, September and November, and 31 for the rest. The prelude's own copy, which the standard library's code calls, is not a program's (stage 1's RULES.md, R183).
## ```
## assert days_in_month(2024, 2) == 29
## assert days_in_month(1900, 2) == 28
## assert days_in_month(2026, 11) == 30
## ```
pub pure def days_in_month(year: int, month: int) -> int
