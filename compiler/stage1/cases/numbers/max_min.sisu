# RULES.md, R35: `max` and `min` take a collection as Python's do (02's
# prelude functions), the largest or smallest item, the first of equals,
# beside the two values they compare; a collection with no item panics,
# as Python's raises.
def main():
    let scores = [3, 9, 4, 9]
    print("{max(scores)} {min(scores)} {max(3, 7)} {min(2, 8)}")
    print(max(["pear", "apple", "fig"]))
    let names = ["Eero".to_string(), "Aino".to_string()]
    print(min(names))
    print(max({5, 1, 3}))
    let none: list[int] = []
    print(max(none))
