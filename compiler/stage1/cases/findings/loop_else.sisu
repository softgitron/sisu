# RULES.md, R16: Python's `else` on a loop is not Sisu (02, "Departures
# from Python": `if let` on the search's result), and the error at it says
# so rather than that an expression was expected there.

def find(xs: list[int], x: int) -> int:
    for i in range(len(xs)):
        if xs[i] == x:
            return i
    else:
        return -1
    return 0

def countdown(n: int) -> int:
    var k = n
    while k > 0:
        k -= 1
    else:
        k = 10
    return k

def main():
    print("{find([1, 2], 2)} {countdown(3)}")
