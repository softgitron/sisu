# `E0806` names the methods that change a value with an invariant, or the
# one to write (RULES.md, R104; chapter 23).
struct Schedule:
    opens: int
    closes: int
    invariant 0 <= self.opens < self.closes <= 24

struct Stove:
    celsius: int
    invariant 0 <= self.celsius <= 120

impl Stove:
    def heat(mut self, by: int):
        self.celsius = min(self.celsius + by, 120)

    def cool(mut self, by: int):
        self.celsius = max(self.celsius - by, 0)

def main():
    var today = Schedule(opens=16, closes=21)
    today.closes = 25
    var stove = Stove(celsius=20)
    stove.celsius = 30
    print("open {today.opens} to {today.closes}, {stove.celsius}")
