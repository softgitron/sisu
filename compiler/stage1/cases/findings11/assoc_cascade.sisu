# An impl without its associated type is `E0237` alone: a use of the type is
# not `E0347` again (RULES.md, R104; R17).
trait Source:
    type Item
    def first(self) -> Self.Item

struct Bench:
    sitters: list[String]

impl Source for Bench:
    def first(self) -> String:
        return self.sitters[0].copy()

def main():
    let bench = Bench(["Aino"])
    print("{bench.first()}")
