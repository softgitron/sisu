# A worksheet (10, "Worksheets"): each statement's value after it, and what
# it printed under it.
let prices = [3, 5, 8]
sum(prices)
var total = 0
for p in prices:
    total += p
    print("added {p}")
total * 2


def double(n: int) -> int:
    return n * 2


double(total)
let (count, name) = (len(prices), "prices")
print("done")
