# RULES.md, R41: `@derive(Arbitrary)` draws a type whose every part has a
# generator (`E0820`); a type parameter is drawn through its own
# `Arbitrary` since R52, which a part of no generator is not.
struct Handle:
    fs: Fs

@derive(Arbitrary)
struct Opened:
    handle: Handle

@derive(Arbitrary)
struct Boxed[T]:
    value: T
    handle: Handle

def main():
    pass
