# The compile-time evaluator on a sieve of 20,000 numbers (the manual's
# chapter 25), which took 90 s while the evaluator copied a list at each
# index, push and step of a loop, and takes about a second now (README,
# "The compile-time evaluator"); the SIR is stage 0's.

## The prime numbers below `n`, by the sieve of Eratosthenes.
def primes_below(n: int) -> list[int]:
    var composite: list[bool] = []
    for _ in range(n):
        composite.push(False)
    var primes: list[int] = []
    for k in range(2, n):
        if not composite[k]:
            primes.push(k)
            var multiple = k * k
            while multiple < n:
                composite[multiple] = True
                multiple += k
    return primes

## How many of `words` are longer than `n` characters, through a loop
## over a list the function owns and its length.
def longer_than(words: list[str], n: int) -> int:
    var kept: list[str] = []
    for w in words:
        kept.push(w)
    var count = 0
    var i = 0
    while i < len(kept):
        if len(kept[i]) > n:
            count += 1
        i += 1
    return count

const PRIMES: list[int] = comptime primes_below(20000)
const LONG: int = comptime longer_than(["the", "sieve", "of", "Eratosthenes", "finds", "primes"], 5)

def main():
    print("{len(PRIMES)} primes, the last {PRIMES[^1]}")
    print(LONG)
