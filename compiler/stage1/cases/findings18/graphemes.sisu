# `graphemes()` of `std.string` (RULES.md, R162; 03): a base with its
# marks, `\r\n`, a syllable in jamo, a flag, a sequence joined by U+200D
# and an emoji with its modifier are one grapheme each.
from std.string import Graphemes

def main():
    let text = "e\u{301}a\r\n\u{1112}\u{1161}\u{11ab}\u{d55c}\u{1f1eb}\u{1f1ee}\u{1f1f8}\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}\u{1f44d}\u{1f3fd}!"
    var n = 0
    for g in text.graphemes():
        var codes: list[String] = []
        for c in g.chars():
            codes.push("{c.code():x}")
        print("{n}: {codes.join(" ")}")
        n += 1
