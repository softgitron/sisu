##! Types.
##!
##! ```text
##! type      := '!' error_set? | option ('!' error_set?)?
##! error_set := '{' option (',' option)* '}' | option
##! option    := ref_type '?'*
##! ref_type  := 'ref' 'mut'? primary_type | primary_type
##! primary_type := path_type | fn_type | tuple_type | '(' type ')' | 'dyn' primary_type
##!              | 'ptr' 'mut' primary_type | 'impl' type ('for' type)?
##!              | '{' option (',' option)* '}'
##! path_type := (name | 'Self' | 'type') ('.' name)* generic_args?
##! fn_type   := 'pure'? '(' (type_element (',' type_element)*)? ')' '->' type
##! tuple_type := '(' ')' | '(' type_element ',' ')' | '(' type_element (',' type_element)+ ')'
##! type_element := (name ':')? type
##! generic_args := '[' generic_arg (',' generic_arg)* ']'
##! generic_arg := const_expr | integer | type
##! ```
##!
##! `ref T?` is `(ref T)?`, an optional reference (02, "Types"). A
##! constant argument may be an expression (03, `Array[T, W * H]`): an
##! argument is one when it starts with what starts an expression and no
##! type (`-`, `~`, a literal other than an integer standing alone,
##! `comptime`), or when its leading path (`W`, `m.N`), integer or
##! parenthesised group is followed by an operator or a call's `(`; it is a
##! `CONST_ARG` node holding the expression.

from stage1.diag import Msg
from stage1.parser.state import Parser
from stage1.syntax.kinds import SyntaxKind

impl Parser:
    pure def at_type_start(self) -> bool:
        return match self.current():
            case Ident | SelfTypeKw | LParen | RefKw | DynKw | LBrace | ImplKw | TypeKw: True
            case _: False

    pub(package) pure def type_(mut self):
        let cp = self.checkpoint()
        if not self.at(SyntaxKind.Bang):
            self.option_type()
        if self.at(SyntaxKind.Bang):
            self.start_at(cp, SyntaxKind.ResultType)
            self.bump()
            if self.at_type_start():
                self.error_set()
            self.finish_node()

    pure def error_set(mut self):
        if self.at(SyntaxKind.LBrace):
            self.start(SyntaxKind.ErrorSetType)
            self.bump()
            while not self.at_list_end(SyntaxKind.RBrace):
                self.option_type()
                if not self.eat(SyntaxKind.Comma):
                    break
            _ = self.expect(SyntaxKind.RBrace)
            self.finish_node()
        else:
            self.option_type()

    pure def option_type(mut self):
        let cp = self.checkpoint()
        self.ref_type()
        while self.at(SyntaxKind.Question):
            self.start_at(cp, SyntaxKind.OptionType)
            self.bump()
            self.finish_node()

    pure def ref_type(mut self):
        if self.at(SyntaxKind.RefKw):
            self.start(SyntaxKind.RefType)
            self.bump()
            _ = self.eat(SyntaxKind.MutKw)
            self.primary_type()
            self.finish_node()
        else:
            self.primary_type()

    pure def primary_type(mut self):
        match self.current():
            case LBrace:
                # A union of error sets as a type of its own (05, "Error
                # sets"): `type AppError = {IoError, ParseError}`.
                self.error_set()
            case Ident if self.current_text() == "pure" and self.nth(1) == SyntaxKind.LParen:
                self.start(SyntaxKind.FnType)
                self.bump()
                _ = self.paren_types()
                _ = self.expect(SyntaxKind.Arrow)
                self.type_()
                self.finish_node()
            case Ident if self.current_text() == "ptr" and self.nth(1) == SyntaxKind.MutKw:
                # `ptr mut T`, a raw pointer (04, "Unsafe").
                self.start(SyntaxKind.PtrType)
                self.bump()
                self.bump()
                self.primary_type()
                self.finish_node()
            case ImplKw:
                # `impl Trait for T`, the result of a comptime derive.
                self.start(SyntaxKind.ImplType)
                self.bump()
                self.type_()
                if self.eat(SyntaxKind.ForKw):
                    self.type_()
                self.finish_node()
            case Ident | SelfTypeKw | TypeKw:
                self.start(SyntaxKind.PathType)
                self.bump()
                while self.at(SyntaxKind.Dot) and self.nth(1) == SyntaxKind.Ident:
                    self.bump()
                    self.bump()
                if self.at(SyntaxKind.LBracket):
                    self.generic_args()
                self.finish_node()
            case LParen:
                let cp = self.checkpoint()
                let (count, trailing_comma) = self.paren_types()
                if self.at(SyntaxKind.Arrow):
                    self.start_at(cp, SyntaxKind.FnType)
                    self.bump()
                    self.type_()
                    self.finish_node()
                else:
                    let single = count == 1 and not trailing_comma
                    let kind = if single: SyntaxKind.ParenType else: SyntaxKind.TupleType
                    self.start_at(cp, kind)
                    self.finish_node()
            case DynKw:
                self.start(SyntaxKind.DynType)
                self.bump()
                self.primary_type()
                self.finish_node()
            case _:
                self.error_found(Msg.ParseExpectedType)
                self.start(SyntaxKind.Error)
                if not self.at_type_sync():
                    self.bump()
                self.finish_node()

    ## Where a missing type consumes nothing.
    pure def at_type_sync(self) -> bool:
        return match self.current():
            case Newline | Colon | Eq | Comma | RParen | RBracket | RBrace | Eof | Dedent | Indent: True
            case _: False

    ## `(A, b: B)`: the elements of a tuple or the parameters of a function
    ## type. Returns the element count and whether a comma trails.
    pure def paren_types(mut self) -> (int, bool):
        _ = self.expect(SyntaxKind.LParen)
        var count = 0
        var trailing = False
        while not self.at_list_end(SyntaxKind.RParen):
            if self.at(SyntaxKind.Ident) and self.nth(1) == SyntaxKind.Colon:
                self.start(SyntaxKind.TupleTypeField)
                self.bump()
                self.bump()
                self.type_()
                self.finish_node()
            else:
                self.type_()
            count += 1
            trailing = False
            if not self.eat(SyntaxKind.Comma):
                break
            trailing = True
        _ = self.expect(SyntaxKind.RParen)
        return (count, trailing)

    ## Whether the type argument here is a constant written as an
    ## expression (see the module comment).
    pure def at_const_expr(self) -> bool:
        var i = 0
        match self.current():
            case Ident:
                if self.current_text() == "pure" and self.nth(1) == SyntaxKind.LParen:
                    return False
                i = 1
                while self.nth(i) == SyntaxKind.Dot and self.nth(i + 1) == SyntaxKind.Ident:
                    i += 2
            case IntNumber:
                i = 1
            case LParen:
                var depth = 0
                while True:
                    match self.nth(i):
                        case LParen | LBracket | LBrace:
                            depth += 1
                        case RParen | RBracket | RBrace:
                            depth = max(depth - 1, 0)
                            if depth == 0:
                                i += 1
                                break
                        case Newline | Eof:
                            return False
                        case _:
                            pass
                    i += 1
            case SelfTypeKw | RefKw | DynKw | LBrace | ImplKw | TypeKw | Bang:
                return False
            # What starts an expression and no type (`-`, `~`, a literal,
            # `comptime`); anything else is a broken type.
            case _:
                return self.at_expr_start()
        return match self.nth(i):
            case Plus | Minus | Star | Slash | SlashSlash | Percent | StarStar: True
            case Shl | Shr | Amp | Pipe | Caret | LParen: True
            case _: False

    pure def generic_args(mut self):
        self.start(SyntaxKind.GenericArgs)
        self.bump()
        while not self.at_list_end(SyntaxKind.RBracket):
            if self.at_const_expr():
                self.start(SyntaxKind.ConstArg)
                _ = self.expr()
                self.finish_node()
            elif self.at(SyntaxKind.IntNumber):
                self.start(SyntaxKind.ConstArg)
                self.bump()
                self.finish_node()
            else:
                self.type_()
            if not self.eat(SyntaxKind.Comma):
                break
        _ = self.expect(SyntaxKind.RBracket)
        self.finish_node()
