##! The tree's tokens regrouped into logical lines, each laid out with the
##! printer; and the comments and blank lines between them (stage 0's
##! `sisu-fmt/src/lines.rs`).
##!
##! The rules, so another implementation writes the same text:
##!
##! - A logical line is what the lexer ends with `NEWLINE`; it is written at
##!   four spaces per block level, and broken only inside brackets and
##!   before the binary operators of its outermost expressions (a line that
##!   starts with an operator continues the one before, 02), each broken
##!   bracket's contents one level deeper and each broken operator's line
##!   one level deeper (two in a block header, so the condition stands out
##!   from the block).
##! - A bracket's contents go on their own line when the whole does not
##!   fit, and one element per line, each with a comma after it, when they
##!   do not fit on that line either. A trailing comma in the source (the
##!   "magic trailing comma") keeps them one per line; a tuple of one keeps
##!   its comma. A comprehension that does not fit puts each `for` and `if`
##!   clause on a line of its own instead.
##! - Brackets are tried from the left, each kept on its line when the rest
##!   up to the next bracket fits, except a definition's parameters: they
##!   stay on the `def` line only when the whole line fits, so a long
##!   signature breaks there before its return type does (Black's
##!   left-hand split).
##! - A comment at the end of a line does not count toward its width.
##! - Strings are written as they are.
##! - `Option[T]` is written `T?`, unless `T` is itself optional (`T??`
##!   would read as `??`), a result or a function type, or the option is
##!   behind `ref` or optional itself.
##! - `Result[T, E]` is written `T ! E` when `E` is a name of an error set
##!   (which the caller says: it is not in the syntax), unless `T` is a
##!   result or a function type (`(int) -> int ! E` returns the result),
##!   or the result is behind `ref` or optional (`int ! E?` would make `E`
##!   optional).
##! - A comment keeps its text. One after code stays after it, two spaces
##!   away; one on a line of its own stays on a line of its own, at the
##!   level of the line after it, or of an enclosing block whose
##!   indentation it was written at.
##! - Blank lines: none at the start of a block or of the file; one before
##!   and after every top-level `def`, `struct`, `enum`, `error`, `trait`,
##!   `impl`, `test`, `suite`, `bench` and `extern` (with the comments
##!   right above it); elsewhere at most one, where the source had any.
##! - A run of `import` and `from ... import` lines, with no comment or
##!   blank line between them, is sorted: `import`s first, each kind by
##!   module path; the names a `from` imports are sorted too. An unused
##!   import is removed (`prune` says which are).

import stage1.fmt.doc
import stage1.fmt.prune
import stage1.fmt.space
from stage1.fmt import INDENT, WIDTH
from stage1.fmt.doc import Doc, Docs
from stage1.syntax.kinds import SyntaxKind
from stage1.syntax.tree import Element, Tree

## A tree and one view of its text, which the formatter reads together.
pub view struct Src:
    pub tree: ref Tree
    pub text: str

impl Src:
    pub pure def kind(self, n: int) -> SyntaxKind:
        return self.tree.nodes[n].kind

    pub pure def parent(self, n: int) -> int?:
        return self.tree.nodes[n].parent

    ## The kind of the node's parent, if it has one.
    pub pure def parent_kind(self, n: int) -> SyntaxKind?:
        if let Some(p) = self.tree.nodes[n].parent:
            return Some(self.tree.nodes[p].kind)
        return None

    pub pure def child_nodes(self, n: int) -> list[int]:
        var out: list[int] = []
        for e in self.tree.nodes[n].children:
            if let Node(c) = e:
                out.push(c)
        return out

    ## The child tokens that are not trivia.
    pub pure def child_tokens(self, n: int) -> list[int]:
        var out: list[int] = []
        for e in self.tree.nodes[n].children:
            if let Leaf(t) = e:
                if not self.tree.tokens[t].kind.is_trivia():
                    out.push(t)
        return out

    pub pure def first_child(self, n: int, kind: SyntaxKind) -> int?:
        for e in self.tree.nodes[n].children:
            if let Node(c) = e:
                if self.tree.nodes[c].kind == kind:
                    return Some(c)
        return None

    pub pure def token_kind(self, t: int) -> SyntaxKind:
        return self.tree.tokens[t].kind

    pub pure def token_text(self, t: int) -> str:
        let token = self.tree.tokens[t]
        return self.text.byte_slice(token.start, token.end)

    pub pure def node_text(self, n: int) -> str:
        let node = ref self.tree.nodes[n]
        return self.text.byte_slice(node.start, node.end)

## A token of a line.
pub struct Tok:
    pub kind: SyntaxKind
    pub text: String
    ## The kind of the node it belongs to.
    pub parent: SyntaxKind
    ## That node.
    pub node: int?
    ## Where the token is in the source (for a token the formatter writes,
    ## where the node it stands for is).
    pub pos: int
    ## The comments after it: on its line (`False`) or on lines of their
    ## own (`True`), before the next token.
    pub comments: list[(bool, String)]
    ## For an operator of a chain of binary operators: the chain's root.
    pub op_root: int?

impl Tok:
    ## A token without comments that is no operator of a chain.
    pub pure def new(kind: SyntaxKind, text: str, parent: SyntaxKind, node: int?, pos: int) -> Tok:
        return Tok(
            kind=kind,
            text=text.to_string(),
            parent=parent,
            node=node,
            pos=pos,
            comments=[],
            op_root=None,
        )

## A comment on a line of its own between logical lines.
struct CommentLine:
    text: String
    col: int
    blank_before: int
    depth: int

struct Line:
    depth: int
    toks: list[Tok]
    ## The blank lines just before it (after any comments before it).
    blank_before: int
    comments_before: list[CommentLine]
    ## The column of its first token in the source.
    col: int
    ## The top-level item it belongs to.
    item: int?
    item_kind: SyntaxKind

view struct Walker:
    src: Src
    lines: list[Line]
    cur: list[Tok]
    cur_col: int
    depth: int
    blank: int
    fresh: bool
    pending: list[CommentLine]
    ## The unused imports, left out.
    pruned: set[int]
    ## The types, as written, that name error sets.
    error_sets: set[String]

pure def col_of(text: str, pos: int) -> int:
    let end = min(pos, text.byte_len())
    var start = end
    while start > 0 and text.byte_at(start - 1) != 10:
        start -= 1
    return len(text.byte_slice(start, end))

## The child nodes of `n` that are types.
pure def type_children(src: Src, n: int) -> list[int]:
    var out: list[int] = []
    for c in src.child_nodes(n):
        if is_type(src.kind(c)):
            out.push(c)
    return out

pure def is_type(k: SyntaxKind) -> bool:
    return match k:
        case PathType | OptionType | ResultType | ErrorSetType | TupleType: True
        case ParenType | FnType | RefType | DynType: True
        case _: False

## Whether a node has a comment among its own tokens, which a rewrite
## would have nowhere to put.
pure def has_comment(src: Src, n: int) -> bool:
    for e in src.tree.nodes[n].children:
        if let Leaf(t) = e:
            match src.tree.tokens[t].kind:
                case Comment | DocComment | ModuleDocComment:
                    return True
                case _:
                    pass
    return False

## `Result[T, E]`'s `T` and `E`, written with nothing else between its
## brackets: the type `T ! E` would be, whatever `E` is.
pub pure def result_parts(src: Src, n: int) -> (int, int)?:
    if src.kind(n) != SyntaxKind.PathType:
        return None
    let idents = src.child_tokens(n)
    if len(idents) != 1 or src.token_text(idents[0]) != "Result":
        return None
    let args = src.first_child(n, SyntaxKind.GenericArgs) else:
        return None
    let ts = type_children(src, args)
    # `[`, `,` and `]`, and no trailing comma.
    let tokens = len(src.child_tokens(args))
    if len(ts) != 2 or tokens != 3 or has_comment(src, n) or has_comment(src, args):
        return None
    return Some((ts[0], ts[1]))

## `Result[T, E]`'s `T` and `E`, when the formatter writes it `T ! E`.
pure def result_sugar(src: Src, n: int, error_sets: set[String]) -> (int, int)?:
    let parts = result_parts(src, n) else:
        return None
    let (t, e) = parts
    if src.kind(e) != SyntaxKind.PathType or src.first_child(e, SyntaxKind.GenericArgs).is_some():
        return None
    if not error_sets.contains(src.node_text(e).trim().to_string()):
        return None
    if result_parts(src, t).is_some():
        return None
    match src.kind(t):
        case PathType | TupleType | ParenType | RefType | DynType | OptionType:
            pass
        case _:
            return None
    match src.parent_kind(n):
        case Some(RefType) | Some(OptionType):
            return None
        case _:
            return Some((t, e))

## `Option[T]`'s `T`, when the formatter writes it `T?`.
pub pure def option_sugar(src: Src, n: int) -> int?:
    return option_sugar_assuming(src, n, None)

## `option_sugar`, with the option `assumed` taken to be written `T?`.
## Whether the inner option of `Option[Option[T]]` is written `T?` depends
## on whether the outer one is, which depends on whether the inner one
## is: the inner one, asking about the outer one, assumes it is (so the
## outer one, whose `T` is optional, is not), and `Option[Option[T]]` is
## written `Option[T?]`, as decision 152 has it (stage 0 asks without end
## and overflows its stack, DISCREPANCIES.md's D6).
pure def option_sugar_assuming(src: Src, n: int, assumed: int?) -> int?:
    if src.kind(n) != SyntaxKind.PathType:
        return None
    let idents = src.child_tokens(n)
    if len(idents) != 1 or src.token_text(idents[0]) != "Option":
        return None
    let args = src.first_child(n, SyntaxKind.GenericArgs) else:
        return None
    let ts = type_children(src, args)
    if len(ts) != 1 or len(src.child_tokens(args)) != 2:
        return None
    let arg = ts[0]
    # Nothing in it but the type and spaces: a comment would have nowhere
    # to go. (Stage 0 refuses spaces too, and then its self-check refuses
    # the file, D7.)
    if has_comment(src, n) or has_comment(src, args):
        return None
    var arg_kind = src.kind(arg)
    if assumed == Some(arg) or option_sugar(src, arg).is_some():
        arg_kind = SyntaxKind.OptionType
    elif result_parts(src, arg).is_some():
        # `Result[T, E]?` would read `T ! E?` once written with `!`.
        arg_kind = SyntaxKind.ResultType
    match arg_kind:
        case PathType | TupleType | RefType | DynType | ParenType:
            pass
        case _:
            return None
    let parent = src.parent_kind(n)
    match parent:
        case Some(RefType) | Some(OptionType):
            return None
        case _:
            pass
    # `Option[Option[T]]` written `Option[T]?` would be `T??`.
    if parent == Some(SyntaxKind.GenericArgs):
        if let Some(p) = src.parent(n):
            if let Some(outer) = src.parent(p):
                if option_sugar_assuming(src, outer, Some(n)) == Some(n):
                    return None
    return Some(arg)

impl Walker:
    pure def node(mut self, n: int):
        let kind = self.src.kind(n)
        let start = self.src.tree.nodes[n].start
        let end = self.src.tree.nodes[n].end
        # A string, with its interpolations, is written as it is.
        if kind == SyntaxKind.StringExpr:
            let t = Tok.new(SyntaxKind.StringStart, self.src.node_text(n), kind, Some(n), start)
            self.push(t)
            return
        if let Some(parts) = result_sugar(self.src, n, self.error_sets):
            let (t, e) = parts
            self.node(t)
            let at = self.src.tree.nodes[e].start
            self.push(Tok.new(SyntaxKind.Bang, "!", SyntaxKind.ResultType, Some(n), at))
            self.node(e)
            return
        if let Some(arg) = option_sugar(self.src, n):
            self.node(arg)
            self.push(Tok.new(SyntaxKind.Question, "?", SyntaxKind.OptionType, Some(n), end))
            return
        var children = self.src.tree.nodes[n].children.copy()
        if kind == SyntaxKind.FromImport:
            children = without_pruned(self.src, children, self.pruned)
        for e in children:
            match e:
                case Node(c):
                    if not self.pruned.contains(c):
                        self.node(c)
                case Leaf(t):
                    self.token(t, n)

    pure def push(mut self, own t: Tok):
        if self.cur.is_empty():
            self.cur_col = col_of(self.src.text, t.pos)
        self.cur.push(t)
        self.fresh = False

    pure def token(mut self, t: int, parent: int):
        let token = self.src.tree.tokens[t]
        match token.kind:
            case Whitespace | Eof:
                pass
            case LineBreak:
                if self.cur.is_empty() and self.fresh:
                    self.blank += 1
                self.fresh = True
            case Comment | DocComment | ModuleDocComment:
                let text = self.src.text.byte_slice(token.start, token.end).trim_end().to_string()
                if self.cur.is_empty():
                    let col = col_of(self.src.text, token.start)
                    self.pending.push(
                        CommentLine(text=text, col=col, blank_before=self.blank, depth=0)
                    )
                    self.blank = 0
                else:
                    let last = len(self.cur) - 1
                    self.cur[last].comments.push((self.fresh, text))
                self.fresh = False
            case Newline:
                let toks = self.cur.copy()
                self.cur.clear()
                var item: int? = None
                if let Some(first) = toks.first():
                    if let Some(n) = first.node:
                        item = top_item(self.src, n)
                var item_kind = SyntaxKind.Error
                if let Some(i) = item:
                    item_kind = self.src.kind(i)
                let comments = self.pending.copy()
                self.pending.clear()
                self.lines.push(
                    Line(
                        depth=self.depth,
                        toks=toks,
                        blank_before=self.blank,
                        comments_before=comments,
                        col=self.cur_col,
                        item=item,
                        item_kind=item_kind,
                    )
                )
                self.blank = 0
                self.fresh = True
            case Indent:
                self.depth += 1
            case Dedent:
                self.depth = max(self.depth - 1, 0)
            case _:
                let pk = self.src.kind(parent)
                var op_root: int? = None
                if pk == SyntaxKind.BinExpr or pk == SyntaxKind.CompareExpr:
                    op_root = Some(chain_root(self.src, parent))
                let text = self.src.text.byte_slice(token.start, token.end)
                var tok = Tok.new(token.kind, text, pk, Some(parent), token.start)
                tok.op_root = op_root
                self.push(tok)

    ## The lines, and the comments after the last one.
    pure def into_lines(own self) -> (list[Line], list[CommentLine]):
        return (self.lines, self.pending)

## A `from` import's children without its unused names, each with the
## comma after it (or, for the last, the one before it).
pure def without_pruned(src: Src, children: list[Element], pruned: set[int]) -> list[Element]:
    var drop: list[bool] = []
    for _ in children:
        drop.push(False)
    for i in range(len(children)):
        var c = -1
        if let Node(x) = children[i]:
            c = x
        if c < 0 or not pruned.contains(c):
            continue
        drop[i] = True
        var after: int? = None
        for k in range(i + 1, len(children)):
            if significant(src, children[k]):
                after = Some(k)
                break
        if let Some(k) = after:
            if is_comma(src, children[k]) and not drop[k]:
                drop[k] = True
                continue
        var before: int? = None
        var k = i - 1
        while k >= 0:
            if significant(src, children[k]) and not drop[k]:
                before = Some(k)
                break
            k -= 1
        if let Some(b) = before:
            if is_comma(src, children[b]):
                drop[b] = True
    var out: list[Element] = []
    for i in range(len(children)):
        if not drop[i]:
            out.push(children[i])
    return out

pure def is_comma(src: Src, e: Element) -> bool:
    if let Leaf(t) = e:
        return src.tree.tokens[t].kind == SyntaxKind.Comma
    return False

pure def significant(src: Src, e: Element) -> bool:
    if let Leaf(t) = e:
        return not src.tree.tokens[t].kind.is_trivia()
    return True

## The child of the file that holds `n`.
pure def top_item(src: Src, n: int) -> int?:
    var cur = n
    while True:
        let p = src.parent(cur) else:
            return None
        if src.kind(p) == SyntaxKind.SourceFile:
            return Some(cur)
        cur = p

## The class of a binary operator: operators of one class chain (`a + b -
## c`), and a chain is broken before each of its operators.
pure def op_class(src: Src, n: int) -> int:
    for t in src.child_tokens(n):
        match src.token_kind(t):
            case LParen | RParen:
                continue
            case OrKw:
                return 1
            case AndKw:
                return 2
            case QuestionQuestion:
                return 3
            case Plus | Minus | PlusPercent | MinusPercent | PlusPipe | MinusPipe:
                return 4
            case Star | Slash | SlashSlash | Percent | StarPercent | StarPipe:
                return 5
            case Shl | Shr:
                return 6
            case Amp | Pipe | Caret:
                return 7
            case StarStar:
                return 8
            case _:
                return 9
    return 0

## The root of the chain of binary operators that `n`'s operator is in:
## the outermost expression above it of the same class.
pure def chain_root(src: Src, n: int) -> int:
    var cur = n
    if src.kind(n) == SyntaxKind.CompareExpr:
        return n
    let class = op_class(src, n)
    while let Some(p) = src.parent(cur):
        if src.kind(p) == SyntaxKind.BinExpr and op_class(src, p) == class:
            cur = p
        else:
            break
    return cur

pure def is_open(k: SyntaxKind) -> bool:
    return match k:
        case LParen | LBracket | LBrace: True
        case _: False

pure def is_close(k: SyntaxKind) -> bool:
    return match k:
        case RParen | RBracket | RBrace: True
        case _: False

## The brackets whose contents take a trailing comma when they are written
## one per line.
pure def takes_trailing_comma(k: SyntaxKind) -> bool:
    return match k:
        case ArgList | ParamList | ListExpr | DictExpr | SetExpr | TupleExpr: True
        case GenericArgs | GenericParams | TupleType | ListPat | TuplePat: True
        case PatArgs | FnType | FromImport | ClosureParams: True
        case _: False

pure def is_tuple(k: SyntaxKind) -> bool:
    return match k:
        case TupleExpr | TupleType | TuplePat: True
        case _: False

## The layout of one logical line.
view struct Layout:
    src: Src
    toks: ref list[Tok]
    ## Each bracket's mate on the line, -1 for one without.
    mate: list[int]
    space: list[bool]
    ## The extra indentation of a broken chain's lines.
    cont: int

impl Layout:
    pure def comments(self, mut docs: Docs, i: int, mut out: list[int]):
        for (alone, c) in self.toks[i].comments:
            if alone:
                out.push(docs.add(Doc.Comment(c.copy())))
            else:
                out.push(docs.add(Doc.Suffix("  {c}")))

    ## The tokens `lo..hi`, laid out.
    pure def build(self, mut docs: Docs, lo: int, hi: int, mut out: list[int]):
        var i = lo
        while i < hi:
            if i > lo and self.space[i]:
                out.push(docs.text(" "))
            if let Some(found) = self.chain_at(i, hi):
                let (root, end) = found
                out.push(self.chain(mut docs, root, i, end))
                i = end
                continue
            let j = self.mate[i]
            if is_open(self.toks[i].kind) and j > i and j < hi:
                out.push(self.bracket(mut docs, i, j))
                i = j + 1
                continue
            out.push(docs.text(self.toks[i].text))
            self.comments(mut docs, i, mut out)
            i += 1

    ## The outermost chain of binary operators that starts at token `i`
    ## and ends before `hi`, with its end.
    pure def chain_at(self, i: int, hi: int) -> (int, int)?:
        var best: (int, int)? = None
        for k in range(i, hi):
            let root = self.toks[k].op_root ?? -1
            if root < 0:
                continue
            let start = self.src.tree.nodes[root].start
            let stop = self.src.tree.nodes[root].end
            # The chain's tokens are those inside its root's range.
            var first = -1
            for x in range(len(self.toks)):
                if self.toks[x].pos >= start and self.toks[x].pos < stop:
                    first = x
                    break
            if first != i:
                continue
            var end = i
            while end < len(self.toks) and self.toks[end].pos < stop:
                end += 1
            if end == i or end > hi or end <= i + 1:
                continue
            let longer = match best:
                case Some((_, e)): end > e
                case None: True
            if longer:
                best = Some((root, end))
        return best

    pure def chain(self, mut docs: Docs, root: int, lo: int, hi: int) -> int:
        # The operators of this chain, outside any bracket of it.
        var ops: list[int] = []
        var k = lo
        while k < hi:
            let kind = self.toks[k].kind
            if is_open(kind) and self.mate[k] > k:
                k = self.mate[k] + 1
                continue
            if self.toks[k].op_root == Some(root):
                ops.push(k)
                # `not in` is one operator.
                if kind == SyntaxKind.NotKw and self.next_is_in(k):
                    k += 1
            k += 1
        if ops.is_empty():
            var out: list[int] = []
            self.build_plain(mut docs, lo, hi, mut out)
            return docs.group(out, False)
        var head: list[int] = []
        self.build(mut docs, lo, ops[0], mut head)
        var rest: list[int] = []
        for n in range(len(ops)):
            let op = ops[n]
            var next_op = hi
            if n + 1 < len(ops):
                next_op = ops[n + 1]
            rest.push(docs.add(Doc.Line))
            var j = op
            var text = self.toks[op].text.copy()
            if self.toks[op].kind == SyntaxKind.NotKw and self.next_is_in(op):
                self.comments(mut docs, op, mut rest)
                j += 1
                text.push(" in")
            rest.push(docs.add(Doc.Text(text)))
            self.comments(mut docs, j, mut rest)
            if j + 1 < next_op:
                if self.space[j + 1]:
                    rest.push(docs.text(" "))
                self.build(mut docs, j + 1, next_op, mut rest)
        head.push(docs.indent(self.cont, rest))
        return docs.group(head, False)

    ## Whether the token after `k` is `in`.
    pure def next_is_in(self, k: int) -> bool:
        return k + 1 < len(self.toks) and self.toks[k + 1].kind == SyntaxKind.InKw

    ## The tokens as they come, without looking for chains (inside a chain
    ## that has none of its own).
    pure def build_plain(self, mut docs: Docs, lo: int, hi: int, mut out: list[int]):
        for i in range(lo, hi):
            if i > lo and self.space[i]:
                out.push(docs.text(" "))
            out.push(docs.text(self.toks[i].text))
            self.comments(mut docs, i, mut out)

    pure def bracket(self, mut docs: Docs, i: int, j: int) -> int:
        let open = self.toks[i].text.copy()
        let close = self.toks[j].text.copy()
        var after_open: list[int] = []
        self.comments(mut docs, i, mut after_open)
        var after_close: list[int] = []
        self.comments(mut docs, j, mut after_close)
        if j == i + 1:
            var empty: list[int] = []
            if after_open.is_empty():
                empty.push(docs.add(Doc.Text("{open}{close}")))
            else:
                empty.push(docs.text(open))
                empty.push(docs.indent(INDENT, after_open))
                empty.push(docs.add(Doc.Soft))
                empty.push(docs.text(close))
            empty.extend(after_close)
            return docs.group(empty, False)
        if self.toks[i].parent == SyntaxKind.Comprehension:
            return self.comprehension(mut docs, i, j, after_open, after_close)
        # The elements: split at this bracket's own commas.
        let node = self.toks[i].node
        var elems: list[(int, int)] = []
        var commas: list[int] = []
        var start = i + 1
        var k = i + 1
        while k < j:
            let kind = self.toks[k].kind
            if is_open(kind) and self.mate[k] > k and self.mate[k] < j:
                k = self.mate[k] + 1
                continue
            if kind == SyntaxKind.Comma and self.toks[k].node == node:
                elems.push((start, k))
                commas.push(k)
                start = k + 1
            k += 1
        elems.push((start, j))
        let kind = self.toks[i].parent
        # A trailing comma: magic, except the one a tuple of one needs.
        var trailing: int? = None
        let (last_start, last_end) = elems[len(elems) - 1]
        if last_start == last_end and len(elems) > 1:
            _ = elems.pop()
            trailing = commas.pop()
        let one_tuple = is_tuple(kind) and len(elems) == 1 and trailing.is_some()
        let eligible = takes_trailing_comma(kind) and not (is_tuple(kind) and len(elems) < 2)
        let magic = trailing.is_some() and not one_tuple and takes_trailing_comma(kind)
        var inner: list[int] = []
        let last = max(len(elems) - 1, 0)
        for n in range(len(elems)):
            let (s, e) = elems[n]
            if n > 0:
                let c = commas[n - 1]
                inner.push(docs.text(","))
                self.comments(mut docs, c, mut inner)
                inner.push(docs.add(Doc.Line))
            if s >= e:
                continue
            if n == last:
                # The last element's own comments come after its comma.
                self.build_without_last_comments(mut docs, s, e, mut inner)
                if one_tuple:
                    inner.push(docs.text(","))
                elif eligible and (len(elems) >= 2 or magic):
                    inner.push(docs.add(Doc.IfBreak(",".to_string())))
                self.comments(mut docs, e - 1, mut inner)
                if let Some(t) = trailing:
                    self.comments(mut docs, t, mut inner)
            else:
                self.build(mut docs, s, e, mut inner)
        var body = after_open
        body.push(docs.add(Doc.Soft))
        body.push(docs.group(inner, magic))
        var all: list[int] = [docs.text(open)]
        all.push(docs.indent(INDENT, body))
        all.push(docs.add(Doc.Soft))
        all.push(docs.text(close))
        all.extend(after_close)
        # A definition's parameters break first (Black's left-hand split).
        return docs.group_with(all, False, kind == SyntaxKind.ParamList)

    ## A comprehension: when it does not fit on a line, each `for` and `if`
    ## clause starts a line of its own, as Black writes them.
    pure def comprehension(
        self, mut docs: Docs, i: int, j: int, own after_open: list[int], own after_close: list[int]
    ) -> int:
        let node = self.toks[i].node
        var cuts: list[int] = [i + 1]
        var k = i + 1
        while k < j:
            let t = ref self.toks[k]
            if is_open(t.kind) and self.mate[k] > k and self.mate[k] < j:
                k = self.mate[k] + 1
                continue
            if is_clause(t) and self.parent_of(t) == node:
                cuts.push(k)
            k += 1
        cuts.push(j)
        var inner: list[int] = []
        for w in range(len(cuts) - 1):
            if cuts[w] > i + 1:
                inner.push(docs.add(Doc.Line))
            self.build(mut docs, cuts[w], cuts[w + 1], mut inner)
        var body = after_open
        body.push(docs.add(Doc.Soft))
        body.push(docs.group(inner, False))
        var all: list[int] = [docs.text(self.toks[i].text)]
        all.push(docs.indent(INDENT, body))
        all.push(docs.add(Doc.Soft))
        all.push(docs.text(self.toks[j].text))
        all.extend(after_close)
        return docs.group(all, False)

    ## The parent of the node a token belongs to.
    pure def parent_of(self, t: Tok) -> int?:
        if let Some(n) = t.node:
            return self.src.parent(n)
        return None

    ## `build`, leaving out the comments of the last token.
    pure def build_without_last_comments(
        self, mut docs: Docs, lo: int, hi: int, mut out: list[int]
    ):
        var built: list[int] = []
        self.build(mut docs, lo, hi, mut built)
        let n = len(self.toks[hi - 1].comments)
        if n == 0:
            out.extend(built)
            return
        # The last token's comments are the last docs pushed at the
        # innermost level: strip them where they are.
        let l = docs.list(built)
        strip_tail_comments(mut docs, l, n)
        out.extend(docs.lists[l].copy())

## Whether a token is the `for` or `if` of a comprehension's clause.
pure def is_clause(t: Tok) -> bool:
    let keyword = match t.kind:
        case ForKw | IfKw: True
        case _: False
    let clause = match t.parent:
        case CompFor | CompIf: True
        case _: False
    return keyword and clause

## Removes the last `n` comment docs of the list `l`, wherever the last
## ones are nested.
pure def strip_tail_comments(mut docs: Docs, l: int, n: int):
    var left = n
    while left > 0:
        let size = len(docs.lists[l])
        if size == 0:
            return
        let d = docs.lists[l][size - 1]
        var inner = -1
        var comment = False
        match docs.nodes[d]:
            case Suffix(_) | Comment(_):
                comment = True
            case Group(g):
                inner = g.docs
            case Indent(_, i):
                inner = i
            case _:
                pass
        if comment:
            _ = docs.lists[l].pop()
            left -= 1
        elif inner >= 0:
            strip_tail_comments(mut docs, inner, left)
            return
        else:
            return

pure def line_text(src: Src, line: Line) -> String:
    let toks = ref line.toks
    let n = len(toks)
    var mate: list[int] = []
    for _ in range(n):
        mate.push(-1)
    var stack: list[int] = []
    for i in range(n):
        if is_open(toks[i].kind):
            stack.push(i)
        elif is_close(toks[i].kind):
            if let Some(o) = stack.pop():
                mate[o] = i
                mate[i] = o
    var spaced: list[bool] = []
    for i in range(n):
        spaced.push(i > 0 and space.between(toks[i - 1], toks[i]))
    var cont = INDENT
    if n > 0 and toks[n - 1].kind == SyntaxKind.Colon:
        cont = 2 * INDENT
    let reading = Src(tree=src.tree, text=src.text)
    let layout = Layout(src=reading, toks=toks, mate=mate, space=spaced, cont=cont)
    var docs = Docs.new()
    var top: list[int] = []
    var multi = False
    for t in toks:
        if t.text.contains("\n"):
            multi = True
    # A line with a string over several lines is written as it is.
    if multi:
        layout.build_plain(mut docs, 0, n, mut top)
    elif n > 0:
        # The comment that ends the line is outside every group: it needs
        # no line break, and so forces none.
        layout.build_without_last_comments(mut docs, 0, n, mut top)
        layout.comments(mut docs, n - 1, mut top)
    let l = docs.list(top)
    return doc.print(mut docs, l, line.depth * INDENT, WIDTH)

## The kinds of top-level item that stand apart, with a blank line before
## and after.
pure def is_block_item(k: SyntaxKind) -> bool:
    return match k:
        case FnDef | StructDef | EnumDef | ErrorDef | ImplDef | TraitDef: True
        case TestDef | SuiteDef | BenchDef | ExternBlock: True
        case _: False

pure def is_import_line(l: Line) -> bool:
    if l.depth != 0:
        return False
    match l.item_kind:
        case ImportItem | FromImport:
            pass
        case _:
            return False
    if let Some(first) = l.toks.first():
        return first.kind == SyntaxKind.ImportKw or first.kind == SyntaxKind.FromKw
    return False

## The key a line sorts by among imports: `import`s first, then by module
## path, then by the whole line.
pure def import_key(l: Line) -> (int, String, String):
    var kind = 1
    if let Some(first) = l.toks.first():
        if first.kind == SyntaxKind.ImportKw:
            kind = 0
    var path = String.new()
    var k = 1
    while k < len(l.toks):
        match l.toks[k].kind:
            case Ident | Dot:
                path.push(l.toks[k].text)
            case _:
                break
        k += 1
    var all: list[String] = []
    for t in l.toks:
        all.push(t.text.copy())
    return (kind, path, all.join(" "))

pure def import_order(a: Line, b: Line) -> Ordering:
    let (ka, pa, wa) = import_key(a)
    let (kb, pb, wb) = import_key(b)
    if ka != kb:
        return ka.cmp(kb)
    if pa != pb:
        return pa.cmp(pb)
    return wa.cmp(wb)

## Sorts the names a `from ... import` line imports.
pure def sort_names(mut l: Line):
    if len(l.toks) == 0 or l.toks[0].kind != SyntaxKind.FromKw:
        return
    for t in l.toks:
        if not t.comments.is_empty():
            return
    var at = -1
    for k in range(len(l.toks)):
        if l.toks[k].kind == SyntaxKind.ImportKw:
            at = k
            break
    if at < 0:
        return
    var body: list[Tok] = []
    for k in range(at + 1, len(l.toks)):
        body.push(l.toks[k].copy())
    let parens = not body.is_empty() and body[0].kind == SyntaxKind.LParen
    if parens:
        _ = body.remove(0)
        if not body.is_empty() and body[len(body) - 1].kind == SyntaxKind.RParen:
            _ = body.pop()
    var comma: Tok? = None
    for t in body:
        if t.kind == SyntaxKind.Comma:
            comma = Some(t.copy())
            break
    var names: list[list[Tok]] = []
    var name: list[Tok] = []
    for t in body:
        if t.kind == SyntaxKind.Comma:
            if not name.is_empty():
                names.push(name.copy())
            name.clear()
        else:
            name.push(t.copy())
    if not name.is_empty():
        names.push(name)
    if len(names) < 2:
        return
    let had_trailing = not body.is_empty() and body[len(body) - 1].kind == SyntaxKind.Comma
    names.sort_by((a, b) -> a[0].text.cmp(b[0].text))
    var rebuilt: list[Tok] = []
    for k in range(at + 1):
        rebuilt.push(l.toks[k].copy())
    if parens:
        rebuilt.push(l.toks[at + 1].copy())
    let sep = comma ?? Tok.new(SyntaxKind.ErrorToken, "", SyntaxKind.Error, None, 0)
    for i in range(len(names)):
        if i > 0:
            rebuilt.push(sep.copy())
        rebuilt.extend(names[i].copy())
    if had_trailing:
        rebuilt.push(sep.copy())
    if parens:
        rebuilt.push(l.toks[len(l.toks) - 1].copy())
    l.toks = rebuilt

pure def sort_imports(mut lines: list[Line]):
    var i = 0
    while i < len(lines):
        if not is_import_line(lines[i]):
            i += 1
            continue
        var j = i + 1
        while j < len(lines) and is_import_line(lines[j]) and lines[j].comments_before.is_empty():
            if lines[j].blank_before != 0:
                break
            j += 1
        for k in range(i, j):
            sort_names(mut lines[k])
        # The run's leading comments and blank lines stay at its head.
        let head_comments = lines[i].comments_before.copy()
        lines[i].comments_before.clear()
        let head_blank = lines[i].blank_before
        var run: list[Line] = []
        for k in range(i, j):
            run.push(lines[k].copy())
        run.sort_by((a, b) -> import_order(a, b))
        for k in range(i, j):
            lines[k] = run[k - i].copy()
        lines[i].comments_before = head_comments
        lines[i].blank_before = head_blank
        for k in range(i + 1, j):
            lines[k].blank_before = 0
        i = j

## The formatted text of a parsed file.
pub pure def format_tree(tree: Tree, error_sets: set[String]) -> String:
    let text: str = tree.text
    let src = Src(tree=tree, text=text)
    return format_pruned(src, error_sets, prune.unused(src))

## The formatted text of the parsed file `src` reads, without the imports
## `pruned` names (`prune.unused` of the tree).
pub pure def format_pruned(src: Src, error_sets: set[String], pruned: set[int]) -> String:
    var w = Walker(
        src=Src(tree=src.tree, text=src.text),
        lines=[],
        cur=[],
        cur_col=0,
        depth=0,
        blank=0,
        fresh=True,
        pending=[],
        pruned=pruned.copy(),
        error_sets=error_sets.copy(),
    )
    w.node(src.tree.root)
    var (lines, tail) = w.into_lines()
    # Each comment between lines takes the level of the line after it, or
    # of a block it was written inside (by its column).
    var indent_of: list[int] = []
    var prev_depth = 0
    for i in range(len(lines)):
        let depth = lines[i].depth
        place_comments(mut lines[i].comments_before, prev_depth, depth, indent_of)
        while len(indent_of) <= depth:
            indent_of.push(0)
        indent_of[depth] = lines[i].col
        while len(indent_of) > depth + 1:
            _ = indent_of.pop()
        prev_depth = depth
    place_comments(mut tail, prev_depth, 0, indent_of)
    sort_imports(mut lines)
    var out = Output(text=String.new(), first=True)
    var last_depth = 0
    var prev_block_item = False
    var prev_item: int? = None
    var prev_attr = False
    for l in lines:
        let starts_item = l.depth == 0 and l.item != prev_item
        let block = is_block_item(l.item_kind)
        # The blank lines the line needs before it (and before the comments
        # right above it), when the rules fix them.
        var needed: int? = None
        if l.depth > last_depth:
            needed = Some(0)
        elif starts_item and (block or prev_block_item):
            needed = Some(1)
        elif l.depth == 0 and not starts_item and prev_attr:
            needed = Some(0)
        # Comments deeper than the line close the block before it; the
        # others are above the line.
        var split = 0
        var k = len(l.comments_before) - 1
        while k >= 0:
            if l.comments_before[k].depth > l.depth:
                split = k + 1
                break
            k -= 1
        for c in range(split):
            let inner = ref l.comments_before[c]
            out.comment(inner, min(inner.blank_before, 1))
        let attached = l.blank_before == 0
        for c in range(split, len(l.comments_before)):
            let above = ref l.comments_before[c]
            var blank = min(above.blank_before, 1)
            if c == split:
                if let Some(fixed) = needed:
                    if attached or fixed == 1:
                        blank = fixed
            out.comment(above, blank)
        var blank = needed ?? min(l.blank_before, 1)
        if split < len(l.comments_before) and attached:
            blank = 0
        out.line(line_text(src, l), blank)
        if starts_item:
            prev_block_item = block
        if l.depth == 0:
            prev_item = l.item
            prev_attr = False
            if let Some(first) = l.toks.first():
                prev_attr = first.kind == SyntaxKind.At
        last_depth = l.depth
    for n in range(len(tail)):
        let c = ref tail[n]
        var blank = min(c.blank_before, 1)
        if n == 0 and prev_block_item and c.depth == 0:
            blank = 1
        out.comment(c, blank)
    return out.text

## The formatted text so far.
struct Output:
    text: String
    first: bool

impl Output:
    pure def blank(mut self, n: int):
        if not self.first:
            for _ in range(n):
                self.text.push("\n")
        self.first = False

    pure def comment(mut self, c: CommentLine, blank: int):
        self.blank(blank)
        self.text.push(" ".repeat(c.depth * INDENT))
        self.text.push(c.text)
        self.text.push("\n")

    pure def line(mut self, text: str, blank: int):
        self.blank(blank)
        self.text.push(text)
        self.text.push("\n")

## The levels of the comments before a line at `next` after one at
## `prev`: the next line's, or the deepest enclosing block's whose
## indentation the comment is written at or beyond.
pure def place_comments(
    mut comments: list[CommentLine], prev: int, next: int, indent_of: list[int]
):
    for k in range(len(comments)):
        comments[k].depth = next
        if prev > next:
            var d = prev
            while d >= next + 1:
                if d < len(indent_of) and comments[k].col >= indent_of[d]:
                    comments[k].depth = d
                    break
                d -= 1
