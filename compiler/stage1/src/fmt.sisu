##! `sisu fmt` (10, "Formatter"; 02, "Formatting"; stage 0's `sisu-fmt`):
##! the formatter with no options. Four spaces, 100 columns, Black's
##! bracket-first line splitting with breaks before binary operators, a
##! magic trailing comma, trailing commas in multi-line constructs, sorted
##! imports with the unused ones removed, one blank line between items,
##! `T?` for `Option[T]`, `T ! E` for `Result[T, E]` when `E` is an error
##! set, and every comment kept, word for word. Whether `E` is an error set
##! is not in the syntax: the caller says, with `format_with`, from the
##! names it resolved (the answers for the types `written_errors` lists),
##! and `format` keeps every `Result[T, E]` as written.
##!
##! It works on the lossless tree, so it never disagrees with the parser:
##! the tree's tokens are regrouped into logical lines (the lexer's
##! `NEWLINE`s), each laid out by the printer of `fmt.doc`, and the blank
##! lines and comments between them placed by the rules of `fmt.lines`. It
##! never changes which block a statement belongs to. A file with a syntax
##! error is not formatted, and the result is checked before it is
##! returned: it must parse to the same tree as the input, up to what the
##! formatter changes on purpose (`fmt.shape`), or the formatter refuses.

from stage1.diag import Catalog, Diagnostic
from stage1.fmt.lines import Src, result_parts
from stage1.parser import parse
from stage1.syntax.kinds import SyntaxKind

## The widest line the formatter writes (when a line can be broken).
pub const WIDTH: int = 100
## One level of indentation.
pub const INDENT: int = 4

## Why a file was not formatted.
pub error Refusal:
    ## The file has syntax errors: it is left as it is.
    Syntax(diagnostics: list[Diagnostic])
    ## The formatted text would not parse to the same tree: a bug of the
    ## formatter, reported rather than written.
    Changed(at: int)

## The canonical text of `text`, with every `Result[T, E]` as written.
pub pure def format(text: str, catalog: Catalog) -> String ! Refusal:
    return format_with(text, set(), catalog)

## The canonical text of `text`, where `error_sets` holds the types, as
## written (`E`, `json.Error`), that name error sets, so that `Result[T,
## E]` is written `T ! E`.
pub pure def format_with(text: str, error_sets: set[String], catalog: Catalog) -> String ! Refusal:
    let parsed = parse(text, catalog)
    var errors: list[Diagnostic] = []
    for d in parsed.diagnostics:
        if catalog.is_error(d.msg):
            errors.push(d.copy())
    if not errors.is_empty():
        return Err(Syntax(diagnostics=errors))
    let whole: str = parsed.tree.text
    let src = Src(tree=ref parsed.tree, text=whole)
    let pruned = prune.unused(src)
    let out = lines.format_pruned(src, error_sets, pruned)
    # The self-check (02: "an AST-equality self-check"). A text that comes
    # out as it went in parses to the tree it was parsed to, so it has
    # passed the check already.
    if out == text:
        return Ok(out)
    let again = parse(out, catalog)
    for d in again.diagnostics:
        if catalog.is_error(d.msg):
            return Err(Changed(at=d.start))
    let a = shape.shape_pruned(src, pruned)
    let b = shape.shape_of(again.tree)
    if a != b:
        var at = 0
        let n = min(a.byte_len(), b.byte_len())
        while at < n and a.byte_at(at) == b.byte_at(at):
            at += 1
        if at == n:
            at = 0
        return Err(Changed(at=at))
    return Ok(out)

## The types written as the `E` of a `Result[T, E]` that the formatter
## writes `T ! E` when `E` names an error set: those the caller of
## `format_with` answers for. None for a text with a syntax error, which
## is not formatted.
pub pure def written_errors(text: str, catalog: Catalog) -> list[String]:
    let parsed = parse(text, catalog)
    for d in parsed.diagnostics:
        if catalog.is_error(d.msg):
            return []
    let tree = ref parsed.tree
    let whole: str = tree.text
    let src = Src(tree=tree, text=whole)
    var out: list[String] = []
    for n in range(len(tree.nodes)):
        if let Some(parts) = result_parts(src, n):
            let e = parts.1
            if src.kind(e) == SyntaxKind.PathType:
                if src.first_child(e, SyntaxKind.GenericArgs).is_none():
                    let written = src.node_text(e).trim().to_string()
                    if not out.contains(written):
                        out.push(written)
    return out

# The tests read the message catalog for the parser's diagnostics, so they
# run from this package's directory, as the parser's do.
def test_catalog(sys: System) -> Catalog:
    let text = sys.fs.read_to_string(Path.new("../catalog/messages.catalog")) else:
        panic("the tests read the catalog at ../catalog/messages.catalog")
    return Catalog.parse(text)

pure def formatted(text: str, catalog: Catalog) -> String:
    return formatted_with(text, set(), catalog)

pure def formatted_with(text: str, error_sets: set[String], catalog: Catalog) -> String:
    match format_with(text, error_sets, catalog):
        case Ok(out):
            return out
        case Err(_):
            panic("the formatter refused:\n{text}")

test "spacing and indentation"(sys: System):
    let catalog = test_catalog(sys)
    let src = "def f(a:int,b:str='x')->int:\n  let d={{'a':1}}\n  return f( a=1 )+-a\n"
    let expected = "def f(a: int, b: str = \"x\") -> int:\n    let d = {{\"a\": 1}}\n    return f(a=1) + -a\n"
    assert formatted(src.replace("'", "\""), catalog) == expected

test "idempotent on its output"(sys: System):
    let catalog = test_catalog(sys)
    var src = "import std.json\nfrom std.time import Duration, DateTime\nimport cli\n\n\n\n".to_string()
    src.push("struct P:\n    x: int\n    def get(self) -> int:\n        return self.x\n")
    src.push("def main():\n    print(json, cli, Duration, DateTime)\n")
    let once = formatted(src, catalog)
    assert formatted(once, catalog) == once
    let head = "import cli\nimport std.json\nfrom std.time import DateTime, Duration\n\nstruct P:"
    assert once.starts_with(head)

test "unused imports are removed"(sys: System):
    let catalog = test_catalog(sys)
    var src = "import std.json\nimport std.num as n\n".to_string()
    src.push("from std.time import Duration, DateTime, Instant\n")
    src.push("pub from std.collections import Deque\n\n## `Instant` in a doc comment counts.\n")
    src.push("def main():\n    print(Duration.seconds(1))\n")
    var expected = "from std.time import Duration, Instant\n".to_string()
    expected.push(
        "pub from std.collections import Deque\n\n## `Instant` in a doc comment counts.\n"
    )
    expected.push("def main():\n    print(Duration.seconds(1))\n")
    assert formatted(src, catalog) == expected
    # One with a comment inside stays.
    let kept = "import std.json  # for later\n"
    assert formatted(kept, catalog) == kept

test "a comment at the end does not break the line"(sys: System):
    let catalog = test_catalog(sys)
    var src = "def main():\n    let x = f(a, b) + 1  # ".to_string()
    src.push("c".repeat(100))
    src.push("\n")
    assert formatted(src, catalog) == src

test "a definition breaks its parameters first"(sys: System):
    let catalog = test_catalog(sys)
    let vs = "V".repeat(40)
    let src = "def f[K](alpha: int, beta: int, gamma: (int) -> K) -> dict[K, {vs}]:\n    pass\n"
    let expected = "def f[K](\n    alpha: int, beta: int, gamma: (int) -> K\n) -> dict[K, {vs}]:\n    pass\n"
    assert formatted(src, catalog) == expected

test "a comprehension breaks before its clauses"(sys: System):
    let catalog = test_catalog(sys)
    let x = "x".repeat(30)
    let src = "def main():\n    let ys = [{x} * 2 for {x} in range(10) if {x} > 2 and {x} < 8]\n"
    var expected = "def main():\n    let ys = [\n        {x} * 2\n".to_string()
    expected.push("        for {x} in range(10)\n        if {x} > 2 and {x} < 8\n    ]\n")
    assert formatted(src, catalog) == expected

test "prefixes and supertraits hug"(sys: System):
    let catalog = test_catalog(sys)
    let prefix = formatted("def f(x: int) -> int:\n    return ~ (x)\n", catalog)
    assert prefix == "def f(x: int) -> int:\n    return ~(x)\n"
    assert formatted("trait Ord (Eq):\n    pass\n", catalog) == "trait Ord(Eq):\n    pass\n"

test "long calls break at brackets"(sys: System):
    let catalog = test_catalog(sys)
    let (a, b, c) = ("a".repeat(40), "b".repeat(40), "c".repeat(40))
    let src = "def main():\n    print(some_function({a}, {b}, {c}))\n"
    let out = formatted(src, catalog)
    assert out.contains("    print(\n        some_function(\n")
    assert formatted(out, catalog) == out

test "comments are kept"(sys: System):
    let catalog = test_catalog(sys)
    var src = "# head\n\ndef main():  # trailing\n    # inside\n    let x = [\n".to_string()
    src.push("        1,  # one\n        # alone\n        2,\n    ]\n    # end of body\n# after\n")
    assert formatted(src, catalog) == src

test "option sugar"(sys: System):
    let catalog = test_catalog(sys)
    let sugared = formatted("def f(x: Option[int]) -> Option[str]:\n    pass\n", catalog)
    assert sugared == "def f(x: int?) -> str?:\n    pass\n"
    # Not when it would read as `??`.
    let kept = "def f(x: Option[int?]):\n    pass\n"
    assert formatted(kept, catalog) == kept
    # The inner option of two (D6), and one with spaces inside (D7).
    assert formatted("def f(x: Option[Option[int]]):\n    pass\n", catalog) == kept
    let spaced = formatted("def f(x: Option[ int ]):\n    pass\n", catalog)
    assert spaced == "def f(x: int?):\n    pass\n"

test "result sugar for error sets"(sys: System):
    let catalog = test_catalog(sys)
    var sets: set[String] = set()
    _ = sets.add("E".to_string())
    _ = sets.add("io.Error".to_string())
    let src = "def f(x: Result[int, E], y: Result[int, T]) -> Result[str, io.Error]:\n    pass\n"
    let expected = "def f(x: int ! E, y: Result[int, T]) -> str ! io.Error:\n    pass\n"
    assert formatted_with(src, sets, catalog) == expected
    let asked = written_errors(src, catalog)
    assert asked == ["E".to_string(), "T".to_string(), "io.Error".to_string()]
    # Not without the names, not behind `ref` or `?`, and not when the
    # value is a function or a result itself.
    assert formatted(src, catalog) == src
    let kept = [
        "def f(x: ref Result[int, E]):\n    pass\n",
        "def f(x: Result[(int) -> int, E]):\n    pass\n",
        "def f(x: Result[int, E]?):\n    pass\n",
    ]
    for k in kept:
        assert formatted_with(k, sets, catalog) == k
    let nested = formatted_with("def f(x: Result[Result[int, E], E]):\n    pass\n", sets, catalog)
    assert nested == "def f(x: Result[int ! E, E]):\n    pass\n"
    # An optional result keeps `Option`, since `int ! E?` would make the
    # error optional.
    let optional = formatted_with("def f(x: Option[Result[int, E]]):\n    pass\n", sets, catalog)
    assert optional == "def f(x: Option[int ! E]):\n    pass\n"

test "refuses broken code"(sys: System):
    let catalog = test_catalog(sys)
    match format("def f(:\n", catalog):
        case Ok(_):
            panic("formatted a file with a syntax error")
        case Err(Syntax(diagnostics)):
            assert not diagnostics.is_empty()
        case Err(Changed(_)):
            panic("refused it as changed")
