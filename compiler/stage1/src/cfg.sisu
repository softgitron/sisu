##! Conditional compilation of items (stage 0's `sisu-driver/src/cfg.rs`;
##! 08, "Conditional compilation": "`@cfg` on items and `if comptime` in
##! bodies"; decision 243). An item (a declaration, an import, a test, an
##! item of a suite or of an `extern` block, or a method of an impl or a
##! trait) whose `@cfg(...)` does not hold is left out before the program is
##! resolved, as if it were not written; one whose `@cfg` holds is kept as
##! written. A condition is `test` (the program is built with its tests),
##! `feature="NAME"` (its package turns the feature on), `not` and a
##! condition, `not(...)` of one condition (so `not(feature="tls")` is a
##! feature that is off, decision 250), or `all(...)` and `any(...)` of
##! conditions; several in one `@cfg` must all hold. A program built
##! without its tests leaves out its `test`, `suite` and `bench` items too.
##! An import's `@cfg` may also test a fact of the target, `target.os ==
##! "windows"` (or `!=`), so that code reaches a dependency that its `when`
##! builds for some targets only (RULES.md, R106); elsewhere such a
##! condition is `E0266`, a body testing the target with `if comptime`.
##!
##! Stage 0 filters the AST; so does stage 1's type checker, and its name
##! pass, which reads the syntax tree, leaves out the nodes of the items
##! and methods the filter left out (`Filtered.left_out`).

from stage1.diag import Catalog, TextRange
from stage1.manifest import target_facts, target_facts_for
from stage1.parser import parse
from stage1.syntax.ast import Ast, Attr, ExprId, ExprKind, FieldDef, FnDef, ItemId, ItemKind, Module, Name
from stage1.syntax.ast import CmpOp, Cond, CondPart, StmtKind, UnOp
from stage1.syntax.ast import VariantDef
from stage1.syntax.ast import build

## A package's features: those its `[features]` declares, and those that
## are on in this build (09); and the runtime the build is for, whose
## `target.runtime` an import's `@cfg` reads (RULES.md, R116 and R128).
@derive(Eq, Debug)
pub struct Features:
    pub declared: list[String]
    pub on: list[String]
    pub runtime: String

impl Features:
    pub pure def none() -> Features:
        return Features(declared=[], on=[], runtime="interpreter".to_string())

    ## No features, in a build for `runtime`.
    pub pure def for_runtime(runtime: str) -> Features:
        return Features(declared=[], on=[], runtime=runtime.to_string())

    ## The facts of the build's target.
    pub pure def facts(self) -> list[(String, String)]:
        return target_facts_for(self.runtime)

## A `@cfg` that is not a condition (`E0266`), or a `feature="NAME"` whose
## package declares no such feature (`W0006`).
@derive(Eq, Debug)
pub enum Problem:
    NotACondition(TextRange)
    UnknownFeature(TextRange, String)

## A module as a build compiles it: the module, when the filter changed it
## (`None` when it is the module as written), the problems its `@cfg`s
## have, and the syntax nodes of the items and methods left out.
pub struct Filtered:
    pub module: Module?
    pub problems: list[Problem]
    pub left_out: list[int]

struct Filter:
    ## Whether the program is built with its tests (Rust's `test`, a
    ## keyword here).
    tests: bool
    features: Features?
    problems: list[Problem]
    left_out: list[int]
    ## The items left out by their `@cfg`, by name, with the condition.
    removed: list[(String, String)]
    ## Whether the `@cfg` looked at is an import's, which may test the
    ## target (RULES.md, R106).
    import_: bool

impl Filter:
    pure def holds(mut self, ast: Ast, e: ExprId, name: Name?) -> bool:
        let range = ast.expr(e).range
        let named = match name:
            case Some(n): Some(n.text.copy())
            case None: None
        match named:
            case Some(n):
                if n == "feature":
                    if let ExprKind.Str(parts) = ast.expr(e).kind:
                        let f = build.plain_text(parts)
                        var declared = False
                        var on = False
                        if let Some(fs) = self.features:
                            declared = fs.declared.contains(f)
                            on = fs.on.contains(f)
                        if not declared:
                            self.problems.push(Problem.UnknownFeature(range, f.copy()))
                        return on
            case None:
                match ast.expr(e).kind:
                    case ExprKind.Name(n):
                        if n == "test":
                            return self.tests
                    case ExprKind.Unary(op, inner):
                        if op == UnOp.Not:
                            return not self.holds(ast, inner, None)
                    case ExprKind.Paren(inner):
                        return self.holds(ast, inner, None)
                    # A fact of the target, on an import (RULES.md, R106).
                    case ExprKind.Compare(first, rest):
                        if self.import_:
                            let facts = match self.features:
                                case Some(fs): fs.facts()
                                case None: target_facts()
                            if let Some(held) = target_condition(ast, first, rest, facts):
                                return held
                    case ExprKind.Call(callee, args, trailing):
                        if trailing.is_none():
                            # `not(...)` of one condition, keyword or not.
                            if let ExprKind.Name(n) = ast.expr(callee).kind:
                                if n == "not":
                                    if len(args) == 1:
                                        return not self.holds(ast, args[0].value, args[0].name)
                                    self.problems.push(Problem.NotACondition(range))
                                    return True
                            var all = False
                            var known = False
                            if let ExprKind.Name(n) = ast.expr(callee).kind:
                                if n == "all":
                                    all = True
                                    known = True
                                elif n == "any":
                                    known = True
                            if not known:
                                self.problems.push(Problem.NotACondition(range))
                                return True
                            var each: list[bool] = []
                            for a in args:
                                each.push(self.holds(ast, a.value, a.name))
                            if all:
                                return not each.contains(False)
                            return each.contains(True)
                    case _:
                        pass
        self.problems.push(Problem.NotACondition(range))
        return True

    ## Whether every `@cfg` among `attrs` holds. Each condition is looked
    ## at, so every problem is reported.
    pure def kept(mut self, ast: Ast, attrs: list[Attr]) -> bool:
        var keep = True
        for a in attrs:
            if a.name != "cfg":
                continue
            if a.args.is_empty():
                # `@cfg` itself: the attribute's range runs to the next line.
                let at = TextRange.new(a.range.start, a.range.start + 1 + a.name.byte_len())
                self.problems.push(Problem.NotACondition(at))
            for arg in a.args:
                let holds = self.holds(ast, arg.value, arg.name)
                keep = keep and holds
        return keep

    pure def methods(mut self, ast: Ast, methods: list[FnDef]) -> list[FnDef]:
        var out: list[FnDef] = []
        for m in methods:
            if self.kept(ast, m.attrs):
                out.push(m.copy())
            else:
                self.left_out.push(m.node)
        return out

    ## The items kept of `items`, with what is in them filtered, into
    ## `ast`, whose items they are.
    pure def items(mut self, mut ast: Ast, items: list[ItemId]) -> list[ItemId]:
        var out: list[ItemId] = []
        for id in items:
            let attrs = ast.item(id).attrs.copy()
            self.import_ = match ast.item(id).kind:
                case ItemKind.Import(_) | ItemKind.FromImport(_): True
                case _: False
            let keep = self.kept(ast, attrs)
            self.import_ = False
            if not keep:
                self.left_out.push(ast.item(id).node)
                if let Some(name) = item_name(ast.item(id).kind):
                    self.removed.push((name, condition_text(ast, attrs)))
                # The names an import left out would bind (RULES.md, R106).
                for name in import_names(ast.item(id).kind):
                    self.removed.push((name.copy(), condition_text(ast, attrs)))
                continue
            var tested = False
            match ast.item(id).kind:
                case ItemKind.Test(_) | ItemKind.Suite(_) | ItemKind.Bench(_):
                    tested = True
                case _:
                    pass
            if not self.tests and tested:
                self.left_out.push(ast.item(id).node)
                continue
            var kind = ast.item(id).kind.copy()
            match ref mut kind:
                case ItemKind.Suite(s):
                    s.items = self.items(mut ast, s.items)
                case ItemKind.Extern(xs):
                    let kept = self.items(mut ast, xs)
                    xs.clear()
                    xs.extend(kept)
                case ItemKind.Impl(imp):
                    imp.methods = self.methods(ast, imp.methods)
                case ItemKind.Trait(t):
                    t.methods = self.methods(ast, t.methods)
                # A struct's fields and methods, and an enum's variants and
                # methods, as an impl's methods (RULES.md, R44).
                case ItemKind.Struct(s):
                    s.methods = self.methods(ast, s.methods)
                    var fields: list[FieldDef] = []
                    for f in s.fields:
                        if self.kept(ast, f.attrs):
                            fields.push(f.copy())
                        else:
                            self.left_out.push(f.node)
                    s.fields = fields
                case ItemKind.Enum(e) | ItemKind.ErrorSet(e):
                    e.methods = self.methods(ast, e.methods)
                    var variants: list[VariantDef] = []
                    for v in e.variants:
                        if self.kept(ast, v.attrs):
                            variants.push(v.copy())
                        else:
                            self.left_out.push(v.node)
                    e.variants = variants
                case _:
                    pass
            ast.items[id.index].kind = kind
            out.push(id)
        return out

## The name an item declares, for the items an import names.
pure def item_name(kind: ItemKind) -> String?:
    return match kind:
        case ItemKind.Fn(f): Some(f.name.text.copy())
        case ItemKind.Struct(s): Some(s.name.text.copy())
        case ItemKind.Enum(e) | ItemKind.ErrorSet(e): Some(e.name.text.copy())
        case ItemKind.Trait(t): Some(t.name.text.copy())
        case ItemKind.Const(c): Some(c.name.text.copy())
        case _: None

## The names an import binds: its last word or its alias, or the names
## a `from` import names.
pub pure def import_names(kind: ItemKind) -> list[String]:
    var out: list[String] = []
    match kind:
        case ItemKind.Import(imp):
            if let Some(a) = imp.alias:
                out.push(a.text.copy())
            elif let Some(last) = imp.path.last():
                out.push(last.text.copy())
        case ItemKind.FromImport(imp):
            for (n, alias) in imp.names:
                match alias:
                    case Some(a): out.push(a.text.copy())
                    case None: out.push(n.text.copy())
        case _:
            pass
    return out

## Whether `target.FACT == "VALUE"` (or `!=`) holds for the build's
## target; `None` for any other comparison.
pub pure def target_condition(
    ast: Ast, first: ExprId, rest: list[(CmpOp, ExprId)], facts: list[(String, String)]
) -> bool?:
    if len(rest) != 1:
        return None
    let (op, rhs) = rest[0]
    if op != CmpOp.Eq and op != CmpOp.Ne:
        return None
    let fact = target_fact(ast, first) else:
        return None
    let ExprKind.Str(parts) = ast.expr(rhs).kind.copy() else:
        return None
    let value = build.plain_text(parts)
    var same = False
    for (f, v) in facts:
        if f == fact and v == value:
            same = True
    return Some(if op == CmpOp.Eq: same else: not same)

## The ranges of the `if comptime` branches on the target that this build
## leaves out (RULES.md, R106): a branch whose condition is a fact of the
## target that does not hold, and those after one that holds, with its
## `else`. A branch on anything else ends the reading of its statement.
pub pure def discarded_branches(ast: Ast, facts: list[(String, String)]) -> list[TextRange]:
    var out: list[TextRange] = []
    for s in ast.stmts:
        let StmtKind.If(branches, else_block) = s.kind.copy() else:
            continue
        var held = False
        var known = True
        for (c, b) in branches:
            if held:
                out.push(b.range)
                continue
            let v = comptime_target(ast, c, facts) else:
                known = False
                break
            if v:
                held = True
            else:
                out.push(b.range)
        if held and known:
            if let Some(e) = else_block:
                out.push(e.range)
    return out

## Whether `if comptime target.FACT == "VALUE":` holds; `None` for a
## condition of another form.
pure def comptime_target(ast: Ast, c: Cond, facts: list[(String, String)]) -> bool?:
    if len(c.parts) != 1:
        return None
    let CondPart.Expr(e) = c.parts[0].copy() else:
        return None
    let ExprKind.Compare(first, rest) = ast.expr(e).kind.copy() else:
        return None
    let ExprKind.Comptime(inner) = ast.expr(first).kind.copy() else:
        return None
    return target_condition(ast, inner, rest, facts)

## The fact `target.FACT` names, `os`, `arch` or `runtime`.
pub pure def target_fact(ast: Ast, e: ExprId) -> String?:
    let ExprKind.Field(base, name) = ast.expr(e).kind.copy() else:
        return None
    let ExprKind.Name(b) = ast.expr(base).kind.copy() else:
        return None
    if b != "target":
        return None
    for (f, _) in target_facts():
        if f == name.text:
            return Some(f.copy())
    return None

## The condition of an item's `@cfg` as written, for the simple forms
## `feature="NAME"`, `test` and a fact of the target; else `...`.
pure def condition_text(ast: Ast, attrs: list[Attr]) -> String:
    for a in attrs:
        if a.name != "cfg":
            continue
        let x = a.args.first() else:
            continue
        if let Some(n) = x.name:
            if let ExprKind.Str(parts) = ast.expr(x.value).kind:
                return "{n.text}=\"{build.plain_text(parts)}\""
        if let ExprKind.Name(n) = ast.expr(x.value).kind:
            return n.copy()
        if let ExprKind.Compare(first, rest) = ast.expr(x.value).kind:
            if len(rest) == 1:
                let (op, rhs) = rest[0]
                if let Some(fact) = target_fact(ast, first):
                    if let ExprKind.Str(parts) = ast.expr(rhs).kind:
                        let sign = if op == CmpOp.Eq: "==" else: "!="
                        return "target.{fact} {sign} \"{build.plain_text(parts)}\""
    return "...".to_string()

pure def has_cfg(attrs: list[Attr]) -> bool:
    for a in attrs:
        if a.name == "cfg":
            return True
    return False

pure def methods_have_cfg(methods: list[FnDef]) -> bool:
    for m in methods:
        if has_cfg(m.attrs):
            return True
    return False

## Whether `items` have anything to leave out or look at: a `@cfg`, or a
## test when the program is built without its tests.
pure def affected(ast: Ast, items: list[ItemId], tests: bool) -> bool:
    for id in items:
        let item = ast.item(id)
        if has_cfg(item.attrs):
            return True
        match item.kind:
            case ItemKind.Test(_) | ItemKind.Bench(_):
                if not tests:
                    return True
            case ItemKind.Suite(s):
                if not tests or affected(ast, s.items, tests):
                    return True
            case ItemKind.Extern(xs):
                if affected(ast, xs, tests):
                    return True
            case ItemKind.Impl(imp):
                if methods_have_cfg(imp.methods):
                    return True
            case ItemKind.Trait(t):
                if methods_have_cfg(t.methods):
                    return True
            case ItemKind.Struct(s):
                if methods_have_cfg(s.methods):
                    return True
                for f in s.fields:
                    if has_cfg(f.attrs):
                        return True
            case ItemKind.Enum(e) | ItemKind.ErrorSet(e):
                if methods_have_cfg(e.methods):
                    return True
                for v in e.variants:
                    if has_cfg(v.attrs):
                        return True
            case _:
                pass
    return False

## The module as this build compiles it, with the problems its `@cfg`s
## have and the nodes it left out. `tests` is whether the program is built
## with its tests, `features` its package's features.
pub pure def filter(m: Module, tests: bool, features: Features?) -> Filtered:
    if not affected(m.ast, m.items, tests):
        return Filtered(module=None, problems=[], left_out=[])
    var f = Filter(
        tests=tests, features=features.copy(), problems=[], left_out=[], removed=[], import_=False
    )
    var ast = m.ast.copy()
    let items = f.items(mut ast, m.items)
    let module = Module(
        ast=ast,
        items=items,
        docs=m.docs.copy(),
        broken_names=m.broken_names.copy(),
        left_out=f.removed.copy(),
    )
    return Filtered(module=Some(module), problems=f.problems, left_out=f.left_out)

# ------------------------------------------------------------------ tests

## The names of the functions a build of `source` keeps, with the feature
## `tls` declared and, with `on`, turned on.
pure def kept_fns(source: str, on: bool) -> (list[String], int):
    let parsed = parse(source, Catalog.parse(""))
    let m = build.module(parsed.tree)
    var turned: list[String] = []
    if on:
        turned.push("tls".to_string())
    let features = Features(
        declared=["tls".to_string()], on=turned, runtime="interpreter".to_string()
    )
    let filtered = filter(m, True, Some(features))
    let kept = filtered.module ?? m
    var out: list[String] = []
    for it in kept.items:
        if let ItemKind.Fn(f) = kept.ast.item(it).kind:
            out.push(f.name.text.copy())
    return (out, len(filtered.problems))

test "`not(...)` turns its one condition around":
    let source = "@cfg(not(feature=\"tls\"))\ndef plain():\n    pass\n\n@cfg(feature=\"tls\")\ndef secure():\n    pass\n"
    assert kept_fns(source, False) == (["plain".to_string()], 0)
    assert kept_fns(source, True) == (["secure".to_string()], 0)
    # Two conditions are not a condition, and the item is kept.
    let two = "@cfg(not(feature=\"tls\", test))\ndef both():\n    pass\n"
    assert kept_fns(two, False) == (["both".to_string()], 1)

test "an import's `@cfg` reads the runtime the build is for":
    let source = "@cfg(target.runtime == \"native\")\nimport fast\n\ndef main():\n    pass\n"
    let m = build.module(parse(source, Catalog.parse("")).tree)
    let interpreted = filter(m, True, Some(Features.none())).module ?? m.copy()
    assert len(interpreted.items) == 1
    let native = filter(m, True, Some(Features.for_runtime("native"))).module ?? m.copy()
    assert len(native.items) == 2
