##! Pattern tests (which branch to take) and bindings (what the arm sees)
##! (stage 0's `sisu-lower/src/pats.rs`). Testing happens first and binds
##! nothing, so a failed test leaves the scrutinee as it was.

from stage1.lower.func import Cx, DropEntry, FnLower
from stage1.sir import (
    BinOp as SirBinOp,
    BlockId,
    Callee,
    Const,
    LocalId,
    Operand,
    Place,
    Proj,
    Rvalue,
    StatementKind,
    Terminator,
    Type,
)
from stage1.typeck.pat import pattern_bindings
from stage1.typeck.std_sources import own_kind
from stage1.typeck.thir import BindMode, Lit, PatId, TExprKind, TPatKind
from stage1.typeck.ty import Ty, TyData

impl FnLower:
    ## The variants `pat` tests for, and the place whose discriminant
    ## decides, when that is all the pattern tests: a variant whose fields
    ## cannot fail, or a choice of such variants of one place.
    pub pure def variant_set(self, cx: Cx, pat: PatId, place: Place) -> (Place, list[int])?:
        let p = ref cx.body.pats[pat.index]
        match p.kind:
            case TPatKind.Variant(_, variant, fields):
                # A union of error sets tests which set first (`test`).
                if let TyData.ErrSet(ms) = self.types.data(p.ty):
                    if len(ms) > 1:
                        return None
                for f in fields:
                    if not cannot_fail(cx, f):
                        return None
                return Some((place.copy(), [variant]))
            case TPatKind.Or(alts):
                var out: (Place, list[int])? = None
                for alt in alts:
                    let found = self.variant_set(cx, alt, place) else:
                        return None
                    let (q, vs) = found
                    match out:
                        case None:
                            out = Some((q, vs))
                        case Some((o, ws)):
                            if o != q:
                                return None
                            var all = ws.copy()
                            for v in vs:
                                all.push(v)
                            out = Some((o.copy(), all))
                return out
            case TPatKind.Deref(inner):
                return self.variant_set(cx, inner, place.project(Proj.Deref))
            case _:
                return None

    ## Continues in the current block when `pat` matches the value at
    ## `place`, and jumps to `fail` otherwise.
    pub pure def test(mut self, cx: Cx, pat: PatId, place: Place, fail: BlockId):
        let p = ref cx.body.pats[pat.index]
        let loc = cx.loc(p.span)
        match p.kind:
            case TPatKind.Wild | TPatKind.Bind(_, _) | TPatKind.Error:
                pass
            case TPatKind.Lit(l):
                var c = Const.Int(0)
                match l:
                    case Lit.Int(n):
                        c = Const.Int(n)
                    case Lit.WideInt(_):
                        c = Const.Int(0)
                    case Lit.Float(f):
                        c = Const.Float(f)
                    case Lit.Bool(b):
                        c = Const.Bool(b)
                    case Lit.Char(ch):
                        c = Const.Char(ch)
                    case Lit.Str(s):
                        c = Const.Str(s.copy())
                # A literal of a `u64`, `u128`, `i128` or `f32` is a value an
                # intrinsic makes, as in an expression.
                var made = self.is_f32(cx, p.ty)
                if let Some(k) = self.sized_int(cx, p.ty):
                    if own_kind(k):
                        made = True
                var rhs = Operand.Const(c.copy())
                if made:
                    var kind = TExprKind.Int(0)
                    match l:
                        case Lit.WideInt(b):
                            kind = TExprKind.WideInt(b)
                        case Lit.Float(f):
                            kind = TExprKind.Float(f)
                        case _:
                            if let Const.Int(n) = c:
                                kind = TExprKind.Int(n)
                    let lit = self.add_expr(cx, kind, p.ty, p.span)
                    let t = self.temp(cx, p.ty)
                    self.into(cx, Place.local(t), lit)
                    rhs = Operand.Copy(Place.local(t))
                var lhs = Operand.Copy(place.copy())
                if not cx.prog.is_copy_in(mut self.types, p.ty, self.bounds):
                    let pt = self.ty(cx, p.ty)
                    let t = self.temp_sir(Type.Ref(inner=[pt], mutable=False))
                    self.assign(
                        cx, Place.local(t), Rvalue.Ref(place=place.copy(), mutable=False), loc
                    )
                    lhs = Operand.Copy(Place.local(t))
                let r = self.temp_sir(Type.Bool)
                self.assign(
                    cx, Place.local(r), Rvalue.Binary(op=SirBinOp.Eq, lhs=lhs, rhs=rhs), loc
                )
                let ok = self.new_block()
                self.terminate(
                    Terminator.Switch(
                        value=Operand.Copy(Place.local(r)), cases=[(0, fail)], default=ok
                    ),
                    loc,
                )
                self.switch_to(cx, ok)
            case TPatKind.Variant(def_, variant, fields):
                # A value of a union of error sets is a variant of one of
                # them: test which before testing the variant index, then
                # test the rest through a reference of that set's type, so
                # that its fields are the set's own (decision 221).
                var at = place.copy()
                var union = False
                if let TyData.ErrSet(ms) = self.types.data(p.ty):
                    union = len(ms) > 1
                if union:
                    let decl = Type.Named(name=cx.ctx.type_name(cx.prog, def_), args=[])
                    let r = self.temp_sir(Type.Ref(inner=[decl.copy()], mutable=False))
                    self.assign(
                        cx, Place.local(r), Rvalue.Ref(place=place.copy(), mutable=False), loc
                    )
                    let is = self.temp_sir(Type.Bool)
                    self.emit(
                        cx,
                        StatementKind.Call(
                            dest=Place.local(is),
                            callee=Callee.Intrinsic(name="error.is", args=[decl]),
                            args=[Operand.Copy(Place.local(r))],
                        ),
                        loc,
                    )
                    let ok = self.new_block()
                    self.terminate(
                        Terminator.Switch(
                            value=Operand.Copy(Place.local(is)), cases=[(0, fail)], default=ok
                        ),
                        loc,
                    )
                    self.switch_to(cx, ok)
                    at = Place.local(r).project(Proj.Deref)
                let d = self.temp_sir(Type.Int)
                self.assign(cx, Place.local(d), Rvalue.Discriminant(at.copy()), loc)
                let ok = self.new_block()
                self.terminate(
                    Terminator.Switch(
                        value=Operand.Copy(Place.local(d)), cases=[(variant, ok)], default=fail
                    ),
                    loc,
                )
                self.switch_to(cx, ok)
                for i in range(len(fields)):
                    let sub = at.project(Proj.Downcast(variant)).project(Proj.Field(i))
                    self.test(cx, fields[i], sub, fail)
            case TPatKind.Struct(_, fields):
                for i in range(len(fields)):
                    self.test(cx, fields[i], place.project(Proj.Field(i)), fail)
            case TPatKind.Tuple(fields):
                for i in range(len(fields)):
                    self.test(cx, fields[i], place.project(Proj.Field(i)), fail)
            case TPatKind.Deref(inner):
                self.test(cx, inner, place.project(Proj.Deref), fail)
            case TPatKind.Or(alts):
                let cont = self.new_block()
                for i in range(len(alts)):
                    if i + 1 == len(alts):
                        self.test(cx, alts[i], place, fail)
                        self.goto(cont)
                    else:
                        let next = self.new_block()
                        self.test(cx, alts[i], place, next)
                        self.goto(cont)
                        self.switch_to(cx, next)
                self.switch_to(cx, cont)
            case TPatKind.List(prefix, has_rest, _, suffix):
                let n = self.temp_sir(Type.Int)
                let pt = self.ty(cx, p.ty)
                let r = self.temp_sir(Type.Ref(inner=[pt], mutable=False))
                self.assign(cx, Place.local(r), Rvalue.Ref(place=place.copy(), mutable=False), loc)
                self.emit(
                    cx,
                    StatementKind.Call(
                        dest=Place.local(n),
                        callee=Callee.Intrinsic(name="len", args=[]),
                        args=[Operand.Copy(Place.local(r))],
                    ),
                    loc,
                )
                let need = len(prefix) + len(suffix)
                let op = if has_rest: SirBinOp.Ge else: SirBinOp.Eq
                let c = self.temp_sir(Type.Bool)
                let cmp = Rvalue.Binary(
                    op=op, lhs=Operand.Copy(Place.local(n)), rhs=Operand.Const(Const.Int(need))
                )
                self.assign(cx, Place.local(c), cmp, loc)
                let ok = self.new_block()
                self.terminate(
                    Terminator.Switch(
                        value=Operand.Copy(Place.local(c)), cases=[(0, fail)], default=ok
                    ),
                    loc,
                )
                self.switch_to(cx, ok)
                for i in range(len(prefix)):
                    let sub = self.element(cx, place, i, False)
                    self.test(cx, prefix[i], sub, fail)
                for j in range(len(suffix)):
                    let sub = self.element(cx, place, len(suffix) - j, True)
                    self.test(cx, suffix[j], sub, fail)

    pure def element(mut self, cx: Cx, place: Place, i: int, from_end: bool) -> Place:
        let idx = self.temp_sir(Type.Int)
        self.assign(cx, Place.local(idx), Rvalue.Use(Operand.Const(Const.Int(i))), None)
        if from_end:
            return place.project(Proj.IndexFromEnd(idx))
        return place.project(Proj.Index(idx))

    ## Binds the names of a pattern that matched; value bindings are dropped
    ## with the innermost scope.
    pub pure def bind(mut self, cx: Cx, pat: PatId, place: Place):
        self.bind_below(cx, pat, place, 0)

    ## Binds, registering drops in the scope `below` levels under the
    ## innermost (a `let` registers in its block, not its statement).
    pub pure def bind_below(mut self, cx: Cx, pat: PatId, place: Place, below: int):
        self.bind_with(cx, pat, place, Some(below), below)

    ## Assigns a pattern's bindings without registering them, for a
    ## binding made on several paths and registered once where they join
    ## (`register_bindings`): the alternatives of `|`, and the two paths of
    ## `let PATTERN = e else: fallback`. An error value the pattern moves
    ## fields out of is registered at once, in the scope `below` levels
    ## under the innermost, where the bindings will be.
    pub pure def bind_values(mut self, cx: Cx, pat: PatId, place: Place, below: int):
        self.bind_with(cx, pat, place, None, below)

    ## Whether binding the pattern moves a value out of the place it
    ## matched: a value binding of a type that is not `Copy`.
    pure def moves_out(mut self, cx: Cx, pat: PatId) -> bool:
        let p = ref cx.body.pats[pat.index]
        match p.kind:
            case TPatKind.Bind(_, mode):
                if mode != BindMode.Value:
                    return False
                let copy = cx.prog.is_copy_in(mut self.types, p.ty, self.bounds)
                if let TyData.Ref(_, _) = self.types.data(p.ty):
                    return False
                return not copy
            case TPatKind.Variant(_, _, fields):
                return self.any_moves_out(cx, fields)
            case TPatKind.Struct(_, fields):
                return self.any_moves_out(cx, fields)
            case TPatKind.Tuple(fields):
                return self.any_moves_out(cx, fields)
            case TPatKind.Or(alts):
                return self.any_moves_out(cx, alts)
            case _:
                return False

    pure def any_moves_out(mut self, cx: Cx, pats: list[PatId]) -> bool:
        for f in pats:
            if self.moves_out(cx, f):
                return True
        return False

    ## Registers the bindings of a pattern that `bind_values` assigned, in
    ## the scope `below` levels under the innermost.
    pub pure def register_bindings(mut self, cx: Cx, pat: PatId, below: int):
        let p = ref cx.body.pats[pat.index]
        match p.kind:
            case TPatKind.Bind(local, mode):
                let l = self.local_for(cx, local)
                match mode:
                    case BindMode.Value:
                        self.bind_registered(cx, local, l, p.ty, below)
                    case BindMode.Ref | BindMode.RefMut:
                        self.scope_local(below, l)
            case TPatKind.Variant(_, _, fields):
                for f in fields:
                    self.register_bindings(cx, f, below)
            case TPatKind.Struct(_, fields):
                for f in fields:
                    self.register_bindings(cx, f, below)
            case TPatKind.Tuple(fields):
                for f in fields:
                    self.register_bindings(cx, f, below)
            case TPatKind.Deref(inner):
                self.register_bindings(cx, inner, below)
            case TPatKind.Or(alts):
                if let Some(first) = alts.first():
                    self.register_bindings(cx, first, below)
            case TPatKind.List(prefix, _, rest, suffix):
                for f in prefix:
                    self.register_bindings(cx, f, below)
                if let Some(r) = rest:
                    let l = self.local_for(cx, r)
                    let ty = cx.body.locals[r].ty
                    self.bind_registered(cx, r, l, ty, below)
                for f in suffix:
                    self.register_bindings(cx, f, below)
            case TPatKind.Wild | TPatKind.Lit(_) | TPatKind.Error:
                pass

    ## Binds a value binding, registering it in the scope `below` levels
    ## down, or, when `reg` is `None`, ending the block after a value that
    ## needs drop (the lowering invariant) and leaving its registration to
    ## the caller.
    pure def bind_value(mut self, cx: Cx, local: int, l: LocalId, ty: Ty, reg: int?):
        match reg:
            case Some(below):
                self.bind_registered(cx, local, l, ty, below)
            case None:
                if self.needs_drop(cx, ty):
                    self.split(cx)

    ## `below`: the scope temporaries of the binding are registered in
    ## (an error value whose fields it moves out).
    pure def bind_with(mut self, cx: Cx, pat: PatId, place: Place, reg: int?, below: int):
        let p = ref cx.body.pats[pat.index]
        let loc = cx.loc(p.span)
        match p.kind:
            case TPatKind.Bind(local, mode):
                let l = self.local_for(cx, local)
                match mode:
                    case BindMode.Value:
                        let v = self.copy_or_move(cx, place.copy(), p.ty)
                        self.assign(cx, Place.local(l), Rvalue.Use(v), loc)
                        self.bind_value(cx, local, l, p.ty, reg)
                    case BindMode.Ref:
                        self.assign(
                            cx, Place.local(l), Rvalue.Ref(place=place.copy(), mutable=False), loc
                        )
                        if let Some(below) = reg:
                            self.scope_local(below, l)
                    case BindMode.RefMut:
                        self.assign(
                            cx, Place.local(l), Rvalue.Ref(place=place.copy(), mutable=True), loc
                        )
                        if let Some(below) = reg:
                            self.scope_local(below, l)
            case TPatKind.Variant(def_, variant, fields):
                # An error value is never partly moved: a pattern that moves
                # fields out of one takes the value out whole first, as its
                # set's own type, and moves them out of that, which is then
                # dropped with the bindings. A union's value is read through
                # a reference of its set's type, as it was tested (decision
                # 221).
                let decl = Type.Named(name=cx.ctx.type_name(cx.prog, def_), args=[])
                var moves = False
                if cx.prog.is_error_set(def_):
                    moves = self.any_moves_out(cx, fields)
                var union = False
                if let TyData.ErrSet(ms) = self.types.data(p.ty):
                    union = len(ms) > 1
                var base = place.copy()
                if moves:
                    let m = self.add_local(decl, None)
                    self.scope_local(below, m)
                    self.assign(cx, Place.local(m), Rvalue.Use(Operand.Move(place.copy())), loc)
                    self.register_below(below, DropEntry.Local(m))
                    self.split(cx)
                    base = Place.local(m)
                elif union and not pattern_bindings(cx.body.pats, pat).is_empty():
                    let r = self.add_local(Type.Ref(inner=[decl], mutable=False), None)
                    self.scope_local(below, r)
                    self.assign(
                        cx, Place.local(r), Rvalue.Ref(place=place.copy(), mutable=False), loc
                    )
                    base = Place.local(r).project(Proj.Deref)
                for i in range(len(fields)):
                    let sub = base.project(Proj.Downcast(variant)).project(Proj.Field(i))
                    self.bind_with(cx, fields[i], sub, reg, below)
            case TPatKind.Struct(_, fields):
                for i in range(len(fields)):
                    self.bind_with(cx, fields[i], place.project(Proj.Field(i)), reg, below)
            case TPatKind.Tuple(fields):
                for i in range(len(fields)):
                    self.bind_with(cx, fields[i], place.project(Proj.Field(i)), reg, below)
            case TPatKind.Deref(inner):
                self.bind_with(cx, inner, place.project(Proj.Deref), reg, below)
            case TPatKind.Or(alts):
                # The alternatives bind the same locals: test again which one
                # matched (testing binds nothing and changes nothing) and bind
                # from it; the bindings are registered once, after the join.
                if pattern_bindings(cx.body.pats, pat).is_empty():
                    return
                let done = self.new_block()
                for i in range(len(alts)):
                    if i + 1 < len(alts):
                        let next = self.new_block()
                        self.test(cx, alts[i], place, next)
                        self.bind_values(cx, alts[i], place, below)
                        self.goto(done)
                        self.switch_to(cx, next)
                    else:
                        self.bind_values(cx, alts[i], place, below)
                        self.goto(done)
                self.switch_to(cx, done)
                if let Some(below) = reg:
                    if let Some(first) = alts.first():
                        self.register_bindings(cx, first, below)
            case TPatKind.List(prefix, _, rest, suffix):
                for i in range(len(prefix)):
                    let sub = self.element(cx, place, i, False)
                    self.bind_with(cx, prefix[i], sub, reg, below)
                if let Some(r) = rest:
                    let l = self.local_for(cx, r)
                    let pt = self.ty(cx, p.ty)
                    let refp = self.temp_sir(Type.Ref(inner=[pt], mutable=False))
                    self.assign(
                        cx, Place.local(refp), Rvalue.Ref(place=place.copy(), mutable=False), loc
                    )
                    self.emit(
                        cx,
                        StatementKind.Call(
                            dest=Place.local(l),
                            callee=Callee.Intrinsic(name="list.slice_middle", args=[]),
                            args=[
                                Operand.Copy(Place.local(refp)),
                                Operand.Const(Const.Int(len(prefix))),
                                Operand.Const(Const.Int(len(suffix))),
                            ],
                        ),
                        loc,
                    )
                    let ty = cx.body.locals[r].ty
                    self.bind_value(cx, r, l, ty, reg)
                for j in range(len(suffix)):
                    let sub = self.element(cx, place, len(suffix) - j, True)
                    self.bind_with(cx, suffix[j], sub, reg, below)
            case _:
                pass

## Whether a pattern matches every value of its type, so that testing it
## emits nothing.
pure def cannot_fail(cx: Cx, pat: PatId) -> bool:
    match cx.body.pats[pat.index].kind:
        case TPatKind.Wild | TPatKind.Bind(_, _) | TPatKind.Error:
            return True
        case TPatKind.Struct(_, fields):
            for f in fields:
                if not cannot_fail(cx, f):
                    return False
            return True
        case TPatKind.Tuple(fields):
            for f in fields:
                if not cannot_fail(cx, f):
                    return False
            return True
        case TPatKind.Deref(inner):
            return cannot_fail(cx, inner)
        case _:
            return False
