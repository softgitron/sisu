##! The stage-1 command line, run on the stage-0 interpreter from this
##! package's directory:
##!
##! ```text
##! sisu run -- tokens [--trivia] FILE          # what `sisu tokens` prints
##! sisu run -- parse --tree [--trivia] FILE    # what `sisu parse --tree` prints
##! sisu run -- parse --print FILE              # the source, reprinted from the tree
##! sisu run -- parse --ast FILE                # what `sisu parse --ast` prints: the AST
##! sisu run -- batch OUT LIST                  # every file LIST names
##! sisu run -- mutate SEED COUNT OUT LIST       # COUNT mutants of the files LIST names
##! sisu run -- names FILE                      # the name diagnostics, as `sisu check --format=ids`
##! sisu run -- names-batch OUT LIST            # those of every file LIST names
##! sisu run -- ast-batch OUT LIST              # the AST of every file LIST names
##! sisu run -- types FILE                    # the type diagnostics, as `sisu check --format=ids`
##! sisu run -- types-batch OUT LIST          # those of every file LIST names
##! sisu run -- sir FILE                      # what `sisu sir FILE` prints: the program's SIR
##! sisu run -- ownership FILE                # the ownership checker's diagnostics, as `sisu check --format=ids`
##! sisu run -- sir-batch OUT LIST            # both, for every file LIST names
##! sisu run -- fmt [--check] [PATH...]       # what `sisu fmt` does, its status as `Exit(status=N)`
##! sisu run -- fmt-batch OUT LIST            # what it does of every file LIST names
##! sisu run -- fmt-profile LIST              # where the formatter's time goes over them
##! sisu run -- deform OUT LIST               # the files laid out otherwise, for the formatters
##! sisu run -- doc [PATH] [--output DIR]     # what `sisu doc` does, its status as `Exit(status=N)`
##! sisu run -- doc --std [MODULE...]         # the standard library's pages
##! sisu run -- doc-batch OUT LIST            # what `doc` does of every program LIST names
##! ```
##!
##! `tokens` and `parse` print to standard output, and the diagnostics in
##! the conformance form to standard error, as stage 0 does. `batch` reads
##! a list of files, one per line, and writes for the `n`th (from 1) the
##! files `OUT/n.tokens` and `OUT/n.tokens.err` (what `tokens --trivia`
##! prints), `OUT/n.tree` and `OUT/n.tree.err` (what `parse --tree`
##! prints), `OUT/n.trivia.tree`, `OUT/n.print` (the reprint) and `OUT/n.ast`
##! (what `parse --ast` prints), so that one run of the interpreter checks
##! many files. `mutate` writes `OUT/m1.sisu` to `OUT/mCOUNT.sisu`, each a
##! mutant of one of the files in turn (`mutants.sisu`). `names` resolves
##! the names of one module (`resolve.sisu`) against the prelude and the
##! std modules it imports, read from `../std/`; `names-batch` writes
##! `OUT/n.names`. `parse --ast` prints the AST of a file
##! (`syntax.ast.build`) as `syntax.ast.dump` writes it, in the notation of
##! Rust's `{:#?}`; `ast-batch` writes `OUT/n.ast`. `types` checks a file's
##! bodies against the prelude (`typeck.sisu`) and prints the type
##! checker's diagnostics, then on standard error why parts of the file are
##! beyond the slice it checks; `types-batch` resolves the prelude once and
##! writes `OUT/n.types` and `OUT/n.beyond`. `sir` lowers a file the type
##! checker checks whole (`lower.sisu`), places its drops (`borrowck.sisu`),
##! threads its jumps (`sir.simplify`) and prints its SIR as `sisu sir`
##! does, or nothing when the front end finds an error, then on standard
##! error why the file is beyond the slice of lowering. `ownership` prints
##! the diagnostics of the ownership checker's rules stage 1 has
##! (`borrowck.sisu`) for the same file, as `sisu check --format=ids` prints
##! them. `sir-batch` writes `OUT/n.sir`, `OUT/n.ownership` and
##! `OUT/n.beyond`, and prints the time the front end, lowering and the
##! ownership checker took.
##! `fmt` formats each file or each `.sisu` file under each directory in
##! place, or with `--check` prints what would change, as `sisu fmt` does
##! (`fmt`, `format.sisu`); `fmt-batch` writes, for the `n`th file,
##! `OUT/n.check.out`, `OUT/n.check.err` and `OUT/n.check.status` (what `fmt
##! --check` prints of it, and its status), `OUT/n.fmt` (the text `fmt`
##! leaves) and `OUT/n.again` (empty when formatting that text again changes
##! nothing). `deform` writes `OUT/jN.sisu` and `OUT/sN.sisu`, the `N`th file
##! with the lines inside its brackets joined, and with a line break after
##! each comma inside them (`mutants.joined`, `mutants.spread`). `doc`
##! writes a program's documentation, a Markdown page per module, as `sisu
##! doc` does (`doc.sisu`); `doc-batch` writes, for the `n`th line (a
##! program's path, or `--std` and the paths of std modules),
##! `OUT/n.doc.out`, `OUT/n.doc.err` and `OUT/n.doc.status` (what `doc`
##! prints and its status), and the pages `doc --output` writes into
##! `OUT/n.pages/`, with `OUT/n.pages.err` and `OUT/n.pages.status`.
##! `--catalog PATH` names the message catalog, by default
##! `../catalog/messages.catalog`.

import stage1.borrowck
import stage1.borrowck.holes
import stage1.cfg
import stage1.config
import stage1.diary
import stage1.diff
import stage1.doc
import stage1.fmt
import stage1.format
import stage1.interp
import stage1.lower
import stage1.mutation
import stage1.package
import stage1.query
import stage1.session
import stage1.sir
import stage1.sir.simplify
import stage1.sir.write
import stage1.typeck
from stage1.audit import (
    AuditModule, AuditPackage, caps_report, module_hash, ownership_line, unsafe_report
)
from stage1.borrowck.finding import Arg, span_of
from stage1.cfg import Features
from stage1.diag import (
    Catalog,
    Diagnostic,
    Edit,
    Filed,
    Lines,
    Msg,
    Param,
    TextRange,
    fix_text,
    quote,
    render_human,
    render_human_files,
    render_ids,
    render_ids_files,
    render_ids_in,
    sort_filed,
    sort_unique,
)
from stage1.fmt import Refusal
from stage1.lexer import Lexed, lex
from stage1.lower.func import DEFAULT_COMPTIME_BUDGET
from stage1.lower.names import CONTRACTS_ALL, CONTRACTS_OFF, CONTRACTS_PRECONDITIONS
from stage1.manifest import read as manifest_read
from stage1.mutants import Rng, joined, mutate, spread
from stage1.package import FeatureRequest, Layout, Problem, Target
from stage1.parser import parse, parse_lexed
from stage1.resolve import Environment, ModuleNames, NamedModule, imported_std_modules
from stage1.syntax.ast import ExprKind, StrPart, build
from stage1.syntax.ast import Mode
from stage1.syntax.ast import visit
from stage1.syntax.ast.dump import module_debug
from stage1.syntax.kinds import KindNames
from stage1.syntax.kinds import SyntaxKind
from stage1.syntax.tree import Tree
from stage1.typeck.collect import SourcePackage, StdMarks
from stage1.typeck.program import DefKind, Embedded, ModuleId, Program, ROOT_PACKAGE
from stage1.typeck.std_sources import display_path, documented, importable, std_file, target_for
from stage1.typeck.ty import DefId, TyKey

error UsageError:
    Usage(text: String)

## Why a command failed after saying why on standard error: a Sisu program
## exits with status 1 only by returning an error from `main`, which the
## run time then prints, `error: Failed`, after what the command printed.
## `fmt` fails with the status stage 0 exits with (2 for a usage error, 70
## for a file the formatter refused as changed): the run time prints
## `error: Exit(status=N)` as the last line, which `sisu1` turns into the
## exit status.
error CommandError:
    Failed
    Exit(status: int)

## Stage 1's version, its package's (`sisu.toml`), which `sisu1 --version`
## prints as `sisu1 VERSION`: its minor number is the round of RULES.md
## that last changed what the driver may rely on (R56), so that the driver
## asks it rather than probing a command (decision 424).
const VERSION: str = "0.19.0"

def main(sys: System) -> ! {IoError, UsageError, CommandError}:
    var args = sys.env.args()
    # The compiler's directory, which holds the message catalog, the
    # standard library's sources and stage 0; by default this one's parent.
    var home = "..".to_string()
    var catalog_path: String? = None
    var rest: list[String] = []
    var i = 0
    while i < len(args):
        if args[i] == "--catalog" and i + 1 < len(args):
            catalog_path = Some(args[i + 1].to_string())
            i += 2
            continue
        if args[i] == "--home" and i + 1 < len(args):
            home = args[i + 1].to_string()
            i += 2
            continue
        # The runtime the program is built for, which `std_texts` reads
        # (RULES.md, R116).
        if args[i] == "--target-runtime" and i + 1 < len(args):
            if args[i + 1] != "native" and args[i + 1] != "interpreter":
                return Err(Usage(text=usage()))
            i += 2
            continue
        rest.push(args[i].to_string())
        i += 1
    # Stage 1's version, one line, before anything is read (RULES.md, R56).
    if len(rest) == 1 and (rest[0] == "version" or rest[0] == "--version"):
        print("sisu1 {VERSION}")
        return Ok(())
    let catalog_file = catalog_path ?? "{home}/catalog/messages.catalog"
    let catalog = Catalog.parse(sys.fs.read_to_string(Path.new(catalog_file))?)
    # What a command prints goes to standard output and standard error as it
    # prints it; `sir --repl-serve` holds what each request prints, for its
    # answer (RULES.md, R158).
    var o = Out.direct()
    return run_command(sys, home, catalog_file, rest, catalog, mut o, Served.alone())

## The command `rest` (its name and its arguments, without `--home`,
## `--catalog` and `--target-runtime`), run with the message catalog
## `catalog`, read from `catalog_file`: what it prints goes to `o`, and
## the standard library's base it checks a program against is `served`'s
## when that holds one (`sir --repl-serve`, RULES.md, R158), else the one
## `base_of` makes.
def run_command(
    sys: System,
    home: str,
    catalog_file: str,
    rest: list[String],
    catalog: Catalog,
    mut o: Out,
    served: Served,
) -> ! {IoError, UsageError, CommandError}:
    if rest.is_empty():
        return Err(Usage(text=usage()))
    let command = rest[0].copy()
    if command == "tokens" and len(rest) >= 2:
        let trivia = rest.contains("--trivia")
        let path = rest[len(rest) - 1].copy()
        let text = sys.fs.read_to_string(Path.new(path))?
        let (out, errs) = tokens(text, trivia, catalog)
        o.emit(out, errs)
        return Ok(())
    if command == "parse" and len(rest) >= 2:
        let path = rest[len(rest) - 1].copy()
        let text = sys.fs.read_to_string(Path.new(path))?
        # `--bindings`: what `:why NAME` reads of a REPL input, its
        # statements with what each binds, reads and changes (RULES.md,
        # R95).
        if rest.contains("--bindings"):
            o.emit(session.bindings(text, catalog), "")
            return Ok(())
        let parsed = parse(text, catalog)
        let errs = render_ids(text, parsed.diagnostics, catalog)
        # `--shape`: what formatting keeps, which `fmt`'s self-check compares
        # (`fmt.shape`), or the file's syntax errors and status 1, as `sisu
        # parse --shape` prints them; an error `fmt` refuses (`E0132` among
        # them) refuses both (RULES.md, R94).
        if rest.contains("--shape"):
            match fmt.shape.shape(text, catalog):
                case Some(s):
                    o.emit(s, "")
                    return Ok(())
                case None:
                    o.emit("", errs)
                    return Err(Exit(status=1))
        if rest.contains("--ast"):
            o.emit(module_debug(build.module(parsed.tree)), errs)
        elif rest.contains("--print"):
            o.emit(parsed.tree.to_source(), errs)
        else:
            o.emit(parsed.tree.dump(rest.contains("--trivia")), errs)
        return Ok(())
    if command == "batch" and len(rest) == 3:
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        var bytes = 0
        var times = Times(lex=0, parse=0, dump=0, ast=0)
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            let text = sys.fs.read_to_string(Path.new(path))?
            bytes += text.byte_len()
            let t0 = now(sys)
            let lexed = lex(text)
            let t1 = now(sys)
            let (out, errs) = dump_tokens(text, lexed, True, catalog)
            let t2 = now(sys)
            let parsed = parse_lexed(text, lexed, catalog)
            let t3 = now(sys)
            let tree = parsed.tree.dump(False)
            let tree_errs = render_ids(text, parsed.diagnostics, catalog)
            let trivia_tree = parsed.tree.dump(True)
            let reprint = parsed.tree.to_source()
            let t4 = now(sys)
            let ast = module_debug(build.module(parsed.tree))
            let t5 = now(sys)
            times.lex += t1 - t0
            times.parse += t3 - t2
            times.dump += t2 - t1 + t4 - t3
            times.ast += t5 - t4
            sys.fs.write_text(Path.new("{out_dir}/{n}.tokens"), out)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.tokens.err"), errs)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.tree"), tree)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.tree.err"), tree_errs)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.trivia.tree"), trivia_tree)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.print"), reprint)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.ast"), ast)?
        let phases = "lex {ms(times.lex)} ms parse {ms(times.parse)} ms dump {ms(times.dump)} ms"
        o.put("files {n} bytes {bytes} {phases} ast {ms(times.ast)} ms")
        return Ok(())
    if command == "profile" and len(rest) == 2:
        let text = sys.fs.read_to_string(Path.new(rest[1].copy()))?
        let t0 = now(sys)
        let lexed = lex(text)
        let t1 = now(sys)
        let (out, _) = dump_tokens(text, lexed, True, catalog)
        let t2 = now(sys)
        let parsed = parse_lexed(text, lexed, catalog)
        let t3 = now(sys)
        let tree = parsed.tree.dump(False)
        let t4 = now(sys)
        let trivia_tree = parsed.tree.dump(True)
        let t5 = now(sys)
        let reprint = parsed.tree.to_source()
        let t6 = now(sys)
        o.put(
            "lex {ms(t1 - t0)} tokens-dump {ms(t2 - t1)} parse {ms(t3 - t2)} tree-dump {ms(t4 - t3)} trivia-dump {ms(t5 - t4)} reprint {ms(t6 - t5)}"
        )
        o.put("{out.byte_len()} {tree.byte_len()} {trivia_tree.byte_len()} {reprint.byte_len()}")
        return Ok(())
    if command == "names" and len(rest) == 2:
        var env = environment(sys, home)?
        let out = names_of(sys, home, rest[1], mut env, catalog)?
        o.emit(out, "")
        return Ok(())
    if command == "names-batch" and len(rest) == 3:
        var env = environment(sys, home)?
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            let out = names_of(sys, home, path, mut env, catalog)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.names"), out)?
        return Ok(())
    if command == "ast-batch" and len(rest) == 3:
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            let text = sys.fs.read_to_string(Path.new(path))?
            let parsed = parse(text, catalog)
            let lines = module_debug(build.module(parsed.tree))
            sys.fs.write_text(Path.new("{out_dir}/{n}.ast"), lines)?
        return Ok(())
    if command == "types" and len(rest) == 2:
        let base = base_of(sys, home, std_texts(sys, home)?, catalog)
        var kept = Kept.new()
        var env = base.environment()
        var out = String.new()
        var why = String.new()
        let request = build_request(sys)
        for input in inputs_of(sys, home, rest[1], False, True, request, mut env, catalog)?:
            let checked = types_of(base, input, catalog, mut kept)
            out.push(typeck.render(input.modules[0].text, checked, catalog))
            for b in checked.beyond:
                why.push("beyond the slice: {b}\n")
        o.emit(out, why)
        return Ok(())
    if command == "types-batch" and len(rest) == 3:
        let base = typeck.base(std_texts(sys, home)?, catalog)
        var kept = Kept.new()
        var env = base.environment()
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            var out = String.new()
            var why = String.new()
            let request = build_request(sys)
            for input in inputs_of(sys, home, path, False, True, request, mut env, catalog)?:
                let checked = types_of(base, input, catalog, mut kept)
                out.push(typeck.render(input.modules[0].text, checked, catalog))
                for b in checked.beyond:
                    why.push("{b}\n")
            sys.fs.write_text(Path.new("{out_dir}/{n}.types"), out)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.beyond"), why)?
        return Ok(())
    # `sir --repl SESSION INPUT --kept OUT [--load]` and `sir --worksheet
    # FILE`: the programs `sisu repl` and `sisu ws` run (RULES.md, R79).
    # `sir --repl-serve`: the three served by one process that keeps the
    # standard library's base (RULES.md, R112).
    if command == "sir" and rest.contains("--repl-serve"):
        repl_serve(sys, home, catalog_file, catalog)?
        return Ok(())
    if command == "sir" and rest.contains("--repl"):
        return repl_command(sys, home, rest, catalog)
    if command == "sir" and rest.contains("--worksheet"):
        return worksheet_command(sys, home, rest, catalog)
    if command == "sir":
        # `--contracts=LEVEL`: the contracts lowering checks (07), all of
        # them by default, as `sisu sir --contracts=LEVEL` lowers.
        # `--features NAMES`, `--no-default-features` and `--locked` choose
        # the root package's features and keep the lockfile, as `check`
        # takes them (decision 250; RULES.md, R47).
        let (request, given) = feature_request(rest, target_runtime(sys))
        var level = CONTRACTS_ALL
        var words: list[String] = []
        var mutant: String? = None
        for w in given:
            if w.starts_with("--contracts="):
                let chosen = w.byte_slice(12, w.byte_len())
                let l = contract_level(chosen) else:
                    let params = [Param(name="value".to_string(), value=chosen.to_string())]
                    o.emit("", catalog.plain_error("cli.bad-contract-level", params))
                    return Err(Failed)
                level = l
            elif w.starts_with("--mutant="):
                # One mutant, by its number (RULES.md, R208), set aside
                # until the path is found.
                mutant = Some(w.copy())
            else:
                words.push(w.copy())
        let flags = [
            "--partial",
            "--accept-unsafe",
            "--tests",
            "--modules",
            "--mutants",
            "--std",
            "--defer-borrow",
            "--locked",
            "--no-default-features",
            "--format=ids",
            "--format=human",
        ]
        # The program's path, or the package of the working directory or
        # the nearest one above it, as `sisu sir` reads it when it names
        # none; its lockfile written as stage 0 writes it (09).
        var path = path_of(words, flags) else:
            return Err(Usage(text=usage()))
        if not names_path(words, flags):
            let found = nearest_package(sys, "sir", catalog, mut o) else:
                return Err(Failed)
            path = found
        if let Some(e) = workspace_run_error(sys, path, catalog):
            o.emit("", e)
            return Err(Failed)
        if let Some(e) = unknown_feature(sys, path, request):
            o.emit("", catalog.plain_error("cli.unknown-feature", e))
            return Err(Failed)
        if let Some(m) = mutant:
            words.push(m.copy())
        let accept = words.contains("--accept-unsafe")
        if not write_lockfile(
            sys, path, True, words.contains("--locked"), accept, catalog, "cli.errors-found", mut o
        )?:
            return Err(Failed)
        # The served base, or one made for this command (RULES.md, R158).
        match served.base:
            case Some(b):
                return sir_with(sys, home, path, words, level, request, b, catalog, mut o)
            case None:
                let base = base_of(sys, home, std_texts(sys, home)?, catalog)
                return sir_with(sys, home, path, words, level, request, base, catalog, mut o)
    if command == "ownership" and len(rest) == 2:
        let base = base_of(sys, home, std_texts(sys, home)?, catalog)
        var kept = Kept.new()
        var env = base.environment()
        var times = SirTimes(check=0, lower=0, ownership=0)
        let done = lowering_of(
            sys,
            home,
            rest[1],
            base,
            mut env,
            catalog,
            mut times,
            False,
            None,
            True,
            False,
            build_request(sys),
            mut kept,
        )?
        var errs = String.new()
        for b in done.beyond:
            errs.push("beyond the slice: {b}\n")
        o.emit(done.ownership, errs)
        return Ok(())
    if command == "sir-batch" and (len(rest) == 3 or len(rest) == 4):
        # With `--contracts=LEVEL`, the SIR alone, lowered with the
        # contracts that level checks, as `sisu sir --contracts=LEVEL`
        # prints it.
        var level: int? = None
        let tests = len(rest) == 4 and rest[3] == "--tests"
        if len(rest) == 4 and not tests:
            if rest[3].starts_with("--contracts="):
                level = contract_level(rest[3].byte_slice(12, rest[3].byte_len()))
            if level.is_none():
                return Err(Usage(text=usage()))
        let base = typeck.base(std_texts(sys, home)?, catalog)
        var kept = Kept.new()
        var env = base.environment()
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var times = SirTimes(check=0, lower=0, ownership=0)
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            let done = lowering_of(
                sys,
                home,
                path,
                base,
                mut env,
                catalog,
                mut times,
                False,
                Some(level ?? CONTRACTS_ALL),
                level.is_none() and not tests,
                tests,
                build_request(sys),
                mut kept,
            )?
            var reasons = String.new()
            for b in done.beyond:
                reasons.push("{b}\n")
            sys.fs.write_text(Path.new("{out_dir}/{n}.sir"), done.sir)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.ownership"), done.ownership)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.beyond"), reasons)?
        let counts = "std bodies lowered {kept.lowered.lowered}, reused {kept.lowered.reused}"
        o.put(
            "files {n} check {ms(times.check)} ms lower {ms(times.lower)} ms ownership {ms(times.ownership)} ms ({counts})"
        )
        return Ok(())
    if command == "check" and rest.contains("--holes"):
        # `check --holes FILE` (10, "Holes"; RULES.md, R174).
        return holes_command(sys, home, rest, catalog, mut o, served)
    if command == "check":
        # `--format=ids`: the conformance form on standard output; else
        # the human form on standard error, as `sisu check` prints them.
        # `--features NAMES` and `--no-default-features` choose the root
        # package's features (decision 250).
        let ids = rest.contains("--format=ids")
        # `--diary PATH` (18, Phase 3; RULES.md, R186): the diagnostics, and
        # what resolved the last check's, appended to the log.
        var diary: String? = None
        var given: list[String] = []
        var k = 0
        while k < len(rest):
            if rest[k] == "--diary" and k + 1 < len(rest):
                diary = Some(rest[k + 1].copy())
                k += 2
                continue
            if rest[k].starts_with("--diary="):
                diary = Some(rest[k].byte_slice(8, rest[k].byte_len()).to_string())
                k += 1
                continue
            given.push(rest[k].copy())
            k += 1
        let (request, words) = feature_request(given, target_runtime(sys))
        let flags = [
            "--format=ids", "--format=human", "--locked", "--no-default-features", "--accept-unsafe"
        ]
        var path = path_of(words, flags) else:
            return Err(Usage(text=usage()))
        if not names_path(words, flags):
            let found = nearest_package(sys, "check", catalog, mut o) else:
                return Err(Failed)
            path = found
        if let Some(e) = unknown_feature(sys, path, request):
            o.emit("", catalog.plain_error("cli.unknown-feature", e))
            return Err(Failed)
        # `--locked` keeps the lockfile as it is, or stops the command;
        # `--accept-unsafe` lets a package's `unsafe` level rise (22).
        let accept = words.contains("--accept-unsafe")
        if not write_lockfile(
            sys, path, False, words.contains("--locked"), accept, catalog, "", mut o
        )?:
            return Err(Failed)
        # The served base, or one made for this command (RULES.md, R158).
        match served.base:
            case Some(b):
                return check_with(sys, home, path, ids, request, b, catalog, mut o, diary)
            case None:
                let base = base_of(sys, home, std_texts(sys, home)?, catalog)
                return check_with(sys, home, path, ids, request, base, catalog, mut o, diary)
    if command == "lint":
        # `sisu lint` (10: "lints beyond the compiler's warnings, with
        # fix-its"; RULES.md, R11): the lints of a program the front end
        # checks, in either form; a program with errors has them reported
        # as `check` reports them, and fails.
        let ids = rest.contains("--format=ids")
        let (request, words) = feature_request(rest, target_runtime(sys))
        let flags = [
            "--format=ids", "--format=human", "--locked", "--no-default-features", "--accept-unsafe"
        ]
        # An option `lint` does not take, `--help` among them, is `D0009`,
        # as the driver's commands answer it (RULES.md, R69).
        if let Some(unknown) = unknown_option(words, flags):
            let params = [
                Param(name="option".to_string(), value=unknown),
                Param(name="command".to_string(), value="lint".to_string()),
            ]
            o.emit("", catalog.plain_error("cli.unknown-option", params))
            return Err(Exit(status=2))
        var path = path_of(words, flags) else:
            return Err(Usage(text=usage()))
        if not names_path(words, flags):
            let found = nearest_package(sys, "lint", catalog, mut o) else:
                return Err(Failed)
            path = found
        if let Some(e) = unknown_feature(sys, path, request):
            o.emit("", catalog.plain_error("cli.unknown-feature", e))
            return Err(Failed)
        # The served base, or one made for this command (RULES.md, R158).
        match served.base:
            case Some(b):
                return lint_with(sys, home, path, ids, request, b, catalog, mut o)
            case None:
                let base = base_of(sys, home, std_texts(sys, home)?, catalog)
                return lint_with(sys, home, path, ids, request, base, catalog, mut o)
    if command == "check-batch" and len(rest) == 3:
        let base = typeck.base(std_texts(sys, home)?, catalog)
        var kept = Kept.new()
        var env = base.environment()
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            # A program of one file is named by its file's name, as stage
            # 0 names it when run in the file's directory.
            let name = package.file_name(path)
            let reports = reports_of(
                sys, home, path, name, True, build_request(sys), base, mut env, catalog, mut kept
            )?
            var ids = String.new()
            var human = String.new()
            var why = String.new()
            for r in reports:
                ids.push(r.ids(catalog))
                human.push(r.human(catalog))
                for b in r.beyond:
                    why.push("{b}\n")
            sys.fs.write_text(Path.new("{out_dir}/{n}.ids"), ids)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.human"), human)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.beyond"), why)?
        return Ok(())
    if command == "build":
        # `build [--native] [--release] [--contracts LEVEL] [PATH] [--output
        # OUT]`: the program checked and lowered by stage 1 as `sisu build`
        # builds it, and with `--native` its SIR built by stage 0's backend
        # (`sisu build --native --from-sir`, in its release profile with
        # `--release`, decision 232).
        var output: String? = None
        var contracts: String? = None
        let (request, given) = feature_request(rest, target_runtime(sys))
        var words: list[String] = []
        var k = 0
        while k < len(given):
            if given[k] == "--output" and k + 1 < len(given):
                output = Some(given[k + 1].copy())
                k += 2
                continue
            if given[k] == "--contracts" and k + 1 < len(given):
                contracts = Some(given[k + 1].copy())
                k += 2
                continue
            if given[k].starts_with("--contracts="):
                contracts = Some(given[k].byte_slice(12, given[k].byte_len()).to_string())
                k += 1
                continue
            words.push(given[k].copy())
            k += 1
        # `--emit-sir`: the SIR the build would hand its backend, on standard
        # output with the line that names the executable, rather than built
        # (RULES.md, R170 and R195); `--native` is implied.
        let emit_sir = words.contains("--emit-sir")
        let native = words.contains("--native") or emit_sir
        let release = words.contains("--release")
        # `--for-run`: the build of `sisu run`, which a program's errors stop
        # with the line that says it was not run (`D0006`, `D0021`), where a
        # build says it was not compiled (`D0132`; RULES.md, R57).
        let for_run = words.contains("--for-run")
        let flags = [
            "--native",
            "--release",
            "--locked",
            "--no-default-features",
            "--accept-unsafe",
            "--for-run",
            "--emit-sir",
            "--defer-borrow",
        ]
        var path = path_of(words, flags) else:
            return Err(Usage(text=usage()))
        if not names_path(words, flags):
            let found = nearest_package(sys, "build", catalog, mut o) else:
                return Err(Failed)
            path = found
        # As stage 0 takes the options: `--output` and `--contracts` go with
        # `--native`, a level is one of three, and `--release` goes with
        # `--native` (`D0111`).
        if not native:
            var option: String? = None
            if output.is_some():
                option = Some("--output".to_string())
            elif contracts.is_some():
                option = Some("--contracts".to_string())
            if let Some(given) = option:
                let params = [
                    Param(name="option".to_string(), value=given.copy()),
                    Param(name="command".to_string(), value="build".to_string()),
                ]
                o.emit("", catalog.plain_error("cli.unknown-option", params))
                return Err(Failed)
        var level: int? = None
        if let Some(c) = contracts:
            level = contract_level(c)
            if level.is_none():
                let params = [Param(name="value".to_string(), value=c.copy())]
                o.emit("", catalog.plain_error("cli.bad-contract-level", params))
                return Err(Failed)
        if release and not native:
            o.emit("", catalog.plain_error("native.release", []))
            return Err(Failed)
        if let Some(e) = unknown_feature(sys, path, request):
            o.emit("", catalog.plain_error("cli.unknown-feature", e))
            return Err(Failed)
        let locked = words.contains("--locked")
        let accept = words.contains("--accept-unsafe")
        let how = BuildHow(
            native=native,
            release=release,
            for_run=for_run,
            emit_sir=emit_sir,
            deferring=emit_sir and words.contains("--defer-borrow"),
        )
        return build_command(
            sys, home, path, how, (locked, accept), level, output, request, catalog, mut o, served
        )
    if command == "test":
        # `test [OPTIONS] [PATH]` (RULES.md, R27): the program checked and
        # lowered with its tests by stage 1, run by stage 0's runner, with
        # the status that says how the tests ended, as `Exit(status=N)`.
        let status = test_command(sys, home, rest, catalog)?
        if status != 0:
            return Err(Exit(status=status))
        return Ok(())
    if command == "audit" and not rest.contains("--unsafe"):
        # `audit --ownership FILE...` and `audit --caps [FILE...]` (18,
        # Phase 3; RULES.md, R188).
        return audit_counts(sys, home, rest, catalog, mut o)
    if command == "audit":
        # `audit --unsafe [--std] [PATH]` (22, "The audit and the lints").
        return audit_command(sys, home, rest, catalog, mut o)
    if command == "explain-borrow":
        # `explain-borrow FILE:LINE` (10, "Language server"; RULES.md, R187).
        return explain_command(sys, home, rest, catalog, mut o, served)
    if command == "doc":
        # `doc [PATH] [--output DIR]` and `doc --std [MODULE...]`: what
        # `sisu doc` does, its exit status given as `Exit(status=N)`.
        let status = doc_command(sys, home, rest, catalog, mut o, served)?
        if status != 0:
            return Err(Exit(status=status))
        return Ok(())
    if command == "eval":
        # `eval FILE [--to json|toml|yaml]`: a configuration module's
        # constants, rendered (08; RULES.md, R165).
        return eval_command(sys, home, rest, catalog, mut o, served)
    if command == "grammar":
        # `grammar`: the parser's grammar from its modules' `##!` comments,
        # in one order (RULES.md, R202).
        if len(rest) != 1:
            return Err(Usage(text=usage()))
        var texts: list[(String, String)] = []
        for m in GRAMMAR_MODULES:
            let file = "{home}/stage1/src/parser/{m}.sisu"
            texts.push(("parser/{m}.sisu", sys.fs.read_to_string(Path.new(file))?))
        o.emit(grammar_text(texts), "")
        return Ok(())
    if command == "fix":
        # `fix FILE [--dry-run] [--all]`: each diagnostic's preferred fix
        # applied to the file (10; RULES.md, R176).
        return fix_command(sys, home, rest, catalog, mut o, served)
    if command == "query":
        # `query KIND FILE [LINE COL] [--text PATH]`: the language server's
        # questions about a position of a file (RULES.md, R164).
        return query_command(sys, home, rest, catalog, mut o, served)
    if command == "doc-batch" and len(rest) == 3:
        # For the `n`th line of LIST, the arguments of a `doc` (a program's
        # path, or `--std` and the paths of std modules): what it prints
        # and its status, and the pages `--output` writes, into OUT.
        let texts = std_texts(sys, home)?
        let base = typeck.base(texts, catalog)
        var env = base.environment()
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        for line in list.lines():
            if line.is_empty():
                continue
            n += 1
            var words = ["doc".to_string()]
            for w in line.split_whitespace():
                words.push(w.to_string())
            let (asked, wrong) = doc_args(words, catalog)
            let fine = wrong.is_empty()
            var report = DocReport.failed(wrong, 2)
            if fine:
                # A program of one file is named by its file's name, as
                # stage 0 names it when run in the file's directory.
                var name: String? = None
                if let Some(t) = asked.targets.first():
                    if not asked.std_lib:
                        name = Some(package.file_name(t))
                report = doc_report(sys, home, asked, name, base, texts, mut env, catalog, mut o)?
            var out = report.out.copy()
            if report.status == 0:
                out = doc.printed(report.pages)
            sys.fs.write_text(Path.new("{out_dir}/{n}.doc.out"), out)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.doc.err"), report.err)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.doc.status"), "{report.status}\n")?
            # `--output DIR`: each page written into a directory of its own.
            var status = report.status
            var errs = report.err.copy()
            if report.status == 0:
                let failed = write_pages(sys, "{out_dir}/{n}.pages", report.pages, catalog)
                if not failed.is_empty():
                    status = 1
                    errs = failed
            sys.fs.write_text(Path.new("{out_dir}/{n}.pages.err"), errs)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.pages.status"), "{status}\n")?
        o.put("files {n}")
        return Ok(())
    if command == "fmt":
        # `fmt [--check] [PATH...]`: what `sisu fmt` does, its exit status
        # given as `Exit(status=N)`.
        let status = fmt_command(sys, home, rest, catalog, mut o, served)?
        if status != 0:
            return Err(Exit(status=status))
        return Ok(())
    if command == "fmt-batch" and len(rest) == 3:
        # For each file, what `sisu fmt --check FILE` prints and its status,
        # the text `sisu fmt FILE` leaves, and whether formatting that text
        # again changes it.
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var base: typeck.Base? = None
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            var report = FmtReport(out=String.new(), err=String.new(), status=0, changed=None)
            var text = String.new()
            var again = String.new()
            match sys.fs.read_to_string(Path.new(path)):
                case Ok(t):
                    text = t
                    report = fmt_file(sys, home, path, text, True, mut base, catalog)?
                    if let Some(out) = report.changed.copy():
                        let next = fmt_file(sys, home, path, out, True, mut base, catalog)?
                        if next.changed.is_some() or next.status != 0:
                            again = "formatting the formatted text changes it\n{next.out}{next.err}"
                case Err(e):
                    report.err = cannot_read(path, e, catalog)
                    report.status = 1
            sys.fs.write_text(Path.new("{out_dir}/{n}.check.out"), report.out)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.check.err"), report.err)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.check.status"), "{report.status}\n")?
            sys.fs.write_text(Path.new("{out_dir}/{n}.fmt"), report.changed ?? text)?
            sys.fs.write_text(Path.new("{out_dir}/{n}.again"), again)?
        o.put("files {n}")
        return Ok(())
    if command == "fmt-profile" and len(rest) == 2:
        # Where the formatter's time goes over the files LIST names, each
        # formatted as `fmt --check` formats it: parsing, laying out,
        # parsing the result again, the two shapes, and the hunks.
        let list = sys.fs.read_to_string(Path.new(rest[1].copy()))?
        var times = [0, 0, 0, 0, 0, 0]
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            let text = sys.fs.read_to_string(Path.new(path))?
            let t0 = now(sys)
            let parsed = parse(text, catalog)
            let t1 = now(sys)
            let out = fmt.lines.format_tree(parsed.tree, set())
            let t2 = now(sys)
            times[0] += t1 - t0
            times[1] += t2 - t1
            if out == text:
                continue
            let again = parse(out, catalog)
            let t3 = now(sys)
            let a = fmt.shape.shape_of(parsed.tree)
            let t4 = now(sys)
            let b = fmt.shape.shape_of(again.tree)
            let t5 = now(sys)
            let d = diff.hunks(text, out, 2)
            let t6 = now(sys)
            times[2] += t3 - t2
            times[3] += t4 - t3
            times[4] += t5 - t4
            times[5] += t6 - t5
            if a != b or d.is_empty():
                o.put("{path}: the shapes differ, or no hunks")
        let parts = "parse {ms(times[0])} ms layout {ms(times[1])} ms parse again {ms(times[2])} ms"
        o.put(
            "files {n} {parts} shapes {ms(times[3])} and {ms(times[4])} ms hunks {ms(times[5])} ms"
        )
        return Ok(())
    if command == "deform" and len(rest) == 3:
        # For the `n`th file, its text with the lines inside brackets joined
        # (`OUT/jN.sisu`) and with a line break after each comma inside
        # brackets (`OUT/sN.sisu`): what a formatter must break and join.
        let out_dir = rest[1].copy()
        let list = sys.fs.read_to_string(Path.new(rest[2].copy()))?
        var n = 0
        for path in list.lines():
            if path.is_empty():
                continue
            n += 1
            let text = sys.fs.read_to_string(Path.new(path))?
            sys.fs.write_text(Path.new("{out_dir}/j{n}.sisu"), joined(text))?
            sys.fs.write_text(Path.new("{out_dir}/s{n}.sisu"), spread(text))?
        return Ok(())
    if command == "mutate" and len(rest) == 5:
        let seed = rest[1].parse_int() ?? 1
        let count = rest[2].parse_int() ?? 0
        let out_dir = rest[3].copy()
        let list = sys.fs.read_to_string(Path.new(rest[4].copy()))?
        var files: list[String] = []
        for path in list.lines():
            if not path.is_empty():
                files.push(sys.fs.read_to_string(Path.new(path))?)
        var rng = Rng.new(seed)
        for k in range(count):
            let mutant = mutate(files[k % len(files)], mut rng)
            sys.fs.write_text(Path.new("{out_dir}/m{k + 1}.sisu"), mutant)?
        return Ok(())
    return Err(Usage(text=usage()))

## `sir` of the program at `path` with the base `base` (the words after the
## command, `words`; the contracts `level` checks; the features `request`
## asks for).
def sir_with(
    sys: System,
    home: str,
    path: str,
    words: list[String],
    level: int,
    request: FeatureRequest,
    base: typeck.Base,
    catalog: Catalog,
    mut o: Out,
) -> ! {IoError, UsageError, CommandError}:
    var kept = Kept.new()
    var env = base.environment()
    var times = SirTimes(check=0, lower=0, ownership=0)
    # `--partial`: the SIR of what lowering reached, also of a program
    # beyond its slice (for comparing a package's modules one by one).
    let partial = words.contains("--partial")
    # `--tests`: the program built with its tests, as `sisu test` and
    # `sisu bench` run it, its tests' tags and its benchmarks written
    # (decision 285).
    let tests = words.contains("--tests")
    if words.contains("--defer-borrow") and not partial:
        # `--defer-borrow`: the SIR of a program whose only errors are the
        # ownership rules', for stage 0's counterexample mode (RULES.md,
        # R189).
        let input = app_input(sys, home, path, tests, request, mut env, catalog)? else:
            return Ok(())
        var built = input.copy()
        built.contracts = level
        built.roots = transcript_roots(sys, built.disk, tests)
        built.std_tests = tests and words.contains("--std")
        let d = deferred_program(base, built, path, catalog, mut kept, words.contains("--modules"))
        let (sir, errs, status) = deferred_answer(d, catalog, words.contains("--format=ids"))
        o.emit(sir, errs)
        if status != 0:
            return Err(Exit(status=status))
        return Ok(())
    if tests and not partial:
        # What `sisu test` runs (decision 357), from one check of the
        # program: a program with an error of a phase is not run, as
        # `sisu test` says (RULES.md, R46); another has its SIR, and
        # its warnings on standard error, in the form `check` prints
        # them (RULES.md, R47).
        let ids = words.contains("--format=ids")
        let input = app_input(sys, home, path, True, request, mut env, catalog)? else:
            return Ok(())
        var built = input.copy()
        built.contracts = level
        built.roots = transcript_roots(sys, built.disk, True)
        built.std_tests = words.contains("--std")
        # `--modules`: each test's and benchmark's module beside it
        # (RULES.md, R142), which the driver reads to run one module's.
        let modules = words.contains("--modules")
        let (r, sir) = report_with(base, built, path, catalog, mut kept, True, modules)
        if let Some(why) = refusal(r, catalog, ids):
            o.emit("", why)
            return Err(Failed)
        var warned = r.human(catalog)
        if ids:
            warned = r.ids(catalog)
        # `--mutants` and `--mutant=K`: each mutant's SIR after the line
        # that says what it changes (RULES.md, R208).
        var only: int? = None
        for w in words:
            if w.starts_with("--mutant="):
                only = w.byte_slice(9, w.byte_len()).parse_int()
        if words.contains("--mutants") or only.is_some():
            o.emit(mutant_sirs(base, built, path, only, catalog, mut kept, modules), warned)
            return Ok(())
        o.emit(sir, warned)
        return Ok(())
    let done = lowering_of(
        sys,
        home,
        path,
        base,
        mut env,
        catalog,
        mut times,
        partial,
        Some(level),
        False,
        tests,
        request,
        mut kept,
    )?
    var errs = String.new()
    for b in done.beyond:
        errs.push("beyond the slice: {b}\n")
    o.emit(done.sir, errs)
    return Ok(())

## The mutants of the program `input` (RULES.md, R208), or with `only`
## the `only`th: for each, in the order of the root package's modules and
## of their places, a line `# mutant K: FILE:LINE:COL: WHAT`, then the SIR
## of the program with its tests and that change. A mutant that does not
## check has its line, ` (it does not check)` after it, and no SIR.
pure def mutant_sirs(
    base: typeck.Base,
    input: Input,
    path: str,
    only: int?,
    catalog: Catalog,
    mut kept: Kept,
    modules: bool,
) -> String:
    var out = String.new()
    var k = 0
    for m in range(len(input.modules)):
        let module = ref input.modules[m]
        if module.package != 0:
            continue
        let text = module.text.copy()
        let parsed = build.module(parse(text, catalog).tree)
        var shown = module.file.copy()
        if input.package_name.is_empty():
            shown = path.to_string()
        for site in mutation.sites(text, parsed):
            let n = k
            k += 1
            if let Some(o) = only:
                if o != n:
                    continue
            let (line, col) = mutation.place(text, site.start)
            out.push("# mutant {n}: {shown}:{line}:{col}: {site.what}")
            var changed = input.copy()
            changed.modules[m].text = mutation.mutated(text, site)
            let (r, sir) = report_with(base, changed, path, catalog, mut kept, True, modules)
            if refusal(r, catalog, True).is_some() or sir.is_empty():
                out.push(" (it does not check)\n")
                continue
            out.push("\n")
            out.push(sir)
    return out

## `check` of the program at `path` with the base `base`, in the form
## `ids` asks for.
def check_with(
    sys: System,
    home: str,
    path: str,
    ids: bool,
    request: FeatureRequest,
    base: typeck.Base,
    catalog: Catalog,
    mut o: Out,
    diary: String?,
) -> ! {IoError, UsageError, CommandError}:
    var kept = Kept.new()
    var env = base.environment()
    let reports = reports_of(
        sys, home, path, path, True, request, base, mut env, catalog, mut kept
    )?
    var out = String.new()
    var why = String.new()
    var failed = False
    if let Some(log) = diary:
        for r in reports:
            if r.ours == 0:
                continue
            if let Some(reason) = append_diary(sys, log, r, catalog):
                let params = [
                    Param(name="path".to_string(), value=log.copy()),
                    Param(name="reason".to_string(), value=reason),
                ]
                o.emit("", catalog.plain_error("cli.cannot-write", params))
                return Err(Failed)
    for r in reports:
        if ids:
            out.push(r.ids(catalog))
        else:
            out.push(r.human(catalog))
        if r.has_error:
            failed = True
        for b in r.beyond:
            why.push("beyond the slice: {b}\n")
    if ids:
        o.emit(out, why)
    else:
        out.push(why)
        o.emit("", out)
    if failed:
        return Err(Failed)
    return Ok(())

## Appends a check's records to the diary at `log` (RULES.md, R186), and
## keeps its files' texts by their hashes in `LOG.d/`; why it could not,
## when it could not.
def append_diary(sys: System, log: str, r: Report, catalog: Catalog) -> String?:
    let store = "{log}.d"
    var previous = String.new()
    if let Ok(t) = sys.fs.read_to_string(Path.new(log)):
        previous = t
    var kept: dict[String, String] = {}
    for h in diary.wanted(previous, r.files, r.ours):
        if let Ok(t) = sys.fs.read_to_string(Path.new("{store}/{h}")):
            _ = kept.insert(h.copy(), t)
    let time = diary.timestamp(sys.clock.now().unix_seconds())
    let lines = diary.records(previous, kept, time, VERSION, r.ours, r.files, r.diags, catalog)
    if let Err(e) = make_dirs(sys, store):
        return Some(io_reason(e))
    for k in range(r.ours):
        let p = "{store}/{diary.hash(r.files[k].1)}"
        if not sys.fs.exists(Path.new(p)):
            if let Err(e) = sys.fs.write_text(Path.new(p), r.files[k].1):
                return Some(io_reason(e))
    var text = previous.copy()
    for l in lines:
        text.push("{l}\n")
    if let Err(e) = sys.fs.write_text(Path.new(log), text):
        return Some(io_reason(e))
    return None

## `lint` of the program at `path` with the base `base`, in the form `ids`
## asks for.
def lint_with(
    sys: System,
    home: str,
    path: str,
    ids: bool,
    request: FeatureRequest,
    base: typeck.Base,
    catalog: Catalog,
    mut o: Out,
) -> ! {IoError, UsageError, CommandError}:
    var kept = Kept.new()
    var env = base.environment()
    let reports = reports_of(
        sys, home, path, path, True, request, base, mut env, catalog, mut kept
    )?
    var out = String.new()
    var failed = False
    for r in reports:
        var shown = r.copy()
        if r.has_error:
            failed = True
            shown = r.front(catalog, Some(True))
        for x in r.lints:
            shown.diags.push(x.copy())
        # The imports a module does not use (RULES.md, R87), in the
        # program's own files.
        for k in range(len(r.files)):
            let (name, text) = r.files[k].copy()
            if name.ends_with(".sisu") and not name.starts_with("<"):
                # An import the resolver refused (`E0204`, `E0203`,
                # `E0220`) is reported once, by its error (RULES.md,
                # R103).
                var refused: list[(int, int)] = []
                for x in r.diags:
                    if x.file == k and catalog.is_error(x.diag.msg):
                        refused.push((x.diag.start, x.diag.end))
                for d in fmt.prune.lints(text, refused, catalog):
                    shown.diags.push(Filed(file=k, diag=d.copy(), label_files=[]))
        sort_filed(mut shown.diags, catalog, True)
        if ids:
            out.push(shown.ids(catalog))
        else:
            out.push(shown.human(catalog))
    if ids:
        o.emit(out, "")
    else:
        o.emit("", out)
    if failed:
        return Err(Failed)
    return Ok(())

## What stage 1 makes of a program for `sisu sir` and for the ownership
## checker's part of `sisu check`: the SIR (nothing when the front end
## finds an error), the ownership checker's diagnostics as `sisu check
## --format=ids` prints them, and why the program is beyond the slice of
## lowering, when it is (then neither is stage 0's).
struct Lowering:
    sir: String
    ownership: String
    beyond: list[String]
    ## The SIR has an entry, a `main` to run.
    entry: bool
    ## The program has an error of a phase: the front end's, the ownership
    ## checker's or a failed `comptime` expression's. A build with its
    ## tests prints no SIR of it, since `sisu test` would run it (RULES.md,
    ## R46); a build without them prints the SIR of a program the ownership
    ## checker rejects, as `sisu sir` does.
    refused: bool

## A program as the front end reads it (stage 0's `ProgramSource`): its
## modules and packages, whether stage 0 reports an error about it that is
## not the type checker's (a name's, a manifest's, an untrusted package's
## `unsafe`, a `@cfg` that is no condition), the files its `embed` calls
## name, and whether it is a program of several files, whose diagnostics
## name their file.
struct Input:
    modules: list[typeck.InputModule]
    packages: list[SourcePackage]
    named: bool
    ## Where the name pass found an error: each the index of its module and
    ## its start (one in a template's body is its instances' error).
    name_errors: list[(int, int)]
    embedded: dict[String, Embedded]
    multi: bool
    ## Whether the program is built with its tests (`check`), or without
    ## them (`sir`, `build`; decision 243); and each package's features.
    tests: bool
    features: list[Features]
    ## The problems of each module's `@cfg`s (`E0266`, `W0006`).
    cfg: list[list[Diagnostic]]
    ## What `check` prints besides the type checker's and the ownership
    ## checker's diagnostics: each module's syntax and name diagnostics,
    ## the manifests the layout read (each name and text) with their
    ## problems, and the `unsafe` and `extern` of a package its user does
    ## not trust (`cap.untrusted`), each with its module.
    syntax: list[list[Diagnostic]]
    names: list[list[Diagnostic]]
    manifests: list[(String, String)]
    problems: list[Problem]
    untrusted: list[(int, Diagnostic)]
    ## The root module's file on disk, the root package's name (empty for a
    ## program of one file) and the directory of its lockfile, its
    ## workspace's or its own (stage 0's `build_root`; none for a program of
    ## one file): where `build` puts the executable.
    disk: String
    package_name: String
    build_root: String?
    ## What a build says of the program: the root package's version, the
    ## number of its modules and its `[profile.release] contracts` (07);
    ## and the contracts lowering checks (`lower.CONTRACTS_...`, all of them
    ## but in a build that asks for fewer, decision 232).
    package_version: String
    own_modules: int
    release_contracts: String?
    contracts: int
    ## The root package's runtime profile (12; RULES.md, R122): `full`, or
    ## `single`, which the SIR names.
    runtime: String
    ## The functions lowering keeps besides what the entry, the exports and
    ## the tests reach: for `sir --tests` of a program that has transcripts,
    ## the world they run against (decision 687; RULES.md, R120).
    roots: list[String]
    ## For a REPL session's program, the lines of each input it holds, which
    ## its SIR names and numbers as the input's own (RULES.md, R123).
    regions: list[session.Region]
    ## `sir --tests --std`: the standard library's doc examples are tests
    ## too (RULES.md, R185).
    std_tests: bool

## The programs the argument names, read: a file's, or each layout's that
## has modules (stage 0 reports the others' problems and checks nothing).
def inputs_of(
    sys: System,
    home: str,
    arg: str,
    sir: bool,
    tests: bool,
    request: FeatureRequest,
    mut env: Environment,
    catalog: Catalog,
) -> list[Input] ! IoError:
    let layouts = layouts_of(sys, arg, sir, request) else:
        let text = sys.fs.read_to_string(Path.new(arg))?
        return Ok([file_input(sys, home, arg, text, tests, mut env, catalog)?])
    var out: list[Input] = []
    for layout in layouts:
        if layout.modules.is_empty():
            continue
        out.push(layout_input(sys, home, layout, tests, mut env, catalog)?)
    return Ok(out)

## The program of the one file `arg`, whose text is `text`, as a build
## with or without its tests compiles it.
def file_input(
    sys: System, home: str, arg: str, text: str, tests: bool, mut env: Environment, catalog: Catalog
) -> Input ! IoError:
    let features = Features.for_runtime(target_runtime(sys))
    let built = name_diagnostics(sys, home, text, tests, features.copy(), mut env, catalog)?
    let (syntax, found_names, cfg_diags) = built
    let names = beside_notes(sys, arg, found_names)
    var named = False
    var name_errors: list[(int, int)] = []
    for d in names:
        if catalog.is_error(d.msg):
            name_errors.push((0, d.start))
    for d in cfg_diags:
        if catalog.is_error(d.msg):
            named = True
    let module = typeck.InputModule(path=[], file=arg.to_string(), text=text.to_string(), package=0)
    let package = SourcePackage(name=String.new(), deps=[], trusted=True, excluded=[], dev_only=[])
    return Ok(
        Input(
            modules=[module],
            packages=[package],
            named=named,
            name_errors=name_errors,
            embedded=embedded_files(sys, arg, None, text, catalog),
            multi=False,
            tests=tests,
            features=[features],
            cfg=[cfg_diags],
            syntax=[syntax],
            names=[names],
            manifests=[],
            problems=[],
            untrusted=[],
            disk=arg.to_string(),
            package_name=String.new(),
            build_root=None,
            package_version=String.new(),
            own_modules=1,
            release_contracts=None,
            contracts=CONTRACTS_ALL,
            runtime="full".to_string(),
            roots=[],
            std_tests=False,
            regions=[],
        )
    )

## A layout's program, read, as a build with or without its tests
## compiles it.
def layout_input(
    sys: System, home: str, layout: Layout, tests: bool, mut env: Environment, catalog: Catalog
) -> Input ! IoError:
    return held_layout_input(sys, home, layout, tests, mut env, catalog, {})

## `layout_input`, with the texts of modules held in memory by their paths
## on disk, which are not read (a session's program, RULES.md, R79).
def held_layout_input(
    sys: System,
    home: str,
    layout: Layout,
    tests: bool,
    mut env: Environment,
    catalog: Catalog,
    held: dict[String, String],
) -> Input ! IoError:
    let (named, cfg_diags) = held_named_modules(sys, home, layout, tests, mut env, catalog, held)?
    var modules: list[typeck.InputModule] = []
    var embedded: dict[String, Embedded] = {}
    for i in range(len(layout.modules)):
        let m = ref layout.modules[i]
        let text = named[i].text.copy()
        modules.push(
            typeck.InputModule(
                path=m.path.copy(), file=m.name.copy(), text=text.copy(), package=m.package
            )
        )
        # The files `embed` names, relative to the root of each module's
        # package; the first module that names one decides.
        let root = layout.packages[m.package].dir.copy()
        for (k, v) in embedded_files(sys, m.disk, Some(root), text, catalog).items():
            if not embedded.contains(k.copy()):
                _ = embedded.insert(k.copy(), v.copy())
    var packages: list[SourcePackage] = []
    for p in layout.packages:
        var excluded: list[String] = []
        var dev_only: list[String] = []
        for w in p.wants:
            if not w.active and w.package.is_some():
                excluded.push(w.name.copy())
            # A dev-dependency is its package's tests' (RULES.md, R75).
            if w.dev and w.active and w.package.is_some():
                dev_only.push(w.name.copy())
        packages.push(
            SourcePackage(
                name=p.name.copy(),
                deps=p.deps.copy(),
                trusted=p.trusted,
                excluded=excluded,
                dev_only=dev_only,
            )
        )
    # Stage 0's errors that are not the type checker's: the manifests' and
    # the module trees' problems, a name that names nothing, and `unsafe` or
    # `extern` in a dependency `[trust]` does not list (`cap.untrusted`).
    var other = layout.has_errors(catalog)
    let found = modules_with_absences(
        without_unreachable(
            resolve.resolve_program(named, packages_of(layout), env, catalog), layout
        ),
        named,
    )
    var name_errors: list[(int, int)] = []
    for i in range(len(found)):
        for d in found[i]:
            if catalog.is_error(d.msg):
                name_errors.push((i, d.start))
    for ds in cfg_diags:
        for d in ds:
            if catalog.is_error(d.msg):
                other = True
    var features: list[Features] = []
    for p in layout.packages:
        var declared: list[String] = []
        for f in p.features:
            declared.push(f.name.copy())
        features.push(Features(declared=declared, on=p.on.copy(), runtime=layout.runtime.copy()))
    # A dependency that declares its level and that `[trust]` does not
    # list is `E1021`, which names the fix: its `unsafe` and `extern` are
    # not reported again (RULES.md, R104).
    let levels = unsafe_levels(layout, named)
    var consent: list[String] = []
    for (_, d) in levels:
        if d.diag.msg == Msg.PackageUnsafeUntrusted:
            if let Some(n) = d.diag.param("name"):
                consent.push(n)
    var untrusted: list[(int, Diagnostic)] = []
    for i in range(len(layout.modules)):
        let k = layout.modules[i].package
        if k == 0 or layout.packages[k].trusted or consent.contains(layout.packages[k].name):
            continue
        for t in lex(named[i].text).tokens:
            var what = String.new()
            if t.kind == SyntaxKind.UnsafeKw:
                what = "`unsafe`".to_string()
            elif t.kind == SyntaxKind.ExternKw:
                what = "`extern`".to_string()
            else:
                continue
            other = True
            let d = Diagnostic.new(Msg.CapUntrusted, t.start, t.end)
            untrusted.push((i, d.with("package", layout.packages[k].name).with("what", what)))
    # The level each package declares against the unsafe code it has (22,
    # D-082): code with no declaration, or above it, is an error; a
    # declaration above the code a warning; a dependency that declares one
    # needs the root's consent.
    var problems = layout.problems.copy()
    for (i, d) in levels:
        if catalog.is_error(d.diag.msg):
            other = True
        if i >= 0:
            untrusted.push((i, d.diag.copy()))
        else:
            problems.push(d.copy())
    var syntax: list[list[Diagnostic]] = []
    for m in named:
        syntax.push(m.syntax.copy())
    var disk = String.new()
    if let Some(root) = layout.modules.first():
        disk = root.disk.copy()
    var package_name = String.new()
    var package_version = String.new()
    var release_contracts: String? = None
    var runtime = "full".to_string()
    if let Some(root) = layout.packages.first():
        package_name = root.name.copy()
        package_version = root.version.copy()
        release_contracts = root.release_contracts.copy()
        runtime = root.runtime.copy()
    var own_modules = 0
    for m in layout.modules:
        if m.package == 0:
            own_modules += 1
    var build_root: String? = None
    if let Some(lock) = layout.lock.copy():
        build_root = Some(parent(lock))
    return Ok(
        Input(
            modules=modules,
            packages=packages,
            named=other,
            name_errors=name_errors,
            embedded=embedded,
            multi=True,
            tests=tests,
            features=features,
            cfg=cfg_diags,
            syntax=syntax,
            names=found,
            manifests=layout.files.copy(),
            problems=problems,
            untrusted=untrusted,
            disk=disk,
            package_name=package_name,
            build_root=build_root,
            package_version=package_version,
            own_modules=own_modules,
            release_contracts=release_contracts,
            contracts=CONTRACTS_ALL,
            runtime=runtime,
            roots=[],
            std_tests=False,
            regions=[],
        )
    )

## The name diagnostics without an import of a dependency the build cannot
## reach, one that is not a `path` dependency (`E1010`): the manifest's error
## is the one that says what to write, so `E0220` does not precede it
## (RULES.md, R104).
pure def without_unreachable(
    own found: list[list[Diagnostic]], layout: Layout
) -> list[list[Diagnostic]]:
    var refused: list[String] = []
    for p in layout.problems:
        if p.diag.msg == Msg.PackageNotAPath:
            if let Some(n) = p.diag.param("name"):
                refused.push(n)
    if refused.is_empty():
        return found
    var out: list[list[Diagnostic]] = []
    for ds in found:
        var kept: list[Diagnostic] = []
        for d in ds:
            var drop = False
            if d.msg == Msg.ResolveImportUnknown:
                if let Some(n) = d.param("name"):
                    var first = n.copy()
                    if let Some((a, _)) = n.split_once("."):
                        first = a.to_string()
                    drop = refused.contains(first)
            if not drop:
                kept.push(d.copy())
        out.push(kept)
    return out

## The diagnostics of a program of one file, `E0220` for an import of a
## module whose file or directory stands beside it with the note that only
## a package makes them one program (09: a package is a directory with a
## `sisu.toml` and a `src/` tree; RULES.md, R119).
def beside_notes(sys: System, path: str, own found: list[Diagnostic]) -> list[Diagnostic]:
    var dir = ".".to_string()
    for i in range(path.byte_len()):
        if path.byte_at(i) == 47:
            dir = path.byte_slice(0, i).to_string()
    var out: list[Diagnostic] = []
    for d in found:
        var kept = d.copy()
        if d.msg == Msg.ResolveImportUnknown:
            if let Some(n) = d.param("name"):
                var first = n.copy()
                if let Some((a, _)) = n.split_once("."):
                    first = a.to_string()
                let file = "{dir}/{first}.sisu"
                if sys.fs.exists(Path.new(file)) or sys.fs.exists(Path.new("{dir}/{first}")):
                    kept = kept.note_with(Msg.ResolveModuleBeside, "name", first)
        out.push(kept)
    return out

## The names an import that tests the target would bind, which this build
## leaves out, each with its condition, and the `if comptime` branches on
## the target that the build leaves out (RULES.md, R106).
pure def target_absences(
    text: str, tree: Tree, features: Features
) -> (list[(String, String)], list[TextRange]):
    if not text.contains("target."):
        return ([], [])
    let m = build.module(tree)
    var names: list[(String, String)] = []
    if let Some(f) = cfg.filter(m, True, Some(features.copy())).module:
        for (n, c) in f.left_out:
            if c.starts_with("target."):
                names.push((n.copy(), c.copy()))
    return (names, cfg.discarded_branches(m.ast, features.facts()))

## The name diagnostics of a module without `E0200` for a name an import on
## the target left out, where an `if comptime` branch on the target that
## the build leaves out uses it; elsewhere, the `E0200` names the import's
## condition (RULES.md, R106).
pure def with_absences(
    own diags: list[Diagnostic], absent: list[(String, String)], discarded: list[TextRange]
) -> list[Diagnostic]:
    if absent.is_empty():
        return diags
    var out: list[Diagnostic] = []
    for d in diags:
        var cond: String? = None
        if d.msg == Msg.ResolveUndefinedName:
            if let Some(n) = d.param("name"):
                for (a, c) in absent:
                    if a == n:
                        cond = Some(c.copy())
        match cond:
            case Some(c):
                var inside = False
                for r in discarded:
                    if r.start <= d.start and d.end <= r.end:
                        inside = True
                if not inside:
                    let ps = [
                        Param(name="name".to_string(), value=d.param("name") ?? String.new()),
                        Param(name="cfg".to_string(), value=c.copy()),
                    ]
                    # The note says what to write; a similar name does not.
                    var noted = d.copy()
                    noted.fixes = []
                    out.push(noted.note_params(Msg.ResolveCfgImportAbsent, ps))
            case None:
                out.push(d.copy())
    return out

## Each module's name diagnostics `with_absences`.
pure def modules_with_absences(
    own found: list[list[Diagnostic]], named: list[NamedModule]
) -> list[list[Diagnostic]]:
    var out: list[list[Diagnostic]] = []
    for i in range(len(found)):
        if i < len(named):
            out.push(with_absences(found[i].copy(), named[i].absent, named[i].discarded))
        else:
            out.push(found[i].copy())
    return out

## What `E1019` and `E1020` call the code that needs `unsafe = "extern"`.
const FOREIGN_CODE: str = "foreign code (an `extern` block or a header import)"

## The diagnostics of the `unsafe` levels of a layout's packages (22,
## "Packages: the manifest field"; D-082), each with the module it is in
## (an index of `named`), or -1 and a problem of a manifest: `E1019` for a
## package with unsafe code and no `unsafe` in its manifest, `E1020` for
## an `extern` block or a header import in a package that declares
## `memory`, at its first such code; `W0012` for a declaration above what
## the package's code uses, and `E1021` for a dependency that declares a
## level the root's `[trust] unsafe` does not list, at the declaration. A
## program of one file has no manifest to declare one in.
pure def unsafe_levels(layout: Layout, named: list[NamedModule]) -> list[(int, package.Problem)]:
    var out: list[(int, package.Problem)] = []
    let n = len(layout.packages)
    var used: list[int] = []
    var first_unsafe: list[(int, int, int)?] = []
    var first_extern: list[(int, int, int)?] = []
    for _ in range(n):
        used.push(0)
        first_unsafe.push(None)
        first_extern.push(None)
    for i in range(min(len(layout.modules), len(named))):
        let k = layout.modules[i].package
        let text: str = named[i].text
        let mentioned = text.contains("unsafe")
            or text.contains("extern")
            or text.contains("import c")
        if k >= n or not mentioned:
            continue
        let tokens = lex(text).tokens
        # The two significant tokens before this one, for `import c "...h"`.
        var before: SyntaxKind? = None
        var previous: SyntaxKind? = None
        var previous_c = False
        for t in tokens:
            if t.kind.is_trivia():
                continue
            if t.kind == SyntaxKind.UnsafeKw:
                used[k] = max(used[k], 1)
                if first_unsafe[k].is_none():
                    first_unsafe[k] = Some((i, t.start, t.end))
            # An `extern` block, or a C header import (`import c "zlib.h"`,
            # not `import c`, a package named `c`).
            let header = before == Some(SyntaxKind.ImportKw)
                and previous_c
                and t.kind == SyntaxKind.StringStart
            if t.kind == SyntaxKind.ExternKw or header:
                used[k] = 2
                if first_extern[k].is_none():
                    first_extern[k] = Some((i, t.start, t.end))
            before = previous
            previous = Some(t.kind)
            previous_c = t.kind == SyntaxKind.Ident and text.byte_slice(t.start, t.end) == "c"
    for k in range(n):
        let p = ref layout.packages[k]
        let file = p.manifest else:
            continue
        var declared = 0
        var at = TextRange.empty(0)
        var level = String.new()
        if let Some((l, r)) = p.unsafe_level:
            declared = package.level_rank(l)
            at = r
            level = l.copy()
        if used[k] > 0 and declared == 0:
            var site = first_unsafe[k]
            if used[k] == 2:
                site = first_extern[k]
            let (i, s, e) = site ?? (0, 0, 0)
            var what = "unsafe code"
            if used[k] == 2:
                what = FOREIGN_CODE
            let wanted = if used[k] == 2: "extern" else: "memory"
            var d = Diagnostic.new(Msg.PackageUnsafeUndeclared, s, e).with("package", p.name)
            d = d.with("what", what).with("level", wanted)
            out.push((i, package.Problem(file=file, diag=d, label_files=[])))
        elif declared == 1 and used[k] == 2:
            let (i, s, e) = first_extern[k] ?? (0, 0, 0)
            var d = Diagnostic.new(Msg.PackageUnsafeLevel, s, e).with("package", p.name)
            d = d.with("what", FOREIGN_CODE)
            out.push((i, package.Problem(file=file, diag=d, label_files=[])))
        if declared > used[k]:
            var why = "and has no foreign code: `unsafe = \"memory\"` says what it uses"
            if used[k] == 0:
                why = "and contains no unsafe code: remove it"
            var d = Diagnostic.new(Msg.UnsafeLevel, at.start, at.end).with("level", level)
            out.push((-1, package.Problem(file=file, diag=d.with("why", why), label_files=[])))
        if k != 0 and not p.trusted and declared > 0:
            var d = Diagnostic.new(Msg.PackageUnsafeUntrusted, at.start, at.end)
            d = d.with("name", p.name).with("level", level)
            d = d.note_with(Msg.PackageTrustToConsent, "name", p.name)
            out.push((-1, package.Problem(file=file, diag=d, label_files=[])))
    return out

## `audit --unsafe [PATH]` (22, "The audit and the lints"; D-083): the
## unsafe code of the program PATH names (a file, a package, a workspace's
## members, by default the package of the working directory), per package
## with its declared level and the program's consent, per module with its
## hash, then the lints and the rules of unsafe code that `check` reports;
## `audit --unsafe --std` the standard library's own unsafe code.
def audit_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out
) -> ! {IoError, UsageError, CommandError}:
    let flags = ["--unsafe", "--std"]
    if not rest.contains("--unsafe"):
        return Err(Usage(text="usage: sisu audit --unsafe [--std] [PATH]".to_string()))
    var packages: list[AuditPackage] = []
    var modules: list[AuditModule] = []
    if rest.contains("--std"):
        let std_package = AuditPackage(
            name="std".to_string(),
            version="(toolchain)".to_string(),
            level="extern".to_string(),
            consent="trusted by every program".to_string(),
        )
        packages.push(std_package)
        var names = ["prelude".to_string()]
        for n in documented():
            names.push(n.to_string())
        names.push("rt".to_string())
        for n in names:
            let text = sys.fs.read_to_string(Path.new(std_file(home, n)))?
            let module = AuditModule(
                package=0, path=display_path(n), file="<std>/{n}.sisu", text=text
            )
            modules.push(module)
        o.emit(unsafe_report(packages, modules, []), "")
        return Ok(())
    var path = path_of(rest, flags) else:
        return Err(Usage(text=usage()))
    if not names_path(rest, flags):
        var direct = Out.direct()
        let found = nearest_package(sys, "audit", catalog, mut direct) else:
            return Err(Failed)
        path = found
    match layouts_of(sys, path, False, build_request(sys)):
        case Some(layouts):
            for layout in layouts:
                let first = len(packages)
                let root_manifest = audit_root_manifest(layout)
                for k in range(len(layout.packages)):
                    let p = ref layout.packages[k]
                    var level = String.new()
                    if let Some((l, _)) = p.unsafe_level:
                        level = l.copy()
                    var consent = "not trusted: `[trust] unsafe` does not list it".to_string()
                    if k == 0:
                        consent = "the root package".to_string()
                    elif p.trusted:
                        consent = "trusted in {trust_line(root_manifest, p.name)}"
                    packages.push(
                        AuditPackage(
                            name=p.name.copy(),
                            version=p.version.copy(),
                            level=level,
                            consent=consent,
                        )
                    )
                for m in layout.modules:
                    let text = sys.fs.read_to_string(Path.new(m.disk))?
                    let module = AuditModule(
                        package=first + m.package,
                        path=m.path.join("."),
                        file=m.name.copy(),
                        text=text,
                    )
                    modules.push(module)
        case None:
            let text = sys.fs.read_to_string(Path.new(path))?
            let file = package.file_name(path)
            let one = AuditPackage(
                name=file.copy(),
                version=String.new(),
                level="no level".to_string(),
                consent="a program of one file, which may hold any unsafe code".to_string(),
            )
            packages.push(one)
            modules.push(AuditModule(package=0, path=file.copy(), file=file, text=text))
    # The lints and the rules of unsafe code, as `check --format=ids` prints
    # them.
    let base = base_of(sys, home, std_texts(sys, home)?, catalog)
    var kept = Kept.new()
    var env = base.environment()
    let reports = reports_of(
        sys, home, path, path, True, build_request(sys), base, mut env, catalog, mut kept
    )?
    var lints: list[String] = []
    for r in reports:
        var keep = False
        for line in r.ids(catalog).lines():
            if line.starts_with("  "):
                if keep:
                    lints.push("  {line.trim()}")
                continue
            keep = is_unsafe_rule(line)
            if keep:
                lints.push(line.to_string())
    var out = unsafe_report(packages, modules, lints)
    out.push("std (toolchain)   unsafe = \"extern\"   see `sisu audit --unsafe --std`\n")
    o.emit(out, "")
    return Ok(())

## The front end's report of a program, and when it has no error of the
## front end its SIR as the ownership checker leaves it (drops placed,
## simplified, its `comptime` values baked in when the checker found
## nothing), with the SIR source of the input's module `at`: what stage
## 0's `explain-borrow` reads (`db.lowered`'s program), whose ownership
## errors do not stop it (RULES.md, R187).
pure def owned_program(
    base: typeck.Base, input: Input, at: int, name: str, catalog: Catalog
) -> (Report, sir.Program?, int):
    var kept = Kept.new()
    let checked = check_input(base, input, catalog, True)
    let report = front_report(input, checked, name, catalog)
    if report.has_error:
        return (report, None, 0)
    let files = program_files(input, checked)
    let lowered = lower_of(checked, base, input, catalog, mut kept) else:
        return (report, None, 0)
    if not lowered.beyond.is_empty():
        return (report, None, 0)
    var done = borrowck.check_with(lowered.program, True, mut kept.placed)
    simplify.program(mut done.program)
    if done.findings.is_empty():
        _ = interp.evaluate(mut done.program, catalog)
    var source = 0
    let by_source = files_by_source(lowered, files)
    for k in range(len(by_source)):
        if let Some((i, _)) = by_source[k]:
            if i == at:
                source = k
                break
    return (report, Some(done.program), source)

## The loans `explain-borrow` and `query explain` show of `line`: each
## function with a loan live there, and each loan as text (its kind, its
## place, where it starts, its holders, where it ends).
pure def explained(
    p: sir.Program, source: int, line: int, text: str
) -> list[(String, list[ExplainedLoan])]:
    let lines = Lines.of(text)
    var out: list[(String, list[ExplainedLoan])] = []
    for fl in borrowck.live_at(p, source, line):
        if fl.loans.is_empty():
            continue
        var each: list[ExplainedLoan] = []
        for l in fl.loans:
            var place = String.new()
            match l.place:
                case Arg.Text(t):
                    place = t.copy()
                case Arg.Source(loc):
                    let (start, end) = span_of(text, lines, Some(loc))
                    if start <= end and end <= text.byte_len():
                        place = text.byte_slice(start, end).to_string()
            each.push(
                ExplainedLoan(
                    mutable=l.mutable,
                    place=place,
                    start=loc_text(l.start),
                    end=loc_text(l.until),
                    holders=l.holders.copy(),
                )
            )
        out.push((fl.function.copy(), each))
    return out

## A loan as `explain-borrow` shows it.
struct ExplainedLoan:
    mutable: bool
    place: String
    start: String
    end: String
    holders: list[String]

## A position as `LINE:COL`, or empty for none.
pure def loc_text(l: sir.Loc?) -> String:
    let at = l else:
        return String.new()
    return "{at.line}:{at.col}"

## `explain-borrow FILE:LINE` (10, "Language server": the "explain this
## borrow" command; RULES.md, R187): every borrow live on the line, with
## where it starts, who holds it and where it is last used, in the
## driver's words, from the program that holds FILE (its package's, or
## the file's alone); a program with an error of the front end has its
## diagnostics reported as `check` reports them, and fails.
def explain_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> ! {IoError, UsageError, CommandError}:
    var target: (String, int)? = None
    if len(rest) >= 2:
        let a = rest[1].copy()
        var k = a.byte_len() - 1
        while k >= 0:
            if a.byte_at(k) == 58:
                if let Some(n) = a.byte_slice(k + 1, a.byte_len()).parse_int():
                    if n >= 0:
                        target = Some((a.byte_slice(0, k).to_string(), n))
                break
            k -= 1
    let (file, line) = target else:
        o.emit("", catalog.plain_error("cli.explain-borrow-usage", []))
        return Err(Exit(status=2))
    var text = String.new()
    match sys.fs.read_to_string(Path.new(file.copy())):
        case Ok(t):
            text = t
        case Err(e):
            o.emit("", cannot_read(file, e, catalog))
            return Err(Exit(status=1))
    var base = served.base.copy() ?? base_of(sys, home, std_texts(sys, home)?, catalog)
    var env = base.environment()
    let (input, at, _) = query_input(sys, home, file, text, mut env, catalog)?
    let (report, program, source) = owned_program(base, input, at, file, catalog)
    let p = program else:
        var err = String.new()
        if report.has_error:
            err = report.human(catalog)
            let n = Param(name="count".to_string(), value="{report.errors(catalog)}")
            err.push(catalog.plain_error("cli.errors-found", [n]))
        else:
            err = "the program is beyond the slice stage 1 lowers\n".to_string()
        o.emit("", err)
        return Err(Exit(status=1))
    var out = String.new()
    for (function, loans) in explained(p, source, line, text):
        let header = [
            Param(name="line".to_string(), value="{line}"),
            Param(name="file".to_string(), value=file.copy()),
            Param(name="function".to_string(), value=function.copy()),
        ]
        out.push("{catalog.render("cli.explain-borrow-header", header)}\n")
        for l in loans:
            var kind = catalog.render("cli.explain-borrow-shared", [])
            if l.mutable:
                kind = catalog.render("cli.explain-borrow-mut", [])
            var holders: list[String] = []
            for h in l.holders:
                holders.push("`{h}`")
            var id = "cli.explain-borrow-loan"
            if holders.is_empty():
                id = "cli.explain-borrow-temporary"
            let params = [
                Param(name="kind".to_string(), value=kind),
                Param(name="place".to_string(), value=l.place.copy()),
                Param(name="start".to_string(), value=l.start.copy()),
                Param(name="holders".to_string(), value=holders.join(", ")),
                Param(name="end".to_string(), value=l.end.copy()),
            ]
            out.push("  {catalog.render(id, params)}\n")
    if out.is_empty():
        let params = [
            Param(name="line".to_string(), value="{line}"),
            Param(name="file".to_string(), value=file.copy()),
        ]
        out.push("{catalog.render("cli.explain-borrow-none", params)}\n")
    o.emit(out, "")
    return Ok(())

## `query explain FILE LINE` (RULES.md, R187): `explain-borrow`'s loans as
## an answer, one line per loan, `FUNCTION\tKIND\tPLACE\tSTART\tHOLDERS\tEND`,
## KIND `shared` or `mut`, START and END `LINE:COL`, HOLDERS the names
## that hold it separated by `, ` (empty for a temporary); nothing for a
## program with an error of the front end, or a line with no loan.
pure def query_explain(
    base: typeck.Base, input: Input, at: int, file: str, text: str, line: int, catalog: Catalog
) -> String:
    let (_, program, source) = owned_program(base, input, at, file, catalog)
    let p = program else:
        return String.new()
    var out = String.new()
    for (function, loans) in explained(p, source, line, text):
        for l in loans:
            var kind = "shared"
            if l.mutable:
                kind = "mut"
            let fields = [
                query.field(function),
                kind.to_string(),
                query.field(l.place),
                l.start.copy(),
                query.field(l.holders.join(", ")),
                l.end.copy(),
            ]
            out.push("{fields.join("\t")}\n")
    return out

## `audit --ownership FILE...` and `audit --caps [FILE...]` (18, Phase 3,
## T1.1 and T1.2; RULES.md, R188), as the driver's `audit` takes them:
## an option it does not know is `D0009`, none or both `D0022`, both with
## status 2; `--ownership` without a file `D0004`.
def audit_counts(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out
) -> ! {IoError, UsageError, CommandError}:
    var flags: list[String] = []
    var files: list[String] = []
    for k in range(1, len(rest)):
        if rest[k].starts_with("--"):
            flags.push(rest[k].copy())
        else:
            files.push(rest[k].copy())
    for f in flags:
        if f != "--ownership" and f != "--caps":
            let params = [
                Param(name="option".to_string(), value=f.copy()),
                Param(name="command".to_string(), value="audit".to_string()),
            ]
            o.emit("", catalog.plain_error("cli.unknown-option", params))
            return Err(Exit(status=2))
    if len(flags) != 1:
        o.emit("", catalog.plain_error("cli.audit-usage", []))
        return Err(Exit(status=2))
    if flags[0] == "--caps":
        return audit_caps(sys, home, files, catalog, mut o)
    if files.is_empty():
        let params = [Param(name="command".to_string(), value="audit".to_string())]
        o.emit("", catalog.plain_error("cli.missing-file", params))
        return Err(Exit(status=2))
    var out = String.new()
    for file in files:
        match sys.fs.read_to_string(Path.new(file.copy())):
            case Ok(text):
                out.push("{ownership_line(file, text)}\n")
            case Err(e):
                o.emit(out, cannot_read(file, e, catalog))
                return Err(Exit(status=1))
    o.emit(out, "")
    return Ok(())

## `audit --caps [FILE...]`: each program checked and lowered, then its
## capability audit, read from its SIR; without a file the package of the
## working directory, each member of a workspace's in turn, named by its
## directory (decision 429); a program with an error has its errors
## reported, and fails.
def audit_caps(
    sys: System, home: str, files: list[String], catalog: Catalog, mut o: Out
) -> ! {IoError, UsageError, CommandError}:
    let base = base_of(sys, home, std_texts(sys, home)?, catalog)
    var env = base.environment()
    var inputs: list[(String, Input)] = []
    if files.is_empty():
        var direct = Out.direct()
        let found = nearest_package(sys, "audit", catalog, mut direct) else:
            return Err(Failed)
        let cwd = absolute(sys, ".")
        for layout in layouts_of(sys, found, False, build_request(sys)) ?? []:
            if layout.modules.is_empty():
                continue
            var shown = layout.modules[0].name.copy()
            if let Some(p) = layout.packages.first():
                if not p.name.is_empty():
                    shown = package.relative(cwd, p.dir)
                    if shown.is_empty():
                        shown = ".".to_string()
            inputs.push((shown, layout_input(sys, home, layout, True, mut env, catalog)?))
    else:
        for f in files:
            match sys.fs.read_to_string(Path.new(f.copy())):
                case Ok(text):
                    inputs.push((f.copy(), file_input(sys, home, f, text, True, mut env, catalog)?))
                case Err(e):
                    o.emit("", cannot_read(f, e, catalog))
                    return Err(Exit(status=1))
    var out = String.new()
    for (shown, input) in inputs:
        if True:
            var kept = Kept.new()
            let (report, done) = report_program(base, input, shown, catalog, mut kept)
            let d = done else:
                var errors = report.front(catalog, Some(True))
                var all: list[Filed] = []
                for x in report.diags:
                    if catalog.is_error(x.diag.msg):
                        all.push(x.copy())
                errors.diags = all
                var err = errors.human(catalog)
                if not report.has_error:
                    err = "the program is beyond the slice stage 1 lowers\n".to_string()
                else:
                    let n = Param(name="count".to_string(), value="{len(errors.diags)}")
                    err.push(catalog.plain_error("cli.errors-found", [n]))
                o.emit(out, err)
                return Err(Exit(status=1))
            out.push(caps_report(shown, d.program, own_structs(base, input, catalog)))
    o.emit(out, "")
    return Ok(())

## The structs the program declares, by their SIR names (std's and the
## dependencies' are not the program's design), for `audit --caps`.
pure def own_structs(base: typeck.Base, input: Input, catalog: Catalog) -> list[String]:
    var out: list[String] = []
    let checked = check_input(base, input, catalog, False)
    let typed = checked.typed else:
        return out
    let prog = ref typed.prog
    for i in range(len(prog.defs)):
        if let DefKind.Struct(_) = prog.defs[i].kind():
            let m = prog.defs[i].module
            if m.index < len(prog.modules):
                if prog.package_of(m) == ROOT_PACKAGE:
                    out.push(prog.qualified_name(DefId(index=i)))
    return out

## Whether a line of `check --format=ids` is one of the rules of unsafe
## code (22): an `unsafe.` lint or error, a package's level, the root's
## consent, unsafe code that compile-time evaluation wrote.
pure def is_unsafe_rule(line: str) -> bool:
    return line.contains(" unsafe.")
        or line.contains(" package.unsafe-")
        or line.contains(" cap.untrusted ")
        or line.contains(" comptime.unsafe-written")

## The root manifest of a layout, its name and text, for the lines of its
## `[trust]`.
pure def audit_root_manifest(layout: Layout) -> (String, String)?:
    let p = layout.packages.first() else:
        return None
    let k = p.manifest else:
        return None
    if k < len(layout.files):
        return Some(layout.files[k].copy())
    return None

## Where the root manifest's `[trust] unsafe` names the package `name`:
## `sisu.toml:14`.
pure def trust_line(manifest: (String, String)?, name: str) -> String:
    let (file, text) = manifest.copy() else:
        return "`[trust] unsafe`".to_string()
    let (read, _) = manifest_read(text)
    let m = read else:
        return file
    for (n, at) in m.trust_unsafe:
        if n == name:
            var line = 1
            for i in range(min(at.start, text.byte_len())):
                if text.byte_at(i) == 10:
                    line += 1
            return "{file}:{line}"
    return file

## The type checker's verdict on a program.
pure def check_input(
    base: typeck.Base, input: Input, catalog: Catalog, keep: bool
) -> typeck.Checked:
    return typeck.check_program(
        base,
        input.modules,
        input.packages,
        catalog,
        input.named,
        input.name_errors,
        input.embedded,
        keep,
        input.multi,
        input.tests,
        input.features,
        input.std_tests,
    )

## The type diagnostics of a program, with the ownership checker's `type.`
## messages when a body may get one: stage 0 reports them with the type
## checker's when the front end finds no error.
pure def types_of(
    base: typeck.Base, input: Input, catalog: Catalog, mut kept: Kept
) -> typeck.Checked:
    let checked = check_input(base, input, catalog, False)
    if checked.owner_beyond.is_empty() or checked.has_error:
        return checked
    for b in checked.beyond:
        if not checked.owner_beyond.contains(b):
            return checked
    let per_file = ownership_types(base, input, catalog, mut kept) else:
        return checked
    var done = checked
    for k in range(len(per_file)):
        for d in per_file[k]:
            if k == 0:
                done.diagnostics.push(d.copy())
            elif k - 1 < len(done.files):
                done.files[k - 1].1.push(d.copy())
    sort_unique(mut done.diagnostics, catalog)
    for k in range(len(done.files)):
        sort_unique(mut done.files[k].1, catalog)
    done.beyond = []
    done.owner_beyond = []
    return done

## The ownership checker's `type.` messages for a program, each file's;
## `None` when lowering leaves part of the program out or a finding is in
## a file that is not the program's.
pure def ownership_types(
    base: typeck.Base, input: Input, catalog: Catalog, mut kept: Kept
) -> list[list[Diagnostic]]?:
    let checked = check_input(base, input, catalog, True)
    let files = program_files(input, checked)
    let lowered = lower_of(checked, base, input, catalog, mut kept) else:
        return None
    if not lowered.beyond.is_empty():
        return None
    let done = borrowck.check_with(lowered.program, True, mut kept.placed)
    let by_source = files_by_source(lowered, files)
    let per_file = borrowck.diagnostics_by_file(done.findings, by_source, len(files), catalog) else:
        return None
    var out: list[list[Diagnostic]] = []
    for ds in per_file:
        var types: list[Diagnostic] = []
        for d in ds:
            if d.msg.id().starts_with("type."):
                types.push(d.copy())
        out.push(types)
    return Some(out)

## The program's files, for the ownership checker's diagnostics.
pure def program_files(input: Input, checked: typeck.Checked) -> list[ProgramFile]:
    var files: list[ProgramFile] = []
    if let Some(typed) = checked.typed:
        for i in range(len(input.modules)):
            if i < len(typed.prog.user_modules):
                let m = typed.prog.user_modules[i]
                var name = String.new()
                if input.multi:
                    name = input.modules[i].file.copy()
                files.push(ProgramFile(module=m, name=name, text=input.modules[i].text.copy()))
    return files

## For each source of the SIR, the file of the program it is, with the
## file's text.
pure def files_by_source(lowered: lower.Lowered, files: list[ProgramFile]) -> list[(int, String)?]:
    var by_source: list[(int, String)?] = []
    for m in lowered.source_modules:
        var found: (int, String)? = None
        for k in range(len(files)):
            if files[k].module == m and found.is_none():
                found = Some((k, files[k].text.copy()))
        by_source.push(found)
    return by_source

## What stage 1 makes of the program `arg` names for `sisu sir` and the
## ownership checker, adding where the time went to `times`: with `sir`,
## the contracts lowering checks, the SIR of the program built without its
## tests, as `sisu sir` builds it (decision 243), for a workspace of its one
## application; with `ownership`, the ownership diagnostics of the program
## built with them, every member's for a workspace, as `sisu check` checks
## each member. A program that a build without its tests compiles as it is
## goes through the pipeline once for both, when the SIR checks every
## contract. Built with its tests (`tests`), a program with an error of a
## phase has no SIR (`Lowering.refused`; RULES.md, R46).
def lowering_of(
    sys: System,
    home: str,
    arg: str,
    base: typeck.Base,
    mut env: Environment,
    catalog: Catalog,
    mut times: SirTimes,
    partial: bool,
    sir: int?,
    ownership: bool,
    tests: bool,
    request: FeatureRequest,
    mut kept: Kept,
) -> Lowering ! IoError:
    var done = Lowering(
        sir=String.new(), ownership=String.new(), beyond=[], entry=False, refused=False
    )
    var checks: list[Input] = []
    if ownership:
        checks = inputs_of(sys, home, arg, False, True, build_request(sys), mut env, catalog)?
    let level = sir ?? CONTRACTS_ALL
    var sir_done = sir.is_none()
    for input in checks:
        let one = sir_of(sys, base, input, catalog, mut times, partial, mut kept)
        done.ownership.push(one.ownership)
        for b in one.beyond:
            done.beyond.push(b.copy())
        let same = (tests or not differs_without_tests(input)) and level == CONTRACTS_ALL
        if not sir_done and len(checks) == 1 and same:
            done.sir = one.sir.copy()
            done.entry = one.entry
            done.refused = one.refused
            sir_done = True
    if not sir_done:
        # The program built without its tests, or with them: a file's, a
        # package's, or a workspace's one application.
        if let Some(input) = app_input(sys, home, arg, tests, request, mut env, catalog)?:
            var built = input.copy()
            built.contracts = level
            let one = sir_of(sys, base, built, catalog, mut times, partial, mut kept)
            done.sir = one.sir.copy()
            done.entry = one.entry
            done.refused = one.refused
            for b in one.beyond:
                if not done.beyond.contains(b):
                    done.beyond.push(b.copy())
    if tests and done.refused and not partial:
        done.sir = String.new()
    return Ok(done)

## The program `sir` builds of what `arg` names, with its tests or without
## them: a file's, a package's, or a workspace's one application.
def app_input(
    sys: System,
    home: str,
    arg: str,
    tests: bool,
    request: FeatureRequest,
    mut env: Environment,
    catalog: Catalog,
) -> Input? ! IoError:
    if let Some(layouts) = layouts_of(sys, arg, True, request):
        if len(layouts) == 1 and not layouts[0].modules.is_empty():
            return Ok(Some(layout_input(sys, home, layouts[0], tests, mut env, catalog)?))
        return Ok(None)
    let built = inputs_of(sys, home, arg, False, tests, request, mut env, catalog)?
    if let Some(x) = built.first():
        return Ok(Some(x.copy()))
    return Ok(None)

## Whether a build without its tests may compile the program otherwise than
## one with them (decision 243): a module of it has a `@cfg`, or an item
## that is a test, a suite or a benchmark, or a doc example (a fence of
## three backquotes), which the text shows where the item begins.
pure def differs_without_tests(input: Input) -> bool:
    for m in input.modules:
        let text: str = m.text
        if text.contains("@cfg") or text.contains("```"):
            return True
        for line in text.lines():
            let t = line.trim_start()
            if t.starts_with("test") or t.starts_with("suite") or t.starts_with("bench"):
                return True
    return False

## The pipeline for one program, a step at a time, timed.
def sir_of(
    sys: System,
    base: typeck.Base,
    input: Input,
    catalog: Catalog,
    mut times: SirTimes,
    partial: bool,
    mut kept: Kept,
) -> Lowering:
    let t0 = now(sys)
    let checked = check_input(base, input, catalog, True)
    let t1 = now(sys)
    times.check += t1 - t0
    if let Some(done) = front_of(checked):
        return done
    # The program's files, for the ownership checker's diagnostics.
    let files = program_files(input, checked)
    let lowered = lower_of(checked, base, input, catalog, mut kept) else:
        return Lowering(
            sir=String.new(),
            ownership=String.new(),
            beyond=["nothing to lower".to_string()],
            entry=False,
            refused=False,
        )
    let t2 = now(sys)
    times.lower += t2 - t1
    let done = finish_of(lowered, files, catalog, partial, mut kept.placed)
    times.ownership += now(sys) - t2
    return done

## A file of the program, for the ownership checker's diagnostics: its
## module, its name (empty in a program of one file) and its text.
struct ProgramFile:
    module: ModuleId
    name: String
    text: String

## Lowering's part, for a program the front end checked whole, with the
## contracts the input's build checks, the functions it keeps besides what
## its entry and tests reach, and its runtime profile when that is not
## `full` (RULES.md, R120 and R122).
pure def lower_of(
    own checked: typeck.Checked, base: typeck.Base, input: Input, catalog: Catalog, mut kept: Kept
) -> lower.Lowered?:
    let typed = checked.typed else:
        return None
    var lowered = lower.lower(
        typed,
        base,
        input.modules[0].file,
        input.contracts,
        catalog,
        mut kept.bodies,
        mut kept.lowered,
        mut kept.slots,
        input.roots,
    )
    if input.runtime != "full":
        lowered.program.runtime = Some(input.runtime.copy())
    return Some(lowered)

## The world of transcripts (`transcript_world`, `transcript_system`),
## which `sir --tests` of a program keeps when it has transcripts: a
## `.transcript` file in the directory `tests/` beside its root module's
## file `disk`, as the driver finds them (17; decision 687; RULES.md, R120).
def transcript_roots(sys: System, disk: str, tests: bool) -> list[String]:
    if not tests:
        return []
    let entries = sys.fs.list_dir(Path.new("{parent(disk)}/tests")) else:
        return []
    for p in entries:
        if "{p}".ends_with(".transcript"):
            return ["transcript_world".to_string(), "transcript_system".to_string()]
    return []

## What `sir_of` gives when the front end ends it: beyond the type
## checker's slice, or a front-end error.
pure def front_of(checked: typeck.Checked) -> Lowering?:
    # A body that may get one of the ownership checker's `type.` messages
    # is typed whole: the ownership checker here decides them.
    var why: list[String] = []
    for b in checked.beyond:
        if not checked.owner_beyond.contains(b):
            why.push("beyond the type checker's slice: {b}")
    if not why.is_empty():
        return Some(
            Lowering(
                sir=String.new(), ownership=String.new(), beyond=why, entry=False, refused=False
            )
        )
    # `sisu sir` prints nothing for a program with a front-end error, and
    # the ownership checker does not run.
    if checked.has_error:
        return Some(
            Lowering(sir=String.new(), ownership=String.new(), beyond=[], entry=False, refused=True)
        )
    if checked.typed.is_none():
        return Some(
            Lowering(
                sir=String.new(),
                ownership=String.new(),
                beyond=["nothing to lower".to_string()],
                entry=False,
                refused=False,
            )
        )
    return None

## The ownership checker's part, and the SIR's text: the diagnostics of
## each of the program's files, in their order, each with its name.
pure def finish_of(
    lowered: lower.Lowered,
    files: list[ProgramFile],
    catalog: Catalog,
    partial: bool,
    mut placed: borrowck.Placed,
) -> Lowering:
    if not lowered.beyond.is_empty() and not partial:
        return Lowering(
            sir=String.new(),
            ownership=String.new(),
            beyond=lowered.beyond.copy(),
            entry=False,
            refused=False,
        )
    # A partial SIR is wanted for its statements: the drops the ownership
    # checker places, not its findings.
    var done = borrowck.check_with(lowered.program, not partial, mut placed)
    simplify.program(mut done.program)
    # The compiler runs the `comptime` expressions of a program the
    # ownership checker accepts (08), and bakes their values into it; one
    # that fails is an error of the program.
    var refused = False
    if done.findings.is_empty():
        let evaluated = interp.evaluate(mut done.program, catalog)
        if not evaluated.beyond.is_empty() and not partial:
            var reasons = lowered.beyond.copy()
            for why in evaluated.beyond:
                reasons.push(why.copy())
            return Lowering(
                sir=String.new(), ownership=String.new(), beyond=reasons, entry=False, refused=False
            )
        refused = not evaluated.errors.is_empty()
    # Each typed hole prints its closure where a run reaches it (RULES.md,
    # R27), once the checker is done with the program.
    let hole = Param(name="hole".to_string(), value="{{hole}}".to_string())
    holes.close(mut done.program, catalog.render("panic.hole-closure", [hole]))
    let by_source = files_by_source(lowered, files)
    let elsewhere = "an ownership finding in a file of the standard library or one the compiler wrote"
    let per_file = borrowck.diagnostics_by_file(done.findings, by_source, len(files), catalog) else:
        var reasons = lowered.beyond.copy()
        reasons.push(elsewhere.to_string())
        var sir = String.new()
        if partial:
            sir = write.write(done.program)
        return Lowering(sir=sir, ownership=String.new(), beyond=reasons, entry=False, refused=False)
    var out = String.new()
    for k in range(len(files)):
        out.push(render_ids_in(files[k].name, files[k].text, per_file[k], catalog))
        for d in per_file[k]:
            if catalog.is_error(d.msg):
                refused = True
    let entry = done.program.entry.is_some()
    let text = write.write(done.program)
    return Lowering(
        sir=text, ownership=out, beyond=lowered.beyond.copy(), entry=entry, refused=refused
    )

## What `check` prints of a program (stage 0's `Db::diagnostics`): every
## diagnostic of each of its files, the front end's and, when it found no
## error, the ownership checker's, in stage 0's order of files (the
## modules', the root module's first, then the manifests', then those the
## compiler wrote), each file with its name and text; whether it is a
## program of several files, whose positions name their file; and why the
## diagnostics are not all of stage 0's, when stage 1 knows that.
struct Report:
    files: list[(String, String)]
    diags: list[Filed]
    multi: bool
    beyond: list[String]
    ## Those of `diags` that are the ownership checker's, which `build`
    ## reports apart.
    owned: list[Filed]
    ## Those of `diags` that are failed `comptime` expressions', which
    ## `build` reports apart too.
    failed: list[Filed]
    ## Whether the program has an error, as far as stage 1 knows: one it
    ## renders, or one of stage 0's that it only notes.
    has_error: bool
    ## The lints of `sisu lint` (RULES.md, R11), which `check` does not
    ## print.
    lints: list[Filed]
    ## How many of `files` are the root package's own modules, the first
    ## (at least one), which `check --diary` hashes (RULES.md, R186).
    ours: int

impl Report:
    ## The number of errors among the diagnostics.
    pure def errors(self, catalog: Catalog) -> int:
        var n = 0
        for x in self.diags:
            if catalog.is_error(x.diag.msg):
                n += 1
        return n

    ## The conformance form, as `sisu check --format=ids` prints it.
    pure def ids(self, catalog: Catalog) -> String:
        return render_ids_files(self.files, self.diags, self.multi, catalog)

    ## The human form, as `sisu check` prints it.
    pure def human(self, catalog: Catalog) -> String:
        return render_human_files(self.files, self.diags, catalog)

    ## The report of the front end's diagnostics only: all of them, or
    ## with `errors` the errors among them or the others.
    pure def front(self, catalog: Catalog, errors: bool?) -> Report:
        var kept: list[Filed] = []
        for x in self.diags:
            if self.owned.contains(x) or self.failed.contains(x):
                continue
            if let Some(e) = errors:
                if catalog.is_error(x.diag.msg) != e:
                    continue
            kept.push(x.copy())
        var r = self.copy()
        r.diags = kept
        return r

    ## The report of the ownership checker's diagnostics only.
    pure def ownership(self) -> Report:
        var r = self.copy()
        r.diags = self.owned.copy()
        return r

    ## The report of the failed `comptime` expressions only.
    pure def evaluation(self) -> Report:
        var r = self.copy()
        r.diags = self.failed.copy()
        return r

## The reports of the programs `arg` names, a program of one file named
## `name` in its diagnostics: a file's, or each layout's, where a layout
## without modules has its manifests' problems only, as stage 0 reports
## them.
def reports_of(
    sys: System,
    home: str,
    arg: str,
    name: str,
    tests: bool,
    request: FeatureRequest,
    base: typeck.Base,
    mut env: Environment,
    catalog: Catalog,
    mut kept: Kept,
) -> list[Report] ! IoError:
    var out: list[Report] = []
    let layouts = layouts_of(sys, arg, False, request) else:
        for input in inputs_of(sys, home, arg, False, tests, request, mut env, catalog)?:
            out.push(report_of(base, input, name, catalog, mut kept))
        return Ok(out)
    for layout in layouts:
        if layout.modules.is_empty():
            out.push(problems_report(layout, catalog))
            continue
        let input = layout_input(sys, home, layout, tests, mut env, catalog)?
        out.push(report_of(base, input, name, catalog, mut kept))
    return Ok(out)

## The report of a layout without a module to check: its manifests'
## problems, each in its file, sorted (stage 0's `input_with_root`).
pure def problems_report(layout: Layout, catalog: Catalog) -> Report:
    var diags: list[Filed] = []
    for p in layout.problems:
        diags.push(Filed(file=p.file, diag=p.diag.copy(), label_files=p.label_files.copy()))
    sort_filed(mut diags, catalog, False)
    var has_error = False
    for x in diags:
        if catalog.is_error(x.diag.msg):
            has_error = True
    return Report(
        files=layout.files.copy(),
        diags=diags,
        multi=True,
        beyond=[],
        owned=[],
        failed=[],
        has_error=has_error,
        lints=[],
        ours=0,
    )

## What `check` makes of one program (stage 0's `Db::checked` and
## `Db::diagnostics`): the syntax diagnostics of each module, the
## manifests' problems, `cap.untrusted`, the name diagnostics and the type
## checker's, sorted; then, when they hold no error, the ownership
## checker's, each finding in its file, with the methods that consume a
## must-consume value named in a note.
pure def report_of(
    base: typeck.Base, input: Input, name: str, catalog: Catalog, mut kept: Kept
) -> Report:
    let (r, _) = report_with(base, input, name, catalog, mut kept, False, False)
    return r

## `report_of`'s report, and with `sir` the SIR of the program it checked
## when it has no error and is within the slice (empty otherwise): the
## program after the ownership checker's drops, its `comptime` values and
## its holes' closures, as `sir` prints it, from the one check (RULES.md,
## R47), with each test's module when `modules` is set (R142).
pure def report_with(
    base: typeck.Base,
    input: Input,
    name: str,
    catalog: Catalog,
    mut kept: Kept,
    sir: bool,
    modules: bool,
) -> (Report, String):
    let (report, evaluated) = report_program(base, input, name, catalog, mut kept)
    var text = String.new()
    if not sir:
        return (report, text)
    let ready = evaluated else:
        return (report, text)
    var done = ready
    # Each typed hole prints its closure where a run reaches it
    # (RULES.md, R27), once the checker is done with the program.
    let hole = Param(name="hole".to_string(), value="{{hole}}".to_string())
    holes.close(mut done.program, catalog.render("panic.hole-closure", [hole]))
    if not input.regions.is_empty():
        session.name_regions(mut done.program, input.regions)
    text = write.write_as(done.program, modules)
    return (report, text)

## `report_of`'s report, and the program it checked, its `comptime` values
## evaluated, when it has no error and is within the slice (`eval`,
## RULES.md, R165; `report_with`'s SIR).
pure def report_program(
    base: typeck.Base, input: Input, name: str, catalog: Catalog, mut kept: Kept
) -> (Report, borrowck.Checked?):
    let checked = check_input(base, input, catalog, True)
    var report = front_report(input, checked, name, catalog)
    if report.has_error:
        return (report, None)
    # The ownership checker runs when the front end found no error.
    let program = program_files(input, checked)
    var consuming: dict[String, String] = {}
    var constants: list[Constant] = []
    if let Some(typed) = checked.typed:
        consuming = consuming_methods(typed.prog)
        constants = constants_of(typed.prog, input, catalog)
    let lowered = lower_of(checked, base, input, catalog, mut kept) else:
        return (report, None)
    if not lowered.beyond.is_empty():
        for b in lowered.beyond:
            report.beyond.push("beyond the slice of lowering: {b}")
        return (report, None)
    var done = borrowck.check_with(lowered.program, True, mut kept.placed)
    let by_source = files_by_source(lowered, program)
    match borrowck.diagnostics_by_file(done.findings, by_source, len(program), catalog):
        case Some(per_file):
            for k in range(len(per_file)):
                for d in per_file[k]:
                    let with_note = consume_note(d, consuming)
                    report.owned.push(Filed(file=k, diag=with_note, label_files=[]))
        case None:
            report.beyond.push(
                "an ownership finding in a file of the standard library or one the compiler wrote"
            )
    # The compiler runs the `comptime` expressions of a program the
    # ownership checker accepts (08); one that fails is an error at it.
    var evaluated_all = False
    if done.findings.is_empty():
        simplify.program(mut done.program)
        let evaluated = interp.evaluate(mut done.program, catalog)
        evaluated_all = evaluated.beyond.is_empty()
        for why in evaluated.beyond:
            report.beyond.push(why.copy())
        for e in evaluated.errors:
            match comptime_diagnostic(e, done.program, by_source):
                case Some((k, d)):
                    report.failed.push(Filed(file=k, diag=d, label_files=[]))
                case None:
                    let why = "a failed `comptime` expression in a file of the standard library or one the compiler wrote"
                    if not report.beyond.contains(why.to_string()):
                        report.beyond.push(why.to_string())
        # A constant's value is computed at compile time (RULES.md, R178):
        # each `const` of the program's modules evaluated as `eval`
        # evaluates it, one that fails an error at its name.
        if evaluated.errors.is_empty():
            for (k, d) in const_failures(done.program, constants, catalog):
                report.failed.push(Filed(file=k, diag=d.copy(), label_files=[]))
    sort_filed(mut report.owned, catalog, True)
    sort_filed(mut report.failed, catalog, True)
    for x in report.owned:
        report.diags.push(x.copy())
        if catalog.is_error(x.diag.msg):
            report.has_error = True
    for x in report.failed:
        report.diags.push(x.copy())
        if catalog.is_error(x.diag.msg):
            report.has_error = True
    sort_filed(mut report.diags, catalog, True)
    if evaluated_all and not report.has_error and report.beyond.is_empty():
        return (report, Some(done))
    return (report, None)

## What `--defer-borrow` makes of a program (RULES.md, R189): its SIR when
## its only errors are the ownership rules' (the front end's `E04` codes
## and the ownership checker's findings but purity's and a second
## assignment of a `let`), which the SIR is written despite; the report of
## every diagnostic, and the errors that stop it otherwise.
struct Deferred:
    ## The SIR, empty when an error stops it.
    sir: String
    ## Every diagnostic of the program, the deferred errors among them.
    report: Report
    ## The errors that stop it, and the message that ends their report.
    stopping: Report
    stopped: String
    ## Whether an error was deferred.
    deferred: bool
    ## Whether the SIR has an entry, a `main` to run.
    entry: bool

## The purity rules and a `let` assigned twice, which the monitor does not
## observe, so that `--defer-borrow` does not defer them.
pure def not_deferred(id: str) -> bool:
    return id == "type.impure-call"
        or id == "type.impure-value-call"
        or id == "type.impure-drop"
        or id == "type.reassign-let"

## `--defer-borrow` (stage 0's counterexample mode): the program checked,
## and lowered and through the ownership checker despite the errors of
## the ownership rules, as stage 0's `run --defer-borrow` lowers it.
pure def deferred_program(
    base: typeck.Base, input: Input, name: str, catalog: Catalog, mut kept: Kept, modules: bool
) -> Deferred:
    let checked = check_input(base, input, catalog, True)
    var report = front_report(input, checked, name, catalog)
    var out = Deferred(
        sir=String.new(),
        report=report.copy(),
        stopping=report.copy(),
        stopped="cli.errors-found".to_string(),
        deferred=False,
        entry=False,
    )
    # The front end's errors but the ownership rules' stop it.
    var stopping: list[Filed] = []
    for x in report.diags:
        if catalog.is_error(x.diag.msg):
            if catalog.code(x.diag.msg).starts_with("E04"):
                out.deferred = True
            else:
                stopping.push(x.copy())
    if not stopping.is_empty() or not report.beyond.is_empty():
        out.stopping.diags = stopping
        return out
    if checked.typed.is_none():
        out.stopping.diags = []
        return out
    let program = program_files(input, checked)
    var consuming: dict[String, String] = {}
    if let Some(typed) = checked.typed:
        consuming = consuming_methods(typed.prog)
    let lowered = lower_of(checked, base, input, catalog, mut kept) else:
        out.stopping.diags = []
        return out
    if not lowered.beyond.is_empty():
        for b in lowered.beyond:
            out.stopping.beyond.push("beyond the slice of lowering: {b}")
        out.stopping.diags = []
        return out
    var done = borrowck.check_with(lowered.program, True, mut kept.placed)
    let by_source = files_by_source(lowered, program)
    var owned: list[Filed] = []
    match borrowck.diagnostics_by_file(done.findings, by_source, len(program), catalog):
        case Some(per_file):
            for k in range(len(per_file)):
                for d in per_file[k]:
                    owned.push(Filed(file=k, diag=consume_note(d, consuming), label_files=[]))
        case None:
            out.stopping.beyond.push(
                "an ownership finding in a file of the standard library or one the compiler wrote"
            )
            out.stopping.diags = []
            return out
    sort_filed(mut owned, catalog, True)
    var impure: list[Filed] = []
    for x in owned:
        if catalog.is_error(x.diag.msg):
            if not_deferred(x.diag.msg.id()):
                impure.push(x.copy())
            else:
                out.deferred = True
        report.diags.push(x.copy())
    sort_filed(mut report.diags, catalog, True)
    out.report = report.copy()
    if not impure.is_empty():
        out.stopping.diags = impure
        return out
    simplify.program(mut done.program)
    if done.findings.is_empty():
        let evaluated = interp.evaluate(mut done.program, catalog)
        if not evaluated.beyond.is_empty():
            for why in evaluated.beyond:
                out.stopping.beyond.push(why.copy())
            out.stopping.diags = []
            return out
        var failed: list[Filed] = []
        for e in evaluated.errors:
            if let Some((k, d)) = comptime_diagnostic(e, done.program, by_source):
                failed.push(Filed(file=k, diag=d, label_files=[]))
        if not evaluated.errors.is_empty():
            out.stopping.diags = failed
            return out
    let hole = Param(name="hole".to_string(), value="{{hole}}".to_string())
    holes.close(mut done.program, catalog.render("panic.hole-closure", [hole]))
    if not input.regions.is_empty():
        session.name_regions(mut done.program, input.regions)
    out.sir = write.write_as(done.program, modules)
    out.entry = done.program.entry.is_some()
    out.stopping.diags = []
    return out

## What `--defer-borrow` prints: the SIR on standard output and every
## diagnostic in the conformance form on standard error, with status 3
## when an error was deferred and 0 when the program has none; or the
## errors that stop it, in the form `ids` asks for, with status 1 and no
## SIR (RULES.md, R189).
pure def deferred_answer(d: Deferred, catalog: Catalog, ids: bool) -> (String, String, int):
    if d.sir.is_empty():
        var errs = shown_report(d.stopping, catalog, ids)
        let n = d.stopping.errors(catalog)
        if n > 0:
            let count = Param(name="count".to_string(), value="{n}")
            errs.push(catalog.plain_error(d.stopped, [count]))
        for b in d.stopping.beyond:
            errs.push("beyond the slice: {b}\n")
        return (String.new(), errs, 1)
    var status = 0
    if d.deferred:
        status = 3
    return (d.sir.copy(), d.report.ids(catalog), status)

## A `const` item of the program's own modules (RULES.md, R178): its
## module's index among the input's, its function's name in SIR, its name
## and where it is written, and its budget of steps.
struct Constant:
    file: int
    function: String
    name: String
    start: int
    end: int
    budget: int

## Each `const` item of the program's own modules, not the standard
## library's, in the order of the modules and of their text.
pure def constants_of(typed: Program, input: Input, catalog: Catalog) -> list[Constant]:
    var out: list[Constant] = []
    for i in range(len(input.modules)):
        let m = query_module(typed, input, i)
        if i > 0 and m == typed.root:
            continue
        if typed.modules[m.index].is_std:
            continue
        var prefix = String.new()
        if m != typed.root:
            prefix = "{typed.modules[m.index].name}."
        for (name, start, end) in config.constants(input.modules[i].text, catalog):
            var budget = DEFAULT_COMPTIME_BUDGET
            if let Some(d) = typed.lookup(m, name):
                budget = typed.comptime_budgets.get(d) ?? budget
            out.push(
                Constant(
                    file=i,
                    function="{prefix}{name}",
                    name=name.copy(),
                    start=start,
                    end=end,
                    budget=budget,
                )
            )
    return out

## Each of `constants` whose evaluation at compile time fails, with the
## error at its name (RULES.md, R178): a panic, a failed invariant or
## contract among them, is `E0602`, a refinement its value does not meet
## `E0810`, the budget spent `E0603` (`@comptime_budget` on the constant
## raises it), the world used `E0601`. A constant that reaches a typed
## hole, or what the evaluator does not run, is left to the run, which
## computes every constant as before.
pure def const_failures(
    prog: sir.Program, constants: list[Constant], catalog: Catalog
) -> list[(int, Diagnostic)]:
    var out: list[(int, Diagnostic)] = []
    for c in constants:
        let (i, start, end) = (c.file, c.start, c.end)
        let Err(stop) = interp.value_of(prog, c.function, c.budget, catalog) else:
            continue
        match stop:
            case interp.Stop.Panicked(message):
                let d = Diagnostic.new(Msg.ComptimePanicked, start, end)
                out.push((i, d.with("message", message)))
            case interp.Stop.Refinement(ty, value, predicate):
                let d = Diagnostic.new(Msg.RefineNotSatisfied, start, end)
                out.push((i, d.with("value", value).with("ty", ty).with("predicate", predicate)))
            case interp.Stop.Budget:
                let d = Diagnostic.new(Msg.ComptimeBudget, start, end).with("item", c.name)
                out.push((i, d.with("steps", "{c.budget}")))
            case interp.Stop.World(what):
                out.push((i, Diagnostic.new(Msg.ComptimeIo, start, end).with("what", what)))
            case _:
                pass
    return out

## The front end's part of what `check` prints of a checked program
## (stage 0's `Db::checked`): the syntax diagnostics of each module, the
## manifests' problems, `cap.untrusted`, the name diagnostics and the type
## checker's, sorted, and whether they hold an error, with why they are
## not all of stage 0's when stage 1 knows that.
pure def front_report(input: Input, checked: typeck.Checked, name: str, catalog: Catalog) -> Report:
    let n = len(input.modules)
    var files: list[(String, String)] = []
    for i in range(n):
        var file = input.modules[i].file.copy()
        if not input.multi:
            file = name.to_string()
        files.push((file, input.modules[i].text.copy()))
    for m in input.manifests:
        files.push(m.copy())
    # The files the compiler wrote follow the manifests.
    let written = len(files)
    for k in range(len(checked.files)):
        if k >= n - 1:
            var file = String.new()
            if k < len(checked.file_names):
                file = checked.file_names[k].copy()
            # The doc examples of a module keep its file's name, as the
            # report names it.
            for i in range(n):
                if file == input.modules[i].file:
                    file = files[i].0.copy()
            files.push((file, checked.files[k].0.copy()))
    var diags: list[Filed] = []
    for i in range(min(n, len(input.syntax))):
        for d in input.syntax[i]:
            diags.push(Filed(file=i, diag=d.copy(), label_files=[]))
    for p in input.problems:
        var label_files: list[int] = []
        for f in p.label_files:
            label_files.push(n + f)
        diags.push(Filed(file=n + p.file, diag=p.diag.copy(), label_files=label_files))
    for (i, d) in input.untrusted:
        diags.push(Filed(file=i, diag=d.copy(), label_files=[]))
    for i in range(min(n, len(input.cfg))):
        for d in input.cfg[i]:
            diags.push(Filed(file=i, diag=d.copy(), label_files=[]))
    # What the name pass finds in a template's body stage 0 reports in its
    # instances, which the type checker checks.
    for i in range(min(n, len(input.names))):
        for d in input.names[i]:
            if not typeck.in_template(checked.template_bodies, i, d.start):
                diags.push(Filed(file=i, diag=d.copy(), label_files=[]))
    for d in checked.diagnostics:
        diags.push(Filed(file=0, diag=d.copy(), label_files=label_files(d, 0, n, written)))
    for k in range(len(checked.files)):
        let file = report_file(k + 1, n, written)
        for d in checked.files[k].1:
            let labelled = label_files(d, file, n, written)
            diags.push(Filed(file=file, diag=d.copy(), label_files=labelled))
    sort_filed(mut diags, catalog, True)
    var beyond: list[String] = []
    for b in checked.beyond:
        if not checked.owner_beyond.contains(b):
            beyond.push("beyond the type checker's slice: {b}")
    var noted: list[String] = []
    for rule in checked.unrendered:
        if not noted.contains(rule):
            noted.push(rule.copy())
    for rule in noted:
        beyond.push("stage 0 reports {rule}, which stage 1 notes without rendering it")
    var lints: list[Filed] = []
    for (k, d) in checked.lints:
        let file = report_file(k, n, written)
        lints.push(Filed(file=file, diag=d.copy(), label_files=label_files(d, file, n, written)))
    sort_filed(mut lints, catalog, True)
    var report = Report(
        files=files,
        diags=diags,
        multi=input.multi,
        beyond=beyond,
        owned=[],
        failed=[],
        has_error=checked.has_error,
        lints=lints,
        ours=max(input.own_modules, 1),
    )
    let errors = report.errors(catalog)
    if errors > 0:
        report.has_error = True
    if errors > 0 or checked.has_error:
        report.has_error = True
        if errors == 0 and noted.is_empty():
            report.beyond.push("an error stage 1 knows of without rendering it")
    return report

## The file of a report a checked file is (`Label.file`): the root
## module's, another of the `n` modules, or, after the manifests, one of
## those the compiler wrote, the first of which is the report's `written`th.
pure def report_file(checked: int, n: int, written: int) -> int:
    if checked <= 0:
        return 0
    let k = checked - 1
    if k < n - 1:
        return k + 1
    return written + k - (n - 1)

## The file of each label of a diagnostic of the report's file `file`: its
## own, or the one its checked file is.
pure def label_files(d: Diagnostic, file: int, n: int, written: int) -> list[int]:
    var out: list[int] = []
    for l in d.labels:
        if l.file < 0:
            out.push(file)
        else:
            out.push(report_file(l.file, n, written))
    return out

## A failed `comptime` expression as a diagnostic at the expression
## (stage 0's `comptime_diagnostic`), with the index of the program's file
## that holds it; `None` when another file does.
pure def comptime_diagnostic(
    e: interp.Error, prog: sir.Program, by_source: list[(int, String)?]
) -> (int, Diagnostic)?:
    let f = prog.function(e.function) else:
        return None
    if f.source >= len(by_source):
        return None
    let (at, text) = by_source[f.source].copy() else:
        return None
    let (start, end) = span_of(text, Lines.of(text), f.loc)
    # The item that holds the expression: `main` for `main#comptime0`.
    var item = e.function.copy()
    if let Some(k) = e.function.find("#comptime"):
        item = e.function.byte_slice(0, k).to_string()
    var d = Diagnostic.new(Msg.ComptimePanicked, start, end)
    match e.failure:
        case interp.Failure.Panicked(m):
            d = d.with("message", m)
        case interp.Failure.Refinement(ty, value, predicate):
            d = Diagnostic.new(Msg.RefineNotSatisfied, start, end)
            d = d.with("value", value).with("ty", ty).with("predicate", predicate)
        case interp.Failure.Budget(n):
            d = Diagnostic.new(Msg.ComptimeBudget, start, end).with("item", item)
            d = d.with("steps", "{n}")
        case interp.Failure.World(what):
            d = Diagnostic.new(Msg.ComptimeIo, start, end).with("what", what)
        case interp.Failure.NotKept(what):
            d = Diagnostic.new(Msg.ComptimeNotKept, start, end).with("what", what)
            # What a result keeps of functions (RULES.md, R160).
            if what.starts_with("a closure"):
                d = d.note(Msg.ComptimeKeptFunctions)
    return Some((at, d))

## For each struct and enum of the program by name (the first of a name),
## its methods that take `own self`, each in backquotes, sorted and joined:
## what the note of a must-consume value that is dropped names.
pure def consuming_methods(prog: Program) -> dict[String, String]:
    var by_def: dict[int, list[String]] = {}
    for ((key, method), d) in prog.methods.items():
        let TyKey.Adt(owner) = key else:
            continue
        let f = prog.fn_info(d) else:
            continue
        if let Some(Mode.Own) = f.self_mode:
            var names: list[String] = []
            if let Some(x) = by_def.get(owner.index):
                names = x.copy()
            names.push("`{method}`")
            _ = by_def.insert(owner.index, names)
    var out: dict[String, String] = {}
    for i in range(len(prog.defs)):
        let def_ = ref prog.defs[i]
        var adt = False
        match def_.kind():
            case DefKind.Struct(_) | DefKind.Enum(_):
                adt = True
            case _:
                pass
        if not adt or out.contains(def_.name.copy()):
            continue
        var names: list[String] = []
        if let Some(x) = by_def.get(i):
            names = x.copy()
        names.sort()
        var joined = String.new()
        for k in range(len(names)):
            if k > 0:
                joined.push(", ")
            joined.push(names[k])
        _ = out.insert(def_.name.copy(), joined)
    return out

## A must-consume value dropped: the note names the methods of its type
## that consume it (stage 0's `consume_note`), which SIR does not keep
## unless they are called.
pure def consume_note(d: Diagnostic, consuming: dict[String, String]) -> Diagnostic:
    if d.msg != Msg.BorrowMustConsume and d.msg != Msg.BorrowMustConsumeExit:
        return d.copy()
    if not d.notes.is_empty():
        return d.copy()
    let ty = d.param("ty") else:
        return d.copy()
    var base = ty.copy()
    if let Some(at) = ty.find("["):
        base = ty.byte_slice(0, at).to_string()
    var methods = String.new()
    if let Some(m) = consuming.get(base):
        methods = m.copy()
    if methods.is_empty():
        return d.copy()
    return d.copy().note_with(Msg.BorrowConsumeWith, "methods", methods)

## `build`: each program the path names (a file's, a package's, or each
## member's of a workspace, in turn, as stage 0's driver builds them; the
## worst outcome decides), after writing the lockfile as stage 0 does
## (09). `level` is the contracts `--contracts` asks for.
def build_command(
    sys: System,
    home: str,
    path: str,
    how: BuildHow,
    lock: (bool, bool),
    level: int?,
    output: String?,
    request: FeatureRequest,
    catalog: Catalog,
    mut o: Out,
    served: Served,
) -> ! {IoError, CommandError}:
    # `--locked`, and `--accept-unsafe` (22).
    let (locked, accept) = lock
    var stopped = "cli.not-compiled"
    if how.for_run:
        stopped = "cli.errors-found"
    if not write_lockfile(sys, path, False, locked, accept, catalog, stopped, mut o)?:
        return Err(Failed)
    var base = served.base.copy() ?? base_of(sys, home, std_texts(sys, home)?, catalog)
    var kept = Kept.new()
    var env = base.environment()
    var programs: list[Input] = []
    var failed = False
    match layouts_of(sys, path, False, request):
        case Some(layouts):
            for layout in layouts:
                if layout.modules.is_empty():
                    # Manifests broken past reading a module: their problems.
                    o.emit("", problems_report(layout, catalog).human(catalog))
                    failed = True
                    continue
                programs.push(layout_input(sys, home, layout, False, mut env, catalog)?)
        case None:
            for input in inputs_of(sys, home, path, False, False, request, mut env, catalog)?:
                programs.push(input.copy())
    # `--emit-sir --defer-borrow`: the SIR of a program whose only errors
    # are the ownership rules', and its diagnostics, for `sisu run
    # --defer-borrow` (RULES.md, R189).
    if how.emit_sir and how.deferring and not failed:
        for input in programs:
            var built = input.copy()
            built.contracts = level ?? CONTRACTS_ALL
            let d = deferred_program(base, built, path, catalog, mut kept, False)
            let (sir, errs, status) = deferred_answer(d, catalog, True)
            var exe = output_for(
                built.disk, built.package_name, built.build_root.copy(), how.release
            )
            if let Some(given) = output:
                exe = given.copy()
            var shown = String.new()
            if d.entry and not sir.is_empty():
                shown = "{EMITTED_EXECUTABLE}{exe}\n{sir}"
            o.emit(shown, errs)
            if status != 0:
                return Err(Exit(status=status))
            return Ok(())
    for input in programs:
        if not build_program(
            sys, home, path, input, how, level, output, base, mut env, catalog, mut kept, mut o
        )?:
            failed = True
    if failed:
        return Err(Failed)
    return Ok(())

## The line before each program's SIR in the answer of `build --emit-sir`
## (RULES.md, R195): a comment of the SIR, which its readers pass by, naming
## the executable the backend would make of it.
pub const EMITTED_EXECUTABLE: str = "# executable "

## What comes before the line of `build --emit-sir` for a program of a
## build that links nothing (a library, without `main`): the line the
## build prints, `built ...`, as a comment of the SIR (RULES.md, R195).
pub const EMITTED_BUILT: str = "# "

## How `build` builds: natively (`--native`), in the release profile
## (`--release`), and for `sisu run` (`--for-run`).
struct BuildHow:
    native: bool
    release: bool
    for_run: bool
    ## The SIR written on standard output rather than built (R170).
    emit_sir: bool
    ## With `emit_sir`, despite the errors of the ownership rules (R189).
    deferring: bool

## A program built as stage 0's `sisu build` builds it, without its tests
## (decision 243): its diagnostics in the human form, and the build stopped
## at the front end's errors (`D0006`), then at a `comptime` expression that
## fails (`D0006`), then at the ownership checker's (`D0021`); then with
## `native` its SIR, lowered with the contracts the build checks (`level`;
## for a release build without one, the root package's `[profile.release]
## contracts`, preconditions by default, 07), written beside the executable
## and built by stage 0's backend, which prints `built PATH`; else, or for
## a program without `main`, the line that says it was built. Whether it
## built. A build that `sisu run` asks for (`how.for_run`) ends at an error
## with the line that says the program was not run, `D0006` or `D0021`;
## any other with `D0132`, that it was not compiled (RULES.md, R57).
def build_program(
    sys: System,
    home: str,
    path: str,
    input: Input,
    how: BuildHow,
    level: int?,
    output: String?,
    base: typeck.Base,
    mut env: Environment,
    catalog: Catalog,
    mut kept: Kept,
    mut o: Out,
) -> bool ! IoError:
    let native = how.native
    let release = how.release
    var stopped = "cli.not-compiled"
    var stopped_owned = "cli.not-compiled"
    if how.for_run:
        stopped = "cli.errors-found"
        stopped_owned = "cli.ownership-errors"
    var built = input.copy()
    built.contracts = level ?? CONTRACTS_ALL
    if release and level.is_none():
        built.contracts = CONTRACTS_PRECONDITIONS
        if let Some(c) = input.release_contracts:
            built.contracts = contract_level(c) ?? CONTRACTS_PRECONDITIONS
    # A program of one file is named as it was given.
    let r = report_of(base, built, path, catalog, mut kept)
    let front = r.front(catalog, None)
    let errors = front.errors(catalog)
    var beyond = String.new()
    for b in r.beyond:
        beyond.push("beyond the slice: {b}\n")
    if errors > 0:
        var errs = front.human(catalog)
        let count = Param(name="count".to_string(), value="{errors}")
        errs.push(catalog.plain_error(stopped, [count]))
        errs.push(beyond)
        o.emit("", errs)
        return Ok(False)
    # A release build rejects typed holes (D-061; RULES.md, R27): each is
    # an error where a debug build warns, and nothing is built.
    let warned = r.front(catalog, Some(False))
    if release:
        let (shipped, holes) = release_report(warned)
        if holes > 0:
            var errs = shipped.human(catalog)
            let count = Param(name="count".to_string(), value="{holes}")
            errs.push(catalog.plain_error(stopped, [count]))
            errs.push(beyond)
            o.emit("", errs)
            return Ok(False)
    o.emit("", warned.human(catalog))
    # A `comptime` expression that failed is an error of the program.
    let evaluation = r.evaluation()
    let failed = evaluation.errors(catalog)
    if failed > 0:
        var errs = evaluation.human(catalog)
        let count = Param(name="count".to_string(), value="{failed}")
        errs.push(catalog.plain_error(stopped, [count]))
        errs.push(beyond)
        o.emit("", errs)
        return Ok(False)
    let ownership = r.ownership()
    let owned = ownership.errors(catalog)
    if owned > 0:
        var errs = ownership.human(catalog)
        let count = Param(name="count".to_string(), value="{owned}")
        errs.push(catalog.plain_error(stopped_owned, [count]))
        errs.push(beyond)
        o.emit("", errs)
        return Ok(False)
    if not beyond.is_empty():
        o.emit("", beyond)
        return Ok(False)
    var times = SirTimes(check=0, lower=0, ownership=0)
    let done = sir_of(sys, base, built, catalog, mut times, False, mut kept)
    if not done.beyond.is_empty():
        var why = String.new()
        for b in done.beyond:
            why.push("beyond the slice: {b}\n")
        o.emit("", why)
        return Ok(False)
    var exe = output_for(built.disk, built.package_name, built.build_root.copy(), release)
    if let Some(given) = output:
        exe = given.copy()
    if how.emit_sir and done.entry:
        # What the backend would be handed, after the line that names the
        # executable it would make (RULES.md, R170 and R195).
        o.emit("{EMITTED_EXECUTABLE}{exe}\n{done.sir}", "")
        return Ok(True)
    if how.emit_sir and how.for_run:
        # Nothing for a program without `main`, which the driver says it
        # cannot run (R170).
        return Ok(True)
    if not native or not done.entry:
        # The plain build: checked and lowered (a library has no `main` to
        # link).
        var line = String.new()
        if built.package_name.is_empty():
            let params = [Param(name="file".to_string(), value=path.to_string())]
            line = catalog.render("cli.built-file", params)
        else:
            let params = [
                Param(name="name".to_string(), value=built.package_name.copy()),
                Param(name="version".to_string(), value=built.package_version.copy()),
                Param(name="modules".to_string(), value="{built.own_modules}"),
            ]
            line = catalog.render("cli.built", params)
        # A build that emits its SIR names what it built without linking as
        # a comment of the SIR (RULES.md, R195).
        if how.emit_sir:
            o.emit("{EMITTED_BUILT}{line}\n", "")
            return Ok(True)
        o.emit("{line}\n", "")
        return Ok(True)
    # The backend makes the executable's directory before it links; here
    # the SIR is written into it first.
    _ = sys.fs.create_dir(Path.new(parent(exe)))
    let sir_file = "{exe}.sir"
    sys.fs.write_text(Path.new(sir_file), done.sir)?
    let sisu = "{home}/target/release/sisu"
    var backend: list[str] = ["build", "--native", "--from-sir", sir_file, "--output", exe]
    if release:
        backend.push("--release")
    let ran = sys.proc.run(sisu, backend)
    _ = sys.fs.remove(Path.new(sir_file))
    match ran:
        case Ok(ran_out):
            o.emit(ran_out.stdout, ran_out.stderr)
            return Ok(ran_out.status == 0)
        case Err(e):
            o.emit("", "cannot run `{sisu}`: {e}\n")
            return Ok(False)

## A program held in memory, checked and lowered as `sisu run` builds it
## (without its tests, every contract checked): its SIR, or the report of
## the phase that stopped it (the front end's diagnostics, warnings and
## all, then the failed `comptime` expressions, then the ownership
## checker's), or what stage 1 says of a program beyond its slice.
enum Built:
    Sir(String)
    Stopped(Report)
    Refused(String)

## How a command of `sir --repl-serve` ended (RULES.md, R112): built,
## stopped by the program's errors, or given arguments it does not take.
enum Ending:
    Done
    Failed
    Misused

## What a command of the REPL prints on standard output and on standard
## error, and how it ended: what `sir --repl`, `sir --worksheet` and `parse
## --bindings` print alone, and what `sir --repl-serve` answers for each.
struct Answer:
    out: String
    err: String
    ending: Ending

impl Answer:
    ## A command that printed `out`.
    pure def done(out: str) -> Answer:
        return Answer(out=out.to_string(), err=String.new(), ending=Ending.Done)

    ## A command that said why on standard error and failed.
    pure def failed(err: str) -> Answer:
        return Answer(out=String.new(), err=err.to_string(), ending=Ending.Failed)

    ## A command given arguments it does not take.
    pure def misused() -> Answer:
        return Answer(out=String.new(), err=String.new(), ending=Ending.Misused)

    ## The bytes the command writes to a stream, as `emit` writes `text`:
    ## nothing, or the text with one line break at its end.
    pure def written(text: str) -> String:
        if text.is_empty():
            return String.new()
        return "{text.strip_suffix("\n")}\n"

    ## The answer's frame (RULES.md, R112): the line `answer STATUS OUT
    ## ERR`, the exit status the command gives alone and the lengths in
    ## bytes of what it writes to standard output and to standard error,
    ## then those bytes, standard output's first. A failed command's
    ## standard error ends with the line the run time prints when it
    ## stops, `error: Failed` or `error: Usage(...)`.
    pure def frame(self) -> String:
        let out = Answer.written(self.out)
        var err = Answer.written(self.err)
        var status = 0
        match self.ending:
            case Ending.Done:
                pass
            case Ending.Failed:
                err.push("error: Failed\n")
                status = 1
            case Ending.Misused:
                let e = Usage(text=usage())
                err.push("error: {e:?}\n")
                status = 1
        return "answer {status} {out.byte_len()} {err.byte_len()}\n{out}{err}"

## A command's answer printed as the command alone prints it, with its
## error for the run time to print and exit with.
def answered(a: Answer) -> ! {UsageError, CommandError}:
    emit(a.out, a.err)
    return match a.ending:
        case Ending.Done: Ok(())
        case Ending.Failed: Err(Failed)
        case Ending.Misused: Err(Usage(text=usage()))

## `sir --repl-serve` (RULES.md, R112 and R158): stage 1's commands
## served by one process, which makes the standard library's base once and
## keeps it between them. Each line of standard input is a request, the
## arguments of one command separated by tabs: `sir --repl ...`, `sir
## --worksheet ...` or `parse --bindings INPUT` (R112), or `sir`, `check`,
## `parse`, `fmt`, `lint`, `doc` or `tokens` with its arguments and `--dir
## DIR`, the working directory it runs in (R158). Each is answered on
## standard error with the frame of what the command alone prints and the
## status it gives (`Answer.frame`, `held_frame`); an empty line or the end
## of the input ends it, status 0. Before each request the base is made
## again when a std text, the catalog or the runtime the request builds for
## changed, and the server answers `stale` and ends when its own executable
## was built again. Standard error, because the native run time writes it
## at once and keeps standard output until it holds 64 KB or the program
## ends.
def repl_serve(sys: System, given_home: str, catalog_file: str, given: Catalog) -> ! IoError:
    # The server's own directories, which a request's working directory
    # does not move.
    let home = absolute(sys, given_home)
    let catalog_path = absolute(sys, catalog_file)
    let cwd = absolute(sys, ".")
    let stamp = ServerStamp.of(sys, home)
    var catalog = given.copy()
    var key = String.new()
    var served = Served.alone()
    while let Some(line) = sys.stdin.read_line():
        if line.is_empty():
            break
        if stamp.stale(sys, home):
            print_err("stale")
            break
        var args: list[String] = []
        for part in line.split("\t"):
            args.push(part.to_string())
        let command = if args.is_empty(): String.new() else: args[0].copy()
        let repl = command == "sir" and (args.contains("--repl") or args.contains("--worksheet"))
        # The working directory of a command (`--dir DIR`, the server's own
        # without one); `sir --repl` and `sir --worksheet` take `--dir` as
        # where their program stands (R95) and run in the server's.
        var dir = cwd.copy()
        var words: list[String] = []
        var misused = not served_command(command) or args.contains("--repl-serve")
        # A build is served when it hands its SIR back (RULES.md, R170 and
        # R195), or when it calls no backend (one without `--native`).
        if command == "build" and (args.contains("--emit-sir") or not args.contains("--native")):
            misused = args.contains("--repl-serve")
        var k = 0
        while k < len(args):
            if not repl and args[k] == "--dir":
                if k + 1 >= len(args):
                    misused = True
                    break
                dir = package.canonical(package.join(cwd, args[k + 1]))
                if args[k + 1].starts_with("/"):
                    dir = package.canonical(args[k + 1])
                k += 2
                continue
            if args[k] == "--home" or args[k] == "--catalog":
                misused = True
            words.push(args[k].copy())
            k += 1
        let at = request_system(sys, dir, words)
        # The base the request's command checks against: the one held, when
        # the std texts, the catalog and the runtime it builds for are the
        # ones it was made of.
        match served_key(at, home, catalog_path):
            case Ok(now):
                if now != key:
                    match remade(at, home, catalog_path):
                        case Ok((c, s)):
                            catalog = c
                            served = s
                            key = now
                        case Err(e):
                            print_err(io_frame(e))
                            continue
            case Err(e):
                print_err(io_frame(e))
                continue
        serve_one(at, home, catalog_path, args, words, misused, served, catalog)
    return Ok(())

## One request of `sir --repl-serve` answered (RULES.md, R112 and R158):
## `args` as given, `words` without the working directory's `--dir`, with
## the system `at` of that directory and the base `served` holds.
def serve_one(
    at: System,
    home: str,
    catalog_path: str,
    args: list[String],
    words: list[String],
    misused: bool,
    served: Served,
    catalog: Catalog,
):
    let command = if args.is_empty(): String.new() else: args[0].copy()
    let repl = command == "sir" and (args.contains("--repl") or args.contains("--worksheet"))
    let bindings = command == "parse" and len(args) == 3 and args[1] == "--bindings"
    match served.base:
        case None:
            print_err(Answer.misused().frame().strip_suffix("\n"))
        case Some(base):
            if misused:
                print_err(Answer.misused().frame().strip_suffix("\n"))
                return
            var answered: Answer ! IoError = Ok(Answer.misused())
            if repl and args.contains("--repl"):
                answered = repl_answer(at, home, base, args, catalog)
            elif repl:
                answered = worksheet_answer(at, home, base, args, catalog)
            elif bindings:
                answered = bindings_answer(at, args[2], catalog)
            else:
                # Any other command, as `main` runs it, with what it prints held
                # and the base served.
                let (rest, fine) = command_words(words)
                if not fine:
                    print_err(Answer.misused().frame().strip_suffix("\n"))
                    return
                var o = Out.held()
                var failure: String? = None
                if let Err(e) = run_command(at, home, catalog_path, rest, catalog, mut o, served):
                    failure = Some("error: {e:?}\n")
                print_err(held_frame(o, failure))
                return
            match answered:
                case Ok(a):
                    print_err(a.frame().strip_suffix("\n"))
                case Err(e):
                    print_err(io_frame(e))

## Whether `sir --repl-serve` runs the command for a request, besides the
## REPL's (RULES.md, R158).
pure def served_command(command: str) -> bool:
    return match command:
        case "sir" | "check" | "parse" | "fmt" | "lint" | "doc" | "tokens" | "query" | "eval" | "fix" | "explain-borrow" | "audit" | "grammar": True
        case _: False

## What the run time prints of an I/O error that stops `main`, without the
## lines of the source it passed through, as an answer (RULES.md, R112).
pure def io_frame(e: IoError) -> String:
    let text = "error: {e:?}\n"
    return "answer 1 0 {text.byte_len()}\n{text.strip_suffix("\n")}"

## The frame of a command run with what it printed held in `o` (RULES.md,
## R158): status 1 when it failed, and then after what it printed on
## standard error the run time's last line, `failure`, `error: ` and the
## error's form (`Failed`, `Exit(status=N)`, `Usage(...)` or an I/O
## error); without the trailing line break, which `print_err` adds.
pure def held_frame(o: Out, failure: String?) -> String:
    var err = o.err.copy()
    var status = 0
    if let Some(f) = failure:
        err.push(f)
        status = 1
    let frame = "answer {status} {o.out.byte_len()} {err.byte_len()}\n{o.out}{err}"
    return frame.strip_suffix("\n").to_string()

## A request's words as `main` takes them: without `--target-runtime` and
## its value, which `target_runtime` reads from the request's arguments,
## and whether they are fine (a runtime is one of two).
pure def command_words(words: list[String]) -> (list[String], bool):
    var rest: list[String] = []
    var i = 0
    while i < len(words):
        if words[i] == "--target-runtime" and i + 1 < len(words):
            if words[i + 1] != "native" and words[i + 1] != "interpreter":
                return (rest, False)
            i += 2
            continue
        rest.push(words[i].copy())
        i += 1
    return (rest, True)

## What a served base is made of: each std text's and the catalog's size
## and time, and the runtime and runtime profile the request builds for
## (its `target`, RULES.md, R116 and R122). A request whose key is the
## held one is served the held base.
def served_key(sys: System, home: str, catalog_path: str) -> String ! IoError:
    var names = ["prelude", "task", "log", "cap", "live"]
    for name in importable():
        names.push(name)
    var all = "{target_runtime(sys)} {runtime_profile(sys)}\n"
    let c = sys.fs.metadata(Path.new(catalog_path))?
    all.push("catalog {c.len} {c.modified}\n")
    for name in names:
        let m = sys.fs.metadata(Path.new(std_file(home, name)))?
        all.push("{name} {m.len} {m.modified}\n")
    return Ok(all)

## The catalog and the base a request is served, made again (RULES.md,
## R158): the base through the cache, as `base_of` makes it, with the
## lines of every std text found once for all its requests (R125).
def remade(sys: System, home: str, catalog_path: str) -> (Catalog, Served) ! IoError:
    let catalog = Catalog.parse(sys.fs.read_to_string(Path.new(catalog_path))?)
    let texts = std_texts(sys, home)?
    let base = typeck.with_lines(base_of(sys, home, texts, catalog))
    return Ok((catalog, Served(base=Some(base), texts=texts)))

## What tells a server's executable (RULES.md, R158): the running
## executable's size and time, and those of the driver's build of stage 1,
## `HOME/target/stage1/sisu1`, when the server is that build. A build
## replaces the file, so the running one keeps its own; the file at the
## driver's path is the build a new server would run.
struct ServerStamp:
    running: String
    built: String?

impl ServerStamp:
    def of(sys: System, home: str) -> ServerStamp:
        let running = file_stamp(sys, "/proc/self/exe")
        let at = file_stamp(sys, "{home}/target/stage1/sisu1")
        var built: String? = None
        if not running.is_empty() and at == running:
            built = Some(at)
        return ServerStamp(running=running, built=built)

    ## Whether the server's executable was built again since it started.
    def stale(self, sys: System, home: str) -> bool:
        if file_stamp(sys, "/proc/self/exe") != self.running:
            return True
        if let Some(b) = self.built:
            return file_stamp(sys, "{home}/target/stage1/sisu1") != b
        return False

## A file's size and time, empty when it cannot be read.
def file_stamp(sys: System, path: str) -> String:
    let m = sys.fs.metadata(Path.new(path)) else:
        return String.new()
    return "{m.len} {m.modified}"

## The system a served request runs with (RULES.md, R158): the server's,
## but for a file system whose relative paths are relative to `dir` and an
## environment whose arguments are the request's `words` and whose working
## directory (`PWD`, which `absolute` reads) is `dir`.
def request_system(sys: System, dir: str, words: list[String]) -> System:
    var vars: dict[String, String] = {}
    _ = vars.insert("PWD".to_string(), dir.to_string())
    let env = cap.FakeEnv(args=words.copy(), vars=vars)
    return cap.system_with(sys, InDir(inner=sys.fs, dir=dir.to_string()), env)

## The file system of a served request (RULES.md, R158): a relative path is
## relative to `dir`, an absolute one is itself; what it lists starts with
## the path as it was given, and an error names that path.
struct InDir:
    inner: Fs
    dir: String

impl InDir:
    pure def full(self, path: Path) -> Path:
        let text = path.as_str()
        if text.starts_with("/"):
            return path.copy()
        return Path.new("{self.dir}/{text}")

pure def given_path(own e: IoError, path: Path) -> IoError:
    return match e:
        case NotFound(_): NotFound(path=path.copy())
        case PermissionDenied(_): PermissionDenied(path=path.copy())
        case AlreadyExists(_): AlreadyExists(path=path.copy())
        case InvalidData(_): InvalidData(path=path.copy())
        case _: e

impl FsOps for InDir:
    def read(self, path: Path) -> bytes ! IoError:
        return self.inner.read(self.full(path)).map_err((e) -> given_path(e, path))
    def write(self, path: Path, data: bytes) -> ! IoError:
        return self.inner.write(self.full(path), data).map_err((e) -> given_path(e, path))
    def read_to_string(self, path: Path) -> String ! IoError:
        return self.inner.read_to_string(self.full(path)).map_err((e) -> given_path(e, path))
    def write_text(self, path: Path, text: str) -> ! IoError:
        return self.inner.write_text(self.full(path), text).map_err((e) -> given_path(e, path))
    def exists(self, path: Path) -> bool:
        return self.inner.exists(self.full(path))
    def metadata(self, path: Path) -> Metadata ! IoError:
        return self.inner.metadata(self.full(path)).map_err((e) -> given_path(e, path))
    def remove(self, path: Path) -> ! IoError:
        return self.inner.remove(self.full(path)).map_err((e) -> given_path(e, path))
    def rename(self, source: Path, target: Path) -> ! IoError:
        let whence = self.full(source)
        let to = self.full(target)
        let Err(e) = self.inner.rename(whence.copy(), to) else:
            return Ok(())
        if cap.error_path(e) == Some(whence):
            return Err(given_path(e, source))
        return Err(given_path(e, target))
    def list_dir(self, path: Path) -> list[Path] ! IoError:
        let full = self.full(path)
        let found = self.inner.list_dir(full.copy()).map_err((e) -> given_path(e, path))?
        let cut = full.as_str().byte_len()
        var out: list[Path] = []
        for f in found:
            let text = f.as_str()
            out.push(Path.new("{path.as_str()}{text.byte_slice(cut, text.byte_len())}"))
        return Ok(out)
    def create_dir(self, path: Path) -> ! IoError:
        return self.inner.create_dir(self.full(path)).map_err((e) -> given_path(e, path))
    def sync(self, path: Path) -> ! IoError:
        return self.inner.sync(self.full(path)).map_err((e) -> given_path(e, path))

## Where a command prints (RULES.md, R158): straight to standard output and
## standard error, as a command run alone prints, or held for a served
## request's answer.
struct Out:
    direct: bool
    out: String
    err: String

impl Out:
    pure def direct() -> Out:
        return Out(direct=True, out=String.new(), err=String.new())

    pure def held() -> Out:
        return Out(direct=False, out=String.new(), err=String.new())

    ## `print(text)`: the text and a line break, on standard output.
    def put(mut self, text: str):
        if self.direct:
            print(text)
            return
        self.out.push(text)
        self.out.push("\n")

    ## `emit(out, errs)`: each text with one line break at its end, on its
    ## stream, nothing for an empty one.
    def emit(mut self, out: str, errs: str):
        if self.direct:
            emit(out, errs)
            return
        self.out.push(Answer.written(out))
        self.err.push(Answer.written(errs))

## The base a command checks a program against when it is served one
## (RULES.md, R158), with the std texts it was made of; a command run alone
## has none and makes its own.
struct Served:
    base: typeck.Base?
    texts: dict[String, String]

impl Served:
    pure def alone() -> Served:
        return Served(base=None, texts={})

## What `parse --bindings INPUT` answers (RULES.md, R95).
def bindings_answer(sys: System, path: str, catalog: Catalog) -> Answer ! IoError:
    let text = sys.fs.read_to_string(Path.new(path))?
    return Ok(Answer.done(session.bindings(text, catalog)))

## `query KIND FILE [LINE COL] [--text PATH]` (RULES.md, R164): the
## language server's questions, each answered as lines of tab-separated
## fields (`query`): `diagnostics FILE` and `symbols FILE` of the file,
## `hover`, `definition`, `references` and `completions` of its position
## LINE and COL (1-based, the column counting characters). The file is
## checked in the program that holds it: the package whose module it is,
## or the file alone; with `--text PATH` the file's text is PATH's, the
## editor's unsaved one.
def query_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> ! {IoError, UsageError, CommandError}:
    var words: list[String] = []
    var given: String? = None
    var k = 1
    while k < len(rest):
        if rest[k] == "--text" and k + 1 < len(rest):
            given = Some(rest[k + 1].copy())
            k += 2
            continue
        words.push(rest[k].copy())
        k += 1
    if words.is_empty():
        return Err(Usage(text=usage()))
    let kind = words[0].copy()
    let whole = kind == "diagnostics"
        or kind == "values"
        or kind == "symbols"
        or kind == "inlay"
        or kind == "format"
        or kind == "holes"
    let at = kind == "hover"
        or kind == "definition"
        or kind == "references"
        or kind == "completions"
        or kind == "selection"
        or kind == "actions"
    let renames = kind == "rename" and len(words) == 5
    # `query explain FILE LINE` (RULES.md, R187): a line, not a position.
    let explains = kind == "explain" and len(words) == 3
    if not (whole and len(words) == 2)
            and not (at and len(words) == 4)
            and not renames
            and not explains:
        return Err(Usage(text=usage()))
    let file = words[1].copy()
    let text = sys.fs.read_to_string(Path.new(given ?? file.copy()))?
    if kind == "symbols":
        o.emit(query.symbols(text, catalog), "")
        return Ok(())
    if kind == "values":
        # A worksheet's inline values (RULES.md, R196).
        var base = served.base.copy() ?? base_of(sys, home, std_texts(sys, home)?, catalog)
        o.emit(sheet_values(sys, home, base, file, text, catalog)?, "")
        return Ok(())
    if explains:
        let line = words[2].parse_int() else:
            return Err(Usage(text=usage()))
        var base = served.base.copy() ?? base_of(sys, home, std_texts(sys, home)?, catalog)
        var env = base.environment()
        let (input, module, _) = query_input(sys, home, file, text, mut env, catalog)?
        o.emit(query_explain(base, input, module, file, text, line, catalog), "")
        return Ok(())
    var offset = 0
    if at or renames:
        let line = words[2].parse_int() else:
            return Err(Usage(text=usage()))
        let col = words[3].parse_int() else:
            return Err(Usage(text=usage()))
        offset = Lines.of(text).offset(text, line, col)
    if kind == "selection":
        o.emit(query.selection(text, offset, catalog), "")
        return Ok(())
    var new = String.new()
    if renames:
        new = words[4].copy()
    if kind == "format":
        # A base only where the file needs one, as `fmt` (RULES.md, R169).
        let written = format.to_resolve(text, catalog)
        var base = served.base.copy()
        if base.is_none() and not written.is_empty():
            base = Some(base_of(sys, home, std_texts(sys, home)?, catalog))
        o.emit(query_format(base, text, written, catalog), "")
        return Ok(())
    match served.base:
        case Some(b):
            o.emit(query_answer(sys, home, kind, file, text, offset, new, b, catalog)?, "")
        case None:
            let base = base_of(sys, home, std_texts(sys, home)?, catalog)
            o.emit(query_answer(sys, home, kind, file, text, offset, new, base, catalog)?, "")
    return Ok(())

## `check --holes FILE` (10, "Holes"; D-061; RULES.md, R174): each typed
## hole of the program that holds FILE (its package's, or the file's
## alone), by module and position, with the type its place needs, the
## function it is in, the bindings in scope before it and those of its
## type, on standard output; a program with an error has its diagnostics
## reported as `check` reports them instead, and fails.
def holes_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> ! {IoError, UsageError, CommandError}:
    var paths: list[String] = []
    var json = False
    for k in range(1, len(rest)):
        if rest[k] == "--holes" or rest[k] == "--format=human":
            continue
        if rest[k] == "--format=json":
            json = True
            continue
        if rest[k].starts_with("--"):
            let params = [
                Param(name="option".to_string(), value=rest[k].copy()),
                Param(name="command".to_string(), value="check".to_string()),
            ]
            o.emit("", catalog.plain_error("cli.unknown-option", params))
            return Err(Failed)
        paths.push(rest[k].copy())
    if len(paths) > 1:
        return Err(Usage(text=usage()))
    # A package's directory, or without a path the working directory's
    # package, reports the holes of each of its modules, a workspace's of
    # each member's in turn (RULES.md, R195).
    var given = String.new()
    if let Some(p) = paths.first():
        given = p.copy()
    else:
        let found = nearest_package(sys, "check", catalog, mut o) else:
            return Err(Failed)
        given = found
    var base = served.base.copy() ?? base_of(sys, home, std_texts(sys, home)?, catalog)
    var files: list[(String, bool)] = [(given.copy(), True)]
    if package.is_dir(sys.fs, absolute(sys, given)):
        files = []
        for layout in layouts_of(sys, given, False, build_request(sys)) ?? []:
            if let Some(first) = layout.modules.first():
                files.push((first.disk.copy(), False))
        if files.is_empty():
            return check_with(
                sys, home, given, False, build_request(sys), base, catalog, mut o, None
            )
    var out = String.new()
    var objects: list[String] = []
    for (file, as_given) in files:
        let text = sys.fs.read_to_string(Path.new(file))?
        var env = base.environment()
        let (input, at, _) = query_input(sys, home, file, text, mut env, catalog)?
        let checked = check_input(base, input, catalog, True)
        let typed = checked.typed else:
            return check_with(
                sys, home, given, False, build_request(sys), base, catalog, mut o, None
            )
        if checked.has_error:
            return check_with(
                sys, home, given, False, build_request(sys), base, catalog, mut o, None
            )
        hole_lines(input, at, file, as_given, typed, json, catalog, mut out, mut objects)
    if json:
        if objects.is_empty():
            out = "[]\n".to_string()
        else:
            out = "[\n  {objects.join(",\n  ")}\n]\n"
    o.emit(out, "")
    return Ok(())

## The lines of `check --holes` (or with `json` its objects) for each typed
## hole of the checked program of `input`, whose module `at` is `file`:
## named `file` as given when `as_given`, else each module by its own file,
## as `check` names a package's (RULES.md, R174, R181, R195).
pure def hole_lines(
    input: Input,
    at: int,
    file: str,
    as_given: bool,
    typed: typeck.Typed,
    json: bool,
    catalog: Catalog,
    mut out: String,
    mut objects: list[String],
):
    for i in range(len(input.modules)):
        let m = query_module(typed.prog, input, i)
        if i > 0 and m == typed.prog.root:
            continue
        var name = input.modules[i].file.copy()
        if (as_given and i == at) or name.is_empty():
            name = file.to_string()
        let mtext = input.modules[i].text.copy()
        let lines = Lines.of(mtext)
        for h in query.holes(typed, [m]):
            let (line, col) = lines.line_col(mtext, h.start)
            if json:
                objects.push(query.hole_json(h, "{name}:{line}:{col}"))
                continue
            var shown = "`todo()`".to_string()
            if not h.name.is_empty():
                shown = "`todo({quote(h.name)})`"
            let params = [
                Param(name="at".to_string(), value="{name}:{line}:{col}"),
                Param(name="hole".to_string(), value=shown),
                Param(name="ty".to_string(), value=h.ty.copy()),
                Param(name="function".to_string(), value=h.function.copy()),
            ]
            out.push(catalog.render("cli.hole", params))
            out.push("\n  ")
            if h.scope.is_empty():
                out.push(catalog.render("cli.hole-scope-none", []))
            else:
                var each: list[String] = []
                for b in h.scope:
                    each.push("`{b}`")
                let ps = [Param(name="bindings".to_string(), value=each.join(", "))]
                out.push(catalog.render("cli.hole-scope", ps))
            out.push("\n  ")
            if h.fits.is_empty():
                out.push(catalog.render("cli.hole-fits-none", []))
            else:
                var each: list[String] = []
                for b in h.fits:
                    each.push("`{b}`")
                let ps = [Param(name="names".to_string(), value=each.join(", "))]
                out.push(catalog.render("cli.hole-fits", ps))
            out.push("\n")
            # The rest of 10's report (RULES.md, R181): the types' definitions,
            # the contract in force, and the tests that reach the hole.
            for t in h.types:
                var each: list[String] = []
                for x in t.members:
                    each.push("`{x}`")
                # Each named whole, so that the catalog's test of its entries
                # finds them (RULES.md, R181, amended in the twenty-second
                # round).
                var id = "cli.hole-enum".to_string()
                if t.is_struct and t.members.is_empty():
                    id = "cli.hole-struct-empty".to_string()
                elif t.is_struct:
                    id = "cli.hole-struct".to_string()
                elif t.members.is_empty():
                    id = "cli.hole-enum-empty".to_string()
                let ps = [
                    Param(name="name".to_string(), value=t.name.copy()),
                    Param(name="members".to_string(), value=each.join(", ")),
                ]
                out.push("  {catalog.render(id, ps)}\n")
            for r in h.requires:
                let ps = [Param(name="clause".to_string(), value=r.copy())]
                out.push("  {catalog.render("cli.hole-requires", ps)}\n")
            for e in h.ensures:
                let ps = [Param(name="clause".to_string(), value=e.copy())]
                out.push("  {catalog.render("cli.hole-ensures", ps)}\n")
            if h.tests.is_empty():
                out.push("  {catalog.render("cli.hole-tests-none", [])}\n")
            else:
                var each: list[String] = []
                for t in h.tests:
                    each.push(quote(t))
                let ps = [Param(name="tests".to_string(), value=each.join(", "))]
                out.push("  {catalog.render("cli.hole-tests", ps)}\n")

## `fix FILE [--dry-run] [--all]` (10: "apply compiler-suggested
## migrations"; RULES.md, R176): the preferred fix of each diagnostic
## `check` reports in FILE (and with `--all` of each lint `lint` reports
## there), applied to the file's text, which is checked again and fixed
## again until no fix applies, a round would bring back a text an earlier
## one had (a fix that undoes another), or `FIX_ROUNDS` rounds are done;
## each fix it applies is said on standard output, with its edits under
## `--dry-run`, which leaves the file as it is.
def fix_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> ! {IoError, UsageError, CommandError}:
    var paths: list[String] = []
    var dry = False
    var all = False
    for k in range(1, len(rest)):
        if rest[k] == "--dry-run":
            dry = True
            continue
        if rest[k] == "--all":
            all = True
            continue
        if rest[k].starts_with("--"):
            let params = [
                Param(name="option".to_string(), value=rest[k].copy()),
                Param(name="command".to_string(), value="fix".to_string()),
            ]
            o.emit("", catalog.plain_error("cli.unknown-option", params))
            return Err(Exit(status=2))
        paths.push(rest[k].copy())
    if len(paths) != 1:
        return Err(Usage(text=usage()))
    let file = paths[0].copy()
    let original = sys.fs.read_to_string(Path.new(file))?
    let base = served.base.copy() ?? base_of(sys, home, std_texts(sys, home)?, catalog)
    var text = original.copy()
    var seen: list[String] = [original.copy()]
    var out = String.new()
    var applied = 0
    var round = 0
    # The errors of the text the fixes leave, when the last round checked it
    # (RULES.md, R199).
    var left: int? = None
    while round < FIX_ROUNDS:
        round += 1
        var env = base.environment()
        let (input, at, _) = query_input(sys, home, file, text, mut env, catalog)?
        var kept = Kept.new()
        let r = report_of(base, input, file, catalog, mut kept)
        let chosen = fixes_to_apply(r, at, all, text, catalog)
        left = Some(r.errors(catalog))
        if chosen.is_empty():
            break
        left = None
        let lines = Lines.of(text)
        var said = String.new()
        var edits: list[Edit] = []
        for c in chosen:
            let (line, col) = lines.line_col(text, c.start)
            let params = [
                Param(name="at".to_string(), value="{file}:{line}:{col}"),
                Param(name="code".to_string(), value=c.code.copy()),
                Param(name="fix".to_string(), value=c.title.copy()),
            ]
            said.push(catalog.render("cli.fixed", params))
            said.push("\n")
            for e in c.edits:
                if dry:
                    let span = lines.span(text, e.start, e.end)
                    said.push("  {span} {quote(e.text)}\n")
                edits.push(e.copy())
        let next = apply_edits(text, edits)
        if seen.contains(next):
            let (line, col) = lines.line_col(text, chosen[0].start)
            let params = [Param(name="at".to_string(), value="{file}:{line}:{col}")]
            out.push(catalog.render("cli.fix-undone", params))
            out.push("\n")
            left = None
            break
        out.push(said)
        applied += len(chosen)
        seen.push(next.copy())
        text = next
    let count = Param(name="count".to_string(), value="{applied}")
    let named = Param(name="file".to_string(), value=file.copy())
    if applied == 0:
        out.push(catalog.render("cli.fix-none", [named.copy()]))
    elif dry:
        out.push(catalog.render("cli.fix-would", [count, named.copy()]))
    else:
        sys.fs.write_text(Path.new(file), text)?
        out.push(catalog.render("cli.fix-done", [count, named.copy()]))
    # The status says whether the program checks after the fixes (RULES.md,
    # R199): 0 when no error is left, 1 when one is, which no fix applies
    # to; the round stopped by an undoing fix or the last round checks the
    # text once more.
    var errors = 0
    if let Some(n) = left:
        errors = n
    else:
        var env = base.environment()
        let (input, _, _) = query_input(sys, home, file, text, mut env, catalog)?
        var kept = Kept.new()
        errors = report_of(base, input, file, catalog, mut kept).errors(catalog)
    if errors > 0:
        let params = [named.copy(), Param(name="count".to_string(), value="{errors}")]
        o.emit(out, catalog.plain_error("cli.fix-errors-left", params))
        return Err(Exit(status=1))
    o.emit(out, "")
    return Ok(())

## The parser's modules whose `##!` comments hold its grammar, in the order
## `grammar` prints them (RULES.md, R202): from a file's declarations down to
## its types.
const GRAMMAR_MODULES: list[str] = ["items", "stmts", "exprs", "patterns", "types"]

## The grammar of `texts` (each module's name and text): for each, a line
## `-- TITLE (NAME)`, its first paragraph of `##!` lines without its last
## stop, then the lines of its `##!` comments' ```` ```text ```` blocks, a
## blank line between modules (RULES.md, R202).
pure def grammar_text(texts: list[(String, String)]) -> String:
    var out = String.new()
    for (name, text) in texts:
        var title = String.new()
        var titled = False
        var inside = False
        var lines: list[String] = []
        for line in text.split("\n"):
            if not line.starts_with("##!"):
                continue
            var body = line.strip_prefix("##!")
            if body.starts_with(" "):
                body = body.strip_prefix(" ")
            # The title is the comment's first paragraph.
            if not titled:
                if body.is_empty():
                    titled = True
                elif title.is_empty():
                    title = body.to_string()
                else:
                    title = "{title} {body}"
                continue
            if body.starts_with("```"):
                # A fence opens a block, ```` ```text ```` the grammar's, and
                # the next closes it.
                inside = not inside and body == "```text"
                continue
            if inside:
                lines.push(body.to_string())
        if lines.is_empty():
            continue
        if not out.is_empty():
            out.push("\n")
        let shown = title.strip_suffix(":").strip_suffix(".")
        out.push("-- {shown} ({name})\n")
        for l in lines:
            out.push("{l}\n")
    return out

test "the grammar of the parser's comments":
    let items = "##! Declarations.\n##!\n##! ```text\n##! file := item* EOF\n##! ```\n\nconst X: int = 1\n"
    let types = "##! Types.\n##!\n##! ```text\n##! type := path\n##! ```\n##! `ref T?` is not a rule.\n"
    let texts = [
        ("parser/items.sisu".to_string(), items.to_string()),
        ("parser/types.sisu".to_string(), types.to_string()),
    ]
    assert grammar_text(texts)
        == "-- Declarations (parser/items.sisu)\nfile := item* EOF\n\n-- Types (parser/types.sisu)\ntype := path\n"

## How many times `fix` checks a file again after fixing it (RULES.md,
## R176): a fix that brings a diagnostic with a fix of its own is applied
## in the next round.
const FIX_ROUNDS: int = 16

## One fix `fix` applies: its diagnostic's start, code and the fix as the
## human form writes it, with its edits.
struct Chosen:
    start: int
    code: String
    title: String
    edits: list[Edit]

## The preferred fix (the first, when it has edits) of each diagnostic of
## the report in its file `at`, and with `all` of each lint (`sisu lint`'s,
## the unused imports among them), in `check`'s order, but one whose edits
## touch those of a fix taken before it, which the next round gets.
pure def fixes_to_apply(r: Report, at: int, all: bool, text: str, catalog: Catalog) -> list[Chosen]:
    var found: list[Diagnostic] = []
    for x in r.diags:
        if x.file == at:
            found.push(x.diag.copy())
    if all:
        for x in r.lints:
            if x.file == at:
                found.push(x.diag.copy())
        var refused: list[(int, int)] = []
        for x in r.diags:
            if x.file == at and catalog.is_error(x.diag.msg):
                refused.push((x.diag.start, x.diag.end))
        for d in fmt.prune.lints(text, refused, catalog):
            found.push(d.copy())
    var out: list[Chosen] = []
    var taken: list[(int, int)] = []
    for d in found:
        let f = d.fixes.first() else:
            continue
        if f.edits.is_empty():
            continue
        var clash = False
        for e in f.edits:
            for (s, t) in taken:
                if (e.start < t and s < e.end) or e.start == s or e.end == t:
                    clash = True
        if clash:
            continue
        for e in f.edits:
            taken.push((e.start, e.end))
        out.push(
            Chosen(
                start=d.start,
                code=catalog.code(d.msg),
                title=fix_text(f, catalog),
                edits=f.edits.copy(),
            )
        )
    return out

## `text` with each of `edits` made, none of which overlaps another.
pure def apply_edits(text: str, edits: list[Edit]) -> String:
    var sorted = edits.copy()
    sorted.sort_by((a, b) -> a.start.cmp(b.start))
    var out = String.new()
    var at = 0
    for e in sorted:
        let start = min(max(e.start, at), text.byte_len())
        out.push(text.byte_slice(at, start))
        out.push(e.text)
        at = min(max(e.end, start), text.byte_len())
    out.push(text.byte_slice(at, text.byte_len()))
    return out

## `query format`: the edits that make `text` what `fmt` writes, one per
## run of changed lines (`query.format_edits`), nothing for a text `fmt`
## leaves as it is, and one line `refused\tsyntax` for a text with a
## syntax error, `refused\tunstable` for one the formatter refuses as
## changed (RULES.md, R169).
pure def query_format(
    base: typeck.Base?, text: str, written: list[String], catalog: Catalog
) -> String:
    return match format.format_file(base, text, written, catalog):
        case Ok(out): query.format_edits(text, out)
        case Err(Refusal.Syntax(_)): "refused\tsyntax\n".to_string()
        case Err(Refusal.Changed(_)): "refused\tunstable\n".to_string()

## The answer of a `query` of `kind` at `offset` of `file`, whose text is
## `text`, checked against `base`.
def query_answer(
    sys: System,
    home: str,
    kind: str,
    file: str,
    text: str,
    offset: int,
    new: str,
    base: typeck.Base,
    catalog: Catalog,
) -> String ! IoError:
    var env = base.environment()
    let (input, at, disks) = query_input(sys, home, file, text, mut env, catalog)?
    if kind == "diagnostics" or kind == "actions":
        var kept = Kept.new()
        let r = report_of(base, input, file, catalog, mut kept)
        if kind == "actions":
            return Ok(query_actions(r, at, offset, catalog))
        return Ok(query_diagnostics(r, at, catalog))
    var program = input.copy()
    if kind == "completions":
        # After a `.`, the program without it and the name being written,
        # so that the value before it is an expression of its own
        # (stage 0's `completion`).
        let start = query.word_start(text, offset)
        let prefix = text.byte_slice(start, offset).to_string()
        if start > 0 and text.byte_at(start - 1) == 46:
            let edited = "{text.byte_slice(0, start - 1)}{text.byte_slice(offset, text.byte_len())}"
            let (cut, _, _) = query_input(sys, home, file, edited, mut env, catalog)?
            let checked = check_input(base, cut, catalog, True)
            let typed = checked.typed else:
                return Ok(String.new())
            let ty = query.receiver_at(typed, query_module(typed.prog, cut, at), start - 1) else:
                return Ok(String.new())
            return Ok(query.with_prefix(query.members(typed, ty), prefix))
        let checked = check_input(base, program, catalog, True)
        let typed = checked.typed else:
            return Ok(String.new())
        let m = query_module(typed.prog, program, at)
        return Ok(query.with_prefix(query.scope(typed, m, offset), prefix))
    let checked = check_input(base, program, catalog, True)
    let typed = checked.typed else:
        return Ok(String.new())
    let m = query_module(typed.prog, program, at)
    if kind == "inlay":
        return Ok(query.inlay(typed, m, text))
    if kind == "holes":
        return Ok(query.holes_answer(typed, m, text))
    let files = query_files(sys, home, typed.prog, program, disks, base)
    if kind == "hover":
        return Ok(query.hover(typed, files, m, text, offset, catalog))
    if kind == "definition":
        return Ok(query.definition(typed, files, m, offset, catalog))
    var programs: list[ModuleId] = []
    for i in range(len(program.modules)):
        programs.push(query_module(typed.prog, program, i))
    if kind == "rename":
        return Ok(query.rename(typed, files, programs, m, offset, catalog, new))
    return Ok(query.references(typed, files, programs, m, offset, catalog))

## The program that holds `file` (whose text is `text`, which stands for
## the file's), checked with its tests as `check` checks it: the package
## of which it is a module, or the file alone (with the dependencies its
## inline metadata names); with the index of the file's module among the
## program's and each module's path on disk.
def query_input(
    sys: System, home: str, file: str, text: str, mut env: Environment, catalog: Catalog
) -> (Input, int, list[String]) ! IoError:
    let disk = absolute(sys, file)
    var dir = package.parent(disk)
    while True:
        if package.is_file(sys.fs, package.join(dir, package.MANIFEST)):
            for layout in package.load_target(
                sys.fs, Target.Package(dir.copy()), False, build_request(sys)
            ):
                for i in range(len(layout.modules)):
                    if package.canonical(layout.modules[i].disk) == disk:
                        var held: dict[String, String] = {}
                        _ = held.insert(layout.modules[i].disk.copy(), text.to_string())
                        let input = held_layout_input(
                            sys, home, layout, True, mut env, catalog, held
                        )?
                        var disks: list[String] = []
                        for m in layout.modules:
                            disks.push(package.canonical(m.disk))
                        return Ok((input, i, disks))
            break
        if dir == "/" or dir.is_empty():
            break
        dir = package.parent(dir)
    let layout = package.load_file_with(sys.fs, file, disk, text, build_request(sys))
    if (len(layout.packages) == 1 and layout.problems.is_empty()) or layout.modules.is_empty():
        return Ok((file_input(sys, home, file, text, True, mut env, catalog)?, 0, [disk]))
    var held: dict[String, String] = {}
    _ = held.insert(disk.copy(), text.to_string())
    let input = held_layout_input(sys, home, layout, True, mut env, catalog, held)?
    var disks: list[String] = []
    for m in layout.modules:
        disks.push(package.canonical(m.disk))
    return Ok((input, 0, disks))

## The module of the program that is the input's `i`th: the root module
## for the first, else the one of the program's whose file is its.
pure def query_module(prog: Program, input: Input, i: int) -> ModuleId:
    if i == 0 or i >= len(input.modules):
        return prog.root
    for k in range(len(prog.modules)):
        let m = ref prog.modules[k]
        if not m.is_std and m.file == input.modules[i].file:
            return ModuleId(index=k)
    return prog.root

## The path on disk and the text of each module of the checked program
## that has a file: the input's modules, and the standard library's.
def query_files(
    sys: System,
    home: str,
    prog: Program,
    input: Input,
    disks: list[String],
    base: typeck.Base,
) -> query.Files:
    var files = query.Files.new()
    for i in range(min(len(input.modules), len(disks))):
        let m = query_module(prog, input, i)
        if i == 0 or m != prog.root:
            _ = files.of.insert(m.index, (disks[i].copy(), input.modules[i].text.copy()))
    for k in range(len(prog.modules)):
        let m = ref prog.modules[k]
        if not m.is_std or m.name.contains("<") or m.name.contains("/"):
            continue
        if let Some(t) = base.texts.get(m.name.copy()):
            _ = files.of.insert(k, (absolute(sys, std_file(home, m.name)), t.copy()))
    return files

## `query diagnostics`: what `check` reports in the program's file `at`,
## one line per diagnostic, `RANGE\tCODE\tID\tSEVERITY\tMESSAGE`, in
## `check`'s order.
pure def query_diagnostics(r: Report, at: int, catalog: Catalog) -> String:
    if at >= len(r.files):
        return String.new()
    let text = r.files[at].1.copy()
    let lines = Lines.of(text)
    var out = String.new()
    for x in r.diags:
        if x.file != at:
            continue
        let d = ref x.diag
        let range = lines.span(text, d.start, d.end)
        let message = catalog.render(d.msg.id(), d.params)
        let severity = catalog.severity(d.msg)
        out.push(
            "{range}\t{catalog.code(d.msg)}\t{d.msg.id()}\t{severity}\t{query.field(message)}\n"
        )
    return out

## `query actions`: the fixes of the diagnostics `check` reports in the
## program's file `at` whose range holds `offset`, in `check`'s order,
## each with edits: a line `fix\tK\tTITLE\tRANGE\tCODE\tID` (K the fix's
## index among its diagnostic's, 0 the one to prefer; TITLE the fix as the
## human form writes it; RANGE, CODE and ID the diagnostic's), then a line
## `edit\tRANGE\tTEXT` per edit, in the same file (RULES.md, R169).
pure def query_actions(r: Report, at: int, offset: int, catalog: Catalog) -> String:
    if at >= len(r.files):
        return String.new()
    let text = r.files[at].1.copy()
    let lines = Lines.of(text)
    var out = String.new()
    for x in r.diags:
        let d = ref x.diag
        if x.file != at or offset < d.start or offset > d.end:
            continue
        let span = lines.span(text, d.start, d.end)
        for k in range(len(d.fixes)):
            let f = ref d.fixes[k]
            if f.edits.is_empty():
                continue
            let title = query.field(fix_text(f, catalog))
            out.push("fix\t{k}\t{title}\t{span}\t{catalog.code(d.msg)}\t{d.msg.id()}\n")
            for e in f.edits:
                let edited = lines.span(text, e.start, e.end)
                out.push("edit\t{edited}\t{query.field(e.text)}\n")
    return out

## `eval FILE [--to json|toml|yaml]` (08, "Configuration files"; RULES.md,
## R165): the module's `const` items, each evaluated by the compile-time
## evaluator, written in the form `--to` names (JSON without it) on
## standard output; the program's diagnostics, and one at each constant
## that fails or that the form cannot write, on standard error, as `check`
## prints them, a failure with status 1.
def eval_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> ! {IoError, UsageError, CommandError}:
    var form = config.Form.Json
    var paths: list[String] = []
    var k = 1
    while k < len(rest):
        if rest[k] == "--to" and k + 1 < len(rest):
            let named = config.Form.named(rest[k + 1]) else:
                return Err(Usage(text=usage()))
            form = named
            k += 2
            continue
        paths.push(rest[k].copy())
        k += 1
    if len(paths) != 1 or paths[0].starts_with("--"):
        return Err(Usage(text=usage()))
    match served.base:
        case Some(b):
            return eval_with(sys, home, paths[0], form, b, catalog, mut o)
        case None:
            let base = base_of(sys, home, std_texts(sys, home)?, catalog)
            return eval_with(sys, home, paths[0], form, base, catalog, mut o)

## `eval` of the module `file` in `form`, checked against `base`.
def eval_with(
    sys: System,
    home: str,
    file: str,
    form: config.Form,
    base: typeck.Base,
    catalog: Catalog,
    mut o: Out,
) -> ! {IoError, UsageError, CommandError}:
    var env = base.environment()
    var kept = Kept.new()
    let inputs = inputs_of(sys, home, file, False, False, build_request(sys), mut env, catalog)?
    let input = inputs.first() else:
        return Err(Failed)
    let (r, evaluated) = report_program(base, input, file, catalog, mut kept)
    if r.has_error or r.errors(catalog) > 0 or not r.beyond.is_empty():
        var errs = r.human(catalog)
        for b in r.beyond:
            errs.push("beyond the slice: {b}\n")
        o.emit("", errs)
        return Err(Failed)
    let done = evaluated else:
        return Err(Failed)
    var failed: list[Filed] = []
    var beyond = String.new()
    var entries: list[(String, config.Data)] = []
    var places: list[(int, int)] = []
    for (name, start, end) in config.constants(input.modules[0].text, catalog):
        var d: Diagnostic? = None
        match interp.value_of(done.program, name, DEFAULT_COMPTIME_BUDGET, catalog):
            case Ok(Some(v)):
                match config.data_of(done.program, v, name):
                    case Ok(data):
                        entries.push((name.copy(), data))
                        places.push((start, end))
                    case Err(config.Unwritable.Holds(what, _, path)):
                        d = Some(no_form(path, what, form, start, end))
            case Ok(None):
                pass
            case Err(stop):
                match stop:
                    case interp.Stop.Panicked(m) | interp.Stop.Hole(m):
                        d = Some(
                            Diagnostic.new(Msg.ComptimePanicked, start, end).with("message", m)
                        )
                    case interp.Stop.Refinement(ty, value, predicate):
                        var x = Diagnostic.new(Msg.RefineNotSatisfied, start, end)
                        d = Some(x.with("value", value).with("ty", ty).with("predicate", predicate))
                    case interp.Stop.Budget:
                        let x = Diagnostic.new(Msg.ComptimeBudget, start, end).with("item", name)
                        d = Some(x.with("steps", "{DEFAULT_COMPTIME_BUDGET}"))
                    case interp.Stop.World(what):
                        d = Some(Diagnostic.new(Msg.ComptimeIo, start, end).with("what", what))
                    case interp.Stop.NotKept(what):
                        d = Some(no_form(name, what, form, start, end))
                    case interp.Stop.Beyond(why):
                        beyond.push(
                            "beyond the slice: the constant `{name}` needs {why}, which stage 1's evaluator does not run\n"
                        )
        if let Some(x) = d:
            failed.push(Filed(file=0, diag=x.copy(), label_files=[]))
    if failed.is_empty() and beyond.is_empty():
        match config.render(form, entries):
            case Ok(text):
                o.emit(text, r.human(catalog))
                return Ok(())
            case Err(config.Unwritable.Holds(what, i, path)):
                let (start, end) = places[i]
                let x = no_form(path, what, form, start, end)
                failed.push(Filed(file=0, diag=x, label_files=[]))
    var shown = r.copy()
    for x in failed:
        shown.diags.push(x.copy())
    sort_filed(mut shown.diags, catalog, True)
    var errs = shown.human(catalog)
    errs.push(beyond)
    o.emit("", errs)
    return Err(Failed)

## `E0617`: the constant's field or item at `name`, its path from the
## constant's name (`LIMITS.timeout`; RULES.md, R180), holds `what`, which
## `form` cannot write.
pure def no_form(name: str, what: str, form: config.Form, start: int, end: int) -> Diagnostic:
    let d = Diagnostic.new(Msg.EvalNoForm, start, end).with("name", name).with("what", what)
    return d.with("form", form.name())

## The program `text`, held as the file `disk` (whose directory its inline
## metadata's paths are relative to) and named `name` in its diagnostics,
## built (RULES.md, R79).
def held_build(
    sys: System,
    home: str,
    base: typeck.Base,
    name: str,
    disk: str,
    text: str,
    catalog: Catalog,
    regions: list[session.Region],
) -> Built ! IoError:
    var kept = Kept.new()
    let (input, problems) = held_input(sys, home, base, name, disk, text, catalog, regions)?
    if let Some(p) = problems:
        return Ok(Built.Stopped(p.copy()))
    let built = input else:
        return Ok(Built.Refused(String.new()))
    let (r, sir) = report_with(base, built, name, catalog, mut kept, True, False)
    let front = r.front(catalog, None)
    if front.errors(catalog) > 0:
        return Ok(Built.Stopped(front))
    let evaluation = r.evaluation()
    if evaluation.errors(catalog) > 0:
        return Ok(Built.Stopped(evaluation))
    let ownership = r.ownership()
    if ownership.errors(catalog) > 0:
        return Ok(Built.Stopped(ownership))
    if not r.beyond.is_empty() or sir.is_empty():
        var why = String.new()
        for b in r.beyond:
            why.push("beyond the slice: {b}\n")
        return Ok(Built.Refused(why))
    return Ok(Built.Sir(sir))

## The program held in memory as `held_build` builds it, `text` named
## `name` and standing at `disk`, as an input with every contract checked;
## or the report of its manifests' problems when they leave it no module.
def held_input(
    sys: System,
    home: str,
    base: typeck.Base,
    name: str,
    disk: str,
    text: str,
    catalog: Catalog,
    regions: list[session.Region],
) -> (Input?, Report?) ! IoError:
    var env = base.environment()
    let layout = package.load_file_with(sys.fs, name, disk, text, build_request(sys))
    if len(layout.packages) == 1 and layout.problems.is_empty():
        var alone = file_input(sys, home, name, text, False, mut env, catalog)?
        # The files `embed` names, beside where the program stands (RULES.md,
        # R95).
        alone.embedded = embedded_files(sys, disk, None, text, catalog)
        alone.contracts = CONTRACTS_ALL
        alone.regions = regions.copy()
        return Ok((Some(alone), None))
    if layout.modules.is_empty():
        return Ok((None, Some(problems_report(layout, catalog))))
    var held: dict[String, String] = {}
    _ = held.insert(disk.to_string(), text.to_string())
    var built = held_layout_input(sys, home, layout, False, mut env, catalog, held)?
    built.contracts = CONTRACTS_ALL
    built.regions = regions.copy()
    return Ok((Some(built), None))

## `sir --repl SESSION INPUT --kept OUT [--load]` (RULES.md, R79): the
## program of a REPL session, SESSION's text (the session's program so far:
## its `#!` line, inline metadata and the inputs it kept, as the `OUT` of
## each gave them) with the input INPUT after it, as `sisu repl` runs it;
## its SIR on standard output, and in OUT the session's program with the
## input kept, which the driver gives the next input when the run keeps
## it. An input that is an expression alone is shown. With `--load`, INPUT
## is a file loaded into the session (`sisu repl FILE`): its `#!` line and
## inline metadata lead the program. A program that does not build is the
## diagnostics of the phase that stopped it, those in the input drawn in
## its text, as `<input>` (or the loaded file), the others in the
## session's, as `<repl>`, with no line after them.
def repl_command(
    sys: System, home: str, rest: list[String], catalog: Catalog
) -> ! {IoError, UsageError, CommandError}:
    let base = base_of(sys, home, std_texts(sys, home)?, catalog)
    return answered(repl_answer(sys, home, base, rest, catalog)?)

## What `sir --repl` answers with the base `base` (RULES.md, R79, R112).
def repl_answer(
    sys: System, home: str, base: typeck.Base, rest: list[String], catalog: Catalog
) -> Answer ! IoError:
    var files: list[String] = []
    var kept_path = String.new()
    var load = False
    var dir: String? = None
    var name = "<repl>".to_string()
    var k = 1
    while k < len(rest):
        let w = rest[k].copy()
        if w == "--load":
            load = True
        elif w == "--kept" and k + 1 < len(rest):
            kept_path = rest[k + 1].copy()
            k += 1
        elif w == "--dir" and k + 1 < len(rest):
            dir = Some(rest[k + 1].copy())
            k += 1
        elif w == "--name" and k + 1 < len(rest):
            name = rest[k + 1].copy()
            k += 1
        elif w.starts_with("--"):
            if w != "--repl":
                return Ok(Answer.misused())
        else:
            files.push(w)
        k += 1
    if len(files) != 2 or kept_path.is_empty():
        return Ok(Answer.misused())
    let held_text = sys.fs.read_to_string(Path.new(files[0]))?
    let input_text = sys.fs.read_to_string(Path.new(files[1]))?
    # The lines of the inputs it kept, which its last lines record
    # (`session.Region`), each named and numbered as its own (decision 690;
    # RULES.md, R123).
    let (session_text, held_regions) = session.regions_of(held_text)
    var head = session_text.copy()
    var entry = session.entry_of(input_text, catalog)
    var shown_name = "<input>".to_string()
    var shown_text = input_text.trim_end().to_string()
    var delta = 0
    if load:
        let (preamble, body, end) = session.split_preamble(input_text)
        var after = session_text.copy()
        if after.starts_with("#!"):
            after = String.new()
            if let Some(i) = session_text.find("\n"):
                after = session_text.byte_slice(i + 1, session_text.byte_len()).to_string()
        head = "{preamble}{after}"
        entry = session.Entry(source=body.copy(), prefix=0, len=body.trim_end().byte_len())
        shown_name = files[1].copy()
        shown_text = input_text.copy()
        delta = end
    elif not head.starts_with("#!"):
        head = "{session.SHEBANG}{head}"
    let at = head.byte_len() + entry.prefix
    # The kept inputs' lines, where the head holds them now, and the new
    # input's: the loaded file's numbered from where its body starts in it.
    let moved = session.line_count(head) - session.line_count(session_text)
    var regions = session.moved(held_regions, moved)
    let first = session.line_count(head) + 1
    var own_first = 1
    if load:
        own_first = session.line_count(input_text.byte_slice(0, delta)) + 1
    let last = first + session.line_count(entry.source) - 1
    let region = session.Region(
        first=first, last=last, shift=own_first - first, prefix=entry.prefix, name=shown_name.copy()
    )
    regions.push(region)
    let kept = "{head}{entry.source}{session.region_lines(regions)}"
    let program = "{kept}{session.TRAILER}"
    # The program stands in DIR, the working directory by default, which
    # `embed` and the inline metadata's paths are relative to, and is named
    # NAME, `<repl>` by default (RULES.md, R95).
    let disk = standing(sys, dir, name)
    match held_build(sys, home, base, name, disk, program, catalog, regions)?:
        case Sir(sir):
            sys.fs.write_text(Path.new(kept_path), kept)?
            return Ok(Answer.done(sir))
        case Stopped(r):
            return Ok(
                Answer.failed(rebased(r, at, entry.len, delta, shown_name, shown_text, catalog))
            )
        case Refused(why):
            return Ok(Answer.failed(why))

## `sir --worksheet FILE` (RULES.md, R79): the program `sisu ws` runs, the
## worksheet FILE (a script, a `#!` line added when it has none) with each
## top-level statement marked and shown (`session.instrument`), its SIR on
## standard output, keeping `System.fake`; or, when the worksheet as
## written does not build, the diagnostics of the phase that stopped it,
## drawn in the file as written, with no line after them.
def worksheet_command(
    sys: System, home: str, rest: list[String], catalog: Catalog
) -> ! {IoError, UsageError, CommandError}:
    let base = base_of(sys, home, std_texts(sys, home)?, catalog)
    return answered(worksheet_answer(sys, home, base, rest, catalog)?)

## What `sir --worksheet` answers with the base `base` (RULES.md, R79,
## R112).
def worksheet_answer(
    sys: System, home: str, base: typeck.Base, rest: list[String], catalog: Catalog
) -> Answer ! IoError:
    var files: list[String] = []
    var dir: String? = None
    var named: String? = None
    var k = 1
    while k < len(rest):
        let w = rest[k].copy()
        if w == "--dir" and k + 1 < len(rest):
            dir = Some(rest[k + 1].copy())
            k += 1
        elif w == "--name" and k + 1 < len(rest):
            named = Some(rest[k + 1].copy())
            k += 1
        elif w.starts_with("--"):
            if w != "--worksheet":
                return Ok(Answer.misused())
        else:
            files.push(w)
        k += 1
    if len(files) != 1:
        return Ok(Answer.misused())
    let source = sys.fs.read_to_string(Path.new(files[0]))?
    # The worksheet named NAME, the file as given by default, standing in
    # DIR, the file's own directory by default (RULES.md, R95).
    let file = named ?? files[0].copy()
    var disk = absolute(sys, files[0])
    if dir.is_some():
        disk = standing(sys, dir, base_name(file))
    let (stopped, instrumented) = instrumented_sheet(sys, home, base, file, disk, source, catalog)?
    if let Some(a) = stopped:
        return Ok(a.copy())
    match held_build(sys, home, base, file, disk, instrumented, catalog, [])?:
        case Sir(sir):
            return Ok(Answer.done(sir))
        case Stopped(r):
            return Ok(Answer.failed(r.human(catalog)))
        case Refused(why):
            return Ok(Answer.failed(why))

## The worksheet `source`, named `file` and standing at `disk`, with each
## top-level statement marked and shown (`session.instrument`, RULES.md,
## R79), or the answer of `sir --worksheet` when the worksheet as written
## does not build: the diagnostics of the phase that stopped it, drawn in
## the file as written.
def instrumented_sheet(
    sys: System, home: str, base: typeck.Base, file: str, disk: str, source: str, catalog: Catalog
) -> (Answer?, String) ! IoError:
    var sheet = source.to_string()
    var shift = 0
    var delta = 0
    if not source.starts_with("#!"):
        sheet = "{session.SHEBANG}{source}"
        shift = 1
        delta = session.SHEBANG.byte_len()
    match held_build(sys, home, base, file, disk, sheet, catalog, [])?:
        case Sir(_):
            pass
        case Stopped(r):
            # A top-level expression statement is shown, so its value is
            # used: an option or a result there is no `E0318` (RULES.md,
            # R103); what else stopped the worksheet is reported.
            let shown = session.shown_statements(sheet, catalog)
            var kept: list[Filed] = []
            for x in r.diags:
                if x.file == 0
                        and x.diag.msg == Msg.TypeUnusedResult
                        and shown.contains(x.diag.start):
                    continue
                kept.push(x.copy())
            let none_shown = len(kept) == len(r.diags)
            var rest_report = r.copy()
            rest_report.diags = kept
            if rest_report.errors(catalog) > 0 or none_shown:
                let shown_report = rebased(
                    rest_report, delta, source.byte_len(), 0, file, source, catalog
                )
                return Ok((Some(Answer.failed(shown_report)), String.new()))
        case Refused(why):
            return Ok((Some(Answer.failed(why)), String.new()))
    return Ok((None, session.instrument(sheet, shift, catalog)))

## `query values FILE` (RULES.md, R196): the values and the output of each
## top-level statement of the worksheet FILE, whose text is `text`, as
## `sisu ws` and the language server's inline values show them, from the
## program `sir --worksheet` writes, run by stage 1's evaluator: a line
## `LINE\tvalue\tVALUE` for each value a statement shows and
## `LINE\toutput\tTEXT` for each line it printed, by the line it ends on
## in the file as written, then where the evaluator stopped, the line of
## the statement it was running, `LINE\tstopped\tWHY` for what it does not
## run (the world among it) or `LINE\tpanicked\tMESSAGE`; nothing for a
## worksheet that does not build.
def sheet_values(
    sys: System, home: str, base: typeck.Base, file: str, text: str, catalog: Catalog
) -> String ! IoError:
    let disk = absolute(sys, file)
    let (stopped, instrumented) = instrumented_sheet(sys, home, base, file, disk, text, catalog)?
    if stopped.is_some():
        return Ok(String.new())
    let (input, report) = held_input(sys, home, base, file, disk, instrumented, catalog, [])?
    let built = input else:
        return Ok(String.new())
    if report.is_some():
        return Ok(String.new())
    var kept = Kept.new()
    let (_, done) = report_program(base, built, file, catalog, mut kept)
    let checked = done else:
        return Ok(String.new())
    var program = checked.program.copy()
    let hole = Param(name="hole".to_string(), value="{{hole}}".to_string())
    holes.close(mut program, catalog.render("panic.hole-closure", [hole]))
    let (printed, stop) = interp.run_sheet(program, SHEET_BUDGET, catalog)
    return Ok(sheet_lines(printed, stop))

## The steps a worksheet's run by the evaluator may take (RULES.md, R196),
## a hundred times a `comptime` expression's.
const SHEET_BUDGET: int = 100000000

## The lines of `query values` of what a worksheet's run printed, with the
## markers `__ws_at` and `__ws_show` write (`session.WS_HELPERS`), and why
## it stopped (RULES.md, R196).
pure def sheet_lines(printed: str, stop: interp.Stop?) -> String:
    var out = String.new()
    var current = 0
    for l in printed.split("\n"):
        if l.starts_with("\u{1}"):
            current = l.strip_prefix("\u{1}").trim().parse_int() ?? 0
            continue
        if l.starts_with("\u{2}"):
            let rest = l.strip_prefix("\u{2}")
            var cut = rest.byte_len()
            if let Some(at) = rest.find(" "):
                cut = at
            let n = rest.byte_slice(0, cut).parse_int() ?? 0
            var v = String.new()
            if cut < rest.byte_len():
                v = rest.byte_slice(cut + 1, rest.byte_len()).to_string()
            out.push("{n}\tvalue\t{query.field(v)}\n")
            continue
        out.push("{current}\toutput\t{query.field(l)}\n")
    # The text ends with a line break, whose empty last line is no output.
    if printed.is_empty() or printed.ends_with("\n"):
        let tail = "{current}\toutput\t\n"
        if out.ends_with(tail):
            out = out.byte_slice(0, out.byte_len() - tail.byte_len()).to_string()
    let Some(why) = stop else:
        return out
    match why:
        case interp.Stop.Panicked(m) | interp.Stop.Hole(m):
            out.push("{current}\tpanicked\t{query.field(m)}\n")
        case interp.Stop.Refinement(ty, value, predicate):
            out.push(
                "{current}\tpanicked\t{query.field("`{value}` is not a `{ty}`: `{predicate}`")}\n"
            )
        case interp.Stop.Budget:
            out.push("{current}\tstopped\t{query.field("its budget of {SHEET_BUDGET} steps")}\n")
        case interp.Stop.World(what):
            out.push("{current}\tstopped\t{query.field(what)}\n")
        case interp.Stop.NotKept(what):
            out.push("{current}\tstopped\t{query.field(what)}\n")
        case interp.Stop.Beyond(what):
            out.push("{current}\tstopped\t{query.field(what)}\n")
    return out

test "a worksheet's printed markers as the lines of `query values`":
    let printed = "\u{1}1\n\u{1}2\n\u{2}2 16\nadded 3\n\u{1}5\n"
    assert sheet_lines(printed, None) == "2\tvalue\t16\n2\toutput\tadded 3\n"
    let stopped = sheet_lines("\u{1}4\n", Some(interp.Stop.World("the standard error")))
    assert stopped == "4\tstopped\tthe standard error\n"

## Where a program held in memory stands on disk: `name`'s last part in
## `dir`, or `name` in the working directory without one (RULES.md, R95).
def standing(sys: System, dir: String?, name: str) -> String:
    let Some(d) = dir else:
        return absolute(sys, name)
    return package.join(absolute(sys, d), base_name(name))

## A path's last part: `sheet.ws.sisu` of `notes/sheet.ws.sisu`.
pure def base_name(path: str) -> String:
    var cut = 0
    for i in range(path.byte_len()):
        if path.byte_at(i) == 47:
            cut = i + 1
    return path.byte_slice(cut, path.byte_len()).to_string()

## The human form of a report of a session's program whose input is the
## `size` bytes from `start` of its first file: the diagnostics inside the
## input drawn in the text it is shown in, `shown` named `name`, where the
## input starts at `delta`, with their labels outside it in the program's
## file; then the others, in the program's files.
pure def rebased(
    r: Report, start: int, size: int, delta: int, name: str, shown: str, catalog: Catalog
) -> String:
    var files = [(name.to_string(), shown.to_string())]
    for f in r.files:
        files.push(f.copy())
    var mine: list[Filed] = []
    var other: list[Filed] = []
    for x in r.diags:
        if x.file != 0 or x.diag.start < start or x.diag.end > start + size:
            other.push(x.copy())
            continue
        var d = x.diag.copy()
        d.start = d.start - start + delta
        d.end = d.end - start + delta
        var label_files: list[int] = []
        for i in range(len(d.labels)):
            let f = x.label_file(i)
            let l = ref x.diag.labels[i]
            if f == 0 and l.start >= start and l.end <= start + size:
                d.labels[i].start = l.start - start + delta
                d.labels[i].end = l.end - start + delta
                label_files.push(0)
            else:
                label_files.push(f + 1)
        for i in range(len(d.fixes)):
            for j in range(len(d.fixes[i].edits)):
                let e = ref x.diag.fixes[i].edits[j]
                if e.start >= start and e.end <= start + size:
                    d.fixes[i].edits[j].start = e.start - start + delta
                    d.fixes[i].edits[j].end = e.end - start + delta
        mine.push(Filed(file=0, diag=d, label_files=label_files))
    var out = render_human_files(files, mine, catalog)
    if not other.is_empty():
        out.push(render_human_files(r.files, other, catalog))
    return out

## The front end's warnings of a program built in the release profile
## (D-061, 10 and 17; RULES.md, R27): each typed hole an error naming the
## hole and its type where the debug profile warns, with the placeholder
## that may ship, so that blocked is never a shipped state; and how many.
pure def release_report(warned: Report) -> (Report, int):
    var r = warned.copy()
    var diags: list[Filed] = []
    var holes = 0
    for x in warned.diags:
        var d = x.copy()
        if x.diag.msg == Msg.TypeHole:
            # The hole as its call is written, as the run time names it.
            let name = x.diag.param("name") ?? String.new()
            var hole = "`todo()`".to_string()
            if not name.is_empty():
                hole = "`todo({quote(name)})`"
            var diag = Diagnostic.new(Msg.TypeHoleInRelease, x.diag.start, x.diag.end)
            diag = diag.with("hole", hole).with("ty", x.diag.param("ty") ?? String.new())
            d.diag = diag.note(Msg.TypeHolePlaceholder)
            holes += 1
        diags.push(d)
    r.diags = diags
    return (r, holes)

## The exit status of `sisu test` when no test failed and a test is
## blocked by a typed hole (RULES.md, R27): neither passed (0) nor failed
## (1), since blocked is never a shipped state (17).
pub const TESTS_BLOCKED: int = 3

## Whether a word is an option of stage 0's test runner that takes a
## value.
pure def runner_value(w: str) -> bool:
    return match w:
        case "--jobs" | "--filter" | "--tag" | "--skip-tag" | "--schedule-seed": True
        case "--explore" | "--scheduler" | "--depth" | "--faults": True
        case _: False

## Whether a word is a flag of stage 0's test runner.
pure def runner_flag(w: str) -> bool:
    return match w:
        case "--no-monitor" | "--sim" | "--update" | "--no-cache": True
        case _: False

## `test [OPTIONS] [PATH]` (RULES.md, R27): each program the path names,
## checked and lowered with its tests by stage 1 as `sisu test` builds it,
## its diagnostics printed as `sisu test` prints them and a program with
## an error not run (`D0006`, `D0021`); then its SIR, written beside where
## `build` puts its executable, run by stage 0's runner (`sisu test
## --from-sir`, decision 285) with the runner's options, whose report is
## printed with each replay line naming the program. The status: 1 when a
## program has an error or a test failed, `TESTS_BLOCKED` when none did
## and a test is blocked by a typed hole, 0 when every test passed (or the
## runner's own, for its usage errors).
def test_command(sys: System, home: str, rest: list[String], catalog: Catalog) -> int ! IoError:
    let (request, given) = feature_request(rest, target_runtime(sys))
    var runner: list[String] = []
    var words: list[String] = []
    var k = 0
    while k < len(given):
        let w: str = given[k]
        if runner_value(w) and k + 1 < len(given):
            runner.push(given[k].copy())
            runner.push(given[k + 1].copy())
            k += 2
            continue
        if runner_flag(w):
            runner.push(given[k].copy())
            k += 1
            continue
        words.push(given[k].copy())
        k += 1
    let flags = ["--locked", "--no-default-features", "--accept-unsafe", "--std"]
    # `--std`: the standard library's doc examples are tests too, as `sisu
    # test --std` runs them (RULES.md, R185).
    let std_tests = words.contains("--std")
    var path = path_of(words, flags) else:
        emit("", "{usage()}\n")
        return Ok(2)
    if not names_path(words, flags):
        var direct = Out.direct()
        let found = nearest_package(sys, "test", catalog, mut direct) else:
            return Ok(1)
        path = found
    if let Some(e) = unknown_feature(sys, path, request):
        emit("", catalog.plain_error("cli.unknown-feature", e))
        return Ok(2)
    let locked = words.contains("--locked")
    let accept = words.contains("--accept-unsafe")
    var direct = Out.direct()
    if not write_lockfile(
        sys, path, False, locked, accept, catalog, "cli.errors-found", mut direct
    )?:
        return Ok(1)
    let base = base_of(sys, home, std_texts(sys, home)?, catalog)
    var kept = Kept.new()
    var env = base.environment()
    var programs: list[(Input, String)] = []
    match layouts_of(sys, path, False, request):
        case Some(layouts):
            for layout in layouts:
                if layout.modules.is_empty():
                    emit("", problems_report(layout, catalog).human(catalog))
                    return Ok(1)
                programs.push(
                    (layout_input(sys, home, layout, True, mut env, catalog)?, path.copy())
                )
        case None:
            for input in inputs_of(sys, home, path, False, True, request, mut env, catalog)?:
                programs.push((input.copy(), path.copy()))
    if std_tests:
        for k in range(len(programs)):
            programs[k].0.std_tests = True
    # Then each package's black-box tests, `tests/*.sisu` (17), a program
    # each whose dependency is the package (RULES.md, R65).
    for file in black_box_files(sys, path):
        for input in inputs_of(sys, home, file, False, True, request, mut env, catalog)?:
            programs.push((input.copy(), file.copy()))
    var failed = False
    var blocked = False
    for (input, shown) in programs:
        let (status, held) = test_program(sys, home, shown, input, runner, base, catalog, mut kept)?
        if status == 1:
            failed = True
        elif status != 0:
            return Ok(status)
        if held:
            blocked = True
    if failed:
        return Ok(1)
    if blocked:
        return Ok(TESTS_BLOCKED)
    return Ok(0)

## The black-box test files of the package or the workspace's members
## `arg` names (17): each package's `tests/*.sisu`, by name, as the
## command line names `arg` (RULES.md, R65).
def black_box_files(sys: System, arg: str) -> list[String]:
    let target = package.locate(sys.fs, absolute(sys, arg)) else:
        return []
    var dirs: list[String] = []
    match target:
        case Target.Package(d):
            dirs.push(d.copy())
        case Target.Workspace(_, members):
            dirs = members.copy()
        case Target.File(_):
            return []
    var out: list[String] = []
    for d in dirs:
        let tests = package.join(d, "tests")
        let entries = sys.fs.list_dir(Path.new(tests)) else:
            continue
        var files: list[String] = []
        for e in entries:
            let p = e.as_str().to_string()
            if p.ends_with(".sisu") and package.is_file(sys.fs, p):
                files.push(p)
        files.sort()
        for f in files:
            out.push(shown_beside(arg, absolute(sys, arg), f))
    return out

## The path `p` (absolute) as the command line would name it, given that
## `arg` names the directory `abs`.
pure def shown_beside(arg: str, abs: str, p: str) -> String:
    if p.starts_with("{abs}/"):
        let rest = p.byte_slice(abs.byte_len() + 1, p.byte_len())
        if arg == "." or arg.is_empty():
            return rest.to_string()
        return package.join(arg.strip_suffix("/"), rest)
    return p.to_string()

## One program's tests (`test_command`): the runner's status (1 for a
## program with an error, or a failed test), and whether a test is blocked.
def test_program(
    sys: System,
    home: str,
    path: str,
    input: Input,
    runner: list[String],
    base: typeck.Base,
    catalog: Catalog,
    mut kept: Kept,
) -> (int, bool) ! IoError:
    var built = input.copy()
    built.contracts = CONTRACTS_ALL
    let (r, sir) = report_with(base, built, path, catalog, mut kept, True, False)
    if let Some(why) = refusal(r, catalog, False):
        emit("", why)
        return Ok((1, False))
    emit("", r.human(catalog))
    let exe = output_for(built.disk, built.package_name, built.build_root.copy(), False)
    _ = sys.fs.create_dir(Path.new(parent(exe)))
    let sir_file = "{exe}.sir"
    sys.fs.write_text(Path.new(sir_file), sir)?
    let sisu = "{home}/target/release/sisu"
    var args: list[str] = ["test", "--from-sir", sir_file]
    for i in range(len(runner)):
        args.push(runner[i])
    let ran = sys.proc.run(sisu, args)
    _ = sys.fs.remove(Path.new(sir_file))
    match ran:
        case Ok(o):
            # A replay line names the program, which `sisu test` runs again.
            let shown = o.stdout.replace(" {sir_file}\n", " {path}\n")
            emit(shown, o.stderr)
            let (_, failures, holes) = test_summary(o.stdout) ?? (0, 0, 0)
            if o.status != 0 and failures == 0:
                return Ok((o.status, False))
            if failures > 0:
                return Ok((1, holes > 0))
            return Ok((0, holes > 0))
        case Err(e):
            emit("", "cannot run `{sisu}`: {e}\n")
            return Ok((1, False))

## Why a program built with its tests is not run, as `sisu test` says it:
## the front end's diagnostics and `D0006` at its errors; else its
## warnings, then the failed `comptime` expressions and `D0006`, or the
## ownership checker's errors and `D0021`, or why stage 1 cannot tell;
## `None` when it runs. With `ids`, the diagnostics are in the conformance
## form, as `check --format=ids` prints them (RULES.md, R47).
pure def refusal(r: Report, catalog: Catalog, ids: bool) -> String?:
    let front = r.front(catalog, None)
    let errors = front.errors(catalog)
    var beyond = String.new()
    for b in r.beyond:
        beyond.push("beyond the slice: {b}\n")
    if errors > 0:
        var errs = shown_report(front, catalog, ids)
        let count = Param(name="count".to_string(), value="{errors}")
        errs.push(catalog.plain_error("cli.errors-found", [count]))
        errs.push(beyond)
        return Some(errs)
    var errs = shown_report(r.front(catalog, Some(False)), catalog, ids)
    let evaluation = r.evaluation()
    let failed = evaluation.errors(catalog)
    if failed > 0:
        errs.push(shown_report(evaluation, catalog, ids))
        let count = Param(name="count".to_string(), value="{failed}")
        errs.push(catalog.plain_error("cli.errors-found", [count]))
        return Some(errs)
    let ownership = r.ownership()
    let owned = ownership.errors(catalog)
    if owned > 0:
        errs.push(shown_report(ownership, catalog, ids))
        let count = Param(name="count".to_string(), value="{owned}")
        errs.push(catalog.plain_error("cli.ownership-errors", [count]))
        return Some(errs)
    if not beyond.is_empty():
        errs.push(beyond)
        return Some(errs)
    return None

## A report in the conformance form with `ids`, else the human one.
pure def shown_report(r: Report, catalog: Catalog, ids: bool) -> String:
    if ids:
        return r.ids(catalog)
    return r.human(catalog)

## The counts of the runner's last line, `N passed, M failed, K blocked`.
def test_summary(out: str) -> (int, int, int)?:
    var found: (int, int, int)? = None
    for line in out.lines():
        let parts = line.split(", ").collect()
        if len(parts) != 3:
            continue
        let passed = count_before(parts[0], " passed") else:
            continue
        let failed = count_before(parts[1], " failed") else:
            continue
        let blocked = count_before(parts[2], " blocked") else:
            continue
        found = Some((passed, failed, blocked))
    return found

## The number that `text` is followed by `word` in, as `3 passed`.
pure def count_before(text: str, word: str) -> int?:
    if not text.ends_with(word):
        return None
    let digits = text.byte_slice(0, text.byte_len() - word.byte_len())
    if digits.is_empty():
        return None
    var n = 0
    for c in digits.chars():
        if c < '0' or c > '9':
            return None
        n = n * 10 + (c.code() - '0'.code())
    return Some(n)

## A level of `--contracts` (07): `off`, `preconditions` or `all`.
pure def contract_level(word: str) -> int?:
    return match word:
        case "off": Some(CONTRACTS_OFF)
        case "preconditions": Some(CONTRACTS_PRECONDITIONS)
        case "all": Some(CONTRACTS_ALL)
        case _: None

## Where `build` puts the executable (stage 0's `output_for`, decision
## 231): a package's in `build/PROFILE/NAME` in the directory of its
## lockfile, its workspace's or its own (`root`; without one, the
## package's, whose root module is `src/main.sisu`), the profile `release`
## for a release build and `debug` otherwise; a file's beside it, named by
## its stem.
pure def output_for(disk: str, package_name: str, root: String?, release: bool) -> String:
    if not package_name.is_empty():
        let dir = root.copy() ?? parent(parent(disk))
        let profile = if release: "release" else: "debug"
        return package.join(dir, "build/{profile}/{package_name}")
    if disk.ends_with(".sisu"):
        return disk.byte_slice(0, disk.byte_len() - 5).to_string()
    return disk.to_string()

## Writes the lockfile of the program `arg` names when it changed, as stage
## 0's driver does before a command works on a package (09): beside the
## workspace's manifest for a workspace or a member of one, with every
## package any member's build resolved, else beside the package's own; not
## for a file, nor when a manifest the lockfile covers has an error, nor for
## `sir` in a workspace without one application (`cli.workspace-run`). With
## `locked` (`--locked`), a lockfile that would change is reported instead
## (`cli.locked`, with what changes), and the command stops: `False`.
## A level that rises is an error of the manifests (RULES.md, R85): a
## command that stops at errors says so after it, with `stopped`, the
## message of its line (`D0006`, `D0132`), as after `E1019` and `E1021`.
def write_lockfile(
    sys: System,
    arg: str,
    sir: bool,
    locked: bool,
    accept_unsafe: bool,
    catalog: Catalog,
    stopped: str,
    mut o: Out,
) -> bool ! IoError:
    let abs = absolute(sys, arg)
    let target = package.locate(sys.fs, abs) else:
        return Ok(True)
    var lock: (String, String)? = None
    var first: Layout? = None
    match target:
        case Target.File(_):
            return Ok(True)
        case Target.Workspace(root, members):
            let all = member_layouts(sys, members)
            if all.is_empty():
                return Ok(True)
            if sir and len(applications(sys, members)) != 1:
                return Ok(True)
            first = Some(all[0].copy())
            lock = workspace_lock(root, all, catalog)
        case Target.Package(d):
            let layout = package.load_package(sys.fs, d, d)
            first = Some(layout.copy())
            match package.workspace_of(sys.fs, d):
                case Some((root, members)):
                    var all: list[Layout] = []
                    for m in members:
                        all.push(package.load_package(sys.fs, m, m))
                    lock = workspace_lock(root, all, catalog)
                case None:
                    if let Some(at) = layout.lock.copy():
                        lock = Some((at.copy(), package.lockfile_of([layout.copy()], parent(at))))
    let (at, text) = lock else:
        return Ok(True)
    let layout = first else:
        return Ok(True)
    if layout.has_errors(catalog):
        return Ok(True)
    var old: String? = None
    if let Ok(t) = sys.fs.read_to_string(Path.new(at)):
        old = Some(t)
    if old == Some(text.copy()):
        return Ok(True)
    # A package whose `unsafe` level rises past what the lockfile records
    # waits for `--accept-unsafe` (22, D-082), which unattended runs never
    # pass.
    if let Some(was) = old:
        if not accept_unsafe:
            if let Some(err) = raised_level(was, text, catalog):
                var errs = err.copy()
                if not stopped.is_empty():
                    let count = Param(name="count".to_string(), value="1")
                    errs.push(catalog.plain_error(stopped, [count]))
                o.emit("", errs)
                return Ok(False)
    if locked:
        var what = "there is none".to_string()
        if let Some(was) = old:
            what = diff.lines(was, text)
        let params = [Param(name="what".to_string(), value=what)]
        o.emit("", catalog.plain_error("cli.locked", params))
        return Ok(False)
    sys.fs.write_text(Path.new(at), text)?
    return Ok(True)

## `package.unsafe-raised` for the first package whose `unsafe` level the
## new lockfile `text` records above what the old one, `old`, does (none to
## `memory`, `memory` to `extern`); a package the old one does not record
## is new, which admission reviews (09).
pure def raised_level(old: str, text: str, catalog: Catalog) -> String?:
    let before = package.locked_levels(old)
    for (name, level) in package.locked_levels(text):
        for (n, was) in before:
            if n != name or package.level_rank(level) <= package.level_rank(was):
                continue
            let shown = if was.is_empty(): "no `unsafe`".to_string() else: "`unsafe = \"{was}\"`"
            let params = [
                Param(name="name".to_string(), value=name.copy()),
                Param(name="old".to_string(), value=shown),
                Param(name="level".to_string(), value=level.copy()),
            ]
            return Some(catalog.plain_error("package.unsafe-raised", params))
    return None

## The members of a workspace with an application (`src/main.sisu`), the
## ones `sir` and `run` choose among.
def applications(sys: System, members: list[String]) -> list[String]:
    var out: list[String] = []
    for d in members:
        if package.is_file(sys.fs, package.join(d, "src/main.sisu")):
            out.push(d.copy())
    return out

## `cli.workspace-run` for `sisu sir` of a workspace whose members, each a
## package, do not have exactly one application, naming every member as
## stage 0 names it, relative to the working directory.
def workspace_run_error(sys: System, arg: str, catalog: Catalog) -> String?:
    let target = package.locate(sys.fs, absolute(sys, arg)) else:
        return None
    let Target.Workspace(_, members) = target else:
        return None
    if member_layouts(sys, members).is_empty() or len(applications(sys, members)) == 1:
        return None
    let cwd = absolute(sys, ".")
    var names: list[String] = []
    for m in members:
        names.push("`{package.relative(cwd, package.canonical(m))}`")
    let params = [
        Param(name="command".to_string(), value="sir".to_string()),
        Param(name="members".to_string(), value=names.join(", ")),
    ]
    return Some(catalog.plain_error("cli.workspace-run", params))

## The package of the working directory or the nearest directory above it,
## which a command that names no path works on (stage 0's `locate` without
## an argument): `None`, after `cli.no-package`, when there is none.
def nearest_package(sys: System, command: str, catalog: Catalog, mut o: Out) -> String?:
    let cwd = absolute(sys, ".")
    var dir = cwd.copy()
    while True:
        if package.is_file(sys.fs, package.join(dir, package.MANIFEST)):
            return Some(dir)
        if dir == "/":
            break
        dir = package.parent(dir)
    let params = [
        Param(name="dir".to_string(), value=cwd),
        Param(name="command".to_string(), value=command.to_string()),
    ]
    o.emit("", catalog.plain_error("cli.no-package", params))
    return None

## Whether the words after a command name a path, beside the options
## `flags`.
pure def names_path(rest: list[String], flags: list[str]) -> bool:
    for k in range(1, len(rest)):
        var flag = False
        for f in flags:
            if rest[k] == f:
                flag = True
        if not flag:
            return True
    return False

## The layouts of a workspace's members; none when a member has no
## manifest, which stage 0 reports before anything is written.
def member_layouts(sys: System, members: list[String]) -> list[Layout]:
    var out: list[Layout] = []
    for m in members:
        if not package.is_file(sys.fs, package.join(m, package.MANIFEST)):
            return []
        out.push(package.load_package(sys.fs, m, m))
    return out

## A workspace's lockfile, beside its manifest, unless a member's layout
## has an error.
pure def workspace_lock(root: str, all: list[Layout], catalog: Catalog) -> (String, String)?:
    for l in all:
        if l.has_errors(catalog):
            return None
    let at = package.join(root, package.LOCKFILE)
    return Some((at, package.lockfile_of(all, root)))

## A path without its last component.
pure def parent(p: str) -> String:
    var cut = -1
    for i in range(p.byte_len()):
        if p.byte_at(i) == 47:
            cut = i
    if cut <= 0:
        return ".".to_string()
    return p.byte_slice(0, cut).to_string()

## What a run keeps of the standard library from one program to the next:
## its bodies as the type checker typed them (`typeck.StdBodies`), the
## functions lowering made of them (`lower.StdLowered`), and those
## functions as the ownership checker placed their drops
## (`borrowck.Placed`).
struct Kept:
    bodies: typeck.StdBodies
    lowered: lower.StdLowered
    slots: lower.StdSlots
    placed: borrowck.Placed

impl Kept:
    pure def new() -> Kept:
        return Kept(
            bodies=typeck.StdBodies.new(),
            lowered=lower.StdLowered.new(),
            slots=lower.StdSlots.new(),
            placed=borrowck.Placed.new(),
        )

## Where `sir-batch` spends its time, in nanoseconds: the front end, the
## lowering, and the ownership checker with the writing of the SIR.
struct SirTimes:
    check: int
    lower: int
    ownership: int

## The prelude's names, with the std modules every module sees without an
## import (stage 0's `std_sources::AMBIENT`, and `target`), whose variants
## are visible too.
def environment(sys: System, home: str) -> Environment ! IoError:
    let text = sys.fs.read_to_string(Path.new("{home}/std/prelude.sisu"))?
    var prelude = ModuleNames.of(text, parse(text, Catalog.parse("")).tree)
    var std: dict[String, ModuleNames] = {}
    for module in ["task", "log", "cap", "live"]:
        let source = sys.fs.read_to_string(Path.new("{home}/std/{module}.sisu"))?
        let names = ModuleNames.of(source, parse(source, Catalog.parse("")).tree)
        for v in names.variants:
            _ = prelude.variants.add(v.copy())
        _ = prelude.items.add(module.to_string())
        _ = std.insert(module.to_string(), names)
    _ = prelude.items.add("target".to_string())
    return Ok(Environment(prelude=prelude, std=std))

## The base of a command that checks a program, made with the cache
## beside the native stage-1 executable when it holds what the base made
## of these std sources with this executable (`typeck.BaseCache`), and
## made whole, then kept there, otherwise: a base made from the cache
## leaves the std modules a program may import unparsed until one imports
## them, and is the same base (README, "Where the time goes"). A batch
## makes its base whole, once for every program it checks.
def base_of(sys: System, home: str, texts: dict[String, String], catalog: Catalog) -> typeck.Base:
    let place = base_cache_place(sys, home) else:
        return typeck.base(texts, catalog)
    let (path, exe) = place
    let key = base_cache_key(sys, home, texts, exe) else:
        return typeck.base(texts, catalog)
    if let Ok(text) = sys.fs.read_to_string(Path.new(path)):
        if let Some(cache) = read_base_cache(text, key):
            return typeck.base_cached(texts, catalog, cache)
    let base = typeck.base(texts, catalog)
    write_base_cache(sys, path, key, typeck.cache_of(base))
    return base

## The version of the base cache's form.
const BASE_CACHE_FORM: int = 2

## Where the cache of the base goes, and what tells the executable: in the
## directory of the native stage-1 executable, `target/stage1/` under the
## compiler's directory (reached through `std/`, as `std_file` reaches
## stage 1's own std modules), named by the running executable's size and
## time, which a build changes. Stage 1 run on the interpreter, whose
## executable is stage 0's `sisu`, keeps none: its own code is not what
## the executable says.
def base_cache_place(sys: System, home: str) -> (String, String)?:
    let exe = sys.fs.metadata(Path.new("/proc/self/exe")) else:
        return None
    let stage0 = Path.new("{home}/std/../target/release/sisu")
    if let Ok(s) = sys.fs.metadata(stage0):
        if s.len == exe.len and "{s.modified}" == "{exe.modified}":
            return None
    let dir = "{home}/std/../target/stage1"
    if not sys.fs.exists(Path.new(dir)):
        return None
    let id = module_hash("{exe.len} {exe.modified}")
    return Some(("{dir}/base-{id}.cache", id))

## The key of a base made of `texts` with the executable `exe`: the hash of
## the cache's form, the executable, and each std source's name, size and
## time, which a change of the file changes (its bytes are not read again).
def base_cache_key(sys: System, home: str, texts: dict[String, String], exe: str) -> String?:
    var names: list[String] = []
    for (name, _) in texts.items():
        # The target is no file; what the cache holds does not depend on
        # it (RULES.md, R116).
        if name == "target":
            continue
        names.push(name.copy())
    names.sort()
    var all = String.new()
    all.push("{BASE_CACHE_FORM} {exe}\n")
    for name in names:
        let m = sys.fs.metadata(Path.new(std_file(home, name))) else:
            return None
        all.push("{name} {m.len} {m.modified}\n")
    return Some(module_hash(all))

## The cache's text: its form and key, each std module's derived impls
## with their length in bytes, the promotions of each module, the modules
## that hold templates and `unsafe` code, and the key again, which a
## reader finds last only in a file written whole.
pure def base_cache_text(key: str, cache: typeck.BaseCache) -> String:
    var out = String.new()
    out.push("sisu1 base cache {BASE_CACHE_FORM}\nkey {key}\n")
    var names: list[String] = []
    for (name, _) in cache.derived.items():
        names.push(name.copy())
    names.sort()
    out.push("derived {len(names)}\n")
    for name in names:
        var text = String.new()
        if let Some(t) = cache.derived.get(name.copy()):
            text = t.copy()
        out.push("{name} {text.byte_len()}\n")
        out.push(text)
        out.push("\n")
    var modules: list[String] = []
    for (name, _) in cache.promoted.items():
        modules.push(name.copy())
    modules.sort()
    out.push("promoted {len(modules)}\n")
    for name in modules:
        var fs: list[String] = []
        if let Some(found) = cache.promoted.get(name.copy()):
            fs = found.copy()
        out.push("{name} {len(fs)}\n")
        for f in fs:
            out.push("{f}\n")
    # The importable modules that hold templates, and `unsafe` code
    # (RULES.md, R125).
    let marks = [
        ("reflecting", cache.marked.reflecting.copy()), ("unsafe", cache.marked.unsafe_code.copy())
    ]
    for (word, names) in marks:
        out.push("{word} {len(names)}\n")
        for name in names:
            out.push("{name}\n")
    out.push("end {key}\n")
    return out

## A cache's text read back, when it is whole and its key is `key`.
pure def read_base_cache(text: str, key: str) -> typeck.BaseCache?:
    var r = CacheReader(text=text, at=0)
    if r.line()? != "sisu1 base cache {BASE_CACHE_FORM}":
        return None
    if r.line()? != "key {key}":
        return None
    let (word, count) = r.counted()?
    if word != "derived":
        return None
    var derived: dict[String, String] = {}
    for _ in range(count):
        let (name, n) = r.counted()?
        let body = r.bytes(n)?
        if r.line()? != "":
            return None
        _ = derived.insert(name.to_string(), body.to_string())
    let (word2, modules) = r.counted()?
    if word2 != "promoted":
        return None
    var promoted: dict[String, list[String]] = {}
    for _ in range(modules):
        let (name, n) = r.counted()?
        var fs: list[String] = []
        for _ in range(n):
            let f = r.line()?
            fs.push(f.to_string())
        _ = promoted.insert(name.to_string(), fs)
    var marks: list[list[String]] = []
    for expected in ["reflecting", "unsafe"]:
        let (word3, n) = r.counted()?
        if word3 != expected:
            return None
        var names: list[String] = []
        for _ in range(n):
            let name = r.line()?
            names.push(name.to_string())
        marks.push(names)
    if r.line()? != "end {key}" or r.at != text.byte_len():
        return None
    let marked = StdMarks(reflecting=marks[0].copy(), unsafe_code=marks[1].copy())
    return Some(typeck.BaseCache(derived=derived, promoted=promoted, marked=marked))

## Writes the cache aside, `base-ID.cache.N.aside` with `N` drawn at
## random, and renames it over the old one (`Fs.rename`, decision 420), so
## that a reader finds the old cache or the new one, never a part of
## either; then removes the caches of other executables. A cache that
## cannot be written is none: its aside goes, and the old one stays.
def write_base_cache(sys: System, path: str, key: str, cache: typeck.BaseCache):
    let aside = "{path}.{sys.rand.bits() & 0xffffffff}.aside"
    if sys.fs.write_text(Path.new(aside), base_cache_text(key, cache)).is_err():
        _ = sys.fs.remove(Path.new(aside))
        return
    if sys.fs.rename(Path.new(aside), Path.new(path)).is_err():
        _ = sys.fs.remove(Path.new(aside))
        return
    let dir = parent(path)
    let mine = file_stem(path)
    let entries = sys.fs.list_dir(Path.new(dir)) else:
        return
    for p in entries:
        let name = file_stem("{p}")
        if not name.starts_with("base-") or name.starts_with("{mine}."):
            continue
        # Another executable's cache, or what a write of one left aside.
        if (name != mine and "{p}".ends_with(".cache")) or "{p}".ends_with(".aside"):
            _ = sys.fs.remove(p)

## A reader of the cache's text, line by line.
view struct CacheReader:
    text: str
    at: int

impl CacheReader:
    ## The next line, without its line break.
    pure def line(mut self) -> str?:
        if self.at >= self.text.byte_len():
            return None
        let rest = self.text.byte_slice(self.at, self.text.byte_len())
        let i = rest.find("\n") else:
            return None
        self.at += i + 1
        return Some(rest.byte_slice(0, i))

    ## A line `WORD COUNT`.
    pure def counted(mut self) -> (str, int)?:
        let l = self.line()?
        let (word, n) = l.split_once(" ")?
        return Some((word, n.parse_int()?))

    ## The next `n` bytes.
    pure def bytes(mut self, n: int) -> str?:
        if n < 0 or self.at + n > self.text.byte_len():
            return None
        let out = self.text.byte_slice(self.at, self.at + n)
        self.at += n
        return Some(out)

## The sources of the std modules, by name: the prelude, the ambient
## modules and those a program may import.
def std_texts(sys: System, home: str) -> dict[String, String] ! IoError:
    var texts: dict[String, String] = {}
    var names = ["prelude", "task", "log", "cap", "live"]
    for name in importable():
        names.push(name)
    for name in names:
        _ = texts.insert(name.to_string(), sys.fs.read_to_string(Path.new(std_file(home, name)))?)
    # A build for another runtime than the interpreter, or of a package for
    # another runtime profile than `full`, has its `target` (RULES.md, R116
    # and R122).
    let runtime = target_runtime(sys)
    let profile = runtime_profile(sys)
    if runtime != "interpreter" or profile != "full":
        _ = texts.insert("target".to_string(), target_for(runtime, profile))
    return Ok(texts)

## The runtime profile of the package the command works on (12, "Runtime
## profiles"; RULES.md, R122), which `target.runtime_profile` gives
## compile-time code: its manifest's `[package] runtime`, read before the
## base is made, `full` without one. The package is the directory an
## argument after the command names, or, when no argument names a file or
## a directory, the nearest one at or above the working directory; a file
## is a program of its own, `full`.
def runtime_profile(sys: System) -> String:
    let args = sys.env.args()
    var named = False
    for i in range(len(args)):
        let a = args[i]
        if i == 0 or a.starts_with("-") or (i > 0 and valued(args[i - 1])):
            continue
        let p = Path.new(a)
        if a.ends_with(".sisu") and sys.fs.exists(p):
            return "full".to_string()
        let manifest = package.join(a, package.MANIFEST)
        if package.is_file(sys.fs, manifest):
            return profile_of(sys, manifest)
        if sys.fs.exists(p):
            named = True
    if named:
        return "full".to_string()
    var dir = absolute(sys, ".")
    while True:
        let manifest = package.join(dir, package.MANIFEST)
        if package.is_file(sys.fs, manifest):
            return profile_of(sys, manifest)
        if dir == "/":
            break
        dir = package.parent(dir)
    return "full".to_string()

## Whether a command's option takes the argument after it as its value: a
## directory or file that is not the program's.
pure def valued(option: str) -> bool:
    return option == "--home"
        or option == "--catalog"
        or option == "--dir"
        or option == "--kept"
        or option == "--output"
        or option == "--name"
        or option == "--target-runtime"

## The runtime profile a manifest's `[package]` names, `full` when it names
## none or cannot be read.
def profile_of(sys: System, manifest: str) -> String:
    let text = sys.fs.read_to_string(Path.new(manifest)) else:
        return "full".to_string()
    let (m, _) = manifest_read(text)
    if let Some(found) = m:
        if let Some(info) = found.package:
            return info.runtime.copy()
    return "full".to_string()

## The runtime the program is built for (RULES.md, R116): what
## `--target-runtime` names, `interpreter` without it, as `target.runtime`
## gives it to compile-time code. The driver names `native` for a native
## build.
def target_runtime(sys: System) -> String:
    let args = sys.env.args()
    for i in range(len(args)):
        if args[i] == "--target-runtime" and i + 1 < len(args):
            return args[i + 1].to_string()
    return "interpreter".to_string()

## The files the `embed("path")` calls of `text` name, read relative to
## the file at `path` (stage 0's `embedded_files`): each text, or why it
## could not be read, in words of its own, the same on every machine.
def embedded_files(
    sys: System, path: str, root: String?, text: str, catalog: Catalog
) -> dict[String, Embedded]:
    var out: dict[String, Embedded] = {}
    if not text.contains("embed("):
        return out
    var dir = ".".to_string()
    var cut = -1
    for i in range(text_len(path)):
        if path.byte_at(i) == 47:
            cut = i
    if cut >= 0:
        dir = path.byte_slice(0, cut).to_string()
    # A package's module names its files from the package's root (08: "the
    # path resolved relative to the package root"; RULES.md, R31), a single
    # file from its directory.
    if let Some(r) = root:
        dir = r.copy()
    let module = build.module(parse(text, catalog).tree)
    for e in visit.exprs_in_items(module.ast, module.items):
        let ExprKind.Call(callee, args, _) = module.ast.expr(e).kind.copy() else:
            continue
        var named_embed = False
        if let ExprKind.Name(n) = module.ast.expr(callee).kind:
            named_embed = n == "embed"
        if not named_embed or len(args) != 1:
            continue
        let ExprKind.Str(parts) = module.ast.expr(args[0].value).kind.copy() else:
            continue
        var plain = True
        for p in parts:
            if let StrPart.Interp(_, _, _, _) = p:
                plain = False
        if not plain:
            continue
        let file = build.plain_text(parts)
        if out.contains(file.copy()):
            continue
        var inside = not file.starts_with("/")
        for part in file.split("/"):
            if part == "..":
                inside = False
        var read = Embedded.Failed("the path must stay inside the program's directory".to_string())
        if inside:
            match sys.fs.read_to_string(Path.new("{dir}/{file}")):
                case Ok(t):
                    read = Embedded.Read(t)
                case Err(NotFound(_)):
                    read = Embedded.Failed("there is no such file".to_string())
                case Err(PermissionDenied(_)):
                    read = Embedded.Failed("it may not be read".to_string())
                case Err(InvalidData(_)):
                    read = Embedded.Failed("it is not UTF-8 text".to_string())
                case Err(_):
                    read = Embedded.Failed("it cannot be read".to_string())
        _ = out.insert(file, read)
    return out

pure def text_len(s: str) -> int:
    return s.byte_len()

## The syntax diagnostics of `text`, its name diagnostics as stage 0's
## name pass reports them for a build with or without its tests, after
## loading the std modules it imports into `env`, and the problems of its
## `@cfg`s.
def name_diagnostics(
    sys: System,
    home: str,
    text: str,
    tests: bool,
    features: Features,
    mut env: Environment,
    catalog: Catalog,
) -> (list[Diagnostic], list[Diagnostic], list[Diagnostic]) ! IoError:
    let parsed = parse(text, catalog)
    let (tree, cfg_diags) = built_tree(text, parsed.tree, tests, features)
    for module in imported_std_modules(text, tree):
        if not env.std.contains(module.copy()):
            let source = sys.fs.read_to_string(Path.new(std_file(home, module)))?
            let names = ModuleNames.of(source, parse(source, catalog).tree)
            _ = env.std.insert(module.copy(), names)
    let (absent, discarded) = target_absences(text, parsed.tree, features)
    let found = with_absences(
        resolve.resolve(text, tree, parsed.diagnostics, env, catalog), absent, discarded
    )
    return Ok((parsed.diagnostics.copy(), found, cfg_diags))

## A module's syntax tree as a build with or without its tests compiles it
## (decision 243): without the items and methods its `@cfg`s or the build
## leave out, which the name pass then passes by (`cfg.filter`); and the
## problems of its `@cfg`s, as diagnostics.
pure def built_tree(
    text: str, tree: Tree, tests: bool, features: Features
) -> (Tree, list[Diagnostic]):
    # Nothing to leave out of a module that names no `@cfg`, built with its
    # tests.
    if tests and not text.contains("cfg"):
        return (tree.copy(), [])
    let filtered = cfg.filter(build.module(tree), tests, Some(features.copy()))
    var diags: list[Diagnostic] = []
    for p in filtered.problems:
        var d = cfg_diagnostic(p)
        # A condition on the target, which a body tests with `if comptime`
        # (08; RULES.md, R101).
        if d.msg == Msg.ResolveBadCfg and d.start < d.end and d.end <= text.byte_len():
            let written = text.byte_slice(d.start, d.end)
            if written.starts_with("target."):
                d = d.note_with(Msg.ResolveCfgTarget, "condition", written)
        diags.push(d)
    if filtered.left_out.is_empty():
        return (tree.copy(), diags)
    return (tree.without(filtered.left_out), diags)

## A problem of a `@cfg` as stage 0's driver reports it.
pure def cfg_diagnostic(p: cfg.Problem) -> Diagnostic:
    return match p:
        case cfg.Problem.NotACondition(at): Diagnostic.new(Msg.ResolveBadCfg, at.start, at.end)
        case cfg.Problem.UnknownFeature(at, name): Diagnostic.new(
            Msg.ResolveUnknownFeature, at.start, at.end
        ).with("name", name)

## The absolute form of a path given on the command line: relative to the
## working directory, which the shell's `PWD` names.
def absolute(sys: System, p: str) -> String:
    if p.starts_with("/"):
        return package.canonical(p)
    let cwd = sys.env.get("PWD") ?? "."
    return package.canonical(package.join(cwd, p))

## The layouts of the program a command's argument names, when it is a
## program of several modules or packages (stage 0's `locate`,
## `load_package` and `load_file`): a package's directory, a workspace's
## (each member's, or for `sir` the one application's), or a script with
## dependencies or broken metadata. `None` for a file that is a program of
## one module on its own.
def layouts_of(sys: System, arg: str, sir: bool, request: FeatureRequest) -> list[Layout]?:
    let abs = absolute(sys, arg)
    let target = package.locate(sys.fs, abs) else:
        return Some([])
    if let Target.File(f) = target:
        let text = package.read_text(sys.fs, f) ?? String.new()
        let layout = package.load_file_with(sys.fs, package.file_name(f), f, text, request)
        if len(layout.packages) == 1 and layout.problems.is_empty():
            return None
        return Some([layout])
    return Some(package.load_target(sys.fs, target, sir, request))

## What a command line that names no feature asks for, in a build for the
## runtime `--target-runtime` names (RULES.md, R128).
def build_request(sys: System) -> FeatureRequest:
    return FeatureRequest.none().for_runtime(target_runtime(sys))

## The features the words of a command line ask for (`--features NAMES`,
## any number of times, the names separated by commas or spaces;
## `--no-default-features`; decision 250), and the words without
## `--features` and its value.
pure def feature_request(rest: list[String], runtime: str) -> (FeatureRequest, list[String]):
    var request = FeatureRequest.none().for_runtime(runtime)
    var words: list[String] = []
    var k = 0
    while k < len(rest):
        var value: String? = None
        if rest[k] == "--features":
            if k + 1 < len(rest):
                value = Some(rest[k + 1].copy())
            else:
                value = Some(String.new())
            k += 2
        elif rest[k].starts_with("--features="):
            value = Some(rest[k].byte_slice(11, rest[k].byte_len()).to_string())
            k += 1
        else:
            if rest[k] == "--no-default-features":
                request.no_default = True
            words.push(rest[k].copy())
            k += 1
            continue
        if let Some(v) = value:
            var name = String.new()
            for c in v.chars():
                if c == ',' or c.is_whitespace():
                    if not name.is_empty():
                        request.names.push(name.copy())
                    name = String.new()
                else:
                    name.push_char(c)
            if not name.is_empty():
                request.names.push(name)
    return (request, words)

## The first name `--features` gives that is not a feature of the package
## it names (`cli.unknown-feature`, `D0112`, decision 250), with that
## package, as stage 0's driver reports it before it writes a lockfile: a
## file that is no script declares none, and is named as it was given.
def unknown_feature(sys: System, arg: str, request: FeatureRequest) -> list[Param]?:
    if request.names.is_empty():
        return None
    let target = package.locate(sys.fs, absolute(sys, arg)) else:
        return None
    var layouts: list[Layout] = []
    if let Target.File(f) = target:
        let text = package.read_text(sys.fs, f) ?? String.new()
        layouts.push(package.load_file_with(sys.fs, arg, f, text, request))
    else:
        layouts = package.load_target(sys.fs, target, False, request)
    for l in layouts:
        if let Some((name, owner)) = l.unknown_requested.first():
            return Some(
                [
                    Param(name="name".to_string(), value=name.copy()),
                    Param(name="package".to_string(), value=owner.copy()),
                ]
            )
    return None

## The modules of a layout, read and parsed, each as a build with or
## without its tests compiles it, after loading the std modules they import
## into `env`; and the problems of each one's `@cfg`s.
def named_modules(
    sys: System, home: str, layout: Layout, tests: bool, mut env: Environment, catalog: Catalog
) -> (list[NamedModule], list[list[Diagnostic]]) ! IoError:
    return held_named_modules(sys, home, layout, tests, mut env, catalog, {})

## `named_modules`, with the texts `held` holds instead of the files'.
def held_named_modules(
    sys: System,
    home: str,
    layout: Layout,
    tests: bool,
    mut env: Environment,
    catalog: Catalog,
    held: dict[String, String],
) -> (list[NamedModule], list[list[Diagnostic]]) ! IoError:
    var out: list[NamedModule] = []
    var problems: list[list[Diagnostic]] = []
    for m in layout.modules:
        var text = String.new()
        match held.get(m.disk.copy()):
            case Some(t):
                text = t.copy()
            case None:
                text = sys.fs.read_to_string(Path.new(m.disk))?
        let parsed = parse(text, catalog)
        var features = Features.for_runtime(layout.runtime)
        if m.package < len(layout.packages):
            let p = ref layout.packages[m.package]
            for f in p.features:
                features.declared.push(f.name.copy())
            features.on = p.on.copy()
        let (tree, cfg_diags) = built_tree(text, parsed.tree, tests, features)
        problems.push(cfg_diags)
        for module in imported_std_modules(text, tree):
            if not env.std.contains(module.copy()):
                let source = sys.fs.read_to_string(Path.new(std_file(home, module)))?
                let names = ModuleNames.of(source, parse(source, catalog).tree)
                _ = env.std.insert(module.copy(), names)
        let (absent, discarded) = target_absences(text, parsed.tree, features)
        out.push(
            NamedModule(
                text=text.copy(),
                tree=tree,
                syntax=parsed.diagnostics,
                path=m.path.copy(),
                package=m.package,
                absent=absent,
                discarded=discarded,
            )
        )
    return Ok((out, problems))

## Each package of a layout: its name and its dependencies.
pure def packages_of(layout: Layout) -> list[(String, list[(String, int)])]:
    var out: list[(String, list[(String, int)])] = []
    for p in layout.packages:
        out.push((p.name.copy(), p.deps.copy()))
    return out

## The name diagnostics of the program `arg` names, a file or a package, in
## the conformance form: those of a program of several modules each with
## its file's name, in the modules' order.
def names_of(
    sys: System, home: str, arg: str, mut env: Environment, catalog: Catalog
) -> String ! IoError:
    let layouts = layouts_of(sys, arg, False, build_request(sys)) else:
        let text = sys.fs.read_to_string(Path.new(arg))?
        return names(sys, home, text, mut env, catalog)
    var out = String.new()
    for layout in layouts:
        let (modules, _) = named_modules(sys, home, layout, True, mut env, catalog)?
        let found = modules_with_absences(
            without_unreachable(
                resolve.resolve_program(modules, packages_of(layout), env, catalog), layout
            ),
            modules,
        )
        for i in range(len(found)):
            out.push(render_ids_in(layout.modules[i].name, modules[i].text, found[i], catalog))
    return Ok(out)

## The name diagnostics of `text` in the conformance form, after loading the
## std modules it imports into `env`.
def names(
    sys: System, home: str, text: str, mut env: Environment, catalog: Catalog
) -> String ! IoError:
    let features = Features.for_runtime(target_runtime(sys))
    let (_, diags, _) = name_diagnostics(sys, home, text, True, features, mut env, catalog)?
    return Ok(render_ids(text, diags, catalog))

## The one path a command names after its name, but for the options
## `flags`: `.` when it names none (the working directory's package, as
## `sisu` reads it), `None` when it names more than one.
pure def path_of(rest: list[String], flags: list[str]) -> String?:
    var paths: list[String] = []
    for k in range(1, len(rest)):
        var flag = False
        for f in flags:
            if rest[k] == f:
                flag = True
        if not flag:
            paths.push(rest[k].copy())
    if paths.is_empty():
        return Some(".".to_string())
    if len(paths) == 1:
        return Some(paths[0].copy())
    return None

## The first word after the command's name that is an option, `--NAME`,
## but none of `flags`.
pure def unknown_option(rest: list[String], flags: list[str]) -> String?:
    for k in range(1, len(rest)):
        if rest[k].starts_with("--"):
            var known = False
            for f in flags:
                if rest[k] == f:
                    known = True
            if not known:
                return Some(rest[k].copy())
    return None

## What `sisu doc` is asked (stage 0's `doc`, its arguments): the paths
## (a program's, or with `std_lib` the standard library's modules by their
## import paths, all of them when it names none), where the pages go, and
## the build's lockfile and features.
struct DocArgs:
    targets: list[String]
    output: String?
    std_lib: bool
    # `--digest`: one plain text of the pages (RULES.md, R207).
    digest: bool
    locked: bool
    accept_unsafe: bool
    request: FeatureRequest

## What `sisu doc` printed of a program, its exit status, and the pages it
## made (none when it failed).
struct DocReport:
    out: String
    err: String
    status: int
    pages: list[doc.Page]

impl DocReport:
    pure def failed(own err: String, status: int) -> DocReport:
        return DocReport(out=String.new(), err=err, status=status, pages=[])

## The arguments of `doc` (the command's words, its name first), as stage
## 0 reads them: `--std`, `--locked`, `--no-default-features`, `--output
## DIR` or `--output=DIR`, `--features NAMES` or `--features=NAMES` (the
## names separated by commas or spaces), and the paths; with the usage
## error stage 0 reports, when there is one (`cli.unknown-option`, for an
## option it does not take or a second path, and `doc.std-path`, `D0113`,
## for a path that is no module of the standard library).
pure def doc_args(rest: list[String], catalog: Catalog) -> (DocArgs, String):
    var args = DocArgs(
        targets=[],
        output=None,
        std_lib=False,
        digest=False,
        locked=False,
        accept_unsafe=False,
        request=FeatureRequest.none(),
    )
    var i = 1
    while i < len(rest):
        let a = rest[i].copy()
        if a == "--std":
            args.std_lib = True
        elif a == "--digest":
            args.digest = True
        elif a == "--locked":
            args.locked = True
        elif a == "--accept-unsafe":
            args.accept_unsafe = True
        elif a == "--no-default-features":
            args.request.no_default = True
        elif a == "--output" or a.starts_with("--output="):
            args.output = flag_value(rest, mut i, "--output")
        elif a == "--features" or a.starts_with("--features="):
            let names = flag_value(rest, mut i, "--features") ?? String.new()
            var name = String.new()
            for c in names.chars():
                if c == ',' or c.is_whitespace():
                    if not name.is_empty():
                        args.request.names.push(name.copy())
                    name = String.new()
                else:
                    name.push_char(c)
            if not name.is_empty():
                args.request.names.push(name)
        elif a.starts_with("-"):
            return (args, doc_option(a, catalog))
        else:
            args.targets.push(a)
        i += 1
    if args.std_lib:
        for t in args.targets:
            var known = t == "std.core"
            for name in documented():
                if display_path(name) == t:
                    known = True
            if not known:
                let params = [Param(name="path".to_string(), value=t.copy())]
                return (args, catalog.plain_error("doc.std-path", params))
    elif len(args.targets) > 1:
        return (args, doc_option(args.targets[1], catalog))
    return (args, String.new())

## `cli.unknown-option` for `doc`.
pure def doc_option(option: str, catalog: Catalog) -> String:
    let params = [
        Param(name="option".to_string(), value=option.to_string()),
        Param(name="command".to_string(), value="doc".to_string()),
    ]
    return catalog.plain_error("cli.unknown-option", params)

## The value of the option `flag` that `rest[i]` is: after its `=`, or the
## next word, which `i` then moves to (none when there is none).
pure def flag_value(rest: list[String], mut i: int, flag: str) -> String?:
    let a = rest[i].copy()
    if a.byte_len() > flag.byte_len():
        return Some(a.byte_slice(flag.byte_len() + 1, a.byte_len()).to_string())
    i += 1
    if i < len(rest):
        return Some(rest[i].copy())
    return None

## `doc [PATH] [--output DIR]` and `doc --std [MODULE...]` (stage 0's `sisu
## doc`; 09, "Documentation"; decision 258): every module of the program
## the path names (a file, a package, each member of a workspace), or of
## the standard library (the modules its import paths name, or all), as a
## Markdown page, printed each after a line naming its file, or written
## into `DIR`. The program is built as `sisu build` builds it, without its
## tests (decision 243); one with an error is reported as `sisu check`
## reports it, then `D0114`, and nothing is written. The exit status is
## stage 0's: 0, 1 for a program with an error or a file that cannot be
## read or written, 2 for a usage error.
def doc_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> int ! IoError:
    let (args, wrong) = doc_args(rest, catalog)
    if not wrong.is_empty():
        o.emit("", wrong)
        return Ok(2)
    # The served base, or one made for this command (RULES.md, R158).
    match served.base:
        case Some(b):
            return doc_with(sys, home, args, b, served.texts, catalog, mut o)
        case None:
            let texts = std_texts(sys, home)?
            let base = base_of(sys, home, texts, catalog)
            return doc_with(sys, home, args, base, texts, catalog, mut o)

## `doc` of what it was asked, `args`, with the base `base` made of `texts`.
def doc_with(
    sys: System,
    home: str,
    args: DocArgs,
    base: typeck.Base,
    texts: dict[String, String],
    catalog: Catalog,
    mut o: Out,
) -> int ! IoError:
    var env = base.environment()
    let report = doc_report(sys, home, args, None, base, texts, mut env, catalog, mut o)?
    if report.status != 0:
        o.emit(report.out, report.err)
        return Ok(report.status)
    var pages = report.pages.copy()
    # `--digest`: the pages as one plain text, `NAME.txt` in `DIR`
    # (RULES.md, R207).
    if args.digest:
        let name = digest_name(sys, args)
        let text = doc.digest("{name}: the API as `sisu doc --digest` writes it", pages)
        let Some(_) = args.output else:
            o.emit(text, "")
            return Ok(0)
        pages = [doc.Page(file="{name}.txt", text=text)]
    let dir = args.output.copy() else:
        o.emit(doc.printed(pages), "")
        return Ok(0)
    let failed = write_pages(sys, dir, pages, catalog)
    if not failed.is_empty():
        o.emit("", failed)
        return Ok(1)
    return Ok(0)

## The name of a digest (RULES.md, R207): `std` for the standard
## library's, a package's directory's for a package's (the working
## directory's nearest package when no path is given), a file's stem for
## a file's.
def digest_name(sys: System, args: DocArgs) -> String:
    if args.std_lib:
        return "std".to_string()
    var dir = absolute(sys, ".")
    if let Some(t) = args.targets.first():
        dir = absolute(sys, t)
        if not package.is_dir(sys.fs, dir):
            return file_stem(dir)
    else:
        while not package.is_file(sys.fs, package.join(dir, package.MANIFEST)) and dir != "/":
            dir = package.parent(dir)
    return package.file_name(dir.strip_suffix("/"))

## What `doc` makes of what it was asked (stage 0's `doc` and `doc_pages`):
## the pages of the program the path names, or of the standard library, or
## what stopped it, with stage 0's status. A program of one file is named
## `name` in its diagnostics, or as it was given.
def doc_report(
    sys: System,
    home: str,
    args: DocArgs,
    name: String?,
    base: typeck.Base,
    texts: dict[String, String],
    mut env: Environment,
    catalog: Catalog,
    mut o: Out,
) -> DocReport ! IoError:
    if args.std_lib:
        # The standard library: a program that imports each module, so that
        # each is loaded.
        let input = file_input(sys, home, "std.sisu", std_root(), False, mut env, catalog)?
        let only = Some(args.targets.copy())
        return Ok(doc_program(base, input, "std.sisu", only, args.digest, texts, catalog))
    # The program's path, or the package of the working directory or the
    # nearest one above it, as `sisu doc` finds it.
    var path = String.new()
    match args.targets.first():
        case Some(t):
            path = t.copy()
            let abs = absolute(sys, t)
            if package.is_dir(sys.fs, abs):
                if package.locate(sys.fs, abs).is_none():
                    let params = [
                        Param(name="dir".to_string(), value=t.copy()),
                        Param(name="command".to_string(), value="doc".to_string()),
                    ]
                    return Ok(DocReport.failed(catalog.plain_error("cli.no-package", params), 2))
            elif let Err(e) = sys.fs.read_to_string(Path.new(t)):
                return Ok(DocReport.failed(cannot_read(t, e, catalog), 1))
        case None:
            let found = nearest_package(sys, "doc", catalog, mut o) else:
                return Ok(DocReport.failed(String.new(), 2))
            path = found
    if let Some(e) = unknown_feature(sys, path, args.request):
        return Ok(DocReport.failed(catalog.plain_error("cli.unknown-feature", e), 2))
    # `--locked` keeps the lockfile as it is, or stops the command.
    if not write_lockfile(sys, path, False, args.locked, args.accept_unsafe, catalog, "", mut o)?:
        return Ok(DocReport.failed(String.new(), 1))
    var inputs: list[Input] = []
    match layouts_of(sys, path, False, args.request):
        case Some(layouts):
            for layout in layouts:
                if layout.modules.is_empty():
                    # Manifests broken past reading a module: their problems.
                    let shown = problems_report(layout, catalog).human(catalog)
                    return Ok(DocReport.failed(shown, 1))
                inputs.push(layout_input(sys, home, layout, False, mut env, catalog)?)
        case None:
            let text = sys.fs.read_to_string(Path.new(path))?
            inputs.push(file_input(sys, home, path, text, False, mut env, catalog)?)
    var named = path.copy()
    if let Some(n) = name:
        named = n.copy()
    var pages: list[doc.Page] = []
    for input in inputs:
        let done = doc_program(base, input, named, None, False, texts, catalog)
        if done.status != 0:
            return Ok(done)
        for p in done.pages:
            pages.push(p.copy())
    return Ok(DocReport(out=String.new(), err=String.new(), status=0, pages=pages))

## The root module of the program `doc --std` documents: an import of every
## module of the standard library, so that each is loaded.
pure def std_root() -> String:
    var text = String.new()
    for name in documented():
        text.push("import {display_path(name)} as std_{name}\n")
    return text

## The pages of one program (stage 0's `doc_pages`): the root package's
## modules, or with `only` the standard library's, those it names if it
## names some; or, for a program with an error, what `sisu check` prints of
## it and `D0114`.
pure def doc_program(
    base: typeck.Base,
    input: Input,
    name: str,
    only: list[String]?,
    public: bool,
    texts: dict[String, String],
    catalog: Catalog,
) -> DocReport:
    let checked = check_input(base, input, catalog, True)
    let report = front_report(input, checked, name, catalog)
    let errors = report.errors(catalog)
    var beyond = String.new()
    for b in report.beyond:
        beyond.push("beyond the slice: {b}\n")
    if errors > 0:
        var err = report.human(catalog)
        let count = Param(name="count".to_string(), value="{errors}")
        err.push(catalog.plain_error("doc.errors-found", [count]))
        err.push(beyond)
        return DocReport.failed(err, 1)
    if report.has_error or not beyond.is_empty():
        return DocReport.failed(beyond, 1)
    let typed = checked.typed else:
        return DocReport.failed("beyond the slice: nothing to document\n".to_string(), 1)
    var pages: list[doc.Page] = []
    match only:
        case Some(paths):
            pages = std_pages(typed, paths, public, texts, catalog)
        case None:
            pages = program_pages(input, typed, catalog)
    return DocReport(out=String.new(), err=String.new(), status=0, pages=pages)

## The pages of a program's root package: each of its modules as the build
## has it, its `@cfg`s applied, named by its import path, or a single
## file's by the file's stem. A package's pages show what another package
## may name.
pure def program_pages(input: Input, typed: typeck.Typed, catalog: Catalog) -> list[doc.Page]:
    var sources: list[doc.Source] = []
    for k in range(len(input.modules)):
        let m = ref input.modules[k]
        if m.package != 0 or k >= len(typed.prog.user_modules):
            continue
        # The tokens the parse reads are the page's, lexed once.
        let lexed = lex(m.text)
        let tokens = lexed.tokens.copy()
        let parsed = build.module(parse_lexed(m.text, lexed, catalog).tree)
        var features: Features? = None
        if m.package < len(input.features):
            features = Some(input.features[m.package].copy())
        let module = cfg.filter(parsed, False, features).module ?? parsed
        var shown = m.path.join(".")
        if m.path.is_empty():
            shown = file_stem(m.file)
        sources.push(
            doc.Source(
                id=typed.prog.user_modules[k],
                path=shown,
                text=m.text.copy(),
                tokens=tokens,
                module=module,
            )
        )
    sources.sort_by((a, b) -> a.path.cmp(b.path))
    var public_only = False
    if let Some(p) = typed.prog.packages.first():
        public_only = not p.name.is_empty()
    let docs = doc.Docs(
        sources=ref sources,
        prog=ref typed.prog,
        types=ref typed.types,
        inferred=ref typed.inferred,
        public_only=public_only,
    )
    return doc.pages(docs)

## The pages of the standard library: the prelude's (`std.core`) and those
## of the modules of 11 (not `target`, whose facts are the host's), or of
## those `only` names when it names some, each read from its text; with
## `public` (a digest's, RULES.md, R207), only what is written `pub`.
pure def std_pages(
    typed: typeck.Typed,
    only: list[String],
    public: bool,
    texts: dict[String, String],
    catalog: Catalog,
) -> list[doc.Page]:
    let prog = ref typed.prog
    var names = ["prelude"]
    for name in documented():
        names.push(name)
    var sources: list[doc.Source] = []
    for name in names:
        var id: ModuleId? = None
        if name == "prelude":
            id = Some(prog.prelude)
        else:
            for k in range(len(prog.modules)):
                if id.is_none() and prog.modules[k].is_std and prog.modules[k].name == name:
                    id = Some(ModuleId(index=k))
        let found = id else:
            continue
        let path = display_path(name)
        if not only.is_empty() and not only.contains(path):
            continue
        var text = String.new()
        if let Some(t) = texts.get(name.to_string()):
            text = t.copy()
        let lexed = lex(text)
        let tokens = lexed.tokens.copy()
        let module = build.module(parse_lexed(text, lexed, catalog).tree)
        sources.push(
            doc.Source(id=found, path=path, text=text.copy(), tokens=tokens, module=module)
        )
    sources.sort_by((a, b) -> a.path.cmp(b.path))
    let docs = doc.Docs(
        sources=ref sources,
        prog=ref typed.prog,
        types=ref typed.types,
        inferred=ref typed.inferred,
        public_only=public,
    )
    return doc.pages(docs)

## A file's name without its directory and its last extension (Rust's
## `file_stem`): the whole name when it has no `.` but at its start.
pure def file_stem(p: str) -> String:
    let name = package.file_name(p)
    var dot = -1
    for i in range(name.byte_len()):
        if name.byte_at(i) == 46:
            dot = i
    if dot <= 0:
        return name
    return name.byte_slice(0, dot).to_string()

## Each page written into `dir`, made when it is missing (`doc --output
## DIR`): `cli.cannot-write` for the first that could not be, or nothing.
def write_pages(sys: System, dir: str, pages: list[doc.Page], catalog: Catalog) -> String:
    for page in pages:
        var path = page.file.copy()
        if not dir.is_empty():
            path = "{dir.strip_suffix("/")}/{page.file}"
        var reason: String? = None
        match make_dirs(sys, dir):
            case Ok(_):
                if let Err(e) = sys.fs.write_text(Path.new(path), page.text):
                    reason = Some(io_reason(e))
            case Err(e):
                reason = Some(io_reason(e))
        if let Some(r) = reason:
            let params = [
                Param(name="path".to_string(), value=path),
                Param(name="reason".to_string(), value=r.copy()),
            ]
            return catalog.plain_error("cli.cannot-write", params)
    return String.new()

## Makes the directory `dir` and those above it that are missing.
def make_dirs(sys: System, dir: str) -> ! IoError:
    var at = 0
    while at < dir.byte_len():
        var end = at + 1
        while end < dir.byte_len() and dir.byte_at(end) != 47:
            end += 1
        let prefix = dir.byte_slice(0, end)
        if not package.is_dir(sys.fs, prefix):
            sys.fs.create_dir(Path.new(prefix))?
        at = end
    return Ok(())

## Where a batch spends its time, in nanoseconds: lexing, parsing,
## writing the dumps, and building and writing the AST.
struct Times:
    lex: int
    parse: int
    dump: int
    ast: int

## What `sisu fmt` prints of one file, its status, and the canonical text
## when it differs from the file's (stage 0's `fmt`, for one file).
struct FmtReport:
    out: String
    err: String
    status: int
    changed: String?

## `fmt [--check] [PATH...]` (stage 0's `sisu fmt`, 10, "Formatter"):
## formats each file, and each `.sisu` file under each directory, in place;
## without a path, the package's (the files under the directory of its
## manifest). There are no options of style. `--check` writes nothing and
## reports each file that is not formatted, with what would change. A file
## with a syntax error is reported and left as it is. The exit status is
## stage 0's: 0, 1 when a file is not formatted or could not be, 2 for a
## usage error and 70 for a file the formatter refused as changed.
def fmt_command(
    sys: System, home: str, rest: list[String], catalog: Catalog, mut o: Out, served: Served
) -> int ! IoError:
    var flags: list[String] = []
    var paths: list[String] = []
    for k in range(1, len(rest)):
        if rest[k].starts_with("--"):
            flags.push(rest[k].copy())
        else:
            paths.push(rest[k].copy())
    for f in flags:
        if f != "--check":
            let params = [
                Param(name="option".to_string(), value=f.copy()),
                Param(name="command".to_string(), value="fmt".to_string()),
            ]
            o.emit("", catalog.plain_error("cli.unknown-option", params))
            return Ok(2)
    let check = not flags.is_empty()
    var files: list[String] = []
    if paths.is_empty():
        let found = nearest_package(sys, "fmt", catalog, mut o) else:
            return Ok(2)
        sisu_files(sys, found, mut files)
    for p in paths:
        if package.is_dir(sys.fs, p):
            let before = len(files)
            sisu_files(sys, p, mut files)
            if len(files) == before:
                let params = [Param(name="path".to_string(), value=p.copy())]
                o.emit("", catalog.plain_error("cli.fmt-nothing", params))
        else:
            files.push(p.copy())
    var status = 0
    var base: typeck.Base? = None
    for f in files:
        var text = String.new()
        match sys.fs.read_to_string(Path.new(f)):
            case Ok(t):
                text = t
            case Err(e):
                o.emit("", cannot_read(f, e, catalog))
                status = 1
                continue
        # A served base where the file needs one (RULES.md, R158).
        let written = format.to_resolve(text, catalog)
        var report = FmtReport(out=String.new(), err=String.new(), status=0, changed=None)
        if served.base.is_some() and not written.is_empty():
            report = fmt_report(served.base, f, text, written, check, catalog)
        else:
            report = fmt_file(sys, home, f, text, check, mut base, catalog)?
        o.emit(report.out, report.err)
        if report.status != 0:
            status = report.status
        if check:
            continue
        if let Some(out) = report.changed:
            if let Err(e) = sys.fs.write_text(Path.new(f), out):
                let params = [
                    Param(name="path".to_string(), value=f.copy()),
                    Param(name="reason".to_string(), value=io_reason(e)),
                ]
                o.emit("", catalog.plain_error("cli.cannot-write", params))
                status = 1
    return Ok(status)

## What `sisu fmt` makes of the file `path` whose text is `text`: nothing
## to say of a file already formatted; with `check`, the hunks of the
## change on standard output, status 1; the syntax errors of a file that
## has any, and `D0075`, status 1; `D0076` for one the formatter refused as
## changed, status 70. The standard library is resolved, into `base`, when
## a first file needs it.
def fmt_file(
    sys: System,
    home: str,
    path: str,
    text: str,
    check: bool,
    mut base: typeck.Base?,
    catalog: Catalog,
) -> FmtReport ! IoError:
    let written = format.to_resolve(text, catalog)
    if not written.is_empty() and base.is_none():
        base = Some(base_of(sys, home, std_texts(sys, home)?, catalog))
    return Ok(fmt_report(base, path, text, written, check, catalog))

pure def fmt_report(
    base: typeck.Base?, path: str, text: str, written: list[String], check: bool, catalog: Catalog
) -> FmtReport:
    var report = FmtReport(out=String.new(), err=String.new(), status=0, changed=None)
    match format.format_file(base, text, written, catalog):
        case Ok(out):
            if out == text:
                return report
            if check:
                let params = [
                    Param(name="file".to_string(), value=path.to_string()),
                    Param(name="diff".to_string(), value=diff.hunks(text, out, 2)),
                ]
                report.out = catalog.render("cli.fmt-would-change", params)
                report.out.push("\n")
                report.status = 1
            report.changed = Some(out)
        case Err(Refusal.Syntax(diagnostics)):
            report.err = render_human(path, text, diagnostics, catalog)
            let params = [Param(name="file".to_string(), value=path.to_string())]
            report.err.push(catalog.plain_error("cli.fmt-syntax", params))
            report.status = 1
        case Err(Refusal.Changed(at)):
            let params = [
                Param(name="file".to_string(), value=path.to_string()),
                Param(name="at".to_string(), value="{at}"),
            ]
            report.err = catalog.plain_error("cli.fmt-unstable", params)
            report.status = 70
    return report

## `cli.cannot-read` for the file `path`.
pure def cannot_read(path: str, e: IoError, catalog: Catalog) -> String:
    let params = [
        Param(name="path".to_string(), value=path.to_string()),
        Param(name="reason".to_string(), value=io_reason(e)),
    ]
    return catalog.plain_error("cli.cannot-read", params)

## The text of an I/O error as stage 0's messages give it, Rust's: the
## host's own words for what is not one of the kinds of `IoError`.
pure def io_reason(e: IoError) -> String:
    return match e:
        case NotFound(_): "No such file or directory (os error 2)".to_string()
        case PermissionDenied(_): "Permission denied (os error 13)".to_string()
        case AlreadyExists(_): "File exists (os error 17)".to_string()
        case InvalidData(_): "stream did not contain valid UTF-8".to_string()
        case Interrupted: "Interrupted system call (os error 4)".to_string()
        case Other(message): message.copy()
        case _: "{e:?}"

## Every `.sisu` file under `dir`, sorted, leaving out hidden directories
## and `target` (stage 0's `sisu_files`).
def sisu_files(sys: System, dir: str, mut out: list[String]):
    let entries = sys.fs.list_dir(Path.new(dir)) else:
        return
    var paths: list[String] = []
    for e in entries:
        paths.push(e.as_str().to_string())
    paths.sort()
    for p in paths:
        let name = package.file_name(p)
        if name.starts_with(".") or name == "target":
            continue
        if package.is_dir(sys.fs, p):
            sisu_files(sys, p, mut out)
        elif name.ends_with(".sisu"):
            out.push(p.copy())

def now(sys: System) -> int:
    return sys.clock.now().unix_nanos()

pure def ms(nanos: int) -> int:
    return nanos // 1000000

pure def usage() -> String:
    return "usage: sisu run -- tokens [--trivia] FILE | parse (--tree [--trivia] | --print | --ast) FILE | batch OUT LIST | ast-batch OUT LIST | mutate SEED COUNT OUT LIST | names FILE | names-batch OUT LIST | types FILE | types-batch OUT LIST | sir FILE | ownership FILE | sir-batch OUT LIST".to_string()

## Prints `out` to standard output and `errs` to standard error exactly:
## both end in a line break, which `print` adds.
def emit(out: str, errs: str):
    if not out.is_empty():
        print(out.strip_suffix("\n"))
    if not errs.is_empty():
        print_err(errs.strip_suffix("\n"))

## What `sisu tokens` prints for `text`: one token per line as `KIND
## start..end "text"`, the trivia only with `trivia`; and the lexer's
## diagnostics in the conformance form, in the order it found them.
pure def tokens(text: str, trivia: bool, catalog: Catalog) -> (String, String):
    return dump_tokens(text, lex(text), trivia, catalog)

pure def dump_tokens(text: str, lexed: Lexed, trivia: bool, catalog: Catalog) -> (String, String):
    var names = KindNames.new()
    var out = String.new()
    for t in lexed.tokens:
        if t.kind.is_trivia() and not trivia:
            continue
        out.push("{names.of(t.kind)} {t.start}..{t.end} {quote(text.byte_slice(t.start, t.end))}\n")
    return (out, render_ids(text, lexed.diagnostics, catalog))

test "a lockfile's `unsafe` level that rises waits for `--accept-unsafe`":
    let catalog = Catalog.parse(
        "E1022 error   package.unsafe-raised       `sisu.lock` records `{{name}}` with {{old}}, and it now declares `unsafe = \"{{level}}\"`\n"
    )
    let memory = "version = 1\n\n[[package]]\nname = \"z\"\nversion = \"1.0.0\"\nsource = \"path+.\"\ndependencies = []\nunsafe = \"memory\"\n"
    let foreign = memory.replace("unsafe = \"memory\"", "unsafe = \"extern\"")
    let none = memory.replace("unsafe = \"memory\"\n", "")
    let raised = raised_level(memory, foreign, catalog).expect("memory to extern rises")
    assert raised
        == "error[E1022]: `sisu.lock` records `z` with `unsafe = \"memory\"`, and it now declares `unsafe = \"extern\"`\n"
    let from_none = raised_level(none, memory, catalog).expect("none to memory rises")
    assert from_none.contains("with no `unsafe`")
    assert raised_level(foreign, memory, catalog).is_none()
    assert raised_level(memory, none, catalog).is_none()
    # A package the old lockfile does not record is new, which admission
    # reviews.
    assert raised_level(memory.replace("\"z\"", "\"y\""), foreign, catalog).is_none()

test "a test run's last line gives its counts, which a blocked suite's status reads":
    let report = "test \"a\" ... ok\ntest \"b\" ... blocked by todo(\"b\")\n1 passed, 0 failed, 1 blocked\n"
    assert test_summary(report) == Some((1, 0, 1))
    assert test_summary("no counts here\n") == None
    assert count_before("12 passed", " passed") == Some(12)
    assert count_before("x passed", " passed") == None
    assert count_before(" passed", " passed") == None

test "an answer of `sir --repl-serve` is framed by its lengths in bytes":
    assert Answer.done("fn main\n").frame() == "answer 0 8 0\nfn main\n"
    assert Answer.failed("é").frame() == "answer 1 0 17\né\nerror: Failed\n"
    assert Answer.done("").frame() == "answer 0 0 0\n"
    assert Answer.misused().frame().starts_with("answer 1 0 ")

test "a served command's answer holds what it printed and the run time's last line":
    var o = Out.held()
    o.put("fn main")
    o.emit("", "error[E0300]: x\n")
    assert held_frame(o, None) == "answer 0 8 16\nfn main\nerror[E0300]: x"
    assert held_frame(o, Some("error: Failed\n"))
        == "answer 1 8 30\nfn main\nerror[E0300]: x\nerror: Failed"
    assert held_frame(Out.held(), None) == "answer 0 0 0"
    let (rest, fine) = command_words(["sir", "--target-runtime", "native", "a.sisu"])
    assert fine and rest == ["sir", "a.sisu"]
    let (_, wrong) = command_words(["sir", "--target-runtime", "wasm", "a.sisu"])
    assert not wrong
    assert served_command("check") and served_command("tokens") and not served_command("build")

test "a served request's relative paths are its directory's":
    let fs = InDir(inner=Fs.in_memory(), dir="/w/d".to_string())
    assert fs.full(Path.new("a.sisu")) == Path.new("/w/d/a.sisu")
    assert fs.full(Path.new("/x/a.sisu")) == Path.new("/x/a.sisu")
    assert given_path(NotFound(path=Path.new("/w/d/a")), Path.new("a"))
        == NotFound(path=Path.new("a"))
