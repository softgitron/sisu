##! The kinds of tokens and nodes, and the lexical tables the lexer reads
##! (docs/architecture.md, "Lexing" and "Parsing and the syntax tree"). The
##! tables are data: the lexer builds its lookups from them, so a change to
##! the language's keywords or operators is a change here only.

## Every kind of token and node. A dump names a kind in upper snake case
## (`L_PAREN`, `FN_DEF`), the names stage 0 prints.
@derive(Eq, Hash, Debug, Copy)
pub enum SyntaxKind:
    # Trivia: kept in the tree, ignored by the parser.
    Whitespace
    Comment
    DocComment
    ModuleDocComment
    # A line break that is not a NEWLINE: inside brackets, on a blank or
    # comment-only line, or before a continuation line.
    LineBreak

    # Layout.
    Newline
    Indent
    Dedent
    Eof

    # Names and literals.
    Ident
    IntNumber
    FloatNumber
    CharLit
    StringStart
    StringText
    StringEnd
    InterpStart
    InterpEnd
    FormatSpec
    RawString
    ByteString
    ErrorToken

    # Punctuation.
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    DotDot
    Question
    QuestionDot
    QuestionQuestion
    Arrow
    At
    Bang
    Semicolon
    Backslash
    Walrus

    # Operators.
    Eq
    EqEq
    BangEq
    Lt
    LtEq
    Gt
    GtEq
    Plus
    Minus
    Star
    Slash
    SlashSlash
    Percent
    StarStar
    PlusPercent
    MinusPercent
    StarPercent
    PlusPipe
    MinusPipe
    StarPipe
    Shl
    Shr
    Amp
    Pipe
    Caret
    Tilde
    PlusEq
    MinusEq
    StarEq
    SlashEq
    SlashSlashEq
    PercentEq
    StarStarEq
    AmpEq
    PipeEq
    CaretEq
    ShlEq
    ShrEq
    PlusPercentEq
    MinusPercentEq
    StarPercentEq
    PlusPipeEq
    MinusPipeEq
    StarPipeEq

    # The 47 reserved keywords of proposal/02-syntax.md.
    AndKw
    AsKw
    AssertKw
    BreakKw
    CaseKw
    ComptimeKw
    ConstKw
    ContinueKw
    DefKw
    DeferKw
    DoKw
    DynKw
    ElifKw
    ElseKw
    EnumKw
    ErrorKw
    ExternKw
    ForKw
    FromKw
    IfKw
    ImplKw
    ImportKw
    InKw
    LetKw
    MatchKw
    MutKw
    NotKw
    OrKw
    OwnKw
    PassKw
    PubKw
    RefKw
    ReturnKw
    SelectKw
    SelfKw
    SelfTypeKw
    StructKw
    TestKw
    TraitKw
    TypeKw
    UnsafeKw
    VarKw
    ViewKw
    WhereKw
    WhileKw
    WithKw
    YieldKw

    # Nodes.
    SourceFile
    Error
    Attribute
    Visibility
    FnDef
    GenericParams
    GenericParam
    ParamList
    Param
    RetType
    WhereClause
    Block
    StructDef
    FieldDef
    EnumDef
    VariantDef
    VariantField
    ErrorDef
    OpenMarker
    ImplDef
    TraitDef
    ImportItem
    FromImport
    ModulePath
    ImportName
    TestDef
    SuiteDef
    BenchDef
    ConstDef
    TypeAlias
    ExternBlock
    LetStmt
    LetElse
    AssignStmt
    ExprStmt
    ReturnStmt
    BreakStmt
    ContinueStmt
    PassStmt
    IfStmt
    ElifClause
    ElseClause
    Cond
    LetCond
    WhileStmt
    ForStmt
    AssertStmt
    ExpectStmt
    DeferStmt
    WithStmt
    UnsafeBlock
    SelectStmt
    ComptimeStmt
    ContractStmt
    YieldStmt
    Literal
    StringExpr
