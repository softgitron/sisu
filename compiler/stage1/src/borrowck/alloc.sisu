##! `@no_alloc` on SIR (04, "Resource attributes"; D-059; RULES.md, R215): a
##! function that says it allocates nothing makes no `list`, `set`, `dict`,
##! `String` or other value that owns memory, grows none, boxes no `dyn`
##! value and makes no closure that holds what it captures, and no function
##! it calls does, through the call graph of the program's SIR, the
##! standard library's functions included. An intrinsic allocates where it
##! grows a collection or a text (`list.push`, `dict.insert`,
##! `String.push`, `Shared.new`) or returns a new value that owns memory
##! (`str.to_string`); one that moves a value out of a collection
##! (`list.pop`) does not. A call whose function only the run knows, of a
##! function value or through a type parameter, `dyn` or a capability, may
##! be one that allocates, and is an error too (D-059: "it must be assumed
##! to allocate"). The paths that only end in a panic, and the cleanup
##! that drops on the way out, are exempt (04: "Panic paths are exempt").

import stage1.sir.write
from stage1.borrowck.finding import Arg, Finding, text
from stage1.borrowck.types import Types
from stage1.diag import Msg
from stage1.sir import (
    Aggregate,
    BinOp,
    Callee,
    ClosureRole,
    FnKind,
    Function,
    Loc,
    Program,
    Rvalue,
    Statement,
    StatementKind,
    Terminator,
    Type,
    TypeDecl,
)

## Where a function allocates: the function the allocation is in, what
## does it (`calls `list.push``), and where.
struct Site:
    function: String
    how: String
    source: int
    loc: Loc?

## What a statement does that allocates, if anything: the words of the
## error for a statement of the `@no_alloc` function itself (`the list it
## makes`, `` `push` ``), which the error quotes the program's own text in
## place of where `quoted` (RULES.md, R229), the words of the note for one
## of a function it calls (`makes a list`), whether what it calls is known
## only at run time, and whether it makes a list, which the function's
## caller may make in its place.
struct Allocation:
    what: String
    how: String
    unknown: bool
    quoted: bool
    list: bool

## A finding of `check_body` before it is kept: the finding, its
## statement, and whether the statement itself allocates, so that one
## within another such statement is the other's (RULES.md, R229).
struct Found:
    finding: Finding
    site: (int, int)
    loc: Loc?
    direct: bool

## The `E0282` errors of the program's `@no_alloc` functions, one at each
## statement that allocates or calls a function that may.
pub pure def check(p: Program, types: Types) -> list[Finding]:
    var out: list[Finding] = []
    var memo: dict[String, Site?] = {}
    var made: dict[String, list[Instance]]? = None
    for (name, shown, attr) in p.no_alloc:
        let fi = types.function(name) else:
            continue
        let f = ref p.functions[fi]
        let fixes = Fixes(name=shown.copy(), attr=attr)
        # What allocates whatever the type arguments are, at the function
        # itself; what depends on them waits for each instance (RULES.md,
        # R222).
        let reported = check_body(p, types, f, shown, fixes, [], None, [], mut memo, mut out)
        if f.type_params.is_empty():
            continue
        if made.is_none():
            made = Some(instances(p, types))
        let all = made.copy() ?? {}
        let these = all.get(name.copy()) else:
            continue
        for inst in these:
            var args: list[String] = []
            for a in inst.args:
                args.push(write.ty(a))
            let named = "{shown}[{args.join(", ")}]"
            _ = check_body(
                p,
                types,
                f,
                named,
                fixes,
                inst.args,
                Some(inst.at.copy()),
                reported,
                mut memo,
                mut out,
            )
    return out

## What the fixes of a `@no_alloc` function's errors name: the function as
## the program writes it, and its attribute's line, which the fix that
## removes the attribute removes (none when the attribute shares its line;
## RULES.md, R229).
struct Fixes:
    name: String
    attr: Loc?

impl Fixes:
    ## The fixes of an error: for a list the function makes, the list its
    ## caller makes in its place, which has no edit, then the attribute
    ## removed.
    pure def add(self, own found: Finding, list: bool) -> Finding:
        var out = found
        if list:
            out = out.fix(Msg.TypeNoAllocPassIn, [], None)
        if let Some(at) = self.attr:
            out = out.fix(
                Msg.TypeNoAllocRemove, [text("name", self.name)], Some((at, "".to_string()))
            )
        return out

## The `E0282` errors of the body of `f`, a `@no_alloc` function named
## `shown`, with its type parameters `args` (none for the function as
## written, where what depends on them is left to its instances), made at
## `made` (an instance's call), but at the statements `skip` names, which
## the function as written reported; returns the statements it reported.
## A statement that allocates within another that does, the element a
## comprehension pushes or the list a `push` is given, is the other's
## error, so that one operation of the program is one error (RULES.md,
## R229).
pure def check_body(
    p: Program,
    types: Types,
    f: Function,
    shown: str,
    fixes: Fixes,
    args: list[Type],
    made: String?,
    skip: list[(int, int)],
    mut memo: dict[String, Site?],
    mut out: list[Finding],
) -> list[(int, int)]:
    var reported: list[(int, int)] = []
    var found_here: list[Found] = []
    let panics = panic_blocks(f)
    for b in range(len(f.blocks)):
        let block = ref f.blocks[b]
        if block.cleanup or panics.contains(b):
            continue
        for si in range(len(block.stmts)):
            if skip.contains((b, si)):
                continue
            let s = ref block.stmts[si]
            if let Some(a) = allocation(p, types, f, s, args):
                var what = Arg.Text(a.what.copy())
                if a.quoted:
                    if let Some(l) = s.loc:
                        what = Arg.Code(loc=l, fallback=a.what.copy())
                var found = Finding.new(Msg.TypeNoAlloc, f, s.loc).with("name", shown).with_arg(
                    "what", what
                ).at(b, si)
                if a.unknown:
                    found = found.note(Msg.TypeNoAllocUnknown, [])
                if let Some(at) = made:
                    found = found.note(Msg.TypeNoAllocInstance, [text("at", at)])
                found = fixes.add(found, a.list)
                found_here.push(Found(finding=found, site=(b, si), loc=s.loc, direct=True))
                reported.push((b, si))
                continue
            let (callee, callee_args) = called(p, types, f, s, args) else:
                continue
            if callee == f.name:
                continue
            var seen: list[String] = [f.name.copy()]
            let site = allocates(p, types, callee, callee_args, mut memo, mut seen) else:
                continue
            var found = Finding.new(Msg.TypeNoAlloc, f, s.loc).with("name", shown).with(
                "what", "`{shown_fn(callee)}`"
            ).at(b, si)
            let at = place_of(p, site.source, site.loc)
            let params = [
                text("callee", shown_fn(site.function)),
                text("how", site.how),
                text("at", at),
            ]
            found = found.note(Msg.TypeNoAllocThrough, params)
            if let Some(made_at) = made:
                found = found.note(Msg.TypeNoAllocInstance, [text("at", made_at)])
            found = fixes.add(found, False)
            found_here.push(Found(finding=found, site=(b, si), loc=s.loc, direct=False))
            reported.push((b, si))
    for k in range(len(found_here)):
        let x = ref found_here[k]
        var inner = False
        if x.direct:
            for j in range(len(found_here)):
                let y = ref found_here[j]
                if j == k or not y.direct:
                    continue
                # Within the other, or at its very place and after it.
                if within(x.loc, y.loc) and (j < k or not within(y.loc, x.loc)):
                    inner = True
                    break
        if not inner:
            out.push(x.finding.copy())
    return reported

## Whether the place `a` lies within `b`, both known.
pure def within(a: Loc?, b: Loc?) -> bool:
    let x = a else:
        return False
    let y = b else:
        return False
    return (x.line, x.col) >= (y.line, y.col) and (x.end_line, x.end_col) <= (y.end_line, y.end_col)

## An instance of a generic function the program makes: its type
## arguments, and where the first call that makes it is.
struct Instance:
    args: list[Type]
    at: String

## Each instance of a generic function the program makes, by the function's
## name: the calls with type arguments that name no type parameter, in any
## function, and those of each instance's body with its arguments put for
## its parameters, to any depth (a bounded number of them), as
## monomorphisation would make them (04, "after monomorphisation";
## RULES.md, R222).
pure def instances(p: Program, types: Types) -> dict[String, list[Instance]]:
    var out: dict[String, list[Instance]] = {}
    var seen: set[String] = set()
    var work: list[(String, list[Type])] = []
    for f in p.functions:
        if not f.type_params.is_empty():
            continue
        work.push((f.name.copy(), []))
    var k = 0
    while k < len(work) and k < MAX_INSTANCES:
        let (name, args) = work[k].copy()
        k += 1
        let fi = types.function(name) else:
            continue
        let f = ref p.functions[fi]
        for block in f.blocks:
            for s in block.stmts:
                let StatementKind.Call(_, callee, _) = s.kind.copy() else:
                    continue
                let Callee.Fn(n, tys) = callee else:
                    continue
                if tys.is_empty():
                    continue
                let given = subst_all(tys, args)
                if has_param_in(given):
                    continue
                var key = n.copy()
                for t in given:
                    key.push("|{write.ty(t)}")
                if seen.contains(key):
                    continue
                _ = seen.add(key.copy())
                let at = place_of(p, f.source, s.loc)
                var made: list[Instance] = []
                if let Some(earlier) = out.get(n.copy()):
                    made = earlier.copy()
                made.push(Instance(args=given.copy(), at=at))
                _ = out.insert(n.copy(), made)
                work.push((n.copy(), given))
    return out

## How many functions and instances `instances` walks at most.
const MAX_INSTANCES: int = 4096

## The types with the type arguments `args` put for their parameters.
pure def subst_all(tys: list[Type], args: list[Type]) -> list[Type]:
    var out: list[Type] = []
    for t in tys:
        out.push(t.subst(args))
    return out

## Whether one of the types names a type parameter.
pure def has_param_in(tys: list[Type]) -> bool:
    for t in tys:
        if has_param(t):
            return True
    return False

## Whether a type names a type parameter, which only an instance tells.
pure def has_param(t: Type) -> bool:
    match t:
        case Type.Param(_):
            return True
        case Type.Named(_, a):
            return has_param_in(a)
        case Type.Tuple(e):
            return has_param_in(e)
        case Type.Fn(ps, r, _):
            return has_param_in(ps) or has_param_in(r)
        case Type.Ref(i, _):
            return has_param_in(i)
        case Type.Dyn(_, a):
            return has_param_in(a)
        case Type.Assoc(t2, _, a, _):
            return has_param_in(t2) or has_param_in(a)
        case Type.ConstOp(_, a):
            return has_param_in(a)
        case _:
            return False

## Where the function `name` or one it calls allocates first, by the order
## of their blocks and statements; `None` when none does. A function on
## the path being searched (`seen`) is taken to allocate nothing more than
## the path finds, so recursion ends.
pure def allocates(
    p: Program,
    types: Types,
    name: str,
    args: list[Type],
    mut memo: dict[String, Site?],
    mut seen: list[String],
) -> Site?:
    # An instance is its function with its arguments (RULES.md, R222).
    var key = name.to_string()
    for t in args:
        key.push("|{write.ty(t)}")
    if let Some(known) = memo.get(key.copy()):
        return known.copy()
    if seen.contains(key.copy()):
        return None
    let fi = types.function(name) else:
        return None
    seen.push(key.copy())
    let f = ref p.functions[fi]
    let panics = panic_blocks(f)
    var found: Site? = None
    for b in range(len(f.blocks)):
        if found.is_some():
            break
        let block = ref f.blocks[b]
        if block.cleanup or panics.contains(b):
            continue
        for s in block.stmts:
            if let Some(a) = allocation(p, types, f, s, args):
                found = Some(Site(function=f.name.copy(), how=a.how, source=f.source, loc=s.loc))
                break
            let (callee, callee_args) = called(p, types, f, s, args) else:
                continue
            if let Some(site) = allocates(p, types, callee, callee_args, mut memo, mut seen):
                found = Some(site)
                break
    _ = seen.pop()
    _ = memo.insert(key, found.copy())
    return found

## The function a statement calls whose body the check walks: a function
## of the program, or a trait's method whose impl the types name.
pure def called(
    p: Program, types: Types, f: Function, s: Statement, args: list[Type]
) -> (String, list[Type])?:
    let StatementKind.Call(_, callee, _) = s.kind.copy() else:
        return None
    match callee:
        case Callee.Fn(n, tys):
            let given = subst_all(tys, args)
            # A call whose type arguments only an instance tells waits for
            # it (RULES.md, R222).
            if has_param_in(given) and not args.is_empty():
                return None
            return Some((n.copy(), given))
        case Callee.Trait(n, tys):
            let given = subst_all(tys, args)
            if let Some((target, targs)) = types.trait_target(p, n, given):
                return Some((target, targs))
            return None
        case _:
            return None

## What a statement does that allocates, if anything.
pure def allocation(
    p: Program, types: Types, f: Function, s: Statement, args: list[Type]
) -> Allocation?:
    match s.kind:
        case StatementKind.Assign(_, value):
            match value:
                case Rvalue.Aggregate(kind, _):
                    match kind:
                        case Aggregate.List:
                            return Some(made_list("the list it makes", "makes a list"))
                        case Aggregate.Set:
                            return Some(made("the set it makes", "makes a set"))
                        case Aggregate.Dict:
                            return Some(made("the dict it makes", "makes a dict"))
                        case Aggregate.Dyn(_):
                            return Some(made("the `dyn` value it boxes", "boxes a `dyn` value"))
                        case _:
                            return None
                case Rvalue.Binary(op, _, _):
                    if op == BinOp.Concat:
                        return Some(made("the text `+` joins", "joins two texts"))
                    return None
                case Rvalue.CopyOf(place):
                    let written = types.place_ty(f, place) else:
                        return Some(made("the copy `.copy()` makes", "copies a value"))
                    let t = written.subst(args)
                    # A copy of a type parameter's value waits for an
                    # instance (RULES.md, R222).
                    if has_param(t):
                        return None
                    if owns_memory(types, t, 0):
                        return Some(
                            made("the copy `.copy()` makes", "copies a value that owns memory")
                        )
                    return None
                case Rvalue.Closure(name, _, _):
                    if captures_by_value(p, types, name):
                        return Some(
                            made(
                                "the closure it makes, which holds what it captures,",
                                "makes a closure that holds what it captures",
                            )
                        )
                    return None
                case _:
                    return None
        case StatementKind.Call(dest, callee, _):
            match callee:
                case Callee.Intrinsic(n, _):
                    if grows(n):
                        return Some(made(intrinsic_words(n), "calls `{n}`"))
                    if moves_out(n):
                        return None
                    if not dest.proj.is_empty():
                        return None
                    let written = types.place_ty(f, dest) else:
                        return None
                    let t = written.subst(args)
                    if has_param(t):
                        return None
                    if owns_memory(types, t, 0):
                        if n == "list.new":
                            return Some(made_list(intrinsic_words(n), "calls `{n}`"))
                        return Some(made(intrinsic_words(n), "calls `{n}`"))
                    return None
                case Callee.Value(_):
                    return Some(
                        Allocation(
                            what="the function value it calls".to_string(),
                            how="calls a function value".to_string(),
                            unknown=True,
                            quoted=False,
                            list=False,
                        )
                    )
                case Callee.Trait(n, tys):
                    let given = subst_all(tys, args)
                    if types.trait_target(p, n, given).is_some():
                        return None
                    # A method of a type parameter: each instance tells
                    # which impl it calls (RULES.md, R222).
                    if has_param_in(given):
                        return None
                    return Some(
                        Allocation(
                            what="`{n}`".to_string(),
                            how="calls `{n}` on a type only the run knows".to_string(),
                            unknown=True,
                            quoted=False,
                            list=False,
                        )
                    )
                case Callee.Fn(_, _):
                    return None
        case _:
            return None

## An allocation the error names by the program's own text, `what` where
## that text does not fit the message (RULES.md, R229).
pure def made(what: str, how: str) -> Allocation:
    return Allocation(
        what=what.to_string(), how=how.to_string(), unknown=False, quoted=True, list=False
    )

## An allocation of a list, which the caller may make in its place.
pure def made_list(what: str, how: str) -> Allocation:
    var a = made(what, how)
    a.list = True
    return a

## The words for what an intrinsic does where the error cannot quote the
## program's text: what the program wrote that reaches it, not the
## intrinsic's own name (RULES.md, R229).
pure def intrinsic_words(n: str) -> String:
    return match n:
        case "list.new": "the list it makes".to_string()
        case "set.new": "the set it makes".to_string()
        case "dict.new": "the dict it makes".to_string()
        case "fmt.new": "the text it formats".to_string()
        case _: "a call of `{method_of(n)}`".to_string()

## The method of an intrinsic's name, `push` of `list.push`.
pure def method_of(n: str) -> String:
    var k = n.byte_len() - 1
    while k > 0:
        if n.byte_at(k) == 46:
            return n.byte_slice(k + 1, n.byte_len()).to_string()
        k -= 1
    return n.to_string()

## The intrinsics that grow a collection, a text or the heap in place.
pure def grows(n: str) -> bool:
    return match n:
        case "list.push" | "list.insert" | "list.extend" | "dict.insert" | "dict.entry": True
        case "set.add" | "String.push" | "String.push_char" | "Shared.new" | "bytes.concat": True
        case _: False

## The intrinsics that move a value out of a collection or hand back one it
## holds, which allocate nothing whatever the value's type.
pure def moves_out(n: str) -> bool:
    return match n:
        case "list.pop" | "list.remove" | "list.get" | "list.first" | "list.last": True
        case "dict.remove" | "dict.get" | "set.remove" | "Cell.get" | "Cell.replace": True
        case "Shared.get" | "bytes.get": True
        case _: False

## The types whose values own memory of the heap: the collections, texts and
## shared cells, a `dyn` value, and a struct, enum or tuple that holds one.
pure def owns_memory(types: Types, t: Type, depth: int) -> bool:
    if depth > 16:
        return True
    match t:
        case Type.Dyn(_, _):
            return True
        case Type.Tuple(es):
            for e in es:
                if owns_memory(types, e, depth + 1):
                    return True
            return False
        case Type.Named(n, args):
            if heap_builtin(n):
                return True
            for a in args:
                if owns_memory(types, a, depth + 1):
                    return True
            let decl = types.decl(n) else:
                return False
            match decl:
                case TypeDecl.Struct(_, _, fields, _, _, _):
                    for x in fields:
                        if owns_memory(types, x.ty, depth + 1):
                            return True
                case TypeDecl.Enum(_, _, variants, _, _, _, _):
                    for v in variants:
                        for (_, ft) in v.fields:
                            if owns_memory(types, ft, depth + 1):
                                return True
            return False
        case _:
            return False

## The builtin types that own memory of the heap.
pure def heap_builtin(n: str) -> bool:
    return match n:
        case "list" | "dict" | "set" | "String" | "bytes" | "Shared" | "Weak" | "Box": True
        case "BigInt" | "BigRatio" | "Decimal" | "Path": True
        case _: False

## Whether the closure function `name` takes what it captures by value,
## not as references, so that its environment may not fit in the value.
pure def captures_by_value(p: Program, types: Types, name: str) -> bool:
    let fi = types.function(name) else:
        return False
    let c = ref p.functions[fi]
    if c.kind == FnKind.Closure(ClosureRole.Task):
        return True
    if len(c.locals) < 2:
        return False
    match c.locals[1].ty:
        case Type.Tuple(es):
            for e in es:
                if let Type.Ref(_, _) = e:
                    continue
                return True
            return False
        case Type.Unit:
            return False
        case Type.Ref(_, _):
            return False
        case _:
            return True

## The blocks from which every path ends in a panic (a block that ends
## `unreachable`, after the call that panics), which `@no_alloc` exempts.
pure def panic_blocks(f: Function) -> list[int]:
    var out: list[int] = []
    for b in range(len(f.blocks)):
        if let Terminator.Unreachable = f.blocks[b].term:
            out.push(b)
    var changed = True
    while changed:
        changed = False
        for b in range(len(f.blocks)):
            if out.contains(b):
                continue
            var targets: list[int] = []
            match f.blocks[b].term:
                case Terminator.Goto(t):
                    targets.push(t.index)
                case Terminator.Switch(_, cases, default):
                    for (_, t) in cases:
                        targets.push(t.index)
                    targets.push(default.index)
                case _:
                    pass
            if targets.is_empty():
                continue
            var all = True
            for t in targets:
                if not out.contains(t):
                    all = False
            if all:
                out.push(b)
                changed = True
    return out

## `FILE:LINE:COL` of a statement, with the file as the SIR names it.
pure def place_of(p: Program, source: int, loc: Loc?) -> String:
    var file = "?".to_string()
    if source >= 0 and source < len(p.sources):
        file = p.sources[source].copy()
    let at = loc else:
        return file
    return "{file}:{at.line}:{at.col}"

## A function of SIR as a message names it: its name without what follows
## a `#` (an instance's arguments, a closure's number), `Synth.next_sample`.
pure def shown_fn(name: str) -> String:
    for i in range(1, name.byte_len()):
        if name.byte_at(i) == 35:
            return name.byte_slice(0, i).to_string()
    return name.to_string()
