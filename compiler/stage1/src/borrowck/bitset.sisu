##! A set of small integers, the dataflow lattice element, and a table of
##! such sets in one buffer (stage 0's `sisu-borrowck/src/bitset.rs`). A
##! word holds 62 members here, so that no operation reaches the sign bit
##! of an `int`. The loops over words are `while` loops: compiled, a `for`
##! over a `range` calls the run time for each step, and these loops are the
##! dataflow's inner ones. The operations on a member write `WORD` out as
##! 62 (`i // 62`, `1 << (i % 62)`): natively, a constant is read through
##! a call, as a function is called, and these are the innermost steps of
##! the dataflows.

## The members a word holds.
pub const WORD: int = 62

pure def words_for(n: int) -> int:
    return (n + 61) // 62

@derive(Eq)
pub struct BitSet:
    pub words: list[int]

impl BitSet:
    pub pure def new(n: int) -> BitSet:
        var words: list[int] = []
        var k = words_for(n)
        while k > 0:
            words.push(0)
            k -= 1
        return BitSet(words=words)

    pub pure def contains(self, i: int) -> bool:
        let w = i // 62
        if w >= len(self.words):
            return False
        return (self.words[w] & (1 << (i % 62))) != 0

    ## Adds `i`; returns whether it was not there.
    pub pure def insert(mut self, i: int) -> bool:
        let w = i // 62
        while len(self.words) <= w:
            self.words.push(0)
        let b = 1 << (i % 62)
        if (self.words[w] & b) != 0:
            return False
        self.words[w] = self.words[w] | b
        return True

    pub pure def remove(mut self, i: int):
        let w = i // 62
        if w < len(self.words):
            let b = 1 << (i % 62)
            if (self.words[w] & b) != 0:
                self.words[w] = self.words[w] ^ b

    ## Adds every member of `other`; returns whether anything changed.
    pub pure def union(mut self, other: BitSet) -> bool:
        let n = len(other.words)
        while len(self.words) < n:
            self.words.push(0)
        var changed = False
        var k = 0
        while k < n:
            let o = other.words[k]
            if o != 0:
                let m = self.words[k] | o
                if m != self.words[k]:
                    self.words[k] = m
                    changed = True
            k += 1
        return changed

    ## Keeps only the members of `other`; returns whether anything changed.
    pub pure def intersect(mut self, other: BitSet) -> bool:
        var changed = False
        let n = len(self.words)
        let m = len(other.words)
        var k = 0
        while k < n:
            var b = 0
            if k < m:
                b = other.words[k]
            let x = self.words[k] & b
            if x != self.words[k]:
                self.words[k] = x
                changed = True
            k += 1
        return changed

    pub pure def subtract(mut self, other: BitSet):
        let n = min(len(self.words), len(other.words))
        var k = 0
        while k < n:
            self.words[k] = self.words[k] ^ (self.words[k] & other.words[k])
            k += 1

    ## Makes this set `other`: a copy of its words, which the run time
    ## makes at once for a list of plain values (a loop over them would
    ## copy a word at a time).
    pub pure def assign(mut self, other: BitSet):
        self.words = other.words.copy()

    pub pure def clear(mut self):
        let n = len(self.words)
        var k = 0
        while k < n:
            self.words[k] = 0
            k += 1

    pub pure def is_empty(self) -> bool:
        let n = len(self.words)
        var k = 0
        while k < n:
            if self.words[k] != 0:
                return False
            k += 1
        return True

    ## The members, in increasing order.
    pub pure def items(self) -> list[int]:
        var out: list[int] = []
        let n = len(self.words)
        var k = 0
        while k < n:
            var w = self.words[k]
            var i = k * 62
            while w != 0:
                if (w & 1) != 0:
                    out.push(i)
                w = w >> 1
                i += 1
            k += 1
        return out

    ## The smallest member.
    pub pure def first(self) -> int?:
        let n = len(self.words)
        var k = 0
        while k < n:
            var w = self.words[k]
            var i = k * 62
            while w != 0:
                if (w & 1) != 0:
                    return Some(i)
                w = w >> 1
                i += 1
            k += 1
        return None

## One set per row, every row the same number of words, kept in one
## buffer: the loans dataflow's state has a set per local, and a copy of it
## is one list rather than one per local. A row may be left out of the
## buffer (a local whose type can hold no loan, decision 219): it reads as
## empty, and nothing is written to it.
@derive(Eq)
pub struct Rows:
    ## Words per row.
    pub width: int
    pub rows: int
    ## Where each row is in the buffer, by its place among the rows kept;
    ## `LEFT_OUT` for a row left out. The copies of a set share them (stage
    ## 0's `Arc`): a copy of the dataflow's state copies its words alone.
    pub slots: Shared[list[int]]
    pub words: list[int]

## The slot of a row left out of the buffer. The operations on rows test
## a slot's sign instead (`s < 0`): natively, a constant is read through a
## call.
pub const LEFT_OUT: int = -1

## How many rows `slots` keeps in the buffer.
pure def kept_of(slots: list[int]) -> int:
    var kept = 0
    for s in slots:
        if s != LEFT_OUT:
            kept += 1
    return kept

impl Rows:
    ## `rows` empty sets, each with room for the members below `bits`.
    pub pure def new(rows: int, bits: int) -> Rows:
        var slots: list[int] = []
        var r = 0
        while r < rows:
            slots.push(r)
            r += 1
        return Rows.with_slots(Shared(slots), bits)

    ## Empty sets for the rows `slots` keeps (each its place in the buffer,
    ## or `LEFT_OUT`), each with room for the members below `bits`.
    pub pure def with_slots(own slots: Shared[list[int]], bits: int) -> Rows:
        let width = words_for(bits)
        let rows = len(Shared.get(slots))
        let kept = kept_of(Shared.get(slots))
        var words: list[int] = []
        var k = kept * width
        while k > 0:
            words.push(0)
            k -= 1
        return Rows(width=width, rows=rows, slots=slots, words=words)

    pub pure def len(self) -> int:
        return self.rows

    ## Where row `r` is in the buffer, if it is kept.
    pure def slot(self, r: int) -> int?:
        let slots = Shared.get(self.slots)
        if r < 0 or r >= len(slots):
            return None
        let s = slots[r]
        if s < 0:
            return None
        return Some(s)

    ## The words row `r` reads as: a row left out, or past the end, as many
    ## zero words as a row has.
    pure def words_of(self, r: int) -> int:
        if r < self.rows:
            return self.width
        return 0

    ## Makes every row `width` words wide (a member past the room made at
    ## the start; the loans of a function are known before its dataflow,
    ## so this does not happen in practice).
    pure def widen(mut self, width: int):
        if width <= self.width:
            return
        let kept = kept_of(Shared.get(self.slots))
        var words: list[int] = []
        for k in range(kept):
            for w in range(width):
                if w < self.width:
                    words.push(self.words[k * self.width + w])
                else:
                    words.push(0)
        self.width = width
        self.words = words

    pub pure def contains(self, r: int, i: int) -> bool:
        let s = self.slot(r) else:
            return False
        let w = i // 62
        if w >= self.width:
            return False
        return (self.words[s * self.width + w] & (1 << (i % 62))) != 0

    pub pure def insert(mut self, r: int, i: int) -> bool:
        if self.slot(r).is_none():
            return False
        self.widen(i // 62 + 1)
        let s = self.slot(r) ?? 0
        let at = s * self.width + i // 62
        let b = 1 << (i % 62)
        let had = (self.words[at] & b) != 0
        self.words[at] = self.words[at] | b
        return not had

    ## Row `r` as a set of its own.
    pub pure def get(self, r: int) -> BitSet:
        var words: list[int] = []
        match self.slot(r):
            case Some(s):
                let base = s * self.width
                var k = 0
                while k < self.width:
                    words.push(self.words[base + k])
                    k += 1
            case None:
                var k = self.words_of(r)
                while k > 0:
                    words.push(0)
                    k -= 1
        return BitSet(words=words)

    ## Replaces row `r` with `b`.
    pub pure def set(mut self, r: int, b: BitSet):
        self.clear_row(r)
        _ = self.union_row(r, b)

    ## Adds every member of `b` to row `r`; returns whether anything
    ## changed.
    pub pure def union_row(mut self, r: int, b: BitSet) -> bool:
        if self.slot(r).is_none():
            return False
        var last = len(b.words) - 1
        while last >= 0 and b.words[last] == 0:
            last -= 1
        self.widen(last + 1)
        let base = (self.slot(r) ?? 0) * self.width
        var changed = False
        let n = min(self.width, last + 1)
        var k = 0
        while k < n:
            let at = base + k
            let m = self.words[at] | b.words[k]
            if m != self.words[at]:
                self.words[at] = m
                changed = True
            k += 1
        return changed

    ## Adds the members of row `r` of `o`, which keeps the same rows, to
    ## row `r` here; returns whether anything changed.
    pub pure def union_from(mut self, r: int, o: Rows) -> bool:
        if self.width != o.width:
            return self.union_row(r, o.get(r))
        let s = self.slot(r) else:
            return False
        let base = s * self.width
        var changed = False
        var k = 0
        while k < self.width:
            let x = o.words[base + k]
            if x != 0:
                let m = self.words[base + k] | x
                if m != self.words[base + k]:
                    self.words[base + k] = m
                    changed = True
            k += 1
        return changed

    ## Makes these rows `o`'s: a copy of its words, made at once (as
    ## `BitSet.assign`), and of its slots when they are not the same.
    pub pure def assign(mut self, o: Rows):
        if self.width != o.width or len(self.words) != len(o.words):
            self.width = o.width
            self.rows = o.rows
            self.slots = o.slots.copy()
        self.words = o.words.copy()

    ## Makes row `r` the set that row `r` of `o`, which keeps the same rows,
    ## is.
    pub pure def set_from(mut self, r: int, o: Rows):
        if self.width != o.width:
            self.set(r, o.get(r))
            return
        let s = self.slot(r) else:
            return
        let base = s * self.width
        var k = 0
        while k < self.width:
            self.words[base + k] = o.words[base + k]
            k += 1

    pub pure def clear_row(mut self, r: int):
        let s = self.slot(r) else:
            return
        let base = s * self.width
        var k = 0
        while k < self.width:
            self.words[base + k] = 0
            k += 1

    ## Adds the members of row `r` to `out`.
    pub pure def add_to(self, r: int, mut out: BitSet):
        let n = self.words_of(r)
        while len(out.words) < n:
            out.words.push(0)
        let s = self.slot(r) else:
            return
        let base = s * self.width
        var k = 0
        while k < self.width:
            out.words[k] = out.words[k] | self.words[base + k]
            k += 1

    ## Adds the members of each row `live` names to `out`, as `add_to` adds
    ## one row's.
    pub pure def add_rows_to(self, live: BitSet, mut out: BitSet):
        let slots = Shared.get(self.slots)
        let w = self.width
        let n = len(live.words)
        var k = 0
        while k < n:
            var bits = live.words[k]
            var r = k * 62
            while bits != 0:
                if (bits & 1) != 0 and r < self.rows:
                    while len(out.words) < w:
                        out.words.push(0)
                    let s = slots[r]
                    if s >= 0:
                        let base = s * w
                        var j = 0
                        while j < w:
                            out.words[j] = out.words[j] | self.words[base + j]
                            j += 1
                bits = bits >> 1
                r += 1
            k += 1

    ## Adds the members of row `r` that are members of `mask` to `out`.
    pub pure def add_masked_to(self, r: int, mask: BitSet, mut out: BitSet):
        let s = self.slot(r) else:
            return
        let base = s * self.width
        let n = min(self.width, len(mask.words))
        while len(out.words) < n:
            out.words.push(0)
        var k = 0
        while k < n:
            let x = self.words[base + k] & mask.words[k]
            if x != 0:
                out.words[k] = out.words[k] | x
            k += 1

    ## The members of row `r`, in increasing order.
    pub pure def row_items(self, r: int) -> list[int]:
        var out: list[int] = []
        let s = self.slot(r) else:
            return out
        let base = s * self.width
        var k = 0
        while k < self.width:
            var w = self.words[base + k]
            var i = k * 62
            while w != 0:
                if (w & 1) != 0:
                    out.push(i)
                w = w >> 1
                i += 1
            k += 1
        return out

    ## `union`, adding to `marks` each row that changed.
    pub pure def union_marking(mut self, o: Rows, mut marks: BitSet) -> bool:
        var changed = False
        if self.width != o.width or len(self.words) != len(o.words):
            self.widen(o.width)
            for r in range(min(self.rows, o.rows)):
                if self.union_row(r, o.get(r)):
                    _ = marks.insert(r)
                    changed = True
            return changed
        let slots = Shared.get(self.slots)
        let w = self.width
        var r = 0
        while r < self.rows:
            let s = slots[r]
            if s >= 0:
                let base = s * w
                var row_changed = False
                var k = 0
                while k < w:
                    let x = o.words[base + k]
                    if x != 0:
                        let m = self.words[base + k] | x
                        if m != self.words[base + k]:
                            self.words[base + k] = m
                            row_changed = True
                    k += 1
                if row_changed:
                    _ = marks.insert(r)
                    changed = True
            r += 1
        return changed

    ## Adds every row of `o`, which keeps the same rows, to the same row
    ## here; returns whether anything changed.
    pub pure def union(mut self, o: Rows) -> bool:
        self.widen(o.width)
        var changed = False
        let n = len(self.words)
        if self.width == o.width and n == len(o.words):
            var k = 0
            while k < n:
                let x = o.words[k]
                if x != 0:
                    let m = self.words[k] | x
                    if m != self.words[k]:
                        self.words[k] = m
                        changed = True
                k += 1
            return changed
        for r in range(min(self.rows, o.rows)):
            if self.union_row(r, o.get(r)):
                changed = True
        return changed
