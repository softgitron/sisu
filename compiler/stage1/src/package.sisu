##! What a program is made of (stage 0's `sisu-driver/src/package.rs`; 09,
##! "Modules" and "Package manifest"): a single file, a script with its
##! inline metadata, a package with its dependencies, or a workspace's
##! members. `load_package` reads the manifests and walks the module trees,
##! and gives a `Layout`: every module's path, file and package, every
##! package's dependencies and trust, and the problems found.
##!
##! The module tree mirrors the file tree under `src/`: the root module is
##! `src/main.sisu` (an application) or `src/lib.sisu` (a library), named by
##! the package's name; `src/parser.sisu` is `PACKAGE.parser`; a directory
##! `src/net/` is the module `PACKAGE.net`, whose children are the files and
##! directories in it, and a file `src/net.sisu` beside it gives that module
##! items of its own.
##!
##! Paths are texts with `/` between their parts. Stage 0 compares
##! directories by their canonical form; stage 1 is given absolute paths and
##! normalises them by their text (`.` and `..` resolved), which is the same
##! where no symbolic link is involved. Stage 1 does not write the lockfile.

import stage1.manifest
import stage1.toml
from stage1.diag import Catalog, Diagnostic, Label, Msg, Param, TextRange
from stage1.manifest import Dependency, Feature, is_module_name, target_facts

## A package of the program.
pub struct Package:
    ## Its `[package] name`; empty for a single file or a script.
    pub name: String
    pub version: String
    ## Its directory.
    pub dir: String
    ## The packages its imports may name: its active dependencies, by name,
    ## as indices of `Layout.packages`.
    pub deps: list[(String, int)]
    ## Whether it may contain `unsafe` and `extern`: the root package, and
    ## the dependencies the root package's `[trust] unsafe` lists.
    pub trusted: bool
    ## Its root module is `src/main.sisu`, or it is a single file: it has a
    ## `main` to run.
    pub application: bool
    ## Its manifest, as `Layout.files` numbers them.
    pub manifest: int?
    ## Its manifest's `[features]` (09).
    pub features: list[Feature]
    ## Its features that are on in this build, sorted (decision 243).
    pub on: list[String]
    ## Its manifest's dependency entries, as far as features go.
    pub wants: list[Want]
    ## The names of its manifest's dependencies but the dev-dependencies,
    ## which the lockfile records.
    pub locked_deps: list[String]
    ## Its manifest's `[profile.release] contracts`: what a release build
    ## checks (07).
    pub release_contracts: String?
    ## Its manifest's `[package] unsafe` (22, D-082): `memory` or `extern`,
    ## and where the value is written in the manifest.
    pub unsafe_level: (String, TextRange)?

## What a dependency entry asks of the package it names (09).
pub struct Want:
    ## The name the entry gives the dependency.
    pub name: String
    ## The package, unless it could not be read or is not built (a
    ## dependency's dev-dependency).
    pub package: int?
    ## Its `when` holds on this target.
    pub active: bool
    ## `features = [...]`.
    pub features: list[(String, TextRange)]
    ## Not `default-features = false`.
    pub defaults: bool

impl Want:
    pure def of(dep: Dependency, package: int?, active: bool) -> Want:
        return Want(
            name=dep.name.copy(),
            package=package,
            active=active,
            features=dep.features.copy(),
            defaults=dep.default_features,
        )

## A module of the program: its path, its file and its package.
pub struct ModuleFile:
    ## `["weather", "parser"]`; empty for a single file.
    pub path: list[String]
    ## The file as diagnostics name it: relative to the root package's
    ## directory, with `/` separators; a single file as it was given.
    pub name: String
    pub disk: String
    ## An index of `Layout.packages`.
    pub package: int

## A diagnostic of the layout, with the files its spans are in: the
## manifest it is about and, for each label, the manifest the label points
## into (stage 0's spans carry their file), as `Layout.files` numbers them.
pub struct Problem:
    pub file: int
    pub diag: Diagnostic
    pub label_files: list[int]

## A program's layout.
pub struct Layout:
    ## The packages, the root package first.
    pub packages: list[Package]
    ## The modules, the root module first.
    pub modules: list[ModuleFile]
    ## The manifests read (the name diagnostics show, the text): the files
    ## `problems` point into.
    pub files: list[(String, String)]
    ## The problems found in the manifests and the module trees.
    pub problems: list[Problem]
    ## The directory the files' names are relative to.
    pub base: String
    ## The root package is a script: a single file with a `#!` line.
    pub script: bool
    ## Where the lockfile goes (stage 0's `lock`, without its text, which
    ## stage 1 does not write): beside the workspace's manifest when the
    ## package is a member of one, else beside its own; none for a single
    ## file.
    pub lock: String?
    ## The features the command line asked for (`--features`) that are not
    ## features: each name as given, and the package it names (decision
    ## 250).
    pub unknown_requested: list[(String, String)]

## The features a command line asks for (`--features`,
## `--no-default-features`; 09, decision 250): names of the root package's
## features, or `DEP/FEATURE` of a dependency's, on besides `default`,
## which `no_default` leaves off.
pub struct FeatureRequest:
    pub names: list[String]
    pub no_default: bool

impl FeatureRequest:
    ## What a command line that names no feature asks for.
    pub pure def none() -> FeatureRequest:
        return FeatureRequest(names=[], no_default=False)

impl Layout:
    pub pure def new(base: str) -> Layout:
        return Layout(
            packages=[],
            modules=[],
            files=[],
            problems=[],
            base=base.to_string(),
            script=False,
            lock=None,
            unknown_requested=[],
        )

    pub pure def has_errors(self, catalog: Catalog) -> bool:
        for p in self.problems:
            if catalog.is_error(p.diag.msg):
                return True
        return False

## What a command works on.
pub enum Target:
    ## One file, as given.
    File(String)
    ## A package's directory.
    Package(String)
    ## A workspace's directory and its members' directories.
    Workspace(String, list[String])

## The manifest file of a directory.
pub const MANIFEST: str = "sisu.toml"

## The lockfile beside the root manifest (09).
pub const LOCKFILE: str = "sisu.lock"

## `rel` joined to the directory `dir`: itself when it is absolute.
pub pure def join(dir: str, rel: str) -> String:
    if rel.starts_with("/"):
        return rel.to_string()
    if dir.is_empty():
        return rel.to_string()
    return "{dir}/{rel}"

## An absolute path with its `.` and `..` parts resolved and no `/` at its
## end (stage 0's `fs::canonicalize`, for paths without symbolic links).
pub pure def canonical(p: str) -> String:
    var parts: list[String] = []
    for part in p.split("/"):
        if part.is_empty() or part == ".":
            continue
        if part == "..":
            _ = parts.pop()
            continue
        parts.push(part.to_string())
    return "/{parts.join("/")}"

## The directory a path is in.
pub pure def parent(p: str) -> String:
    var cut = -1
    for i in range(p.byte_len()):
        if p.byte_at(i) == 47:
            cut = i
    if cut <= 0:
        return "/".to_string()
    return p.byte_slice(0, cut).to_string()

## The last part of a path.
pub pure def file_name(p: str) -> String:
    var cut = -1
    for i in range(p.byte_len()):
        if p.byte_at(i) == 47:
            cut = i
    return p.byte_slice(cut + 1, p.byte_len()).to_string()

## `to` relative to the directory `from`, with `/` separators (both
## canonical).
pub pure def relative(from_: str, to: str) -> String:
    var a: list[String] = []
    for part in from_.split("/"):
        if not part.is_empty():
            a.push(part.to_string())
    var b: list[String] = []
    for part in to.split("/"):
        if not part.is_empty():
            b.push(part.to_string())
    var common = 0
    while common < len(a) and common < len(b) and a[common] == b[common]:
        common += 1
    var parts: list[String] = []
    for _ in range(common, len(a)):
        parts.push("..".to_string())
    for i in range(common, len(b)):
        parts.push(b[i].copy())
    if parts.is_empty():
        return ".".to_string()
    return parts.join("/")

## Whether a file is there (and is not a directory).
pub def is_file(fs: Fs, p: str) -> bool:
    return match fs.metadata(Path.new(p)):
        case Ok(m): not m.is_dir
        case Err(_): False

pub def is_dir(fs: Fs, p: str) -> bool:
    return match fs.metadata(Path.new(p)):
        case Ok(m): m.is_dir
        case Err(_): False

pub def read_text(fs: Fs, p: str) -> String?:
    return match fs.read_to_string(Path.new(p)):
        case Ok(t): Some(t)
        case Err(_): None

## What the command's argument names: a `.sisu` file, or a directory with a
## manifest; `None` when it is neither (stage 0's `locate` with an
## argument, which names the directory itself, not one above it). `arg` is
## absolute.
pub def locate(fs: Fs, arg: str) -> Target?:
    if is_file(fs, arg) or not is_dir(fs, arg):
        return Some(Target.File(arg.to_string()))
    let m = join(arg, MANIFEST)
    if not is_file(fs, m):
        return None
    let text = read_text(fs, m) ?? String.new()
    let (parsed, _) = manifest.read(text)
    if let Some(found) = parsed:
        if found.package.is_none():
            if let Some(members) = found.members:
                var dirs: list[String] = []
                for (p, _) in members:
                    dirs.push(join(arg, p))
                return Some(Target.Workspace(arg.to_string(), dirs))
    return Some(Target.Package(arg.to_string()))

struct Loader:
    layout: Layout
    target: list[(String, String)]
    ## Each package's canonical directory, by index.
    dirs: list[String]
    ## For each package on the loader's stack, the dependency entry that led
    ## to it (none for the first), to label a cycle's edges: the manifest and
    ## the range of the dependency's name in it.
    edges: list[(int, TextRange)?]
    ## The package whose dev-dependencies are built and whose `[trust]`
    ## counts: the root package, or for a package's black-box tests (17)
    ## the package they test, whose dev-dependencies the tests' file gets.
    root: int

impl Loader:
    pure def add_file(mut self, name: str, text: str) -> int:
        self.layout.files.push((name.to_string(), text.to_string()))
        return len(self.layout.files) - 1

    pure def report(mut self, file: int, own d: Diagnostic):
        self.layout.problems.push(Problem(file=file, diag=d, label_files=[]))

    pure def shown(self, p: str) -> String:
        return relative(self.layout.base, canonical(p))

    pure def manifest_file(self, package: int) -> int:
        if package < len(self.layout.packages):
            if let Some(m) = self.layout.packages[package].manifest:
                return m
        return 0

    ## Reads the package in `dir` (once), its modules and, depth first, its
    ## dependencies. `stack` is the path of packages to it, for a cycle's
    ## report; `via` the dependency that names it.
    def package(mut self, fs: Fs, dir: str, mut stack: list[int], via: (int, Dependency)?) -> int?:
        let canon = canonical(dir)
        var known: int? = None
        for i in range(len(self.dirs)):
            if self.dirs[i] == canon:
                known = Some(i)
        if let Some(i) = known:
            var pos: int? = None
            for k in range(len(stack)):
                if stack[k] == i and pos.is_none():
                    pos = Some(k)
            let start = pos else:
                return Some(i)
            var names: list[String] = []
            for k in range(start, len(stack)):
                names.push("`{self.layout.packages[stack[k]].name}`")
            names.push("`{self.layout.packages[i].name}`")
            let cycle = names.join(" -> ")
            var file = 0
            var at = TextRange.empty(0)
            if let Some((from_, dep)) = via:
                file = self.manifest_file(from_)
                at = dep.name_range
            var d = Diagnostic.new(Msg.PackageCycle, at.start, at.end).with("cycle", cycle)
            var label_files: list[int] = []
            # The other edges of the cycle, each where its manifest names the
            # next package.
            for k in range(start + 1, len(stack)):
                if k < len(self.edges):
                    if let Some((edge_file, edge_at)) = self.edges[k]:
                        let name = self.layout.packages[stack[k - 1]].name.copy()
                        let dep = self.layout.packages[stack[k]].name.copy()
                        let params = [
                            Param(name="name".to_string(), value=name),
                            Param(name="dep".to_string(), value=dep),
                        ]
                        d.labels.push(
                            Label(
                                msg=Msg.PackageDependsHere,
                                start=edge_at.start,
                                end=edge_at.end,
                                params=params,
                                file=-1,
                            )
                        )
                        label_files.push(edge_file)
            self.layout.problems.push(Problem(file=file, diag=d, label_files=label_files))
            return None
        let manifest_path = join(dir, MANIFEST)
        let text = read_text(fs, manifest_path) else:
            if let Some((from_, dep)) = via:
                let path = self.shown(dir)
                let d = Diagnostic.new(
                    Msg.PackageNoManifest, dep.path_range.start, dep.path_range.end
                )
                self.report(self.manifest_file(from_), d.with("name", dep.name).with("path", path))
            return None
        let shown = self.shown(manifest_path)
        let file = self.add_file(shown, text)
        let (read, diags) = manifest.read(text)
        for d in diags:
            self.report(file, d.copy())
        let m = read else:
            return None
        let info = m.package.copy() else:
            if let Some((from_, dep)) = via:
                let path = self.shown(dir)
                let d = Diagnostic.new(
                    Msg.PackageNoPackage, dep.name_range.start, dep.name_range.end
                )
                self.report(self.manifest_file(from_), d.with("path", path))
            return None
        if let Some((from_, dep)) = via:
            if dep.name != info.name:
                let d = Diagnostic.new(
                    Msg.PackageRenamedDependency, dep.name_range.start, dep.name_range.end
                )
                let named = d.with("name", dep.name).with("found", info.name)
                self.report(self.manifest_file(from_), named)
        let index = len(self.layout.packages)
        self.layout.packages.push(
            Package(
                name=info.name.copy(),
                version=info.version.copy(),
                dir=canon.copy(),
                deps=[],
                trusted=index == self.root,
                application=False,
                manifest=Some(file),
                features=m.features.copy(),
                on=[],
                wants=[],
                locked_deps=locked_deps(m.dependencies),
                release_contracts=m.release_contracts.copy(),
                unsafe_level=info.unsafe_level.copy(),
            )
        )
        self.dirs.push(canon.copy())
        self.modules_of(fs, index, canon, info.name, file)
        stack.push(index)
        match via:
            case Some((from_, dep)):
                self.edges.push(Some((self.manifest_file(from_), dep.name_range)))
            case None:
                self.edges.push(None)
        for dep in m.dependencies:
            # A dev-dependency is the package's own tests' business: only
            # the root package's are built.
            if dep.dev and index != self.root:
                self.layout.packages[index].wants.push(Want.of(dep, None, False))
                continue
            var active = True
            if let Some(w) = dep.when:
                active = w.holds(self.target)
            let found = self.package(
                fs, join(canon, dep.path), mut stack, Some((index, dep.copy()))
            )
            # A black-box test's file, not the package it tests, imports
            # the package's dev-dependencies.
            var owner = index
            if dep.dev and index != 0:
                owner = 0
            self.layout.packages[owner].wants.push(Want.of(dep, found, active))
            let d = found else:
                continue
            if active:
                self.layout.packages[owner].deps.push((dep.name.copy(), d))
            if index == self.root:
                for (t, _) in m.trust_unsafe:
                    if t == dep.name:
                        self.layout.packages[d].trusted = True
        _ = stack.pop()
        _ = self.edges.pop()
        return Some(index)

    ## The modules under `dir/src`, the root module first, then the others
    ## by path.
    def modules_of(mut self, fs: Fs, package: int, dir: str, name: str, manifest_file: int):
        let src = join(dir, "src")
        let main = join(src, "main.sisu")
        let lib = join(src, "lib.sisu")
        let has_main = is_file(fs, main)
        let has_lib = is_file(fs, lib)
        var root = main.copy()
        if has_main and has_lib:
            let d = Diagnostic.new(Msg.PackageTwoRootModules, 0, 0).with("name", name)
            self.report(manifest_file, d)
        elif has_lib:
            root = lib.copy()
        elif not has_main:
            let d = Diagnostic.new(Msg.PackageNoRootModule, 0, 0).with("name", name)
            self.report(manifest_file, d)
            return
        self.layout.packages[package].application = root.ends_with("main.sisu")
        let shown = self.shown(root)
        self.layout.modules.push(
            ModuleFile(path=[name.to_string()], name=shown, disk=root.copy(), package=package)
        )
        var others: list[ModuleFile] = []
        self.walk(fs, src, [name.to_string()], package, manifest_file, True, mut others)
        others.sort_by((a, b) -> a.path.cmp(b.path))
        for m in others:
            self.layout.modules.push(m.copy())

    def walk(
        mut self,
        fs: Fs,
        dir: str,
        prefix: list[String],
        package: int,
        manifest_file: int,
        top: bool,
        mut out: list[ModuleFile],
    ):
        let entries = fs.list_dir(Path.new(dir)) else:
            return
        var paths: list[String] = []
        for e in entries:
            paths.push(e.as_str().to_string())
        paths.sort()
        for p in paths:
            let file = file_name(p)
            if file.starts_with("."):
                continue
            let directory = is_dir(fs, p)
            var stem = file.copy()
            if not directory:
                if not file.ends_with(".sisu"):
                    continue
                stem = file.byte_slice(0, file.byte_len() - 5).to_string()
                if top and (stem == "main" or stem == "lib"):
                    continue
            if not is_module_name(stem):
                let shown = self.shown(p)
                let d = Diagnostic.new(Msg.PackageModuleName, 0, 0).with("file", shown).with(
                    "name", stem
                )
                self.report(manifest_file, d)
                continue
            var path = prefix.copy()
            path.push(stem)
            if directory:
                self.walk(fs, p, path, package, manifest_file, False, mut out)
            else:
                let shown = self.shown(p)
                out.push(ModuleFile(path=path, name=shown, disk=p.copy(), package=package))

## The layout of a package in `dir`, with file names relative to `base`
## (both absolute).
pub def load_package(fs: Fs, dir: str, base: str) -> Layout:
    return load_package_with(fs, dir, base, FeatureRequest.none())

## `load_package`, with the features the command line asks for.
pub def load_package_with(fs: Fs, dir: str, base: str, request: FeatureRequest) -> Layout:
    var l = Loader(
        layout=Layout.new(canonical(base)), target=target_facts(), dirs=[], edges=[], root=0
    )
    var stack: list[int] = []
    _ = l.package(fs, dir, mut stack, None)
    turn_on_features(mut l.layout, request)
    # The lockfile: beside the workspace's manifest when the package is a
    # member of one, else beside its own.
    let canon = canonical(dir)
    var lock_dir = canon.copy()
    if let Some((d, _)) = workspace_of(fs, canon):
        lock_dir = d
    l.layout.lock = Some(join(lock_dir, LOCKFILE))
    return l.layout

## The workspace that lists `dir` as a member: the nearest directory above
## it whose manifest lists it, with its members' directories.
pub def workspace_of(fs: Fs, dir: str) -> (String, list[String])?:
    let canon = canonical(dir)
    var up = canon.copy()
    while up != "/":
        let d = parent(up)
        if let Some(text) = read_text(fs, join(d, MANIFEST)):
            let (found, _) = manifest.read(text)
            if let Some(m) = found:
                if let Some(members) = m.members:
                    var dirs: list[String] = []
                    for (p, _) in members:
                        dirs.push(canonical(join(d, p)))
                    if dirs.contains(canon):
                        return Some((d, dirs))
        up = d
    return None

## The layout of a single file: one module, in a package of its own with no
## name. A script (`#!` on its first line) may declare dependencies in its
## inline metadata, by paths relative to its directory. `disk` is the file's
## absolute path and `name` the name diagnostics give it.
pub def load_file(fs: Fs, name: str, disk: str, text: str) -> Layout:
    return load_file_with(fs, name, disk, text, FeatureRequest.none())

## `load_file`, with the features the command line asks for: a file that is
## no script declares none.
pub def load_file_with(fs: Fs, name: str, disk: str, text: str, request: FeatureRequest) -> Layout:
    if not text.starts_with("#!"):
        if let Some(dir) = tested_package(fs, disk):
            return load_black_box(fs, disk, dir, request)
    var layout = Layout.new(parent(disk))
    layout.script = text.starts_with("#!")
    layout.packages.push(
        Package(
            name=String.new(),
            version=String.new(),
            dir=parent(disk),
            deps=[],
            trusted=True,
            application=True,
            manifest=None,
            features=[],
            on=[],
            wants=[],
            locked_deps=[],
            release_contracts=None,
            unsafe_level=None,
        )
    )
    layout.modules.push(
        ModuleFile(path=[], name=name.to_string(), disk=disk.to_string(), package=0)
    )
    if not layout.script:
        turn_on_features(mut layout, request)
        return layout
    let (meta, broken) = manifest.script_metadata(text)
    if let Some(at) = broken:
        layout.files.push((name.to_string(), text.to_string()))
        layout.problems.push(
            Problem(
                file=0,
                diag=Diagnostic.new(Msg.PackageScriptMetadata, at.start, at.end),
                label_files=[],
            )
        )
        return layout
    let found = meta else:
        turn_on_features(mut layout, request)
        return layout
    # The script is the first package on the stack, reached by no edge.
    var l = Loader(layout=layout, target=target_facts(), dirs=[String.new()], edges=[None], root=0)
    l.layout.files.push((name.to_string(), found.copy()))
    let (read, diags) = manifest.read(found)
    for d in diags:
        l.report(0, d.copy())
    l.layout.packages[0].manifest = Some(0)
    let m = read else:
        return l.layout
    l.layout.packages[0].features = m.features.copy()
    let dir = l.layout.packages[0].dir.copy()
    var stack = [0]
    for dep in m.dependencies:
        var active = True
        if let Some(w) = dep.when:
            active = w.holds(l.target)
        let reached = l.package(fs, join(dir, dep.path), mut stack, Some((0, dep.copy())))
        l.layout.packages[0].wants.push(Want.of(dep, reached, active))
        let d = reached else:
            continue
        if active:
            l.layout.packages[0].deps.push((dep.name.copy(), d))
        for (t, _) in m.trust_unsafe:
            if t == dep.name:
                l.layout.packages[d].trusted = True
    turn_on_features(mut l.layout, request)
    return l.layout

## The directory of the package whose black-box tests the file `disk` is
## (17, RULES.md R65): a file of the `tests/` directory beside a package's
## manifest.
pub def tested_package(fs: Fs, disk: str) -> String?:
    let dir = parent(disk)
    if file_name(dir) != "tests":
        return None
    let up = parent(dir)
    let text = read_text(fs, join(up, MANIFEST)) else:
        return None
    let (read, _) = manifest.read(text)
    let m = read else:
        return None
    if m.package.is_none():
        return None
    return Some(up)

## The layout of a package's black-box test file (17, RULES.md R65): a
## program of one module, the file, whose dependencies are the package it
## tests, by the package's name, and the package's dev-dependencies. The
## file sees the package's `pub` items only, as any dependency's; it has
## the package's features, each turning on the package's own, so that
## `--features` and `--no-default-features` mean what they mean for the
## package. Its files are named relative to the package's directory.
pub def load_black_box(fs: Fs, disk: str, dir: str, request: FeatureRequest) -> Layout:
    let canon = canonical(dir)
    var layout = Layout.new(canon)
    let shown = relative(canon, canonical(disk))
    layout.packages.push(
        Package(
            name=String.new(),
            version=String.new(),
            dir=parent(canonical(disk)),
            deps=[],
            trusted=True,
            application=True,
            manifest=None,
            features=[],
            on=[],
            wants=[],
            locked_deps=[],
            release_contracts=None,
            unsafe_level=None,
        )
    )
    layout.modules.push(ModuleFile(path=[], name=shown, disk=disk.to_string(), package=0))
    var l = Loader(layout=layout, target=target_facts(), dirs=[String.new()], edges=[None], root=1)
    var stack = [0]
    let found = l.package(fs, canon, mut stack, None)
    if let Some(p) = found:
        let tested = l.layout.packages[p].name.copy()
        l.layout.packages[0].deps.insert(0, (tested.copy(), p))
        let want = Want(
            name=tested.copy(), package=Some(p), active=True, features=[], defaults=False
        )
        l.layout.packages[0].wants.insert(0, want)
        var features: list[Feature] = []
        for f in l.layout.packages[p].features:
            features.push(
                Feature(name=f.name.copy(), range=f.range, on=[("{tested}/{f.name}", f.range)])
            )
        l.layout.packages[0].features = features
    turn_on_features(mut l.layout, request)
    return l.layout

## The names of the dependencies but the dev-dependencies.
pure def locked_deps(deps: list[Dependency]) -> list[String]:
    var out: list[String] = []
    for d in deps:
        if not d.dev:
            out.push(d.name.copy())
    return out

## `sisu.lock` (09): the packages a build resolved, as data (stage 0's
## `lockfile_of`). Every dependency is a path, so the lock records each
## package's name, version, source (its directory relative to `dir`, the
## lockfile's) and dependencies, sorted, once, for every layout of a
## workspace's members.
pub pure def lockfile_of(layouts: list[Layout], dir: str) -> String:
    var out = String.new()
    out.push("# Written by `sisu` from the manifests: the packages this build resolved.\n")
    out.push("# It is data; `sisu` rewrites it when a manifest changes.\nversion = 1\n")
    var entries: list[(String, String, String, list[String], String)] = []
    for l in layouts:
        for p in l.packages:
            let source = "path+{relative(dir, p.dir)}"
            var deps = p.locked_deps.copy()
            deps.sort()
            # The level a package declares (22, D-082), which `sisu` refuses
            # to raise without `--accept-unsafe`.
            var level = String.new()
            if let Some((l_, _)) = p.unsafe_level:
                level = l_.copy()
            let entry = (p.name.copy(), p.version.copy(), source, deps, level)
            entries.push(entry)
    entries.sort()
    var last: (String, String, String, list[String], String)? = None
    for e in entries:
        if last == Some(e.copy()):
            continue
        last = Some(e.copy())
        let (name, version, source, deps, level) = e.copy()
        var quoted: list[String] = []
        for d in deps:
            quoted.push(toml.quote(d))
        out.push("\n[[package]]\nname = {toml.quote(name)}\nversion = {toml.quote(version)}\n")
        out.push("source = {toml.quote(source)}\ndependencies = [{quoted.join(", ")}]\n")
        if not level.is_empty():
            out.push("unsafe = {toml.quote(level)}\n")
    return out

## The `unsafe` level a lockfile records for each package, by name: the
## lines `name = "..."` and `unsafe = "..."` of each `[[package]]` (the
## lockfile is `sisu`'s own data, written by `lockfile_of`).
pub pure def locked_levels(text: str) -> list[(String, String)]:
    var out: list[(String, String)] = []
    var name = String.new()
    var level = String.new()
    var started = False
    for raw in text.lines():
        let line = raw.trim()
        if line == "[[package]]":
            if started:
                out.push((name.copy(), level.copy()))
            started = True
            name = String.new()
            level = String.new()
        elif line.starts_with("name = \""):
            name = unquoted(line.strip_prefix("name = "))
        elif line.starts_with("unsafe = \""):
            level = unquoted(line.strip_prefix("unsafe = "))
    if started:
        out.push((name, level))
    return out

## A TOML basic string's text, as `toml.quote` writes simple ones.
pure def unquoted(s: str) -> String:
    let t = s.trim()
    if t.byte_len() >= 2 and t.starts_with("\"") and t.ends_with("\""):
        return t.byte_slice(1, t.byte_len() - 1).to_string()
    return t.to_string()

## How much an `unsafe` level allows: none 0, `memory` 1, `extern` 2.
pub pure def level_rank(level: str) -> int:
    return match level:
        case "memory": 1
        case "extern": 2
        case _: 0

## Whether package `p` of the layout declares the feature `f`.
pure def has_feature(layout: Layout, p: int, f: str) -> bool:
    if p >= len(layout.packages):
        return False
    for x in layout.packages[p].features:
        if x.name == f:
            return True
    return False

## A package as `E1018` names it: its name, or for a script its file's.
pure def shown_package(layout: Layout, p: int) -> String:
    if p < len(layout.packages) and not layout.packages[p].name.is_empty():
        return layout.packages[p].name.copy()
    if let Some(m) = layout.modules.first():
        return m.name.copy()
    return String.new()

## `E1018` for `name`, which is no feature of package `of`, unless it is.
pure def check_feature(
    layout: Layout, file: int, at: TextRange, of: int, name: str, mut problems: list[Problem]
):
    if has_feature(layout, of, name):
        return
    let d = Diagnostic.new(Msg.PackageUnknownFeature, at.start, at.end)
    let named = d.with("name", name).with("package", shown_package(layout, of))
    problems.push(Problem(file=file, diag=named, label_files=[]))

## The features each package of the build turns on (09; decision 243): the
## root package's `default` feature (unless the command line says
## `--no-default-features`) and those the command line names (decision
## 250), each dependency's `default` unless every entry that reaches it
## says `default-features = false`, the features those entries list, and
## what each feature that is on turns on in turn, of its own package or
## (`DEP/FEATURE`) of a dependency. A name that is no feature is `E1018` in
## a manifest, and is kept in `unknown_requested` from the command line.
pure def turn_on_features(mut layout: Layout, request: FeatureRequest):
    let problems = feature_problems(layout)
    for x in problems:
        layout.problems.push(x.copy())
    let (on, unknown) = features_on(layout, request)
    layout.unknown_requested = unknown
    for p in range(len(on)):
        layout.packages[p].on = on[p].copy()

## `E1018` for each name a feature list gives that is no feature.
pure def feature_problems(layout: Layout) -> list[Problem]:
    var problems: list[Problem] = []
    for p in range(len(layout.packages)):
        let pkg = ref layout.packages[p]
        let file = pkg.manifest ?? 0
        for f in pkg.features:
            for (e, at) in f.on:
                match e.find("/"):
                    case Some(cut):
                        let dep = e.byte_slice(0, cut)
                        let x = e.byte_slice(cut + 1, e.byte_len())
                        var want: Want? = None
                        for w in pkg.wants:
                            if w.name == dep and want.is_none():
                                want = Some(w.copy())
                        match want:
                            case Some(w):
                                if let Some(d) = w.package:
                                    check_feature(layout, file, at, d, x, mut problems)
                            case None:
                                let d = Diagnostic.new(Msg.PackageUnknownFeature, at.start, at.end)
                                let named = d.with("name", e).with(
                                    "package", shown_package(layout, p)
                                )
                                problems.push(Problem(file=file, diag=named, label_files=[]))
                    case None:
                        check_feature(layout, file, at, p, e, mut problems)
        for w in pkg.wants:
            if let Some(d) = w.package:
                for (x, at) in w.features:
                    check_feature(layout, file, at, d, x, mut problems)
    return problems

## The features that are on in each package, sorted, and the names the
## command line asks for that are no feature, each with the package it
## names.
pure def features_on(
    layout: Layout, request: FeatureRequest
) -> (list[list[String]], list[(String, String)]):
    let n = len(layout.packages)
    # The packages the build reaches, and what reaching them turns on.
    var reached: list[bool] = []
    for _ in range(n):
        reached.push(False)
    var stack = [0]
    var work: list[(int, String)] = []
    if not request.no_default:
        work.push((0, "default".to_string()))
    var unknown: list[(String, String)] = []
    for name in request.names:
        # The package it names: the root's, or for `DEP/FEATURE` the one
        # the root package's first active entry of that name reaches.
        var target: (int, String)? = None
        match name.find("/"):
            case Some(cut):
                let dep = name.byte_slice(0, cut)
                var seen = False
                var reaches: int? = None
                if n > 0:
                    for w in layout.packages[0].wants:
                        if w.name == dep and w.active and not seen:
                            seen = True
                            reaches = w.package
                if let Some(d) = reaches:
                    target = Some((d, name.byte_slice(cut + 1, name.byte_len()).to_string()))
            case None:
                target = Some((0, name.copy()))
        match target:
            case Some((p, f)):
                if has_feature(layout, p, f):
                    work.push((p, f.copy()))
                else:
                    unknown.push((name.copy(), shown_package(layout, p)))
            case None:
                unknown.push((name.copy(), shown_package(layout, 0)))
    while let Some(p) = stack.pop():
        if p >= n or reached[p]:
            continue
        reached[p] = True
        for w in layout.packages[p].wants:
            if not w.active:
                continue
            let d = w.package else:
                continue
            stack.push(d)
            if w.defaults:
                work.push((d, "default".to_string()))
            for (x, _) in w.features:
                work.push((d, x.copy()))
    var on: list[list[String]] = []
    for _ in range(n):
        on.push([])
    while let Some((p, f)) = work.pop():
        if p >= n:
            continue
        var feature: Feature? = None
        for x in layout.packages[p].features:
            if x.name == f and feature.is_none():
                feature = Some(x.copy())
        let found = feature else:
            continue
        if on[p].contains(f):
            continue
        for (e, _) in found.on:
            match e.find("/"):
                case Some(cut):
                    let dep = e.byte_slice(0, cut)
                    let x = e.byte_slice(cut + 1, e.byte_len())
                    var target: int? = None
                    for w in layout.packages[p].wants:
                        if w.name == dep and w.active and target.is_none():
                            target = Some(w.package ?? -1)
                    if let Some(d) = target:
                        if d >= 0:
                            work.push((d, x.to_string()))
                case None:
                    work.push((p, e.copy()))
        on[p].push(f)
    for p in range(n):
        on[p].sort()
    return (on, unknown)

## The layouts a command works on, read as stage 0's `sisu check` and
## `sisu sir` read them (`cli.rs`): a package's, or each member's of a
## workspace (for `sir`, the one member with a `main`). A workspace member
## without a manifest is the only problem (its `Layout` holds the
## workspace's manifest and nothing else); a workspace whose `sir` names no
## single application gives no layout.
pub def load_target(fs: Fs, target: Target, sir: bool, request: FeatureRequest) -> list[Layout]:
    match target:
        case Target.File(f):
            let text = read_text(fs, f) ?? String.new()
            return [load_file_with(fs, file_name(f), f, text, request)]
        case Target.Package(d):
            return [load_package_with(fs, d, d, request)]
        case Target.Workspace(root, members):
            let m = join(root, MANIFEST)
            let text = read_text(fs, m) ?? String.new()
            let (parsed, _) = manifest.read(text)
            var listed: list[(String, TextRange)] = []
            if let Some(found) = parsed:
                listed = found.members.copy() ?? []
            var missing = Layout.new(root)
            missing.files.push((MANIFEST.to_string(), text.copy()))
            for (p, at) in listed:
                if not is_file(fs, join(join(root, p), MANIFEST)):
                    let d = Diagnostic.new(Msg.PackageNoMember, at.start, at.end).with("path", p)
                    missing.problems.push(Problem(file=0, diag=d, label_files=[]))
            if not missing.problems.is_empty():
                return [missing]
            var dirs = members.copy()
            if sir:
                var apps: list[String] = []
                for d in members:
                    if is_file(fs, join(d, "src/main.sisu")):
                        apps.push(d.copy())
                if len(apps) != 1:
                    return []
                dirs = apps
            var out: list[Layout] = []
            for d in dirs:
                out.push(load_package_with(fs, d, d, request))
            return out

# ------------------------------------------------------------------ tests

test "paths":
    assert canonical("/a/b/../c/./d/") == "/a/c/d"
    assert relative("/a/b", "/a/b/src/x.sisu") == "src/x.sisu"
    assert relative("/a/b", "/a/c/src") == "../c/src"
    assert relative("/a/b", "/a/b") == "."
    assert parent("/a/b/c.sisu") == "/a/b"
    assert file_name("/a/b/c.sisu") == "c.sisu"
    assert join("/a", "../b") == "/a/../b"

test "the lockfile is beside the workspace's manifest, or the package's own":
    let fs = Fs.in_memory(
        {
            "/w/sisu.toml": "[workspace]\nmembers = [\"app\", \"lib\"]\n",
            "/w/app/sisu.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
            "/w/app/src/main.sisu": "def main():\n    pass\n",
            "/p/sisu.toml": "[package]\nname = \"p\"\nversion = \"0.1.0\"\n",
            "/p/src/main.sisu": "def main():\n    pass\n",
        }
    )
    let members = ["/w/app".to_string(), "/w/lib".to_string()]
    assert workspace_of(fs, "/w/app/") == Some(("/w".to_string(), members))
    assert workspace_of(fs, "/p").is_none()
    assert load_package(fs, "/w/app", "/w/app").lock == Some("/w/sisu.lock".to_string())
    assert load_package(fs, "/p", "/p").lock == Some("/p/sisu.lock".to_string())

test "the command line's features are turned on, and a name that is none is kept":
    let fs = Fs.in_memory(
        {
            "/p/sisu.toml": "[package]\nname = \"p\"\nversion = \"0.1.0\"\n\n[features]\ndefault = [\"a\"]\na = []\nb = [\"a\"]\n",
            "/p/src/main.sisu": "def main():\n    pass\n",
        }
    )
    assert load_package(fs, "/p", "/p").packages[0].on == ["a".to_string(), "default".to_string()]
    let none = FeatureRequest(names=[], no_default=True)
    assert load_package_with(fs, "/p", "/p", none).packages[0].on.is_empty()
    let named = FeatureRequest(names=["b".to_string(), "c".to_string()], no_default=True)
    let l = load_package_with(fs, "/p", "/p", named)
    assert l.packages[0].on == ["a".to_string(), "b".to_string()]
    assert l.unknown_requested == [("c".to_string(), "p".to_string())]

test "the lockfile records each package's `unsafe` level, and a level can be read back":
    let fs = Fs.in_memory(
        {
            "/p/sisu.toml": "[package]\nname = \"p\"\nversion = \"0.1.0\"\nunsafe = \"memory\"\n\n[dependencies]\nq = {{ path = \"q\" }}\n",
            "/p/src/main.sisu": "def main():\n    pass\n",
            "/p/q/sisu.toml": "[package]\nname = \"q\"\nversion = \"0.2.0\"\n",
            "/p/q/src/lib.sisu": "pub def f():\n    pass\n",
        }
    )
    let layout = load_package(fs, "/p", "/p")
    let text = lockfile_of([layout], "/p")
    assert text.contains(
        "name = \"p\"\nversion = \"0.1.0\"\nsource = \"path+.\"\ndependencies = [\"q\"]\nunsafe = \"memory\"\n"
    )
    assert locked_levels(text)
        == [("p".to_string(), "memory".to_string()), ("q".to_string(), String.new())]
    assert level_rank("extern") > level_rank("memory") and level_rank("memory") > level_rank("")
