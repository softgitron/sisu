##! Unicode tables stage 1 pins (docs/port-debt.md, "Unicode tables"),
##! taken from Rust 1.97, which implements Unicode 17.0.0 and is the host of
##! stage 0, so that the two front ends agree beyond ASCII. Each table is a
##! sorted list of disjoint ranges of code points, written as fixed-width
##! records `LLLLLL-HHHHHH` in hexadecimal, each followed by one space or
##! line break: record `k` starts at byte `14 * k`, so a lookup is a
##! binary search over the text itself.

## The width in bytes of a record and the separator after it.
const RECORD: int = 14

## Whether the code point `n` is in one of the ranges of `table`.
pub pure def in_table(table: str, n: int) -> bool:
    var lo = 0
    var hi = table.byte_len() // RECORD - 1
    while lo <= hi:
        let mid = (lo + hi) // 2
        if n < hex_at(table, mid * RECORD):
            hi = mid - 1
        elif n > hex_at(table, mid * RECORD + 7):
            lo = mid + 1
        else:
            return True
    return False

## The six hexadecimal digits at byte `at` of `table`.
pure def hex_at(table: str, at: int) -> int:
    var value = 0
    for i in range(at, at + 6):
        let b = table.byte_at(i).to_int()
        value = value * 16 + (if b <= 57: b - 48 else: b - 87)
    return value

