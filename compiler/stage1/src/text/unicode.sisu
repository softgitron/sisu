"""

test "the tables answer for their ranges and between them":
    assert in_table(numeric(), 0x661)
    assert in_table(numeric(), 0xB2)
    assert not in_table(numeric(), 0x41)
    assert not in_table(numeric(), 0xE9)
    assert in_table(escaped(), 0x85)
    assert in_table(escaped(), 0x301)
    assert in_table(escaped(), 0x10FFFF)
    assert not in_table(escaped(), 0xE9)
    assert not in_table(escaped(), 0x1F600)
    assert not in_table(escaped(), 0x20AC)
