##! `sisu audit --unsafe` (proposal/22-unsafe.md, "The audit and the
##! lints"; D-083; RULES.md, R7): a `pure` function of the program's
##! packages and modules. Per package, with the level its manifest declares
##! and how the program consents to it, every module that contains unsafe
##! code (the module, not the block, is the unit of review), with a hash of
##! its text, the key of the review ledger (N-43), and in each module every
##! `unsafe:` block and `unsafe` expression with the function it is in,
##! every `unsafe def` and `unsafe trait` with the obligations its `Safety:`
##! list names, every `unsafe impl` and `extern` block, each with its
##! location and its safety comment; then the package's foreign functions,
##! each with the functions that call it and what each holds: a capability
##! (a parameter of a capability type, or the impl of a capability trait it
##! is a method of), the purity it asserts, or nothing. The lints follow, as
##! `sisu check --format=ids` prints them.

from stage1.diag import Catalog
from stage1.lexer import lex
from stage1.parser import parse
from stage1.sir import (
    Callee,
    Function,
    ImplTarget,
    Operand,
    Place,
    Program,
    Proj,
    Rvalue,
    StatementKind,
    Type,
    TypeDecl,
)
from stage1.sir.types import Decls, place_ty
from stage1.sir.write import quote as sir_quote
from stage1.syntax.ast import (
    Ast,
    Block,
    ExprId,
    ExprKind,
    FnDef,
    ItemId,
    ItemKind,
    Module,
    ParamKind,
    StmtId,
    StmtKind,
    TypeExprId,
    TypeKind,
)
from stage1.syntax.ast import build
from stage1.syntax.ast import visit
from stage1.syntax.kinds import SyntaxKind
from stage1.syntax.tree import Token
from stage1.typeck.safety import doc_above, safety_comment, safety_list

## A package as the audit shows it.
pub struct AuditPackage:
    pub name: String
    pub version: String
    ## `memory`, `extern`, or empty when its manifest declares none.
    pub level: String
    ## How the program consents to its unsafe code: `the root package`,
    ## `trusted in sisu.toml:14`, `not trusted`.
    pub consent: String

## A module as the audit shows it: its package (an index of the
## packages), its path (`fasthash.table`), its file and its text.
pub struct AuditModule:
    pub package: int
    pub path: String
    pub file: String
    pub text: String

## One line of a module's listing: where, what, and the safety comment or
## the `Safety:` list.
struct Entry:
    line: int
    what: String
    note: String

## A foreign function a module declares, and the calls of it the module
## makes: each caller and what it holds.
struct Foreign:
    name: String
    callers: list[String]

## What a module holds of unsafe code.
struct Listing:
    entries: list[Entry]
    blocks: int
    defs: int
    impls: int
    traits: int
    externs: int
    foreign: list[Foreign]

## The capability types and traits a caller may hold (06).
pure def is_capability(name: str) -> bool:
    return match name:
        case "Fs" | "Net" | "Clock" | "Rand" | "Env" | "Proc" | "Stdin" | "System": True
        case "Cap" | "Lent": True
        case _: False

## The 1-based line of byte `at`.
pure def line_of(text: str, at: int) -> int:
    var line = 1
    var i = 0
    let end = min(at, text.byte_len())
    while i < end:
        if text.byte_at(i) == 10:
            line += 1
        i += 1
    return line

## A text's 64-bit FNV-1a hash, in 16 hex digits: a module's key in the
## review ledger, which changes with any byte of it.
pub pure def module_hash(text: str) -> String:
    var h = -3750763034362895579
    for i in range(text.byte_len()):
        h = h ^ text.byte_at(i)
        h = h *% 1099511628211
    let digits = "0123456789abcdef"
    var out = String.new()
    var k = 15
    while k >= 0:
        let nibble = (h >> (4 * k)) & 15
        out.push(digits.byte_slice(nibble, nibble + 1))
        k -= 1
    return out

## A comment for the listing: on one line, at most 100 characters.
pure def shown(text: str) -> String:
    var out = String.new()
    var n = 0
    for c in text.chars():
        if n >= 100:
            out.push("...")
            break
        out.push_char(c)
        n += 1
    return out

## The `# safety:` comment above the line of `at`, or the word that it has
## none.
pure def comment_at(text: str, at: int) -> String:
    match safety_comment(text, at):
        case Some(c):
            return "# safety: {shown(c.text)}"
        case None:
            return "(no `# safety:` comment)"

## The obligations of the `Safety:` list above `at`, or the word that it
## has none.
pure def obligations_at(text: str, at: int) -> String:
    match safety_list(doc_above(text, at)):
        case Some(os):
            if os.is_empty():
                return "Safety: (no obligation named)"
            var named: list[String] = []
            for o in os:
                named.push("`{o}`")
            return "Safety: {named.join(", ")}"
        case None:
            return "(no `Safety:` list)"

## The name of a type as written, its first segment's (`HostClock`,
## `Allocator`).
pure def type_name(ast: Ast, t: TypeExprId) -> String:
    match ast.type_expr(t).kind:
        case TypeKind.Path(segments, _):
            if let Some(s) = segments.last():
                return s.text.copy()
        case TypeKind.Ref(_, inner):
            return type_name(ast, inner)
        case _:
            pass
    return String.new()

## What a function holds that a foreign call it makes may use: the purity
## it asserts, a capability parameter, or the capability trait whose impl
## it is a method of.
pure def holds(ast: Ast, f: FnDef, capability_impl: String?) -> String:
    if f.is_pure:
        return "asserted pure"
    for p in f.params:
        if let ParamKind.Named(_, ty, _) = p.kind:
            let n = type_name(ast, ty)
            if is_capability(n):
                return "takes `{n}`"
    if let Some(c) = capability_impl:
        return "in an impl of `{c}`"
    return "no capability"

struct Walker:
    text: String
    module: Module
    out: Listing
    ## The foreign functions of the module, by name.
    foreign_names: list[String]

impl Walker:
    pure def entry(mut self, at: int, own what: String, own note: String):
        self.out.entries.push(Entry(line=line_of(self.text, at), what=what, note=note))

    ## The items of the module, `extern` blocks first so that the foreign
    ## functions are known to the bodies.
    pure def items(mut self, items: list[ItemId]):
        for id in items:
            let item = self.module.ast.item(id).copy()
            if let ItemKind.Extern(members) = item.kind:
                self.out.externs += 1
                let note = comment_at(self.text, item.range.start)
                self.entry(item.range.start, "extern block".to_string(), note)
                for mid in members:
                    if let ItemKind.Fn(f) = self.module.ast.item(mid).kind:
                        self.foreign_names.push(f.name.text.copy())
                        self.out.foreign.push(Foreign(name=f.name.text.copy(), callers=[]))
        for id in items:
            let item = self.module.ast.item(id).copy()
            match item.kind:
                case ItemKind.Fn(f):
                    self.function(f, String.new(), None, None)
                case ItemKind.Struct(s):
                    for m in s.methods:
                        self.function(m, "{s.name.text}.", None, None)
                case ItemKind.Enum(e) | ItemKind.ErrorSet(e):
                    for m in e.methods:
                        self.function(m, "{e.name.text}.", None, None)
                case ItemKind.Trait(t):
                    if t.is_unsafe:
                        self.out.traits += 1
                        let note = obligations_at(self.text, t.name.range.start)
                        self.entry(t.name.range.start, "unsafe trait {t.name.text}", note)
                    for m in t.methods:
                        self.function(m, "{t.name.text}.", None, None)
                case ItemKind.Impl(i):
                    let self_name = type_name(self.module.ast, i.self_ty)
                    var trait_name: String? = None
                    if let Some(tt) = i.trait_ty:
                        trait_name = Some(type_name(self.module.ast, tt))
                    if i.is_unsafe:
                        self.out.impls += 1
                        let note = comment_at(self.text, item.range.start)
                        let header = match trait_name:
                            case Some(t): "unsafe impl {t} for {self_name}"
                            case None: "unsafe impl {self_name}"
                        self.entry(item.range.start, header, note)
                    var capability: String? = None
                    if let Some(t) = trait_name:
                        if is_capability(t):
                            capability = Some(t.copy())
                    for m in i.methods:
                        self.function(m, "{self_name}.", capability.copy(), trait_name.copy())
                case _:
                    pass

    ## A function, a method of `owner` (`Type.`), in an impl of the trait
    ## `of_trait` when it is one, whose `unsafe def`s have that trait's
    ## obligations unless they list their own.
    pure def function(mut self, f: FnDef, owner: str, capability: String?, of_trait: String?):
        let name = "{owner}{f.name.text}"
        if f.is_unsafe:
            self.out.defs += 1
            var note = obligations_at(self.text, f.range.start)
            if let Some(t) = of_trait:
                if safety_list(doc_above(self.text, f.range.start)).is_none():
                    note = "Safety: `{t}.{f.name.text}`'s"
            self.entry(f.name.range.start, "unsafe def {name}", note)
        let body = f.body.copy() else:
            return
        let held = holds(self.module.ast, f, capability)
        self.block(body, name, held)

    pure def block(mut self, b: Block, function: str, held: str):
        for s in b.stmts:
            self.stmt(s, function, held)

    ## A statement: an `unsafe:` block is an entry, and so is each `unsafe`
    ## expression in it, whose comment is above the statement.
    pure def stmt(mut self, s: StmtId, function: str, held: str):
        let st = self.module.ast.stmt(s).copy()
        if let StmtKind.Unsafe(b) = st.kind:
            self.out.blocks += 1
            let note = comment_at(self.text, st.range.start)
            self.entry(st.range.start, "unsafe block in {function}", note)
            self.calls_in(visit.exprs_in_block(self.module.ast, b), function, held)
            self.block(b, function, held)
            return
        # The blocks inside this statement, each a statement of its own; the
        # `unsafe` expressions of the statement itself.
        var nested: list[Block] = []
        match st.kind:
            case StmtKind.If(branches, else_block):
                for (_, b) in branches:
                    nested.push(b.copy())
                if let Some(b) = else_block:
                    nested.push(b.copy())
            case StmtKind.While(_, b):
                nested.push(b.copy())
            case StmtKind.For(_, _, _, b):
                nested.push(b.copy())
            case StmtKind.Defer(b):
                nested.push(b.copy())
            case StmtKind.With(_, _, b):
                nested.push(b.copy())
            case _:
                pass
        if nested.is_empty():
            for e in visit.exprs_in_block(
                self.module.ast, Block(node=0, range=st.range, stmts=[s])
            ):
                if let ExprKind.Unsafe(inner) = self.module.ast.expr(e).kind:
                    self.out.blocks += 1
                    let note = comment_at(self.text, st.range.start)
                    self.entry(st.range.start, "unsafe expression in {function}", note)
                    self.calls_in(visit.exprs_of(self.module.ast, inner), function, held)
            return
        for b in nested:
            self.block(b, function, held)

    ## The foreign functions the expressions call, each with its caller.
    pure def calls_in(mut self, exprs: list[ExprId], function: str, held: str):
        for e in exprs:
            if let ExprKind.Call(callee, _, _) = self.module.ast.expr(e).kind:
                if let ExprKind.Name(n) = self.module.ast.expr(callee).kind:
                    for k in range(len(self.out.foreign)):
                        if self.out.foreign[k].name == n:
                            let caller = "{function} ({held})"
                            if not self.out.foreign[k].callers.contains(caller.copy()):
                                self.out.foreign[k].callers.push(caller)

## What a module holds of unsafe code.
pure def listing(text: str) -> Listing:
    let module = build.module(parse(text, Catalog.parse("")).tree)
    let items = module.items.copy()
    var w = Walker(
        text=text.to_string(),
        module=module,
        out=Listing(entries=[], blocks=0, defs=0, impls=0, traits=0, externs=0, foreign=[]),
        foreign_names=[],
    )
    w.items(items)
    w.out.entries.sort_by((a, b) -> a.line.cmp(b.line))
    return w.out

## The counts of a listing: `2 blocks, 1 unsafe def`.
pure def counted(l: Listing) -> String:
    var parts: list[String] = []
    for (n, one, many) in [
        (l.blocks, "block", "blocks"),
        (l.defs, "unsafe def", "unsafe defs"),
        (l.traits, "unsafe trait", "unsafe traits"),
        (l.impls, "unsafe impl", "unsafe impls"),
        (l.externs, "extern block", "extern blocks"),
    ]:
        if n == 1:
            parts.push("1 {one}")
        elif n > 1:
            parts.push("{n} {many}")
    return parts.join(", ")

## The audit: each package, its modules with unsafe code and their
## entries, its foreign functions; then `lints`, the lines of `sisu check
## --format=ids` that the lints and the rules of unsafe code gave.
pub pure def unsafe_report(
    packages: list[AuditPackage], modules: list[AuditModule], lints: list[String]
) -> String:
    var out = String.new()
    for k in range(len(packages)):
        let p = ref packages[k]
        # A package's declared level; a program of one file, which
        # declares none and may hold any unsafe code, says so (RULES.md,
        # R69).
        var level = "unsafe = \"{p.level}\""
        if p.level.is_empty():
            level = "no `unsafe`".to_string()
        elif p.level != "memory" and p.level != "extern":
            level = p.level.copy()
        var title = p.name.copy()
        if not p.version.is_empty():
            title.push(" {p.version}")
        out.push("{title}   {level}   {p.consent}\n")
        var foreign: list[Foreign] = []
        var any = False
        for m in modules:
            if m.package != k:
                continue
            let l = listing(m.text)
            if l.entries.is_empty():
                continue
            any = True
            out.push("  {m.path} ({m.file})   {counted(l)}, module hash {module_hash(m.text)}\n")
            for e in l.entries:
                out.push("    {m.file}:{e.line}   {e.what}   {e.note}\n")
            for f in l.foreign:
                foreign.push(f.copy())
        if not any:
            out.push("  no unsafe code\n")
        if not foreign.is_empty():
            var shown_calls: list[String] = []
            for f in foreign:
                if f.callers.is_empty():
                    shown_calls.push("{f.name} (not called)")
                else:
                    shown_calls.push("{f.name} (called by {f.callers.join(", ")})")
            out.push("  foreign functions: {shown_calls.join("; ")}\n")
    if not lints.is_empty():
        out.push("lints:\n")
        for l in lints:
            out.push("  {l}\n")
    return out

## `audit --ownership` (18, Phase 3, T1.1 and T1.2; RULES.md, R188): how
## often a file reaches for the escape hatches of the ownership model, as
## the driver's `audit::ownership` counts them, from the tokens: the names
## `Shared`, `Weak`, `Cell`, `Arena` and `Key` where they mean std's types
## (not after a `.`, and not in a file that declares the name itself), the
## method calls `.copy()`, and the keyword `unsafe`; `lines` the lines on
## which a token starts that is not trivia or layout. One line of data:
## the file's name, then `name=count` for `lines` and each column.
pub pure def ownership_line(file: str, text: str) -> String:
    let module = build.module(parse(text, Catalog.parse("")).tree)
    var declared: list[String] = []
    declared_names(module, module.items, mut declared)
    let tokens = lex(text).tokens
    var code: list[Token] = []
    for t in tokens:
        if t.kind.is_trivia():
            continue
        match t.kind:
            case SyntaxKind.Newline | SyntaxKind.Indent | SyntaxKind.Dedent | SyntaxKind.Eof:
                continue
            case _:
                code.push(t)
    let names = ["Shared", "Weak", "Cell", "Arena", "Key"]
    var counts = [0, 0, 0, 0, 0, 0, 0]
    var lines = 0
    var line = 1
    var last_line = 0
    var at = 0
    for i in range(len(code)):
        let t = code[i]
        while at < t.start and at < text.byte_len():
            if text.byte_at(at) == 10:
                line += 1
            at += 1
        if line != last_line:
            lines += 1
            last_line = line
        let after_dot = i > 0 and code[i - 1].kind == SyntaxKind.Dot
        let word = text.byte_slice(t.start, t.end)
        if t.kind == SyntaxKind.UnsafeKw:
            counts[6] += 1
        elif t.kind == SyntaxKind.Ident and after_dot:
            let call = i + 1 < len(code) and code[i + 1].kind == SyntaxKind.LParen
            if word == "copy" and call:
                counts[5] += 1
        elif t.kind == SyntaxKind.Ident and not declared.contains(word.to_string()):
            for k in range(len(names)):
                if names[k] == word:
                    counts[k] += 1
    var out = "{file} lines={lines}"
    let columns = ["Shared", "Weak", "Cell", "Arena", "Key", "copy", "unsafe"]
    for k in range(len(columns)):
        out.push(" {columns[k]}={counts[k]}")
    return out

## The names a file declares at its top level, which then mean its own
## declarations rather than std's.
pure def declared_names(module: Module, items: list[ItemId], mut out: list[String]):
    for id in items:
        match module.ast.item(id).kind:
            case ItemKind.Fn(f):
                out.push(f.name.text.copy())
            case ItemKind.Struct(s):
                out.push(s.name.text.copy())
            case ItemKind.Enum(e) | ItemKind.ErrorSet(e):
                out.push(e.name.text.copy())
                for v in e.variants:
                    out.push(v.name.text.copy())
            case ItemKind.Trait(t):
                out.push(t.name.text.copy())
            case ItemKind.Const(k):
                out.push(k.name.text.copy())
            case ItemKind.TypeAlias(a):
                out.push(a.name.text.copy())
            case ItemKind.FromImport(f):
                for (n, alias) in f.names:
                    match alias:
                        case Some(a):
                            out.push(a.text.copy())
                        case None:
                            out.push(n.text.copy())
            case ItemKind.Extern(inner):
                declared_names(module, inner, mut out)
            case _:
                pass

## The capability types of `audit --caps`: the handles of a `System`, the
## `System`, a test clock, and a `Lent` of a handle.
const CAPABILITIES: list[str] = [
    "Fs", "Net", "Clock", "Rand", "Env", "Proc", "Stdin", "System", "TestClock", "Lent"
]

## The operations traits, whose methods a capability's calls are.
const OPS_TRAITS: list[str] = [
    "FsOps", "NetOps", "ClockOps", "RandOps", "EnvOps", "ProcOps", "StdinOps"
]

## A type without the references around it.
pure def strip_refs(t: Type) -> Type:
    var u = t.copy()
    while True:
        match u.copy():
            case Type.Ref(inner, _):
                u = inner[0].copy()
            case _:
                return u

## The capability types a type holds, by name: itself (through
## references), or the fields of a struct or enum of the program, its
## tuples, options and collections (decision 240).
pure def capability_types(decls: Decls, t: Type, mut out: list[String], depth: int):
    if depth > 8:
        return
    match t:
        case Type.Ref(inner, _):
            capability_types(decls, inner[0], mut out, depth + 1)
        case Type.Tuple(es):
            for e in es:
                capability_types(decls, e, mut out, depth + 1)
        case Type.Named(n, args):
            if CAPABILITIES.contains(n):
                # A `Lent` is its handle's capability.
                var name = n.copy()
                if n == "Lent" and not args.is_empty():
                    if let Type.Named(h, _) = args[0].copy():
                        name = h
                if not out.contains(name.copy()):
                    out.push(name)
                return
            for a in args:
                capability_types(decls, a, mut out, depth + 1)
            let d = decls.get(n) else:
                return
            match d:
                case TypeDecl.Struct(_, _, fields, _, _, _):
                    for f in fields:
                        capability_types(decls, f.ty.subst(args), mut out, depth + 1)
                case TypeDecl.Enum(_, _, variants, _, _, _, _):
                    for v in variants:
                        for (_, ft) in v.fields:
                            capability_types(decls, ft.subst(args), mut out, depth + 1)
        case _:
            pass

## The type of a place, a `System`'s fields being its handles.
pure def cap_place_type(decls: Decls, f: Function, p: Place) -> Type?:
    if let Some(t) = place_ty(decls, f, p):
        return Some(t)
    # `sys.fs`: the `System` is a builtin, its fields the handles in the
    # order `System.assemble` takes them.
    let handles = ["Fs", "Net", "Clock", "Rand", "Env", "Proc", "Stdin"]
    if p.local.index >= len(f.locals):
        return None
    var k = 0
    while k < len(p.proj) and p.proj[k] == Proj.Deref:
        k += 1
    if k + 1 != len(p.proj):
        return None
    if let Type.Named(n, _) = strip_refs(f.locals[p.local.index].ty):
        if n == "System":
            if let Proj.Field(i) = p.proj[k]:
                if i < len(handles):
                    return Some(Type.Named(name=handles[i].to_string(), args=[]))
    return None

## A function as `audit --caps` names it: a test as its trace names it,
## `test "its name"`, where its SIR name numbers it (decision 505).
pure def caps_name(prog: Program, n: str) -> String:
    if not n.starts_with("test#"):
        return n.to_string()
    return shown_fn(prog, n)

## A SIR function's name as a trace shows it (stage 0's `display_fn_name`),
## as far as a test's functions need it: `test "its name"`, and `closure in
## ...` of a closure written in one.
pure def shown_fn(prog: Program, n: str) -> String:
    if n.starts_with("test#"):
        for (t, f) in prog.tests:
            if f == n:
                return "test {sir_quote(t)}"
        if let Some(i) = n.byte_slice(5, n.byte_len()).parse_int():
            if i < len(prog.tests):
                return "test {sir_quote(prog.tests[i].0)}"
    if n.ends_with(".__check_invariant"):
        return "the invariant of {n.byte_slice(0, n.byte_len() - 18)}"
    if let Some(k) = n.find("#closure"):
        return "closure in {shown_fn(prog, n.byte_slice(0, k))}"
    return n.to_string()

## `audit --caps` (18, Phase 6; T2.1, T2.3 and the threading depth of 20's
## pre-registration; RULES.md, R188), as the driver's `audit::caps`
## computes it from the program's SIR: for each function of the program
## that does I/O (calls an operation of a capability, or a function that
## does), the number of its parameters that hold a capability; for each
## such call (a leaf use), the threading depth, the fewest calls from
## `main` to the function that makes it; and the structs of the program
## (`own_structs`) that bundle three or more capability types. Every line
## starts with `file`.
pub pure def caps_report(file: str, prog: Program, own_structs: list[String]) -> String:
    let decls = Decls.new(prog.types)
    let nf = len(prog.functions)
    # The program's own functions, by name, in the order of their names.
    var by_name: dict[String, int] = {}
    var names: list[String] = []
    for i in range(nf):
        let f = ref prog.functions[i]
        if f.source < len(prog.sources) and not prog.sources[f.source].starts_with("<"):
            if not by_name.contains(f.name.copy()):
                names.push(f.name.copy())
            _ = by_name.insert(f.name.copy(), i)
    names.sort()
    var order: list[int] = []
    for n in names:
        order.push(by_name.get(n) ?? 0)
    # Each function's calls of the program's functions (a closure counts as
    # called where it is made), and its uses of capabilities.
    var edges: list[list[int]] = []
    var generic_caps: list[list[int]] = []
    for _ in range(nf):
        edges.push([])
        generic_caps.push([])
    var uses: list[(int, String)] = []
    for i in order:
        let f = ref prog.functions[i]
        for b in f.blocks:
            for s in b.stmts:
                match s.kind:
                    case StatementKind.Call(_, callee, args):
                        var first_ty: Type? = None
                        if let Some(a) = args.first():
                            match a:
                                case Operand.Copy(p) | Operand.Move(p):
                                    first_ty = cap_place_type(decls, f, p)
                                case _:
                                    pass
                        # A call on a capability itself (not on a struct that
                        # holds one) is a use of it.
                        var on_capability = False
                        if let Some(t) = first_ty:
                            if let Type.Named(n, _) = strip_refs(t):
                                on_capability = CAPABILITIES.contains(n)
                        match callee:
                            case Callee.Fn(target, _):
                                if let Some(j) = by_name.get(target.copy()):
                                    edges[i].push(j)
                                elif on_capability:
                                    uses.push((i, target.copy()))
                            case Callee.Trait(method, tys):
                                var tr = method.copy()
                                var m = method.copy()
                                if let Some(d) = method.find("."):
                                    tr = method.byte_slice(0, d).to_string()
                                var k = method.byte_len() - 1
                                while k >= 0:
                                    if method.byte_at(k) == 46:
                                        m = method.byte_slice(k + 1, method.byte_len()).to_string()
                                        break
                                    k -= 1
                                if OPS_TRAITS.contains(tr):
                                    uses.push((i, method.copy()))
                                    # A type parameter that a capability's
                                    # operation is called on is a capability.
                                    if let Some(t) = tys.first():
                                        if let Type.Param(p) = strip_refs(t):
                                            if not generic_caps[i].contains(p):
                                                generic_caps[i].push(p)
                                else:
                                    # The impls of the program it may run.
                                    for imp in prog.impls:
                                        if imp.trait_name != tr:
                                            continue
                                        for (mn, target) in imp.methods:
                                            if mn != m:
                                                continue
                                            if let ImplTarget.Fn(t) = target:
                                                if let Some(j) = by_name.get(t.copy()):
                                                    edges[i].push(j)
                            case Callee.Intrinsic(name, _):
                                # Lending a capability passes it on; it does
                                # no I/O.
                                let lends = name.starts_with("cap.") or name.starts_with("Lent.")
                                if on_capability and not lends:
                                    uses.push((i, name.copy()))
                            case _:
                                pass
                    case StatementKind.Assign(_, value):
                        if let Rvalue.Closure(name, _, _) = value:
                            if let Some(j) = by_name.get(name.copy()):
                                edges[i].push(j)
                    case _:
                        pass
    # The fewest calls from `main` to each function.
    var depth: list[int?] = []
    for _ in range(nf):
        depth.push(None)
    if let Some(e) = prog.entry:
        if let Some(m) = by_name.get(e.function.copy()):
            depth[m] = Some(0)
            var queue = [m]
            var head = 0
            while head < len(queue):
                let i = queue[head]
                head += 1
                for j in edges[i]:
                    if depth[j].is_none():
                        depth[j] = Some((depth[i] ?? 0) + 1)
                        queue.push(j)
    # The functions that do I/O: those with a use, and their callers.
    var io: list[String?] = []
    for _ in range(nf):
        io.push(None)
    for (i, _) in uses:
        io[i] = Some("direct".to_string())
    var more = True
    while more:
        more = False
        for i in order:
            if io[i].is_some():
                continue
            for j in edges[i]:
                if io[j].is_some():
                    io[i] = Some("calls".to_string())
                    more = True
                    break
    var out = String.new()
    var counts: list[int] = []
    for i in order:
        let kind = io[i].copy() else:
            continue
        let f = ref prog.functions[i]
        var params = 0
        for k in range(1, f.param_count + 1):
            if k >= len(f.locals):
                break
            let ty = f.locals[k].ty.copy()
            var found: list[String] = []
            capability_types(decls, ty, mut found, 0)
            var generic = False
            if let Type.Param(p) = strip_refs(ty):
                generic = generic_caps[i].contains(p)
            if not found.is_empty() or generic:
                params += 1
        counts.push(params)
        let name = caps_name(prog, f.name)
        out.push("{file} function {name} caps={params} io={kind} depth={shown_depth(depth[i])}\n")
    uses.sort_by(
        (a, b) -> (prog.functions[a.0].name.copy(), a.1.copy()).cmp(
            (prog.functions[b.0].name.copy(), b.1.copy())
        )
    )
    var kept: list[(int, String)] = []
    for u in uses:
        if let Some(last) = kept.last():
            if last.0 == u.0 and last.1 == u.1:
                continue
        kept.push(u.copy())
    for (i, op) in kept:
        let name = caps_name(prog, prog.functions[i].name)
        out.push("{file} use {name} {op} depth={shown_depth(depth[i])}\n")
    var bundles = 0
    for d in prog.types:
        if let TypeDecl.Struct(name, _, fields, _, _, _) = d:
            if not own_structs.contains(name.copy()):
                continue
            var found: list[String] = []
            for f in fields:
                capability_types(decls, f.ty, mut found, 0)
            # A `System` bundles all of them, by the language's design.
            var held: list[String] = []
            for c in found:
                if c != "System":
                    held.push(c.copy())
            if len(held) >= 3:
                bundles += 1
                out.push("{file} struct {name} caps={len(held)} {held.join(",")}\n")
    counts.sort()
    var median = "0".to_string()
    let n = len(counts)
    if n % 2 == 1:
        median = "{counts[n // 2]}"
    elif n > 0:
        let twice = counts[n // 2 - 1] + counts[n // 2]
        if twice % 2 == 0:
            median = "{twice // 2}"
        else:
            median = "{twice // 2}.5"
    var deepest: int? = None
    for (i, _) in kept:
        if let Some(d) = depth[i]:
            if deepest.is_none() or d > (deepest ?? 0):
                deepest = Some(d)
    var max = 0
    if let Some(m) = counts.last():
        max = m
    out.push(
        "{file} summary functions={n} median={median} max={max} uses={len(kept)} deepest={shown_depth(deepest)} structs={bundles}\n"
    )
    return out

## A depth, or `-` for none.
pure def shown_depth(d: int?) -> String:
    let k = d else:
        return "-".to_string()
    return "{k}"

test "a module's hash is its text's":
    assert module_hash("") == "cbf29ce484222325"
    assert module_hash("a") == "af63dc4c8601ec8c"
    assert module_hash("a") != module_hash("b")

test "the audit lists blocks, declarations and foreign calls by module":
    let text = "# safety: getpid takes nothing.\nextern \"C\":\n    def getpid() -> int\n\n## Halves.\n##\n## Safety:\n## - `even`: n is even\nunsafe def half(n: int) -> int:\n    return n // 2\n\npub pure def pid() -> int:\n    # safety: pure: the id is the same all along.\n    return unsafe getpid()\n\ndef main():\n    # safety: even: 4 is even.\n    unsafe:\n        print(half(4))\n"
    let packages = [
        AuditPackage(
            name="p".to_string(),
            version="0.1.0".to_string(),
            level="extern".to_string(),
            consent="the root package".to_string(),
        )
    ]
    let modules = [
        AuditModule(
            package=0, path="p".to_string(), file="src/main.sisu".to_string(), text=text.to_string()
        )
    ]
    let report = unsafe_report(packages, modules, [])
    var lines: list[str] = []
    for l in report.lines():
        lines.push(l)
    assert lines[0] == "p 0.1.0   unsafe = \"extern\"   the root package"
    assert lines[1].starts_with(
        "  p (src/main.sisu)   2 blocks, 1 unsafe def, 1 extern block, module hash "
    )
    assert lines[2] == "    src/main.sisu:2   extern block   # safety: getpid takes nothing."
    assert lines[3] == "    src/main.sisu:9   unsafe def half   Safety: `even`"
    assert lines[4]
        == "    src/main.sisu:14   unsafe expression in pid   # safety: pure: the id is the same all along."
    assert lines[5] == "    src/main.sisu:18   unsafe block in main   # safety: even: 4 is even."
    assert lines[6] == "  foreign functions: getpid (called by pid (asserted pure))"
