##! The raw scanner (docs/architecture.md, "Lexing"): text to tokens that
##! cover every byte, trivia included. Line breaks are `LINE_BREAK` here;
##! the layout pass decides which of them end logical lines. A string with
##! interpolation is a sequence of tokens: `STRING_START`, `STRING_TEXT`,
##! `INTERP_START`, the expression's tokens, an optional `COLON
##! FORMAT_SPEC` or `EQ`, `INTERP_END`, and `STRING_END` (PEP 701).

from stage1.diag import Diagnostic, Edit, Msg
from stage1.syntax.kinds import SyntaxKind
from stage1.syntax.tree import Token
from stage1.text import char_at, hex, is_alphanumeric

## Where the scanner is.
@derive(Eq, Debug, Copy)
enum Mode:
    Code
    ## Inside `{...}` of a string; `depth` counts the brackets opened inside.
    Interp(depth: int, triple: bool)
    ## Inside the text of a string that opened at `start`.
    Str(triple: bool, start: int)

## The suffixes a number literal may carry (`42u8`, `1.0f32`).
const SUFFIXES: list[str] = [
    "i8",
    "i16",
    "i32",
    "i64",
    "i128",
    "u8",
    "u16",
    "u32",
    "u64",
    "u128",
    "f32",
    "f64",
    "int",
    "uint",
]

view struct Scanner:
    text: str
    ## The length of `text` in bytes.
    n: int
    pos: int
    tokens: list[Token]
    modes: list[Mode]
    diags: list[Diagnostic]
    last_significant: SyntaxKind

## Scans `text` into raw tokens, appending its diagnostics to `diags`.
pub pure def scan(text: str, mut diags: list[Diagnostic]) -> list[Token]:
    var s = Scanner.new(text)
    while s.pos < s.n:
        let before = s.pos
        # Only the first mode is `Code`: the scanner pushes the others.
        if len(s.modes) == 1:
            s.code()
        else:
            match s.mode():
                case Str(triple, start):
                    s.string_text(triple, start)
                case _:
                    s.code()
        if s.pos == before:
            # Never stall: consume one character as an error token.
            s.pos += char_at(s.text, s.pos).len_utf8()
            s.push(SyntaxKind.ErrorToken, before)
    # Close any string left open at the end of the file.
    var open = True
    while open:
        match s.mode():
            case Code:
                open = False
            case Str(triple, start):
                let at = s.pos
                let m = if triple: Msg.LexUnterminatedBlockString else: Msg.LexUnterminatedString
                s.error(m, start, at)
                s.push(SyntaxKind.StringEnd, at)
                _ = s.modes.pop()
            case Interp(_, _):
                let at = s.pos
                s.push(SyntaxKind.InterpEnd, at)
                _ = s.modes.pop()
    diags.extend(s.diags)
    return s.tokens

impl Scanner:
    pure def new(text: str) -> Scanner:
        return Scanner(
            text=text,
            n=text.byte_len(),
            pos=0,
            tokens=[],
            modes=[Mode.Code],
            diags=[],
            last_significant=SyntaxKind.Newline,
        )

    pure def mode(self) -> Mode:
        return match self.modes.last():
            case Some(m): m
            case None: Mode.Code

    ## The byte at `i`, or -1 past the end.
    pure def byte(self, i: int) -> int:
        if i < self.n:
            return self.text.byte_at(i).to_int()
        return -1

    ## Whether the text at the current position starts with `prefix`.
    pure def at_text(self, prefix: str) -> bool:
        let m = prefix.byte_len()
        if self.pos + m > self.n:
            return False
        for j in range(m):
            if self.text.byte_at(self.pos + j) != prefix.byte_at(j):
                return False
        return True

    pure def push(mut self, kind: SyntaxKind, start: int):
        self.tokens.push(Token(kind=kind, start=start, end=self.pos))
        if not kind.is_trivia():
            self.last_significant = kind

    pure def error(mut self, msg: Msg, start: int, end: int):
        self.diags.push(Diagnostic.new(msg, start, end))

    pure def error_with(mut self, msg: Msg, start: int, end: int, name: str, value: str):
        self.diags.push(Diagnostic.new(msg, start, end).with(name, value))

    ## Inside the interpolation of a one-line string.
    pure def in_one_line_interpolation(self) -> bool:
        return match self.mode():
            case Interp(_, triple): not triple
            case _: False

    ## Inside an interpolation or the text of a string.
    pure def in_string(self) -> bool:
        return match self.mode():
            case Code: False
            case _: True

    pure def code(mut self):
        let start = self.pos
        let b = self.byte(start)
        if b < 0:
            return
        if (b == 10 or b == 13) and self.in_one_line_interpolation():
            # A line break ends a one-line string inside its interpolation:
            # report it, close the interpolation and the string, and scan
            # the line break as code.
            self.error(Msg.LexNewlineInInterpolation, start, start)
            while self.in_string():
                let kind = match self.mode():
                    case Interp(_, _): SyntaxKind.InterpEnd
                    case _: SyntaxKind.StringEnd
                _ = self.modes.pop()
                self.push(kind, start)
        if b == 32 or b == 9 or b == 12:
            self.pos += 1
            while self.pos < self.n:
                let c = self.text.byte_at(self.pos).to_int()
                if c != 32 and c != 9 and c != 12:
                    break
                self.pos += 1
            self.push(SyntaxKind.Whitespace, start)
        elif b == 10:
            self.pos += 1
            self.push(SyntaxKind.LineBreak, start)
        elif b == 13:
            self.pos += 1
            if self.byte(self.pos) == 10:
                self.pos += 1
            self.push(SyntaxKind.LineBreak, start)
        elif b == 35:
            self.comment(start)
        elif b == 34:
            self.string_start(start)
        elif b == 39:
            self.char_literal(start)
        elif is_ascii_digit(b):
            self.number(start)
        elif is_ascii_letter(b)
                or b == 95
                or (b >= 128 and char_at(self.text, start).is_alphabetic()):
            self.ident(start)
        else:
            self.punctuation(start)

    ## `#` to the end of the line: `##!` documents the module, `##` the
    ## item or field that follows.
    pure def comment(mut self, start: int):
        var kind = SyntaxKind.Comment
        if self.at_text("##!"):
            kind = SyntaxKind.ModuleDocComment
        elif self.at_text("##"):
            kind = SyntaxKind.DocComment
        while self.pos < self.n:
            let b = self.text.byte_at(self.pos).to_int()
            if b == 10 or b == 13:
                break
            self.pos += 1
        self.push(kind, start)

    pure def ident(mut self, start: int):
        while self.pos < self.n:
            let b = self.text.byte_at(self.pos).to_int()
            if (97 <= b <= 122) or (65 <= b <= 90) or (48 <= b <= 57) or b == 95:
                self.pos += 1
            elif b >= 128 and is_alphanumeric(char_at(self.text, self.pos)):
                self.pos += char_at(self.text, self.pos).len_utf8()
            else:
                break
        let length = self.pos - start
        if length == 1 and self.byte(self.pos) == 34:
            let b = self.byte(start)
            if b == 114 or b == 98:
                self.prefixed_string(start, b == 114)
                return
        # After `.` or `?.` a keyword is an ordinary name (02, "Lexical
        # structure"), and so after `def`, which declares such a method
        # (`def or(own self, default: T)`, called as `x.or(d)`).
        var kind = SyntaxKind.Ident
        match self.last_significant:
            case Dot | QuestionDot | DefKw:
                pass
            case _:
                if let Some(k) = keyword_at(self.text, start, length):
                    kind = k
        self.push(kind, start)

    pure def number(mut self, start: int):
        let after_dot = self.last_significant == SyntaxKind.Dot
        var is_float = False
        var valid = True
        var radix = 10
        if self.byte(start) == 48:
            let second = self.byte(start + 1)
            if second == 120 or second == 88:
                radix = 16
            elif second == 98 or second == 66:
                radix = 2
            elif second == 111 or second == 79:
                radix = 8
        if radix != 10:
            self.pos += 2
            var digits = 0
            while self.byte(self.pos) == 95 or is_digit_in(self.byte(self.pos), radix):
                if self.byte(self.pos) != 95:
                    digits += 1
                self.pos += 1
            if digits == 0:
                valid = False
        else:
            self.digits()
            if not after_dot
                    and self.byte(self.pos) == 46
                    and is_ascii_digit(self.byte(self.pos + 1)):
                is_float = True
                self.pos += 1
                self.digits()
            let e = self.byte(self.pos)
            if not after_dot and (e == 101 or e == 69):
                let sign = self.byte(self.pos + 1) == 43 or self.byte(self.pos + 1) == 45
                let digit_at = if sign: 2 else: 1
                if is_ascii_digit(self.byte(self.pos + digit_at)):
                    is_float = True
                    self.pos += digit_at
                    self.digits()
        # A suffix such as `u8` or `f32` is part of the literal.
        let suffix_start = self.pos
        while self.pos < self.n:
            let b = self.byte(self.pos)
            if is_ascii_letter(b) or is_ascii_digit(b) or b == 95:
                self.pos += 1
            elif b >= 128 and is_alphanumeric(char_at(self.text, self.pos)):
                self.pos += char_at(self.text, self.pos).len_utf8()
            else:
                break
        if self.pos > suffix_start:
            let suffix = self.text.byte_slice(suffix_start, self.pos)
            let floating = suffix.starts_with("f")
            if not is_suffix(suffix) or (radix != 10 and floating):
                valid = False
            elif floating:
                is_float = True
        if not valid:
            let text = self.text.byte_slice(start, self.pos)
            self.error_with(Msg.LexInvalidNumber, start, self.pos, "text", text)
        self.push(if is_float: SyntaxKind.FloatNumber else: SyntaxKind.IntNumber, start)

    pure def digits(mut self):
        while is_ascii_digit(self.byte(self.pos)) or self.byte(self.pos) == 95:
            self.pos += 1

    ## Consumes an escape sequence starting at `\`, reporting unknown ones.
    pure def escape(mut self):
        let start = self.pos
        self.pos += 1
        if self.pos >= self.n:
            return
        let b = self.byte(self.pos)
        if b == 10 or b == 13:
            return
        let c = char_at(self.text, self.pos)
        self.pos += c.len_utf8()
        if not is_escape_letter(c):
            self.error_with(Msg.LexInvalidEscape, start, self.pos, "escape", "{c}")
            return
        if c == 'u' and not self.unicode_escape():
            self.error_with(Msg.LexInvalidEscape, start, self.pos, "escape", "u")

    ## After `\u`: `{`, one to six hex digits naming a Unicode scalar
    ## value, and `}`, consumed if valid.
    pure def unicode_escape(mut self) -> bool:
        if self.byte(self.pos) != 123:
            return False
        var i = self.pos + 1
        var value = 0
        while i < self.n and is_digit_in(self.byte(i), 16):
            # Seven digits are already too many: the value stops growing.
            if i - self.pos <= 6:
                value = value * 16 + hex_value(self.byte(i))
            i += 1
        let count = i - self.pos - 1
        if self.byte(i) != 125 or count == 0 or count > 6:
            return False
        if value > 0x10FFFF or (0xD800 <= value <= 0xDFFF):
            return False
        self.pos = i + 1
        return True

    pure def char_literal(mut self, start: int):
        self.pos += 1
        var count = 0
        var closed = False
        while self.pos < self.n:
            let b = self.byte(self.pos)
            if b == 39:
                self.pos += 1
                closed = True
                break
            if b == 10 or b == 13:
                break
            if b == 92:
                self.escape()
            else:
                self.pos += char_at(self.text, self.pos).len_utf8()
            count += 1
        if not closed:
            self.error(Msg.LexUnterminatedChar, start, self.pos)
        elif count > 1 and not self.text.byte_slice(start, self.pos).contains("\""):
            # Text in single quotes, Python's `'Aino'`: Sisu writes text in
            # double quotes (RULES.md, R45).
            let d = Diagnostic.new(Msg.LexBadCharLiteral, start, self.pos)
            let edits = [
                Edit(start=start, end=start + 1, text="\""),
                Edit(start=self.pos - 1, end=self.pos, text="\""),
            ]
            self.diags.push(d.fix_edits(Msg.LexDoubleQuotes, edits))
        elif count != 1:
            self.error(Msg.LexBadCharLiteral, start, self.pos)
        self.push(SyntaxKind.CharLit, start)

    pure def string_start(mut self, start: int):
        let triple = self.at_text("\"\"\"")
        self.pos += if triple: 3 else: 1
        self.push(SyntaxKind.StringStart, start)
        self.modes.push(Mode.Str(triple=triple, start=start))

    ## Raw `r"..."` and byte `b"..."` strings are single tokens.
    pure def prefixed_string(mut self, start: int, raw: bool):
        let triple = self.at_text("\"\"\"")
        let delim = if triple: "\"\"\"" else: "\""
        self.pos += delim.byte_len()
        var closed = False
        while self.pos < self.n:
            if self.at_text(delim):
                self.pos += delim.byte_len()
                closed = True
                break
            let b = self.byte(self.pos)
            if not triple and (b == 10 or b == 13):
                break
            if b == 92 and not raw:
                # A byte string also takes `\xNN`, any byte.
                if self.byte(self.pos + 1) == 120
                        and is_digit_in(self.byte(self.pos + 2), 16)
                        and is_digit_in(self.byte(self.pos + 3), 16):
                    self.pos += 4
                else:
                    self.escape()
            else:
                self.pos += char_at(self.text, self.pos).len_utf8()
        if not closed:
            let m = if triple: Msg.LexUnterminatedBlockString else: Msg.LexUnterminatedString
            self.error(m, start, self.pos)
        self.push(if raw: SyntaxKind.RawString else: SyntaxKind.ByteString, start)

    pure def string_text(mut self, triple: bool, opened: int):
        let start = self.pos
        while self.pos < self.n:
            let b = self.text.byte_at(self.pos).to_int()
            if b == 34 and (not triple or self.at_text("\"\"\"")):
                break
            if not triple and (b == 10 or b == 13):
                break
            if b == 123:
                if self.byte(self.pos + 1) == 123:
                    self.pos += 2
                    continue
                break
            if b == 125:
                if self.byte(self.pos + 1) == 125:
                    self.pos += 2
                    continue
                let at = self.pos
                self.pos += 1
                self.error(Msg.LexLoneCloseBrace, at, at + 1)
                continue
            if b == 92:
                self.escape()
                continue
            self.pos += char_at(self.text, self.pos).len_utf8()
        if self.pos > start:
            self.push(SyntaxKind.StringText, start)
        let here = self.pos
        let b = self.byte(here)
        if b < 0:
            return
        if b == 123:
            self.pos += 1
            self.push(SyntaxKind.InterpStart, here)
            self.modes.push(Mode.Interp(depth=0, triple=triple))
        elif b == 10 or b == 13:
            # An unterminated one-line string: close it before the line
            # break, and report it from its opening quote. Brackets left
            # open before the quote and closed at the end of the text were
            # meant to follow it: `print("no end)` closes as
            # `print("no end")`.
            var line = opened
            while line > 0 and self.byte(line - 1) != 10:
                line -= 1
            var open = 0
            for i in range(line, opened):
                let c = self.byte(i)
                if c == 40 or c == 91:
                    open += 1
                elif c == 41 or c == 93:
                    open -= 1
            var end = here
            while open > 0
                    and end > start
                    and (self.byte(end - 1) == 41 or self.byte(end - 1) == 93):
                end -= 1
                open -= 1
            let d = Diagnostic.new(Msg.LexUnterminatedString, opened, here)
            self.diags.push(d.fix_at(Msg.LexCloseString, end, end, "\""))
            self.push(SyntaxKind.StringEnd, here)
            _ = self.modes.pop()
        else:
            self.pos += if triple: 3 else: 1
            self.push(SyntaxKind.StringEnd, here)
            _ = self.modes.pop()

    pure def punctuation(mut self, start: int):
        match self.mode():
            case Interp(depth, triple):
                let b = self.byte(start)
                if depth == 0 and b == 125:
                    self.pos += 1
                    self.push(SyntaxKind.InterpEnd, start)
                    _ = self.modes.pop()
                    return
                if depth == 0 and b == 58:
                    self.pos += 1
                    self.push(SyntaxKind.Colon, start)
                    # The format spec runs to the closing brace.
                    let spec_start = self.pos
                    while self.pos < self.n:
                        let c = self.byte(self.pos)
                        if c == 125 or c == 34 or c == 10 or c == 13:
                            break
                        self.pos += char_at(self.text, self.pos).len_utf8()
                    self.push(SyntaxKind.FormatSpec, spec_start)
                    return
                var delta = 0
                if b == 40 or b == 91 or b == 123:
                    delta = 1
                elif b == 41 or b == 93 or b == 125:
                    delta = -1
                if delta != 0:
                    _ = self.modes.pop()
                    self.modes.push(Mode.Interp(depth=max(depth + delta, 0), triple=triple))
            case _:
                pass
        # The longest operator or punctuation the text starts with.
        let next = punctuation_of(self.byte(start), self.byte(start + 1), self.byte(start + 2))
        if let Some((kind, length)) = next:
            self.pos += length
            match kind:
                case Semicolon:
                    self.error(Msg.LexSemicolon, start, self.pos)
                case Backslash:
                    let b = self.byte(self.pos)
                    if b == 10 or b == 13:
                        self.error(Msg.LexBackslashContinuation, start, self.pos)
                    else:
                        self.error_with(Msg.LexUnknownCharacter, start, self.pos, "char", "\\")
                case _:
                    pass
            self.push(kind, start)
            return
        let c = char_at(self.text, start)
        self.pos += c.len_utf8()
        # A character that shows as nothing or as a space is written as its
        # escape and named, with the fix that writes a space or removes it
        # (RULES.md, R100).
        match invisible(c.code(), start == 0):
            case Some((name, space)):
                var d = Diagnostic.new(Msg.LexUnknownCharacter, start, self.pos)
                d = d.with("char", "\\u{{{hex(c.code())}}}")
                d = d.note_with(Msg.LexInvisibleCharacter, "name", name)
                if space:
                    d = d.fix_at(Msg.LexWriteSpace, start, self.pos, " ")
                else:
                    d = d.fix_at(Msg.LexRemoveCharacter, start, self.pos, "")
                self.diags.push(d)
            case None:
                self.error_with(Msg.LexUnknownCharacter, start, self.pos, "char", "{c}")
        self.push(SyntaxKind.ErrorToken, start)

## The operator or punctuation of `PUNCTUATION` that the bytes `b0`, `b1`
## and `b2` start with (-1 past the end), the longest, with its length: a
## dispatch on the bytes themselves, which makes no text and looks nothing
## up (RULES.md, R127). The test "punctuation by its bytes" holds it to
## `PUNCTUATION`.
pure def punctuation_of(b0: int, b1: int, b2: int) -> (SyntaxKind, int)?:
    match b0:
        case 40:
            return Some((SyntaxKind.LParen, 1))
        case 41:
            return Some((SyntaxKind.RParen, 1))
        case 91:
            return Some((SyntaxKind.LBracket, 1))
        case 93:
            return Some((SyntaxKind.RBracket, 1))
        case 123:
            return Some((SyntaxKind.LBrace, 1))
        case 125:
            return Some((SyntaxKind.RBrace, 1))
        case 44:
            return Some((SyntaxKind.Comma, 1))
        case 58:
            return with_eq(b1, SyntaxKind.Colon, SyntaxKind.Walrus)
        case 46:
            if b1 == 46:
                return Some((SyntaxKind.DotDot, 2))
            return Some((SyntaxKind.Dot, 1))
        case 61:
            return with_eq(b1, SyntaxKind.Eq, SyntaxKind.EqEq)
        case 43:
            if b1 == 61:
                return Some((SyntaxKind.PlusEq, 2))
            return wrapping(b1, b2, SyntaxKind.Plus, Wrapping.Plus)
        case 45:
            if b1 == 61:
                return Some((SyntaxKind.MinusEq, 2))
            if b1 == 62:
                return Some((SyntaxKind.Arrow, 2))
            return wrapping(b1, b2, SyntaxKind.Minus, Wrapping.Minus)
        case 42:
            if b1 == 42:
                return doubled(b2, SyntaxKind.StarStar, SyntaxKind.StarStarEq)
            if b1 == 61:
                return Some((SyntaxKind.StarEq, 2))
            return wrapping(b1, b2, SyntaxKind.Star, Wrapping.Star)
        case 47:
            if b1 == 47:
                return doubled(b2, SyntaxKind.SlashSlash, SyntaxKind.SlashSlashEq)
            return with_eq(b1, SyntaxKind.Slash, SyntaxKind.SlashEq)
        case 60:
            if b1 == 60:
                return doubled(b2, SyntaxKind.Shl, SyntaxKind.ShlEq)
            return with_eq(b1, SyntaxKind.Lt, SyntaxKind.LtEq)
        case 62:
            if b1 == 62:
                return doubled(b2, SyntaxKind.Shr, SyntaxKind.ShrEq)
            return with_eq(b1, SyntaxKind.Gt, SyntaxKind.GtEq)
        case 33:
            return with_eq(b1, SyntaxKind.Bang, SyntaxKind.BangEq)
        case 37:
            return with_eq(b1, SyntaxKind.Percent, SyntaxKind.PercentEq)
        case 38:
            return with_eq(b1, SyntaxKind.Amp, SyntaxKind.AmpEq)
        case 124:
            return with_eq(b1, SyntaxKind.Pipe, SyntaxKind.PipeEq)
        case 94:
            return with_eq(b1, SyntaxKind.Caret, SyntaxKind.CaretEq)
        case 63:
            if b1 == 46:
                return Some((SyntaxKind.QuestionDot, 2))
            if b1 == 63:
                return Some((SyntaxKind.QuestionQuestion, 2))
            return Some((SyntaxKind.Question, 1))
        case 64:
            return Some((SyntaxKind.At, 1))
        case 59:
            return Some((SyntaxKind.Semicolon, 1))
        case 92:
            return Some((SyntaxKind.Backslash, 1))
        case 126:
            return Some((SyntaxKind.Tilde, 1))
        case _:
            return None

## `plain`, or `eq_kind` when an `=` (`b1`) follows it.
pure def with_eq(b1: int, plain: SyntaxKind, eq_kind: SyntaxKind) -> (SyntaxKind, int)?:
    if b1 == 61:
        return Some((eq_kind, 2))
    return Some((plain, 1))

## A doubled operator (`**`, `//`, `<<`, `>>`), or `eq_kind` when an `=`
## (`b2`) follows it.
pure def doubled(b2: int, plain: SyntaxKind, eq_kind: SyntaxKind) -> (SyntaxKind, int)?:
    if b2 == 61:
        return Some((eq_kind, 3))
    return Some((plain, 2))

## The arithmetic operators that wrap (`+%`) or saturate (`+|`).
@derive(Copy)
enum Wrapping:
    Plus
    Minus
    Star

## `+`, `-` or `*` (`plain`), or with `%` or `|` (`b1`) after it the
## operator that wraps or saturates, with `=` (`b2`) its assignment.
pure def wrapping(b1: int, b2: int, plain: SyntaxKind, op: Wrapping) -> (SyntaxKind, int)?:
    if b1 != 37 and b1 != 124:
        return Some((plain, 1))
    let assign = b2 == 61
    let kind = match (op, b1 == 37, assign):
        case (Plus, True, False): SyntaxKind.PlusPercent
        case (Plus, True, True): SyntaxKind.PlusPercentEq
        case (Plus, False, False): SyntaxKind.PlusPipe
        case (Plus, False, True): SyntaxKind.PlusPipeEq
        case (Minus, True, False): SyntaxKind.MinusPercent
        case (Minus, True, True): SyntaxKind.MinusPercentEq
        case (Minus, False, False): SyntaxKind.MinusPipe
        case (Minus, False, True): SyntaxKind.MinusPipeEq
        case (Star, True, False): SyntaxKind.StarPercent
        case (Star, True, True): SyntaxKind.StarPercentEq
        case (Star, False, False): SyntaxKind.StarPipe
        case (Star, False, True): SyntaxKind.StarPipeEq
    return Some((kind, if assign: 3 else: 2))

## The reserved keyword that the `length` bytes of `text` at `start` spell,
## if they spell one of `KEYWORDS`: a dispatch on the first byte and the
## length, then the bytes compared, with no text made (RULES.md, R127). The
## test "keywords by their bytes" holds it to `KEYWORDS`.
pure def keyword_at(text: str, start: int, length: int) -> SyntaxKind?:
    if length < 2 or length > 8:
        return None
    let k = Word(text=text, start=start, length=length)
    match text.byte_at(start).to_int():
        case 97:
            if k.spells("and"):
                return Some(SyntaxKind.AndKw)
            if k.spells("as"):
                return Some(SyntaxKind.AsKw)
            if k.spells("assert"):
                return Some(SyntaxKind.AssertKw)
        case 98:
            if k.spells("break"):
                return Some(SyntaxKind.BreakKw)
        case 99:
            if k.spells("case"):
                return Some(SyntaxKind.CaseKw)
            if k.spells("comptime"):
                return Some(SyntaxKind.ComptimeKw)
            if k.spells("const"):
                return Some(SyntaxKind.ConstKw)
            if k.spells("continue"):
                return Some(SyntaxKind.ContinueKw)
        case 100:
            if k.spells("def"):
                return Some(SyntaxKind.DefKw)
            if k.spells("defer"):
                return Some(SyntaxKind.DeferKw)
            if k.spells("do"):
                return Some(SyntaxKind.DoKw)
            if k.spells("dyn"):
                return Some(SyntaxKind.DynKw)
        case 101:
            if k.spells("elif"):
                return Some(SyntaxKind.ElifKw)
            if k.spells("else"):
                return Some(SyntaxKind.ElseKw)
            if k.spells("enum"):
                return Some(SyntaxKind.EnumKw)
            if k.spells("error"):
                return Some(SyntaxKind.ErrorKw)
            if k.spells("extern"):
                return Some(SyntaxKind.ExternKw)
        case 102:
            if k.spells("for"):
                return Some(SyntaxKind.ForKw)
            if k.spells("from"):
                return Some(SyntaxKind.FromKw)
        case 105:
            if k.spells("if"):
                return Some(SyntaxKind.IfKw)
            if k.spells("impl"):
                return Some(SyntaxKind.ImplKw)
            if k.spells("import"):
                return Some(SyntaxKind.ImportKw)
            if k.spells("in"):
                return Some(SyntaxKind.InKw)
        case 108:
            if k.spells("let"):
                return Some(SyntaxKind.LetKw)
        case 109:
            if k.spells("match"):
                return Some(SyntaxKind.MatchKw)
            if k.spells("mut"):
                return Some(SyntaxKind.MutKw)
        case 110:
            if k.spells("not"):
                return Some(SyntaxKind.NotKw)
        case 111:
            if k.spells("or"):
                return Some(SyntaxKind.OrKw)
            if k.spells("own"):
                return Some(SyntaxKind.OwnKw)
        case 112:
            if k.spells("pass"):
                return Some(SyntaxKind.PassKw)
            if k.spells("pub"):
                return Some(SyntaxKind.PubKw)
        case 114:
            if k.spells("ref"):
                return Some(SyntaxKind.RefKw)
            if k.spells("return"):
                return Some(SyntaxKind.ReturnKw)
        case 115:
            if k.spells("select"):
                return Some(SyntaxKind.SelectKw)
            if k.spells("self"):
                return Some(SyntaxKind.SelfKw)
            if k.spells("struct"):
                return Some(SyntaxKind.StructKw)
        case 83:
            if k.spells("Self"):
                return Some(SyntaxKind.SelfTypeKw)
        case 116:
            if k.spells("test"):
                return Some(SyntaxKind.TestKw)
            if k.spells("trait"):
                return Some(SyntaxKind.TraitKw)
            if k.spells("type"):
                return Some(SyntaxKind.TypeKw)
        case 117:
            if k.spells("unsafe"):
                return Some(SyntaxKind.UnsafeKw)
        case 118:
            if k.spells("var"):
                return Some(SyntaxKind.VarKw)
            if k.spells("view"):
                return Some(SyntaxKind.ViewKw)
        case 119:
            if k.spells("where"):
                return Some(SyntaxKind.WhereKw)
            if k.spells("while"):
                return Some(SyntaxKind.WhileKw)
            if k.spells("with"):
                return Some(SyntaxKind.WithKw)
        case 121:
            if k.spells("yield"):
                return Some(SyntaxKind.YieldKw)
        case _:
            pass
    return None

## A word of the text, by where it is, for `keyword_at`.
view struct Word:
    text: str
    start: int
    length: int

impl Word:
    ## Whether the word is `word`: the same length, and the same bytes after
    ## the first, which `keyword_at` has matched.
    pure def spells(self, word: str) -> bool:
        if word.byte_len() != self.length:
            return False
        for j in range(1, self.length):
            if self.text.byte_at(self.start + j) != word.byte_at(j):
                return False
        return True

pure def is_ascii_digit(b: int) -> bool:
    return 48 <= b <= 57

pure def is_ascii_letter(b: int) -> bool:
    return (97 <= b <= 122) or (65 <= b <= 90)

## Whether byte `b` is a digit in base `radix` (2, 8, 10 or 16).
pure def is_digit_in(b: int, radix: int) -> bool:
    if radix == 16:
        return is_ascii_digit(b) or (97 <= b <= 102) or (65 <= b <= 70)
    return 48 <= b < 48 + radix

## The value of a hex digit.
pure def hex_value(b: int) -> int:
    if b <= 57:
        return b - 48
    if b >= 97:
        return b - 87
    return b - 55

## The known escape letters after `\` in strings and characters.
pure def is_escape_letter(c: char) -> bool:
    return match c:
        case 'n' | 't' | 'r' | '0' | '\\' | '"' | '\'' | 'u': True
        case _: False

pure def is_suffix(text: str) -> bool:
    for s in SUFFIXES:
        if s == text:
            return True
    return False

## The name of a character that shows as nothing or as a space, which a
## message cannot show as it is, with how it shows, and whether a space is
## what was meant (a space of another kind) or nothing (a mark of width
## zero); `None` for any other. A byte-order mark at the start of a file is
## named as one (RULES.md, R100).
pure def invisible(n: int, at_start: bool) -> (String, bool)?:
    if n == 0xFEFF and at_start:
        return Some(("a byte-order mark, which UTF-8 text does not need".to_string(), False))
    let space = match n:
        case 0xA0: "a no-break space"
        case 0x1680: "an ogham space mark"
        case 0x202F: "a narrow no-break space"
        case 0x205F: "a mathematical space"
        case 0x3000: "an ideographic space"
        case 0x2028: "a line separator"
        case 0x2029: "a paragraph separator"
        case _: ""
    if not space.is_empty():
        return Some(("{space}, which looks like a space".to_string(), True))
    if n >= 0x2000 and n <= 0x200A:
        return Some(("a space of another width, which looks like a space".to_string(), True))
    var mark = match n:
        case 0xAD: "a soft hyphen"
        case 0xFEFF: "a zero-width no-break space"
        case 0x200B: "a zero-width space"
        case 0x200C: "a zero-width non-joiner"
        case 0x200D: "a zero-width joiner"
        case 0x2060: "a word joiner"
        case 0x180E: "a Mongolian vowel separator"
        case _: ""
    if (n >= 0x200E and n <= 0x200F)
            or (n >= 0x202A and n <= 0x202E)
            or (n >= 0x2066 and n <= 0x2069):
        mark = "a mark of the text's direction"
    if not mark.is_empty():
        return Some(("{mark}, which shows as nothing".to_string(), False))
    return None
