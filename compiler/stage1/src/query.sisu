##! The language server's questions (10, "Language server"; RULES.md,
##! R164), answered from stage 1's check of the program that holds a file,
##! so that the driver's `sisu lsp` reads its answers from stage 1 rather
##! than from the Rust front end: what a position names, its hover text, its
##! declaration and its uses, the names that may be written there, and a
##! file's declarations.
##!
##! Each answer is lines of fields separated by tabs, which the driver
##! splits without a parser: a position is `LINE:COL` and a range
##! `LINE:COL-LINE:COL`, 1-based, the column counting characters, as
##! `check --format=ids` writes them; a field of text has its backslashes,
##! tabs and line breaks written `\\`, `\t` and `\n` (`field`).

import stage1.typeck
from stage1.diag import Catalog, Lines, TextRange, quote
from stage1.parser import parse
from stage1.syntax.ast import Mode, Vis
from stage1.syntax.kinds import SyntaxKind, keyword_kind
from stage1.syntax.tree import Element, Tree
from stage1.typeck.program import DefKind, ModuleId, Program
from stage1.typeck.thir import ArgMode, Callee, TBody, TExprKind
from stage1.typeck.ty import DefId, Ty, TyData, TyKey, Types

## The keywords a statement or a declaration starts with, which a
## completion offers where a name may be written (stage 0's `KEYWORDS`).
const KEYWORDS: list[str] = [
    "def",
    "let",
    "var",
    "if",
    "elif",
    "else",
    "for",
    "while",
    "match",
    "case",
    "return",
    "break",
    "continue",
    "pass",
    "struct",
    "enum",
    "error",
    "trait",
    "impl",
    "import",
    "from",
    "test",
    "const",
    "type",
    "with",
    "defer",
    "assert",
    "pure",
    "own",
    "mut",
    "ref",
    "and",
    "or",
    "not",
    "in",
    "comptime",
]

## The files of a checked program a question reads: for each module whose
## text is known (the program's own, and the standard library's), its path
## on disk and its text, by the module's index. A module the compiler
## wrote has none.
pub struct Files:
    pub of: dict[int, (String, String)]

impl Files:
    pub pure def new() -> Files:
        return Files(of={})

    ## The path and text of module `m`, when it has a file.
    pub pure def get(self, m: ModuleId) -> (String, String)?:
        if let Some(found) = self.of.get(m.index):
            return Some(found.copy())
        return None

## What a position names (stage 0's `Target`).
@derive(Eq, Copy)
pub enum Target:
    Def(DefId)
    ## A struct's field, by its index.
    Field(DefId, int)
    ## A local of the body at this index.
    Local(int, int)
    ## An expression that names nothing, by its body and its index.
    Expr(int, int)

## A field of an answer: its backslashes, tabs and line breaks written
## `\\`, `\t` and `\n`, so that it holds neither.
pub pure def field(text: str) -> String:
    var out = String.new()
    for c in text.chars():
        if c == '\\':
            out.push("\\\\")
        elif c == '\t':
            out.push("\\t")
        elif c == '\n':
            out.push("\\n")
        else:
            out.push("{c}")
    return out

## `LINE:COL-LINE:COL` of a range of `text`.
pub pure def range_of(text: str, lines: Lines, start: int, end: int) -> String:
    return lines.span(text, start, end)

pure def within(r: TextRange, offset: int) -> bool:
    return r.start <= offset and offset <= r.end

pure def width(r: TextRange) -> int:
    return r.end - r.start

## Where a body is written: from its name to the end of its block (a
## body's own range is its definition's name).
pure def extent(b: TBody) -> TextRange:
    let block = b.blocks[b.block.index].span
    return TextRange.new(min(b.span.start, block.start), max(b.span.end, block.end))

## The module of the body at `bi`: its definition's.
pure def body_module(typed: typeck.Typed, bi: int) -> ModuleId:
    return typed.prog.defs[typed.bodies[bi].def_.index].module

## The innermost expression of a body of module `m` at `offset`: its body
## and its index.
pub pure def expr_at(typed: typeck.Typed, m: ModuleId, offset: int) -> (int, int)?:
    var best: (int, int)? = None
    var best_width = 0
    for bi in range(len(typed.bodies)):
        if body_module(typed, bi) != m:
            continue
        let body = ref typed.bodies[bi]
        if not within(extent(body), offset):
            continue
        for ei in range(len(body.exprs)):
            let r = body.exprs[ei].span
            if within(r, offset) and (best.is_none() or width(r) <= best_width):
                best = Some((bi, ei))
                best_width = width(r)
    return best

## What position `offset` of module `m` names: a definition's own name, a
## field's in its struct, a local's declaration, or what the innermost
## expression there names (stage 0's `target_at`).
pub pure def target_at(typed: typeck.Typed, m: ModuleId, offset: int) -> Target?:
    let prog = ref typed.prog
    var best: Target? = None
    var best_width = 0
    for i in range(len(prog.defs)):
        let d = ref prog.defs[i]
        if d.module != m or not within(d.span, offset):
            continue
        if let DefKind.Impl(_) = d.kind():
            continue
        if best.is_none() or width(d.span) < best_width:
            best = Some(Target.Def(DefId(index=i)))
            best_width = width(d.span)
    for i in range(len(prog.defs)):
        let d = ref prog.defs[i]
        if d.module != m:
            continue
        if let DefKind.Struct(s) = d.kind():
            for k in range(len(s.fields)):
                if within(s.fields[k].span, offset):
                    best = Some(Target.Field(DefId(index=i), k))
    if let Some(t) = best:
        return Some(t)
    for bi in range(len(typed.bodies)):
        if body_module(typed, bi) != m:
            continue
        let body = ref typed.bodies[bi]
        for li in range(len(body.locals)):
            let l = ref body.locals[li]
            if within(l.span, offset) and named(l.name):
                return Some(Target.Local(bi, li))
    let (bi, ei) = expr_at(typed, m, offset) else:
        return None
    let e = ref typed.bodies[bi].exprs[ei]
    match e.kind:
        case TExprKind.Local(l):
            return Some(Target.Local(bi, l))
        case TExprKind.Const(d) | TExprKind.FnRef(d, _):
            return Some(Target.Def(d))
        case TExprKind.Call(Callee.Fn(d, _), _):
            return Some(Target.Def(d))
        case TExprKind.Struct(d, _) | TExprKind.Variant(d, _, _):
            return Some(Target.Def(d))
        case TExprKind.Field(base, index):
            let t = typed.types.strip_ref(typed.bodies[bi].exprs[base.index].ty)
            if let TyData.Adt(d, _) = typed.types.data(t):
                if let DefKind.Struct(_) = prog.defs[d.index].kind():
                    return Some(Target.Field(d, index))
        case _:
            pass
    return Some(Target.Expr(bi, ei))

## Whether a local's name is one the program wrote, not the compiler.
pure def named(name: str) -> bool:
    if name.is_empty() or name.starts_with("__") or name.contains("#"):
        return False
    let c = name.chars().next() ?? ' '
    return c.is_alphabetic() or c == '_'

## The `##` comment written above the declaration whose name starts at
## `at` in `text`, its lines without `##` and the space after it, past the
## attributes between them.
pub pure def doc_above(text: str, at: int) -> String:
    let lines = Lines.of(text)
    var index = lines.index(at)
    var found: list[String] = []
    while index > 0:
        index -= 1
        let line = lines.text_of(text, index + 1)
        let t = line.trim()
        if t.starts_with("@"):
            continue
        if not t.starts_with("##") or t.starts_with("##!"):
            break
        var rest = t.byte_slice(2, t.byte_len()).to_string()
        if rest.starts_with(" "):
            rest = rest.byte_slice(1, rest.byte_len()).to_string()
        found.push(rest)
    found.reverse()
    return found.join("\n")

## The spelling of a type, with the generic parameters `names` names.
pure def shown(prog: Program, types: Types, ty: Ty, names: list[String]) -> String:
    return prog.display_in(types, ty, names)

pure def generic_names(prog: Program, d: DefId) -> list[String]:
    var names: list[String] = []
    match prog.defs[d.index].kind():
        case DefKind.Fn(f):
            for g in f.generics:
                names.push(g.name.copy())
        case DefKind.Struct(s):
            for g in s.generics:
                names.push(g.name.copy())
        case DefKind.Enum(e) | DefKind.ErrorSet(e):
            for g in e.generics:
                names.push(g.name.copy())
        case _:
            pass
    return names

## A definition's signature as it would be written (stage 0's
## `signature`).
pub pure def signature(prog: Program, types: Types, d: DefId) -> String:
    let def_ = ref prog.defs[d.index]
    let names = generic_names(prog, d)
    match def_.kind():
        case DefKind.Fn(f):
            var owner = String.new()
            if let Some(o) = f.owner:
                owner = "{shown(prog, types, o, names)}."
            var params: list[String] = []
            match f.self_mode:
                case Some(Mode.Own):
                    params.push("own self".to_string())
                case Some(Mode.Mut):
                    params.push("mut self".to_string())
                case Some(Mode.Borrow):
                    params.push("self".to_string())
                case None:
                    pass
            for p in f.params:
                let mode = match p.mode:
                    case Mode.Own: "own "
                    case Mode.Mut: "mut "
                    case Mode.Borrow: ""
                params.push("{mode}{p.name}: {shown(prog, types, p.ty, names)}")
            let pure_ = if f.pure: "pure " else: ""
            let ret = shown(prog, types, f.ret, names)
            return "{pure_}def {owner}{def_.name}({params.join(", ")}) -> {ret}"
        case DefKind.Struct(s):
            var out = "struct {def_.name}:"
            for f in s.fields:
                out.push("\n    {f.name}: {shown(prog, types, f.ty, names)}")
            return out
        case DefKind.Enum(e):
            var out = "enum {def_.name}:"
            for v in e.variants:
                out.push("\n    {v.name}")
            return out
        case DefKind.ErrorSet(e):
            var out = "error {def_.name}:"
            for v in e.variants:
                out.push("\n    {v.name}")
            return out
        case DefKind.Const(c):
            return "const {def_.name}: {shown(prog, types, c.ty, [])}"
        case DefKind.Trait(_):
            return "trait {def_.name}"
        case DefKind.Module(_):
            return "module {prog.qualified_name(d)}"
        case DefKind.TypeAlias(t):
            return "type {def_.name} = {shown(prog, types, t, [])}"
        case DefKind.Refinement(_):
            return "type {def_.name}"
        case _:
            return def_.name.copy()

## What the checker knows of a definition besides its signature: a `T !`
## function's inferred error set.
pure def notes_of(typed: typeck.Typed, d: DefId) -> String:
    let f = typed.prog.fn_info(d) else:
        return String.new()
    if not f.err_inferred:
        return String.new()
    var set: list[String] = []
    if let Some(members) = typed.inferred.get(d):
        for e in members:
            set.push(typed.prog.defs[e.index].name.copy())
    if set.is_empty():
        return "error set (inferred): none".to_string()
    return "error set (inferred): `{{{set.join(", ")}}}`"

## The `##` comment of a definition, from its module's file.
pure def doc_of(typed: typeck.Typed, files: Files, d: DefId) -> String:
    let def_ = ref typed.prog.defs[d.index]
    let (_, text) = files.get(def_.module) else:
        return String.new()
    return doc_above(text, def_.span.start)

## `query hover`: the range of what the position names, its signature (a
## definition's, `let x: T` of a local, `x: T` of a field, or the type of
## an expression), what the checker knows of it, and its `##` comment,
## as one line `RANGE\tSIGNATURE\tNOTES\tDOC`; nothing where the position
## names nothing.
pub pure def hover(
    typed: typeck.Typed, files: Files, m: ModuleId, text: str, offset: int, catalog: Catalog
) -> String:
    let target = target_of(typed, files, m, offset, catalog) else:
        return String.new()
    let prog = ref typed.prog
    let types = ref typed.types
    let lines = Lines.of(text)
    var range = TextRange.new(offset, offset)
    var sig = String.new()
    var notes = String.new()
    var doc = String.new()
    match target:
        case Target.Def(d):
            sig = signature(prog, types, d)
            notes = notes_of(typed, d)
            doc = doc_of(typed, files, d)
            range = name_at(text, offset, prog.defs[d.index].name) ?? range_at(typed, m, offset)
        case Target.Field(d, k):
            let s = prog.struct_info(d) else:
                return String.new()
            let f = ref s.fields[k]
            sig = "{f.name}: {shown(prog, types, f.ty, generic_names(prog, d))}"
            doc = f.doc.copy()
            range = name_at(text, offset, f.name) ?? range_at(typed, m, offset)
        case Target.Local(bi, li):
            let l = ref typed.bodies[bi].locals[li]
            let kw = if l.mutable: "var" else: "let"
            sig = "{kw} {l.name}: {shown(prog, types, l.ty, generic_names(prog, typed.bodies[bi].def_))}"
            range = name_at(text, offset, l.name) ?? l.span
        case Target.Expr(bi, ei):
            let e = ref typed.bodies[bi].exprs[ei]
            sig = shown(prog, types, e.ty, generic_names(prog, typed.bodies[bi].def_))
            range = e.span
    let at = range_of(text, lines, range.start, range.end)
    return "{at}\t{field(sig)}\t{field(notes)}\t{field(doc)}\n"

## The range of the name `name` written at `offset` of `text`, when the
## name there is that one.
pure def name_at(text: str, offset: int, name: str) -> TextRange?:
    let start = word_start(text, offset)
    var end = min(offset, text.byte_len())
    while end < text.byte_len() and is_name_byte(text.byte_at(end)):
        end += 1
    if text.byte_slice(start, end) != name:
        return None
    return Some(TextRange.new(start, end))

## The range of the innermost expression at `offset`, or the offset itself.
pure def range_at(typed: typeck.Typed, m: ModuleId, offset: int) -> TextRange:
    if let Some((bi, ei)) = expr_at(typed, m, offset):
        return typed.bodies[bi].exprs[ei].span
    return TextRange.new(offset, offset)

## Where a definition, a field or a local is declared: its module and its
## range there.
pub pure def declared(typed: typeck.Typed, target: Target) -> (ModuleId, TextRange)?:
    let prog = ref typed.prog
    match target:
        case Target.Def(d):
            # A module is declared by its file (RULES.md, R169).
            if let DefKind.Module(mid) = prog.defs[d.index].kind():
                return Some((mid, TextRange.new(0, 0)))
            return Some((prog.defs[d.index].module, prog.defs[d.index].span))
        case Target.Field(d, k):
            let s = prog.struct_info(d) else:
                return None
            return Some((prog.defs[d.index].module, name_in(s.fields[k].span, s.fields[k].name)))
        case Target.Local(bi, li):
            return Some((body_module(typed, bi), typed.bodies[bi].locals[li].span))
        case Target.Expr(_, _):
            return None

## The part of a field's range that is its name: the field is written
## `name: T`, its name first.
pure def name_in(r: TextRange, name: str) -> TextRange:
    return TextRange.new(r.start, min(r.end, r.start + name.byte_len()))

## `query definition`: the file and range of the declaration the position
## names, `PATH\tRANGE`; nothing where it names none or none with a file.
pub pure def definition(
    typed: typeck.Typed, files: Files, m: ModuleId, offset: int, catalog: Catalog
) -> String:
    let target = target_of(typed, files, m, offset, catalog) else:
        return String.new()
    let (at, r) = declared(typed, target) else:
        return String.new()
    let (path, text) = files.get(at) else:
        return String.new()
    return "{field(path)}\t{range_of(text, Lines.of(text), r.start, r.end)}\n"

## The name a target is written with.
pure def target_name(typed: typeck.Typed, target: Target) -> String?:
    let prog = ref typed.prog
    match target:
        case Target.Def(d):
            return Some(prog.defs[d.index].name.copy())
        case Target.Field(d, k):
            let s = prog.struct_info(d) else:
                return None
            return Some(s.fields[k].name.copy())
        case Target.Local(bi, li):
            return Some(typed.bodies[bi].locals[li].name.copy())
        case Target.Expr(_, _):
            return None

## `query references`: the declaration of what the position names and
## every use of it in the program's own files (`programs`, the modules of the
## program's packages that have files), each `PATH\tRANGE\tKIND`, the kind
## `declaration` or `use`: the declaration first, then the uses by file
## and position. A use is a name written as that one where it means it
## (stage 0's `occurrences`): what is at the name is the target.
pub pure def references(
    typed: typeck.Typed,
    files: Files,
    programs: list[ModuleId],
    m: ModuleId,
    offset: int,
    catalog: Catalog,
) -> String:
    let target = target_of(typed, files, m, offset, catalog) else:
        return String.new()
    let name = target_name(typed, target) else:
        return String.new()
    var out = String.new()
    var decl: (ModuleId, TextRange)? = None
    if let Some((at, r)) = declared(typed, target):
        if let Some((path, text)) = files.get(at):
            out.push(
                "{field(path)}\t{range_of(text, Lines.of(text), r.start, r.end)}\tdeclaration\n"
            )
            decl = Some((at, r))
    var typeish = False
    if let Target.Def(d) = target:
        typeish = is_type(typed.prog, d)
    # A local is used in its own body only.
    var modules = programs.copy()
    if let Target.Local(bi, _) = target:
        modules = [body_module(typed, bi)]
    for module in modules:
        let (path, text) = files.get(module) else:
            continue
        let lines = Lines.of(text)
        let tree = parse(text, catalog).tree
        for k in range(len(tree.tokens)):
            let t = tree.tokens[k]
            if t.kind != SyntaxKind.Ident:
                continue
            if text.byte_slice(t.start, t.end) != name:
                continue
            if let Some((dm, dr)) = decl:
                if dm == module and dr.start <= t.start and t.end <= dr.end:
                    continue
            if let Target.Local(bi, _) = target:
                if not within(extent(typed.bodies[bi]), t.start):
                    continue
            var means = False
            # A name of an import line means what the line imports
            # (RULES.md, R169).
            if in_import(tree, k):
                if let Target.Def(d) = target:
                    means = import_meaning(typed.prog, tree, text, k) == Some(d)
                if means:
                    out.push("{field(path)}\t{range_of(text, lines, t.start, t.end)}\tuse\n")
                continue
            # A keyword argument's name in a construction means its field
            # (RULES.md, R179).
            if let Some(found) = keyword_field(typed, module, tree, text, k):
                if found == target:
                    out.push("{field(path)}\t{range_of(text, lines, t.start, t.end)}\tuse\n")
                continue
            if let Some(found) = target_at(typed, module, t.start):
                means = found == target
            # A type's name written in a type means the type.
            if not means and typeish and k < len(tree.token_parents):
                if let Some(n) = tree.token_parents[k]:
                    means = in_type(tree, n)
            if means:
                out.push("{field(path)}\t{range_of(text, lines, t.start, t.end)}\tuse\n")
    return out

## Whether a definition is a type, whose name a type may be written with.
pure def is_type(prog: Program, d: DefId) -> bool:
    return match prog.defs[d.index].kind():
        case DefKind.Struct(_) | DefKind.Enum(_) | DefKind.ErrorSet(_) | DefKind.Trait(_): True
        case DefKind.TypeAlias(_) | DefKind.Refinement(_): True
        case _: False

## Whether node `n` is written in a type, or is one.
pure def in_type(tree: Tree, n: int) -> bool:
    var at: int? = Some(n)
    while let Some(k) = at:
        let found = match tree.nodes[k].kind:
            case SyntaxKind.PathType | SyntaxKind.OptionType | SyntaxKind.ResultType: True
            case SyntaxKind.ErrorSetType | SyntaxKind.TupleType | SyntaxKind.ParenType: True
            case SyntaxKind.FnType | SyntaxKind.RefType | SyntaxKind.DynType: True
            case _: False
        if found:
            return True
        at = tree.nodes[k].parent
    return False

## `query symbols`: the declarations of a file, from its syntax tree alone,
## so that a file with a syntax error has them too: one line per
## declaration, `KIND\tNAME\tRANGE\tNAME_RANGE\tDEPTH`, in the order
## written, a member (a method, a field, a variant, an associated constant)
## after its item with the depth 1 (stage 0's `symbol`). The kinds are
## `function`, `method`, `struct`, `enum`, `error`, `trait`, `impl`,
## `const`, `type`, `test`, `field` and `variant`.
pub pure def symbols(text: str, catalog: Catalog) -> String:
    let tree = parse(text, catalog).tree
    let lines = Lines.of(text)
    var out = String.new()
    for e in tree.nodes[tree.root].children:
        if let Element.Node(n) = e:
            symbol(tree, text, lines, n, 0, mut out)
    return out

pure def symbol_kind(kind: SyntaxKind) -> str:
    return match kind:
        case SyntaxKind.FnDef: "function"
        case SyntaxKind.StructDef: "struct"
        case SyntaxKind.EnumDef: "enum"
        case SyntaxKind.ErrorDef: "error"
        case SyntaxKind.TraitDef: "trait"
        case SyntaxKind.ImplDef: "impl"
        case SyntaxKind.ConstDef: "const"
        case SyntaxKind.TypeAlias: "type"
        case SyntaxKind.TestDef | SyntaxKind.BenchDef | SyntaxKind.SuiteDef: "test"
        case SyntaxKind.FieldDef: "field"
        case SyntaxKind.VariantDef: "variant"
        case _: ""

pure def symbol(tree: Tree, text: str, lines: Lines, n: int, depth: int, mut out: String):
    let node = ref tree.nodes[n]
    var kind = symbol_kind(node.kind)
    if kind.is_empty():
        return
    if depth > 0 and kind == "function":
        kind = "method"
    let raw = text.byte_slice(node.start, node.end)
    let end = node.start + raw.trim_end().byte_len()
    var name = String.new()
    var sel = TextRange.new(node.start, node.start)
    if kind == "test":
        for c in node.children:
            if let Element.Node(s) = c:
                if tree.nodes[s].kind == SyntaxKind.StringExpr and name.is_empty():
                    let sn = ref tree.nodes[s]
                    name = text.byte_slice(sn.start, sn.end).to_string()
                    sel = TextRange.new(sn.start, sn.end)
    elif kind == "impl":
        var header = String.new()
        for c in node.children:
            match c:
                case Element.Leaf(t):
                    if tree.tokens[t].kind == SyntaxKind.Colon:
                        break
                    header.push(text.byte_slice(tree.tokens[t].start, tree.tokens[t].end))
                case Element.Node(k):
                    header.push(text.byte_slice(tree.nodes[k].start, tree.nodes[k].end))
        var words: list[String] = []
        for w in header.split_whitespace():
            words.push(w.to_string())
        name = words.join(" ")
        sel = TextRange.new(node.start, min(node.start + 4, end))
    else:
        # The name follows the keyword (`pure def area`: `pure` is a name
        # to the lexer).
        var after_keyword = False
        var has_keyword = False
        for c in node.children:
            if let Element.Leaf(t) = c:
                if is_declaring(tree.tokens[t].kind):
                    has_keyword = True
        for c in node.children:
            if let Element.Leaf(t) = c:
                let k = tree.tokens[t].kind
                if is_declaring(k):
                    after_keyword = True
                elif k == SyntaxKind.Ident
                        and (after_keyword or not has_keyword)
                        and name.is_empty():
                    name = text.byte_slice(tree.tokens[t].start, tree.tokens[t].end).to_string()
                    sel = TextRange.new(tree.tokens[t].start, tree.tokens[t].end)
    if name.is_empty():
        return
    let whole = range_of(text, lines, node.start, end)
    let at = range_of(text, lines, sel.start, sel.end)
    out.push("{kind}\t{field(name)}\t{whole}\t{at}\t{depth}\n")
    if depth > 0:
        return
    # Members are items one level down: methods, fields, variants and
    # associated constants, directly or in the item's block.
    for c in node.children:
        if let Element.Node(k) = c:
            if is_member(tree.nodes[k].kind):
                symbol(tree, text, lines, k, 1, mut out)
            else:
                for g in tree.nodes[k].children:
                    if let Element.Node(j) = g:
                        if is_member(tree.nodes[j].kind):
                            symbol(tree, text, lines, j, 1, mut out)

pure def is_declaring(k: SyntaxKind) -> bool:
    return match k:
        case SyntaxKind.DefKw | SyntaxKind.StructKw | SyntaxKind.EnumKw | SyntaxKind.ErrorKw: True
        case SyntaxKind.TraitKw | SyntaxKind.ConstKw | SyntaxKind.TypeKw: True
        case _: False

pure def is_member(k: SyntaxKind) -> bool:
    return match k:
        case SyntaxKind.FnDef | SyntaxKind.FieldDef | SyntaxKind.VariantDef | SyntaxKind.ConstDef: True
        case _: False

# ---------------------------------------------------------------- completions

## A completion: its kind, its label, its detail and the snippet that
## writes it (empty for none), as one line.
pure def item(kind: str, label: str, detail: str, snippet: str) -> String:
    return "{kind}\t{field(label)}\t{field(detail)}\t{field(snippet)}\n"

## A snippet calling `name` with a hole for each of `params`.
pure def call_snippet(name: str, params: list[String]) -> String:
    var holes: list[String] = []
    for i in range(len(params)):
        holes.push("${{{i + 1}:{params[i]}}}")
    return "{name}({holes.join(", ")})"

## The completion of a definition named `name`, when it is one.
pure def def_item(prog: Program, types: Types, name: str, d: DefId) -> String?:
    if name.is_empty() or name.starts_with("__") or name.contains("#") or name.contains("<"):
        return None
    let detail = signature(prog, types, d)
    match prog.defs[d.index].kind():
        case DefKind.Fn(f):
            if f.comptime_ or f.internal:
                return None
            var required: list[String] = []
            for p in f.params:
                if p.default.is_none():
                    required.push(p.name.copy())
            return Some(item("function", name, detail, call_snippet(name, required)))
        case DefKind.Struct(s):
            var snippet = String.new()
            if s.builtin.is_none():
                var holes: list[String] = []
                for f in s.fields:
                    if f.default.is_none():
                        holes.push("{f.name}=${{{len(holes) + 1}:{f.name}}}")
                snippet = "{name}({holes.join(", ")})"
            return Some(item("struct", name, detail, snippet))
        case DefKind.Enum(_) | DefKind.ErrorSet(_):
            return Some(item("enum", name, detail, ""))
        case DefKind.Const(_):
            return Some(item("const", name, detail, ""))
        case DefKind.Module(_):
            return Some(item("module", name, detail, ""))
        case DefKind.Trait(_):
            return Some(item("trait", name, detail, ""))
        case DefKind.TypeAlias(_) | DefKind.Refinement(_):
            return Some(item("type", name, detail, ""))
        case _:
            return None

## The completions of a value of type `ty`: its struct's fields, then its
## type's methods and those of the traits it implements, each once
## (stage 0's `members`).
pub pure def members(typed: typeck.Typed, ty: Ty) -> String:
    let prog = ref typed.prog
    var types = typed.types.copy()
    let t = types.strip_ref(ty)
    var found: dict[String, String] = {}
    var order: list[String] = []
    if let TyData.Adt(d, args) = types.data(t).copy():
        if let Some(s) = prog.struct_info(d):
            if s.builtin.is_none():
                for f in s.fields:
                    let fty = types.subst(f.ty, args)
                    let line = item("field", f.name, prog.display(types, fty), "")
                    if not found.contains(f.name.copy()):
                        _ = found.insert(f.name.copy(), line)
                        order.push(f.name.copy())
    let key = types.key(t) else:
        return joined(found, order)
    var methods: list[(String, DefId)] = []
    for ((k, n), d) in prog.methods.items():
        if k == key:
            methods.push((n.copy(), d))
    for i in prog.impls:
        let info = prog.impl_info(i) else:
            continue
        if types.key(types.strip_ref(info.self_ty)) == Some(key):
            for (n, d) in info.methods:
                methods.push((n.copy(), d))
    for (n, d) in methods:
        let f = prog.fn_info(d) else:
            continue
        if f.self_mode.is_none() or not named(n) or found.contains(n.copy()):
            continue
        var required: list[String] = []
        for p in f.params:
            if p.default.is_none():
                required.push(p.name.copy())
        let line = item("method", n, signature(prog, types, d), call_snippet(n, required))
        _ = found.insert(n.copy(), line)
        order.push(n.copy())
    return joined(found, order)

## The lines of `found` by their labels, sorted.
pure def joined(found: dict[String, String], order: list[String]) -> String:
    var labels = order.copy()
    labels.sort()
    var out = String.new()
    for l in labels:
        if let Some(line) = found.get(l.copy()):
            out.push(line)
    return out

## The narrowest expression of module `m` that ends at `end`: the value
## before a `.`, in a text whose `.` and the name after it are gone.
pub pure def receiver_at(typed: typeck.Typed, m: ModuleId, end: int) -> Ty?:
    var best: Ty? = None
    var best_width = 0
    for bi in range(len(typed.bodies)):
        if body_module(typed, bi) != m:
            continue
        let body = ref typed.bodies[bi]
        for e in body.exprs:
            if e.span.end != end or typed.types.contains_error(e.ty):
                continue
            if best.is_none() or width(e.span) < best_width:
                best = Some(e.ty)
                best_width = width(e.span)
    return best

## The names that may be written at `offset` of module `m` (stage 0's
## `scope_items`): the locals of the innermost body there declared before
## it, the module's own names and those it imports, the prelude's names
## (but the standard library's internal functions), the variants of the program's own enums by their bare names, and
## the keywords.
pub pure def scope(typed: typeck.Typed, m: ModuleId, offset: int) -> String:
    let prog = ref typed.prog
    let types = ref typed.types
    var found: dict[String, String] = {}
    var order: list[String] = []
    var around: int? = None
    var around_width = 0
    for bi in range(len(typed.bodies)):
        if body_module(typed, bi) != m or not within(extent(typed.bodies[bi]), offset):
            continue
        let w = width(extent(typed.bodies[bi]))
        if around.is_none() or w < around_width:
            around = Some(bi)
            around_width = w
    if let Some(bi) = around:
        let body = ref typed.bodies[bi]
        let names = generic_names(prog, body.def_)
        for l in body.locals:
            if l.span.end <= offset and named(l.name) and not found.contains(l.name.copy()):
                let kw = if l.mutable: "var" else: "let"
                let detail = "{kw} {l.name}: {shown(prog, types, l.ty, names)}"
                _ = found.insert(l.name.copy(), item("variable", l.name, detail, ""))
                order.push(l.name.copy())
    # The prelude's names a program sees: those it marks `pub`, when it
    # marks any (RULES.md, R175).
    var marks_pub = False
    for d in prog.modules[prog.prelude.index].order:
        if prog.defs[d.index].vis == Vis.Pub:
            marks_pub = True
            break
    for module in [m, prog.prelude]:
        for (n, d) in prog.modules[module.index].items.items():
            if found.contains(n.copy()):
                continue
            if module == prog.prelude and marks_pub and prog.defs[d.index].vis != Vis.Pub:
                continue
            if let Some(line) = def_item(prog, types, n, d):
                _ = found.insert(n.copy(), line)
                order.push(n.copy())
    for (n, ds) in prog.variants.items():
        let (d, _) = ds.first() else:
            continue
        if prog.modules[prog.defs[d.index].module.index].is_std or found.contains(n.copy()):
            continue
        _ = found.insert(n.copy(), item("variant", n, prog.defs[d.index].name, ""))
        order.push(n.copy())
    for k in KEYWORDS:
        if not found.contains(k.to_string()):
            _ = found.insert(k.to_string(), item("keyword", k, "keyword", ""))
            order.push(k.to_string())
    return joined(found, order)

## The lines of `answer` whose label starts with `prefix`.
pub pure def with_prefix(answer: str, prefix: str) -> String:
    if prefix.is_empty():
        return answer.to_string()
    var out = String.new()
    for line in answer.lines():
        var k = 0
        for part in line.split("\t"):
            if k == 1 and part.starts_with(prefix):
                out.push(line)
                out.push("\n")
            k += 1
    return out

## Whether byte `b` may be part of a name.
pub pure def is_name_byte(b: u8) -> bool:
    let n = b.to_int()
    return (n >= 48 and n <= 57)
        or (n >= 65 and n <= 90)
        or (n >= 97 and n <= 122)
        or n == 95
        or n >= 128

## Where the name being written at `offset` starts.
pub pure def word_start(text: str, offset: int) -> int:
    var start = min(offset, text.byte_len())
    while start > 0 and is_name_byte(text.byte_at(start - 1)):
        start -= 1
    return start

# ---------------------------------------------------------------- import lines

## What position `offset` of module `m` names: a name of an import line
## what the line imports (RULES.md, R169), else what `target_at` finds.
pub pure def target_of(
    typed: typeck.Typed, files: Files, m: ModuleId, offset: int, catalog: Catalog
) -> Target?:
    if let Some((_, text)) = files.get(m):
        let tree = parse(text, catalog).tree
        for k in range(len(tree.tokens)):
            let t = tree.tokens[k]
            if t.kind != SyntaxKind.Ident or t.start > offset or offset > t.end:
                continue
            if in_import(tree, k):
                if let Some(d) = import_meaning(typed.prog, tree, text, k):
                    return Some(Target.Def(d))
                return None
            if let Some(found) = keyword_field(typed, m, tree, text, k):
                return Some(found)
    return target_at(typed, m, offset)

## The field that the name `k` of a keyword argument names, `x` of
## `Point(x=1)`: a name before `=` among the arguments of a struct's
## construction (RULES.md, R179), which `references` and `rename` count
## among the field's uses.
pure def keyword_field(typed: typeck.Typed, m: ModuleId, tree: Tree, text: str, k: int) -> Target?:
    var next = k + 1
    while next < len(tree.tokens) and tree.tokens[next].kind.is_trivia():
        next += 1
    if next >= len(tree.tokens) or tree.tokens[next].kind != SyntaxKind.Eq:
        return None
    let t = tree.tokens[k]
    let (bi, ei) = expr_at(typed, m, t.start) else:
        return None
    let TExprKind.Struct(d, _) = typed.bodies[bi].exprs[ei].kind.copy() else:
        return None
    let s = typed.prog.struct_info(d) else:
        return None
    let name = text.byte_slice(t.start, t.end)
    for i in range(len(s.fields)):
        if s.fields[i].name == name:
            return Some(Target.Field(d, i))
    return None

## Whether token `k` is written in an import line.
pure def in_import(tree: Tree, k: int) -> bool:
    if k >= len(tree.token_parents):
        return False
    var at = tree.token_parents[k]
    while let Some(n) = at:
        let kind = tree.nodes[n].kind
        if kind == SyntaxKind.FromImport or kind == SyntaxKind.ImportItem:
            return True
        at = tree.nodes[n].parent
    return False

## The names of a module path node, up to and including token `upto` when
## it is one of them.
pure def path_names(tree: Tree, text: str, n: int, upto: int?) -> list[String]:
    var names: list[String] = []
    for c in tree.nodes[n].children:
        if let Element.Leaf(t) = c:
            if tree.tokens[t].kind == SyntaxKind.Ident:
                names.push(text.byte_slice(tree.tokens[t].start, tree.tokens[t].end).to_string())
                if Some(t) == upto:
                    break
    return names

## The module an import names by `names` (`garden.beds`, `std.json`).
pure def module_by_path(prog: Program, names: list[String]) -> ModuleId?:
    for k in range(len(prog.modules)):
        if not prog.modules[k].path.is_empty() and prog.modules[k].path == names:
            return Some(ModuleId(index=k))
    if len(names) >= 2 and names[0] == "std":
        var rest: list[String] = []
        for i in range(1, len(names)):
            rest.push(names[i].copy())
        let name = rest.join(".")
        for k in range(len(prog.modules)):
            if prog.modules[k].is_std and prog.modules[k].name == name:
                return Some(ModuleId(index=k))
    return None

## The definition that is module `mid`.
pure def module_def(prog: Program, mid: ModuleId) -> DefId?:
    for i in range(len(prog.defs)):
        if let DefKind.Module(found) = prog.defs[i].kind():
            if found == mid:
                return Some(DefId(index=i))
    return None

## What the name at token `k` of an import line means: a module of its
## path, or the definition a `from` line imports by that name (not the
## alias after `as`, which declares a name of its own).
pure def import_meaning(prog: Program, tree: Tree, text: str, k: int) -> DefId?:
    if k >= len(tree.token_parents):
        return None
    let p = tree.token_parents[k] else:
        return None
    let kind = tree.nodes[p].kind
    if kind == SyntaxKind.ModulePath:
        let found = module_by_path(prog, path_names(tree, text, p, Some(k))) else:
            return None
        return module_def(prog, found)
    if kind != SyntaxKind.ImportName:
        return None
    var first: int? = None
    for c in tree.nodes[p].children:
        if let Element.Leaf(t) = c:
            if tree.tokens[t].kind == SyntaxKind.Ident and first.is_none():
                first = Some(t)
    if first != Some(k):
        return None
    let line = tree.nodes[p].parent else:
        return None
    var source: int? = None
    for c in tree.nodes[line].children:
        if let Element.Node(n) = c:
            if tree.nodes[n].kind == SyntaxKind.ModulePath:
                source = Some(n)
    let path = source else:
        return None
    let found = module_by_path(prog, path_names(tree, text, path, None)) else:
        return None
    let name = text.byte_slice(tree.tokens[k].start, tree.tokens[k].end).to_string()
    if let Some(d) = prog.modules[found.index].items.get(name):
        return Some(d)
    return None

# ---------------------------------------------------------------- rename

## Whether `name` may name a declaration: a name the lexer reads as one,
## not a keyword.
pub pure def is_name(name: str) -> bool:
    var first = True
    for c in name.chars():
        if not (c.is_alphabetic() or c == '_' or (not first and c.is_digit())):
            return False
        first = False
    if first or KEYWORDS.contains(name):
        return False
    return keyword_kind(name).is_none()

## `query rename`: the edits that rename what the position names to `new`,
## one per line of `references` (its declaration and every use),
## `PATH\tRANGE\tNEW`; or one line `refused\tREASON`: `not-a-name` for a
## `new` that is not a name, `not-renamable` where the position names
## nothing the program declares (a local, a definition of the program's
## own packages, a field of one).
pub pure def rename(
    typed: typeck.Typed,
    files: Files,
    programs: list[ModuleId],
    m: ModuleId,
    offset: int,
    catalog: Catalog,
    new: str,
) -> String:
    if not is_name(new):
        return "refused\tnot-a-name\n"
    let target = target_of(typed, files, m, offset, catalog) else:
        return "refused\tnot-renamable\n"
    let (at, _) = declared(typed, target) else:
        return "refused\tnot-renamable\n"
    # A module is named by its file, which a rename does not move.
    if let Target.Def(d) = target:
        if let DefKind.Module(_) = typed.prog.defs[d.index].kind():
            return "refused\tnot-renamable\n"
    if not programs.contains(at) or files.get(at).is_none():
        return "refused\tnot-renamable\n"
    var out = String.new()
    for line in references(typed, files, programs, m, offset, catalog).lines():
        var parts: list[String] = []
        for part in line.split("\t"):
            parts.push(part.to_string())
        if len(parts) == 3:
            out.push("{parts[0]}\t{parts[1]}\t{field(new)}\n")
    if out.is_empty():
        return "refused\tnot-renamable\n"
    return out

# ---------------------------------------------------------------- inlay hints

## `query inlay`: the hints of module `m`, whose text is `text`, by
## position: `POSITION\tKIND\tLABEL`, the kind `type` (`: T` after the
## name of a local whose declaration does not write its type, a `let`'s, a
## pattern's, a closure's parameter), `errors` (the error set a `T !`
## function infers, `{A, B}`, after its return type) or `mode` (`mut` or
## `own` before an argument passed to such a parameter without the word).
pub pure def inlay(typed: typeck.Typed, m: ModuleId, text: str) -> String:
    let prog = ref typed.prog
    let types = ref typed.types
    let lines = Lines.of(text)
    var hints: list[(int, String)] = []
    for bi in range(len(typed.bodies)):
        if body_module(typed, bi) != m:
            continue
        let body = ref typed.bodies[bi]
        let names = generic_names(prog, body.def_)
        for li in range(len(body.locals)):
            let l = ref body.locals[li]
            if body.params.contains(li) or not named(l.name) or l.name.starts_with("_"):
                continue
            if l.span.end > text.byte_len() or text.byte_slice(l.span.start, l.span.end) != l.name:
                continue
            if types.contains_error(l.ty):
                continue
            let after = text.byte_slice(l.span.end, text.byte_len()).trim_start()
            if after.starts_with(":"):
                continue
            let at = l.span.end
            let label = ": {shown(prog, types, l.ty, names)}"
            hints.push((at, "{position(text, lines, at)}\ttype\t{field(label)}\n"))
        for e in body.exprs:
            match e.kind:
                case TExprKind.Call(Callee.Fn(d, _), args):
                    let f = prog.fn_info(d) else:
                        continue
                    var skip = 0
                    if f.self_mode.is_some():
                        skip = 1
                    for j in range(len(f.params)):
                        if j + skip >= len(args):
                            break
                        let a = ref args[j + skip]
                        let arg = ref body.exprs[a.expr.index]
                        var word = ""
                        if f.params[j].mode == Mode.Mut and a.mode == ArgMode.BorrowMut:
                            word = "mut"
                        elif f.params[j].mode == Mode.Own and not types.contains_error(arg.ty):
                            word = "own"
                        if word.is_empty() or arg.span.start > text.byte_len():
                            continue
                        let at = arg.span.start
                        if text.byte_slice(0, at).trim_end().ends_with(word):
                            continue
                        hints.push((at, "{position(text, lines, at)}\tmode\t{word}\n"))
                case _:
                    pass
    for i in range(len(prog.defs)):
        let def_ = ref prog.defs[i]
        if def_.module != m:
            continue
        let f = prog.fn_info(DefId(index=i)) else:
            continue
        if not f.err_inferred:
            continue
        let ret = f.ret_span else:
            continue
        var set: list[String] = []
        if let Some(members) = typed.inferred.get(DefId(index=i)):
            for e in members:
                set.push(prog.defs[e.index].name.copy())
        let label = "{{{set.join(", ")}}}"
        hints.push((ret.end, "{position(text, lines, ret.end)}\terrors\t{field(label)}\n"))
    hints.sort_by((a, b) -> a.0.cmp(b.0))
    var out = String.new()
    for (_, line) in hints:
        out.push(line)
    return out

## `LINE:COL` of byte `at` of `text`.
pub pure def position(text: str, lines: Lines, at: int) -> String:
    let (line, col) = lines.line_col(text, at)
    return "{line}:{col}"

# ---------------------------------------------------------------- selection ranges

## `query selection`: the ranges of the syntax around `offset` of `text`,
## from its syntax tree alone, innermost first, each `RANGE` once, a
## node's range without the blanks and line breaks it ends with (stage
## 0's `selection_ranges`).
pub pure def selection(text: str, offset: int, catalog: Catalog) -> String:
    let tree = parse(text, catalog).tree
    let lines = Lines.of(text)
    var path: list[int] = []
    var node: int? = Some(tree.root)
    while let Some(n) = node:
        path.push(n)
        node = None
        for c in tree.nodes[n].children:
            if let Element.Node(k) = c:
                if tree.nodes[k].start <= offset and offset < tree.nodes[k].end:
                    node = Some(k)
                    break
    var out = String.new()
    var last: (int, int)? = None
    var i = len(path) - 1
    while i >= 0:
        let n = ref tree.nodes[path[i]]
        let raw = text.byte_slice(n.start, n.end)
        let end = n.start + raw.trim_end().byte_len()
        if last != Some((n.start, end)):
            out.push("{range_of(text, lines, n.start, end)}\n")
            last = Some((n.start, end))
        i -= 1
    return out

# ---------------------------------------------------------------- formatting

## The lines of `text`, each with its line break.
pure def split_lines(text: str) -> list[String]:
    var out: list[String] = []
    var start = 0
    for i in range(text.byte_len()):
        if text.byte_at(i).to_int() == 10:
            out.push(text.byte_slice(start, i + 1).to_string())
            start = i + 1
    if start < text.byte_len():
        out.push(text.byte_slice(start, text.byte_len()).to_string())
    return out

## The runs of lines that differ between `old` and `new`, as `(old start,
## old end, new start, new end)`, from the longest common subsequence of
## the lines between those both start and end with (stage 0's
## `changed_runs`).
pub pure def changed_runs(old: list[String], new: list[String]) -> list[(int, int, int, int)]:
    var prefix = 0
    while prefix < len(old) and prefix < len(new) and old[prefix] == new[prefix]:
        prefix += 1
    var suffix = 0
    while suffix < len(old) - prefix
            and suffix < len(new) - prefix
            and old[len(old) - 1 - suffix] == new[len(new) - 1 - suffix]:
        suffix += 1
    let na = len(old) - prefix - suffix
    let nb = len(new) - prefix - suffix
    var lcs: list[list[int]] = []
    for _ in range(na + 1):
        var row: list[int] = []
        for _ in range(nb + 1):
            row.push(0)
        lcs.push(row)
    var i = na - 1
    while i >= 0:
        var j = nb - 1
        while j >= 0:
            if old[prefix + i] == new[prefix + j]:
                lcs[i][j] = lcs[i + 1][j + 1] + 1
            else:
                lcs[i][j] = max(lcs[i + 1][j], lcs[i][j + 1])
            j -= 1
        i -= 1
    var runs: list[(int, int, int, int)] = []
    var a = 0
    var b = 0
    var open: (int, int)? = None
    while a < na or b < nb:
        if a < na and b < nb and old[prefix + a] == new[prefix + b]:
            if let Some((s, t)) = open:
                runs.push((prefix + s, prefix + a, prefix + t, prefix + b))
                open = None
            a += 1
            b += 1
            continue
        if open.is_none():
            open = Some((a, b))
        if a < na and (b == nb or lcs[a + 1][b] >= lcs[a][b + 1]):
            a += 1
        else:
            b += 1
    if let Some((s, t)) = open:
        runs.push((prefix + s, prefix + a, prefix + t, prefix + b))
    return runs

## `query format`'s edits of `text` formatted as `formatted`: one line per
## run of changed lines, `RANGE\tTEXT`, the run's lines in `text` (an empty
## range where lines are only inserted) and the lines that replace them.
pub pure def format_edits(text: str, formatted: str) -> String:
    let old = split_lines(text)
    let new = split_lines(formatted)
    var starts: list[int] = []
    var at = 0
    for l in old:
        starts.push(at)
        at += l.byte_len()
    starts.push(text.byte_len())
    let lines = Lines.of(text)
    var out = String.new()
    for (a0, a1, b0, b1) in changed_runs(old, new):
        var written = String.new()
        for k in range(b0, b1):
            written.push(new[k])
        out.push("{range_of(text, lines, starts[a0], starts[a1])}\t{field(written)}\n")
    return out

# ---------------------------------------------------------------- typed holes

## A typed hole (10, "Holes"; RULES.md, R174 and R181): where it is, its
## name, the type its place needs, the function it is written in, the
## bindings in scope before it with their types (`n: int`), the names and
## the expressions to depth two of those whose type is the hole's
## (`base`, `self.hours`, `t.total()`, `area(shape)`), the definitions of
## the program's types the hole's type mentions, the `requires` of its
## function as facts and its `ensures` as obligations, and the tests that
## reach its function.
pub struct Hole:
    pub module: ModuleId
    pub start: int
    pub end: int
    pub name: String
    pub ty: String
    pub function: String
    pub scope: list[String]
    pub fits: list[String]
    pub types: list[HoleType]
    pub requires: list[String]
    pub ensures: list[String]
    pub tests: list[String]

## A type the hole's type mentions, defined by the program: a struct with
## its fields (`hours: int`) or an enum with its variants (`Circle(r: f64)`).
pub struct HoleType:
    pub name: String
    pub is_struct: bool
    pub members: list[String]

## The typed holes of the bodies of `modules`, by module and position.
pub pure def holes(typed: typeck.Typed, modules: list[ModuleId]) -> list[Hole]:
    let prog = ref typed.prog
    let types = ref typed.types
    let reached = tests_reaching(typed)
    var out: list[Hole] = []
    for bi in range(len(typed.bodies)):
        let m = body_module(typed, bi)
        if not modules.contains(m):
            continue
        let body = ref typed.bodies[bi]
        let names = generic_names(prog, body.def_)
        var requires: list[String] = []
        var ensures: list[String] = []
        # The local `ensures` calls `result`, which is not in scope in the
        # body.
        var result_local = -1
        if let Some(c) = body.contracts:
            for r in c.requires:
                requires.push(r.text.copy())
            for e in c.ensures:
                ensures.push(e.text.copy())
            result_local = c.result ?? -1
        for e in body.exprs:
            match e.kind:
                case TExprKind.Call(Callee.Fn(d, _), args):
                    let f = prog.fn_info(d) else:
                        continue
                    if f.intrinsic != Some("todo".to_string()):
                        continue
                    var name = String.new()
                    if let Some(first) = args.first():
                        if let TExprKind.Str(t) = body.exprs[first.expr.index].kind:
                            name = t.copy()
                    let ty = shown(prog, types, e.ty, names)
                    var scope: list[String] = []
                    var fits: list[String] = []
                    var seen: list[String] = []
                    var bound: list[(String, Ty)] = []
                    for li in range(len(body.locals)):
                        let l = ref body.locals[li]
                        if l.span.end > e.span.start or not named(l.name) or seen.contains(l.name):
                            continue
                        if li == result_local:
                            continue
                        seen.push(l.name.copy())
                        scope.push("{l.name}: {shown(prog, types, l.ty, names)}")
                        bound.push((l.name.copy(), l.ty))
                        let bare = shown(prog, types, types.strip_ref(l.ty), names)
                        if bare == ty:
                            fits.push(l.name.copy())
                    for x in fits_deeper(typed, bound, ty, names, body.def_):
                        if not fits.contains(x):
                            fits.push(x.copy())
                    var mentioned: list[DefId] = []
                    mentions(prog, types, e.ty, mut mentioned)
                    var defined: list[HoleType] = []
                    for t in mentioned:
                        if let Some(h) = hole_type(prog, types, t):
                            defined.push(h)
                    var tests: list[String] = []
                    if let Some(ts) = reached.get(body.def_):
                        tests = ts.copy()
                    out.push(
                        Hole(
                            module=m,
                            start=e.span.start,
                            end=e.span.end,
                            name=name,
                            ty=ty,
                            function=function_name(prog, types, body.def_),
                            scope=scope,
                            fits=fits,
                            types=defined,
                            requires=requires.copy(),
                            ensures=ensures.copy(),
                            tests=tests,
                        )
                    )
                case _:
                    pass
    out.sort_by((a, b) -> hole_order(a, b))
    return out

## The expressions of depth two whose type is the hole's `ty` (10: "the
## expressions that fit to depth two"; RULES.md, R181), from the bindings
## in scope `bound`: a field of one (`self.hours`), a method of one that
## takes nothing else (`t.total()`), and a function of the program's own
## modules, but the hole's, that takes one of them alone (`area(shape)`).
pure def fits_deeper(
    typed: typeck.Typed, bound: list[(String, Ty)], ty: str, names: list[String], within: DefId
) -> list[String]:
    let prog = ref typed.prog
    let types = ref typed.types
    var out: list[String] = []
    for (name, lty) in bound:
        let bare = types.strip_ref(lty)
        let TyData.Adt(d, _) = types.data(bare) else:
            continue
        if let Some(s) = prog.struct_info(d):
            for f in s.fields:
                if shown(prog, types, f.ty, generic_names(prog, d)) == ty:
                    out.push("{name}.{f.name}")
        for ((key, method), m) in prog.methods.items():
            if key != TyKey.Adt(d) or m == within:
                continue
            let f = prog.fn_info(m) else:
                continue
            if f.self_mode.is_none() or not f.params.is_empty() or not f.generics.is_empty():
                continue
            if shown(prog, types, f.ret, names) == ty:
                out.push("{name}.{method}()")
    for i in range(len(prog.defs)):
        let d = DefId(index=i)
        let def_ = ref prog.defs[i]
        if d == within or prog.modules[def_.module.index].is_std:
            continue
        let DefKind.Fn(f) = def_.kind() else:
            continue
        if f.owner.is_some() or len(f.params) != 1 or not f.generics.is_empty():
            continue
        if f.intrinsic.is_some() or shown(prog, types, f.ret, names) != ty:
            continue
        let wanted = shown(prog, types, types.strip_ref(f.params[0].ty), names)
        for (name, lty) in bound:
            if shown(prog, types, types.strip_ref(lty), names) == wanted:
                out.push("{def_.name}({name})")
    out.sort()
    return out

## The structs and enums of the program's own modules that `ty` names,
## through its type arguments, references, tuples and functions, each once.
pure def mentions(prog: Program, types: Types, ty: Ty, mut out: list[DefId]):
    match types.data(ty):
        case TyData.Adt(d, args):
            if not prog.modules[prog.defs[d.index].module.index].is_std and not out.contains(d):
                out.push(d)
            for a in args:
                mentions(prog, types, a, mut out)
        case TyData.Ref(inner, _):
            mentions(prog, types, inner, mut out)
        case TyData.Tuple(elems, _):
            for t in elems:
                mentions(prog, types, t, mut out)
        case TyData.Fn(params, ret, _):
            for t in params:
                mentions(prog, types, t, mut out)
            mentions(prog, types, ret, mut out)
        case _:
            pass

## The definition of the struct or enum `d`, as the hole's report writes it.
pure def hole_type(prog: Program, types: Types, d: DefId) -> HoleType?:
    let names = generic_names(prog, d)
    let name = prog.defs[d.index].name.copy()
    if let Some(s) = prog.struct_info(d):
        var members: list[String] = []
        for f in s.fields:
            members.push("{f.name}: {shown(prog, types, f.ty, names)}")
        return Some(HoleType(name=name, is_struct=True, members=members))
    if let Some(e) = prog.enum_info(d):
        var members: list[String] = []
        for v in e.variants:
            if v.fields.is_empty():
                members.push(v.name.copy())
                continue
            var each: list[String] = []
            for (n, t) in v.fields:
                match n:
                    case Some(x):
                        each.push("{x}: {shown(prog, types, t, names)}")
                    case None:
                        each.push(shown(prog, types, t, names))
            members.push("{v.name}({each.join(", ")})")
        return Some(HoleType(name=name, is_struct=False, members=members))
    return None

## For each function of the program, the names of the tests whose bodies
## call it, directly or through other functions, in the tests' order: the
## tests that reach a hole of it (RULES.md, R181).
pure def tests_reaching(typed: typeck.Typed) -> dict[DefId, list[String]]:
    var calls: dict[DefId, list[DefId]] = {}
    for body in typed.bodies:
        var callees: list[DefId] = []
        for e in body.exprs:
            match e.kind:
                case TExprKind.Call(Callee.Fn(d, _), _) | TExprKind.FnRef(d, _):
                    if not callees.contains(d):
                        callees.push(d)
                case _:
                    pass
        match calls.get(body.def_):
            case Some(xs):
                var all = xs.copy()
                for c in callees:
                    if not all.contains(c):
                        all.push(c)
                _ = calls.insert(body.def_, all)
            case None:
                _ = calls.insert(body.def_, callees)
    var out: dict[DefId, list[String]] = {}
    for t in typed.prog.tests:
        let name = typed.prog.defs[t.index].name.copy()
        var seen: set[DefId] = set()
        var work = [t]
        while let Some(d) = work.pop():
            if not seen.add(d):
                continue
            var names: list[String] = []
            if let Some(xs) = out.get(d):
                names = xs.copy()
            if not names.contains(name):
                names.push(name.copy())
                _ = out.insert(d, names)
            if let Some(cs) = calls.get(d):
                for c in cs:
                    work.push(c)
    return out

pure def hole_order(a: Hole, b: Hole) -> Ordering:
    if a.module != b.module:
        return a.module.index.cmp(b.module.index)
    return a.start.cmp(b.start)

## The name of a function as a hole's report writes it: `Point.moved` of a
## method.
pure def function_name(prog: Program, types: Types, d: DefId) -> String:
    let def_ = ref prog.defs[d.index]
    if let Some(f) = prog.fn_info(d):
        if let Some(o) = f.owner:
            return "{shown(prog, types, o, generic_names(prog, d))}.{def_.name}"
    return def_.name.copy()

## `query holes`: the typed holes of module `m`, whose text is `text`,
## one line each, `RANGE\tNAME\tTYPE\tFUNCTION\tSCOPE\tFITS\tTYPES\tREQUIRES\tENSURES\tTESTS`:
## SCOPE the bindings in scope with their types and FITS the names and
## expressions of depth two of its type, each separated by `, `; TYPES the
## definitions of the types it mentions, `struct Task {name: String}` and
## `enum Shape {Circle(r: f64), Square}`, REQUIRES and ENSURES the
## clauses of its function, each separated by `; `, and TESTS the tests
## that reach it, quoted and separated by `, ` (RULES.md, R174, R181).
pub pure def holes_answer(typed: typeck.Typed, m: ModuleId, text: str) -> String:
    let lines = Lines.of(text)
    var out = String.new()
    for h in holes(typed, [m]):
        let at = range_of(text, lines, h.start, h.end)
        let scope = field(h.scope.join(", "))
        let fits = field(h.fits.join(", "))
        var defined: list[String] = []
        for t in h.types:
            defined.push(type_line(t))
        var tests: list[String] = []
        for t in h.tests:
            tests.push(quote(t))
        let more = "{field(defined.join("; "))}\t{field(h.requires.join("; "))}\t{field(h.ensures.join("; "))}\t{field(tests.join(", "))}"
        out.push("{at}\t{field(h.name)}\t{field(h.ty)}\t{field(h.function)}\t{scope}\t{fits}\t{more}\n")
    return out

## A type of a hole's report as one line: `struct Task {name: String}`.
pub pure def type_line(t: HoleType) -> String:
    let kind = if t.is_struct: "struct" else: "enum"
    return "{kind} {t.name} {{{t.members.join(", ")}}}"

## A hole's report in JSON (10: "a human form and a JSON form"; RULES.md,
## R181): an object of its fields, each list an array of strings, the
## types an array of objects; `at` the file, line and column.
pub pure def hole_json(h: Hole, at: str) -> String:
    var types: list[String] = []
    for t in h.types:
        let kind = if t.is_struct: "struct" else: "enum"
        types.push(
            "{{\"name\": {json_text(t.name)}, \"kind\": \"{kind}\", \"members\": {json_list(t.members)}}}"
        )
    var parts: list[String] = []
    parts.push("\"at\": {json_text(at)}")
    parts.push("\"name\": {json_text(h.name)}")
    parts.push("\"type\": {json_text(h.ty)}")
    parts.push("\"function\": {json_text(h.function)}")
    parts.push("\"scope\": {json_list(h.scope)}")
    parts.push("\"fits\": {json_list(h.fits)}")
    parts.push("\"types\": [{types.join(", ")}]")
    parts.push("\"requires\": {json_list(h.requires)}")
    parts.push("\"ensures\": {json_list(h.ensures)}")
    parts.push("\"tests\": {json_list(h.tests)}")
    return "{{{parts.join(", ")}}}"

pure def json_list(xs: list[String]) -> String:
    var each: list[String] = []
    for x in xs:
        each.push(json_text(x))
    return "[{each.join(", ")}]"

## Text in double quotes, as JSON writes it.
pub pure def json_text(s: str) -> String:
    var out = String.new("\"")
    for c in s.chars():
        let n = c.code()
        if c == '"':
            out.push("\\\"")
        elif c == '\\':
            out.push("\\\\")
        elif c == '\n':
            out.push("\\n")
        elif c == '\t':
            out.push("\\t")
        elif n < 32:
            out.push("\\u00")
            out.push("0123456789abcdef".byte_slice(n >> 4, (n >> 4) + 1))
            out.push("0123456789abcdef".byte_slice(n & 15, (n & 15) + 1))
        else:
            out.push_char(c)
    out.push("\"")
    return out

test "a field holds no tab and no line break":
    assert field("a\tb\nc\\d") == "a\\tb\\nc\\\\d"
    assert field("plain") == "plain"

test "a declaration's comment is the `##` lines above it":
    let text = "## One.\n## Two.\n@inline\ndef f():\n    pass\n"
    assert doc_above(text, text.find("f(") ?? 0) == "One.\nTwo."
    assert doc_above("def g():\n    pass\n", 4) == ""

test "the name being written":
    assert word_start("let x = foo", 11) == 8
    assert word_start("p.na", 4) == 2
    assert with_prefix("a\tname\tx\t\nb\tother\ty\t\n", "na") == "a\tname\tx\t\n"

test "the runs of changed lines":
    let old = ["a\n".to_string(), "b\n".to_string(), "c\n".to_string()]
    let new = ["a\n".to_string(), "B\n".to_string(), "c\n".to_string(), "d\n".to_string()]
    assert changed_runs(old, new) == [(1, 2, 1, 2), (3, 3, 3, 4)]
    assert format_edits("x=1\n", "x = 1\n") == "1:1-2:1\tx = 1\\n\n"

test "a new name":
    assert is_name("total")
    assert is_name("_x2")
    assert not is_name("2x")
    assert not is_name("def")
    assert not is_name("a-b")
    assert not is_name("")
