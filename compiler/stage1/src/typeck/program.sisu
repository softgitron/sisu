##! The resolved program (stage 0's `sisu-resolve/src/program.rs`, with
##! the display and `Copy` rules of `ty.rs` and the trait solver of
##! `solve.rs`): every definition of every module, with resolved
##! signatures, module scopes, method tables and the well-known definitions
##! of the prelude.
##!
##! The table of types is not part of the program: the checker holds the
##! program by reference while it makes new types, so every method that
##! reads or makes a type is given the table. A function's body and a
##! parameter's default stay in the AST of the module that declares them.

from stage1.diag import Diagnostic, Msg, TextRange
from stage1.resolve import closest
from stage1.syntax.ast import Block, ExprId, Mode, TestFixture, Vis
from stage1.typeck.fix_inline import InlineForm
from stage1.typeck.folding import Term
from stage1.typeck.ty import DefId, TraitRef, Ty, TyData, TyKey, Types

@derive(Eq, Hash, Debug, Copy)
pub struct ModuleId:
    pub index: int

pub struct Def:
    pub name: String
    pub module: ModuleId
    ## Where the name is written, in the module's file.
    pub span: TextRange
    pub vis: Vis
    ## What it defines (`kind`), shared by the copies of the program: each
    ## program checked against the base is a copy of the base's, and a
    ## change makes a definition its own (`set_kind`).
    kind_: Shared[DefKind]

impl Def:
    pub pure def new(
        own name: String, module: ModuleId, span: TextRange, vis: Vis, own kind: DefKind
    ) -> Def:
        return Def(name=name, module=module, span=span, vis=vis, kind_=Shared(kind))

    ## What it defines.
    pub pure def kind(self) -> ref DefKind:
        return Shared.get(self.kind_)

    ## Replaces what it defines.
    pub pure def set_kind(mut self, own kind: DefKind):
        self.kind_ = Shared(kind)

pub enum DefKind:
    Struct(StructInfo)
    Enum(EnumInfo)
    ErrorSet(EnumInfo)
    Fn(FnInfo)
    Const(ConstInfo)
    Module(ModuleId)
    TypeAlias(Ty)
    Trait(TraitInfo)
    ## `impl Trait for Type` (an inherent `impl Type` registers its methods
    ## and is not a definition of its own).
    Impl(ImplInfo)
    ## `type Port = int where ...` (07): its base, in terms of its
    ## parameters.
    Refinement(RefinementInfo)
    ## A declaration this stage does not implement, kept so that names
    ## resolve and nothing cascades.
    Unsupported

pub struct RefinementInfo:
    pub generics: list[Generic]
    pub base: Ty
    ## The function the compiler writes for the predicate, `where(self) ->
    ## bool`.
    pub predicate: DefId?
    ## The predicate as written, for messages.
    pub text: String

## `ty: bound`, from a generic parameter's bounds or a `where` clause.
@derive(Eq)
pub struct Predicate:
    pub ty: Ty
    pub bound: TraitRef
    pub span: TextRange

pub struct AssocInfo:
    pub name: String
    ## `type Item = T` in the trait: the binding an impl that omits it gets.
    pub default: Ty?

## A trait (03, "Traits"). In its signatures `Self` is `Param(0)` and the
## trait's own parameter `i` is `Param(i + 1)`.
pub struct TraitInfo:
    pub generics: list[Generic]
    ## `trait Container(Len)`: every implementer implements these too.
    pub supertraits: list[TraitRef]
    pub assoc: list[AssocInfo]
    ## Required and provided methods, in declaration order.
    pub methods: list[DefId]
    ## `@sealed`: only the standard library implements it.
    pub sealed: bool
    ## `@marker`: no methods; implemented by the language's rules (`Copy`).
    pub marker: bool
    ## Its `comptime def`s but `derive`: compile-time functions a program
    ## names through the trait, `Trait.name(...)` (decision 251).
    pub comptime_fns: list[(String, DefId)]
    ## `unsafe trait` (22): an impl is written `unsafe impl`, its author
    ## keeping the promise the `Safety:` list of its doc comment names.
    pub unsafe_: bool

impl TraitInfo:
    pub pure def new() -> TraitInfo:
        return TraitInfo(
            generics=[],
            supertraits=[],
            assoc=[],
            methods=[],
            sealed=False,
            marker=False,
            comptime_fns=[],
            unsafe_=False,
        )

## `impl[...] Trait[...] for Type`.
pub struct ImplInfo:
    pub generics: list[Generic]
    pub predicates: list[Predicate]
    pub trait_ref: TraitRef
    pub self_ty: Ty
    pub methods: list[(String, DefId)]
    ## The associated types it binds.
    pub assoc: list[(String, Ty)]
    ## Written by the compiler for `@derive` (or a struct's or enum's own
    ## `Debug`): it compares, hashes or prints the fields.
    pub derived: bool
    ## `unsafe impl` (22): of an `unsafe trait`, `Send` or `Sync`, whose
    ## promise its author keeps.
    pub unsafe_: bool

pub struct StructInfo:
    pub generics: list[Generic]
    pub fields: list[FieldInfo]
    ## For a host-backed type, the name in `@builtin("...")`.
    pub builtin: String?
    pub copy: bool
    ## Rust's `view` (a keyword here).
    pub view_: bool
    ## `@must_consume` (D-054).
    pub must_consume: bool
    ## The traits `@derive` and `@delegate` name: stage 0 declares their
    ## impls from templates, which stage 1 does not unfold.
    pub derives: list[String]
    ## The method of its `impl Drop`, which dropping a value runs.
    pub drop: DefId?

pub struct FieldInfo:
    pub name: String
    pub ty: Ty
    pub default: ExprId?
    ## The module whose syntax and file the default is in, when it is not
    ## the struct's: the text its unfolding made when it reflects
    ## (decision 251).
    pub default_module: ModuleId?
    pub span: TextRange
    pub vis: Vis
    ## Its `##` comment (RULES.md, R117).
    pub doc: String
    ## Its attributes, each name and its arguments' text, which reflection
    ## gives as `f.attributes` (RULES.md, R161); none in the standard
    ## library.
    pub attrs: list[(String, list[String])]

pub struct EnumInfo:
    pub generics: list[Generic]
    pub variants: list[VariantInfo]
    pub open: bool
    pub copy: bool
    pub must_consume: bool
    pub derives: list[String]
    ## The method of its `impl Drop`, which dropping a value runs.
    pub drop: DefId?

pub struct VariantInfo:
    pub name: String
    pub fields: list[(String?, Ty)]
    pub span: TextRange
    ## Each field's `##` comment, which reflection gives as `f.doc`
    ## (RULES.md, R129).
    pub docs: list[String]
    ## Its attributes, which reflection gives as `v.attributes` (RULES.md,
    ## R161).
    pub attrs: list[(String, list[String])]

@derive(Eq, Debug)
pub enum FnKind:
    Free
    Method
    Assoc
    Test(String)
    Drop
    ## The predicate of the refinement type, written by the compiler.
    Predicate(DefId)
    ## The check of the struct's `invariant` lines, written by the
    ## compiler.
    Invariant(DefId)

pub struct Generic:
    pub name: String
    ## `A: Allocator = Global`: the type a use site that omits it gets.
    pub default: Ty?
    pub is_const: bool

## What is in the way of a type's being `Send` or `Sync` (stage 0's
## `Obstacle`): the path to the part that is not (field names, tuple
## indices, `[]` for an element of a container) and that part's type.
pub struct Obstacle:
    pub path: list[String]
    pub ty: Ty

impl Obstacle:
    ## The obstacle as seen from what holds it under `step`.
    pub pure def under(own self, step: str) -> Obstacle:
        var path = [step.to_string()]
        for p in self.path:
            path.push(p.copy())
        return Obstacle(path=path, ty=self.ty)

pub struct ParamInfo:
    pub name: String
    pub mode: Mode
    pub ty: Ty
    pub default: ExprId?
    ## The module whose syntax and file the default is in, when it is not
    ## the function's: the text its unfolding made when it reflects
    ## (decision 251).
    pub default_module: ModuleId?
    pub span: TextRange

pub struct FnInfo:
    ## The impl's generic parameters first, then the function's own. For a
    ## trait's method, the impl's are `Self` and the trait's parameters.
    pub generics: list[Generic]
    pub impl_generics: int
    ## The bounds and `where` clauses in scope in the signature and body.
    pub predicates: list[Predicate]
    ## A method of a trait (its declaration, and its body when provided).
    pub trait_: DefId?
    ## A method of a trait impl.
    pub impl_: DefId?
    ## How `self` is passed, for a method.
    pub self_mode: Mode?
    ## The type a method or associated function belongs to.
    pub owner: Ty?
    pub params: list[ParamInfo]
    ## Parameters from this index on are keyword-only (after a bare `*`).
    pub keyword_only_from: int?
    ## Parameters before this index are positional-only (before a bare `/`).
    pub positional_only_until: int
    pub ret: Ty
    ## Where the result type is written.
    pub ret_span: TextRange?
    ## `T !`: the error set is inferred from the body.
    pub err_inferred: bool
    pub pure: bool
    ## Rust's `comptime` (a keyword here).
    pub comptime_: bool
    ## `unsafe def` (22): a call is an unsafe operation, permitted only in
    ## an `unsafe:` block or an `unsafe` expression.
    pub unsafe_: bool
    ## Declared in an `extern` block (22, "Foreign calls"): a call is an
    ## unsafe operation too, and lowers to the intrinsic
    ## `extern.LIBRARY.NAME` (`intrinsic`).
    pub foreign: bool
    ## The obligations the `Safety:` list of its doc comment names, which a
    ## caller's `# safety:` comment discharges; `None` without the list.
    pub obligations: list[String]?
    pub intrinsic: String?
    ## `@structural("name")`: the intrinsic that computes the function
    ## when every bound is met by a structural impl.
    pub structural: String?
    ## `@keeps(self, x)`: the positions among `self` and the parameters of
    ## the arguments whose every value the function keeps or returns.
    pub keeps: list[int]
    ## The `from` clause of the result: the parameters it borrows from,
    ## and where each is written.
    pub from_: list[String]
    pub from_spans: list[TextRange]
    pub internal: bool
    ## The body, in the AST of the module that declares it.
    pub body: Block?
    pub kind: FnKind
    ## The header has a syntax error: the result type is `Error`, calls are
    ## not checked against the parameters, and names the body cannot find
    ## are not reported.
    pub header_broken: bool
    ## The body has a syntax error.
    pub body_broken: bool
    ## The body begins with contracts (`requires`, `ensures`), which the
    ## checker of stage 1 does not check.
    pub contracts: bool
    ## A free generic function that reflects on its type parameters, or was
    ## promoted for calling one with them (08, "Reflection"): it is checked
    ## in its instances, not as written.
    pub template: bool
    ## The `T: type` parameters of a `comptime def` (08, "Reflection";
    ## decision 251): each one's position among the arguments a call writes
    ## and its name, and the generic parameter whose argument the call's
    ## argument, a type, is. They are not among `params`.
    pub type_params: list[(int, String, int)]
    ## `@deprecated("...")` (13, "Deprecation"; RULES.md, R30): the text it
    ## names the replacement with, empty when it names none.
    pub deprecated: String?
    ## The function that gives an associated constant of a trait or of its
    ## impl (03, "Traits"; RULES.md, R37): read as `T.NAME`, not called.
    pub assoc_const: bool

impl FnInfo:
    ## Whether this template is made once, for all its type arguments at
    ## once: one without type parameters (decision 244), or a method of a
    ## trait impl, whose instance is as generic as the template, so that a
    ## trait's call reaches it whatever the type arguments (decision 251).
    pub pure def made_once(self) -> bool:
        return self.template and (self.generics.is_empty() or self.impl_.is_some())

## A file an `embed("path")` call names, as the driver read it: its text,
## or why it could not be read (stage 0's `Result<String, String>`).
pub enum Embedded:
    Read(String)
    Failed(String)

## What the bodies ask of the next resolution (08, "Reflection"): an
## instance of a template for concrete type arguments, with where the
## program needs it (the module and range of the call), or the promotion
## of a generic function that calls one with its own type parameters
## (stage 0's `Request`).
pub enum Request:
    Instance(def_: DefId, args: list[Ty], site: (ModuleId, TextRange))
    Promote(DefId)

impl Request:
    ## Whether the two ask for the same thing (wherever they are asked).
    pub pure def same(self, other: Request) -> bool:
        match self:
            case Instance(a, x, _):
                if let Instance(b, y, _) = other:
                    return a == b and x == y
            case Promote(a):
                if let Promote(b) = other:
                    return a == b
        return False

pub struct ConstInfo:
    pub ty: Ty
    pub value: ExprId?
    ## The module whose syntax and file the value is in, when it is not the
    ## constant's: the text its unfolding made when it reflects (decision
    ## 251).
    pub value_module: ModuleId?
    ## The value as folding reads it (`typeck.folding`), empty without one.
    pub terms: list[Term]

pub struct ModuleData:
    ## The module's name in SIR: `main` for the root module, the import
    ## path for the program's other modules (`weather.parser`), the std
    ## module's name (`json`), or a generated module's (`<derive>/main.sisu`).
    pub name: String
    ## Names declared in or imported into the module.
    pub items: dict[String, DefId]
    ## Declarations in source order.
    pub order: list[DefId]
    ## Whether this is a standard-library module (intrinsics allowed).
    pub is_std: bool
    pub parent: ModuleId?
    ## The names an import bound here, with the import's visibility (a
    ## `pub` import re-exports).
    pub imported: dict[String, Vis]
    ## The child modules linked in the module by their names (09: a
    ## directory's files), which an import path goes through also when a
    ## declaration or an import of the module took the name (RULES.md,
    ## R74).
    pub children: dict[String, ModuleId]
    ## The package the module belongs to (an index of `Program.packages`):
    ## `ROOT_PACKAGE` for the program's own code, `STD_PACKAGE` for the
    ## standard library, and the others for the dependencies.
    pub package: int
    ## The path an import names the module by (`weather.parser`); empty for
    ## a module no import names.
    pub path: list[String]
    ## The name of the module's file, as diagnostics and SIR name it, for a
    ## module of a program of several modules (`src/geo/point.sisu`).
    pub file: String

impl ModuleData:
    pub pure def new(name: str, is_std: bool) -> ModuleData:
        var package = ROOT_PACKAGE
        if is_std:
            package = STD_PACKAGE
        return ModuleData(
            name=name.to_string(),
            items={},
            order=[],
            is_std=is_std,
            parent=None,
            imported={},
            children={},
            package=package,
            path=[],
            file=String.new(),
        )

## The program's own package: the one being built, which nothing depends
## on (the orphan rule's exception, D-013).
pub const ROOT_PACKAGE: int = 0
## The standard library, one package.
pub const STD_PACKAGE: int = 1

## A package of the program (09): the root package, the standard library,
## or a dependency.
pub struct PackageData:
    ## Its name as `sisu.toml` gives it (and imports name it); empty for a
    ## single file, which is a package of its own without a name.
    pub name: String
    ## `[trust] unsafe` lists it, or it is the root package or std.
    pub trusted: bool
    ## The packages its imports may name, by the names they are imported
    ## by: its own dependencies, as indices of `Program.packages`.
    pub deps: list[(String, int)]
    ## Its root module.
    pub root: ModuleId?
    ## The dependencies whose `when` excludes the target (RULES.md, R71).
    pub excluded: list[String]
    ## Its own dev-dependencies, which only its `@cfg(test)` imports name
    ## (RULES.md, R75).
    pub dev_only: list[String]

## Definitions of the prelude that the checker refers to by role.
pub struct WellKnown:
    pub option: DefId?
    pub result: DefId?
    pub ordering: DefId?
    pub string: DefId?
    pub list: DefId?
    pub dict: DefId?
    pub set: DefId?
    pub iter: DefId?
    pub iterable: DefId?
    pub range: DefId?
    pub boxed: DefId?
    pub display: DefId?
    pub debug: DefId?
    pub eq: DefId?
    pub partial_ord: DefId?
    pub ord: DefId?
    pub hash: DefId?
    pub len: DefId?
    pub contains: DefId?
    pub copy: DefId?
    pub drop: DefId?
    pub iterator: DefId?
    pub add: DefId?
    pub sub: DefId?
    pub mul: DefId?
    pub div: DefId?
    pub rem: DefId?
    pub neg: DefId?
    pub from_literal: DefId?
    pub send: DefId?
    pub sync: DefId?
    pub escapable: DefId?
    ## `Sized` (RULES.md, R153).
    pub sized: DefId?
    pub system: DefId?
    pub formatter: DefId?
    pub fs_ops: DefId?
    pub net_ops: DefId?
    pub clock_ops: DefId?
    pub rand_ops: DefId?
    pub env_ops: DefId?
    pub stdin_ops: DefId?
    pub proc_ops: DefId?

impl WellKnown:
    pub pure def none() -> WellKnown:
        return WellKnown(
            option=None,
            result=None,
            ordering=None,
            string=None,
            list=None,
            dict=None,
            set=None,
            iter=None,
            iterable=None,
            range=None,
            boxed=None,
            display=None,
            debug=None,
            eq=None,
            partial_ord=None,
            ord=None,
            hash=None,
            len=None,
            contains=None,
            copy=None,
            drop=None,
            iterator=None,
            add=None,
            sub=None,
            mul=None,
            div=None,
            rem=None,
            neg=None,
            from_literal=None,
            send=None,
            sync=None,
            escapable=None,
            sized=None,
            system=None,
            formatter=None,
            fs_ops=None,
            net_ops=None,
            clock_ops=None,
            rand_ops=None,
            env_ops=None,
            stdin_ops=None,
            proc_ops=None,
        )

## The traits `@derive` knows (stage 0's `derive::DERIVABLE`): every
## struct and enum has a derived `Debug` unless it has its own.
pub pure def derivable(name: str) -> bool:
    return match name:
        case "Debug" | "Eq" | "PartialOrd" | "Ord" | "Hash": True
        case _: False

## What makes a type implement a trait.
@derive(Eq)
pub enum ImplSource:
    ## An `impl`, with the impl's type arguments.
    Impl(def_: DefId, args: list[Ty])
    ## A bound in scope.
    Param
    ## `dyn Trait` implements its trait and the trait's supertraits.
    Dyn
    ## A rule of the language.
    Builtin

## The solver's answer.
@derive(Eq)
pub enum Answer:
    Yes(ImplSource)
    No
    ## The type still has inference variables that decide it, or (stage 1
    ## only) an impl stage 0 derives would decide it.
    Unknown

impl Answer:
    pub pure def holds(self) -> bool:
        return match self:
            case Yes(_): True
            case _: False

## The result of matching an impl header against a type.
@derive(Eq, Copy)
pub enum Match:
    Yes
    No
    Unknown

impl Match:
    pub pure def and(self, other: Match) -> Match:
        if self == Match.No or other == Match.No:
            return Match.No
        if self == Match.Unknown or other == Match.Unknown:
            return Match.Unknown
        return Match.Yes

## The auto traits (06, "Send, Sync, and shared state").
@derive(Eq, Copy)
pub enum Auto:
    Send
    Sync

pub struct Program:
    pub defs: list[Def]
    pub modules: list[ModuleData]
    pub root: ModuleId
    pub prelude: ModuleId
    pub wk: WellKnown
    ## Methods and associated functions by receiver type and name.
    pub methods: dict[(TyKey, String), DefId]
    ## Every variant by its unqualified name: (enum or error set, index).
    pub variants: dict[String, list[(DefId, int)]]
    ## Tests in declaration order.
    pub tests: list[DefId]
    ## The types and constants marked `@deprecated("...")` (13; RULES.md,
    ## R40), with the attribute's text, empty when it names no replacement;
    ## and the variants so marked, by their enum or error set and index.
    pub deprecated: dict[DefId, String]
    pub deprecated_variants: dict[(DefId, int), String]
    ## The fields marked `@deprecated("...")`, by their struct and index
    ## (RULES.md, R51).
    pub deprecated_fields: dict[(DefId, int), String]
    ## The functions, types and constants marked `@preview("...")` (13,
    ## D-072; RULES.md, R115), with the attribute's text.
    pub previews: dict[DefId, String]
    ## The functions marked `@fix_inline` (D-067; RULES.md, R177) whose
    ## body is one `return`, with the form of what it returns, which a
    ## call's warning offers in the call's place.
    pub fix_inline: dict[DefId, InlineForm]
    ## The types declared `@repr(c)`, which an exported function's
    ## signature may hold (12, "C interop"; RULES.md, R118).
    pub c_layout: set[DefId]
    ## The functions marked `@export("name")`, with the symbol, which
    ## lowering writes as the SIR's `export` lines and keeps as roots
    ## (decision 683; RULES.md, R120).
    pub exports: dict[DefId, String]
    ## The constants of a type the program gives a value folding computes,
    ## by the type and the name, for a type's constant argument written
    ## `Square.SIDES` (RULES.md, R50).
    pub const_args: dict[(DefId, String), Ty]
    ## The program is built with its tests (`sisu test`, `sir --tests`):
    ## an `expect` that fails records its failure and the test goes on
    ## (17; RULES.md, R38).
    pub with_tests: bool
    ## Each test's `@tag("...")`s, in the order written (decision 285).
    pub test_tags: dict[DefId, list[String]]
    ## Each test's fixtures, for `sir --tests --module-fixtures` (RULES.md,
    ## R219), in the order of its parameters.
    pub test_fixtures: dict[DefId, list[TestFixture]]
    ## The fixtures with `scope="module"` (RULES.md, R219), with their
    ## attribute's name, whose value the tests of a module share.
    pub module_fixtures: list[(DefId, TextRange)]
    ## The functions marked `@fixture` that `E0281` refuses, which a test
    ## that names one is not told again with `E0702` (RULES.md, R212).
    pub refused_fixtures: list[DefId]
    ## The functions marked `@no_alloc` (04, "Resource attributes"; RULES.md,
    ## R215), with the attribute's name, which lowering names for the
    ## ownership checker's pass over the call graph.
    pub no_alloc: list[(DefId, TextRange)]
    ## Benchmarks in declaration order.
    pub benches: list[DefId]
    ## Every trait impl, in declaration order.
    pub impls: list[DefId]
    ## The impls of each trait, in declaration order.
    pub impls_of: dict[DefId, list[DefId]]
    ## Names in top-level code of the root module that failed to parse.
    pub poisoned: set[String]
    ## The traits whose `comptime def derive` `E0607` refused, by name, and
    ## the types whose `@derive` names one: the one mistake is reported
    ## once, at the template (RULES.md, R144).
    pub refused_derives: set[String]
    pub refused_derived: set[DefId]
    ## Associated constants by type and name (`Money.ZERO`).
    pub assoc_consts: dict[(TyKey, String), DefId]
    ## The types written in `arbitrary[T]` and `exhaustive[T](...)`, by
    ## their text without whitespace: the generator the compiler writes
    ## for it, or `None` when it has none.
    pub generator_sites: dict[String, String?]
    ## Why a type written in `arbitrary[T]` has no generator, by the same
    ## key (stage 0's `Err` of `arbitrary_sites`).
    pub generator_failures: dict[String, String]
    ## The call that stands for each such site, by the site's module and
    ## expression.
    pub generator_calls: dict[(int, int), ExprId]
    ## For a site whose type is a bare name without a generator, `T` in
    ## `arbitrary[T]`: the call `Gen.of(d -> T.arbitrary(d))`, which stands
    ## for it where `T` is a type parameter bounded by `Arbitrary` (RULES.md,
    ## R107).
    pub generator_bounds: dict[(int, int), ExprId]
    ## The `@refines` attribute each test the compiler writes for one stands
    ## for, by the test's name: its module and range (RULES.md, R83).
    pub refines_at: dict[String, (ModuleId, TextRange)]
    ## The budget of steps of the `comptime` expressions of each item with
    ## `@comptime_budget(steps=N)` (08).
    pub comptime_budgets: dict[DefId, int]
    ## The files the root module's `embed("path")` calls name, as the
    ## driver read them, relative to the file.
    pub embedded: dict[String, Embedded]
    ## The fake the compiler wrote for each trait of the program's own.
    pub fakes: dict[DefId, DefId]
    ## Each instance of a template declared: the template, the type
    ## arguments and the instance.
    pub instances: list[(DefId, list[Ty], DefId)]
    ## Where the program needs each instance: the call that asked for it,
    ## or the one that asked for the instance it was asked from.
    pub instance_sites: dict[DefId, (ModuleId, TextRange)]
    ## When each definition was made, as stage 0 makes them (`Resolver.phase`):
    ## stage 0 declares every module's items before it resolves any, so a
    ## definition's place in its order is its phase and then its index.
    pub phases: list[int]
    ## The packages: the root package, std, then the dependencies.
    pub packages: list[PackageData]
    ## The modules of the program's own source (and the modules of its
    ## directories), the root module first.
    pub user_modules: list[ModuleId]
    ## The types with an `impl Drop`, by definition: no other type's value
    ## runs a `drop` of its own.
    pub drop_types: set[DefId]

impl Program:
    pub pure def new() -> Program:
        return Program(
            defs=[],
            modules=[],
            root=ModuleId(index=0),
            prelude=ModuleId(index=0),
            wk=WellKnown.none(),
            methods={},
            variants={},
            tests=[],
            deprecated={},
            deprecated_variants={},
            deprecated_fields={},
            previews={},
            fix_inline={},
            c_layout=set(),
            exports={},
            const_args={},
            with_tests=False,
            test_tags={},
            test_fixtures={},
            module_fixtures=[],
            refused_fixtures=[],
            no_alloc=[],
            benches=[],
            impls=[],
            impls_of={},
            poisoned=set(),
            refused_derives=set(),
            refused_derived=set(),
            assoc_consts={},
            generator_sites={},
            generator_failures={},
            generator_calls={},
            generator_bounds={},
            refines_at={},
            comptime_budgets={},
            embedded={},
            fakes={},
            instances=[],
            instance_sites={},
            phases=[],
            packages=[],
            user_modules=[],
            drop_types=set(),
        )

    pub pure def def(self, d: DefId) -> ref Def:
        return ref self.defs[d.index]

    pub pure def name(self, d: DefId) -> str from self:
        return self.defs[d.index].name

    pub pure def fn_info(self, d: DefId) -> ref FnInfo?:
        if let Fn(f) = self.defs[d.index].kind():
            return Some(f)
        return None

    pub pure def struct_info(self, d: DefId) -> ref StructInfo?:
        if let Struct(s) = self.defs[d.index].kind():
            return Some(s)
        return None

    pub pure def trait_info(self, d: DefId) -> ref TraitInfo?:
        if let Trait(t) = self.defs[d.index].kind():
            return Some(t)
        return None

    pub pure def impl_info(self, d: DefId) -> ref ImplInfo?:
        if let Impl(i) = self.defs[d.index].kind():
            return Some(i)
        return None

    pub pure def enum_info(self, d: DefId) -> ref EnumInfo?:
        match self.defs[d.index].kind():
            case Enum(e):
                return Some(e)
            case ErrorSet(e):
                return Some(e)
            case _:
                return None

    pub pure def is_error_set(self, d: DefId) -> bool:
        if let ErrorSet(_) = self.defs[d.index].kind():
            return True
        return False

    pub pure def is_fn(self, d: DefId) -> bool:
        if let Fn(_) = self.defs[d.index].kind():
            return True
        return False

    pub pure def builtin(self, d: DefId) -> String?:
        if let Some(s) = self.struct_info(d):
            return s.builtin.copy()
        return None

    pub pure def is_builtin(self, d: DefId, name: str) -> bool:
        if let Some(s) = self.struct_info(d):
            if let Some(b) = s.builtin:
                return b == name
        return False

    ## Whether `d` is `std.mem`'s raw pointer `name` (`ptr` or `ptr_mut`),
    ## by name, which is known before the type's `@builtin` is read.
    pub pure def is_raw_pointer(self, d: DefId, name: str) -> bool:
        let def_ = ref self.defs[d.index]
        let module = ref self.modules[def_.module.index]
        return def_.name == name and module.is_std and module.name == "mem"

    ## The type `ptr mut T` names, when `ptr` names `d` (22): the raw
    ## pointer through which `T` may be written, `ptr_mut`, which `std.mem`
    ## declares beside its `ptr`. (By name: a module's types are known
    ## before their `@builtin` is read.)
    pub pure def ptr_mut_of(self, d: DefId) -> DefId?:
        let def_ = ref self.defs[d.index]
        let module = ref self.modules[def_.module.index]
        if def_.name != "ptr" or not module.is_std or module.name != "mem":
            return None
        return module.items.get("ptr_mut".to_string()).copied()

    ## The generic parameters of a struct, enum or refinement type.
    pub pure def type_generics(self, d: DefId) -> list[Generic]:
        match self.defs[d.index].kind():
            case Struct(s):
                return s.generics.copy()
            case Enum(e):
                return e.generics.copy()
            case ErrorSet(e):
                return e.generics.copy()
            case Refinement(r):
                return r.generics.copy()
            case _:
                return []

    ## The base of a refinement type with its arguments in it.
    pub pure def refinement_base(self, mut types: Types, d: DefId, args: list[Ty]) -> Ty?:
        if let Refinement(r) = self.defs[d.index].kind():
            return Some(types.subst(r.base, args))
        return None

    pub pure def refinement(self, d: DefId) -> ref RefinementInfo?:
        if let Refinement(r) = self.defs[d.index].kind():
            return Some(r)
        return None

    ## The type with every refinement replaced by its base, at the top
    ## only (`Port` is `int`; `list[Port]` stays as it is).
    pub pure def unrefine(self, mut types: Types, ty: Ty) -> Ty:
        var t = ty
        for _ in range(16):
            let TyData.Adt(d, args) = types.data(t).copy() else:
                return t
            let b = self.refinement_base(mut types, d, args) else:
                return t
            t = b
        return t

    ## The type with every refinement in it replaced by its base, at any
    ## depth (`list[Port]` is `list[int]`).
    pub pure def erase_refinements(self, mut types: Types, ty: Ty) -> Ty:
        var has = False
        for t in types.walk(ty):
            if let TyData.Adt(d, _) = types.data(t):
                if self.refinement(d).is_some():
                    has = True
        if not has:
            return ty
        return self.erase_depth(mut types, ty, 0)

    pure def erase_depth(self, mut types: Types, ty: Ty, depth: int) -> Ty:
        if depth > 32:
            return ty
        match types.data(ty).copy():
            case TyData.Adt(d, a):
                var args: list[Ty] = []
                for x in a:
                    args.push(self.erase_depth(mut types, x, depth + 1))
                if let Some(b) = self.refinement_base(mut types, d, args):
                    return self.erase_depth(mut types, b, depth + 1)
                return types.adt(d, args)
            case TyData.Tuple(es, l):
                var out: list[Ty] = []
                for x in es:
                    out.push(self.erase_depth(mut types, x, depth + 1))
                return types.intern(TyData.Tuple(elems=out, labels=l))
            case TyData.Fn(ps, r, pure):
                var out: list[Ty] = []
                for x in ps:
                    out.push(self.erase_depth(mut types, x, depth + 1))
                let ret = self.erase_depth(mut types, r, depth + 1)
                return types.fn_(out, ret, pure)
            case TyData.Ref(inner, m):
                let i = self.erase_depth(mut types, inner, depth + 1)
                return types.ref_(i, m)
            case TyData.Dyn(tr):
                var out: list[Ty] = []
                for x in tr.args:
                    out.push(self.erase_depth(mut types, x, depth + 1))
                return types.intern(TyData.Dyn(TraitRef(def_=tr.def_, args=out)))
            case TyData.Assoc(s, tr, name):
                let st = self.erase_depth(mut types, s, depth + 1)
                var out: list[Ty] = []
                for x in tr.args:
                    out.push(self.erase_depth(mut types, x, depth + 1))
                let t = TraitRef(def_=tr.def_, args=out)
                return types.intern(TyData.Assoc(self_ty=st, trait_=t, name=name))
            case _:
                return ty

    ## The check of a struct's invariant, `T.__check_invariant`, when the
    ## struct has `invariant` lines.
    pub pure def invariant_check(self, d: DefId) -> DefId?:
        let m = self.method(TyKey.Adt(d), "__check_invariant") else:
            return None
        let f = self.fn_info(m) else:
            return None
        if let FnKind.Invariant(_) = f.kind:
            return Some(m)
        return None

    ## The operations trait of a capability handle type (`Fs`: `FsOps`).
    pub pure def capability_ops(self, d: DefId) -> DefId?:
        let b = self.builtin(d) else:
            return None
        let wk = ref self.wk
        let bs: str = b
        return match bs:
            case "Fs": wk.fs_ops
            case "Net": wk.net_ops
            case "Clock": wk.clock_ops
            case "Rand": wk.rand_ops
            case "Env": wk.env_ops
            case "Proc": wk.proc_ops
            case "Stdin": wk.stdin_ops
            case _: None

    ## Associated constant `name` of the type with key `k`.
    pub pure def assoc_const(self, k: TyKey, name: str) -> DefId?:
        if let Some(d) = self.assoc_consts.get((k, name.to_string())):
            return Some(d)
        return None

    # ---------------------------------------------------------------- visibility

    ## The module whose names `module` sees: itself, or for a module of
    ## derived impls, the module of the types.
    pub pure def scope_module(self, module: ModuleId) -> ModuleId:
        if module.index < len(self.modules):
            if let Some(p) = self.modules[module.index].parent:
                return p
        return module

    ## Whether code in `from` may name `def_`, an item of another module
    ## (09, "Modules"): items are private to their module unless `pub`. A
    ## module is always reachable by its path, and the standard library's
    ## items are all public in stage 0.
    pub pure def visible_from(self, def_: DefId, from_: ModuleId) -> bool:
        let d = ref self.defs[def_.index]
        if let Module(_) = d.kind():
            return True
        return self.vis_allows(d.vis, d.module, from_)

    ## Whether an item of `owner` with visibility `vis` may be named from
    ## `from`: `pub(package)` reaches the modules of the same package.
    pub pure def vis_allows(self, vis: Vis, owner_in: ModuleId, from_in: ModuleId) -> bool:
        let owner = self.scope_module(owner_in)
        let seen_from = self.scope_module(from_in)
        if owner == seen_from:
            return True
        if owner.index >= len(self.modules) or seen_from.index >= len(self.modules):
            return True
        if self.modules[owner.index].is_std or self.modules[seen_from.index].is_std:
            return True
        return match vis:
            case Vis.Pub: True
            case Vis.PubPackage: self.package_of(owner) == self.package_of(seen_from)
            case Vis.Private: False

    ## The package a module belongs to, for the orphan rule (03,
    ## "Coherence") and `pub(package)`.
    pub pure def package_of(self, m: ModuleId) -> int:
        if m.index >= len(self.modules):
            return ROOT_PACKAGE
        if self.modules[m.index].is_std:
            return STD_PACKAGE
        return self.modules[m.index].package

    ## The diagnostic of an item `d` of another module that code sees
    ## through `m` but may not name (stage 0's `private_item`): an import
    ## that is not re-exported, a `pub(package)` item of another package,
    ## or a private one.
    pub pure def private_item(self, d: DefId, m: ModuleId, range: TextRange) -> Diagnostic:
        let def_ = ref self.defs[d.index]
        let name = def_.name.copy()
        let data = ref self.modules[m.index]
        let imported = data.imported.contains(name.copy())
        if imported or self.scope_module(def_.module) != self.scope_module(m):
            # Seen through a module that imported it.
            var same = False
            if let Some(x) = data.items.get(name.copy()):
                same = x == d
            if same and imported:
                var diag = Diagnostic.new(Msg.ResolveNotReexported, range.start, range.end)
                diag = diag.with("name", name).with("module", self.module_path(m))
                return diag.with("origin", self.module_path(def_.module))
        let owner = def_.module
        if def_.vis == Vis.PubPackage:
            let package = self.package_of(owner)
            var pname = String.new()
            if package >= 0 and package < len(self.packages):
                pname = self.packages[package].name.copy()
            var diag = Diagnostic.new(Msg.ResolvePackageItem, range.start, range.end)
            diag = diag.with("name", name).with("module", self.module_path(owner))
            return diag.with("package", pname)
        let diag = Diagnostic.new(Msg.ResolvePrivateItem, range.start, range.end).with("name", name)
        return diag.with("module", self.module_path(owner))

    ## The module's path as an import writes it, for messages: `std.json`
    ## for a std module, `weather.parser` for a module of a package.
    pub pure def module_path(self, m: ModuleId) -> String:
        if m.index < 0 or m.index >= len(self.modules):
            return String.new()
        let data = ref self.modules[m.index]
        if not data.path.is_empty():
            return data.path.join(".")
        return data.name.copy()

    ## `name` in module `m` as code in `from` sees it through the module
    ## (`m.name`, `from m import name`): the item, and whether `from` may
    ## name it there. A name an import bound in `m` is seen only when the
    ## import is `pub` (a re-export).
    pub pure def member(self, m: ModuleId, name: str, from_: ModuleId) -> (DefId, bool)?:
        if m.index >= len(self.modules):
            return None
        let data = ref self.modules[m.index]
        var found: DefId? = None
        if let Some(x) = data.items.get(name.to_string()):
            found = Some(x)
        let d = found else:
            return None
        if let Some(vis) = data.imported.get(name.to_string()):
            return Some((d, self.vis_allows(vis, m, from_)))
        return Some((d, self.visible_from(d, from_)))

    # ---------------------------------------------------------------- views and auto traits

    ## Whether a value of the type can hold a loan at all: a view, and also
    ## a function value (a closure borrows its captures) and an iterator or
    ## dict entry (they borrow what they walk). A generic parameter can,
    ## since it may stand for any of these.
    pub pure def can_borrow(self, mut types: Types, ty: Ty) -> bool:
        return self.can_borrow_in(mut types, ty, [])

    ## `can_borrow` in an environment of bounds: a type parameter bounded by
    ## `Escapable` holds no loan, since every type argument it stands for
    ## must not (decision 257), and neither does one bounded by `Send`,
    ## which asks the same of its arguments (RULES.md, R1). A half of a
    ## channel of closures holds none: each closure sent on it owns what it
    ## captures, checked where it is sent.
    pub pure def can_borrow_in(self, mut types: Types, ty: Ty, env: list[Predicate]) -> bool:
        let data = types.data(ty).copy()
        if let TyData.Adt(d, args) = data:
            if let Some(b) = self.refinement_base(mut types, d, args):
                return self.can_borrow_in(mut types, b, env)
        match data:
            case TyData.Param(_):
                for p in env:
                    if p.ty == ty and p.bound.args.is_empty():
                        let b = Some(p.bound.def_)
                        if b == self.wk.escapable or b == self.wk.send:
                            return False
                return True
            case TyData.Ref(_, _) | TyData.Str | TyData.Fn(_, _, _) | TyData.Var(_) | TyData.Error:
                return True
            case TyData.Tuple(es, _):
                for t in es:
                    if self.can_borrow_in(mut types, t, env):
                        return True
                return False
            case TyData.Adt(d, args):
                match self.defs[d.index].kind():
                    case Struct(s):
                        if let Some(b) = s.builtin:
                            let bs: str = b
                            match bs:
                                case "Iter" | "Entry" | "Iterable" | "MutexGuard" | "ReadGuard" | "Lent" | "Slice":
                                    return True
                                case "Sender" | "Receiver":
                                    if carries_closures(types, args):
                                        return False
                                case _:
                                    pass
                        elif s.view_:
                            return True
                        for t in args:
                            if self.can_borrow_in(mut types, t, env):
                                return True
                        return False
                    case Enum(_):
                        for t in args:
                            if self.can_borrow_in(mut types, t, env):
                                return True
                        return False
                    case _:
                        return False
            case _:
                return False

    ## The collection `d` is, by the name a message gives it: `list`, `set`,
    ## `dict` and `Array` of the prelude, and `Deque`, `Heap`, `SortedDict`
    ## and `SortedSet` of `std.collections` (11). Its items are values it
    ## owns, or views, and never references (04, rule 3; RULES.md, R21).
    pub pure def collection_name(self, d: DefId) -> String?:
        if d.index < 0 or d.index >= len(self.defs):
            return None
        if let Some(b) = self.builtin(d):
            if b == "list" or b == "set" or b == "dict" or b == "Array":
                return Some(b)
            return None
        let item = ref self.defs[d.index]
        if item.module.index < 0 or item.module.index >= len(self.modules):
            return None
        let m = ref self.modules[item.module.index]
        if not m.is_std or m.name != "collections":
            return None
        let n: str = item.name
        if n == "Deque" or n == "Heap" or n == "SortedDict" or n == "SortedSet":
            return Some(n.to_string())
        return None

    ## Why a trait cannot be `dyn`, if it cannot (03, "Dispatch": "the
    ## compiler says why when it is not"): the method, and the reason. A
    ## method without `self` by reference, with type parameters of its own,
    ## or mentioning `Self` besides its receiver cannot be called through a
    ## `dyn`, which does not know the type behind it.
    pub pure def object_safety_problem(self, mut types: Types, t: DefId) -> (String, String)?:
        let p0 = types.param(0)
        for tr in self.elaborate(mut types, p0, TraitRef(def_=t, args=[])):
            let info = self.trait_info(tr.def_) else:
                continue
            for m in info.methods.copy():
                let f = self.fn_info(m) else:
                    continue
                let name = self.defs[m.index].name.copy()
                # A constant is each type's, and a `dyn` value does not say
                # which type it is (RULES.md, R37).
                if f.assoc_const:
                    let why = "it is a constant, which each implementing type gives, and a `dyn` value does not say which type it is"
                    return Some((name, why.to_string()))
                match f.self_mode:
                    case Some(Mode.Borrow) | Some(Mode.Mut):
                        pass
                    case _:
                        return Some((name, "it does not take `self` or `mut self`".to_string()))
                if len(f.generics) > f.impl_generics:
                    return Some((name, "it has type parameters of its own".to_string()))
                var mentions = False
                for p in f.params:
                    if types.walk(p.ty).contains(p0):
                        mentions = True
                if mentions or types.walk(f.ret).contains(p0):
                    return Some((name, "its signature mentions `Self` besides `self`".to_string()))
        return None

    ## The first collection in `ty` (`ty` itself, or a type inside it) whose
    ## items are references (RULES.md, R21), with the reference. A shared
    ## borrow of a `str` is the `str`, a view, as a declaration's type reads
    ## it.
    pub pure def ref_items(self, types: Types, ty: Ty) -> (Ty, Ty)?:
        for t in types.walk(ty):
            if let TyData.Adt(d, args) = types.data(t):
                if self.collection_name(d).is_some():
                    for a in args:
                        if is_ref_item(types, a):
                            return Some((t, a))
        return None

    ## `@must_consume` (D-054), through containers, options and tuples
    ## (D-064): a type is must-consume when it is declared so or holds one,
    ## in a field or a type argument.
    ##
    ## The walk is stage 0's, to the same depth; a type already found to
    ## hold none from a depth no deeper is not walked again, which gives
    ## the same answer without the exponential cost of a type whose fields
    ## nest (decision 180).
    pub pure def must_consume_ty(self, mut types: Types, t: Ty, depth: int) -> bool:
        var cleared: dict[Ty, int] = {}
        return self.must_consume_from(mut types, t, depth, mut cleared)

    pure def must_consume_from(
        self, mut types: Types, t: Ty, depth: int, mut cleared: dict[Ty, int]
    ) -> bool:
        if depth > 16:
            return False
        if let Some(at) = cleared.get(t):
            if at <= depth:
                return False
        let found = self.must_consume_walk(mut types, t, depth, mut cleared)
        if not found:
            _ = cleared.insert(t, depth)
        return found

    pure def must_consume_walk(
        self, mut types: Types, t: Ty, depth: int, mut cleared: dict[Ty, int]
    ) -> bool:
        match types.data(t).copy():
            case TyData.Tuple(es, _):
                for e in es:
                    if self.must_consume_from(mut types, e, depth + 1, mut cleared):
                        return True
                return False
            case TyData.Adt(d, args):
                if let Refinement(_) = self.defs[d.index].kind():
                    let base = self.refinement_base(mut types, d, args) ?? Ty.error()
                    return self.must_consume_from(mut types, base, depth + 1, mut cleared)
                var flag = False
                var fields: list[Ty] = []
                match self.defs[d.index].kind():
                    case Struct(s):
                        flag = s.must_consume
                        for f in s.fields:
                            fields.push(f.ty)
                    case Enum(e):
                        flag = e.must_consume
                        for v in e.variants:
                            for (_, ft) in v.fields:
                                fields.push(ft)
                    case ErrorSet(e):
                        flag = e.must_consume
                        for v in e.variants:
                            for (_, ft) in v.fields:
                                fields.push(ft)
                    case _:
                        pass
                if flag:
                    return True
                for a in args:
                    if self.must_consume_from(mut types, a, depth + 1, mut cleared):
                        return True
                for f in fields:
                    let ft = types.subst(f, args)
                    if self.must_consume_from(mut types, ft, depth + 1, mut cleared):
                        return True
                return False
            case _:
                return False

    ## Whether the type is `Send` (or `Sync`) by the structural rule (06):
    ## stage 0's `auto_trait`, without the part of the type in the way.
    pub pure def auto_trait(
        self, mut types: Types, ty: Ty, auto: Auto, env: list[Predicate]
    ) -> bool:
        return self.auto_obstacle(mut types, ty, auto, env).is_none()

    ## What is in the way of the type's being `Send` or `Sync`, if
    ## anything (stage 0's `auto_trait`).
    pub pure def auto_obstacle(
        self, mut types: Types, ty: Ty, auto: Auto, env: list[Predicate]
    ) -> Obstacle?:
        var seen: list[(DefId, list[Ty], Auto)] = []
        return self.auto_depth(mut types, ty, auto, env, mut seen, 0)

    pure def auto_bound(self, auto: Auto) -> DefId?:
        return match auto:
            case Auto.Send: self.wk.send
            case Auto.Sync: self.wk.sync

    pure def auto_depth(
        self,
        mut types: Types,
        ty: Ty,
        auto: Auto,
        env: list[Predicate],
        mut seen: list[(DefId, list[Ty], Auto)],
        depth: int,
    ) -> Obstacle?:
        if depth > 64:
            return None
        let no = Some(Obstacle(path=[], ty=ty))
        match types.data(ty).copy():
            case TyData.Int | TyData.Float | TyData.Bool | TyData.Char | TyData.Str | TyData.Unit:
                return None
            case TyData.Never | TyData.Error | TyData.Const(_) | TyData.ConstOp(_, _) | TyData.Var(
                _
            ):
                return None
            case TyData.Ref(inner, mutable):
                let need = if mutable and auto == Auto.Send: Auto.Send else: Auto.Sync
                return self.auto_depth(mut types, inner, need, env, mut seen, depth + 1)
            case TyData.Tuple(es, _):
                for i in range(len(es)):
                    if let Some(o) = self.auto_depth(
                        mut types, es[i], auto, env, mut seen, depth + 1
                    ):
                        return Some(o.under("{i}"))
                return None
            case TyData.Fn(_, _, _):
                return no
            case TyData.Dyn(tr):
                let want = self.auto_bound(auto)
                for t in self.elaborate(mut types, ty, tr):
                    if Some(t.def_) == want:
                        return None
                return no
            case TyData.Param(_) | TyData.Assoc(_, _, _):
                let want = self.auto_bound(auto)
                for p in env:
                    if p.ty == ty and Some(p.bound.def_) == want:
                        return None
                return no
            case TyData.ErrSet(members):
                for d in members:
                    if let Some(o) = self.adt_auto(mut types, d, [], auto, env, mut seen, depth):
                        return Some(o)
                return None
            case TyData.Adt(d, args):
                let arg0 = args.first() ?? Ty.error()
                let b = self.builtin(d) else:
                    return self.adt_auto(mut types, d, args, auto, env, mut seen, depth)
                let bs: str = b
                var found: Obstacle? = None
                match bs:
                    # A raw pointer is neither (22, "Auto traits"), so that
                    # a type holding one is not made thread-safe by
                    # inference; `unsafe impl` asserts them.
                    case "ptr" | "ptr_mut":
                        return no
                    case "Cell":
                        if auto == Auto.Sync:
                            return no
                        found = self.auto_depth(
                            mut types, arg0, Auto.Send, env, mut seen, depth + 1
                        )
                    # A channel of closures is both: each closure sent on
                    # it was checked where it was sent (RULES.md, R1).
                    case "Sender" | "Receiver":
                        if carries_closures(types, args):
                            return None
                        found = self.auto_depth(
                            mut types, arg0, Auto.Send, env, mut seen, depth + 1
                        )
                    case "Mutex" | "Atomic" | "Handle":
                        found = self.auto_depth(
                            mut types, arg0, Auto.Send, env, mut seen, depth + 1
                        )
                    # Readers share the value: `Sync` asks it to be `Sync`
                    # too.
                    case "RwLock":
                        found = self.auto_depth(
                            mut types, arg0, Auto.Send, env, mut seen, depth + 1
                        )
                        if found.is_none() and auto == Auto.Sync:
                            found = self.auto_depth(
                                mut types, arg0, Auto.Sync, env, mut seen, depth + 1
                            )
                    case "MutexGuard" | "ReadGuard":
                        if auto == Auto.Send:
                            return no
                        found = self.auto_depth(
                            mut types, arg0, Auto.Sync, env, mut seen, depth + 1
                        )
                    # A `Cap` is shared by its copies, a `Lent` is a view of
                    # a capability: both are references in effect.
                    case "Shared" | "Weak" | "Cap" | "Lent" | "Slice":
                        found = self.auto_depth(
                            mut types, arg0, Auto.Sync, env, mut seen, depth + 1
                        )
                    case _:
                        for a in args:
                            if found.is_none():
                                found = self.auto_depth(
                                    mut types, a, auto, env, mut seen, depth + 1
                                )
                # What an element is in the way of is under `[]`.
                let o = found else:
                    return None
                return Some(o.under("[]"))

    ## What an `unsafe impl` of `Send` or `Sync` for `d` says of `d[args]`:
    ## `Some(None)` when an impl's header matches and its bounds hold,
    ## `Some(obstacle)` when one matches and a bound does not (the type it
    ## bounds), `None` when no impl asserts the trait for the type.
    pure def asserted_auto(
        self,
        mut types: Types,
        d: DefId,
        args: list[Ty],
        auto: Auto,
        env: list[Predicate],
        mut seen: list[(DefId, list[Ty], Auto)],
        depth: int,
    ) -> Option[Obstacle?]:
        let want = self.auto_bound(auto) else:
            return None
        let candidates = self.impls_of.get(want) else:
            return None
        let ty = types.adt(d, args.copy())
        for i in candidates:
            let info = self.impl_info(i) else:
                continue
            if not info.unsafe_:
                continue
            var binds: list[Ty?] = []
            for _ in range(len(info.generics)):
                binds.push(None)
            if match_ty(types, info.self_ty, ty, mut binds) != Match.Yes:
                continue
            var bound_args: list[Ty] = []
            for b in binds:
                bound_args.push(b.copy() ?? Ty.error())
            for p in info.predicates:
                let pt = types.subst(p.ty, bound_args)
                let pb = types.subst_trait(p.bound, bound_args)
                if Some(pb.def_) == self.wk.send or Some(pb.def_) == self.wk.sync:
                    let pa = if Some(pb.def_) == self.wk.send: Auto.Send else: Auto.Sync
                    if let Some(o) = self.auto_depth(mut types, pt, pa, env, mut seen, depth + 1):
                        return Some(Some(o))
                else:
                    match self.implements(mut types, pt, pb, env):
                        case Yes(_):
                            pass
                        case _:
                            return Some(Some(Obstacle(path=[], ty=pt)))
            return Some(None)
        return None

    ## A declared struct, enum or error set: every field, with the type's
    ## arguments in it. A type met again on the way is assumed to hold
    ## (coinduction, as for Rust's auto traits).
    pure def adt_auto(
        self,
        mut types: Types,
        d: DefId,
        args: list[Ty],
        auto: Auto,
        env: list[Predicate],
        mut seen: list[(DefId, list[Ty], Auto)],
        depth: int,
    ) -> Obstacle?:
        if let Some(base) = self.refinement_base(mut types, d, args):
            return self.auto_depth(mut types, base, auto, env, mut seen, depth + 1)
        for (sd, sargs, sa) in seen:
            if sd == d and sargs == args and sa == auto:
                return None
        seen.push((d, args.copy(), auto))
        # An `unsafe impl Send` or `Sync` of the type asserts it, for the
        # arguments its bounds admit (22, "Auto traits"): what is in the way
        # is then an argument that does not meet them.
        if let Some(asserted) = self.asserted_auto(mut types, d, args, auto, env, mut seen, depth):
            return asserted
        var fields: list[(String, Ty)] = []
        match self.defs[d.index].kind():
            case Struct(s):
                for f in s.fields:
                    fields.push((f.name.copy(), f.ty))
            case Enum(e) | ErrorSet(e):
                for v in e.variants:
                    for i in range(len(v.fields)):
                        let (n, t) = v.fields[i].copy()
                        match n:
                            case Some(name):
                                fields.push(("{v.name}.{name}", t))
                            case None:
                                fields.push(("{v.name}.{i}", t))
            case _:
                pass
        for (name, f) in fields:
            let t = types.subst(f, args)
            if let Some(o) = self.auto_depth(mut types, t, auto, env, mut seen, depth + 1):
                return Some(o.under(name))
        return None

    ## Whether dropping a value of the type may run a `drop` that is not
    ## `pure`: the type's own `Drop`, or that of a part it owns (a field, a
    ## type argument), which stage 0's ownership checker holds a pure
    ## function to (E0393). Each type is looked at once, as decision 180
    ## has stage 0 look at the parts of a type: a type with several fields
    ## of recursive types made the walk exponential.
    pub pure def drops_impure(self, mut types: Types, ty: Ty, depth: int) -> bool:
        var seen: set[Ty] = set()
        return self.drops_impure_in(mut types, ty, mut seen)

    ## `drops_impure` for one of several types whose answer is wanted
    ## together: what `seen` holds was walked already.
    pub pure def drops_impure_in(self, mut types: Types, ty: Ty, mut seen: set[Ty]) -> bool:
        if seen.contains(ty):
            return False
        _ = seen.add(ty)
        match types.data(ty).copy():
            case TyData.Tuple(es, _):
                for e in es:
                    if self.drops_impure_in(mut types, e, mut seen):
                        return True
                return False
            case TyData.Adt(d, args):
                if let Some(base) = self.refinement_base(mut types, d, args):
                    return self.drops_impure_in(mut types, base, mut seen)
                var drop_trait = self.wk.drop
                if not self.drop_types.contains(d):
                    drop_trait = None
                if let Some(drop) = drop_trait:
                    let tr = TraitRef(def_=drop, args=[])
                    if let Some((i, _)) = self.find_impl(mut types, ty, tr, []):
                        if let Some(info) = self.impl_info(i):
                            for (n, m) in info.methods:
                                if n == "drop":
                                    if let Some(f) = self.fn_info(m):
                                        if not f.pure:
                                            return True
                for a in args:
                    if self.drops_impure_in(mut types, a, mut seen):
                        return True
                var fields: list[Ty] = []
                match self.defs[d.index].kind():
                    case Struct(s):
                        for f in s.fields:
                            fields.push(f.ty)
                    case Enum(e):
                        for v in e.variants:
                            for (_, t) in v.fields:
                                fields.push(t)
                    case _:
                        pass
                for f in fields:
                    let t = types.subst(f, args)
                    if self.drops_impure_in(mut types, t, mut seen):
                        return True
                return False
            case _:
                return False

    ## Whether `ty` implements the trait `tr` (one of `Display`, `Debug`,
    ## `Eq`, `PartialOrd`, `Ord`, `Hash`) structurally, the way the
    ## interpreter compares, orders, hashes and prints values: by the
    ## language's rules, the standard library's impls and derived impls,
    ## all the way down.
    pub pure def is_structural(self, mut types: Types, ty: Ty, tr: DefId) -> bool:
        return self.structural_depth(mut types, ty, tr, 0)

    pure def structural_depth(self, mut types: Types, ty: Ty, tr: DefId, depth: int) -> bool:
        if depth > 16:
            return False
        match types.data(ty).copy():
            case TyData.Int | TyData.Float | TyData.Bool | TyData.Char | TyData.Str | TyData.Unit:
                return True
            case TyData.Never | TyData.Error | TyData.Const(_) | TyData.ConstOp(_, _):
                return True
            case TyData.ErrSet(_):
                return True
            case TyData.Ref(t, _):
                return self.structural_depth(mut types, t, tr, depth + 1)
            case TyData.Tuple(es, _):
                for e in es:
                    if not self.structural_depth(mut types, e, tr, depth + 1):
                        return False
                return True
            case TyData.Fn(_, _, _):
                return Some(tr) == self.wk.debug
            case TyData.Adt(d, args):
                let tref = TraitRef(def_=tr, args=[])
                let found_impl = self.find_impl(mut types, ty, tref, []) else:
                    return False
                let (imp, iargs) = found_impl
                let info = self.impl_info(imp) else:
                    return False
                let module = ref self.modules[self.defs[imp.index].module.index]
                if info.derived:
                    # The derived impl compares or prints the fields.
                    var fields: list[Ty] = []
                    match self.defs[d.index].kind():
                        case Struct(s):
                            for f in s.fields:
                                fields.push(types.subst(f.ty, args))
                        case Enum(e):
                            for v in e.variants:
                                for (_, t) in v.fields:
                                    fields.push(types.subst(t, args))
                        case _:
                            pass
                    # What the derived impl reads is its fields, the type's
                    # arguments only where a field holds them: `Key[T]`'s `T`
                    # is in none (RULES.md, R25).
                    for f in fields:
                        if not self.structural_depth(mut types, f, tr, depth + 1):
                            return False
                    _ = iargs
                    return True
                let name: str = self.defs[d.index].name
                let core = name == "Option"
                    or name == "Result"
                    or name == "Ordering"
                    or name == "Box"
                var host = False
                if let Some(b) = self.builtin(d):
                    host = b != "Atomic"
                if module.is_std and (host or core):
                    # std's impls of the host-backed types and the core
                    # enums render as the host does; another std type's own
                    # impl (`Duration`'s `Display`, `Atomic`'s `Debug`,
                    # which the host would show as the `Cell` it is) is its
                    # own.
                    for a in args:
                        if not self.structural_depth(mut types, a, tr, depth + 1):
                            return False
                    return True
                return False
            case _:
                return False

    ## Looks a name up in a module (and the module it derives for), then in
    ## the prelude.
    pub pure def lookup(self, module: ModuleId, name: str) -> DefId?:
        var m: ModuleId? = Some(module)
        while let Some(id) = m:
            if id.index >= len(self.modules):
                return None
            let data = ref self.modules[id.index]
            if let Some(d) = data.items.get(name.to_string()):
                return Some(d)
            m = data.parent
        return self.lookup_in(self.prelude, name)

    ## Looks a name up in one module only.
    pub pure def lookup_in(self, module: ModuleId, name: str) -> DefId?:
        if module.index >= len(self.modules):
            return None
        if let Some(d) = self.modules[module.index].items.get(name.to_string()):
            return Some(d)
        return None

    pub pure def method(self, key: TyKey, name: str) -> DefId?:
        if let Some(d) = self.methods.get((key, name.to_string())):
            return Some(d)
        return None

    ## The function `main` of the root module.
    pub pure def main(self) -> DefId?:
        let d = self.lookup_in(self.root, "main") else:
            return None
        if not self.is_fn(d):
            return None
        return Some(d)

    # ---------------------------------------------------------------- display

    ## The canonical spelling of a type, as the formatter would write it
    ## (`T?`, `T ! E`), used in diagnostics.
    pub pure def display(self, types: Types, ty: Ty) -> String:
        return self.display_in(types, ty, [])

    ## A trait with its arguments: `Add[int]`.
    pub pure def display_trait_in(self, types: Types, tr: TraitRef, names: list[String]) -> String:
        let name = self.qualified_name(tr.def_)
        if tr.args.is_empty():
            return name
        return "{name}[{self.joined(types, tr.args, names)}]"

    ## The spellings of types, joined by `, `.
    pure def joined(self, types: Types, tys: list[Ty], names: list[String]) -> String:
        var out = String.new()
        for t in tys:
            if not out.is_empty():
                out.push(", ")
            out.push(self.display_in(types, t, names))
        return out

    ## The spelling of a type whose generic parameters are named `names`.
    pub pure def display_in(self, types: Types, ty: Ty, names: list[String]) -> String:
        match types.data(ty):
            case TyData.Int:
                return "int".to_string()
            case TyData.Float:
                return "f64".to_string()
            case TyData.Bool:
                return "bool".to_string()
            case TyData.Char:
                return "char".to_string()
            case TyData.Str:
                return "str".to_string()
            case TyData.Unit:
                return "()".to_string()
            case TyData.Never:
                return "Never".to_string()
            case TyData.Error:
                return "{{unknown}}".to_string()
            case TyData.Var(_):
                return "_".to_string()
            case TyData.Const(n):
                return "{n}"
            # `W * H`, `-N`, `(W + 1) * H`.
            case TyData.ConstOp(op, args):
                var parts: list[String] = []
                for a in args:
                    let shown = self.display_in(types, a, names)
                    match types.data(a):
                        case TyData.ConstOp(_, _):
                            parts.push("({shown})")
                        case _:
                            parts.push(shown)
                if len(parts) == 1:
                    return "{op.symbol()}{parts[0]}"
                if len(parts) == 2:
                    return "{parts[0]} {op.symbol()} {parts[1]}"
                return "{{unknown}}".to_string()
            case TyData.Param(i):
                if i < len(names):
                    return names[i].copy()
                return "T{i}"
            case TyData.Dyn(tr):
                return "dyn {self.display_trait_in(types, tr, names)}"
            case TyData.Assoc(s, _, name):
                let base = self.display_in(types, s, names)
                match types.data(s):
                    case TyData.Param(_) | TyData.Assoc(_, _, _) | TyData.Adt(_, _):
                        return "{base}.{name}"
                    case _:
                        return "({base}).{name}"
            case TyData.Adt(d, args):
                return self.display_adt(types, d, args, names)
            case TyData.Tuple(elems, labels):
                var parts: list[String] = []
                for i in range(len(elems)):
                    let shown = self.display_in(types, elems[i], names)
                    if i < len(labels):
                        parts.push("{labels[i]}: {shown}")
                    else:
                        parts.push(shown)
                if len(parts) == 1 and labels.is_empty():
                    return "({parts[0]},)"
                return "({parts.join(", ")})"
            case TyData.ErrSet(members):
                var shown: list[String] = []
                for d in members:
                    shown.push(self.qualified_name(d))
                if len(shown) == 1:
                    return shown[0].copy()
                return "{{{shown.join(", ")}}}"
            case TyData.Fn(params, ret, pure):
                let p = self.joined(types, params, names)
                let prefix = if pure: "pure " else: ""
                return "{prefix}({p}) -> {self.display_in(types, ret, names)}"
            case TyData.Ref(t, m):
                let prefix = if m: "ref mut " else: "ref "
                return "{prefix}{self.display_in(types, t, names)}"

    pure def display_adt(
        self, types: Types, d: DefId, args: list[Ty], names: list[String]
    ) -> String:
        if Some(d) == self.wk.option:
            if args.is_empty():
                return "?".to_string()
            let inner = self.display_in(types, args[0], names)
            match types.data(args[0]):
                case TyData.Fn(_, _, _) | TyData.Ref(_, _):
                    return "({inner})?"
                case _:
                    return "{inner}?"
        if Some(d) == self.wk.result:
            let ok = if args.is_empty(): Ty.unit() else: args[0]
            var err = String.new()
            if len(args) > 1:
                err = self.display_in(types, args[1], names)
            if ok == Ty.unit():
                return "! {err}"
            return "{self.display_in(types, ok, names)} ! {err}"
        # The raw pointers of `std.mem`, as they are written (22).
        if self.is_raw_pointer(d, "ptr_mut") and len(args) == 1:
            return "ptr mut {self.display_in(types, args[0], names)}"
        if self.is_raw_pointer(d, "ptr") and len(args) == 1:
            return "ptr[{self.display_in(types, args[0], names)}]"
        let name = self.qualified_name(d)
        if args.is_empty():
            return name
        return "{name}[{self.joined(types, args, names)}]"

    ## A definition's name, qualified by its module unless it is in the root
    ## module or the prelude. A type or trait of the root module that the
    ## prelude also names (`struct Box`) is `main.Box`.
    pub pure def qualified_name(self, d: DefId) -> String:
        let item = ref self.defs[d.index]
        let module = ref self.modules[item.module.index]
        # The prelude's own items, while the base is made (when the root is
        # the prelude's module), keep their bare names: `u8.MAX` (R111).
        if item.module == self.root
                and item.module != self.prelude
                and not self.is_fn(d)
                and self.prelude.index < len(self.modules):
            if self.modules[self.prelude.index].items.contains(item.name.copy()):
                return "{module.name}.{item.name}"
        if item.module == self.root
                or item.module == self.prelude
                or module.name.starts_with("<shims>/"):
            # What the compiler writes for the program's traits is named
            # `__Fake_Trait`, a name the program does not use.
            return item.name.copy()
        return "{module.name}.{item.name}"

    # ---------------------------------------------------------------- copy

    ## `is_copy` where the bounds `env` are in scope: a type parameter
    ## bounded by `Copy` is `Copy`.
    pub pure def is_copy_in(self, mut types: Types, ty: Ty, env: list[Predicate]) -> bool:
        if env.is_empty() or not types.has_params(ty):
            return self.is_copy(mut types, ty)
        return self.is_copy_in_depth(mut types, ty, env, 0)

    pure def is_copy_in_depth(
        self, mut types: Types, ty: Ty, env: list[Predicate], depth: int
    ) -> bool:
        if depth > 32:
            return False
        match types.data(ty).copy():
            case TyData.Param(_) | TyData.Assoc(_, _, _):
                for p in env:
                    if p.ty == ty and Some(p.bound.def_) == self.wk.copy:
                        return True
                return False
            case TyData.Tuple(e, _):
                for t in e:
                    if not self.is_copy_in_depth(mut types, t, env, depth + 1):
                        return False
                return True
            case TyData.Adt(d, args):
                if Some(d) == self.wk.option:
                    for t in args:
                        if not self.is_copy_in_depth(mut types, t, env, depth + 1):
                            return False
                    return True
                if let Some(base) = self.refinement_base(mut types, d, args):
                    return self.is_copy_in_depth(mut types, base, env, depth + 1)
                if args.is_empty():
                    return self.is_copy(mut types, ty)
                match self.defs[d.index].kind():
                    case Struct(s):
                        if s.builtin.is_some():
                            return self.is_copy(mut types, ty)
                        if not s.copy:
                            return False
                        for f in s.fields:
                            let t = types.subst(f.ty, args)
                            if not self.is_copy_in_depth(mut types, t, env, depth + 1):
                                return False
                        return True
                    case Enum(e):
                        if not e.copy:
                            return False
                        for v in e.variants:
                            for (_, ft) in v.fields:
                                let t = types.subst(ft, args)
                                if not self.is_copy_in_depth(mut types, t, env, depth + 1):
                                    return False
                        return True
                    case _:
                        return self.is_copy(mut types, ty)
            case _:
                return self.is_copy(mut types, ty)

    ## Whether values of the type are copied rather than moved (04, rule 1).
    pub pure def is_copy(self, mut types: Types, ty: Ty) -> bool:
        return self.is_copy_depth(mut types, ty, 0)

    pure def is_copy_depth(self, mut types: Types, ty: Ty, depth: int) -> bool:
        # A type that contains itself this deep is not `Copy`.
        if depth > 32:
            return False
        match types.data(ty).copy():
            case TyData.Int | TyData.Float | TyData.Bool | TyData.Char | TyData.Str:
                return True
            case TyData.Unit | TyData.Never | TyData.Error | TyData.Const(_) | TyData.ConstOp(_, _):
                return True
            case TyData.Ref(_, m):
                return not m
            case TyData.Fn(_, _, _):
                return True
            case TyData.Tuple(e, _):
                for t in e:
                    if not self.is_copy_depth(mut types, t, depth + 1):
                        return False
                return True
            case TyData.ErrSet(members):
                for d in members:
                    if not self.def_is_copy(mut types, d, [], depth + 1):
                        return False
                return True
            case TyData.Adt(d, args):
                if Some(d) == self.wk.option:
                    for t in args:
                        if not self.is_copy_depth(mut types, t, depth + 1):
                            return False
                    return True
                return self.def_is_copy(mut types, d, args, depth + 1)
            case _:
                return False

    ## Whether a value of the type holds a capability handle (`Fs` and the
    ## others of a `System`) or a `Cap` by value (decision 237), or may: a
    ## function value, whose environment (an `own` closure's) holds copies
    ## of what it captured (decision 248). Such a value is `Copy` (Q-51),
    ## but each copy of a handle is counted and the object goes with the
    ## last one, so lowering drops it as it drops a value that is not
    ## `Copy`. A `Lent` is a view of a handle, and counts nothing; a type
    ## parameter holds none here (lowering drops a value whose type is
    ## `Copy` only by a bound all the same).
    pub pure def holds_capability(self, mut types: Types, ty: Ty) -> bool:
        return self.holds_capability_depth(mut types, ty, 0)

    pure def holds_capability_depth(self, mut types: Types, ty: Ty, depth: int) -> bool:
        if depth > 32:
            return False
        match types.data(ty).copy():
            # A function value's environment (an `own` closure's) holds
            # copies of what it captured (decision 248).
            case TyData.Fn(_, _, _):
                return True
            case TyData.Tuple(e, _):
                for t in e:
                    if self.holds_capability_depth(mut types, t, depth + 1):
                        return True
                return False
            case TyData.ErrSet(members):
                for d in members:
                    if self.def_holds_capability(mut types, d, [], depth + 1):
                        return True
                return False
            case TyData.Adt(d, args):
                return self.def_holds_capability(mut types, d, args, depth + 1)
            case _:
                return False

    pure def def_holds_capability(
        self, mut types: Types, d: DefId, args: list[Ty], depth: int
    ) -> bool:
        match self.defs[d.index].kind():
            case Refinement(r):
                let base = types.subst(r.base, args)
                return self.holds_capability_depth(mut types, base, depth)
            case Struct(s):
                if let Some(b) = s.builtin:
                    let bs: str = b
                    match bs:
                        case "Fs" | "Net" | "Clock" | "Rand" | "Env" | "Proc" | "Stdin" | "System" | "Cap":
                            return True
                        case "Lent":
                            return False
                        case _:
                            for a in args:
                                if self.holds_capability_depth(mut types, a, depth + 1):
                                    return True
                            return False
                for f in s.fields:
                    let t = types.subst(f.ty, args)
                    if self.holds_capability_depth(mut types, t, depth):
                        return True
                return False
            case Enum(e) | ErrorSet(e):
                for v in e.variants:
                    for (_, ft) in v.fields:
                        let t = types.subst(ft, args)
                        if self.holds_capability_depth(mut types, t, depth):
                            return True
                return False
            case _:
                for a in args:
                    if self.holds_capability_depth(mut types, a, depth + 1):
                        return True
                return False

    ## A `@derive(Copy)` type whose fields, with its arguments in them, are
    ## all `Copy`.
    pure def def_is_copy(self, mut types: Types, d: DefId, args: list[Ty], depth: int) -> bool:
        match self.defs[d.index].kind():
            case Refinement(r):
                # A refinement is represented as its base.
                let base = types.subst(r.base, args)
                return self.is_copy_depth(mut types, base, depth)
            case Struct(s):
                if let Some(b) = s.builtin:
                    return is_copy_builtin(b)
                if not s.copy:
                    return False
                if args.is_empty():
                    return True
                for f in s.fields:
                    let t = types.subst(f.ty, args)
                    if not self.is_copy_depth(mut types, t, depth):
                        return False
                return True
            case Enum(e):
                return self.enum_is_copy(mut types, e, args, depth)
            case ErrorSet(e):
                return self.enum_is_copy(mut types, e, args, depth)
            case _:
                return False

    pure def enum_is_copy(self, mut types: Types, e: EnumInfo, args: list[Ty], depth: int) -> bool:
        if not e.copy:
            return False
        if args.is_empty():
            return True
        for v in e.variants:
            for (_, ft) in v.fields:
                let t = types.subst(ft, args)
                if not self.is_copy_depth(mut types, t, depth):
                    return False
        return True

    # ---------------------------------------------------------------- traits

    ## The trait and its supertraits, transitively, with `Self` = `subject`.
    pub pure def elaborate(self, mut types: Types, subject: Ty, tr: TraitRef) -> list[TraitRef]:
        var out: list[TraitRef] = []
        var work: list[TraitRef] = [tr.copy()]
        while let Some(t) = work.pop():
            if out.contains(t) or len(out) > 64:
                continue
            if let Some(info) = self.trait_info(t.def_):
                var args: list[Ty] = [subject]
                for a in t.args:
                    args.push(a)
                for s in info.supertraits:
                    work.push(types.subst_trait(s, args))
            out.push(t)
        return out

    ## The predicates in `env` closed under supertraits.
    pub pure def elaborate_env(self, mut types: Types, env: list[Predicate]) -> list[Predicate]:
        var out: list[Predicate] = []
        for p in env:
            for b in self.elaborate(mut types, p.ty, p.bound):
                var seen = False
                for q in out:
                    if q.ty == p.ty and q.bound == b:
                        seen = True
                if not seen:
                    out.push(Predicate(ty=p.ty, bound=b.copy(), span=p.span))
        return out

    ## Whether `ty` implements `tr` in an environment of bounds (already
    ## elaborated).
    pub pure def implements(
        self, mut types: Types, ty: Ty, tr: TraitRef, env: list[Predicate]
    ) -> Answer:
        return self.implements_depth(mut types, ty, tr, env, 0)

    pure def implements_depth(
        self, mut types: Types, ty_in: Ty, tr: TraitRef, env: list[Predicate], depth: int
    ) -> Answer:
        if depth > 32:
            return Answer.No
        let ty = self.normalize(mut types, ty_in, env)
        match types.data(ty):
            case TyData.Error | TyData.Never:
                return Answer.Yes(ImplSource.Builtin)
            case TyData.Var(_):
                return Answer.Unknown
            case _:
                pass
        for a in tr.args:
            if let TyData.Var(_) = types.data(a):
                return Answer.Unknown
        # A bound in scope.
        for p in env:
            if p.ty == ty and p.bound == tr:
                return Answer.Yes(ImplSource.Param)
        let t = Some(tr.def_)
        # `Copy` is structural (04, rule 1).
        if t == self.wk.copy:
            match types.data(ty):
                case TyData.Param(_) | TyData.Assoc(_, _, _):
                    return Answer.No
                case _:
                    pass
            if self.is_copy(mut types, ty):
                return Answer.Yes(ImplSource.Builtin)
            return Answer.No
        # `Send` and `Sync` are structural (06), and so is `Escapable`:
        # whatever holds no reference or view.
        if t == self.wk.send or t == self.wk.sync:
            let auto = if t == self.wk.send: Auto.Send else: Auto.Sync
            # As a bound, `Send` asks the type to own what it holds too
            # (RULES.md, R1): what a generic body sends on a channel
            # reaches a receiver that may keep it after what it borrows is
            # gone, and a bound cannot see how long that is.
            if auto == Auto.Send
                    and not holds_var(types, ty)
                    and self.can_borrow_in(mut types, ty, env):
                return Answer.No
            if self.auto_trait(mut types, ty, auto, env):
                return Answer.Yes(ImplSource.Builtin)
            return Answer.No
        if t == self.wk.escapable:
            if not self.can_borrow_in(mut types, ty, env):
                return Answer.Yes(ImplSource.Builtin)
            return Answer.No
        # Every type but a `dyn` one has its size (03; `E0395` keeps a
        # `dyn` behind `ref` or in a `Box`; RULES.md, R153).
        if t == self.wk.sized:
            if let TyData.Dyn(_) = types.data(ty):
                return Answer.No
            return Answer.Yes(ImplSource.Builtin)
        # A refinement implements the reading traits of its base (07).
        if let TyData.Adt(d, args) = types.data(ty).copy():
            if let Some(base) = self.refinement_base(mut types, d, args):
                if not self.passes_through_refs(tr.def_):
                    return Answer.No
                return self.implements_depth(mut types, base, tr, env, depth + 1)
        match types.data(ty).copy():
            case TyData.Dyn(d):
                if self.elaborate(mut types, ty, d).contains(tr):
                    return Answer.Yes(ImplSource.Dyn)
                if t == self.wk.debug:
                    return Answer.Yes(ImplSource.Builtin)
            case TyData.Ref(inner, _):
                # A reference reads what it points to.
                if self.passes_through_refs(tr.def_):
                    return match self.implements_depth(mut types, inner, tr, env, depth + 1):
                        case Yes(_): Answer.Yes(ImplSource.Builtin)
                        case other: other
            case TyData.ErrSet(_):
                # Error sets compare, hash and print structurally.
                if t == self.wk.eq
                        or t == self.wk.hash
                        or t == self.wk.debug
                        or t == self.wk.display:
                    return Answer.Yes(ImplSource.Builtin)
            case TyData.Fn(_, _, _):
                if t == self.wk.debug:
                    return Answer.Yes(ImplSource.Builtin)
            case _:
                pass
        # The impls of the trait, in the order they were declared.
        var unknown = False
        if let Some(candidates) = self.impls_of.get(tr.def_):
            for i in candidates:
                let info = self.impl_info(i) else:
                    continue
                var binds: list[Ty?] = []
                for _ in range(len(info.generics)):
                    binds.push(None)
                var header = match_ty(types, info.self_ty, ty, mut binds)
                for k in range(len(info.trait_ref.args)):
                    if k < len(tr.args):
                        header = header.and(
                            match_ty(types, info.trait_ref.args[k], tr.args[k], mut binds)
                        )
                if header == Match.No:
                    continue
                if header == Match.Unknown:
                    unknown = True
                    continue
                var args: list[Ty] = []
                for b in binds:
                    args.push(b.copy() ?? Ty.error())
                # The impl's own bounds, for these arguments.
                var ok = Answer.Yes(ImplSource.Impl(def_=i, args=args.copy()))
                for p in info.predicates:
                    let pt = types.subst(p.ty, args)
                    let pb = types.subst_trait(p.bound, args)
                    match self.implements_depth(mut types, pt, pb, env, depth + 1):
                        case Yes(src):
                            if not self.defaults_hold(mut types, pt, pb, src, env):
                                ok = Answer.No
                                break
                        case No:
                            ok = Answer.No
                            break
                        case Unknown:
                            ok = Answer.Unknown
                return ok
        if unknown:
            return Answer.Unknown
        return Answer.No

    ## The traits that a `ref T` implements whenever `T` does: those whose
    ## methods only read.
    pub pure def passes_through_refs(self, t: DefId) -> bool:
        let wk = ref self.wk
        let d = Some(t)
        return d == wk.display
            or d == wk.debug
            or d == wk.eq
            or d == wk.partial_ord
            or d == wk.ord
            or d == wk.hash
            or d == wk.len

    ## Whether `ty` meets the bound `tr`: it implements the trait, and each
    ## associated type to which the trait gives a default is that default.
    pub pure def bound_holds(
        self, mut types: Types, ty: Ty, tr: TraitRef, env: list[Predicate]
    ) -> Answer:
        let answer = self.implements(mut types, ty, tr, env)
        if let Yes(src) = answer:
            if not self.defaults_hold(mut types, ty, tr, src, env):
                return Answer.No
        return answer

    pure def defaults_hold(
        self, mut types: Types, ty: Ty, tr: TraitRef, src: ImplSource, env: list[Predicate]
    ) -> bool:
        let Impl(def_, args) = src else:
            return True
        let info = self.impl_info(def_) else:
            return True
        let t = self.trait_info(tr.def_) else:
            return True
        var targs: list[Ty] = [ty]
        for a in tr.args:
            targs.push(a)
        for a in t.assoc:
            let default = a.default else:
                continue
            for (n, bound) in info.assoc:
                if n == a.name:
                    let x = types.subst(default, targs)
                    let y = types.subst(bound, args)
                    if self.normalize(mut types, x, env) != self.normalize(mut types, y, env):
                        return False
        return True

    ## The impl that makes `ty` implement `tr`, when one does.
    pub pure def find_impl(
        self, mut types: Types, ty: Ty, tr: TraitRef, env: list[Predicate]
    ) -> (DefId, list[Ty])?:
        if let Yes(Impl(def_, args)) = self.implements(mut types, ty, tr, env):
            return Some((def_, args))
        return None

    ## The function a call of the trait method `method` runs for `self_ty`
    ## (stage 0's `resolve_method`): the impl's method with the impl's type
    ## arguments, or the trait's provided method with `Self` and the
    ## trait's arguments.
    pub pure def resolve_method(
        self,
        mut types: Types,
        method: DefId,
        trait_args: list[Ty],
        self_ty: Ty,
        env: list[Predicate],
    ) -> (DefId, list[Ty])?:
        let f = self.fn_info(method) else:
            return None
        let t = f.trait_ else:
            return None
        let tr = TraitRef(def_=t, args=trait_args.copy())
        let found = self.find_impl(mut types, self_ty, tr, env) else:
            return None
        let (imp, args) = found
        let info = self.impl_info(imp) else:
            return None
        let name = ref self.defs[method.index].name
        for (n, m) in info.methods:
            if n == name:
                return Some((m, args))
        var targs = [self_ty]
        for a in trait_args:
            targs.push(a)
        return Some((method, targs))

    ## Replaces associated types of known types by what their impls bind.
    pub pure def normalize(self, mut types: Types, ty: Ty, env: list[Predicate]) -> Ty:
        return self.normalize_depth(mut types, ty, env, 0)

    pure def normalize_depth(
        self, mut types: Types, ty: Ty, env: list[Predicate], depth: int
    ) -> Ty:
        if depth > 32:
            return ty
        match types.data(ty).copy():
            case TyData.Assoc(s, tr, name):
                let self_ty = self.normalize_depth(mut types, s, env, depth + 1)
                var targs: list[Ty] = []
                for a in tr.args:
                    targs.push(self.normalize_depth(mut types, a, env, depth + 1))
                let trait_ = TraitRef(def_=tr.def_, args=targs)
                if let Some((d, args)) = self.find_impl(mut types, self_ty, trait_, env):
                    if let Some(info) = self.impl_info(d):
                        for (n, t) in info.assoc:
                            if n == name:
                                let bound = types.subst(t, args)
                                return self.normalize_depth(mut types, bound, env, depth + 1)
                    if let Some(default) = self.assoc_default(trait_.def_, name):
                        var all: list[Ty] = [self_ty]
                        for a in trait_.args:
                            all.push(a)
                        let x = types.subst(default, all)
                        return self.normalize_depth(mut types, x, env, depth + 1)
                else:
                    var bounded = False
                    for p in env:
                        if p.ty == self_ty and p.bound == trait_:
                            bounded = True
                    if bounded:
                        if let Some(default) = self.assoc_default(trait_.def_, name):
                            var all: list[Ty] = [self_ty]
                            for a in trait_.args:
                                all.push(a)
                            let x = types.subst(default, all)
                            return self.normalize_depth(mut types, x, env, depth + 1)
                return types.intern(TyData.Assoc(self_ty=self_ty, trait_=trait_, name=name))
            case TyData.Adt(d, args):
                var out: list[Ty] = []
                for a in args:
                    out.push(self.normalize_depth(mut types, a, env, depth + 1))
                return types.adt(d, out)
            case TyData.Tuple(e, l):
                var out: list[Ty] = []
                for a in e:
                    out.push(self.normalize_depth(mut types, a, env, depth + 1))
                return types.intern(TyData.Tuple(elems=out, labels=l))
            case TyData.Fn(ps, r, pure):
                var out: list[Ty] = []
                for a in ps:
                    out.push(self.normalize_depth(mut types, a, env, depth + 1))
                let ret = self.normalize_depth(mut types, r, env, depth + 1)
                return types.fn_(out, ret, pure)
            case TyData.Ref(inner, m):
                let t = self.normalize_depth(mut types, inner, env, depth + 1)
                return types.ref_(t, m)
            case TyData.Dyn(tr):
                var out: list[Ty] = []
                for a in tr.args:
                    out.push(self.normalize_depth(mut types, a, env, depth + 1))
                return types.intern(TyData.Dyn(TraitRef(def_=tr.def_, args=out)))
            case _:
                return ty

    ## The default a trait gives its associated type `name`.
    pure def assoc_default(self, tr: DefId, name: str) -> Ty?:
        let info = self.trait_info(tr) else:
            return None
        for a in info.assoc:
            if a.name == name:
                return a.default
        return None

    ## The method `name` a trait declares, if any.
    pub pure def trait_method(self, tr: DefId, name: str) -> DefId?:
        let info = self.trait_info(tr) else:
            return None
        for m in info.methods:
            if self.defs[m.index].name == name:
                return Some(m)
        return None

    ## The traits whose methods named `name` a value of type `ty` can call:
    ## for a generic parameter, its bounds; for `dyn T`, `T` and its
    ## supertraits; otherwise every trait the type implements. Each comes
    ## with the trait's arguments.
    pub pure def trait_methods_for(
        self, mut types: Types, ty: Ty, name: str, env: list[Predicate]
    ) -> list[(TraitRef, DefId)]:
        var out: list[(TraitRef, DefId)] = []
        match types.data(ty).copy():
            case TyData.Param(_) | TyData.Assoc(_, _, _):
                for p in env:
                    if p.ty == ty:
                        push_method(self, p.bound, name, mut out)
            case TyData.Dyn(tr):
                for t in self.elaborate(mut types, ty, tr):
                    push_method(self, t, name, mut out)
                if let Some(d) = self.wk.debug:
                    push_method(self, TraitRef(def_=d, args=[]), name, mut out)
            case _:
                for i in range(len(self.defs)):
                    let d = DefId(index=i)
                    let info = self.trait_info(d) else:
                        continue
                    if self.trait_method(d, name).is_none():
                        continue
                    if info.generics.is_empty():
                        let tr = TraitRef(def_=d, args=[])
                        if self.implements(mut types, ty, tr, env).holds():
                            push_method(self, tr, name, mut out)
                    elif let Some(candidates) = self.impls_of.get(d):
                        for im in candidates:
                            let ii = self.impl_info(im) else:
                                continue
                            var binds: list[Ty?] = []
                            for _ in range(len(ii.generics)):
                                binds.push(None)
                            if match_ty(types, ii.self_ty, ty, mut binds) == Match.Yes:
                                var args: list[Ty] = []
                                for b in binds:
                                    args.push(b.copy() ?? Ty.error())
                                let tr = types.subst_trait(ii.trait_ref, args)
                                push_method(self, tr, name, mut out)
        return out

    ## The first `dyn Trait` a type holds by value rather than behind a
    ## `ref` or in a `Box` (03, "Dispatch": `dyn` is unsized).
    pub pure def unsized_part(self, types: Types, ty: Ty) -> Ty?:
        return self.unsized_walk(types, ty, False)

    pure def unsized_walk(self, types: Types, t: Ty, held: bool) -> Ty?:
        match types.data(t):
            case TyData.Dyn(tr):
                if not held:
                    return Some(t)
                for a in tr.args:
                    if let Some(x) = self.unsized_walk(types, a, False):
                        return Some(x)
                return None
            case TyData.Ref(inner, _):
                return self.unsized_walk(types, inner, True)
            case TyData.Adt(d, args):
                let boxed = Some(d) == self.wk.boxed
                for a in args:
                    if let Some(x) = self.unsized_walk(types, a, boxed):
                        return Some(x)
                return None
            case TyData.Tuple(es, _):
                for e in es:
                    if let Some(x) = self.unsized_walk(types, e, False):
                        return Some(x)
                return None
            case TyData.Fn(ps, r, _):
                for p in ps:
                    if let Some(x) = self.unsized_walk(types, p, False):
                        return Some(x)
                return self.unsized_walk(types, r, False)
            case _:
                return None

    ## Whether a value of the type is or lends a capability, or is the
    ## `System` of them: what a `pure` function cannot take (06).
    pub pure def is_capability(self, types: Types, ty: Ty) -> bool:
        match types.data(ty):
            case TyData.Ref(t, _):
                return self.is_capability(types, t)
            case TyData.Adt(d, args):
                let b = self.builtin(d) ?? String.new()
                if is_capability_builtin(b):
                    return True
                if b == "Lent":
                    for a in args:
                        if self.is_capability(types, a):
                            return True
                return False
            case _:
                return False

    ## The closest of `names` to a misspelt `name`, by stage 0's rule.
    pub pure def closest(self, name: str, names: list[String]) -> String?:
        return closest(name, names)

## Adds a trait's method `name` to `out`, once per trait.
pure def push_method(prog: Program, tr: TraitRef, name: str, mut out: list[(TraitRef, DefId)]):
    if let Some(m) = prog.trait_method(tr.def_, name):
        for (t, _) in out:
            if t == tr:
                return
        out.push((tr.copy(), m))

## Matches `pat` (in terms of the impl's parameters, `Param(i)` binding
## `binds[i]`) against `ty`.
pub pure def match_ty(types: Types, pat: Ty, ty: Ty, mut binds: list[Ty?]) -> Match:
    if let TyData.Param(i) = types.data(pat):
        if i < len(binds):
            let bound = binds[i]
            match bound:
                case None:
                    binds[i] = Some(ty)
                    return Match.Yes
                case Some(b):
                    if b == ty:
                        return Match.Yes
                    if is_var(types, b) or is_var(types, ty):
                        return Match.Unknown
                    return Match.No
    if is_var(types, ty):
        return Match.Unknown
    match types.data(pat):
        case TyData.Adt(d1, a1):
            if let TyData.Adt(d2, a2) = types.data(ty):
                if d1 == d2 and len(a1) == len(a2):
                    return match_all(types, a1, a2, mut binds, Match.Yes)
        case TyData.Tuple(e1, _):
            if let TyData.Tuple(e2, _) = types.data(ty):
                if len(e1) == len(e2):
                    return match_all(types, e1, e2, mut binds, Match.Yes)
        case TyData.Ref(p, m1):
            if let TyData.Ref(t, m2) = types.data(ty):
                if m1 == m2:
                    return match_ty(types, p, t, mut binds)
        case TyData.Fn(p1, r1, _):
            if let TyData.Fn(p2, r2, _) = types.data(ty):
                if len(p1) == len(p2):
                    let first = match_ty(types, r1, r2, mut binds)
                    return match_all(types, p1, p2, mut binds, first)
        case TyData.Dyn(t1):
            if let TyData.Dyn(t2) = types.data(ty):
                if t1.def_ == t2.def_ and len(t1.args) == len(t2.args):
                    return match_all(types, t1.args, t2.args, mut binds, Match.Yes)
        case _:
            pass
    if pat == ty:
        return Match.Yes
    return Match.No

pure def match_all(
    types: Types, pats: list[Ty], tys: list[Ty], mut binds: list[Ty?], start: Match
) -> Match:
    var m = start
    for i in range(len(pats)):
        m = m.and(match_ty(types, pats[i], tys[i], mut binds))
    return m

pure def is_var(types: Types, t: Ty) -> bool:
    if let TyData.Var(_) = types.data(t):
        return True
    return False

## The builtin types that are capabilities, their handles or `System`.
pure def is_capability_builtin(b: str) -> bool:
    return match b:
        case "Fs" | "Net" | "Clock" | "Rand" | "Env" | "Proc" | "Stdin" | "System" | "TestClock": True
        case "HostFs" | "HostNet" | "HostClock" | "HostRand" | "HostEnv" | "HostProc" | "HostStdin": True
        case _: False

## The builtin types whose values are copied.
pure def is_copy_builtin(b: str) -> bool:
    return match b:
        case "Fs" | "Net" | "Clock" | "Rand" | "Env" | "Proc" | "Stdin" | "System": True
        case "HostFs" | "HostNet" | "HostClock" | "HostRand" | "HostEnv" | "HostProc" | "HostStdin": True
        case "TestClock" | "Cap" | "Lent" | "DateTime" | "Scope" | "Cancellation" | "Timer": True
        # A raw pointer is copied (22, "Auto traits"); what it points to is not.
        case "ptr" | "ptr_mut": True
        case "f32" | "u8" | "u16" | "u32" | "u64" | "u128" | "i8" | "i16" | "i32" | "i128": True
        case _: False

## The type of a parameter as a local of its function (stage 0's
## `sisu_typeck::param_local_ty`): a borrowed parameter is a `ref T`
## unless `T` is `Copy`; a generic parameter, or an associated type of one,
## only when its bounds make it `Copy`.
pub pure def param_local_ty(
    prog: Program, mut types: Types, ty: Ty, mode: Mode, env: list[Predicate]
) -> Ty:
    match mode:
        case Mode.Own:
            return ty
        case Mode.Mut:
            return types.ref_(ty, True)
        case Mode.Borrow:
            # A reference is passed as it is, a `ref mut T` too: the call
            # passes the reference, not a borrow of it (decision 255). A
            # generic parameter bounded by `Copy` is passed by value, as
            # every type it stands for is.
            # A type holding the function's type parameters is `Copy` by
            # their bounds (`(T, T)` with `T: Copy`, RULES.md, R23), as one
            # of them is.
            if let TyData.Ref(_, _) = types.data(ty):
                return ty
            var copy = False
            if types.has_params(ty):
                copy = prog.is_copy_in(mut types, ty, env)
            else:
                copy = prog.is_copy(mut types, ty)
            if copy:
                return ty
            return types.ref_(ty, False)

## Whether a type holds an inference variable, which `can_borrow_in` takes
## for a view: whether it owns what it holds is not known yet.
pure def holds_var(types: Types, ty: Ty) -> bool:
    for x in types.walk(ty):
        if let TyData.Var(_) = types.data(x):
            return True
    return False

## Whether the type arguments of a channel half are those of a channel of
## closures, whose closures are checked where they are sent (RULES.md,
## R1): its element is a function type.
## Whether a collection's item of type `a` would be a reference (RULES.md,
## R21): a `ref T`, but a shared borrow of a `str`, which is the view.
pub pure def is_ref_item(types: Types, a: Ty) -> bool:
    if let TyData.Ref(inner, mutable) = types.data(a):
        return mutable or inner != Ty.str()
    return False

pub pure def carries_closures(types: Types, args: list[Ty]) -> bool:
    if args.is_empty():
        return False
    if let TyData.Fn(_, _, _) = types.data(args[0]):
        return True
    return False
