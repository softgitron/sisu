##! Calls (stage 0's `sisu-typeck/src/call.rs`): functions, methods,
##! associated functions, constructors and variants, with keyword
##! arguments, defaults, `mut` at the call site and trailing `do` blocks.

from stage1.diag import Diagnostic, Edit, Msg, Param, TextRange
from stage1.syntax.ast import Arg, Ast, Closure, ExprId, ExprKind, IndexArg, Mode, Name, StrPart
from stage1.typeck.check import Checker, Cx, SendCheck, primitive
from stage1.typeck.expr import ClosureParamSrc, ClosureSource, is_var_data
from stage1.typeck.program import Answer, DefKind, ModuleId, param_local_ty
from stage1.typeck.tasks import task_call
from stage1.typeck.thir import ArgMode, Callee, FieldInit, ForMode, TArg, TExprId, TExprKind
from stage1.typeck.ty import DefId, TraitRef, Ty, TyData, TyKey

## A name that denotes a module, a type, a function or a trait rather than
## a value.
pub enum StaticPath:
    Module(ModuleId)
    Type(Ty)
    ## A generic function, with the type arguments written after it.
    Fn(def_: DefId, args: list[Ty]?)
    ## A trait, whose methods are called as `Trait.method(x, ...)`.
    Trait(DefId)

## A parameter of a function as a call sees it, its type instantiated.
pub struct InstParam:
    pub name: String
    pub mode: Mode
    pub ty: Ty
    pub has_default: bool
    ## The declared type is a generic parameter (or an associated type of
    ## one) of a function with a body: a borrowed argument is passed by
    ## reference even when its type is `Copy`.
    pub opaque: bool

## A function's signature, instantiated for one call.
pub struct InstSig:
    pub def_: DefId
    pub name: String
    pub params: list[InstParam]
    pub ret: Ty
    pub owner: Ty?
    pub type_args: list[Ty]
    pub keyword_only_from: int?
    pub positional_only_until: int

## An argument as the matching of arguments to parameters sees it: one
## written in the parentheses, or the trailing `do` block.
pub struct ArgIn:
    pub name: Name?
    pub mutable: bool
    ## The argument's expression; `None` for a trailing block.
    pub value: ExprId?
    pub closure: Closure?
    pub range: TextRange
    ## Where the value is written.
    pub value_range: TextRange

impl Checker:
    ## Checks arguments for their own errors when the callee is unknown.
    pub pure def check_args_loosely(mut self, cx: Cx, args: list[Arg]):
        for a in args:
            # An argument over `it` is a closure only where a function is
            # expected, which a call that failed does not say: it is left
            # unchecked rather than reported as `it` outside one (RULES.md,
            # R24).
            if mentions_it(cx.ast, a.value):
                continue
            _ = self.infer_expr(cx, a.value, None)

    # ---------------------------------------------------------------- static paths

    pub pure def static_path(mut self, cx: Cx, e: ExprId) -> StaticPath?:
        let at = cx.ast.expr(e).range
        match cx.ast.expr(e).kind:
            case ExprKind.Name(n):
                if self.lookup_local(n).is_some() or n == "it":
                    return None
                # A generic parameter: `T.zero()`. A `const` one is a value,
                # whose methods `N.to_f32()` calls (RULES.md, R43).
                for i in range(len(self.generic_names)):
                    if self.generic_names[i] == n:
                        if i < len(self.const_generics) and self.const_generics[i]:
                            return None
                        return Some(StaticPath.Type(self.types.param(i)))
                if let Some(t) = primitive_value_type(n):
                    if cx.prog.lookup(self.module, n).is_none():
                        return Some(StaticPath.Type(t))
                let d = cx.prog.lookup(self.module, n) else:
                    return None
                return self.classify(cx, d, at)
            case ExprKind.SelfType:
                if let Some(t) = self.self_ty:
                    return Some(StaticPath.Type(t))
                return None
            case ExprKind.Field(base, name):
                if let Some(StaticPath.Module(m)) = self.static_path(cx, base):
                    let d = self.module_member(cx, m, name) else:
                        self.not_in_module(cx, m, name)
                        return Some(StaticPath.Type(Ty.error()))
                    return self.classify(cx, d, at)
                return None
            case ExprKind.Index(base, args):
                let path = self.static_path(cx, base) else:
                    return None
                # `cap.Fake[Trait]`: the fake the compiler wrote (17).
                if let StaticPath.Type(t) = path:
                    if let TyData.Adt(d, _) = self.types.data(t).copy():
                        if self.is_fake_marker(cx, d):
                            var as_expr: String? = None
                            var written = at
                            if len(args) == 1:
                                if let IndexArg.Expr(x) = args[0]:
                                    written = cx.ast.expr(x).range
                                    if let ExprKind.Name(n) = cx.ast.expr(x).kind:
                                        as_expr = Some(n.copy())
                            let fake = self.fake_named(cx, as_expr, written)
                            return Some(StaticPath.Type(fake))
                var tys: list[Ty] = []
                for a in args:
                    match a:
                        case IndexArg.Expr(x):
                            tys.push(self.expr_as_type(cx, x))
                        case IndexArg.Slice(_, _):
                            tys.push(Ty.error())
                match path:
                    case StaticPath.Type(t):
                        if let TyData.Adt(d, _) = self.types.data(t).copy():
                            return Some(StaticPath.Type(self.def_type(cx, d, tys, at)))
                        return Some(StaticPath.Type(t))
                    case StaticPath.Fn(d, None):
                        return Some(StaticPath.Fn(def_=d, args=Some(tys)))
                    case other:
                        return Some(other.copy())
            case _:
                return None

    ## The static path of a pattern's qualifier (`Shape` in
    ## `Shape.Circle(r)`): names joined by dots.
    pub pure def static_path_of_names(mut self, cx: Cx, names: list[Name]) -> StaticPath?:
        let first = names.first() else:
            return None
        var path: StaticPath? = None
        let n = first.text.copy()
        if self.lookup_local(n).is_some() or n == "it":
            return None
        var found = False
        for i in range(len(self.generic_names)):
            if self.generic_names[i] == n and not found:
                path = Some(StaticPath.Type(self.types.param(i)))
                found = True
        if not found:
            if let Some(t) = primitive_value_type(n):
                if cx.prog.lookup(self.module, n).is_none():
                    path = Some(StaticPath.Type(t))
                    found = True
        if not found:
            let d = cx.prog.lookup(self.module, n) else:
                return None
            path = self.classify(cx, d, first.range)
        for i in range(1, len(names)):
            let p = path else:
                return None
            match p:
                case StaticPath.Module(m):
                    match self.module_member(cx, m, names[i]):
                        case Some(d):
                            path = self.classify(cx, d, names[i].range)
                        case None:
                            self.not_in_module(cx, m, names[i])
                            path = Some(StaticPath.Type(Ty.error()))
                case _:
                    return None
        return path

    ## `m.name` as this module sees it (09): the item, reported when it is
    ## not visible here, so that nothing cascades from it.
    pub pure def module_member(mut self, cx: Cx, m: ModuleId, name: Name) -> DefId?:
        let member = cx.prog.member(m, name.text, self.module) else:
            return None
        let (d, visible) = member
        if not visible:
            self.report_other(cx.prog.private_item(d, m, name.range))
        return Some(d)

    ## `resolve.not-in-module`: `m` has no `name`.
    pure def not_in_module(mut self, cx: Cx, m: ModuleId, name: Name):
        var d = self.error(cx, Msg.ResolveNotInModule, name.range)
        self.report_other(d.with("module", cx.prog.module_path(m)).with("name", name.text))

    pure def classify(mut self, cx: Cx, d: DefId, range: TextRange) -> StaticPath?:
        match cx.prog.defs[d.index].kind():
            case DefKind.Module(m):
                return Some(StaticPath.Module(m))
            case DefKind.Struct(_) | DefKind.Enum(_) | DefKind.ErrorSet(_):
                return Some(StaticPath.Type(self.def_type(cx, d, [], range)))
            case DefKind.TypeAlias(_) | DefKind.Refinement(_):
                return Some(StaticPath.Type(self.def_type(cx, d, [], range)))
            case DefKind.Fn(f):
                if f.generics.is_empty():
                    return None
                return Some(StaticPath.Fn(def_=d, args=None))
            case DefKind.Trait(_):
                return Some(StaticPath.Trait(d))
            case _:
                return None

    ## An index argument read as a type: `Options` in `cli.parse[Options]`,
    ## or a constant for a `const` parameter: `16` in `size[16]()`.
    pub pure def expr_as_type(mut self, cx: Cx, e: ExprId) -> Ty:
        match cx.ast.expr(e).kind:
            case ExprKind.Int(_, value, None):
                let v = value else:
                    self.expected_type(cx, e)
                    return Ty.error()
                if let Some(n) = v.to_int():
                    return self.types.intern(TyData.Const(n))
                return Ty.error()
            case ExprKind.Name(n):
                # A `const` parameter of the function itself, passed on.
                for i in range(len(self.generic_names)):
                    if self.generic_names[i] == n
                            and i < len(self.const_generics)
                            and self.const_generics[i]:
                        return self.types.param(i)
                # A constant of the program.
                if self.lookup_local(n).is_none():
                    if let Some(d) = cx.prog.lookup(self.module, n):
                        if let DefKind.Const(_) = cx.prog.defs[d.index].kind():
                            return self.const_arg(cx, e)
                if let Some(t) = primitive_value_type(n):
                    return t
                if let Some(StaticPath.Type(t)) = self.static_path(cx, e):
                    return t
                self.undefined_type(cx, n, cx.ast.expr(e).range)
                return Ty.error()
            case ExprKind.Field(_, _) | ExprKind.Index(_, _):
                # `Square.SIDES`, a type's constant as a constant argument
                # (RULES.md, R50).
                if let ExprKind.Field(b, name) = cx.ast.expr(e).kind.copy():
                    if let ExprKind.Name(n) = cx.ast.expr(b).kind.copy():
                        if let Some(d) = cx.prog.lookup(self.module, n):
                            if let Some(t) = cx.prog.const_args.get((d, name.text.copy())):
                                return t
                if let Some(StaticPath.Type(t)) = self.static_path(cx, e):
                    return t
                let at = cx.ast.expr(e).range
                let shown = self.source_text(cx, at)
                self.report_other(self.error(cx, Msg.ResolveNotAType, at).with("name", shown))
                return Ty.error()
            case ExprKind.Tuple(xs):
                var tys: list[Ty] = []
                for x in xs:
                    tys.push(self.expr_as_type(cx, x))
                if tys.is_empty():
                    return Ty.unit()
                return self.types.tuple(tys)
            # A constant computed where it is written: `size[N * 2]()`.
            case ExprKind.Binary(_, _, _) | ExprKind.Unary(_, _) | ExprKind.Paren(_):
                return self.const_arg(cx, e)
            case _:
                self.expected_type(cx, e)
                return Ty.error()

    ## `parse.expected-type`: an index argument that is not a type.
    pure def expected_type(mut self, cx: Cx, e: ExprId):
        let at = cx.ast.expr(e).range
        let found = "`{self.source_text(cx, at)}`"
        self.report_other(self.error(cx, Msg.ParseExpectedType, at).with("found", found))

    ## `module.name`, `Type.Variant`, `Type.function`, used as a value or,
    ## with `args`, called.
    pub pure def static_member(
        mut self,
        cx: Cx,
        path: StaticPath,
        name: Name,
        at: TextRange,
        args: list[Arg]?,
        trailing: Closure?,
        expected: Ty?,
    ) -> TExprId:
        match path:
            case StaticPath.Module(m):
                let d = self.module_member(cx, m, name) else:
                    self.not_in_module(cx, m, name)
                    if let Some(a) = args:
                        self.check_args_loosely(cx, a)
                    return self.error_expr(at)
                match args:
                    case Some(a):
                        return self.call_def(cx, d, None, a, trailing, at, expected)
                    case None:
                        return self.def_value(cx, d, name.text, at)
            case StaticPath.Type(ty):
                if ty == Ty.error():
                    if let Some(a) = args:
                        self.check_args_loosely(cx, a)
                    return self.error_expr(at)
                # A deprecated type named before `.` (RULES.md, R40).
                if let TyData.Adt(d, _) = self.types.data(ty):
                    if at.start < name.range.start:
                        let written = TextRange.new(at.start, max(at.start, name.range.start - 1))
                        self.deprecated_item_use(cx, d, written)
                # `X.try_from(v)` for a refinement type (07).
                if name.text == "try_from" and self.refinement_of(cx, ty).is_some():
                    if let Some(a) = args:
                        return self.refine_try(cx, ty, a, trailing, at)
                # `X.__default_f()`: the default of the field `f` of `X`.
                if name.text.starts_with("__default_"):
                    if let Some(a) = args:
                        if let TyData.Adt(d, targs) = self.types.data(ty).copy():
                            if let Some(si) = cx.prog.struct_info(d):
                                let field = name.text.byte_slice(10, name.text.byte_len())
                                for fi in range(len(si.fields)):
                                    if si.fields[fi].name == field
                                            and si.fields[fi].default.is_some():
                                        if not a.is_empty() or trailing.is_some():
                                            self.check_args_loosely(cx, a)
                                        let fty = self.types.subst(si.fields[fi].ty, targs)
                                        let k = TExprKind.FieldDefault(def_=d, field=fi)
                                        return self.add(k, fty, at)
                # An associated constant (`Money.ZERO`).
                if let Some(k) = self.types.key(ty):
                    if let Some(c) = cx.prog.assoc_const(k, name.text):
                        let value = self.def_value(cx, c, name.text, at)
                        match args:
                            case Some(a):
                                return self.call_value(cx, value, a, trailing, at)
                            case None:
                                return value
                # A variant of the type.
                if let Some((def_, vi)) = self.variant_in(cx, ty, name.text):
                    match args:
                        case Some(a):
                            return self.variant_call(cx, def_, vi, a, trailing, at, Some(ty))
                        case None:
                            return self.unit_variant_value(cx, def_, vi, ty, at)
                # An associated function.
                var method: DefId? = None
                if let Some(k) = self.types.key(ty):
                    method = cx.prog.method(k, name.text)
                if let Some(d) = method:
                    match args:
                        case Some(a):
                            var has_self = False
                            if let Some(f) = cx.prog.fn_info(d):
                                has_self = f.self_mode.is_some()
                            if has_self:
                                let diag = self.error(cx, Msg.TypeMethodNeedsReceiver, name.range)
                                self.report(diag.with("name", name.text))
                                self.check_args_loosely(cx, a)
                                return self.error_expr(at)
                            self.check_method_vis(cx, d, name.range)
                            let explicit = self.explicit_method_args.copy()
                            self.explicit_method_args = None
                            return self.call_fn(
                                cx, d, explicit, Some(ty), None, a, trailing, at, expected
                            )
                        case None:
                            self.check_method_vis(cx, d, name.range)
                            return self.def_value(cx, d, name.text, at)
                # A trait's associated constant (`T.SIDES`, `Self.SIDES`,
                # `Square.SIDES`; RULES.md, R37): the call of the function
                # that gives its value, for the type.
                if let Some((tr, m)) = self.trait_static(cx, ty, name.text):
                    if self.is_assoc_const(cx, m):
                        let z = self.infer.zonk(mut self.types, ty)
                        let norm = cx.prog.normalize(mut self.types, z, self.env)
                        var outer = [norm]
                        for t in tr.args:
                            outer.push(t)
                        match args:
                            case Some(a):
                                let value = self.call_fn_with(
                                    cx, m, None, Some(outer), Some(norm), None, [], None, at, None
                                )
                                return self.call_value(cx, value, a, trailing, at)
                            case None:
                                return self.call_fn_with(
                                    cx,
                                    m,
                                    None,
                                    Some(outer),
                                    Some(norm),
                                    None,
                                    [],
                                    None,
                                    at,
                                    expected,
                                )
                if let Some(a) = args:
                    if let Some((tr, m)) = self.trait_static(cx, ty, name.text):
                        var has_self = False
                        if let Some(f) = cx.prog.fn_info(m):
                            has_self = f.self_mode.is_some()
                        if has_self:
                            let diag = self.error(cx, Msg.TypeMethodNeedsReceiver, name.range)
                            self.report(diag.with("name", name.text))
                            self.check_args_loosely(cx, a)
                            return self.error_expr(at)
                        let z = self.infer.zonk(mut self.types, ty)
                        let norm = cx.prog.normalize(mut self.types, z, self.env)
                        var outer = [norm]
                        for t in tr.args:
                            outer.push(t)
                        let explicit = self.explicit_method_args.copy()
                        self.explicit_method_args = None
                        return self.call_fn_with(
                            cx,
                            m,
                            explicit,
                            Some(outer),
                            Some(norm),
                            None,
                            a,
                            trailing,
                            at,
                            expected,
                        )
                let shown = self.show(cx, ty)
                # A name written as a variant's of an enum that has no such
                # variant is `E0327`, as in a pattern, with the variant it
                # most likely means (RULES.md, R45).
                if let Some(d) = self.missing_variant(cx, ty, name, shown):
                    self.report(d)
                    if let Some(a) = args:
                        self.check_args_loosely(cx, a)
                    return self.error_expr(at)
                let diag = self.error(cx, Msg.TypeUnknownAssociated, name.range).with("ty", shown)
                self.report(diag.with("name", name.text))
                if let Some(a) = args:
                    self.check_args_loosely(cx, a)
                return self.error_expr(at)
            case StaticPath.Trait(t):
                return self.trait_path_call(cx, t, name, at, args, trailing, expected)
            case StaticPath.Fn(d, _):
                let owner = cx.prog.defs[d.index].name.copy()
                let diag = self.error(cx, Msg.TypeUnknownField, name.range).with("ty", owner)
                self.report(diag.with("name", name.text))
                return self.error_expr(at)

    ## `E0327` for `Light.Blue`, a CamelCase name after an enum or an error
    ## set that has no such variant (RULES.md, R45), with the variant closest
    ## to it.
    pure def missing_variant(mut self, cx: Cx, ty: Ty, name: Name, shown: str) -> Diagnostic?:
        let TyData.Adt(d, _) = self.types.data(ty) else:
            return None
        let e = cx.prog.enum_info(d) else:
            return None
        let first = name.text.chars().next() else:
            return None
        if not first.is_uppercase():
            return None
        var names: list[String] = []
        for v in e.variants:
            names.push(v.name.copy())
        var diag = self.error(cx, Msg.TypeUnknownVariant, name.range).with("ty", shown)
        diag = diag.with("name", name.text)
        if let Some(similar) = cx.prog.closest(name.text, names):
            let r = name.range
            diag = diag.fix(Msg.ResolveSimilarName, "name", similar, r.start, r.end, similar)
        return Some(diag)

    ## Whether `d` is the function that gives an associated constant
    ## (RULES.md, R37), read as `T.NAME` rather than called.
    pub pure def is_assoc_const(self, cx: Cx, d: DefId) -> bool:
        if let Some(f) = cx.prog.fn_info(d):
            return f.assoc_const
        return False

    ## The one trait method called `name` that `ty` has through the traits
    ## it implements.
    pure def trait_static(mut self, cx: Cx, ty: Ty, name: str) -> (TraitRef, DefId)?:
        let z = self.infer.zonk(mut self.types, ty)
        let norm = cx.prog.normalize(mut self.types, z, self.env)
        let found = cx.prog.trait_methods_for(mut self.types, norm, name, self.env)
        if len(found) == 1:
            return Some(found[0].copy())
        return None

    ## `Trait.method(x, ...)`: the trait's method called on `x`, or, for a
    ## method without `self`, with `Self` inferred from the arguments and
    ## the expected type (`Default.default()`).
    pure def trait_path_call(
        mut self,
        cx: Cx,
        t: DefId,
        name: Name,
        at: TextRange,
        args_in: list[Arg]?,
        trailing: Closure?,
        expected: Ty?,
    ) -> TExprId:
        # A `comptime def` of the trait's, called through it (decision 251).
        var comptime_fn: DefId? = None
        if let Some(info) = cx.prog.trait_info(t):
            for (n, fd) in info.comptime_fns:
                if comptime_fn.is_none() and n == name.text:
                    comptime_fn = Some(fd)
        if let Some(fd) = comptime_fn:
            match args_in:
                case Some(given):
                    let call_args = given.copy()
                    return self.call_fn(cx, fd, None, None, None, call_args, trailing, at, expected)
                case None:
                    let fname = cx.prog.defs[fd.index].name.copy()
                    self.report_other(self.error(cx, Msg.ComptimeOnly, at).with("name", fname))
                    return self.error_expr(at)
        let m = cx.prog.trait_method(t, name.text) else:
            let tname = cx.prog.defs[t.index].name.copy()
            let diag = self.error(cx, Msg.TypeUnknownAssociated, name.range).with("ty", tname)
            self.report(diag.with("name", name.text))
            if let Some(a) = args_in:
                self.check_args_loosely(cx, a)
            return self.error_expr(at)
        # A trait's constant is each type's, read through one (RULES.md,
        # R37).
        if self.is_assoc_const(cx, m):
            let tname = cx.prog.defs[t.index].name.copy()
            var diag = self.error(cx, Msg.TypeTraitConstant, at)
            self.report(diag.with("name", name.text).with("trait", tname))
            if let Some(a) = args_in:
                self.check_args_loosely(cx, a)
            return self.error_expr(at)
        if args_in.is_none():
            let text = self.source_text(cx, at)
            var diag = self.error(cx, Msg.TypeNotAValue, at)
            diag = diag.with("name", text).with("kind", "trait method")
            self.report(diag)
            return self.error_expr(at)
        let args = args_in.copy() ?? []
        # The trait's own parameters: inferred, or their defaults.
        var targs: list[Ty] = []
        if let Some(info) = cx.prog.trait_info(t):
            for _ in info.generics:
                targs.push(self.infer.fresh(mut self.types))
        let tr = TraitRef(def_=t, args=targs)
        var has_self = False
        if let Some(f) = cx.prog.fn_info(m):
            has_self = f.self_mode.is_some()
        if has_self:
            if args.is_empty():
                var d = self.error(cx, Msg.TypeArgumentCount, at)
                d = d.with("name", name.text).with("expected", "1 or more").with("found", "0")
                self.report(d)
                return self.error_expr(at)
            let recv0 = self.infer_expr(cx, args[0].value, None)
            let recv = self.auto_deref(recv0)
            let z = self.infer.zonk(mut self.types, self.ty_of(recv))
            let self_ty = cx.prog.normalize(mut self.types, z, self.env)
            self.bounds.push((self_ty, tr.copy(), self.span_of(recv)))
            var rest: list[Arg] = []
            for i in range(1, len(args)):
                rest.push(args[i].copy())
            return self.trait_call(cx, m, tr, recv, self_ty, name, rest, trailing, at, expected)
        let self_ty = self.infer.fresh(mut self.types)
        self.bounds.push((self_ty, tr.copy(), at))
        var outer = [self_ty]
        for a in tr.args:
            outer.push(a)
        return self.call_fn_with(cx, m, None, Some(outer), None, None, args, trailing, at, expected)

    pure def unit_variant_value(
        mut self, cx: Cx, def_: DefId, vi: int, ty: Ty, at: TextRange
    ) -> TExprId:
        if let Some(e) = cx.prog.enum_info(def_):
            if vi < len(e.variants) and not e.variants[vi].fields.is_empty():
                let name = e.variants[vi].name.copy()
                let d = self.error(cx, Msg.TypeVariantNeedsFields, at).with("name", name)
                self.report(d)
                return self.error_expr(at)
        let (owner, _) = self.variant_owner_ty(cx, def_, Some(ty))
        return self.add(TExprKind.Variant(def_=def_, variant=vi, args=[]), owner, at)

    # ---------------------------------------------------------------- calls

    pub pure def call_expr(
        mut self,
        cx: Cx,
        callee: ExprId,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        match cx.ast.expr(callee).kind:
            case ExprKind.Field(base, name):
                if let Some(path) = self.static_path(cx, base):
                    return self.static_member(
                        cx, path, name, at, Some(args.copy()), trailing, expected
                    )
                let recv = self.infer_expr(cx, base, None)
                return self.method_call_on(cx, recv, name, args, trailing, at, expected)
            case ExprKind.OptField(base, name):
                return self.opt_chain(cx, base, name, Some(args.copy()), trailing, at)
            case ExprKind.Index(inner, targs):
                if self.generator_kind(cx, inner).is_some():
                    return self.generator_site(
                        cx, callee, inner, targs, Some(args.copy()), at, expected
                    )
                match self.static_path(cx, callee):
                    case Some(StaticPath.Fn(d, tys)):
                        return self.call_fn(cx, d, tys, None, None, args, trailing, at, expected)
                    case Some(StaticPath.Type(ty)):
                        return self.construct(cx, ty, args, trailing, at, expected)
                    case _:
                        # `Deque[int]()` of a type nothing declares, or an
                        # import that failed bound: the name is reported
                        # once, and its arguments are not read as values
                        # (RULES.md, R101).
                        if let ExprKind.Name(n) = cx.ast.expr(inner).kind:
                            let upper = n.byte_len() > 0
                                and n.byte_at(0) >= 65
                                and n.byte_at(0) <= 90
                            if upper
                                    and self.lookup_local(n).is_none()
                                    and cx.prog.lookup(self.module, n).is_none():
                                let x = self.infer_expr(cx, inner, None)
                                if self.ty_of(x) == Ty.error():
                                    self.check_args_loosely(cx, args)
                                    return x
                        # `Type.function[T](...)`: an associated function with
                        # the type arguments of its own generic parameters, as
                        # `f[T](...)` gives a free function's (RULES.md, R18).
                        if let ExprKind.Field(base, name) = cx.ast.expr(inner).kind:
                            if let Some(StaticPath.Type(ty)) = self.static_path(cx, base):
                                var tys: list[Ty] = []
                                for a in targs:
                                    match a:
                                        case IndexArg.Expr(x):
                                            tys.push(self.expr_as_type(cx, x))
                                        case _:
                                            tys.push(Ty.error())
                                self.explicit_method_args = Some(tys)
                                let x = self.static_member(
                                    cx,
                                    StaticPath.Type(ty),
                                    name,
                                    at,
                                    Some(args.copy()),
                                    trailing,
                                    expected,
                                )
                                self.explicit_method_args = None
                                return x
                        # `x.method[T](...)`: a method with its type arguments.
                        if let ExprKind.Field(base, name) = cx.ast.expr(inner).kind:
                            if self.static_path(cx, base).is_none():
                                var tys: list[Ty] = []
                                for a in targs:
                                    match a:
                                        case IndexArg.Expr(x):
                                            tys.push(self.expr_as_type(cx, x))
                                        case _:
                                            tys.push(Ty.error())
                                let recv = self.infer_expr(cx, base, None)
                                self.explicit_method_args = Some(tys)
                                let x = self.method_call_on(
                                    cx, recv, name, args, trailing, at, expected
                                )
                                self.explicit_method_args = None
                                return x
            case ExprKind.SelfType:
                if let Some(t) = self.self_ty:
                    return self.construct(cx, t, args, trailing, at, expected)
            case ExprKind.Name(n):
                if n == "old"
                        and self.lookup_local(n).is_none()
                        and cx.prog.lookup(self.module, n).is_none():
                    return self.old_expr(cx, args, trailing, at)
                if self.lookup_local(n).is_none() and n != "it":
                    if let Some(exp) = expected:
                        if let Some((def_, vi)) = self.variant_in(cx, exp, n):
                            return self.variant_call(cx, def_, vi, args, trailing, at, Some(exp))
                    let callee_range = cx.ast.expr(callee).range
                    if let Some(d) = cx.prog.lookup(self.module, n):
                        # A trait is no value: a variant of that name is
                        # what a call means (RULES.md, R13).
                        if let DefKind.Trait(_) = cx.prog.defs[d.index].kind():
                            if let Some((def_, vi)) = self.global_variant(cx, n, callee_range):
                                return self.variant_call(cx, def_, vi, args, trailing, at, expected)
                        var embed = False
                        if let Some(f) = cx.prog.fn_info(d):
                            if let Some(i) = f.intrinsic:
                                embed = i == "compiler.embed"
                        if embed:
                            return self.embed_call(cx, args, trailing, at)
                        return self.call_def(cx, d, None, args, trailing, at, expected)
                    if let Some((def_, vi)) = self.global_variant(cx, n, callee_range):
                        return self.variant_call(cx, def_, vi, args, trailing, at, expected)
                    if not self.quiet_unknown_names
                            and not cx.prog.poisoned.contains(n.to_string()):
                        self.undefined_name(cx, n, callee_range)
                    self.unresolved_call()
                    self.check_args_loosely(cx, args)
                    return self.error_expr(at)
            case _:
                pass
        let f = self.infer_expr(cx, callee, None)
        return self.call_value(cx, f, args, trailing, at)

    ## Calls a declaration: a function, a struct's constructor, a constant
    ## holding a function.
    pub pure def call_def(
        mut self,
        cx: Cx,
        d: DefId,
        tys: list[Ty]?,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        match cx.prog.defs[d.index].kind():
            case DefKind.Fn(f):
                if f.self_mode.is_some():
                    let name = cx.prog.defs[d.index].name.copy()
                    let diag = self.error(cx, Msg.TypeMethodNeedsReceiver, at).with("name", name)
                    self.report(diag)
                    self.check_args_loosely(cx, args)
                    return self.error_expr(at)
                # Python's `max(xs)` and `min(xs)` over a collection (02):
                # the prelude's `max_of` and `min_of` (RULES.md, R35).
                if let Some(of) = self.extreme_of(cx, d, args, trailing):
                    return self.call_fn(cx, of, tys, None, None, args, trailing, at, expected)
                return self.call_fn(cx, d, tys, None, None, args, trailing, at, expected)
            case DefKind.Struct(_) | DefKind.Enum(_) | DefKind.ErrorSet(_) | DefKind.TypeAlias(_):
                let ty = self.def_type(cx, d, tys.copy() ?? [], at)
                return self.construct(cx, ty, args, trailing, at, expected)
            case DefKind.Const(_):
                let name = cx.prog.defs[d.index].name.copy()
                let f = self.def_value(cx, d, name, at)
                return self.call_value(cx, f, args, trailing, at)
            case _:
                let name = cx.prog.defs[d.index].name.copy()
                let diag = self.error(cx, Msg.TypeNotCallable, at).with("ty", name)
                self.report(diag)
                self.check_args_loosely(cx, args)
                return self.error_expr(at)

    ## For a call of the prelude's `max` or `min` with one argument, given
    ## by position: the function of the items of a collection, `max_of` or
    ## `min_of`.
    pure def extreme_of(self, cx: Cx, d: DefId, args: list[Arg], trailing: Closure?) -> DefId?:
        if trailing.is_some() or len(args) != 1 or args[0].name.is_some():
            return None
        if cx.prog.defs[d.index].module != cx.prog.prelude:
            return None
        let name = cx.prog.defs[d.index].name.copy()
        if name != "max" and name != "min":
            return None
        return cx.prog.lookup_in(cx.prog.prelude, "{name}_of")

    ## `T(...)` for a type: a struct's fields, or `new` for a builtin type.
    pub pure def construct(
        mut self, cx: Cx, ty: Ty, args: list[Arg], trailing: Closure?, at: TextRange, expected: Ty?
    ) -> TExprId:
        let TyData.Adt(def_, targs) = self.data(ty) else:
            if ty != Ty.error():
                let shown = self.show(cx, ty)
                let d = self.error(cx, Msg.TypeNotCallable, at).with("ty", shown)
                self.report(d)
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        let s = cx.prog.struct_info(def_) else:
            let shown = self.show(cx, ty)
            let d = self.error(cx, Msg.TypeNotCallable, at).with("ty", shown)
            self.report(d)
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        if s.builtin.is_some():
            if let Some(new) = cx.prog.method(TyKey.Adt(def_), "new"):
                let owner = self.types.adt(def_, targs)
                return self.call_fn(cx, new, None, Some(owner), None, args, trailing, at, expected)
            let shown = self.show(cx, ty)
            let d = self.error(cx, Msg.TypeNoConstructor, at).with("ty", shown)
            self.report(d)
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        # The type expected gives the type arguments first, so that each
        # field is checked against its type (`let r: Reading[f64, String] =
        # Reading(21.5, "°C")` makes the text a `String`; RULES.md, R26).
        # A type argument the value is coerced to (a `dyn`) is the
        # coercion's, after the struct is made, and one the checker has not
        # told yet tells nothing.
        if let Some(e) = expected:
            let ez = self.infer.zonk(mut self.types, e)
            if let TyData.Adt(ed, eargs) = self.data(ez):
                var plain = len(eargs) == len(targs) and not targs.is_empty()
                for t in self.types.walk(ez):
                    match self.types.data(t):
                        case TyData.Dyn(_) | TyData.Var(_) | TyData.Error:
                            plain = False
                        case _:
                            pass
                if ed == def_ and plain:
                    _ = self.infer.try_unify(mut self.types, ty, ez)
        # Fields by position, then by name.
        let n = len(s.fields)
        var slots: list[int?] = []
        for _ in range(n):
            slots.push(None)
        var pos = 0
        var seen_kw = False
        let tyname = self.show(cx, ty)
        for k in range(len(args)):
            let a = ref args[k]
            match a.name:
                case Some(key):
                    seen_kw = True
                    var found: int? = None
                    for i in range(n):
                        if s.fields[i].name == key.text and found.is_none():
                            found = Some(i)
                    match found:
                        case Some(i):
                            if slots[i].is_none():
                                slots[i] = Some(k)
                            else:
                                var d = self.error(cx, Msg.TypeDuplicateArgument, key.range)
                                d = d.with("arg", key.text)
                                self.report(d)
                        case None:
                            var d = self.error(cx, Msg.TypeUnknownField, key.range)
                            d = d.with("ty", tyname).with("name", key.text)
                            self.report(d)
                case None:
                    if seen_kw:
                        # Bound to the first field still unset that no
                        # keyword names.
                        var free: int? = None
                        for i in range(n):
                            if free.is_none() and slots[i].is_none():
                                var named = False
                                for b in args:
                                    if let Some(bk) = b.name:
                                        if bk.text == s.fields[i].name:
                                            named = True
                                if not named:
                                    free = Some(i)
                        var free_name: String? = None
                        if let Some(i) = free:
                            free_name = Some(s.fields[i].name.copy())
                        self.positional_after_keyword(cx, a.range, free_name)
                        if let Some(i) = free:
                            slots[i] = Some(k)
                        pos += 1
                        continue
                    if pos < n:
                        slots[pos] = Some(k)
                    else:
                        var d = self.error(cx, Msg.TypeArgumentCount, at)
                        d = d.with("name", tyname).with("expected", "{n}")
                        d = d.with("found", "{len(args)}")
                        self.report(d)
                    pos += 1
        if trailing.is_some():
            var d = self.error(cx, Msg.TypeArgumentCount, at)
            d = d.with("name", tyname).with("expected", "{n}").with("found", "{len(args) + 1}")
            self.report(d)
        # A struct of another module is built there only when every field
        # is visible (09).
        let home = cx.prog.defs[def_.index].module
        for i in range(n):
            if not cx.prog.vis_allows(s.fields[i].vis, home, self.module):
                var written = at
                if let Some(k) = slots[i]:
                    if let Some(key) = args[k].name:
                        written = key.range
                self.check_field_vis(cx, def_, i, written)
                break
        var fields: list[FieldInit] = []
        for i in range(n):
            let f = ref s.fields[i]
            let fty = self.types.subst(f.ty, targs)
            match slots[i]:
                case Some(k):
                    let x = self.check_expr(cx, args[k].value, fty)
                    fields.push(FieldInit.Value(self.check_movable(cx, x)))
                case None:
                    if f.default.is_some():
                        fields.push(FieldInit.Default(i))
                    else:
                        var d = self.error(cx, Msg.TypeMissingField, at)
                        d = d.with("field", f.name).with("ty", tyname)
                        if let Some(edit) = self.hole_edit(cx, at, "{f.name}=todo(\"{f.name}\")"):
                            let name = Param(name="name".to_string(), value=f.name.copy())
                            d = d.fix_params(Msg.TypeAddHole, [name], [edit])
                        self.report(d)
                        fields.push(FieldInit.Value(self.error_expr(at)))
        let result = self.types.adt(def_, targs)
        return self.add(TExprKind.Struct(def_=def_, fields=fields), result, at)

    ## `Variant(args)`.
    pub pure def variant_call(
        mut self,
        cx: Cx,
        def_: DefId,
        vi: int,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        let (ty, targs) = self.variant_owner_ty(cx, def_, expected)
        let e = cx.prog.enum_info(def_) else:
            return self.error_expr(at)
        if vi >= len(e.variants):
            return self.error_expr(at)
        let v = ref e.variants[vi]
        let n = len(v.fields)
        var slots: list[int?] = []
        for _ in range(n):
            slots.push(None)
        var pos = 0
        for k in range(len(args)):
            let a = ref args[k]
            match a.name:
                case Some(key):
                    var found: int? = None
                    for i in range(n):
                        if let Some(fname) = v.fields[i].0:
                            if fname == key.text and found.is_none():
                                found = Some(i)
                    var placed = False
                    if let Some(i) = found:
                        if slots[i].is_none():
                            slots[i] = Some(k)
                            placed = True
                    if not placed:
                        var d = self.error(cx, Msg.TypeUnknownKeyword, key.range)
                        d = d.with("name", v.name).with("arg", key.text)
                        self.report(d)
                case None:
                    if pos < n:
                        slots[pos] = Some(k)
                    pos += 1
        if pos > n or trailing.is_some():
            var found = len(args)
            if trailing.is_some():
                found += 1
            var d = self.error(cx, Msg.TypeArgumentCount, at)
            d = d.with("name", v.name).with("expected", "{n}").with("found", "{found}")
            self.report(d)
        var out: list[TExprId] = []
        for i in range(n):
            let fty = self.types.subst(v.fields[i].1, targs)
            match slots[i]:
                case Some(k):
                    let x = self.check_expr(cx, args[k].value, fty)
                    out.push(self.check_movable(cx, x))
                case None:
                    let shown = v.fields[i].0.copy() ?? "{i}"
                    var d = self.error(cx, Msg.TypeMissingArgument, at)
                    d = d.with("arg", shown).with("name", v.name)
                    self.report(d)
                    out.push(self.error_expr(at))
        return self.add(TExprKind.Variant(def_=def_, variant=vi, args=out), ty, at)

    ## Instantiates a function's signature with fresh type variables, or
    ## the explicit type arguments for its own generic parameters; its
    ## bounds are required of the arguments.
    pub pure def instantiate(
        mut self, cx: Cx, d: DefId, explicit: list[Ty]?, at: TextRange
    ) -> InstSig:
        let f = cx.prog.fn_info(d) else:
            return InstSig(
                def_=d,
                name=String.new(),
                params=[],
                ret=Ty.error(),
                owner=None,
                type_args=[],
                keyword_only_from=None,
                positional_only_until=0,
            )
        let own_count = len(f.generics) - f.impl_generics
        if let Some(ex) = explicit:
            if len(ex) != own_count:
                if own_count == 0:
                    let name = cx.prog.defs[d.index].name.copy()
                    let diag = self.error(cx, Msg.TypeNotGeneric, at).with("name", name)
                    self.report(diag)
                else:
                    let name = cx.prog.defs[d.index].name.copy()
                    var diag = self.error(cx, Msg.ResolveTypeArgumentCount, at).with("name", name)
                    diag = diag.with("expected", "{own_count}").with("found", "{len(ex)}")
                    self.report_other(diag)
        var vars: list[Ty] = []
        for i in range(len(f.generics)):
            var v: Ty? = None
            if i >= f.impl_generics:
                if let Some(ex) = explicit:
                    if i - f.impl_generics < len(ex):
                        v = Some(ex[i - f.impl_generics])
            vars.push(v ?? self.infer.fresh(mut self.types))
        for p in f.predicates:
            # A trait method's `Self: Trait` asks for an impl; any other
            # predicate is a bound.
            let own_trait = f.trait_ == Some(p.bound.def_) and p.ty == self.types.param(0)
            let t = self.types.subst(p.ty, vars)
            let b = self.types.subst_trait(p.bound, vars)
            if own_trait:
                self.impl_bounds.push((t, b, at))
            else:
                self.bounds.push((t, b, at))
        let has_body = f.intrinsic.is_none()
        let fenv = cx.prog.elaborate_env(mut self.types, f.predicates)
        var params: list[InstParam] = []
        for p in f.params:
            # A parameter the body takes by reference whatever the type
            # arguments are: its type holds the function's type parameters
            # and is not `Copy` by their bounds (a `T`, a `(T, T)`). An
            # argument of a `Copy` instance is borrowed for it all the same
            # (RULES.md, R23).
            var opaque = False
            if has_body and self.types.has_params(p.ty):
                match self.types.data(p.ty):
                    case TyData.Param(_) | TyData.Assoc(_, _, _):
                        opaque = not cx.prog.is_copy_in(mut self.types, p.ty, fenv)
                    case TyData.Ref(_, _):
                        pass
                    case _:
                        # A type some of whose instances are `Copy` (a tuple,
                        # an option, a type that derives `Copy`), which the
                        # function takes by reference.
                        var ints: list[Ty] = []
                        for _ in f.generics:
                            ints.push(Ty.int())
                        let instance = self.types.subst(p.ty, ints)
                        if cx.prog.is_copy(mut self.types, instance):
                            let local = param_local_ty(
                                cx.prog, mut self.types, p.ty, Mode.Borrow, fenv
                            )
                            if let TyData.Ref(_, _) = self.types.data(local):
                                opaque = True
            let ty = self.types.subst(p.ty, vars)
            params.push(
                InstParam(
                    name=p.name.copy(),
                    mode=p.mode,
                    ty=ty,
                    has_default=p.default.is_some(),
                    opaque=opaque,
                )
            )
        let ret0 = self.fn_ret(cx, d)
        let ret = self.types.subst(ret0, vars)
        var owner: Ty? = None
        if let Some(o) = f.owner:
            owner = Some(self.types.subst(o, vars))
        return InstSig(
            def_=d,
            name=cx.prog.defs[d.index].name.copy(),
            params=params,
            ret=ret,
            owner=owner,
            type_args=vars,
            keyword_only_from=f.keyword_only_from,
            positional_only_until=f.positional_only_until,
        )

    ## Calls a function given its definition. `owner` is the type a static
    ## call names; `recv` the receiver argument of a method call.
    pub pure def call_fn(
        mut self,
        cx: Cx,
        d: DefId,
        tys: list[Ty]?,
        owner: Ty?,
        recv: TArg?,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        return self.call_fn_with(cx, d, tys, None, owner, recv, args, trailing, at, expected)

    ## `call_fn` where the outer generic parameters are known: for a
    ## trait's method, `Self` and the trait's arguments.
    pub pure def call_fn_with(
        mut self,
        cx: Cx,
        d: DefId,
        tys: list[Ty]?,
        outer: list[Ty]?,
        owner: Ty?,
        recv: TArg?,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        let f = cx.prog.fn_info(d) else:
            return self.error_expr(at)
        if f.comptime_ and not self.in_comptime:
            let name = cx.prog.defs[d.index].name.copy()
            self.report_other(self.error(cx, Msg.ComptimeOnly, at).with("name", name))
        self.check_internal(cx, d, at)
        # Calling an `unsafe def` or a foreign function is an unsafe
        # operation (22).
        self.unsafe_call(cx, d, f, at)
        # A pure body's calls are checked on SIR, by stage 0's ownership
        # checker (E0333); inside an `unsafe` block, one asserts it keeps
        # the body pure (D-085).
        if not f.pure and self.body_is_pure(cx):
            self.impure_call(cx, d, at)
            self.owner_go_beyond("a call of an impure function from a pure one")
        if f.header_broken:
            # Its signature is unknown: check the arguments on their own.
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        let intrinsic = f.intrinsic.copy() ?? String.new()
        var sig = self.instantiate(cx, d, tys, at)
        if let Some(o) = outer:
            for i in range(min(len(sig.type_args), len(o))):
                _ = self.infer.try_unify(mut self.types, sig.type_args[i], o[i])
        # A method of an impl for some of a type's values is not one of the
        # others.
        if let Some(o) = owner:
            if let Some(so) = sig.owner:
                if not self.infer.try_unify(mut self.types, so, o)
                        and recv.is_some()
                        and not self.infer.has_vars(mut self.types, o)
                        and o != Ty.error():
                    let shown = self.show(cx, o)
                    let name = cx.prog.defs[d.index].name.copy()
                    var diag = self.error(cx, Msg.TypeUnknownMethod, at)
                    diag = diag.with("ty", shown).with("name", name)
                    self.report(diag)
                    self.check_args_loosely(cx, args)
                    return self.error_expr(at)
        # Associated types of what is known now.
        for i in range(len(sig.params)):
            let z = self.infer.zonk(mut self.types, sig.params[i].ty)
            sig.params[i].ty = cx.prog.normalize(mut self.types, z, self.env)
        let zr = self.infer.zonk(mut self.types, sig.ret)
        sig.ret = cx.prog.normalize(mut self.types, zr, self.env)
        # An associated type of a type the arguments have not told yet
        # (`Iter[I.Item]` while `I` is unknown) cannot be compared with
        # anything before it is normalised, so the expected type does not
        # drive such a call (decision 252).
        var unknown_projection = False
        for x in self.types.walk(sig.ret):
            if let TyData.Assoc(_, _, _) = self.types.data(x):
                if self.infer.has_vars(mut self.types, x):
                    unknown_projection = True
        if let Some(exp) = expected:
            # Let the expected type drive inference (`list()`, `todo()`).
            if self.infer.has_vars(mut self.types, sig.ret) and not unknown_projection:
                let snap = self.infer.snapshot()
                if not self.infer.unify(mut self.types, sig.ret, exp):
                    self.infer.rollback(snap)
        # A `comptime def`'s `T: type` parameters take types, which are the
        # call's type arguments (decision 251): `field_names(Point)`.
        var given_args = args.copy()
        let typed = f.type_params.copy()
        if not typed.is_empty():
            var rest: list[Arg] = []
            var given: list[bool] = []
            for _ in typed:
                given.push(False)
            var position = 0
            for a in args:
                var k: int? = None
                match a.name:
                    case Some(n):
                        for j in range(len(typed)):
                            if k.is_none() and typed[j].1 == n.text:
                                k = Some(j)
                    case None:
                        for j in range(len(typed)):
                            if k.is_none() and typed[j].0 == position:
                                k = Some(j)
                        position += 1
                match k:
                    case Some(j):
                        let t = self.expr_as_type(cx, a.value)
                        if typed[j].2 < len(sig.type_args):
                            _ = self.infer.try_unify(mut self.types, sig.type_args[typed[j].2], t)
                        given[j] = True
                    case None:
                        rest.push(a.copy())
            for j in range(len(typed)):
                if not given[j]:
                    var d_ = self.error(cx, Msg.TypeMissingArgument, at).with("arg", typed[j].1)
                    self.report(d_.with("name", cx.prog.defs[d.index].name))
                    break
            given_args = rest
        var out: list[TArg] = []
        if let Some(r) = recv:
            out.push(r)
        let task = task_call(intrinsic)
        let spawns_before = len(self.spawn_sites)
        # `range(n)` is `range(0, n)` (02, "Prelude functions").
        if Some(d) == cx.prog.wk.range
                and len(given_args) == 1
                and given_args[0].name.is_none()
                and len(sig.params) >= 2:
            let p = sig.params[1].copy()
            let start = given_args[0].range.start
            let zero = self.add(TExprKind.Int(0), Ty.int(), TextRange.empty(start))
            out.push(TArg(expr=zero, mode=ArgMode.Value))
            out.push(self.check_arg(cx, arg_in(cx.ast, given_args[0]), p))
            # The parameters after the two take their defaults, as for any
            # call that omits them.
            for i in range(2, len(sig.params)):
                if sig.params[i].has_default:
                    out.push(self.default_arg(cx, sig, i, at))
        else:
            for x in self.check_args(cx, sig, given_args, trailing, at):
                out.push(x)
        let zret = self.infer.zonk(mut self.types, sig.ret)
        var ret = cx.prog.normalize(mut self.types, zret, self.env)
        if let Some(tc) = task:
            let text = self.source_text(cx, at)
            let function = call_name(text)
            ret = self.task_rules(cx, tc, out, ret, spawns_before, at, function)
        # What a `Shared`, `Cell`, `Mutex` or channel owns can be neither a
        # view nor must-consume (checked when the type is known): a
        # channel's receiver may keep what was sent longer than what it
        # borrows lives (decision 230).
        var atomic = False
        if let TyData.Adt(a, _) = self.types.data(self.resolved(ret)).copy():
            atomic = cx.prog.builtin(a) == Some("Atomic")
        var owner_name: String? = None
        if intrinsic == "Shared.new":
            owner_name = Some("Shared".to_string())
        elif intrinsic == "Cell.new" and atomic:
            # An `Atomic` is a `Cell` tasks may share.
            owner_name = Some("Atomic".to_string())
        elif intrinsic == "Cell.new":
            owner_name = Some("Cell".to_string())
        elif intrinsic == "Mutex.new":
            owner_name = Some("Mutex".to_string())
        elif intrinsic == "RwLock.new":
            owner_name = Some("RwLock".to_string())
        elif intrinsic == "Cap.new":
            owner_name = Some("Cap".to_string())
        elif intrinsic == "channel":
            owner_name = Some("channel".to_string())
        if let Some(o) = owner_name:
            if let Some(t) = sig.type_args.first():
                self.owner_checks.push((t, o.copy(), at))
        # What a channel carries is `Send` (RULES.md, R1): a closure is
        # checked where it is sent, and a value of a type parameter by the
        # parameter's bounds, once types and captures are known.
        # The value is the last argument, after the receiver.
        if intrinsic == "Sender.send" or intrinsic == "Sender.try_send":
            if len(out) >= 2 and not sig.params.is_empty():
                let text = self.source_text(cx, at)
                let elem = sig.params[len(sig.params) - 1].ty
                let arg = out[len(out) - 1].expr
                let sent = SendCheck(elem=elem, arg=arg, span=at, function=call_name(text))
                self.send_checks.push(sent)
        # A typed hole is reported with the type it stands for (D-061).
        if intrinsic == "todo":
            var name = String.new()
            if let Some(first) = out.first():
                if let TExprKind.Str(s) = self.exprs[first.expr.index].kind:
                    name = s.copy()
            let shown = self.show(cx, self.resolved(sig.ret))
            let diag = self.error(cx, Msg.TypeHole, at).with("name", name).with("ty", shown)
            self.report(diag)
        let call = TExprKind.Call(
            callee=Callee.Fn(def_=d, type_args=sig.type_args.copy()), args=out
        )
        return self.add(call, ret, at)

    ## Whether the body is pure: declared so, or the impl of a trait's pure
    ## method.
    pub pure def body_is_pure(self, cx: Cx) -> bool:
        let f = cx.prog.fn_info(self.def_) else:
            return False
        return f.pure

    ## A positional argument after a keyword one (E0376), with the fix that
    ## names it as `name`.
    pure def positional_after_keyword(mut self, cx: Cx, range: TextRange, name: String?):
        var d = self.error(cx, Msg.TypePositionalAfterKeyword, range)
        if let Some(n) = name:
            if not n.is_empty():
                let edit = Edit(start=range.start, end=range.start, text="{n}=")
                let named = Param(name="name".to_string(), value=n.copy())
                d = d.fix_params(Msg.TypeNameArgument, [named], [edit])
        self.report(d)

    ## The edit that adds an argument (`todo("b")`, `y=todo("y")`) at the
    ## end of the call written at `at`, before its `)`.
    pub pure def hole_edit(self, cx: Cx, at: TextRange, arg: str) -> Edit?:
        let text = cx.source.byte_slice(at.start, at.end)
        let trimmed = text.trim_end()
        if not trimmed.ends_with(")"):
            return None
        let close = at.start + trimmed.byte_len() - 1
        let before = cx.source.byte_slice(at.start, close).trim_end()
        let insert = if before.ends_with("("): arg.to_string() else: ", {arg}"
        let pos = at.start + before.byte_len()
        return Some(Edit(start=pos, end=pos, text=insert))

    ## Matches arguments to parameters and checks each.
    ## The argument a call that omits parameter `i` passes: its default, a
    ## temporary passed as an argument written there would be.
    pure def default_arg(mut self, cx: Cx, sig: InstSig, i: int, at: TextRange) -> TArg:
        let p = ref sig.params[i]
        var mode = ArgMode.Value
        match p.mode:
            case Mode.Own:
                mode = ArgMode.Value
            case Mode.Mut:
                mode = ArgMode.BorrowMut
            case Mode.Borrow:
                if p.opaque:
                    mode = ArgMode.Ref
                elif self.is_copy(cx, p.ty):
                    mode = ArgMode.Value
                else:
                    mode = ArgMode.Borrow
        let x = self.add(TExprKind.DefaultArg(def_=sig.def_, param=i), p.ty, at)
        return TArg(expr=x, mode=mode)

    pub pure def check_args(
        mut self, cx: Cx, sig: InstSig, args: list[Arg], trailing: Closure?, at: TextRange
    ) -> list[TArg]:
        let n = len(sig.params)
        var slots: list[ArgIn?] = []
        for _ in range(n):
            slots.push(None)
        let kw_from = sig.keyword_only_from ?? n
        var pos = 0
        var seen_kw = False
        var extra = False
        for k in range(len(args)):
            let a = ref args[k]
            match a.name:
                case Some(key):
                    seen_kw = True
                    var found: int? = None
                    for i in range(n):
                        if sig.params[i].name == key.text and found.is_none():
                            found = Some(i)
                    var named = False
                    if let Some(i) = found:
                        if i >= sig.positional_only_until:
                            named = True
                            if slots[i].is_some():
                                var d = self.error(cx, Msg.TypeDuplicateArgument, key.range)
                                d = d.with("arg", key.text)
                                self.report(d)
                            else:
                                slots[i] = Some(arg_in(cx.ast, a))
                    if not named:
                        var d = self.error(cx, Msg.TypeUnknownKeyword, key.range)
                        d = d.with("name", sig.name).with("arg", key.text)
                        # A positional-only parameter passed by its name,
                        # `parse(value=s)`: it is passed without the name,
                        # and taken as passed, so that no `E0308` follows
                        # (RULES.md, R76).
                        if let Some(i) = found:
                            if slots[i].is_none():
                                let vr = cx.ast.expr(a.value).range
                                d = d.note_with(Msg.TypePositionalOnly, "arg", key.text)
                                self.report(
                                    d.fix_at(Msg.TypeDropName, key.range.start, vr.start, "")
                                )
                                slots[i] = Some(arg_in(cx.ast, a))
                                if i == pos:
                                    pos += 1
                                continue
                        # A misspelt parameter's name, `prot=443` for `port`
                        # (RULES.md, R45), when no parameter has it.
                        if found.is_none():
                            var names: list[String] = []
                            for i in range(sig.positional_only_until, n):
                                names.push(sig.params[i].name.copy())
                            if let Some(similar) = cx.prog.closest(key.text, names):
                                let r = key.range
                                d = d.fix(
                                    Msg.ResolveSimilarName, "name", similar, r.start, r.end, similar
                                )
                        # Python's `sorted(xs, key=len)`, `max(xs, key=f)`:
                        # Sisu compares by a key with `sort_by` and picks by
                        # one with `max_by` and `min_by` (RULES.md, R25).
                        let by_key = key.text == "key"
                        if by_key
                                and (
                                    sig.name == "sorted" or sig.name == "max" or sig.name == "min"
                                ):
                            d = d.note(Msg.TypeSortByKey)
                        # Python's `enumerate(xs, start=1)`: Sisu's counts from
                        # 0 (RULES.md, R63).
                        if key.text == "start" and sig.name == "enumerate":
                            d = d.note(Msg.TypeEnumerateStart)
                        self.report(d)
                        # A function named as the value (`key=len`) is no
                        # error of its own.
                        var bare = False
                        if let ExprKind.Name(_) = cx.ast.expr(a.value).kind:
                            bare = True
                        if not bare:
                            _ = self.infer_expr(cx, a.value, None)
                case None:
                    if seen_kw:
                        # Bound to the first parameter still unset that a
                        # keyword may name and none does.
                        var free: int? = None
                        for i in range(sig.positional_only_until, n):
                            if free.is_none() and slots[i].is_none():
                                var named = False
                                for b in args:
                                    if let Some(bk) = b.name:
                                        if bk.text == sig.params[i].name:
                                            named = True
                                if not named:
                                    free = Some(i)
                        var free_name: String? = None
                        if let Some(i) = free:
                            free_name = Some(sig.params[i].name.copy())
                        self.positional_after_keyword(cx, a.range, free_name)
                        match free:
                            case Some(i):
                                slots[i] = Some(arg_in(cx.ast, a))
                            case None:
                                _ = self.infer_expr(cx, a.value, None)
                        pos += 1
                        continue
                    if pos < kw_from and pos < n:
                        slots[pos] = Some(arg_in(cx.ast, a))
                    else:
                        extra = True
                        _ = self.infer_expr(cx, a.value, None)
                    pos += 1
        var trailing_extra = False
        if let Some(c) = trailing:
            # A `do` block binds to the last function-typed parameter.
            var target: int? = None
            var i = n - 1
            while i >= 0 and target.is_none():
                if let TyData.Fn(_, _, _) = self.data(sig.params[i].ty):
                    target = Some(i)
                i -= 1
            var placed = False
            if let Some(t) = target:
                if slots[t].is_none():
                    slots[t] = Some(
                        ArgIn(
                            name=None,
                            mutable=False,
                            value=None,
                            closure=Some(c.copy()),
                            range=c.range,
                            value_range=c.range,
                        )
                    )
                    placed = True
            if not placed:
                extra = True
                trailing_extra = True
        if extra:
            # With keyword-only parameters, the positional ones are counted
            # against the arguments without a name (PEP 3102: "takes 1
            # positional argument but 2 were given"); otherwise every
            # parameter is counted against every argument.
            var expected = n
            var found = len(args)
            if trailing.is_some():
                found += 1
            if let Some(k) = sig.keyword_only_from:
                expected = k
                found = if trailing_extra: 1 else: 0
                for a in args:
                    if a.name.is_none():
                        found += 1
            var d = self.error(cx, Msg.TypeArgumentCount, at)
            d = d.with("name", sig.name).with("expected", "{expected}").with("found", "{found}")
            # Too many by position where the next parameter is keyword-only:
            # it takes its name (RULES.md, R45).
            if let Some(k) = sig.keyword_only_from:
                if k < n and found > expected:
                    d = d.note_with(Msg.TypeKeywordOnly, "param", sig.params[k].name)
            # Python's `d.get(k, default)`: `get` gives an option, whose
            # default `??` gives (RULES.md, R76).
            if sig.name == "get" and n == 1 and len(args) == 2 and trailing.is_none():
                if args[0].name.is_none()
                        and args[1].name.is_none()
                        and self.is_option(cx, sig.ret):
                    let first = cx.ast.expr(args[0].value).range
                    let second = cx.ast.expr(args[1].value).range
                    let call = cx.source.byte_slice(at.start, first.end)
                    let default = cx.source.byte_slice(second.start, second.end)
                    d = d.fix_at(Msg.TypeGetDefault, at.start, at.end, "{call}) ?? {default}")
            # Python's `print(a, b)`: one text with the values in it (02,
            # "Prelude functions"; R16).
            if (sig.name == "print" or sig.name == "print_err") and trailing.is_none():
                var ranges: list[TextRange] = []
                var plain = True
                for a in args:
                    if a.name.is_some() or a.mutable:
                        plain = False
                    ranges.push(cx.ast.expr(a.value).range)
                if plain:
                    if let Some((start, end, text)) = printed_together(cx.source, ranges):
                        d = d.fix_at(Msg.TypeInterpolate, start, end, text)
            self.report(d)
        var out: list[TArg] = []
        for i in range(n):
            let p = sig.params[i].copy()
            match slots[i]:
                case Some(a):
                    self.arg_callee = Some((sig.def_, i))
                    out.push(self.check_arg(cx, a.copy(), p))
                    self.arg_callee = None
                case None:
                    if p.has_default:
                        out.push(self.default_arg(cx, sig, i, at))
                        continue
                    if not extra:
                        var d = self.error(cx, Msg.TypeMissingArgument, at)
                        d = d.with("arg", p.name).with("name", sig.name)
                        # A hole for the argument, by name after one named
                        # or keyword-only.
                        var keyword = False
                        if let Some(kf) = sig.keyword_only_from:
                            keyword = i >= kf
                        for a in args:
                            if a.name.is_some():
                                keyword = True
                        var hole = "todo(\"{p.name}\")"
                        if keyword:
                            hole = "{p.name}={hole}"
                        if not p.name.is_empty():
                            if let Some(edit) = self.hole_edit(cx, at, hole):
                                let name = Param(name="name".to_string(), value=p.name.copy())
                                d = d.fix_params(Msg.TypeAddHole, [name], [edit])
                        self.report(d)
                    out.push(TArg(expr=self.error_expr(at), mode=ArgMode.Value))
        return out

    ## An argument's value inferred with `expected` as a hint.
    pure def arg_infer(mut self, cx: Cx, a: ArgIn, expected: Ty?) -> TExprId:
        match a.value:
            case Some(v):
                return self.infer_expr(cx, v, expected)
            case None:
                let c = a.closure.copy() else:
                    return self.error_expr(a.range)
                var fn_ty: Ty? = None
                if let Some(t) = expected:
                    if let TyData.Fn(_, _, _) = self.data(t):
                        fn_ty = Some(self.resolved(t))
                return self.check_closure(cx, c, fn_ty)

    ## An argument's value checked against `ty`.
    pure def arg_check(mut self, cx: Cx, a: ArgIn, ty: Ty) -> TExprId:
        if let Some(v) = a.value:
            return self.check_expr(cx, v, ty)
        let x = self.arg_infer(cx, a, Some(ty))
        return self.coerce(cx, x, ty)

    pure def check_arg(mut self, cx: Cx, a: ArgIn, p: InstParam) -> TArg:
        if p.mode == Mode.Mut and not a.mutable:
            let r = a.value_range
            let d = self.error(cx, Msg.TypeMutArgumentMissing, r).with("param", p.name)
            self.report(d.fix_at(Msg.TypeAddMut, r.start, r.start, "mut "))
        elif p.mode != Mode.Mut and a.mutable:
            let d = self.error(cx, Msg.TypeMutArgumentUnexpected, a.range).with("param", p.name)
            self.report(self.callee_takes_mut(cx, d.fix_edits(Msg.TypeRemoveMut, []), p.name))
        # What earlier arguments inferred may settle an associated type; a
        # `T !` function's own error set stays open (RULES.md, R89).
        let z = self.infer.zonk_open(mut self.types, p.ty)
        let pty = cx.prog.normalize(mut self.types, z, self.env)
        # An argument that mentions `it` where a one-parameter function is
        # expected is a closure over `it`.
        if let TyData.Fn(ps, _, _) = self.types.data(pty):
            if len(ps) == 1:
                if let Some(v) = a.value:
                    var is_closure = False
                    if let ExprKind.Closure(_) = cx.ast.expr(v).kind:
                        is_closure = True
                    if not is_closure and mentions_it(cx.ast, v):
                        let r = cx.ast.expr(v).range
                        let it = ClosureParamSrc(name="it".to_string(), ty=None, range=r)
                        let c = self.closure_from_parts(
                            cx, [it], ClosureSource.Expr(v), Some(pty), r
                        )
                        let cc = self.coerce(cx, c, pty)
                        return TArg(expr=cc, mode=ArgMode.Value)
        match p.mode:
            case Mode.Own:
                self.arg_own = Some(p.name.copy())
                let x = self.arg_check(cx, a, pty)
                self.arg_own = None
                return TArg(expr=self.check_movable(cx, x), mode=ArgMode.Value)
            case Mode.Mut:
                let x = self.arg_infer(cx, a, Some(pty))
                if let TyData.Ref(inner, True) = self.data(self.ty_of(x)):
                    if not self.infer.try_unify(mut self.types, inner, pty):
                        let target = self.types.ref_(pty, True)
                        let y = self.coerce(cx, x, target)
                        return TArg(expr=y, mode=ArgMode.Value)
                    return TArg(expr=x, mode=ArgMode.Value)
                if not self.infer.try_unify(mut self.types, self.ty_of(x), pty):
                    let y = self.coerce(cx, x, pty)
                    return TArg(expr=y, mode=ArgMode.BorrowMut)
                if self.is_place(x):
                    self.require_mutable(cx, x, a.value_range)
                return TArg(expr=x, mode=ArgMode.BorrowMut)
            case Mode.Borrow:
                if p.opaque:
                    # A generic parameter: always by reference.
                    let x = self.arg_infer(cx, a, Some(pty))
                    if let TyData.Ref(inner, _) = self.data(self.ty_of(x)):
                        if self.infer.try_unify(mut self.types, inner, pty):
                            return TArg(expr=x, mode=ArgMode.Value)
                    let y = self.coerce(cx, x, pty)
                    return TArg(expr=y, mode=ArgMode.Ref)
                if let TyData.Adt(d, targs) = self.types.data(pty).copy():
                    if Some(d) == cx.prog.wk.iterable:
                        return self.iterable_arg(cx, a, pty, targs)
                if self.is_copy(cx, pty) and not is_var_data(self.types.data(pty)):
                    let x = self.arg_check(cx, a, pty)
                    return TArg(expr=x, mode=ArgMode.Value)
                let x = self.arg_infer(cx, a, Some(pty))
                if let TyData.Ref(inner, _) = self.data(self.ty_of(x)):
                    if self.infer.try_unify(mut self.types, inner, pty):
                        # A reference is passed on as it is.
                        return TArg(expr=x, mode=ArgMode.Value)
                let y = self.coerce(cx, x, pty)
                let mode = if self.is_copy(cx, self.ty_of(y)): ArgMode.Value else: ArgMode.Borrow
                return TArg(expr=y, mode=mode)

    ## An argument for an `Iterable[T]` parameter: any collection or
    ## iterator of `T`.
    pure def iterable_arg(mut self, cx: Cx, a: ArgIn, pty: Ty, targs: list[Ty]) -> TArg:
        let passed = self.arg_infer(cx, a, None)
        let item_ty = if targs.is_empty(): Ty.error() else: targs[0]
        # A `Slice` or `bytes` through its iterator (RULES.md, R61), when its
        # items are what the parameter takes; else the error names the view.
        var x = passed
        let viewed = self.view_iter(cx, passed)
        if viewed != passed:
            if let Some((item, _)) = self.iteration_item(cx, self.ty_of(viewed), Mode.Borrow):
                let it = self.decay_ty(cx, item)
                if self.infer.try_unify(mut self.types, it, item_ty):
                    x = viewed
        # An `Iterable` parameter passed on as it is: the reference to what
        # the caller gave.
        if let TyData.Ref(inner, _) = self.data(self.ty_of(x)):
            if let TyData.Adt(d2, ta2) = self.data(inner):
                if Some(d2) == cx.prog.wk.iterable:
                    let given = if ta2.is_empty(): Ty.error() else: ta2[0]
                    if not self.infer.try_unify(mut self.types, given, item_ty):
                        let shown_p = self.show(cx, pty)
                        let shown_x = self.show(cx, self.ty_of(x))
                        let d = self.error(cx, Msg.TypeMismatch, a.value_range)
                        self.report(d.with("expected", shown_p).with("found", shown_x))
                    return TArg(expr=x, mode=ArgMode.Value)
        match self.iteration_item(cx, self.ty_of(x), Mode.Borrow):
            case Some((item, mode)):
                let it = self.decay_ty(cx, item)
                if not self.infer.try_unify(mut self.types, it, item_ty):
                    let shown_p = self.show(cx, pty)
                    let shown_x = self.show(cx, self.ty_of(x))
                    var d = self.error(cx, Msg.TypeMismatch, a.value_range)
                    d = d.with("expected", shown_p).with("found", shown_x)
                    d = self.borrowed_items_help(cx, d, x, it, item_ty, a.value_range)
                    self.report(d)
                match mode:
                    case ForMode.Iter:
                        return TArg(expr=self.check_movable(cx, x), mode=ArgMode.Value)
                    case ForMode.Trait:
                        # A program's iterator, through a generator that
                        # takes its items (`iter_from`).
                        let (y, made) = self.iter_from(cx, x, item_ty)
                        if not made:
                            let shown_p = self.show(cx, pty)
                            let shown_x = self.show(cx, self.ty_of(y))
                            let d = self.error(cx, Msg.TypeMismatch, a.value_range)
                            self.report(d.with("expected", shown_p).with("found", shown_x))
                        return TArg(expr=y, mode=ArgMode.Value)
                    case _:
                        return TArg(expr=x, mode=ArgMode.Borrow)
            case None:
                if self.ty_of(x) != Ty.error():
                    let shown_p = self.show(cx, pty)
                    let shown_x = self.show(cx, self.ty_of(x))
                    let d = self.error(cx, Msg.TypeMismatch, a.value_range)
                    self.report(d.with("expected", shown_p).with("found", shown_x))
                return TArg(expr=x, mode=ArgMode.Value)

    ## A borrowed collection given where an `Iterable[T]` of owned items is
    ## expected (`sorted(hand)`, R16): its items are references, which are
    ## values only of a `Copy` type, so the note says so and the fix gives
    ## a copy of the collection.
    pure def borrowed_items_help(
        mut self, cx: Cx, own d: Diagnostic, x: TExprId, it: Ty, want: Ty, at: TextRange
    ) -> Diagnostic:
        let TyData.Ref(referent, _) = self.data(it) else:
            return d
        if self.is_copy(cx, referent) or self.types.contains_error(referent):
            return d
        let w = self.resolved(want)
        if self.resolved(referent) != w:
            return d
        let TyData.Ref(whole, _) = self.data(self.ty_of(x)) else:
            return d
        let shown = self.show(cx, whole)
        let item = self.show(cx, referent)
        let params = [
            Param(name="ty".to_string(), value=shown),
            Param(name="item".to_string(), value=item),
        ]
        return d.note_params(Msg.TypeBorrowedItems, params).fix_at(
            Msg.TypeAddCopy, at.end, at.end, ".copy()"
        )

    ## `recv.name(args)`: a method of the receiver's type, then of a trait
    ## it implements (or, for a generic parameter, a trait it is bounded
    ## by); through references and `Box`es.
    pub pure def method_call_on(
        mut self,
        cx: Cx,
        recv0: TExprId,
        name: Name,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        var recv = self.auto_deref(recv0)
        while True:
            var base = self.resolved(self.ty_of(recv))
            match self.types.data(base):
                case TyData.Error:
                    self.check_args_loosely(cx, args)
                    return self.error_expr(at)
                case TyData.Var(_):
                    let recv_at = self.span_of(recv)
                    let text = self.source_text(cx, recv_at)
                    let d = self.error(cx, Msg.TypeCannotInfer, recv_at).with("name", text)
                    self.report(d)
                    self.check_args_loosely(cx, args)
                    return self.error_expr(at)
                case _:
                    pass
            if name.text == "copy" and args.is_empty() and trailing.is_none():
                return self.add(TExprKind.CopyOf(recv), base, at)
            if name.text == "trace" and args.is_empty():
                if let TyData.ErrSet(_) = self.types.data(base):
                    let s = self.string_ty(cx)
                    return self.add(TExprKind.Trace(recv), s, at)
            var def_: DefId? = None
            if let Some(k) = self.types.key(base):
                def_ = cx.prog.method(k, name.text)
            # A `Shared`'s own functions take it as an argument: a method
            # call reaches the value's methods.
            if self.smart_pointer(cx, base) == Some("Shared".to_string()):
                if let Some(d) = def_:
                    if let Some(f) = cx.prog.fn_info(d):
                        if f.self_mode.is_none():
                            def_ = None
            if def_.is_none() and self.is_string(cx, base):
                if let Some(d) = cx.prog.method(TyKey.Str, name.text):
                    def_ = Some(d)
                    recv = self.coerce(cx, recv, Ty.str())
                    base = Ty.str()
            if let Some(d) = def_:
                # A `dict` or `set` finds its keys by their hash.
                if let TyData.Adt(cd, a) = self.types.data(base):
                    if Some(cd) == cx.prog.wk.dict or Some(cd) == cx.prog.wk.set:
                        if let Some(k) = a.first():
                            self.require(k, cx.prog.wk.hash, at)
                return self.inherent_call(cx, d, recv, base, name, args, trailing, at, expected)
            # A method of a trait.
            let z = self.infer.zonk(mut self.types, base)
            let norm = cx.prog.normalize(mut self.types, z, self.env)
            let candidates = cx.prog.trait_methods_for(mut self.types, norm, name.text, self.env)
            if len(candidates) == 1:
                let (tr, m) = candidates[0].copy()
                return self.trait_call(cx, m, tr, recv, norm, name, args, trailing, at, expected)
            if len(candidates) > 1:
                # One generic trait implemented for several of its arguments
                # (`Into[u32]`, `Into[int]`): the arguments are inferred.
                var same = True
                for (t, m) in candidates:
                    if t.def_ != candidates[0].0.def_ or m != candidates[0].1:
                        same = False
                if same:
                    let (tr0, m) = candidates[0].copy()
                    var fresh: list[Ty] = []
                    for _ in tr0.args:
                        fresh.push(self.infer.fresh(mut self.types))
                    let tr = TraitRef(def_=tr0.def_, args=fresh)
                    return self.trait_call(
                        cx, m, tr, recv, norm, name, args, trailing, at, expected
                    )
                var traits: list[String] = []
                for (t, _) in candidates:
                    traits.push(cx.prog.display_trait_in(self.types, t, self.generic_names))
                let shown = self.show(cx, base)
                var d = self.error(cx, Msg.TypeAmbiguousMethod, name.range)
                d = d.with("name", name.text).with("ty", shown).with("traits", traits.join(", "))
                self.report(d)
                self.check_args_loosely(cx, args)
                return self.error_expr(at)
            # A refinement has its base's methods, with the same value as the
            # receiver.
            if self.refinement_of(cx, base).is_some():
                recv = self.unrefined_once(cx, recv)
                continue
            # A `Box` and a `Shared` lend their methods' receiver to what
            # they hold.
            if self.is_box(cx, base):
                recv = self.unbox(recv)
                recv = self.auto_deref(recv)
                continue
            if self.smart_pointer(cx, base).is_some():
                recv = self.deref_smart(recv)
                recv = self.auto_deref(recv)
                continue
            # A field holding a function.
            if let TyData.Adt(sd, _) = self.types.data(base):
                if let Some(s) = cx.prog.struct_info(sd):
                    var has_field = False
                    for f in s.fields:
                        if f.name == name.text:
                            has_field = True
                    if has_field:
                        let fv = self.field_of(cx, recv, name, at)
                        return self.call_value(cx, fv, args, trailing, at)
            let shown = self.show(cx, base)
            var d = self.error(cx, Msg.TypeUnknownMethod, name.range)
            d = d.with("ty", shown).with("name", name.text)
            match self.spelling_fix(cx, base, recv, name, args, at):
                case Some(fixed):
                    d = fixed.with("ty", shown).with("name", name.text)
                case None:
                    if let Some(similar) = self.similar_member(cx, base, name.text):
                        d = d.fix_at(
                            Msg.TypeSimilarMember, name.range.start, name.range.end, similar
                        )
            d = self.method_bound_fix(cx, d, base, name.text)
            d = self.hidden_module_note(cx, d, recv)
            self.report(unknown_method_note(cx, d, name.text))
            self.check_args_loosely(cx, args)
            return self.error_expr(at)

    ## The note of a method looked for on a local named like a module the
    ## module imports, `fs.walk(...)` with a parameter `fs` beside `import
    ## std.fs`: the local hides the module (RULES.md, R74).
    pure def hidden_module_note(self, cx: Cx, own d: Diagnostic, recv: TExprId) -> Diagnostic:
        let r = self.span_of(recv)
        if r.start >= r.end or r.end > cx.source.byte_len():
            return d
        let written = cx.source.byte_slice(r.start, r.end).to_string()
        if self.lookup_local(written).is_none():
            return d
        let item = cx.prog.lookup_in(self.module, written) else:
            return d
        let DefKind.Module(m) = cx.prog.defs[item.index].kind() else:
            return d
        var module = cx.prog.modules[m.index].path.join(".")
        if module.is_empty():
            module = "std.{cx.prog.modules[m.index].name}"
        let params = [
            Param(name="name".to_string(), value=written),
            Param(name="module".to_string(), value=module),
        ]
        return d.note_params(Msg.TypeHiddenModule, params)

    ## The other fix of a `mut` argument for a borrowed parameter, when the
    ## function is the module's own: its parameter taken with `mut`, which is
    ## the fix `E0341` offers where the function changes it (RULES.md, R24),
    ## so that the two errors agree.
    pure def callee_takes_mut(self, cx: Cx, own d: Diagnostic, pname: str) -> Diagnostic:
        let (callee, i) = self.arg_callee else:
            return d
        if cx.prog.defs[callee.index].module != self.module:
            return d
        let f = cx.prog.fn_info(callee) else:
            return d
        if i >= len(f.params) or f.params[i].mode != Mode.Borrow:
            return d
        let at = f.params[i].span
        let edit = Edit(start=at.start, end=at.start, text="mut ".to_string())
        let named = Param(name="name".to_string(), value=pname.to_string())
        return d.fix_params(Msg.TypeTakeMut, [named], [edit])

    ## The fix of a method another language spells so (RULES.md, R24): Python's
    ## `", ".join(names)` is `names.join(", ")`, a method of the items; an
    ## iterator's method on a collection iterates it first,
    ## `xs.iter().map(f)`; and `append`, `clone`, `strip` and the others
    ## have their Sisu names.
    pure def spelling_fix(
        mut self, cx: Cx, base: Ty, recv: TExprId, name: Name, args: list[Arg], at: TextRange
    ) -> Diagnostic?:
        let d = self.error(cx, Msg.TypeUnknownMethod, name.range)
        let r = self.span_of(recv)
        let n = cx.source.byte_len()
        if name.text == "join" and len(args) == 1 and self.is_text(cx, base):
            let a = cx.ast.expr(args[0].value).range
            if args[0].name.is_none() and r.start < r.end and a.start < a.end and at.end <= n:
                let items = cx.source.byte_slice(a.start, a.end)
                let sep = cx.source.byte_slice(r.start, r.end)
                return Some(d.fix_at(Msg.TypeJoinItems, r.start, at.end, "{items}.join({sep})"))
        if let Some(sisu) = sisu_spelling(name.text):
            let mut_name = sisu.to_string()
            return Some(d.fix_at(Msg.TypeSisuSpelling, name.range.start, name.range.end, mut_name))
        # An iterator's method on what can be iterated: `.iter()` first.
        if let Some(it) = cx.prog.wk.iterator:
            let tr = TraitRef(def_=it, args=[])
            let is_iter = cx.prog.implements(mut self.types, base, tr, self.env) != Answer.No
            if cx.prog.trait_method(it, name.text).is_some() and not is_iter:
                if self.iteration_item(cx, base, Mode.Borrow).is_some():
                    let dot = name.range.start
                    if dot > 0 and cx.source.byte_at(dot - 1) == 46:
                        return Some(d.fix_at(Msg.TypeIterateFirst, dot - 1, dot - 1, ".iter()"))
        return None

    ## A method of a trait called on a type parameter its bounds do not
    ## give it: the fix bounds the parameter by the trait, as `E0347` does
    ## (RULES.md, R24).
    pure def method_bound_fix(
        mut self, cx: Cx, own d: Diagnostic, base: Ty, name: str
    ) -> Diagnostic:
        let TyData.Param(i) = self.types.data(base) else:
            return d
        var found: DefId? = None
        var count = 0
        for k in range(len(cx.prog.defs)):
            if let DefKind.Trait(info) = cx.prog.defs[k].kind():
                if info.generics.is_empty()
                        and cx.prog.trait_method(DefId(index=k), name).is_some():
                    found = Some(DefId(index=k))
                    count += 1
        let t = found else:
            return d
        if count != 1:
            return d
        let bound = cx.prog.defs[t.index].name.copy()
        let (pname, e) = self.bound_edit(cx, i, bound) else:
            return d
        let params = [
            Param(name="param".to_string(), value=pname),
            Param(name="bound".to_string(), value=bound.copy()),
        ]
        return d.fix_params(Msg.TypeAddBound, params, [e])

    pure def inherent_call(
        mut self,
        cx: Cx,
        d: DefId,
        recv: TExprId,
        base: Ty,
        name: Name,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        let info = cx.prog.fn_info(d) else:
            return self.error_expr(at)
        if info.header_broken:
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        self.check_method_vis(cx, d, name.range)
        let mode = info.self_mode else:
            let shown = self.show(cx, base)
            var diag = self.error(cx, Msg.TypeAssocNotMethod, name.range)
            diag = diag.with("name", name.text).with("ty", shown)
            self.report(diag)
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        var recv_arg = TArg(expr=recv, mode=ArgMode.Value)
        match mode:
            case Mode.Borrow:
                if not self.is_copy(cx, base):
                    recv_arg = TArg(expr=recv, mode=ArgMode.Borrow)
            case Mode.Mut:
                if self.is_place(recv):
                    self.require_mutable(cx, recv, self.span_of(recv))
                recv_arg = TArg(expr=recv, mode=ArgMode.BorrowMut)
            case Mode.Own:
                recv_arg = TArg(expr=self.check_movable(cx, recv), mode=ArgMode.Value)
        let explicit = self.explicit_method_args.copy()
        self.explicit_method_args = None
        return self.call_fn(
            cx, d, explicit, Some(base), Some(recv_arg), args, trailing, at, expected
        )

    ## A call of the trait method `m` of `tr` on `recv`, of type `self_ty`.
    ## `self` is the trait's `Self`, a generic parameter, so a borrowed one
    ## is passed by reference whatever its type.
    pub pure def trait_call(
        mut self,
        cx: Cx,
        m: DefId,
        tr: TraitRef,
        recv: TExprId,
        self_ty: Ty,
        name: Name,
        args: list[Arg],
        trailing: Closure?,
        at: TextRange,
        expected: Ty?,
    ) -> TExprId:
        let info = cx.prog.fn_info(m) else:
            return self.error_expr(at)
        if info.header_broken:
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        let mode = info.self_mode else:
            let shown = self.show(cx, self_ty)
            var diag = self.error(cx, Msg.TypeAssocNotMethod, name.range)
            diag = diag.with("name", name.text).with("ty", shown)
            self.report(diag)
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        var recv_arg = TArg(expr=recv, mode=ArgMode.Ref)
        match mode:
            case Mode.Borrow:
                if let TyData.Ref(_, _) = self.data(self.ty_of(recv)):
                    recv_arg = TArg(expr=recv, mode=ArgMode.Value)
            case Mode.Mut:
                if self.is_place(recv):
                    self.require_mutable(cx, recv, self.span_of(recv))
                recv_arg = TArg(expr=recv, mode=ArgMode.BorrowMut)
            case Mode.Own:
                recv_arg = TArg(expr=self.check_movable(cx, recv), mode=ArgMode.Value)
        var outer = [self_ty]
        for a in tr.args:
            outer.push(a)
        # The brackets of `x.method[T](...)` are the trait method's own type
        # arguments, as an inherent method's are (`E0349` for one that has
        # none, `collect[set[int]]()`, where they were dropped; RULES.md,
        # R25).
        let explicit = self.explicit_method_args.copy()
        self.explicit_method_args = None
        return self.call_fn_with(
            cx,
            m,
            explicit,
            Some(outer),
            Some(self_ty),
            Some(recv_arg),
            args,
            trailing,
            at,
            expected,
        )

    ## Calls a value of function type.
    pub pure def call_value(
        mut self, cx: Cx, f0: TExprId, args: list[Arg], trailing: Closure?, at: TextRange
    ) -> TExprId:
        # A reference to a function value calls the function.
        var f = f0
        while let TyData.Ref(inner, _) = self.data(self.ty_of(f)):
            if let TyData.Fn(_, _, _) = self.data(inner):
                let fspan = self.span_of(f)
                f = self.add(TExprKind.Deref(f), inner, fspan)
            else:
                break
        let t = self.resolved(self.ty_of(f))
        let TyData.Fn(ps, ret, _) = self.types.data(t).copy() else:
            if t != Ty.error():
                let shown = self.show(cx, t)
                let d = self.error(cx, Msg.TypeNotCallable, at).with("ty", shown)
                self.report(d)
            self.check_args_loosely(cx, args)
            return self.error_expr(at)
        var params: list[InstParam] = []
        for i in range(len(ps)):
            params.push(
                InstParam(name="{i}", mode=Mode.Own, ty=ps[i], has_default=False, opaque=False)
            )
        let sig = InstSig(
            def_=DefId(index=-1),
            name=self.source_text(cx, self.span_of(f)),
            params=params,
            ret=ret,
            owner=None,
            type_args=[],
            keyword_only_from=None,
            positional_only_until=len(ps),
        )
        let out = self.check_args(cx, sig, args, trailing, at)
        if let Some(root) = self.place_root(f):
            self.note_use(root, False)
        return self.add(TExprKind.Call(callee=Callee.Value(f), args=out), ret, at)

## The argument as `check_args` sees it.
pure def arg_in(ast: Ast, a: Arg) -> ArgIn:
    return ArgIn(
        name=a.name.copy(),
        mutable=a.mutable,
        value=Some(a.value),
        closure=None,
        range=a.range,
        value_range=ast.expr(a.value).range,
    )

## The function a task call names, for its messages: the text before `(`.
pure def call_name(text: str) -> String:
    var out = String.new()
    for c in text.chars():
        if c == '(' or c == ' ' or c == '\n' or c == '\t':
            return out
        out.push_char(c)
    return out

## The type a primitive name denotes where a value is written (`int.max`).
pure def primitive_value_type(name: str) -> Ty?:
    if name == "Never":
        return None
    return primitive(name)

## Whether an expression mentions `it` outside any nested closure: such an
## argument, where a one-parameter function is expected, is a closure over
## `it` (02, "Closures").
pub pure def mentions_it(ast: Ast, e: ExprId) -> bool:
    match ast.expr(e).kind:
        case ExprKind.Name(n):
            return n == "it"
        case ExprKind.Closure(_):
            return False
        case ExprKind.Paren(x):
            return mentions_it(ast, x)
        case ExprKind.Try(x):
            return mentions_it(ast, x)
        case ExprKind.FromEnd(x):
            return mentions_it(ast, x)
        case ExprKind.Unary(_, x):
            return mentions_it(ast, x)
        case ExprKind.Ref(_, x):
            return mentions_it(ast, x)
        case ExprKind.Binary(_, l, r):
            return mentions_it(ast, l) or mentions_it(ast, r)
        case ExprKind.Compare(first, rest):
            if mentions_it(ast, first):
                return True
            for (_, x) in rest:
                if mentions_it(ast, x):
                    return True
            return False
        case ExprKind.Tuple(xs):
            for x in xs:
                if mentions_it(ast, x):
                    return True
            return False
        case ExprKind.List(xs):
            for x in xs:
                if mentions_it(ast, x):
                    return True
            return False
        case ExprKind.Set(xs):
            for x in xs:
                if mentions_it(ast, x):
                    return True
            return False
        case ExprKind.Dict(kv):
            for (k, v) in kv:
                if mentions_it(ast, k) or mentions_it(ast, v):
                    return True
            return False
        case ExprKind.Call(callee, args, _):
            if mentions_it(ast, callee):
                return True
            for a in args:
                if mentions_it(ast, a.value):
                    return True
            return False
        case ExprKind.Field(base, _):
            return mentions_it(ast, base)
        case ExprKind.OptField(base, _):
            return mentions_it(ast, base)
        case ExprKind.Index(base, args):
            if mentions_it(ast, base):
                return True
            for a in args:
                match a:
                    case IndexArg.Expr(x):
                        if mentions_it(ast, x):
                            return True
                    case IndexArg.Slice(lo, hi):
                        if let Some(x) = lo:
                            if mentions_it(ast, x):
                                return True
                        if let Some(x) = hi:
                            if mentions_it(ast, x):
                                return True
            return False
        case ExprKind.If(branches, else_):
            for (c, v) in branches:
                if mentions_it(ast, c) or mentions_it(ast, v):
                    return True
            if let Some(x) = else_:
                return mentions_it(ast, x)
            return False
        case ExprKind.Str(parts):
            for p in parts:
                if let StrPart.Interp(x, _, _, _) = p:
                    if mentions_it(ast, x):
                        return True
            return False
        case _:
            return False

## A note naming the traits that have a method called `name`, when the
## receiver implements none of them (stage 0's `unknown_method_note`).
## Python's and Rust's names of methods Sisu spells otherwise (02, "Departures
## from Python"; RULES.md, R24).
pure def sisu_spelling(name: str) -> str?:
    return match name:
        case "append": Some("push")
        case "clone": Some("copy")
        case "strip": Some("trim")
        case "upper": Some("to_uppercase")
        case "lower": Some("to_lowercase")
        case "startswith": Some("starts_with")
        case "endswith": Some("ends_with")
        case "to_owned": Some("to_string")
        case _: None

pure def unknown_method_note(cx: Cx, own d: Diagnostic, name: str) -> Diagnostic:
    var traits = String.new()
    for i in range(len(cx.prog.defs)):
        if let DefKind.Trait(_) = cx.prog.defs[i].kind():
            if cx.prog.trait_method(DefId(index=i), name).is_some():
                if not traits.is_empty():
                    traits.push(", ")
                traits.push("`{cx.prog.defs[i].name}`")
    if traits.is_empty():
        return d
    let params = [
        Param(name="name".to_string(), value=name.to_string()),
        Param(name="traits".to_string(), value=traits),
    ]
    return d.note_params(Msg.TypeMethodOfTraits, params)

## The arguments of `print(a, b)` written as the one text `print` takes:
## each literal's text, each other value interpolated, with a space
## between, as Python's `print` joins them.
pure def printed_together(text: str, args: list[TextRange]) -> (int, int, String)?:
    if len(args) < 2:
        return None
    var parts: list[String] = []
    for r in args:
        if r.start < 0 or r.end > text.byte_len() or r.start >= r.end:
            return None
        let written = text.byte_slice(r.start, r.end)
        let quoted = written.starts_with("\"") and written.ends_with("\"")
        if quoted and written.byte_len() >= 2 and not written.starts_with("\"\"\""):
            parts.push(written.byte_slice(1, written.byte_len() - 1).to_string())
        else:
            parts.push("{{{written}}}")
    let start = args[0].start
    let end = args[len(args) - 1].end
    return Some((start, end, "\"{parts.join(" ")}\""))
