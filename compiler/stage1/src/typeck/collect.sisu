## Where a method is declared, which decides the generics, bounds and
## `Self` of its signature.
enum Owner:
    ## Written in a struct's or enum's body.
    Type(DefId)
    ## `impl[...] Type:`.
    Inherent(generics: list[Generic], names: list[String], predicates: list[Predicate], self_ty: Ty)
    ## A trait's method.
    Trait(DefId)
    ## A trait impl's method.
    Impl(DefId)
    ## A refinement type's predicate, whose `self` is a value of the base.
    Refinement(DefId)

## A declaration waiting for its signature.
pub enum Pending:
    Fn(def_: DefId, module: ModuleId, ast: FnDef, owner: Owner?)
    Struct(def_: DefId, module: ModuleId, ast: StructDef, attrs: list[Attr])
    Enum(def_: DefId, module: ModuleId, ast: EnumDef, attrs: list[Attr])
    Trait(def_: DefId, module: ModuleId, ast: TraitDef, attrs: list[Attr])
    Impl(module: ModuleId, ast: ImplDef, range: TextRange)
    Test(def_: DefId, module: ModuleId, ast: TestDef)
    Const(def_: DefId, module: ModuleId, ast: ConstDef)
    Refinement(def_: DefId, module: ModuleId, ast: TypeAlias, node: int, range: TextRange)

## A value that reflects, unfolded once everything is resolved (decision
## 251): a constant's, a struct field's default, a parameter's default,
## each with the module it is written in.
pub enum Later:
    Const(def_: DefId, module: ModuleId, value: ExprId)
    Field(def_: DefId, index: int, module: ModuleId, label: String, value: ExprId)
    Param(def_: DefId, index: int, module: ModuleId, label: String, value: ExprId)

## What a type expression may mention where it is written.
struct TyCtx:
    module: ModuleId
    generics: list[String]
    self_ty: Ty?
    allow_ref: bool
    ## Bounds in scope, which give `C.Item` its trait.
    predicates: list[Predicate]
    ## Inside a trait: its own associated types may be named bare.
    in_trait: DefId?
    ## Inside a trait impl: what it binds its associated types to.
    impl_assoc: list[(String, Ty)]

impl TyCtx:
    pure def plain(module: ModuleId, generics: list[String], allow_ref: bool) -> TyCtx:
        return TyCtx(
            module=module,
            generics=generics.copy(),
            self_ty=None,
            allow_ref=allow_ref,
            predicates=[],
            in_trait=None,
            impl_assoc=[],
        )

## Which std modules a program may import hold templates (`reflect.`)
## and `unsafe` code, by name, which the base keeps the texts of (RULES.md,
## R125: a base made from its cache reads them from it).
pub struct StdMarks:
    pub reflecting: list[String]
    pub unsafe_code: list[String]

impl StdMarks:
    ## What a resolver's base found.
    pub pure def of(r: Resolver) -> StdMarks:
        var reflecting: list[String] = []
        for (name, _) in r.std_texts.items():
            reflecting.push(name.copy())
        var unsafe_code: list[String] = []
        for (name, _) in Shared.get(r.std_safety_texts).items():
            unsafe_code.push(name.copy())
        reflecting.sort()
        unsafe_code.sort()
        return StdMarks(reflecting=reflecting, unsafe_code=unsafe_code)

pub struct Resolver:
    pub prog: Program
    pub types: Types
    ## Each module's syntax, by module index.
    pub sources: list[Module]
    ## The type checker's messages found in signatures, with their module.
    pub diags: list[(ModuleId, Diagnostic)]
    ## Why the root module is beyond the checker's slice, when it is.
    pub beyond: String?
    pub pending: list[Pending]
    aliases: dict[DefId, (ModuleId, TypeAlias)]
    resolving_alias: list[DefId]
    ## The generic parameters of every struct, enum, trait and refinement,
    ## known before any of them is resolved.
    type_params: dict[DefId, list[GenericParam]]
    headers_done: set[DefId]
    ## The bounds of every struct's and enum's generic parameters.
    type_preds: dict[DefId, list[Predicate]]
    ## The std modules a program may import, parsed once by the base and
    ## shared by each copy of it (a program's resolver is one).
    std_parsed: Shared[dict[String, Module]]
    ## Their texts, for a base that did not parse them (one made with the
    ## cache of `main.base_of`): an import parses its module then.
    std_sources: Shared[dict[String, String]]
    ## What the name pass knows of the prelude and the ambient modules,
    ## from the base's own parse of them (`resolve.Environment`).
    pub environment: Environment?
    ## The std modules loaded, by name.
    std_loaded: dict[String, ModuleId]
    ## While the root module's items are declared: its imports, declared
    ## once every item is (stage 0's deferred imports).
    deferring: bool
    deferred: list[(ModuleId, ItemId)]
    ## Stage 0 reports an error about the root module's declarations that
    ## is not the type checker's (a `resolve.` message).
    pub other_error: bool
    ## The functions the compiler writes and checks elsewhere too, which
    ## report nothing of their own.
    pub quiet_fns: set[DefId]
    ## The kinds of the functions the compiler writes.
    special_kinds: dict[DefId, FnKind]
    ## `@derive(Copy)` to check against the fields, with the type.
    pub copy_checks: list[(DefId, TextRange)]
    ## The root module's text.
    pub root_text: String
    ## The text of each module of the program, and of each module the
    ## compiler wrote for it, by module.
    pub module_texts: dict[ModuleId, String]
    ## The modules of the program's doc examples, a test each, with their
    ## texts, which keep every example line where the module's file has it.
    pub docs: list[(ModuleId, String)]
    ## The message catalog, for the texts of the messages that are
    ## parameters of others (a panic folding a constant reports): the
    ## program's, which `typeck.base` gives the base, shared by each copy of
    ## it.
    pub catalog: Shared[Catalog]
    ## The derive templates of the program's modules, by module and their
    ## trait's name.
    pub derive_templates: dict[(int, String), FnDef]
    ## The syntax of each template, for its instances.
    pub template_fns: dict[DefId, FnDef]
    ## Values that reflect (a constant's, a field's or a parameter's
    ## default), unfolded once everything they may name is resolved
    ## (decision 251).
    pub unfold_later: list[Later]
    ## Each trait's provided methods that reflect, with the trait's module:
    ## an impl that does not write one gets it as a template of its own,
    ## made for its type (decision 251).
    pub trait_templates: dict[DefId, list[(ModuleId, FnDef)]]
    ## The provided methods that reflect each impl got from its trait
    ## (decision 251): their instances name the impl's type parameters
    ## apart, since the trait's code never names them.
    pub provided_copies: set[DefId]
    ## While a suite's items are declared: the `@tag`s of the suites around
    ## them, which tag each of their tests (RULES.md, R40).
    pub suite_tags: list[Attr]
    ## While a type's declaration is resolved (its fields, its methods, an
    ## impl of it): the type, whose own uses of itself are not deprecated
    ## uses (RULES.md, R40); and while an impl's self type is, any use.
    pub decl_owner: DefId?
    pub quiet_deprecation: bool
    ## The names reflection shows for the type parameters of the template
    ## being made (a generic trait impl's, decision 251).
    pub shape_names: list[String]
    ## While a parameter's type is resolved, its range: a trait written as
    ## the whole type is a parameter's `ref dyn` (RULES.md, R63).
    pub param_type_at: TextRange?
    ## Generic functions the last check found calling a template with their
    ## own type parameters: templates too.
    pub promoted: set[DefId]
    ## How many instances this resolution was asked for, made or not, and
    ## whether the bound on them was reported.
    pub instances_asked: int
    pub instances_bounded: bool
    ## The program is built with its tests, so the root package's doc
    ## examples are tests of it (stage 0's `Sources::tests`; decision 243).
    pub tests: bool
    ## `sir --tests --std` (RULES.md, R185): the texts of the std modules,
    ## by name, whose doc examples are tests too; empty otherwise.
    pub std_doc_texts: dict[String, String]
    ## The module each std module's doc examples make, by the module's name,
    ## made once for every round of a check (RULES.md, R224); empty for a
    ## resolver that makes each when it declares it.
    pub std_docs: Shared[dict[String, StdDoc]]
    ## How many instances this resolution declared: the next one's number.
    pub instances_declared: int
    ## The modules that hold an instance, whose functions are never
    ## templates themselves.
    pub instance_modules: set[ModuleId]
    ## The call that made each instance's module, its module and the
    ## instance's name (`make[User]`), where a diagnostic in the instance is
    ## placed (RULES.md, R77).
    pub instance_sites: dict[ModuleId, (ModuleId, TextRange, String)]
    ## For an instance's module whose template is the program's, the
    ## template's module and the statement that wrote each stretch of its
    ## code (RULES.md, R131).
    pub instance_origins: dict[ModuleId, (ModuleId, list[(int, int, TextRange)])]
    ## The instances whose template's own text has a syntax error, which
    ## its file reports: their copies of it are not reported again
    ## (RULES.md, R159).
    pub broken_instances: set[ModuleId]
    ## While an import is declared: whether it is `@cfg(test)`, as an import
    ## of a dev-dependency must be (RULES.md, R75).
    pub import_for_tests: bool
    ## How many definitions the base made: a program's own come after them,
    ## and nothing a program declares changes one of the base's.
    pub base_defs: int
    ## The base's functions that a program makes an instance of whether
    ## anything calls them or not (a template made once, with a body, not a
    ## trait's), found once: the walk of each round of instances over every
    ## definition starts at the program's own.
    pub base_eager: list[DefId]
    ## The instances that are methods, found once their impls are resolved:
    ## the module, the instance's name, the template, its type arguments and
    ## where the program needs it.
    pub method_instances: list[(ModuleId, String, DefId, list[Ty], (ModuleId, TextRange))]
    ## Each instance's template and type arguments, which its definition
    ## keeps when it is resolved (stage 0's `instance_of`).
    pub instance_of: dict[DefId, (DefId, list[Ty])]
    ## Every module's generators are declared: a module the compiler writes
    ## from now on has the calls that stand for its generators' sites
    ## written as it is declared (`write_sites_in`).
    pub sites_known: bool
    ## The types with an impl of `Arbitrary` written by hand, and those that
    ## derive it, in any module of the program (RULES.md, R52).
    pub arbitrary_by_hand: list[DefId]
    pub arbitrary_derived: list[DefId]
    ## The attributes on the root module's types, as data for
    ## `reflect.attributes_of`: each name and its arguments' text.
    pub attrs_of: dict[DefId, list[(String, list[String])]]
    ## The attributes on the program's functions and methods, as data for
    ## `reflect.attributes_of` of a method (RULES.md, R161).
    pub fn_attrs: dict[DefId, list[(String, list[String])]]
    ## The modules the compiler wrote from templates (derived impls and
    ## instances), with their text, in the order they were made: their
    ## bodies are checked.
    pub generated: list[(ModuleId, String)]
    ## The module of the interceptors and fakes the compiler wrote for the
    ## program's traits, with its text, whose bodies are checked when
    ## lowering reaches them.
    pub shims: list[(ModuleId, String)]
    ## The derived and delegated impls to check once every impl is known.
    pub derive_checks: list[DeriveCheck]
    ## Where each derived impl of the program's modules is in the module
    ## the compiler wrote for them, by that module (RULES.md, R70).
    pub derive_origins: dict[ModuleId, list[DeriveOrigin]]
    ## The text of each std module that has templates, by name.
    pub std_texts: dict[String, String]
    ## The text of each std module with unsafe code, by name, for the
    ## `Safety:` lists of its `unsafe def`s and `unsafe trait`s (22).
    pub std_safety_texts: Shared[dict[String, String]]
    ## The functions declared in `extern` blocks (22, "Foreign calls"), with
    ## the library their calls lower to (`extern.c.NAME` for `extern "C"`).
    pub foreign_fns: dict[DefId, String]
    ## The syntax of the modules the base resolves, by module, which
    ## `typeck.base` takes so that lowering can check a std body it reaches.
    pub std_kept: list[Module]
    ## A std module the base declared in part, by name: its whole syntax,
    ## whose other items an import of it declares (`std.mem`, whose
    ## `Allocator` and `Global` the prelude's collections name; RULES.md,
    ## R227).
    pub std_rest: dict[String, Module]
    ## The traits written as `dyn T` in signatures, with the module, for the
    ## check that they can be (stage 0's `dyn_uses`).
    dyn_uses: list[(DefId, ModuleId, TextRange)]
    ## The phase the definitions made now belong to: 0 while modules are
    ## declared, 1 to 4 while the types, the traits, the impls and the rest
    ## are resolved, 9 once the root module is.
    pub phase: int
    ## The prelude's derive templates, with its syntax and text, which the
    ## base keeps until `typeck.base` takes them (they are not copied with
    ## the program for each file).
    pub std_derives: Templates
    ## The text of each std module's derived impls (its `<derive>/NAME.sisu`
    ## module), by the module's name, which the base makes from the
    ## prelude's templates for every std module, those a program may import
    ## included: a program that imports one declares the text made here.
    pub std_derived: dict[String, String]

## Where the part of `std.mem` the base declares ends (RULES.md, R227): its
## raw pointers, layouts and allocators come before it, `Region`, `RawBuf`
## and `Plain` after.
const MEM_HEAD_END: str = "## The alignment of a `Region`'s base."

impl Resolver:
    pub pure def new() -> Resolver:
        let parsed: dict[String, Module] = {}
        let sources: dict[String, String] = {}
        let safety_texts: dict[String, String] = {}
        let no_docs: dict[String, StdDoc] = {}
        return Resolver(
            prog=Program.new(),
            types=Types.new(),
            sources=[],
            diags=[],
            beyond=None,
            pending=[],
            aliases={},
            resolving_alias=[],
            type_params={},
            headers_done=set(),
            type_preds={},
            std_parsed=Shared(parsed),
            std_sources=Shared(sources),
            environment=None,
            std_loaded={},
            deferring=False,
            deferred=[],
            other_error=False,
            quiet_fns=set(),
            special_kinds={},
            copy_checks=[],
            root_text=String.new(),
            module_texts={},
            docs=[],
            catalog=Shared(Catalog.parse("")),
            derive_templates={},
            template_fns={},
            unfold_later=[],
            trait_templates={},
            provided_copies=set(),
            suite_tags=[],
            decl_owner=None,
            quiet_deprecation=False,
            shape_names=[],
            param_type_at=None,
            promoted=set(),
            instances_asked=0,
            instances_bounded=False,
            tests=True,
            std_doc_texts={},
            std_docs=Shared(no_docs),
            instances_declared=0,
            instance_modules=set(),
            instance_sites={},
            instance_origins={},
            broken_instances=set(),
            import_for_tests=False,
            base_defs=0,
            base_eager=[],
            method_instances=[],
            instance_of={},
            sites_known=False,
            arbitrary_by_hand=[],
            arbitrary_derived=[],
            attrs_of={},
            fn_attrs={},
            generated=[],
            shims=[],
            derive_checks=[],
            derive_origins={},
            std_texts={},
            std_safety_texts=Shared(safety_texts),
            foreign_fns={},
            std_kept=[],
            std_rest={},
            dyn_uses=[],
            phase=0,
            std_derives=Templates.none(),
            std_derived={},
        )

    ## The prelude, the ambient std modules, `target` and `builtin_impls`,
    ## resolved: `texts` gives each std module's source by name.
    pub pure def base(texts: dict[String, String]) -> Resolver:
        let (r, _) = Resolver.base_with_all(texts)
        return r

    ## `base`, and a copy of it that loads every std module a program may
    ## import besides, which the base makes their derived impls on.
    pub pure def base_with_all(texts: dict[String, String]) -> (Resolver, Resolver):
        var (r, templates) = Resolver.base_core(texts, {}, None)
        # The std modules a program may import, parsed once.
        var parsed: dict[String, Module] = {}
        for name in importable():
            let text = text_of(texts, name)
            if not text.is_empty():
                let module = build.module(parse(text, Catalog.parse("")).tree)
                _ = parsed.insert(name.to_string(), module)
        r.std_parsed = Shared(parsed)
        # Their derived impls, unfolded now on a copy that loads them all:
        # stage 0 unfolds them whenever a program loads the module, and the
        # text is the same each time.
        var all = r.copy()
        for name in importable():
            if let Some(module) = r.std_parsed.get(name.to_string()):
                _ = all.load_std_module(name, module.copy(), text_of(texts, name), templates)
        r.std_derived = all.std_derived.copy()
        # The std modules' texts were for the bounds their derived impls
        # repeat.
        r.module_texts = {}
        r.std_derives = templates
        # The copy resolves them all, for what their bodies ask of a program
        # that imports them (`typeck.std_promotions`).
        all.resolve_pending()
        r.mark_base()
        return (r, all)

    ## Every std module a program may import parsed, for a base a server
    ## keeps (RULES.md, R220): its syntax for the imports of each request's
    ## resolution, which a base made from the cache otherwise parses at each
    ## import, and its names for the name pass's environment, which the name
    ## pass otherwise reads and parses at each import. A module the base
    ## parsed already keeps its syntax.
    pub pure def parse_importables(mut self, texts: dict[String, String]):
        var parsed: dict[String, Module] = {}
        var names: dict[String, ModuleNames] = {}
        for name in importable():
            let text = text_of(texts, name)
            if text.is_empty():
                continue
            let p = parse(text, Catalog.parse(""))
            _ = names.insert(name.to_string(), ModuleNames.of(text, p.tree))
            if let Some(m) = self.std_parsed.get(name.to_string()):
                _ = parsed.insert(name.to_string(), m.copy())
            else:
                _ = parsed.insert(name.to_string(), build.module(p.tree))
        self.std_parsed = Shared(parsed)
        let current = self.environment.copy()
        if let Some(e) = current:
            var env = e.copy()
            for (name, these) in names.items():
                if not env.std.contains(name.copy()):
                    _ = env.std.insert(name.copy(), these.copy())
            self.environment = Some(env)

    ## `base` made from what `base_with_all`'s copy made before, the derived
    ## impls of every std module by name (`main.base_of`'s cache): the
    ## modules a program may import are parsed when one imports them.
    pub pure def base_cached(
        texts: dict[String, String], derived: dict[String, String], marked: StdMarks
    ) -> Resolver:
        var (r, templates) = Resolver.base_core(texts, derived, Some(marked.copy()))
        var sources: dict[String, String] = {}
        for name in importable():
            let text = text_of(texts, name)
            if not text.is_empty():
                _ = sources.insert(name.to_string(), text.to_string())
        r.std_sources = Shared(sources)
        r.std_derived = derived.copy()
        r.module_texts = {}
        r.std_derives = templates
        r.mark_base()
        return r

    ## The prelude, the ambient std modules, `target` and `builtin_impls`,
    ## loaded and resolved, with the prelude's derive templates; a module
    ## whose derived impls `derived` holds declares that text rather than
    ## unfolding it again, as a module a program imports does.
    ## `marked`: which std modules a program may import hold templates and
    ## `unsafe` code, as a base made whole found them, read from its cache
    ## rather than searched for in their texts again (RULES.md, R125).
    pure def base_core(
        texts: dict[String, String], derived: dict[String, String], marked: StdMarks?
    ) -> (Resolver, Templates):
        var r = Resolver.new()
        r.std_derived = derived.copy()
        # The prelude's derive templates, with its syntax and text, which
        # unfold the derived impls of every std module and stay for the
        # program's.
        let prelude_text = text_of(texts, "prelude")
        let prelude_parsed = parse(prelude_text, Catalog.parse(""))
        var names = ModuleNames.of(prelude_text, prelude_parsed.tree)
        var ambient_names: dict[String, ModuleNames] = {}
        let prelude_module = build.module(prelude_parsed.tree)
        let templates = derive_templates(prelude_module.copy(), prelude_text)
        let prelude = r.load_std_module("prelude", prelude_module, prelude_text, templates)
        r.prog.prelude = prelude
        r.fill_well_known()
        for name in ambient():
            let text = text_of(texts, name)
            let parsed = parse(text, Catalog.parse(""))
            let these = ModuleNames.of(text, parsed.tree)
            for v in these.variants:
                _ = names.variants.add(v.copy())
            _ = names.items.add(name.to_string())
            _ = ambient_names.insert(name.to_string(), these)
            let m = r.load_std_module(name, build.module(parsed.tree), text, templates)
            let d = r.new_def(prelude, name, TextRange.empty(0), Vis.Pub, DefKind.Module(m))
            _ = r.prog.modules[prelude.index].items.insert(name.to_string(), d)
        _ = names.items.add("target".to_string())
        # `std.mem`'s `Allocator` and `Global`, which the collections' headers
        # name, are the prelude's too: the module is the one a program that
        # imports it reads, loaded after the rest of the base so that their
        # definitions keep their places (RULES.md, R227).
        let mem_text = text_of(texts, "mem")
        let allocators = not mem_text.is_empty() and prelude_text.contains("A: Allocator = Global]")
        if allocators:
            for n in allocator_names():
                _ = names.items.add(n.to_string())
        r.environment = Some(Environment(prelude=names, std=ambient_names, parses=None))
        # The build's target, which a native build names (RULES.md, R116).
        let target_text = if texts.contains("target"): text_of(texts, "target") else: target()
        let t = r.load_std("target", target_text, templates)
        let td = r.new_def(prelude, "target", TextRange.empty(0), Vis.Pub, DefKind.Module(t))
        _ = r.prog.modules[prelude.index].items.insert("target".to_string(), td)
        _ = r.load_std("builtin_impls", builtin_impls(), templates)
        var mem_module: ModuleId? = None
        if allocators:
            # Its raw pointers, layouts and allocators alone, which the
            # allocators' signatures need; the rest, `Plain` and its impls on
            # the numbers among it, a program sees when it imports the module.
            let whole = build.module(parse(mem_text, Catalog.parse("")).tree)
            var head = whole.copy()
            head.items = []
            let cut = mem_text.find(MEM_HEAD_END) ?? mem_text.byte_len()
            for id in whole.items:
                if whole.ast.item(id).range.start < cut:
                    head.items.push(id)
            # Its derived impls come with the rest, whose `Debug` of `RawBuf`
            # they hold.
            let m = r.add_module("mem", True, head.copy())
            _ = r.std_loaded.insert("mem".to_string(), m)
            _ = r.module_texts.insert(m, mem_text.to_string())
            r.declare_items(m, head.items, "")
            _ = r.std_rest.insert("mem".to_string(), whole)
            mem_module = Some(m)
            for n in allocator_names():
                if let Some(d) = r.prog.modules[m.index].items.get(n.to_string()):
                    _ = r.prog.modules[prelude.index].items.insert(n.to_string(), d)
        r.resolve_pending()
        r.build_variant_index(0)
        r.check_traits(0)
        # The type checker never checks the std modules' bodies: their syntax
        # goes from the program, which each file copies, and stays for
        # lowering. `std.mem`'s stays, as a module a program imports keeps
        # it, for the derive of its `Plain` (RULES.md, R227).
        r.std_kept = r.sources.copy()
        for i in range(len(r.sources)):
            if let Some(m) = mem_module:
                if m.index == i:
                    continue
            r.sources[i] = Module(ast=Ast.new(), items=[], docs=[], broken_names=[], left_out=[])
        # The text of each std module a program may import that has
        # templates, for their instances.
        var safety_texts: dict[String, String] = {}
        for name in importable():
            let text = text_of(texts, name)
            var reflects = False
            var unsafe_ = False
            match marked:
                case Some(m):
                    reflects = m.reflecting.contains(name.to_string())
                    unsafe_ = m.unsafe_code.contains(name.to_string())
                case None:
                    reflects = text.contains("reflect.")
                    unsafe_ = text.contains("unsafe ")
            if reflects:
                _ = r.std_texts.insert(name.to_string(), text.to_string())
            if unsafe_:
                _ = safety_texts.insert(name.to_string(), text.to_string())
        # The prelude's text too, for the instances of its generic methods
        # that ask `reflect` of their type parameters: the base keeps no
        # std module's syntax (RULES.md, R110).
        let prelude_name = r.prog.modules[r.prog.prelude.index].name.copy()
        _ = r.std_texts.insert(prelude_name, prelude_text.copy())
        r.std_safety_texts = Shared(safety_texts)
        return (r, templates)

    ## Records where the base's definitions end, and which of its functions
    ## each program makes an instance of whatever calls it (`base_eager`).
    pub pure def mark_base(mut self):
        self.base_defs = len(self.prog.defs)
        self.base_eager = []
        for i in range(len(self.prog.defs)):
            let d = DefId(index=i)
            if let Some(f) = self.prog.fn_info(d):
                if f.body.is_some() and f.made_once() and f.trait_.is_none():
                    self.base_eager.push(d)

    ## A prelude of the given text alone, resolved: no ambient modules, no
    ## `target` and no `builtin_impls` (for the tests).
    pub pure def base_from(prelude_text: str) -> Resolver:
        var r = Resolver.new()
        let prelude_module = build.module(parse(prelude_text, Catalog.parse("")).tree)
        let templates = derive_templates(prelude_module.copy(), prelude_text)
        let prelude = r.load_std_module("prelude", prelude_module, prelude_text, templates)
        r.prog.prelude = prelude
        r.fill_well_known()
        r.resolve_pending()
        r.build_variant_index(0)
        r.check_traits(0)
        r.module_texts = {}
        r.mark_base()
        return r

    ## Declares and resolves the root module, `module`, the syntax of a
    ## file: the base with the file's module added, a program of one module.
    pub pure def add_root(mut self, own module: Module, text: str, templates: Templates):
        let source = SourceModule(
            path=[], file=String.new(), syntax=module, text=text.to_string(), package=0
        )
        let package = SourcePackage(
            name=String.new(), deps=[], trusted=True, excluded=[], dev_only=[]
        )
        self.add_program([source], [package], templates)

    ## Declares and resolves a program of several modules and packages
    ## (stage 0's `resolve_session`; 09): every module of the program is
    ## declared before any import is resolved, so the modules of a package
    ## may name each other in any order; then the impls the compiler writes
    ## for each, and everything is resolved. The root module comes first,
    ## and the root package.
    pub pure def add_program(
        mut self,
        own modules: list[SourceModule],
        packages: list[SourcePackage],
        templates: Templates,
    ):
        let first_def = len(self.prog.defs)
        if not modules.is_empty():
            self.root_text = modules[0].text.copy()
        self.prog.with_tests = self.tests
        # The packages: the root package, std, then the dependencies.
        for k in range(len(packages)):
            var deps: list[(String, int)] = []
            for (n, d) in packages[k].deps:
                deps.push((n.copy(), package_id(d)))
            let data = PackageData(
                name=packages[k].name.copy(),
                trusted=packages[k].trusted or k == 0,
                deps=deps,
                root=None,
                excluded=packages[k].excluded.copy(),
                dev_only=packages[k].dev_only.copy(),
            )
            self.prog.packages.push(data)
            if k == 0:
                self.prog.packages.push(
                    PackageData(
                        name="std".to_string(),
                        trusted=True,
                        deps=[],
                        root=None,
                        excluded=[],
                        dev_only=[],
                    )
                )
        # `sir --tests --std`: the standard library's doc examples, before
        # the program's own tests, as stage 0 declares them (RULES.md, R185).
        if not self.std_doc_texts.is_empty():
            self.declare_std_doc_tests()
        # The program's own modules, the root module first: each is a module
        # of its package, and a child of the module its path's prefix names.
        var ids: list[ModuleId] = []
        var all_items: list[list[ItemId]] = []
        for i in range(len(modules)):
            let m = ref modules[i]
            let items = m.syntax.items.copy()
            all_items.push(items)
            var name = "main".to_string()
            if i > 0:
                name = m.path.join(".")
            let id = self.add_module(name, False, m.syntax.copy())
            self.prog.modules[id.index].package = package_id(m.package)
            self.prog.modules[id.index].path = m.path.copy()
            self.prog.modules[id.index].file = m.file.copy()
            _ = self.module_texts.insert(id, m.text.copy())
            self.prog.user_modules.push(id)
            ids.push(id)
        if let Some(root) = ids.first():
            self.prog.root = root
        if let Some(m) = modules.first():
            for n in m.syntax.broken_names:
                _ = self.prog.poisoned.add(n.copy())
        # The names an import on the target, which this build leaves out,
        # would bind: the name pass reports a use outside an `if comptime`
        # branch on the target, and one inside such a branch the build
        # leaves out is not checked (RULES.md, R106).
        for m in modules:
            for (n, c) in m.syntax.left_out:
                if c.starts_with("target."):
                    _ = self.prog.poisoned.add(n.copy())
        for i in range(len(modules)):
            self.link_module(ids[i], modules[i].path, modules[i].package, modules[i].file)
        # Every module's items, then the imports between them.
        self.deferring = True
        var owned: list[list[ItemId]] = []
        for i in range(len(modules)):
            let id = ids[i]
            # A dependency's tests and benchmarks are its own package's
            # business (stage 0's `own_items`).
            var items: list[ItemId] = []
            for it in all_items[i]:
                var tested = False
                match self.ast(id).item(it).kind:
                    case ItemKind.Test(_) | ItemKind.Suite(_) | ItemKind.Bench(_):
                        tested = True
                    case _:
                        pass
                if not (tested and modules[i].package != 0):
                    items.push(it)
            owned.push(items.copy())
            var declared = items.copy()
            # A script's top-level statements are its `main` (10).
            if modules[i].text.starts_with("#!"):
                declared = self.script_items(id, items)
            let prefix = test_prefix(modules[i].path)
            self.declare_items(id, declared, prefix)
            self.declare_trait_shims(id, declared)
            # The root package's doc examples are its tests too (10), when
            # the program is built with its tests.
            if modules[i].package == 0 and self.tests:
                self.declare_doc_tests(id, declared, prefix)
        self.deferring = False
        let deferred = self.deferred.copy()
        self.deferred = []
        # A `from` import of a name its module re-exports (`pub from`, 09)
        # waits for that module's own imports, which may come later: each
        # pass declares the imports whose names are there, until a pass
        # declares none, and the rest are declared as they are, each name
        # missing reported (RULES.md, R24).
        var waiting: list[(ModuleId, ItemId)] = []
        for (m, id) in deferred:
            if self.import_waits(m, id):
                waiting.push((m, id))
            else:
                self.declare_import(m, id)
        var progress = True
        while progress and not waiting.is_empty():
            progress = False
            var still: list[(ModuleId, ItemId)] = []
            for (m, id) in waiting:
                if self.import_waits(m, id):
                    still.push((m, id))
                else:
                    self.declare_import(m, id)
                    progress = True
            waiting = still
        for (m, id) in waiting:
            self.declare_import(m, id)
        self.sites_known = False
        for i in range(len(modules)):
            self.find_arbitrary_impls(ids[i], owned[i])
        for i in range(len(modules)):
            self.declare_derived(ids[i], owned[i], templates)
            self.declare_generators(ids[i], owned[i])
        self.declare_written_sites()
        self.resolve_pending()
        self.fold_const_args(ids)
        self.build_variant_index(first_def)
        self.check_traits(first_def)
        self.check_borrow_signatures(first_def)
        # What is made from now on (the instances of templates) comes after
        # everything, as in stage 0.
        self.phase = 9

    ## Makes a module of the program's source the child of the module its
    ## path's prefix names (a directory with no file of its own is a module
    ## too, whose items are its children), and a package's root module the
    ## one its imports name the package by (stage 0's `link_module`).
    pure def link_module(mut self, id: ModuleId, path: list[String], package: int, file: str):
        let pid = package_id(package)
        if len(path) == 1:
            if pid < len(self.prog.packages) and self.prog.packages[pid].root.is_none():
                self.prog.packages[pid].root = Some(id)
            return
        if len(path) < 2:
            return
        var prefix = path.copy()
        let last = prefix.pop() ?? String.new()
        let parent = self.module_at(prefix, pid, file)
        let d = self.new_def(parent, last, TextRange.empty(0), Vis.Pub, DefKind.Module(id))
        _ = self.prog.modules[parent.index].children.insert(last.copy(), id)
        _ = self.prog.modules[parent.index].items.insert(last, d)

    ## The module of the program at `path`, made (as a directory's module,
    ## with no items but its children) when no file is (stage 0's
    ## `module_at`); `pid` is its package's index in the program.
    pure def module_at(mut self, path: list[String], pid: int, file: str) -> ModuleId:
        for m in self.prog.user_modules:
            if self.prog.modules[m.index].path == path:
                return m
        let empty = Module(ast=Ast.new(), items=[], docs=[], broken_names=[], left_out=[])
        let id = self.add_module(path.join("."), False, empty)
        self.prog.modules[id.index].package = pid
        self.prog.modules[id.index].path = path.copy()
        self.prog.modules[id.index].file = file.to_string()
        self.prog.user_modules.push(id)
        # Linked as `link_module` would, with this package.
        if len(path) == 1:
            if pid < len(self.prog.packages) and self.prog.packages[pid].root.is_none():
                self.prog.packages[pid].root = Some(id)
        elif len(path) > 1:
            var prefix = path.copy()
            let last = prefix.pop() ?? String.new()
            let parent = self.module_at(prefix, pid, file)
            let d = self.new_def(parent, last, TextRange.empty(0), Vis.Pub, DefKind.Module(id))
            _ = self.prog.modules[parent.index].children.insert(last.copy(), id)
            _ = self.prog.modules[parent.index].items.insert(last, d)
        return id

    ## The text of a module of the program, or of one the compiler wrote,
    ## by which a range of its syntax is read.
    pub pure def text_of_module(self, module: ModuleId) -> String:
        if let Some(t) = self.module_texts.get(module):
            return t.copy()
        return self.root_text.copy()

    ## The text of a module whose `Safety:` lists are read (22): a module of
    ## the program, or a std module with unsafe code.
    pub pure def safety_text(self, module: ModuleId) -> String?:
        if let Some(t) = self.module_texts.get(module):
            return Some(t.copy())
        if self.is_std(module):
            let name = self.prog.modules[module.index].name.copy()
            if let Some(t) = Shared.get(self.std_safety_texts).get(name):
                return Some(t.copy())
            return None
        return Some(self.root_text.copy())

    ## Whether the lints of unsafe code are reported in `module`: a module
    ## of the program, not the standard library's nor one the compiler
    ## wrote.
    pure def lints_in(self, module: ModuleId) -> bool:
        return self.is_root(module) and not self.prog.modules[module.index].name.starts_with("<")

    ## Reports a warning in `module`, which leaves the program without an
    ## error.
    pure def warn_in(mut self, module: ModuleId, own d: Diagnostic):
        self.diags.push((module, d))

    ## Whether compile-time evaluation wrote `module` (a derive's impls, a
    ## template's instance, a value unfolded): code there holds no `unsafe`
    ## (`E0615`, D-085). Doc examples are in their source file.
    pure def written_by_comptime(self, module: ModuleId) -> bool:
        let name = ref self.prog.modules[module.index].name
        return name.starts_with("<") and not name.starts_with("<doc>/")

    ## The text at `range` of a module's text.
    ## The `##` comment above what starts at `at` in `module` (RULES.md,
    ## R117): none for a std module, whose text the base does not keep.
    pub pure def doc_in(self, module: ModuleId, at: int) -> String:
        if let Some(t) = self.module_texts.get(module):
            return doc_above(t, at).join("\n")
        if self.is_std(module):
            return String.new()
        return doc_above(self.root_text, at).join("\n")

    ## The `##` comment above a variant's field that starts its own line,
    ## `Circle(\n    ## The radius.\n    radius: f64,\n)`; none for a field
    ## on the variant's line, whose comment above is the variant's
    ## (RULES.md, R129).
    pub pure def variant_field_doc(self, module: ModuleId, at: int) -> String:
        if let Some(t) = self.module_texts.get(module):
            return own_line_doc(t, at)
        if self.is_std(module):
            return String.new()
        return own_line_doc(self.root_text, at)

    ## Attributes as reflection gives them: each name and its arguments'
    ## text, none in the standard library (RULES.md, R161).
    pub pure def attr_data(
        self, module: ModuleId, attrs: list[Attr]
    ) -> list[(String, list[String])]:
        var out: list[(String, list[String])] = []
        if self.is_std(module):
            return out
        for a in attrs:
            var args: list[String] = []
            for x in a.args:
                args.push(self.text_in(module, x.range))
            out.push((a.name.copy(), args))
        return out

    pub pure def text_in(self, module: ModuleId, range: TextRange) -> String:
        if let Some(t) = self.module_texts.get(module):
            return slice_text(t, range)
        # A std module's text is the base's, which a program does not keep.
        if self.is_std(module):
            return String.new()
        return slice_text(self.root_text, range)

    ## The `from` clauses and the elision rules of every function from the
    ## definition `first` on that is not the standard library's (stage 0's
    ## `check_borrow_signatures`; 04, "Borrowing rules in detail"): stage 0
    ## reports a `from` clause on a result that cannot borrow, one that
    ## names no borrowed parameter, and a borrowing result of more than one
    ## borrowed parameter without one.
    pure def check_borrow_signatures(mut self, first: int):
        for i in range(first, len(self.prog.defs)):
            let module = self.prog.defs[i].module
            if self.prog.modules[module.index].is_std:
                continue
            let DefKind.Fn(f) = self.prog.defs[i].kind().copy() else:
                continue
            if f.header_broken:
                continue
            let shape = self.prog.result_shape(mut self.types, f.ret)
            let params = self.prog.sig_params(f)
            let def_span = self.prog.defs[i].span
            let fname = self.prog.defs[i].name.copy()
            let ret_span = f.ret_span ?? def_span
            if not f.from_.is_empty():
                if shape == ResultShape.Plain:
                    let span = f.from_spans[0]
                    let shown = self.prog.display(self.types, f.ret)
                    # The fix removes ` from a, b`: from the end of the
                    # result type to the end of the last name.
                    let last = f.from_spans[len(f.from_spans) - 1].end
                    var d = Diagnostic.new(Msg.BorrowFromWithoutBorrow, span.start, span.end)
                    d = d.with("function", fname).with("ty", shown)
                    d = d.label_with(
                        Msg.BorrowResultCannotBorrow, ret_span.start, ret_span.end, "ty", shown
                    )
                    let edit = Edit(start=ret_span.end, end=last, text=String.new())
                    self.report_other(module, d.fix_params(Msg.BorrowRemoveFrom, [], [edit]))
                    continue
                for k in range(len(f.from_)):
                    let name = f.from_[k].copy()
                    var ok = False
                    var named = False
                    for p in params:
                        if p.name == name:
                            named = True
                            if self.prog.is_borrowed_param(mut self.types, p):
                                ok = True
                    if not ok:
                        let span = f.from_spans[k]
                        var d = Diagnostic.new(Msg.BorrowFromNotAParameter, span.start, span.end)
                        d = d.with("name", name).with("function", fname)
                        if named:
                            # Where the parameter is written; `self` has no
                            # span of its own.
                            var at = def_span
                            for p in f.params:
                                if p.name == name:
                                    at = p.span
                                    break
                            d = d.label_with(
                                Msg.BorrowNotBorrowedParam, at.start, at.end, "name", name
                            )
                        else:
                            var label = Label(
                                msg=Msg.BorrowNoSuchParam,
                                start=def_span.start,
                                end=def_span.end,
                                params=[
                                    MsgParam(name="function".to_string(), value=fname.copy()),
                                    MsgParam(name="name".to_string(), value=name.copy()),
                                ],
                                file=-1,
                            )
                            d.labels.push(label)
                        self.report_other(module, d.note(Msg.BorrowFromOnlyParameters))
                continue
            if shape == ResultShape.Plain:
                continue
            var borrowed: list[String] = []
            for p in params:
                if self.prog.is_borrowed_param(mut self.types, p):
                    borrowed.push(p.name.copy())
            let self_wins = f.self_mode.is_some()
                and not borrowed.is_empty()
                and borrowed[0] == "self"
            if len(borrowed) >= 2 and not self_wins:
                var names = String.new()
                for n in borrowed:
                    if not names.is_empty():
                        names.push(", ")
                    names.push(n)
                let shown = self.prog.display(self.types, f.ret)
                var d = Diagnostic.new(Msg.BorrowFromRequired, ret_span.start, ret_span.end)
                d = d.with("name", self.prog.defs[i].name).with("ret", shown).with("params", names)
                for n in borrowed:
                    # Where the parameter is written; `self` has no span of
                    # its own.
                    var at = def_span
                    for p in f.params:
                        if p.name == n:
                            at = p.span
                            break
                    d = d.label_with(Msg.BorrowBorrowedParam, at.start, at.end, "name", n)
                # The `from` clause names them all, which is always allowed;
                # the author may then drop the ones the result never borrows.
                let edit = Edit(start=ret_span.end, end=ret_span.end, text=" from {names}")
                let param = MsgParam(name="param".to_string(), value=names.copy())
                # A result of text may own it instead (RULES.md, R24): a
                # `str` read from a file, or made in the function, borrows no
                # parameter, and a `from` clause would lead to E0407. It comes
                # first unless the body returns a borrowed parameter or a part
                # of one, which the `from` clause fits and a `String` copies
                # (RULES.md, R48).
                var from_first = True
                var own_fix: (Edit, MsgParam)? = None
                if let Some(owned) = self.owned_text_type(module, ret_span):
                    let own_edit = Edit(start=ret_span.start, end=ret_span.end, text=owned.copy())
                    own_fix = Some((own_edit, MsgParam(name="ty".to_string(), value=owned.copy())))
                    if let Some(b) = f.body:
                        from_first = self.returns_borrowed(module, b, borrowed)
                if from_first:
                    d = d.fix_params(Msg.BorrowAddFrom, [param.copy()], [edit.copy()])
                if let Some((own_edit, ty)) = own_fix:
                    d = d.fix_params(Msg.BorrowOwnResult, [ty.copy()], [own_edit.copy()])
                if not from_first:
                    d = d.fix_params(Msg.BorrowAddFrom, [param], [edit])
                self.report_other(module, d)

    ## Whether a `return` of the body `b` gives one of the parameters
    ## `names` or a part of one (`a`, `a[1:]`, `a.trim()`, `if c: a else:
    ## b`): a result that borrows a parameter (RULES.md, R48).
    pure def returns_borrowed(self, module: ModuleId, b: Block, names: list[String]) -> bool:
        for s in b.stmts:
            if self.stmt_returns_borrowed(module, s, names):
                return True
        return False

    pure def stmt_returns_borrowed(self, module: ModuleId, s: StmtId, names: list[String]) -> bool:
        let ast = self.ast(module)
        match ast.stmt(s).kind:
            case StmtKind.Return(Some(e)):
                return self.gives_param(module, e, names, 0)
            case StmtKind.If(branches, else_block):
                for (_, blk) in branches:
                    if self.returns_borrowed(module, blk, names):
                        return True
                if let Some(blk) = else_block:
                    return self.returns_borrowed(module, blk, names)
                return False
            case StmtKind.While(_, body) | StmtKind.For(_, _, _, body) | StmtKind.Unsafe(body):
                return self.returns_borrowed(module, body, names)
            case StmtKind.With(_, _, body):
                return self.returns_borrowed(module, body, names)
            case StmtKind.Expr(e):
                if let ExprKind.Match(_, arms) = ast.expr(e).kind:
                    for a in arms:
                        if let ArmBody.Block(blk) = a.body:
                            if self.returns_borrowed(module, blk, names):
                                return True
                return False
            case _:
                return False

    ## Whether the expression gives one of `names` or a part of one.
    pure def gives_param(
        self, module: ModuleId, e: ExprId, names: list[String], depth: int
    ) -> bool:
        if depth > 16:
            return False
        let ast = self.ast(module)
        match ast.expr(e).kind:
            case ExprKind.Name(n):
                return names.contains(n)
            case ExprKind.Paren(x) | ExprKind.Field(x, _) | ExprKind.Index(x, _):
                return self.gives_param(module, x, names, depth + 1)
            case ExprKind.Call(callee, _, _):
                if let ExprKind.Field(x, _) = ast.expr(callee).kind:
                    return self.gives_param(module, x, names, depth + 1)
                return False
            case ExprKind.If(branches, else_):
                for (_, v) in branches:
                    if self.gives_param(module, v, names, depth + 1):
                        return True
                if let Some(v) = else_:
                    return self.gives_param(module, v, names, depth + 1)
                return False
            case ExprKind.Match(_, arms):
                for a in arms:
                    if let ArmBody.Expr(v) = a.body:
                        if self.gives_param(module, v, names, depth + 1):
                            return True
                return False
            case _:
                return False

    ## The program, its table of types and the root module's syntax.
    pub pure def into_parts(own self) -> (Program, Types, Module):
        var sources = self.sources
        var root = Module(ast=Ast.new(), items=[], docs=[], broken_names=[], left_out=[])
        let at = self.prog.root.index
        if at < len(sources):
            # The modules the root module imports come after it.
            while len(sources) > at + 1:
                _ = sources.pop()
            root = sources.pop() ?? root
        return (self.prog, self.types, root)

    ## How many type parameters the type `d` declares, as written.
    pub pure def declared_type_params(self, d: DefId) -> int:
        if let Some(ps) = self.type_params.get(d):
            return len(ps)
        return 0

    ## The syntax of the module of doc examples, when there is one.
    pub pure def doc_syntax(self) -> Module?:
        let (m, _) = self.docs.first() else:
            return None
        if m.index >= len(self.sources):
            return None
        return Some(self.sources[m.index].copy())

    pub pure def add_module(mut self, name: str, is_std: bool, own module: Module) -> ModuleId:
        let id = ModuleId(index=len(self.prog.modules))
        self.prog.modules.push(ModuleData.new(name, is_std))
        self.sources.push(module)
        return id

    ## `@comptime_budget(steps=N)` (08): the item's own budget for its
    ## `comptime` expressions; one written otherwise is stage 0's
    ## `comptime.budget-attribute`.
    pure def comptime_budget(mut self, module: ModuleId, def_: DefId, attrs: list[Attr]):
        for a in attrs:
            if a.name != "comptime_budget":
                continue
            var steps: int? = None
            if len(a.args) == 1:
                if let Some(n) = a.args[0].name:
                    if n.text == "steps":
                        if let ExprKind.Int(_, value, suffix) = self.ast(module).expr(
                            a.args[0].value
                        ).kind:
                            if let Some(v) = value:
                                if suffix.is_none():
                                    if let Some(k) = v.to_int():
                                        if k > 0:
                                            steps = Some(k)
            match steps:
                case Some(k):
                    _ = self.prog.comptime_budgets.insert(def_, k)
                case None:
                    # The attribute without the line break after it.
                    let written = self.text_in(module, a.range)
                    let end = a.range.start + written.trim_end().byte_len()
                    let d = Diagnostic.new(Msg.ComptimeBudgetAttribute, a.range.start, end)
                    self.report_other(module, d)

    ## Whether the std module `name` is loaded.
    pub pure def is_loaded(self, name: str) -> bool:
        return self.std_loaded.contains(name.to_string())

    ## The std module loaded under `name`.
    pub pure def loaded(self, name: str) -> ModuleId?:
        if let Some(m) = self.std_loaded.get(name.to_string()):
            return Some(m)
        return None

    ## Declares the items of the std module `name`, loaded as `m`, that the
    ## base left out (`std_rest`), when a program imports it, and the derived
    ## impls of the whole module, which the base did not declare (unfolded
    ## from `templates` by the base's copy that loads every module, and the
    ## text it made after).
    pure def complete_std(mut self, name: str, m: ModuleId, templates: Templates):
        let whole = self.std_rest.remove(name.to_string()) else:
            return
        var rest: list[ItemId] = []
        if m.index < len(self.sources):
            for id in whole.items:
                if not self.sources[m.index].items.contains(id):
                    rest.push(id)
            self.sources[m.index] = whole.copy()
        # The definitions the base made go where the import makes the rest,
        # in their order, as an import of the whole module made them
        # (`def_rank`).
        let start = len(self.prog.defs)
        var head: list[int] = []
        for i in range(start):
            if self.prog.defs[i].module == m:
                head.push(i)
        if len(head) < RANK_STEP - 1 and start > 0:
            for k in range(len(head)):
                let at = self.phase * RANK_PHASE + (start - 1) * RANK_STEP + 1 + k
                _ = self.prog.reranked.insert(head[k], at)
        self.declare_items(m, rest, "")
        self.declare_derived(m, whole.items, templates)

    pure def load_std(mut self, name: str, text: str, templates: Templates) -> ModuleId:
        let module = build.module(parse(text, Catalog.parse("")).tree)
        return self.load_std_module(name, module, text, templates)

    ## Declares a parsed std module, once, and its derived impls: unfolded
    ## from the prelude's `templates` while the base is made, with the
    ## module's `text` for the bounds they repeat; the text the base made
    ## (`std_derived`) for a module a program imports.
    pure def load_std_module(
        mut self, name: str, own module: Module, text: str, templates: Templates
    ) -> ModuleId:
        let loaded = self.std_loaded.get(name.to_string()).copied()
        if let Some(m) = loaded:
            self.complete_std(name, m, templates)
            return m
        let items = module.items.copy()
        let m = self.add_module(name, True, module)
        _ = self.std_loaded.insert(name.to_string(), m)
        if not text.is_empty():
            _ = self.module_texts.insert(m, text.to_string())
        self.declare_items(m, items, "")
        self.declare_derived(m, items, templates)
        return m

    pure def fill_well_known(mut self):
        let p = self.prog.prelude
        var wk = WellKnown.none()
        wk.option = self.prog.lookup_in(p, "Option")
        wk.result = self.prog.lookup_in(p, "Result")
        wk.ordering = self.prog.lookup_in(p, "Ordering")
        wk.string = self.prog.lookup_in(p, "String")
        wk.list = self.prog.lookup_in(p, "list")
        wk.dict = self.prog.lookup_in(p, "dict")
        wk.set = self.prog.lookup_in(p, "set")
        wk.iter = self.prog.lookup_in(p, "Iter")
        wk.iterable = self.prog.lookup_in(p, "Iterable")
        wk.range = self.prog.lookup_in(p, "range")
        wk.boxed = self.prog.lookup_in(p, "Box")
        wk.display = self.prog.lookup_in(p, "Display")
        wk.debug = self.prog.lookup_in(p, "Debug")
        wk.eq = self.prog.lookup_in(p, "Eq")
        wk.partial_ord = self.prog.lookup_in(p, "PartialOrd")
        wk.ord = self.prog.lookup_in(p, "Ord")
        wk.hash = self.prog.lookup_in(p, "Hash")
        wk.len = self.prog.lookup_in(p, "Len")
        wk.contains = self.prog.lookup_in(p, "Contains")
        wk.copy = self.prog.lookup_in(p, "Copy")
        wk.drop = self.prog.lookup_in(p, "Drop")
        wk.iterator = self.prog.lookup_in(p, "Iterator")
        wk.add = self.prog.lookup_in(p, "Add")
        wk.sub = self.prog.lookup_in(p, "Sub")
        wk.mul = self.prog.lookup_in(p, "Mul")
        wk.div = self.prog.lookup_in(p, "Div")
        wk.rem = self.prog.lookup_in(p, "Rem")
        wk.neg = self.prog.lookup_in(p, "Neg")
        wk.from_literal = self.prog.lookup_in(p, "FromLiteral")
        wk.send = self.prog.lookup_in(p, "Send")
        wk.sync = self.prog.lookup_in(p, "Sync")
        wk.escapable = self.prog.lookup_in(p, "Escapable")
        wk.sized = self.prog.lookup_in(p, "Sized")
        wk.system = self.prog.lookup_in(p, "System")
        wk.formatter = self.prog.lookup_in(p, "Formatter")
        wk.fs_ops = self.prog.lookup_in(p, "FsOps")
        wk.net_ops = self.prog.lookup_in(p, "NetOps")
        wk.clock_ops = self.prog.lookup_in(p, "ClockOps")
        wk.rand_ops = self.prog.lookup_in(p, "RandOps")
        wk.env_ops = self.prog.lookup_in(p, "EnvOps")
        wk.stdin_ops = self.prog.lookup_in(p, "StdinOps")
        wk.proc_ops = self.prog.lookup_in(p, "ProcOps")
        self.prog.wk = wk

    pub pure def is_std(self, module: ModuleId) -> bool:
        return self.prog.modules[module.index].is_std

    pure def is_root(self, module: ModuleId) -> bool:
        return not self.is_std(module)

    ## A diagnostic of a type's constant argument: the type checker's are
    ## kept, and the others reported but an undefined name in the program's
    ## own modules, which the name pass reports.
    pure def report_const(mut self, module: ModuleId, own d: Diagnostic):
        if d.msg.id().starts_with("type."):
            self.diags.push((module, d))
        elif d.msg == Msg.ResolveUndefinedName and not self.reports_names(module):
            if self.is_root(module):
                self.other_error = True
        else:
            self.report_other(module, d)

    ## Whether the names a module's declarations cannot find are the
    ## resolver's to report, as stage 0's resolver reports them: the module
    ## is one the compiler wrote for the program (an instance of a template,
    ## derived and delegated impls, interceptors and fakes), which stage 1's
    ## name pass, reading the program's own modules, never sees.
    pub pure def reports_names(self, module: ModuleId) -> bool:
        return not self.is_std(module) and not self.prog.user_modules.contains(module)

    ## `resolve.undefined-type` for `name`, written at `at` in a module whose
    ## names the resolver reports (`reports_names`), with the closest type
    ## in scope as its fix (stage 0's `similar_type_fix`: the module's, the
    ## prelude's, the builtin scalars); a name a failed import or a broken
    ## declaration poisoned is not reported again.
    pure def undefined_type(mut self, module: ModuleId, name: str, at: TextRange):
        if not self.reports_names(module) or self.prog.poisoned.contains(name.to_string()):
            return
        var names: list[String] = []
        for s in SIMILAR_SCALARS:
            names.push(s.to_string())
        for m in [module, self.prog.prelude]:
            for (k, d) in self.prog.modules[m.index].items.items():
                if k.starts_with("_"):
                    continue
                match self.prog.defs[d.index].kind():
                    case DefKind.Struct(_) | DefKind.Enum(_) | DefKind.ErrorSet(_):
                        names.push(k.copy())
                    case DefKind.TypeAlias(_) | DefKind.Refinement(_) | DefKind.Trait(_):
                        names.push(k.copy())
                    case _:
                        pass
        var d = Diagnostic.new(Msg.ResolveUndefinedType, at.start, at.end).with("name", name)
        if let Some(similar) = closest(name, names):
            d = d.fix_at(Msg.ResolveSimilarType, at.start, at.end, similar)
        self.report_other(module, d)

    ## A constant's value as folding reads it.
    pure def value_terms(self, module: ModuleId, value: ExprId?) -> list[Term]:
        let e = value else:
            return []
        return folding.terms(self.ast(module), e)

    ## Puts the root module beyond the slice, for `why`.
    pure def beyond_in(mut self, module: ModuleId, why: str):
        if self.is_root(module) and self.beyond.is_none():
            self.beyond = Some(why.to_string())

    ## `stage0.unsupported` at `range` of `module`: a construct stage 0
    ## does not implement yet.
    pure def unsupported_in(
        mut self, module: ModuleId, range: TextRange, construct: str, phase: str
    ):
        var d = Diagnostic.new(Msg.Stage0Unsupported, range.start, range.end)
        self.report_other(module, d.with("construct", construct).with("phase", phase))

    ## `resolve.type-argument-count` for `name` at `range` of `module`.
    pure def argument_count(
        mut self, module: ModuleId, range: TextRange, name: str, expected: int, found: int
    ):
        var d = Diagnostic.new(Msg.ResolveTypeArgumentCount, range.start, range.end).with(
            "name", name
        )
        self.report_other(module, d.with("expected", "{expected}").with("found", "{found}"))

    ## Reports `m` at `at` with one parameter, for the module `module`.
    pure def report_at(mut self, module: ModuleId, m: Msg, at: TextRange, name: str, value: str):
        let diag = Diagnostic.new(m, at.start, at.end).with(name, value)
        self.diags.push((module, diag))

    pub pure def new_def(
        mut self, module: ModuleId, name: str, range: TextRange, vis: Vis, own kind: DefKind
    ) -> DefId:
        let id = DefId(index=len(self.prog.defs))
        self.prog.defs.push(Def.new(name.to_string(), module, range, vis, kind))
        self.prog.phases.push(self.phase)
        return id

    ## Declares a name in a module; a second declaration is the name pass's
    ## to report, and the first stays.
    pure def bind(mut self, module: ModuleId, name: str, def_: DefId):
        if name.is_empty():
            return
        if self.prog.modules[module.index].items.contains(name.to_string()):
            # `resolve.duplicate-definition`.
            if self.is_root(module):
                self.other_error = True
            return
        _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        self.prog.modules[module.index].order.push(def_)

    ## Reports an error of the resolver's that is not the type checker's
    ## own (a `resolve.` or `borrow.` message) in `module`, when that is
    ## the root module: `check` prints it with the rest.
    pub pure def report_other(mut self, module: ModuleId, own d: Diagnostic):
        if self.is_root(module):
            self.other_error = True
            self.diags.push((module, d))

    ## Where `keyword` is written last before byte `start` on its line, as an
    ## empty range for a fix to write before it (stage 0's `keyword_before`).
    ## Records the `@tag("...")`s on a test (stage 0's `test_tags`): each
    ## argument's text without its quotes.
    pure def test_tags(mut self, def_: DefId, attrs: list[Attr], module: ModuleId):
        var tags: list[String] = []
        # A suite's `@tag`s tag each of its tests, before their own (17;
        # RULES.md, R40).
        var all = self.suite_tags.copy()
        for a in attrs:
            all.push(a.copy())
        for a in all:
            if a.name != "tag":
                continue
            for x in a.args:
                let written = self.text_in(module, x.range)
                var text: str = written
                while text.starts_with("\""):
                    text = text.strip_prefix("\"")
                while text.ends_with("\""):
                    text = text.strip_suffix("\"")
                tags.push(text.to_string())
        if not tags.is_empty():
            _ = self.prog.test_tags.insert(def_, tags)

    ## A field's type written at `at` with each `str` in it a `String`, when
    ## `str` is what it borrows by (no `ref` in it): the fix of a struct
    ## that holds text (R16).
    pure def owned_text_type(self, module: ModuleId, at: TextRange) -> String?:
        let owned = self.text_of_module(module)
        let text: str = owned
        if at.end > text.byte_len() or at.start >= at.end:
            return None
        let written = text.byte_slice(at.start, at.end)
        var out = String.new()
        var word = String.new()
        var changed = False
        for c in written.chars():
            if c.is_alphabetic() or c.is_digit() or c == '_':
                word.push("{c}")
                continue
            if word == "ref" or word == "view":
                return None
            if word == "str":
                out.push("String")
                changed = True
            else:
                out.push(word)
            word = String.new()
            out.push("{c}")
        if word == "ref":
            return None
        if word == "str":
            out.push("String")
            changed = True
        else:
            out.push(word)
        if not changed:
            return None
        return Some(out)

    pure def keyword_before(self, module: ModuleId, start: int, keyword: str) -> int?:
        let owned = self.text_of_module(module)
        let text: str = owned
        if start > text.byte_len():
            return None
        var line_start = start
        while line_start > 0 and text.byte_at(line_start - 1) != 10:
            line_start -= 1
        let line = text.byte_slice(line_start, start)
        var found: int? = None
        var from_ = 0
        while let Some(k) = line.byte_slice(from_, line.byte_len()).find(keyword):
            found = Some(line_start + from_ + k)
            from_ = from_ + k + 1
        return found

    ## A signature as an impl must write it (stage 0's `signature_text`):
    ## `pure def name(self, x: T) -> R`, each type substituted with `args`,
    ## when given, and normalized, shown with the generic parameters named
    ## `names`.
    pure def signature_text(
        mut self, name: str, f: FnInfo, args: list[Ty]?, env: list[Predicate], names: list[String]
    ) -> String:
        var parts = String.new()
        if let Some(m) = f.self_mode:
            parts.push("{mode_text(m)}self")
        for p in f.params:
            if not parts.is_empty():
                parts.push(", ")
            parts.push("{mode_text(p.mode)}{p.name}: {self.signature_ty(p.ty, args, env, names)}")
        var ret = String.new()
        if f.ret != Ty.unit():
            ret = " -> {self.signature_ty(f.ret, args, env, names)}"
        let prefix = if f.pure: "pure " else: ""
        let marker = if f.unsafe_: "unsafe " else: ""
        return "{prefix}{marker}def {name}({parts}){ret}"

    pure def signature_ty(
        mut self, t: Ty, args: list[Ty]?, env: list[Predicate], names: list[String]
    ) -> String:
        var ty = t
        if let Some(a) = args:
            let s = self.types.subst(t, a)
            ty = self.prog.normalize(mut self.types, s, env)
        return self.prog.display_in(self.types, ty, names)

    pub pure def placeholder_fn(self, own kind: FnKind) -> FnInfo:
        return FnInfo(
            generics=[],
            impl_generics=0,
            predicates=[],
            trait_=None,
            impl_=None,
            self_mode=None,
            owner=None,
            params=[],
            keyword_only_from=None,
            positional_only_until=0,
            ret=Ty.unit(),
            ret_span=None,
            err_inferred=False,
            pure=False,
            comptime_=False,
            unsafe_=False,
            foreign=False,
            obligations=None,
            intrinsic=None,
            structural=None,
            keeps=[],
            from_=[],
            from_spans=[],
            internal=False,
            body=None,
            kind=kind,
            header_broken=False,
            body_broken=False,
            contracts=False,
            template=False,
            type_params=[],
            deprecated=None,
            assoc_const=False,
        )

    pub pure def ast(self, module: ModuleId) -> ref Ast:
        return ref self.sources[module.index].ast

    # ---------------------------------------------------------------- pass 1

    pub pure def declare_items(mut self, module: ModuleId, items: list[ItemId], test_prefix: str):
        var attributed: list[(String, list[(String, list[String])])] = []
        for id in items:
            let item = self.sources[module.index].ast.item(id).copy()
            self.check_std_only_attrs(module, item.attrs)
            # The attributes of a type of the program, as data for
            # `reflect.attributes_of`.
            if not self.is_std(module) and not item.attrs.is_empty():
                var type_name: String? = None
                match item.kind:
                    case ItemKind.Struct(s):
                        type_name = Some(s.name.text.copy())
                    case ItemKind.Enum(e):
                        type_name = Some(e.name.text.copy())
                    case ItemKind.ErrorSet(e):
                        type_name = Some(e.name.text.copy())
                    case _:
                        pass
                if let Some(n) = type_name:
                    var attrs: list[(String, list[String])] = []
                    for a in item.attrs:
                        var args: list[String] = []
                        for x in a.args:
                            args.push(self.text_in(module, x.range))
                        attrs.push((a.name.copy(), args))
                    attributed.push((n.copy(), attrs))
            match item.kind:
                case ItemKind.Fn(f):
                    let info = self.placeholder_fn(FnKind.Free)
                    let def_ = self.new_def(
                        module, f.name.text, f.name.range, item.vis, DefKind.Fn(info)
                    )
                    self.bind(module, f.name.text, def_)
                    self.comptime_budget(module, def_, item.attrs)
                    self.pending.push(
                        Pending.Fn(def_=def_, module=module, ast=f.copy(), owner=None)
                    )
                case ItemKind.Struct(s):
                    let info = StructInfo(
                        generics=[],
                        fields=[],
                        builtin=None,
                        copy=False,
                        view_=s.is_view,
                        must_consume=False,
                        derives=[],
                        drop=None,
                    )
                    let def_ = self.new_def(
                        module, s.name.text, s.name.range, item.vis, DefKind.Struct(info)
                    )
                    self.bind(module, s.name.text, def_)
                    self.deprecate(module, def_, item.attrs)
                    _ = self.type_params.insert(def_, s.generics.copy())
                    self.declare_methods(module, def_, s.methods)
                    for c in s.consts:
                        self.declare_assoc_const(module, TyKey.Adt(def_), s.name.text, c)
                    # `invariant e` lines (07): a method of the struct that
                    # checks them, which construction, every `mut self`
                    # method and the `Mutex` rule call.
                    if not s.invariants.is_empty():
                        self.declare_invariant(module, def_, item.node, s)
                    self.pending.push(
                        Pending.Struct(
                            def_=def_, module=module, ast=s.copy(), attrs=item.attrs.copy()
                        )
                    )
                case ItemKind.Enum(e):
                    self.declare_enum(module, e, item.vis, item.attrs, False)
                case ItemKind.ErrorSet(e):
                    self.declare_enum(module, e, item.vis, item.attrs, True)
                case ItemKind.Impl(i):
                    self.pending.push(Pending.Impl(module=module, ast=i.copy(), range=item.range))
                case ItemKind.Trait(t):
                    let def_ = self.new_def(
                        module, t.name.text, t.name.range, item.vis, DefKind.Trait(TraitInfo.new())
                    )
                    self.bind(module, t.name.text, def_)
                    self.deprecate(module, def_, item.attrs)
                    _ = self.type_params.insert(def_, t.generics.copy())
                    # The trait's derive, which `@derive` runs at compile time.
                    for m in t.methods:
                        if not m.is_comptime or m.name.text != "derive":
                            continue
                        let source = self.text_of_module(module)
                        let src = Src(ast=ref self.sources[module.index].ast, source=source)
                        if template_parts(src, m).is_some():
                            if not self.is_std(module):
                                let key = (module.index, t.name.text.copy())
                                _ = self.derive_templates.insert(key, m.copy())
                        else:
                            let at = m.name.range
                            var d = Diagnostic.new(Msg.ComptimeDeriveTemplate, at.start, at.end)
                            d = d.with("trait", t.name.text)
                            # A template that returns its impl after other
                            # statements is told what may come first
                            # (RULES.md, R130).
                            if returns_impl(src, m):
                                d = d.note(Msg.ComptimeDeriveChecks)
                            self.report_other(module, d)
                            # Its `@derive`s and the uses of what it would
                            # have written are not reported again (RULES.md,
                            # R144).
                            _ = self.prog.refused_derives.add(t.name.text.copy())
                    self.pending.push(
                        Pending.Trait(
                            def_=def_, module=module, ast=t.copy(), attrs=item.attrs.copy()
                        )
                    )
                case ItemKind.Import(_) | ItemKind.FromImport(_):
                    if self.deferring:
                        self.deferred.push((module, id))
                    else:
                        self.declare_import(module, id)
                case ItemKind.Test(t):
                    let name = prefixed(test_prefix, t.name)
                    # A parametrised test is a test for each case (17).
                    for (case_name, case_def) in self.test_cases(module, name, t):
                        let info = self.placeholder_fn(FnKind.Test(case_name.copy()))
                        let def_ = self.new_def(
                            module, case_name, t.name_range, Vis.Private, DefKind.Fn(info)
                        )
                        self.prog.tests.push(def_)
                        self.test_tags(def_, item.attrs, module)
                        if not t.fixtures.is_empty():
                            _ = self.prog.test_fixtures.insert(def_, t.fixtures.copy())
                        self.pending.push(
                            Pending.Test(def_=def_, module=module, ast=case_def.copy())
                        )
                case ItemKind.Suite(s):
                    let prefix = prefixed(test_prefix, s.name)
                    let outer = self.suite_tags.copy()
                    for a in item.attrs:
                        if a.name == "tag":
                            self.suite_tags.push(a.copy())
                    self.declare_items(module, s.items, prefix)
                    self.suite_tags = outer
                # A benchmark is checked like a test; `sisu bench` runs it.
                case ItemKind.Bench(t):
                    let name = prefixed(test_prefix, t.name)
                    let info = self.placeholder_fn(FnKind.Test(name.copy()))
                    let def_ = self.new_def(
                        module, name, t.name_range, Vis.Private, DefKind.Fn(info)
                    )
                    self.prog.benches.push(def_)
                    self.pending.push(Pending.Test(def_=def_, module=module, ast=t.copy()))
                case ItemKind.Const(c):
                    # The value is known from here on, for a type's
                    # constant argument that names it (`typeck.consts`).
                    let ts = self.value_terms(module, c.value)
                    let info = ConstInfo(ty=Ty.error(), value=c.value, value_module=None, terms=ts)
                    let def_ = self.new_def(
                        module, c.name.text, c.name.range, item.vis, DefKind.Const(info)
                    )
                    self.bind(module, c.name.text, def_)
                    self.deprecate(module, def_, item.attrs)
                    self.comptime_budget(module, def_, item.attrs)
                    self.pending.push(Pending.Const(def_=def_, module=module, ast=c.copy()))
                case ItemKind.TypeAlias(a):
                    if a.refinement:
                        # The predicate as written, which a failed conversion
                        # shows.
                        var text = String.new()
                        if let Some(p) = a.predicate:
                            let r = self.ast(module).expr(p).range
                            text = self.text_in(module, r).trim().to_string()
                        let info = RefinementInfo(
                            generics=[], base=Ty.error(), predicate=None, text=text
                        )
                        let def_ = self.new_def(
                            module, a.name.text, a.name.range, item.vis, DefKind.Refinement(info)
                        )
                        self.bind(module, a.name.text, def_)
                        self.deprecate(module, def_, item.attrs)
                        _ = self.type_params.insert(def_, a.generics.copy())
                        self.pending.push(
                            Pending.Refinement(
                                def_=def_,
                                module=module,
                                ast=a.copy(),
                                node=item.node,
                                range=item.range,
                            )
                        )
                    else:
                        let def_ = self.new_def(
                            module,
                            a.name.text,
                            a.name.range,
                            item.vis,
                            DefKind.TypeAlias(Ty.error()),
                        )
                        self.bind(module, a.name.text, def_)
                        self.deprecate(module, def_, item.attrs)
                        _ = self.aliases.insert(def_, (module, a.copy()))
                # An `extern` block declares foreign functions (22, "Foreign
                # calls"), each a function of the module without a body
                # whose call is an unsafe operation.
                case ItemKind.Extern(members):
                    let library = self.extern_library(module, item.range)
                    for mid in members:
                        let member = self.sources[module.index].ast.item(mid).copy()
                        if let ItemKind.Fn(f) = member.kind:
                            let info = self.placeholder_fn(FnKind.Free)
                            let def_ = self.new_def(
                                module, f.name.text, f.name.range, member.vis, DefKind.Fn(info)
                            )
                            self.bind(module, f.name.text, def_)
                            _ = self.foreign_fns.insert(def_, library.copy())
                            self.pending.push(
                                Pending.Fn(def_=def_, module=module, ast=f.copy(), owner=None)
                            )
                    if self.lints_in(module):
                        if let Some(text) = self.safety_text(module):
                            if let Some(d) = missing_comment(text, item.range, "`extern` block"):
                                self.warn_in(module, d)
                case _:
                    pass
        for (n, attrs) in attributed:
            if let Some(d) = self.prog.modules[module.index].items.get(n):
                _ = self.attrs_of.insert(d, attrs.copy())

    ## `E0234` for a method of an impl that is `unsafe def` where the
    ## trait's is not, or the other way round.
    pure def check_unsafe_method(
        mut self,
        module: ModuleId,
        tm: DefId,
        m: DefId,
        trait_ref: TraitRef,
        self_ty: Ty,
        names: list[String],
    ):
        # The two signatures are copied only for what follows a mismatch
        # (RULES.md, R147).
        let expected_info = self.prog.fn_info(tm) else:
            return
        let expected_unsafe = expected_info.unsafe_
        let found_info = self.prog.fn_info(m) else:
            return
        let found_unsafe = found_info.unsafe_
        # The impl's method without a `Safety:` list of its own has the
        # trait's obligations, which its callers discharge.
        if expected_unsafe and found_unsafe and found_info.obligations.is_none():
            let obligations = expected_info.obligations.copy()
            var kind_now = self.prog.defs[m.index].kind().copy()
            if let DefKind.Fn(fi) = ref mut kind_now:
                fi.obligations = obligations
            self.prog.defs[m.index].set_kind(kind_now)
        if expected_unsafe == found_unsafe or not self.lints_in(module):
            return
        let expected_again = self.prog.fn_info(tm) else:
            return
        let expected = expected_again.copy()
        let found_again = self.prog.fn_info(m) else:
            return
        let found = found_again.copy()
        var args = [self_ty]
        for a in trait_ref.args:
            args.push(a)
        let name = self.prog.defs[m.index].name.copy()
        let trait_name = self.prog.display_trait_in(self.types, trait_ref, names)
        let expected_text = self.signature_text(name, expected, Some(args), [], names)
        let found_text = self.signature_text(name, found, None, [], names)
        let at = self.prog.defs[m.index].span
        var d = Diagnostic.new(Msg.ResolveMethodSignature, at.start, at.end).with("name", name)
        d = d.with("trait", trait_name).with("expected", expected_text)
        self.report_other(module, d.with("found", found_text))

    ## `E0234` for a method of an impl whose types are not the trait's, with
    ## `Self` and the trait's parameters substituted and its associated
    ## types bound (stage 0's `check_method_signature`; RULES.md, R22): a
    ## call through the trait would take the trait's types for the impl's.
    ## A method whose shape differs (its receiver, the number of its
    ## parameters, their modes, its own generic parameters) the name pass
    ## reports.
    pure def check_method_types(
        mut self,
        module: ModuleId,
        tm: DefId,
        m: DefId,
        trait_ref: TraitRef,
        self_ty: Ty,
        env: list[Predicate],
    ):
        let expected_info = self.prog.fn_info(tm) else:
            return
        let expected = expected_info.copy()
        let found_info = self.prog.fn_info(m) else:
            return
        let found = found_info.copy()
        if expected.header_broken or found.header_broken:
            return
        let own_t = len(expected.generics) - expected.impl_generics
        let own_f = len(found.generics) - found.impl_generics
        if own_t != own_f or expected.self_mode != found.self_mode:
            return
        if len(expected.params) != len(found.params):
            return
        var args = [self_ty]
        for a in trait_ref.args:
            args.push(a)
        for k in range(own_t):
            args.push(self.types.param(found.impl_generics + k))
        var same = True
        for i in range(len(expected.params)):
            if expected.params[i].mode != found.params[i].mode:
                return
            let s = self.types.subst(expected.params[i].ty, args)
            let a = self.prog.normalize(mut self.types, s, env)
            let b = self.prog.normalize(mut self.types, found.params[i].ty, env)
            if a != b:
                same = False
        let sr = self.types.subst(expected.ret, args)
        let ra = self.prog.normalize(mut self.types, sr, env)
        let rb = self.prog.normalize(mut self.types, found.ret, env)
        if ra != rb:
            same = False
        if same:
            return
        var names: list[String] = []
        for g in found.generics:
            names.push(g.name.copy())
        let name = self.prog.defs[m.index].name.copy()
        let trait_name = self.prog.display_trait_in(self.types, trait_ref, [])
        let expected_text = self.signature_text(name, expected, Some(args), env, names)
        let found_text = self.signature_text(name, found, None, env, names)
        let at = self.prog.defs[m.index].span
        var d = Diagnostic.new(Msg.ResolveMethodSignature, at.start, at.end).with("name", name)
        d = d.with("trait", trait_name).with("expected", expected_text)
        self.report_other(module, d.with("found", found_text))

    ## Whether `d` is the function that gives an associated constant
    ## (RULES.md, R37).
    pure def is_assoc_const(self, d: DefId) -> bool:
        if let Some(f) = self.prog.fn_info(d):
            return f.assoc_const
        return False

    ## An impl's associated constant has the type the trait declares it
    ## with (RULES.md, R37): `E0272` otherwise.
    pure def check_const_type(
        mut self,
        module: ModuleId,
        tm: DefId,
        m: DefId,
        trait_ref: TraitRef,
        self_ty: Ty,
        env: list[Predicate],
        names: list[String],
    ):
        let expected = self.prog.fn_info(tm) else:
            return
        let found = self.prog.fn_info(m) else:
            return
        let eret = expected.ret
        let fret = found.ret
        if eret == Ty.error() or fret == Ty.error():
            return
        var args = [self_ty]
        for a in trait_ref.args:
            args.push(a)
        let declared = self.types.subst(eret, args)
        let a = self.prog.normalize(mut self.types, declared, env)
        let b = self.prog.normalize(mut self.types, fret, env)
        if a == b:
            return
        let name = self.prog.defs[m.index].name.copy()
        let at = found.ret_span ?? self.prog.defs[m.index].span
        var d = Diagnostic.new(Msg.ResolveConstantType, at.start, at.end).with("name", name)
        d = d.with("trait", self.prog.display_trait_in(self.types, trait_ref, []))
        d = d.with("expected", self.prog.display_in(self.types, a, names))
        d = d.with("found", self.prog.display_in(self.types, b, names))
        self.report_other(module, d)

    ## `impl Copy for T` written by hand (RULES.md, R22): `Copy` is opt-in
    ## through `@derive(Copy)` (03, "Auto traits"), which checks that every
    ## field is `Copy`; an impl the program writes would leave the type
    ## moved. `E0270`, with the fix that derives it instead, on the type's
    ## line when the module declares it.
    pure def check_copy_by_hand(
        mut self,
        module: ModuleId,
        trait_ref: TraitRef,
        self_ty: Ty,
        header: TextRange,
        item: TextRange,
    ):
        if Some(trait_ref.def_) != self.prog.wk.copy or not self.is_root(module):
            return
        let mname = self.prog.modules[module.index].name.copy()
        if mname.starts_with("<"):
            return
        let shown = self.prog.display(self.types, self_ty)
        var d = Diagnostic.new(Msg.ResolveCopyByHand, header.start, header.end).with("ty", shown)
        if let TyData.Adt(def_, _) = self.types.data(self_ty):
            if self.prog.defs[def_.index].module == module:
                if let Some(text) = self.module_texts.get(module):
                    let at = self.prog.defs[def_.index].span.start
                    if let Some(add) = derive_edit(text, at, ["Copy".to_string()]):
                        var end = item.end
                        while end < text.byte_len() and text.byte_at(end) == 10:
                            end += 1
                        let remove = Edit(start=item.start, end=end, text=String.new())
                        d = d.fix_edits(Msg.ResolveDeriveCopy, [add, remove])
        self.report_other(module, d)

    ## The rules of `unsafe impl` (22, D-080): an `unsafe trait`, `Send` and
    ## `Sync` are implemented with `unsafe impl` (`E0984`), and no other
    ## trait is (`E0985`); `Copy` and `Escapable` are never asserted
    ## (`E0986`). An `unsafe impl` has its `# safety:` comment (`W0007`),
    ## and one of `Send` or `Sync` bounds each parameter by the trait it
    ## asserts (`W0013`, Rudra's check).
    pure def check_unsafe_impl(
        mut self,
        module: ModuleId,
        imp: ImplDef,
        span: TextRange,
        trait_ref: TraitRef,
        predicates: list[Predicate],
        names: list[String],
    ):
        let t = trait_ref.def_
        let auto = Some(t) == self.prog.wk.send or Some(t) == self.prog.wk.sync
        var unsafe_trait = auto
        if let Some(info) = self.prog.trait_info(t):
            unsafe_trait = unsafe_trait or info.unsafe_
        let never = (
            Some(t) == self.prog.wk.copy
                or Some(t) == self.prog.wk.escapable
                or Some(t) == self.prog.wk.sized
        )
        let trait_name = self.prog.display_trait_in(self.types, trait_ref, names)
        if imp.is_unsafe and never:
            let at = self.impl_keyword(module, span, "unsafe")
            var d = Diagnostic.new(
                Msg.UnsafeNeverAsserted, at.start, self.impl_header_end(module, span)
            )
            self.report_other(module, d.with("trait", trait_name))
            return
        if imp.is_unsafe and not unsafe_trait:
            let what = "`{trait_name}` is not an `unsafe trait`"
            self.unsafe_promises_nothing(module, span, what)
            return
        if not imp.is_unsafe and unsafe_trait:
            if self.prog.modules[module.index].name.starts_with("<"):
                return
            let at = self.impl_keyword(module, span, "impl")
            var d = Diagnostic.new(
                Msg.UnsafeImplNeeded, at.start, self.impl_header_end(module, span)
            )
            d = d.with("trait", trait_name)
            self.report_other(
                module, d.fix_at(Msg.UnsafeWriteUnsafeImpl, at.start, at.start, "unsafe ")
            )
            return
        if not imp.is_unsafe or not self.lints_in(module):
            return
        if let Some(text) = self.safety_text(module):
            if let Some(d) = missing_comment(text, span, "`unsafe impl`"):
                self.warn_in(module, d)
        if not auto:
            return
        let auto_name = self.prog.defs[t.index].name.copy()
        for i in range(len(imp.generics)):
            let g = ref imp.generics[i]
            if g.is_const:
                continue
            var bounded = False
            for p in predicates:
                if p.ty == self.types.param(i) and p.bound.def_ == t:
                    bounded = True
            if bounded:
                continue
            let at = g.name.range
            var insert_at = at.end
            var text = ": {auto_name}"
            if let Some(last) = g.bounds.last():
                insert_at = self.ast(module).type_expr(last).range.end
                text = " + {auto_name}"
            var d = Diagnostic.new(Msg.UnsafeAutoTraitBound, at.start, at.end)
            d = d.with("trait", auto_name).with("param", g.name.text)
            let param = MsgParam(name="param".to_string(), value=g.name.text.copy())
            let bound = MsgParam(name="bound".to_string(), value=auto_name.copy())
            let edit = Edit(start=insert_at, end=insert_at, text=text)
            self.warn_in(module, d.fix_params(Msg.TypeAddBound, [param, bound], [edit]))

    ## `E0985` for the `unsafe impl` at `range`: `what` says why it promises
    ## nothing.
    pure def unsafe_promises_nothing(mut self, module: ModuleId, range: TextRange, what: str):
        let at = self.impl_keyword(module, range, "unsafe")
        var end = at.end
        let owned = self.text_of_module(module)
        let text: str = owned
        while end < text.byte_len() and text.byte_at(end) == 32:
            end += 1
        var d = Diagnostic.new(
            Msg.UnsafeImplPromisesNothing, at.start, self.impl_header_end(module, range)
        )
        d = d.with("what", what)
        self.report_other(module, d.fix_at(Msg.UnsafeRemoveUnsafe, at.start, end, ""))

    ## Where the header line of the impl at `range` ends, before its `:`.
    pure def impl_header_end(self, module: ModuleId, range: TextRange) -> int:
        let at = self.impl_keyword(module, range, "impl")
        let owned = self.text_of_module(module)
        let text: str = owned
        var e = at.start
        while e < text.byte_len() and text.byte_at(e) != 10:
            e += 1
        while e > at.start and is_header_tail(text.byte_at(e - 1)):
            e -= 1
        return e

    ## The first `word` (`unsafe`, `impl`) of an impl's header at `range`,
    ## past its attributes and comments.
    pure def impl_keyword(self, module: ModuleId, range: TextRange, word: str) -> TextRange:
        let owned = self.text_of_module(module)
        let text: str = owned
        var i = range.start
        let n = min(range.end, text.byte_len())
        while i < n:
            var e = i
            while e < n and text.byte_at(e) != 10:
                e += 1
            let line = text.byte_slice(i, e)
            let trimmed = line.trim_start()
            if not trimmed.starts_with("@")
                    and not trimmed.starts_with("#")
                    and not trimmed.is_empty():
                if let Some(k) = line.find(word):
                    return TextRange(start=i + k, end=i + k + word.byte_len())
                return TextRange(start=i, end=i)
            i = e + 1
        return TextRange(start=range.start, end=range.start)

    ## The library an `extern` block's calls name in SIR: its ABI string,
    ## in lowercase (`extern "C":` is `c`), `c` when it has none.
    pure def extern_library(self, module: ModuleId, range: TextRange) -> String:
        let header = self.text_in(module, range)
        let all: str = header
        let line = all.byte_slice(0, all.find("\n") ?? all.byte_len())
        if let Some(open) = line.find("\""):
            let rest = line.byte_slice(open + 1, line.byte_len())
            if let Some(close) = rest.find("\""):
                let abi = rest.byte_slice(0, close).to_lowercase()
                if not abi.is_empty():
                    return abi
        return "c".to_string()

    pure def declare_enum(
        mut self, module: ModuleId, e: EnumDef, vis: Vis, attrs: list[Attr], error_set: bool
    ):
        let info = EnumInfo(
            generics=[],
            variants=[],
            open=e.open,
            copy=False,
            must_consume=False,
            derives=[],
            drop=None,
        )
        let kind = if error_set: DefKind.ErrorSet(info) else: DefKind.Enum(info)
        let def_ = self.new_def(module, e.name.text, e.name.range, vis, kind)
        self.bind(module, e.name.text, def_)
        self.deprecate(module, def_, attrs)
        # Its constants, as a struct's (RULES.md, R43).
        for c in e.consts:
            self.declare_assoc_const(module, TyKey.Adt(def_), e.name.text, c)
        for k in range(len(e.variants)):
            if has_attr(e.variants[k].attrs, "deprecated"):
                let why = self.builtin_attr(module, e.variants[k].attrs, "deprecated")
                _ = self.prog.deprecated_variants.insert((def_, k), why ?? String.new())
        _ = self.type_params.insert(def_, e.generics.copy())
        self.declare_methods(module, def_, e.methods)
        self.pending.push(Pending.Enum(def_=def_, module=module, ast=e.copy(), attrs=attrs.copy()))

    ## The type a method belongs to, whose declaration it is part of.
    pure def owner_def(self, owner: Owner?) -> DefId?:
        var st: Ty? = None
        match owner:
            case Some(Owner.Type(t)):
                return Some(t)
            case Some(Owner.Refinement(r)):
                return Some(r)
            case Some(Owner.Trait(t)):
                return Some(t)
            case Some(Owner.Inherent(_, _, _, t)):
                st = Some(t)
            case Some(Owner.Impl(i)):
                if let Some(info) = self.prog.impl_info(i):
                    st = Some(info.self_ty)
            case _:
                pass
        if let Some(t) = st:
            if let TyData.Adt(d, _) = self.types.data(t):
                return Some(d)
        return None

    ## Records a type or constant marked `@deprecated("...")` (13; RULES.md,
    ## R40) with the attribute's text.
    pure def deprecate(mut self, module: ModuleId, def_: DefId, attrs: list[Attr]):
        if has_attr(attrs, "deprecated"):
            let why = self.builtin_attr(module, attrs, "deprecated") ?? String.new()
            _ = self.prog.deprecated.insert(def_, why)
        if has_attr(attrs, "preview"):
            let why = self.builtin_attr(module, attrs, "preview") ?? String.new()
            _ = self.prog.previews.insert(def_, why)
        # `@repr(c)`, a layout C shares (RULES.md, R118).
        for a in attrs:
            if a.name == "repr":
                if let Some(arg) = a.args.first():
                    if let ExprKind.Name(n) = self.ast(module).expr(arg.value).kind:
                        if n == "c":
                            _ = self.prog.c_layout.add(def_)

    ## `W0023` (or `W0025`) for a use at `at` in `module` of the deprecated
    ## type `d` (RULES.md, R40), but in the type's own declaration (its
    ## fields, its methods, its impls), which `decl_owner` names.
    pure def deprecated_type_use(mut self, d: DefId, module: ModuleId, at: TextRange):
        if self.decl_owner == Some(d) or self.quiet_deprecation or not self.lints_in(module):
            return
        let name = self.prog.defs[d.index].name.copy()
        # A preview type (RULES.md, R115).
        if let Some(p) = self.prog.previews.get(d):
            let preview = preview_warning(name, p, at)
            self.warn_in(module, preview)
        let why = self.prog.deprecated.get(d) else:
            return
        if why.is_empty():
            let diag = Diagnostic.new(Msg.TypeDeprecatedPlain, at.start, at.end)
            self.warn_in(module, diag.with("name", name))
        else:
            let diag = Diagnostic.new(Msg.TypeDeprecated, at.start, at.end)
            self.warn_in(module, diag.with("name", name).with("reason", why))

    ## `E0225` for each attribute of `attrs` that only the standard library
    ## may write (stage 0's `check_attrs`), in a module of the program:
    ## `@intrinsic` above all, since a function with an intrinsic body
    ## reaches the machine, which a program does only through `unsafe` and
    ## `std.mem`'s `unsafe def`s (22).
    pure def check_std_only_attrs(mut self, module: ModuleId, attrs: list[Attr]):
        if self.is_std(module) or attrs.is_empty():
            return
        let owned = self.text_of_module(module)
        let text: str = owned
        for a in attrs:
            # One the compiler wrote (the `@internal` of an invariant's
            # check) is not in the text.
            if a.range.start >= text.byte_len() or text.byte_at(a.range.start) != 64:
                continue
            let name: str = a.name
            match name:
                case "builtin" | "intrinsic" | "structural" | "keeps" | "sealed" | "marker" | "internal":
                    let d = Diagnostic.new(Msg.ResolveStdOnlyAttribute, a.range.start, a.range.end)
                    self.report_other(module, d.with("name", a.name))
                case _:
                    pass

    pure def declare_methods(mut self, module: ModuleId, owner: DefId, methods: list[FnDef]):
        for m in methods:
            let vis = if self.is_std(module): Vis.Pub else: m.vis
            let info = self.placeholder_fn(FnKind.Method)
            let def_ = self.new_def(module, m.name.text, m.name.range, vis, DefKind.Fn(info))
            self.pending.push(
                Pending.Fn(def_=def_, module=module, ast=m.copy(), owner=Some(Owner.Type(owner)))
            )

    # ---------------------------------------------------------------- pass 2

    pub pure def resolve_pending(mut self):
        # The generic parameters of every type and trait first.
        self.resolve_headers()
        # Aliases next, so that later declarations can use them.
        var alias_ids: list[int] = []
        for d in self.aliases.keys():
            if not self.headers_done.contains(d):
                alias_ids.push(d.index)
        alias_ids.sort()
        for i in alias_ids:
            _ = self.headers_done.add(DefId(index=i))
        for i in alias_ids:
            _ = self.resolve_alias(DefId(index=i))
        # Types, then traits, then impls, then functions.
        var pending: list[Pending] = []
        while let Some(p) = self.pending.pop():
            pending.push(p)
        pending.reverse()
        for p in pending:
            if let Pending.Trait(def_, module, t, attrs) = p:
                self.resolve_trait_header(def_, module, t, attrs)
        var types: list[Pending] = []
        var traits: list[Pending] = []
        var impls: list[Pending] = []
        var rest: list[Pending] = []
        for p in own pending:
            match p:
                case Pending.Struct(_, _, _, _) | Pending.Enum(_, _, _, _):
                    types.push(p)
                case Pending.Refinement(_, _, _, _, _):
                    types.push(p)
                case Pending.Trait(_, _, _, _):
                    traits.push(p)
                case Pending.Impl(_, _, _):
                    impls.push(p)
                case _:
                    rest.push(p)
        let declaring = self.phase
        self.phase = max(declaring, 1)
        for p in own types:
            self.resolve_one(p)
        self.phase = max(declaring, 2)
        for p in own traits:
            self.resolve_one(p)
        self.phase = max(declaring, 3)
        for p in own impls:
            self.resolve_one(p)
        self.phase = max(declaring, 4)
        var queue = rest
        # Traits and impls push the functions they declare, which follow in
        # the order they were pushed.
        var pushed: list[Pending] = []
        while let Some(p) = self.pending.pop():
            pushed.push(p)
        pushed.reverse()
        for p in own pushed:
            queue.push(p)
        while not queue.is_empty():
            for p in own queue:
                self.resolve_one(p)
            queue = []
            var more: list[Pending] = []
            while let Some(p) = self.pending.pop():
                more.push(p)
            more.reverse()
            queue = more
        self.unfold_values()
        self.phase = declaring

    ## Unfolds the values that reflect, now that every type and trait they
    ## may name is resolved (decision 251): each is checked from the text
    ## its unfolding made, in a module of its own (`<NAME>/MODULE.sisu`).
    pure def unfold_values(mut self):
        let later = self.unfold_later.copy()
        self.unfold_later = []
        for l in later:
            match l:
                case Later.Const(def_, module, value):
                    let name = self.prog.defs[def_.index].name.copy()
                    let site = self.ast(module).expr(value).range
                    let unfolded = self.unfold_value(module, name, value, site)
                    var kind_now = self.prog.defs[def_.index].kind().copy()
                    if let DefKind.Const(c) = ref mut kind_now:
                        match unfolded:
                            case Some((v, m)):
                                c.value = Some(v)
                                c.value_module = Some(m)
                                c.terms = self.value_terms(m, Some(v))
                            case None:
                                c.value = None
                    self.prog.defs[def_.index].set_kind(kind_now)
                case Later.Field(def_, index, module, label, value):
                    let site = self.ast(module).expr(value).range
                    let unfolded = self.unfold_value(module, label, value, site)
                    var kind_now = self.prog.defs[def_.index].kind().copy()
                    if let DefKind.Struct(st) = ref mut kind_now:
                        if index < len(st.fields):
                            match unfolded:
                                case Some((v, m)):
                                    st.fields[index].default = Some(v)
                                    st.fields[index].default_module = Some(m)
                                case None:
                                    st.fields[index].default = None
                    self.prog.defs[def_.index].set_kind(kind_now)
                case Later.Param(def_, index, module, label, value):
                    let site = self.ast(module).expr(value).range
                    let unfolded = self.unfold_value(module, label, value, site)
                    var kind_now = self.prog.defs[def_.index].kind().copy()
                    if let DefKind.Fn(info) = ref mut kind_now:
                        if index < len(info.params):
                            match unfolded:
                                case Some((v, m)):
                                    info.params[index].default = Some(v)
                                    info.params[index].default_module = Some(m)
                                case None:
                                    info.params[index].default = None
                    self.prog.defs[def_.index].set_kind(kind_now)

    pure def resolve_alias(mut self, d: DefId) -> Ty:
        if let DefKind.TypeAlias(t) = self.prog.defs[d.index].kind():
            if t != Ty.error():
                return t
        let entry = self.aliases.get(d) else:
            return Ty.error()
        let module = entry.0
        let alias = entry.1.copy()
        if self.resolving_alias.contains(d):
            let at = alias.name.range
            let diag = Diagnostic.new(Msg.ResolveAliasCycle, at.start, at.end)
            self.report_other(module, diag.with("name", alias.name.text))
            return Ty.error()
        self.resolving_alias.push(d)
        var names: list[String] = []
        for g in alias.generics:
            names.push(g.name.text.copy())
        let ctx = TyCtx.plain(module, names, self.is_std(module))
        var ty = Ty.error()
        if let Some(t) = alias.ty:
            if let TypeKind.Union(_) = self.ast(module).type_expr(t).kind:
                ty = self.resolve_error_set(t, ctx)
            else:
                ty = self.resolve_ty(t, ctx)
        _ = self.resolving_alias.pop()
        self.prog.defs[d.index].set_kind(DefKind.TypeAlias(ty))
        return ty

    ## Whether an attribute list has `@derive(what)`.
    pure def has_derive(self, module: ModuleId, attrs: list[Attr], what: str) -> bool:
        return self.derives(module, attrs).contains(what.to_string())

    ## The names `@derive(...)` and `@delegate(...)` list.
    pure def derives(self, module: ModuleId, attrs: list[Attr]) -> list[String]:
        var out: list[String] = []
        for a in attrs:
            if a.name != "derive" and a.name != "delegate":
                continue
            for arg in a.args:
                if let ExprKind.Name(n) = self.ast(module).expr(arg.value).kind:
                    out.push(n.copy())
        return out

    ## The text of `@name("...")`, its first argument.
    ## The form of what the `@fix_inline` function `f` returns (RULES.md,
    ## R177): a free function whose body is one `return` of an expression
    ## and whose parameters take no `mut` or `own`; `None` for any other.
    pure def inline_form(self, module: ModuleId, f: FnDef, method: bool) -> InlineForm?:
        if method:
            return None
        let body = f.body.copy() else:
            return None
        if len(body.stmts) != 1:
            return None
        let ast = self.ast(module)
        let StmtKind.Return(Some(e)) = ast.stmt(body.stmts[0]).kind else:
            return None
        var names: list[String] = []
        for p in f.params:
            let ParamKind.Named(name, _, _) = p.kind.copy() else:
                return None
            if p.mode != Mode.Borrow:
                return None
            names.push(name.text.copy())
        let text = self.text_in(module, ast.expr(e).range)
        if text.is_empty():
            return None
        return form_of(text, names)

    pure def builtin_attr(self, module: ModuleId, attrs: list[Attr], name: str) -> String?:
        for a in attrs:
            if a.name == name:
                if let Some(arg) = a.args.first():
                    if let ExprKind.Str(parts) = self.ast(module).expr(arg.value).kind:
                        return Some(build.plain_text(parts))
                return None
        return None

    pure def resolve_one(mut self, own p: Pending):
        match p:
            # A type's own uses of itself are not deprecated uses (RULES.md,
            # R40).
            case Pending.Struct(def_, module, s, attrs):
                self.decl_owner = Some(def_)
                self.resolve_struct(def_, module, s, attrs)
                self.decl_owner = None
            case Pending.Enum(def_, module, e, attrs):
                self.decl_owner = Some(def_)
                self.resolve_enum(def_, module, e, attrs)
                self.decl_owner = None
            case Pending.Trait(def_, module, t, _):
                # A trait's own uses of itself, as a type's (RULES.md, R51).
                self.decl_owner = Some(def_)
                self.resolve_trait(def_, module, t)
                self.decl_owner = None
            case Pending.Fn(def_, module, f, owner):
                self.decl_owner = self.owner_def(owner)
                self.resolve_fn(def_, module, f, owner)
                self.decl_owner = None
            case Pending.Test(def_, module, t):
                self.resolve_test(def_, module, t)
            case Pending.Const(def_, module, c):
                var ty = Ty.error()
                match c.ty:
                    case Some(t):
                        ty = self.resolve_ty(t, TyCtx.plain(module, [], False))
                    case None:
                        let at = c.name.range
                        let d = Diagnostic.new(Msg.ResolveConstTypeRequired, at.start, at.end)
                        self.report_other(module, d.with("name", c.name.text))
                # A value that reflects is unfolded where it is written, once
                # everything is resolved, and checked as the text that makes
                # (decision 251).
                if let Some(v) = c.value:
                    if value_unfolds(self.ast(module), v):
                        self.unfold_later.push(Later.Const(def_=def_, module=module, value=v))
                let ts = self.value_terms(module, c.value)
                let info = ConstInfo(ty=ty, value=c.value, value_module=None, terms=ts)
                self.prog.defs[def_.index].set_kind(DefKind.Const(info))
            case Pending.Impl(module, imp, rng):
                self.resolve_impl(module, imp, rng)
            case Pending.Refinement(def_, module, a, node, rng):
                var names: list[String] = []
                for g in a.generics:
                    names.push(g.name.text.copy())
                var ctx = TyCtx.plain(module, names, False)
                ctx.predicates = self.preds_of(def_)
                var base = Ty.error()
                if let Some(t) = a.ty:
                    base = self.resolve_ty(t, ctx)
                # A refinement of a refinement keeps it as its base; a chain
                # that comes back is a cycle (`resolve.alias-cycle`).
                var at = base
                var cycle = False
                for _ in range(64):
                    let TyData.Adt(d, args) = self.types.data(at).copy() else:
                        break
                    if d == def_:
                        cycle = True
                        break
                    let b = self.prog.refinement_base(mut self.types, d, args) else:
                        break
                    at = b
                if cycle:
                    let d = Diagnostic.new(
                        Msg.ResolveAliasCycle, a.name.range.start, a.name.range.end
                    )
                    self.report_other(module, d.with("name", a.name.text))
                    base = Ty.error()
                var kind_now = self.prog.defs[def_.index].kind().copy()
                if let DefKind.Refinement(r) = ref mut kind_now:
                    r.base = base
                self.prog.defs[def_.index].set_kind(kind_now)
                self.declare_predicate(module, def_, node, a, rng)

    pure def resolve_struct(
        mut self, def_: DefId, module: ModuleId, s: StructDef, attrs: list[Attr]
    ):
        let (names, predicates) = self.type_param_scope(def_)
        let self_ty = self.self_type(def_, len(names))
        var fields: list[FieldInfo] = []
        for f in s.fields:
            var dup = False
            for x in fields:
                if x.name == f.name.text:
                    dup = True
            # A field declared twice is stage 0's `E0205`, which stage 1
            # left out.
            if dup:
                let at = f.name.range
                var d = Diagnostic.new(Msg.ResolveDuplicateField, at.start, at.end)
                self.report_other(module, d.with("name", f.name.text).with("owner", s.name.text))
                continue
            var ctx = TyCtx.plain(module, names, True)
            ctx.self_ty = Some(self_ty)
            ctx.predicates = predicates.copy()
            let ty = self.resolve_ty(f.ty, ctx)
            let at = self.ast(module).type_expr(f.ty).range
            self.check_sized(module, ty, at)
            # Views are infectious upwards (04): only a `view struct` may
            # hold a reference or a view (`borrow.view-field-in-plain-struct`).
            if not self.is_std(module)
                    and not s.is_view
                    and self.prog.is_view_type(mut self.types, ty):
                let whole = f.name.range.cover(at)
                let fty = self.prog.display(self.types, ty)
                let named = s.name.range
                var d = Diagnostic.new(Msg.BorrowViewFieldInPlainStruct, whole.start, whole.end)
                d = d.with("ty", s.name.text).with("field", f.name.text).with("fty", fty)
                d = d.label_with(
                    Msg.BorrowTypeDeclaredHere, named.start, named.end, "ty", s.name.text
                )
                # A field that holds text owns it as a `String` (R16): the
                # fix a struct of owned data wants.
                if let Some(owned) = self.owned_text_type(module, at):
                    d = d.fix_at(Msg.BorrowOwnString, at.start, at.end, owned)
                # The fix writes `view ` before the `struct` keyword.
                var edits: list[Edit] = []
                if let Some(k) = self.keyword_before(module, named.start, "struct"):
                    edits.push(Edit(start=k, end=k, text="view ".to_string()))
                let param = MsgParam(name="ty".to_string(), value=s.name.text.copy())
                self.report_other(module, d.fix_params(Msg.BorrowDeclareView, [param], edits))
            if let Some(v) = f.default:
                if value_unfolds(self.ast(module), v):
                    let label = "{s.name.text}.{f.name.text}"
                    let index = len(fields)
                    self.unfold_later.push(
                        Later.Field(def_=def_, index=index, module=module, label=label, value=v)
                    )
            # A deprecated field warns where it is used (RULES.md, R51).
            if has_attr(f.attrs, "deprecated"):
                let why = self.builtin_attr(module, f.attrs, "deprecated") ?? String.new()
                _ = self.prog.deprecated_fields.insert((def_, len(fields)), why)
            # Its `##` comment, which reflection gives (RULES.md, R117).
            let doc = self.doc_in(module, f.range.start)
            fields.push(
                FieldInfo(
                    name=f.name.text.copy(),
                    ty=ty,
                    default=f.default,
                    default_module=None,
                    span=f.range,
                    vis=f.vis,
                    doc=doc,
                    attrs=self.attr_data(module, f.attrs),
                )
            )
        if not s.unsupported.is_empty():
            self.beyond_in(module, "a contract in a struct")
        let builtin = self.builtin_attr(module, attrs, "builtin")
        let copy = self.has_derive(module, attrs, "Copy")
        let must_consume = has_attr(attrs, "must_consume")
        let derives = self.derives(module, attrs)
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Struct(info) = ref mut kind_now:
            info.fields = fields
            info.builtin = builtin
            info.copy = copy
            info.must_consume = must_consume
            info.derives = derives
        self.prog.defs[def_.index].set_kind(kind_now)

    pure def resolve_enum(mut self, def_: DefId, module: ModuleId, e: EnumDef, attrs: list[Attr]):
        let (names, predicates) = self.type_param_scope(def_)
        let self_ty = self.self_type(def_, len(names))
        let std = self.is_std(module)
        var variants: list[VariantInfo] = []
        for v in e.variants:
            var dup = False
            for x in variants:
                if x.name == v.name.text:
                    dup = True
            # And a variant declared twice its `E0206`.
            if dup:
                let at = v.name.range
                var d = Diagnostic.new(Msg.ResolveDuplicateVariant, at.start, at.end)
                self.report_other(module, d.with("name", v.name.text).with("owner", e.name.text))
                continue
            var ctx = TyCtx.plain(module, names, std)
            ctx.self_ty = Some(self_ty)
            ctx.predicates = predicates.copy()
            var fields: list[(String?, Ty)] = []
            var docs: list[String] = []
            for f in v.fields:
                docs.push(self.variant_field_doc(module, f.range.start))
                let ty = self.resolve_ty(f.ty, ctx)
                let at = self.ast(module).type_expr(f.ty).range
                self.check_sized(module, ty, at)
                # An enum has no `view` form (`borrow.view-in-enum`).
                if not std and self.prog.is_view_type(mut self.types, ty):
                    let fty = self.prog.display(self.types, ty)
                    let named = e.name.range
                    var d = Diagnostic.new(Msg.BorrowViewInEnum, at.start, at.end)
                    d = d.with("ty", e.name.text).with("fty", fty)
                    d = d.label_with(
                        Msg.BorrowTypeDeclaredHere, named.start, named.end, "ty", e.name.text
                    )
                    self.report_other(module, d.note(Msg.BorrowOwnedField))
                var fname: String? = None
                if let Some(n) = f.name:
                    fname = Some(n.text.copy())
                fields.push((fname, ty))
            variants.push(
                VariantInfo(
                    name=v.name.text.copy(),
                    fields=fields,
                    span=v.range,
                    docs=docs,
                    attrs=self.attr_data(module, v.attrs),
                )
            )
        let copy = self.has_derive(module, attrs, "Copy")
        let must_consume = has_attr(attrs, "must_consume")
        let derives = self.derives(module, attrs)
        var kind_now = self.prog.defs[def_.index].kind().copy()
        match ref mut kind_now:
            case DefKind.Enum(info):
                info.variants = variants
                info.copy = copy
                info.must_consume = must_consume
                info.derives = derives
            case DefKind.ErrorSet(info):
                info.variants = variants
                info.copy = copy
                info.must_consume = must_consume
                info.derives = derives
            case _:
                pass
        self.prog.defs[def_.index].set_kind(kind_now)

    pure def resolve_test(mut self, def_: DefId, module: ModuleId, t: TestDef):
        let name = self.prog.defs[def_.index].name.copy()
        var info = self.placeholder_fn(FnKind.Test(name.copy()))
        # A module's fixture the runner gives is a `ref T` (RULES.md, R219).
        var shared = False
        for x in t.fixtures:
            shared = shared or x.module_scope
        for p in t.params:
            if let ParamKind.Named(n, ty, _) = p.kind:
                let resolved = self.resolve_ty(ty, TyCtx.plain(module, [], shared))
                info.params.push(
                    ParamInfo(
                        name=n.text.copy(),
                        mode=p.mode,
                        ty=resolved,
                        default=None,
                        default_module=None,
                        span=p.range,
                    )
                )
        info.body = t.body.copy()
        # A test whose body runs code at compile time by unfolding is a
        # template, made once as a function without type parameters is
        # (decision 251), and so is each case of a parametrised one.
        let f = test_fn(name, t)
        if unfolds(self.ast(module), f, []) and not self.instance_modules.contains(module):
            info.template = True
            _ = self.template_fns.insert(def_, f)
        self.prog.defs[def_.index].set_kind(DefKind.Fn(info))

    ## `Adt(d, [Param(0), ..., Param(n - 1)])`: a type in terms of its own
    ## parameters.
    pure def self_type(mut self, d: DefId, n: int) -> Ty:
        var args: list[Ty] = []
        for i in range(n):
            args.push(self.types.param(i))
        return self.types.adt(d, args)

    ## The names and bounds of a struct's or enum's generic parameters.
    pure def type_param_scope(self, d: DefId) -> (list[String], list[Predicate]):
        var names: list[String] = []
        for g in self.prog.type_generics(d):
            names.push(g.name.copy())
        return (names, self.preds_of(d))

    pure def resolve_fn(mut self, def_: DefId, module: ModuleId, f: FnDef, owner: Owner?):
        # The generics, bounds and `Self` the owner brings.
        var outer: list[Generic] = []
        var outer_names: list[String] = []
        var predicates: list[Predicate] = []
        var self_ty: Ty? = None
        var in_trait: DefId? = None
        var impl_def: DefId? = None
        match owner:
            case Some(Owner.Type(t)):
                outer = self.prog.type_generics(t)
                for g in outer:
                    outer_names.push(g.name.copy())
                predicates = self.preds_of(t)
                self_ty = Some(self.self_type(t, len(outer)))
            case Some(Owner.Inherent(generics, names, preds, st)):
                outer = generics.copy()
                outer_names = names.copy()
                predicates = preds.copy()
                self_ty = Some(st)
            case Some(Owner.Trait(t)):
                var generics = [Generic(name="Self".to_string(), default=None, is_const=False)]
                if let Some(info) = self.prog.trait_info(t):
                    for g in info.generics:
                        generics.push(g.copy())
                for g in generics:
                    outer_names.push(g.name.copy())
                var args: list[Ty] = []
                for i in range(1, len(generics)):
                    args.push(self.types.param(i))
                let tr = TraitRef(def_=t, args=args)
                predicates = [
                    Predicate(ty=self.types.param(0), bound=tr, span=self.prog.defs[t.index].span)
                ]
                outer = generics
                self_ty = Some(self.types.param(0))
                in_trait = Some(t)
            case Some(Owner.Impl(i)):
                if let Some(info) = self.prog.impl_info(i):
                    outer = info.generics.copy()
                    for g in info.generics:
                        outer_names.push(g.name.copy())
                    predicates = info.predicates.copy()
                    self_ty = Some(info.self_ty)
                    impl_def = Some(i)
            case Some(Owner.Refinement(r)):
                outer = self.prog.type_generics(r)
                for g in outer:
                    outer_names.push(g.name.copy())
                predicates = self.preds_of(r)
                if let Some(ri) = self.prog.refinement(r):
                    self_ty = Some(ri.base)
            case _:
                pass
        var names = outer_names.copy()
        for g in f.generics:
            names.push(g.name.text.copy())
        # A `comptime def`'s `T: type` parameters are generic parameters
        # whose arguments a call writes among its arguments (decision 251).
        var typed: list[(int, String)] = []
        if f.is_comptime:
            typed = type_params(Src(ast=self.ast(module), source=""), f)
        var generics = outer.copy()
        for k in range(len(f.generics)):
            let g = ref f.generics[k]
            # A function's type parameters take no defaults.
            if let Some(d) = g.default:
                var seen: list[String] = []
                for j in range(len(outer) + k):
                    seen.push(names[j].copy())
                _ = self.resolve_ty(d, TyCtx.plain(module, seen, True))
                let at = g.name.range
                self.report_other(module, Diagnostic.new(Msg.ResolveImplDefault, at.start, at.end))
            generics.push(Generic(name=g.name.text.copy(), default=None, is_const=g.is_const))
        var type_param_info: list[(int, String, int)] = []
        for (at, n) in typed:
            type_param_info.push((at, n.copy(), len(generics)))
            names.push(n.copy())
            generics.push(Generic(name=n.copy(), default=None, is_const=False))
        var impl_assoc: list[(String, Ty)] = []
        if let Some(i) = impl_def:
            if let Some(info) = self.prog.impl_info(i):
                impl_assoc = info.assoc.copy()
        # The function's own bounds, then its `where` clause.
        let own_preds = self.resolve_bounds(module, f.generics, names, len(outer), in_trait)
        for p in own_preds:
            predicates.push(p.copy())
        for w in f.where_:
            let ctx = TyCtx(
                module=module,
                generics=names.copy(),
                self_ty=self_ty,
                allow_ref=True,
                predicates=predicates.copy(),
                in_trait=in_trait,
                impl_assoc=impl_assoc.copy(),
            )
            let ty = self.resolve_ty(w.ty, ctx)
            var new: list[Predicate] = []
            for b in w.bounds:
                if let Some(tr) = self.resolve_bound(b, ty, ctx):
                    new.push(Predicate(ty=ty, bound=tr, span=self.ast(module).type_expr(b).range))
            for p in own new:
                predicates.push(p)
        var info = self.placeholder_fn(FnKind.Free)
        info.generics = generics
        info.impl_generics = len(outer)
        info.predicates = predicates.copy()
        info.trait_ = in_trait
        info.impl_ = impl_def
        info.owner = self_ty
        info.pure = f.is_pure
        info.comptime_ = f.is_comptime
        info.unsafe_ = f.is_unsafe
        # A method's attributes, which stage 0 does not check (it checks an
        # item's): `@intrinsic` on a program's method would be an unsafe
        # operation without `unsafe` (22).
        if owner.is_some():
            self.check_std_only_attrs(module, f.attrs)
        if f.is_unsafe:
            # Its obligations, from the `Safety:` list of its `##` comment.
            if let Some(text) = self.safety_text(module):
                info.obligations = safety_list(doc_above(text, f.range.start))
            # A trait impl's method takes the trait's list, which the impl's
            # methods check and copy (`check_unsafe_method`).
            var of_trait_impl = False
            if let Some(Owner.Impl(_)) = owner:
                of_trait_impl = True
            if info.obligations.is_none() and self.lints_in(module) and not of_trait_impl:
                let at = f.name.range
                var d = Diagnostic.new(Msg.UnsafeNoSafetyList, at.start, at.end)
                d = d.with("name", f.name.text).with("kind", "def").with("who", "callers")
                self.warn_in(module, d)
            if self.written_by_comptime(module):
                let at = f.name.range
                self.report_other(
                    module, Diagnostic.new(Msg.ComptimeUnsafeWritten, at.start, at.end)
                )
        info.type_params = type_param_info
        info.body = f.body.copy()
        info.intrinsic = self.builtin_attr(module, f.attrs, "intrinsic")
        # A foreign function's call lowers to the intrinsic
        # `extern.LIBRARY.NAME`, which marks it in SIR (stage 0's `sim.rs`).
        if let Some(library) = self.foreign_fns.get(def_):
            info.foreign = True
            info.intrinsic = Some("extern.{library}.{f.name.text}")
        info.structural = self.builtin_attr(module, f.attrs, "structural")
        info.internal = has_attr(f.attrs, "internal")
        # A function's or a method's attributes, as data for reflection
        # (RULES.md, R161).
        if not f.attrs.is_empty() and not self.is_std(module):
            _ = self.fn_attrs.insert(def_, self.attr_data(module, f.attrs))
        info.assoc_const = has_attr(f.attrs, ASSOC_CONST_ATTR)
        if has_attr(f.attrs, "deprecated"):
            info.deprecated = Some(self.builtin_attr(module, f.attrs, "deprecated") ?? String.new())
        # `@fix_inline` (D-067; RULES.md, R177): the function is deprecated
        # by its body, the migration, which a call's warning offers in the
        # call's place when it is one `return`.
        if has_attr(f.attrs, "fix_inline"):
            if info.deprecated.is_none():
                info.deprecated = Some(String.new())
            match self.inline_form(module, f, owner.is_some()):
                case Some(form):
                    _ = self.prog.fix_inline.insert(def_, form)
                case None:
                    for a in f.attrs:
                        if a.name == "fix_inline" and not self.is_std(module):
                            let at = a.range.start + 1
                            var d = Diagnostic.new(
                                Msg.TypeFixInlineBody, at, at + a.name.byte_len()
                            )
                            self.warn_in(module, d.with("name", f.name.text))
        # A fixture takes nothing, and is a free function (17; RULES.md,
        # R200): a test names it as a parameter and receives what it returns.
        if has_attr(f.attrs, "fixture") and (not f.params.is_empty() or owner.is_some()):
            self.prog.refused_fixtures.push(def_)
            for a in f.attrs:
                if a.name == "fixture" and not self.is_std(module):
                    let at = a.range.start + 1
                    let d = Diagnostic.new(Msg.TypeFixtureSignature, at, at + a.name.byte_len())
                    self.warn_in(module, d.with("name", f.name.text))
        elif has_attr(f.attrs, "fixture") and not self.is_std(module):
            # A module's fixture, whose value its tests share (RULES.md,
            # R219): what it returns is checked to be `Sync` once the types
            # are known.
            for a in f.attrs:
                if a.name == "fixture" and fixtures.scoped_to_module(self.ast(module), a.args):
                    let at = a.range.start + 1
                    let named = TextRange.new(at, at + a.name.byte_len())
                    self.prog.module_fixtures.push((def_, named))
        # A preview warns where it is used, as a deprecated function does
        # (RULES.md, R115).
        if has_attr(f.attrs, "preview"):
            let why = self.builtin_attr(module, f.attrs, "preview") ?? String.new()
            _ = self.prog.previews.insert(def_, why)
        # The global symbol a native build gives it (decision 683; RULES.md,
        # R120).
        if let Some(symbol) = self.builtin_attr(module, f.attrs, "export"):
            _ = self.prog.exports.insert(def_, symbol)
        # A function that allocates nothing, checked over the program's SIR
        # by the ownership checker's pass (04; RULES.md, R215).
        for a in f.attrs:
            if a.name == "no_alloc" and not self.is_std(module):
                let at = a.range.start + 1
                self.prog.no_alloc.push((def_, TextRange.new(at, at + a.name.byte_len())))
        if self.is_root(module):
            info.contracts = not f.contracts(self.ast(module)).is_empty()
            if has_attr(f.attrs, "structural") or has_attr(f.attrs, "keeps"):
                self.beyond_in(module, "an attribute of a function")
        let ctx = TyCtx(
            module=module,
            generics=names.copy(),
            self_ty=self_ty,
            allow_ref=True,
            predicates=predicates.copy(),
            in_trait=in_trait,
            impl_assoc=impl_assoc.copy(),
        )
        var seen_default = False
        for i in range(len(f.params)):
            let p = ref f.params[i]
            match p.kind:
                case ParamKind.SelfParam:
                    if owner.is_none():
                        let d = Diagnostic.new(
                            Msg.ResolveSelfOutsideMethod, p.range.start, p.range.end
                        )
                        self.report_other(module, d)
                    elif i != 0:
                        let d = Diagnostic.new(Msg.ResolveSelfNotFirst, p.range.start, p.range.end)
                        self.report_other(module, d)
                    else:
                        info.self_mode = Some(p.mode)
                case ParamKind.Named(name, ty, default):
                    # A `T: type` parameter is a type parameter (decision
                    # 251).
                    var is_type = False
                    for (_, n) in typed:
                        if n == name.text:
                            is_type = True
                    if is_type:
                        continue
                    var twice = False
                    for x in info.params:
                        if x.name == name.text:
                            twice = True
                    if twice:
                        var d = Diagnostic.new(
                            Msg.ResolveDuplicateParameter, name.range.start, name.range.end
                        )
                        self.report_other(module, d.with("name", name.text))
                    if default.is_some():
                        seen_default = True
                    elif seen_default and info.keyword_only_from.is_none():
                        let at = name.range
                        let d = Diagnostic.new(Msg.ResolveParameterDefaultOrder, at.start, at.end)
                        self.report_other(module, d)
                    self.param_type_at = Some(self.ast(module).type_expr(ty).range)
                    let resolved = self.resolve_ty(ty, ctx)
                    self.param_type_at = None
                    self.check_sized(module, resolved, p.range)
                    if let Some(v) = default:
                        if value_unfolds(self.ast(module), v):
                            let label = "{f.name.text}.{name.text}"
                            let index = len(info.params)
                            self.unfold_later.push(
                                Later.Param(
                                    def_=def_, index=index, module=module, label=label, value=v
                                )
                            )
                    info.params.push(
                        ParamInfo(
                            name=name.text.copy(),
                            mode=p.mode,
                            ty=resolved,
                            default=default,
                            default_module=None,
                            span=p.range,
                        )
                    )
                case ParamKind.KeywordOnly:
                    info.keyword_only_from = Some(len(info.params))
                case ParamKind.PositionalOnly:
                    info.positional_only_until = len(info.params)
                case ParamKind.Variadic(_, _):
                    # 02 gives `*xs: T`, 14 rules variadic functions out: an
                    # error that says so, where the checker stopped without
                    # a code and `check` passed (RULES.md, R64).
                    let what = "a variadic parameter, `*xs: T`,"
                    let phase = "the decision between 02, which gives it, and 14, which rules variadic functions out; a `Slice[T]` parameter takes a list meanwhile"
                    self.unsupported_in(module, p.range, what, phase)
                    # Its calls are not checked against the parameters
                    # before it, which would only repeat the error as
                    # `E0305` (RULES.md, R71).
                    info.header_broken = True
                case ParamKind.Error:
                    pass
        for n in f.from_:
            info.from_.push(n.text.copy())
            info.from_spans.push(n.range)
        # `@keeps(self, x)`: positions among `self` and the parameters.
        for a in f.attrs:
            if a.name != "keeps":
                continue
            for arg in a.args:
                var name = String.new()
                match self.ast(module).expr(arg.value).kind:
                    case ExprKind.Name(n):
                        name = n.copy()
                    case ExprKind.SelfValue:
                        name = "self".to_string()
                    case _:
                        continue
                let offset = if info.self_mode.is_some(): 1 else: 0
                if name == "self" and info.self_mode.is_some():
                    info.keeps.push(0)
                    continue
                for k in range(len(info.params)):
                    if info.params[k].name == name:
                        info.keeps.push(k + offset)
                        break
        # The result type; `T !` infers the error set from the body.
        match f.ret:
            case None:
                info.ret = Ty.unit()
            case Some(t):
                let written = self.ast(module).type_expr(t).copy()
                info.ret_span = Some(written.range)
                match written.kind:
                    case TypeKind.Result(ok, None):
                        var ok_ty = Ty.unit()
                        if let Some(o) = ok:
                            ok_ty = self.resolve_ty(o, ctx)
                        info.err_inferred = True
                        info.ret = Ty.error()
                        if let Some(r) = self.prog.wk.result:
                            let empty = self.types.err_set([])
                            info.ret = self.types.adt(r, [ok_ty, empty])
                    case _:
                        info.ret = self.resolve_ty(t, ctx)
                self.check_sized(module, info.ret, written.range)
        info.body_broken = f.body_broken
        if f.header_broken:
            info.header_broken = True
            info.ret = Ty.error()
            info.err_inferred = False
        # A function without a body that is no trait's (`resolve.missing-body`).
        if info.body.is_none()
                and info.intrinsic.is_none()
                and not f.name.text.is_empty()
                and in_trait.is_none():
            let d = Diagnostic.new(Msg.ResolveMissingBody, f.name.range.start, f.name.range.end)
            self.report_other(module, d.with("name", f.name.text))
        # Register methods and associated functions.
        if let Some(o) = owner:
            if self.is_drop_impl(impl_def):
                info.kind = FnKind.Drop
            elif info.self_mode.is_some():
                info.kind = FnKind.Method
            else:
                info.kind = FnKind.Assoc
            match o:
                case Owner.Type(_) | Owner.Inherent(_, _, _, _):
                    if let Some(st) = self_ty:
                        if let Some(key) = self.types.key(st):
                            let k = (key, f.name.text.copy())
                            if not self.prog.methods.contains(k.copy()):
                                _ = self.prog.methods.insert(k, def_)
                            else:
                                let at = f.name.range
                                var d = Diagnostic.new(Msg.ResolveDuplicateMethod, at.start, at.end)
                                d = d.with("owner", self.prog.display(self.types, st))
                                self.report_other(module, d.with("name", f.name.text))
                case Owner.Trait(t):
                    var kind_now = self.prog.defs[t.index].kind().copy()
                    if let DefKind.Trait(ti) = ref mut kind_now:
                        ti.methods.push(def_)
                    self.prog.defs[t.index].set_kind(kind_now)
                case Owner.Impl(i):
                    var kind_now = self.prog.defs[i.index].kind().copy()
                    if let DefKind.Impl(ii) = ref mut kind_now:
                        ii.methods.push((f.name.text.copy(), def_))
                    self.prog.defs[i.index].set_kind(kind_now)
                # A refinement's predicate is nobody's method.
                case Owner.Refinement(_):
                    pass
        if let Some(k) = self.special_kinds.get(def_):
            info.kind = k.copy()
        # A function whose body runs code at compile time by unfolding, or
        # that was promoted for calling a template with its own type
        # parameters, is a template (08, "Reflection"; decision 244): a free
        # function, a method of a type or of an impl, and a `comptime def`
        # that reflects or has `T: type` parameters, which are type
        # parameters made per type as a template's are (decision 251). It is
        # made for each list of type arguments it is called with, and once,
        # before anything calls it, when it has none; a method of a trait
        # impl is made once whatever its type parameters, which stay
        # parameters, so that a trait's call reaches it (decision 251). A
        # trait's own method that reflects is made in each impl that does not
        # write it, as that impl's template: it is a template only so that
        # nothing checks it as written.
        let unfolding = unfolds(self.ast(module), f, names)
            or self.promoted.contains(def_)
            or not info.type_params.is_empty()
        var placed = False
        match owner:
            case None | Some(Owner.Type(_)) | Some(Owner.Inherent(_, _, _, _)):
                placed = True
            case Some(Owner.Impl(_)):
                placed = True
            case Some(Owner.Trait(_)):
                placed = f.body.is_some()
            case _:
                placed = False
        if unfolding and not self.instance_modules.contains(module) and placed:
            info.template = True
            _ = self.template_fns.insert(def_, f.copy())
        # A test's instance is the test (decision 251), also once it is
        # resolved, which makes its `FnInfo` again (decision 259).
        if let Some((template, _)) = self.instance_of.get(def_):
            if let Some(t) = self.prog.fn_info(template):
                if let FnKind.Test(_) = t.kind:
                    info.kind = t.kind.copy()
        if not self.is_std(module):
            self.check_export_blocking(module, f, info)
        self.prog.defs[def_.index].set_kind(DefKind.Fn(info))

    ## `@export` and `@blocking` (22, "Foreign calls"; RULES.md, R19): an
    ## exported function's signature holds no reference, view, `Shared`,
    ## closure or capability, which foreign code that calls it could not
    ## keep alive (`E0989`, at each parameter or result that does); and
    ## `@blocking` marks a foreign function, whose call may block its
    ## thread (`E0990` elsewhere).
    pure def check_export_blocking(mut self, module: ModuleId, f: FnDef, info: FnInfo):
        for a in f.attrs:
            if a.name == "blocking" and not info.foreign:
                # The attribute as written, without the line break after it.
                let owned = self.text_of_module(module)
                let text: str = owned
                var end = min(a.range.end, text.byte_len())
                while end > a.range.start and is_blank_byte(text.byte_at(end - 1)):
                    end -= 1
                let d = Diagnostic.new(Msg.UnsafeBlockingNotForeign, a.range.start, end)
                self.report_other(module, d.with("name", f.name.text))
        if not has_attr(f.attrs, "export"):
            return
        var parts: list[(Ty, TextRange)] = []
        for p in info.params:
            parts.push((p.ty, p.span))
        if let Some(r) = info.ret_span:
            parts.push((info.ret, r))
        for (ty, at) in parts:
            if self.unexportable(ty):
                let shown = self.prog.display(self.types, ty)
                var d = Diagnostic.new(Msg.UnsafeExportSignature, at.start, at.end)
                self.report_other(module, d.with("name", f.name.text).with("ty", shown))
            elif not self.c_representable(ty):
                # A type C has no layout for (12, "C interop"; RULES.md,
                # R118).
                let shown = self.prog.display(self.types, ty)
                var d = Diagnostic.new(Msg.UnsafeExportNotC, at.start, at.end)
                self.report_other(module, d.with("name", f.name.text).with("ty", shown))

    ## Whether a type has a layout C shares, as 12 asks of an exported
    ## function's signature (RULES.md, R118): a number of a width C has
    ## (`int`, `f64`, the sized integers to 64 bits, `f32`), `bool`,
    ## `char`, nothing (`()`), a raw pointer, or a struct or enum declared
    ## `@repr(c)`.
    pure def c_representable(mut self, ty: Ty) -> bool:
        match self.types.data(ty).copy():
            case TyData.Int | TyData.Float | TyData.Bool | TyData.Char | TyData.Unit:
                return True
            case TyData.Adt(d, _):
                if self.prog.c_layout.contains(d):
                    return True
                let b = self.prog.builtin(d) else:
                    return False
                return [
                    "u8", "u16", "u32", "u64", "i8", "i16", "i32", "f32", "ptr", "ptr_mut"
                ].contains(b.copy())
            case _:
                return False

    ## Whether a type holds a reference, a view, a `Shared`, a closure or a
    ## capability.
    pure def unexportable(mut self, ty: Ty) -> bool:
        if self.prog.is_view_type(mut self.types, ty):
            return True
        if self.prog.holds_capability(mut self.types, ty):
            return True
        for t in self.types.walk(ty):
            match self.types.data(t).copy():
                case TyData.Ref(_, _) | TyData.Fn(_, _, _):
                    return True
                case TyData.Adt(d, _):
                    let b = self.prog.builtin(d)
                    if b == Some("Shared".to_string()) or b == Some("Weak".to_string()):
                        return True
                case _:
                    pass
        return False

    ## Whether an impl is of `Drop`.
    pure def is_drop_impl(self, impl_def: DefId?) -> bool:
        let i = impl_def else:
            return False
        let info = self.prog.impl_info(i) else:
            return False
        return Some(info.trait_ref.def_) == self.prog.wk.drop

    ## Every variant by its unqualified name, for the definitions from
    ## `first` on.
    pure def build_variant_index(mut self, first: int):
        for i in range(first, len(self.prog.defs)):
            var names: list[String] = []
            if let Some(e) = self.prog.enum_info(DefId(index=i)):
                for v in e.variants:
                    names.push(v.name.copy())
            for vi in range(len(names)):
                var entry: list[(DefId, int)] = []
                if let Some(l) = self.prog.variants.get(names[vi].copy()):
                    entry = l.copy()
                entry.push((DefId(index=i), vi))
                _ = self.prog.variants.insert(names[vi].copy(), entry)

    # ---------------------------------------------------------------- traits

    ## A trait's associated type names and supertraits, before any struct
    ## or enum.
    pure def resolve_trait_header(
        mut self, def_: DefId, module: ModuleId, t: TraitDef, attrs: list[Attr]
    ):
        var names = ["Self".to_string()]
        if let Some(info) = self.prog.trait_info(def_):
            for g in info.generics:
                names.push(g.name.copy())
        let self_ty = self.types.param(0)
        var assoc: list[AssocInfo] = []
        for a in t.assoc_types:
            var dup = False
            for x in assoc:
                if x.name == a.name.text:
                    dup = True
            if not dup:
                assoc.push(AssocInfo(name=a.name.text.copy(), default=None))
        let sealed = has_attr(attrs, "sealed")
        let marker = has_attr(attrs, "marker")
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Trait(info) = ref mut kind_now:
            info.assoc = assoc
            info.sealed = sealed
            info.marker = marker
            info.unsafe_ = t.is_unsafe
        self.prog.defs[def_.index].set_kind(kind_now)
        # An `unsafe trait` names its implementors' obligations in a
        # `Safety:` list (22).
        if t.is_unsafe and self.lints_in(module):
            var listed_ = False
            if let Some(text) = self.safety_text(module):
                listed_ = safety_list(doc_above(text, t.name.range.start)).is_some()
            if not listed_:
                let at = t.name.range
                var d = Diagnostic.new(Msg.UnsafeNoSafetyList, at.start, at.end)
                d = d.with("name", t.name.text).with("kind", "trait").with("who", "implementors")
                self.warn_in(module, d)
        var supers: list[TraitRef] = []
        for s in t.supertraits:
            var ctx = TyCtx.plain(module, names, True)
            ctx.self_ty = Some(self_ty)
            ctx.in_trait = Some(def_)
            if let Some(tr) = self.resolve_bound(s, self_ty, ctx):
                if tr.def_ == def_:
                    let at = self.ast(module).type_expr(s).range
                    let d = Diagnostic.new(Msg.ResolveTraitCycle, at.start, at.end)
                    self.report_other(module, d.with("name", t.name.text))
                else:
                    supers.push(tr)
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Trait(info) = ref mut kind_now:
            info.supertraits = supers
        self.prog.defs[def_.index].set_kind(kind_now)

    ## The rest of a trait, once types are known: its associated types'
    ## defaults and its methods.
    pure def resolve_trait(mut self, def_: DefId, module: ModuleId, t: TraitDef):
        var names = ["Self".to_string()]
        if let Some(info) = self.prog.trait_info(def_):
            for g in info.generics:
                names.push(g.name.copy())
        let self_ty = self.types.param(0)
        for i in range(len(t.assoc_types)):
            if let Some(te) = t.assoc_types[i].ty:
                var ctx = TyCtx.plain(module, names, True)
                ctx.self_ty = Some(self_ty)
                ctx.in_trait = Some(def_)
                let ty = self.resolve_ty(te, ctx)
                var kind_now = self.prog.defs[def_.index].kind().copy()
                if let DefKind.Trait(info) = ref mut kind_now:
                    if i < len(info.assoc):
                        info.assoc[i].default = Some(ty)
                self.prog.defs[def_.index].set_kind(kind_now)
        for k in range(len(t.methods)):
            let m = ref t.methods[k]
            # A `comptime def` runs at compile time: the trait's derive is
            # not one of its methods.
            if m.is_comptime:
                # Any other is a compile-time function of the trait's,
                # `Trait.name(...)` (decision 251).
                if m.name.text != "derive":
                    let placeholder = self.placeholder_fn(FnKind.Free)
                    let fdef = self.new_def(
                        module,
                        "{t.name.text}.{m.name.text}",
                        m.name.range,
                        Vis.Pub,
                        DefKind.Fn(placeholder),
                    )
                    var kind_now = self.prog.defs[def_.index].kind().copy()
                    if let DefKind.Trait(info) = ref mut kind_now:
                        info.comptime_fns.push((m.name.text.copy(), fdef))
                    self.prog.defs[def_.index].set_kind(kind_now)
                    self.pending.push(
                        Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=None)
                    )
                continue
            var first = k
            for j in range(len(t.methods)):
                if t.methods[j].name.text == m.name.text:
                    first = min(first, j)
            if first != k:
                continue
            let info = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(info))
            # A provided method that reflects is made in each impl that does
            # not write it (decision 251).
            if m.body.is_some() and unfolds(self.ast(module), m, names):
                var provided: list[(ModuleId, FnDef)] = []
                if let Some(x) = self.trait_templates.get(def_):
                    provided = x.copy()
                provided.push((module, m.copy()))
                _ = self.trait_templates.insert(def_, provided)
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=Some(Owner.Trait(def_)))
            )
        # Each associated constant (03, "Traits"; RULES.md, R37): the
        # function that gives its value, a method of the trait without
        # `self` that each impl gives and a value written here provides.
        var declared: list[String] = []
        for m in t.methods:
            declared.push(m.name.text.copy())
        for c in t.consts:
            if declared.contains(c.name.text):
                let at = c.name.range
                var d = Diagnostic.new(Msg.ResolveDuplicateMethod, at.start, at.end)
                d = d.with("owner", t.name.text)
                self.report_other(module, d.with("name", c.name.text))
                continue
            declared.push(c.name.text.copy())
            let f = self.const_fn(module, c) else:
                continue
            let info = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, c.name.text, c.name.range, Vis.Pub, DefKind.Fn(info))
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=f, owner=Some(Owner.Trait(def_)))
            )

    ## An associated constant of a trait or of a trait's impl as the
    ## function that gives its value (RULES.md, R37): `pure def NAME() ->
    ## T: return value`, without a body when the trait leaves the value to
    ## each impl. `None` for a constant without a type, which is `E0219`.
    pure def const_fn(mut self, module: ModuleId, c: ConstDef) -> FnDef?:
        let range = c.name.range
        let ty = c.ty else:
            let d = Diagnostic.new(Msg.ResolveConstTypeRequired, range.start, range.end)
            self.report_other(module, d.with("name", c.name.text))
            return None
        var body: Block? = None
        if let Some(v) = c.value:
            let e = self.sources[module.index].ast.expr(v).copy()
            let st = Stmt(node=e.node, range=e.range, kind=StmtKind.Return(Some(v)))
            let sid = self.sources[module.index].ast.add_stmt(st)
            body = Some(Block(node=e.node, range=e.range, stmts=[sid]))
        return Some(
            FnDef(
                node=0,
                range=range,
                name=Name(text=c.name.text.copy(), range=range),
                is_pure=True,
                is_comptime=False,
                is_unsafe=False,
                generics=[],
                params=[],
                ret=Some(ty),
                from_=[],
                where_=[],
                body=body,
                attrs=[Attr(name=ASSOC_CONST_ATTR.to_string(), args=[], range=range)],
                header_broken=False,
                body_broken=False,
                vis=Vis.Pub,
            )
        )

    pure def resolve_impl(mut self, module: ModuleId, imp: ImplDef, range_in: TextRange):
        # The impl is named by its header, `impl[...] Trait for Type`.
        let self_range = self.ast(module).type_expr(imp.self_ty).range
        var range = range_in
        if self_range.end > range_in.start and self_range.end <= range_in.end:
            range = TextRange.new(range_in.start, self_range.end)
        var names: list[String] = []
        var generics: list[Generic] = []
        for g in imp.generics:
            names.push(g.name.text.copy())
            if g.default.is_some():
                let at = g.name.range
                self.report_other(module, Diagnostic.new(Msg.ResolveImplDefault, at.start, at.end))
            generics.push(Generic(name=g.name.text.copy(), default=None, is_const=g.is_const))
        let predicates = self.resolve_bounds(module, imp.generics, names, 0, None)
        var ctx = TyCtx.plain(module, names, True)
        ctx.predicates = predicates.copy()
        # An impl of a deprecated type is part of its declaration (RULES.md,
        # R40).
        self.quiet_deprecation = True
        let self_ty = self.resolve_ty(imp.self_ty, ctx)
        self.quiet_deprecation = False
        if imp.is_unsafe and self.written_by_comptime(module):
            let at = TextRange.new(range_in.start, self_range.end)
            self.report_other(module, Diagnostic.new(Msg.ComptimeUnsafeWritten, at.start, at.end))
        let trait_ty = imp.trait_ty else:
            # `unsafe impl Type:` promises nothing (22).
            if imp.is_unsafe:
                self.unsafe_promises_nothing(
                    module, range_in, "an inherent impl implements no trait"
                )
            # An inherent impl adds methods to a type.
            let key = self.types.key(self_ty) else:
                if self_ty != Ty.error():
                    let at = self_range
                    var d = Diagnostic.new(Msg.ResolveNotAType, at.start, at.end)
                    self.report_other(
                        module, d.with("name", self.prog.display(self.types, self_ty))
                    )
                return
            # An associated type belongs in an impl of a trait.
            for a in imp.assoc_types:
                let at = a.name.range
                let d = Diagnostic.new(Msg.ResolveAssocOutsideTraitImpl, at.start, at.end)
                self.report_other(module, d)
            let shown = self.prog.display(self.types, self_ty)
            var owner_name = String.new()
            for part in shown.split("["):
                if owner_name.is_empty():
                    owner_name = part.to_string()
            for c in imp.consts:
                self.declare_assoc_const(module, key, owner_name, c)
            for m in imp.methods:
                let vis = if self.is_std(module): Vis.Pub else: m.vis
                let info = self.placeholder_fn(FnKind.Method)
                let def_ = self.new_def(module, m.name.text, m.name.range, vis, DefKind.Fn(info))
                let owner = Owner.Inherent(
                    generics=generics.copy(),
                    names=names.copy(),
                    predicates=predicates.copy(),
                    self_ty=self_ty,
                )
                self.pending.push(
                    Pending.Fn(def_=def_, module=module, ast=m.copy(), owner=Some(owner))
                )
            return
        ctx.self_ty = Some(self_ty)
        let trait_ref = self.resolve_bound(trait_ty, self_ty, ctx) else:
            return
        if self_ty == Ty.error():
            return
        self.check_unsafe_impl(module, imp, range_in, trait_ref, predicates, names)
        # An `unsafe impl Copy` is E0986's: `Copy` is never asserted.
        if not imp.is_unsafe:
            self.check_copy_by_hand(module, trait_ref, self_ty, range, range_in)
        # A refinement has its base's reading impls and no others (07).
        if let TyData.Adt(d, args) = self.types.data(self_ty).copy():
            if let Some(base) = self.prog.refinement_base(mut self.types, d, args):
                var diag = Diagnostic.new(Msg.RefineOwnImpl, range.start, range.end)
                diag = diag.with("ty", self.prog.display(self.types, self_ty))
                diag = diag.with("base", self.prog.display(self.types, base))
                diag = diag.with("trait", self.prog.display_trait_in(self.types, trait_ref, []))
                self.report_other(module, diag)
                return
        # `Drop` is for a struct or enum of this module, with exactly
        # `def drop(mut self)`, and for all of a generic type: the drop glue
        # (a SIR function per type) runs it for every value, whatever the
        # type arguments.
        if Some(trait_ref.def_) == self.prog.wk.drop:
            var target: DefId? = None
            if let TyData.Adt(d, _) = self.types.data(self_ty):
                if self.prog.defs[d.index].module == module:
                    match self.prog.defs[d.index].kind():
                        case DefKind.Struct(_) | DefKind.Enum(_):
                            target = Some(d)
                        case _:
                            pass
            let t = target else:
                self.report_other(
                    module, Diagnostic.new(Msg.ResolveDropTarget, range.start, range.end)
                )
                return
            let params = len(self.prog.type_generics(t))
            if params > 0:
                let declared_preds = self.preds_of(t)
                var whole = len(generics) == params and self_ty == self.self_type(t, params)
                for p in predicates:
                    var declared = False
                    for q in declared_preds:
                        if q.ty == p.ty and q.bound == p.bound:
                            declared = True
                    if not declared:
                        whole = False
                if not whole:
                    var own_names: list[String] = []
                    for g in self.prog.type_generics(t):
                        own_names.push(g.name.copy())
                    let list = own_names.join(", ")
                    let name = self.prog.defs[t.index].name.copy()
                    var d = Diagnostic.new(Msg.ResolveDropGeneric, range.start, range.end)
                    d = d.with("ty", self.prog.display_in(self.types, self_ty, names))
                    d = d.with("name", name).with(
                        "expected", "impl[{list}] Drop for {name}[{list}]"
                    )
                    self.report_other(module, d)
                    return
            var ok = len(imp.methods) == 1
            if ok:
                let m = ref imp.methods[0]
                ok = m.name.text == "drop" and len(m.params) == 1 and m.ret.is_none()
                if ok:
                    ok = m.params[0].mode == Mode.Mut
                    if let ParamKind.SelfParam = m.params[0].kind:
                        pass
                    else:
                        ok = False
            if not ok:
                let d = Diagnostic.new(Msg.ResolveDropSignature, range.start, range.end)
                self.report_other(module, d)
                return
        # What the impl binds its associated types to.
        var assoc: list[(String, Ty)] = []
        var declared: list[String] = []
        if let Some(i) = self.prog.trait_info(trait_ref.def_):
            for a in i.assoc:
                declared.push(a.name.copy())
        for a in imp.assoc_types:
            if not declared.contains(a.name.text):
                let at = a.name.range
                var d = Diagnostic.new(Msg.ResolveUnknownAssocType, at.start, at.end)
                d = d.with("trait", self.prog.display_trait_in(self.types, trait_ref, names))
                self.report_other(module, d.with("name", a.name.text))
                continue
            var ty = Ty.error()
            match a.ty:
                case Some(te):
                    ty = self.resolve_ty(te, ctx)
                case None:
                    let d = Diagnostic.new(Msg.ResolveAssocNeedsType, a.range.start, a.range.end)
                    self.report_other(module, d.with("name", a.name.text))
            assoc.push((a.name.text.copy(), ty))
        let shown_trait = self.prog.display_trait_in(self.types, trait_ref, names)
        let shown_ty = self.prog.display_in(self.types, self_ty, names)
        let info = ImplInfo(
            generics=generics,
            predicates=predicates,
            trait_ref=trait_ref.copy(),
            self_ty=self_ty,
            methods=[],
            assoc=assoc,
            derived=self.prog.modules[module.index].name.starts_with("<derive>/"),
            unsafe_=imp.is_unsafe,
        )
        let def_ = self.new_def(
            module, "impl {shown_trait} for {shown_ty}", range, Vis.Pub, DefKind.Impl(info)
        )
        self.prog.impls.push(def_)
        # In place, where the list was copied and put back for each impl
        # (RULES.md, R147).
        if self.prog.impls_of.contains(trait_ref.def_):
            self.prog.impls_of[trait_ref.def_].push(def_)
        else:
            _ = self.prog.impls_of.insert(trait_ref.def_, [def_])
        if Some(trait_ref.def_) == self.prog.wk.drop:
            if let TyData.Adt(d, _) = self.types.data(self_ty):
                _ = self.prog.drop_types.add(d)
        for m in imp.methods:
            let finfo = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(finfo))
            # A value of the type runs its `impl Drop`'s method when dropped.
            if Some(trait_ref.def_) == self.prog.wk.drop:
                if let TyData.Adt(d, _) = self.types.data(self_ty).copy():
                    var kind_now = self.prog.defs[d.index].kind().copy()
                    if let DefKind.Struct(s) = ref mut kind_now:
                        s.drop = Some(fdef)
                    if let DefKind.Enum(e) = ref mut kind_now:
                        e.drop = Some(fdef)
                    self.prog.defs[d.index].set_kind(kind_now)
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=Some(Owner.Impl(def_)))
            )
        # The trait's associated constants the impl gives (RULES.md, R37),
        # each the function that gives its value, as the trait declares it.
        for c in imp.consts:
            let f = self.const_fn(module, c) else:
                continue
            let finfo = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, c.name.text, c.name.range, Vis.Pub, DefKind.Fn(finfo))
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=f, owner=Some(Owner.Impl(def_)))
            )
        # The trait's provided methods that reflect and that the impl does
        # not write: each a method of the impl, written where the trait's
        # is, and so a template of the impl made for its type (decision
        # 251).
        var provided: list[(ModuleId, FnDef)] = []
        if let Some(x) = self.trait_templates.get(trait_ref.def_):
            provided = x.copy()
        for (trait_module, m) in provided:
            var written = False
            for x in imp.methods:
                if x.name.text == m.name.text:
                    written = True
            if written:
                continue
            let finfo = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(
                trait_module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(finfo)
            )
            _ = self.provided_copies.add(fdef)
            self.pending.push(
                Pending.Fn(
                    def_=fdef, module=trait_module, ast=m.copy(), owner=Some(Owner.Impl(def_))
                )
            )

    # ---------------------------------------------------------------- imports

    ## Whether a `from` import names a module of the program's packages that
    ## does not have each name yet (RULES.md, R24): one its own imports bind.
    pure def import_waits(self, module: ModuleId, id: ItemId) -> bool:
        let item = self.sources[module.index].ast.item(id).copy()
        let ItemKind.FromImport(imp) = item.kind else:
            return False
        let target = self.package_module(module, imp.path) else:
            return False
        for (n, _) in imp.names:
            if self.prog.member(target, n.text, module).is_none():
                return True
        return False

    ## The module of a package of the program an import path names, or
    ## `None` (without reporting anything) for any other path.
    pure def package_module(self, module: ModuleId, path: list[Name]) -> ModuleId?:
        let first = path.first() else:
            return None
        let package = self.prog.package_of(module)
        if package >= len(self.prog.packages):
            return None
        let this = ref self.prog.packages[package]
        var root: ModuleId? = None
        if not this.name.is_empty() and this.name == first.text:
            root = this.root
        else:
            for (n, d) in this.deps:
                if n == first.text and root.is_none() and d < len(self.prog.packages):
                    root = self.prog.packages[d].root
        let found = root else:
            return None
        var m = found
        for i in range(1, len(path)):
            if let Some(c) = self.prog.modules[m.index].children.get(path[i].text.copy()):
                m = c
                continue
            let d = self.prog.lookup_in(m, path[i].text) else:
                return None
            let DefKind.Module(c) = self.prog.defs[d.index].kind() else:
                return None
            m = c
        return Some(m)

    ## An `import` or `from ... import` item of `module` (09, "Modules").
    pure def declare_import(mut self, module: ModuleId, id: ItemId):
        let item = self.sources[module.index].ast.item(id).copy()
        var for_tests = False
        for a in item.attrs:
            if a.name == "cfg" and len(a.args) == 1 and a.args[0].name.is_none():
                if let ExprKind.Name(n) = self.ast(module).expr(a.args[0].value).kind:
                    for_tests = n == "test"
        self.import_for_tests = for_tests
        match item.kind:
            case ItemKind.Import(imp):
                self.import_module(module, imp, item.range, item.vis)
            case ItemKind.FromImport(imp):
                self.import_from(module, imp, item.range, item.vis)
            case _:
                pass
        self.import_for_tests = False

    ## The module an import path names (09, "Modules"): a module of the
    ## importing package (by the package's own name), of one of its
    ## dependencies (by the dependency's name), or of the standard library
    ## (`std.json`, and stage 0's short names), loaded; `None` after noting
    ## that stage 0 reports the path (`resolve.import-unknown`, with the name
    ## a similar module's import would bind; `resolve.not-a-dependency`;
    ## `resolve.unknown-module`).
    pure def import_target(
        mut self, module: ModuleId, path: list[Name], at: TextRange
    ) -> (ModuleId?, String?):
        var words: list[String] = []
        for n in path:
            words.push(n.text.copy())
        let first = words.first() else:
            return (None, None)
        let package = self.prog.package_of(module)
        var root: ModuleId? = None
        # A dev-dependency imported by its package's code by an import that
        # is not `@cfg(test)` (RULES.md, R75).
        let outside_tests = not self.is_std(module) and not self.import_for_tests
        if package < len(self.prog.packages) and outside_tests:
            if self.prog.packages[package].dev_only.contains(first.copy()):
                let this = self.prog.packages[package].name.copy()
                var d = Diagnostic.new(Msg.ResolveDevDependency, at.start, at.end)
                d = d.with("name", words.join(".")).with("package", first).with("this", this)
                self.report_other(module, d.note(Msg.ResolveDevDependencyTests))
                return (None, None)
        if package < len(self.prog.packages):
            let this = ref self.prog.packages[package]
            if not this.name.is_empty() and this.name == first:
                root = this.root
            else:
                for (n, d) in this.deps:
                    if n == first and root.is_none() and d < len(self.prog.packages):
                        root = self.prog.packages[d].root
        if let Some(found) = root:
            var m = found
            for i in range(1, len(path)):
                let seg = path[i].text.copy()
                var next: ModuleId? = None
                if let Some(c) = self.prog.modules[m.index].children.get(seg.copy()):
                    next = Some(c)
                elif let Some(d) = self.prog.lookup_in(m, seg):
                    if let DefKind.Module(c) = self.prog.defs[d.index].kind():
                        if not self.prog.modules[m.index].imported.contains(seg.copy()):
                            next = Some(c)
                let c = next else:
                    var named: list[String] = []
                    for k in range(i + 1):
                        named.push(words[k].copy())
                    var d = Diagnostic.new(Msg.ResolveUnknownModule, at.start, at.end)
                    # A module one letter off, `atlas.geo.points` for
                    # `atlas.geo.point`: the path with the similar module
                    # (RULES.md, R97), as `E0220` has it.
                    var children: list[String] = []
                    for (c, _) in self.prog.modules[m.index].children.items():
                        children.push(c.copy())
                    if let Some(similar) = self.prog.closest(seg, children):
                        var fixed: list[String] = []
                        for k in range(len(words)):
                            fixed.push(if k == i: similar.copy() else: words[k].copy())
                        d = d.fix_at(Msg.ResolveSimilarModule, at.start, at.end, fixed.join("."))
                    self.report_other(module, d.with("name", named.join(".")))
                    return (None, None)
                m = c
            return (Some(m), None)
        # A package of the program that this package does not depend on
        # (`resolve.not-a-dependency`).
        if not self.is_std(module) and module_for(words).is_none():
            for k in range(2, len(self.prog.packages)):
                if self.prog.packages[k].name == first:
                    var this = String.new()
                    var excluded = False
                    if package < len(self.prog.packages):
                        this = self.prog.packages[package].name.copy()
                        excluded = self.prog.packages[package].excluded.contains(first.copy())
                    # A dependency whose `when` leaves it out of this build
                    # is in `[dependencies]` already (RULES.md, R71).
                    if excluded:
                        var d = Diagnostic.new(Msg.ResolveDependencyExcluded, at.start, at.end)
                        d = d.with("name", words.join(".")).with("package", first)
                        self.report_other(module, d.with("this", this))
                        return (None, None)
                    var d = Diagnostic.new(Msg.ResolveNotADependency, at.start, at.end)
                    d = d.with("name", words.join(".")).with("package", self.prog.packages[k].name)
                    self.report_other(module, d.with("this", this))
                    return (None, None)
        let name = module_for(words) else:
            # `resolve.import-unknown`, the name pass's.
            if self.is_root(module):
                self.other_error = True
            # The closest module a path can name: std's, or a package's.
            var candidates = module_paths()
            for p in self.prog.packages:
                if not p.name.is_empty():
                    candidates.push(p.name.copy())
            var similar: String? = None
            if let Some(c) = closest(words.join("."), candidates):
                similar = Some(last_word(c))
            return (None, similar)
        # `std.rt` is internal to the standard library (22, "Machine
        # intrinsics"; Q-57): only `std` reaches the machine.
        if name == "rt" and not self.is_std(module):
            var d = Diagnostic.new(Msg.CapInternal, at.start, at.end)
            self.report_other(module, d.with("name", "std.rt"))
            return (None, None)
        let loaded = self.std_loaded.get(name.copy()).copied()
        if let Some(m) = loaded:
            self.complete_std(name, m, Templates.none())
            return (Some(m), None)
        var found: Module? = None
        if let Some(m) = self.std_parsed.get(name.copy()):
            found = Some(m.copy())
        # A base made from the cache parses a module when one imports it.
        if found.is_none():
            if let Some(text) = self.std_sources.get(name.copy()):
                found = Some(build.module(parse(text, Catalog.parse("")).tree))
        let parsed = found else:
            # Stage 1 reads every std module it may import; one missing is
            # not one it can check against.
            self.beyond_in(module, "an import of a std module stage 1 has not read")
            return (None, None)
        if not self.std_derived.contains(name.copy()):
            self.beyond_in(
                module, "an import of a std module whose derived impls the base did not make"
            )
            return (None, None)
        let m = self.load_std_module(name, parsed.copy(), "", Templates.none())
        return (Some(m), None)

    ## The names an import that failed would have bound: their uses are not
    ## reported again.
    pure def poison_import(mut self, module: ModuleId, name: str, similar: String?):
        if not self.is_root(module):
            return
        if let Some(s) = similar:
            _ = self.prog.poisoned.add(s.copy())
        _ = self.prog.poisoned.add(name.to_string())

    ## Whether `name` in `module` is still the child module 09 links there,
    ## which no declaration or import took.
    pure def child_link(self, module: ModuleId, name: str) -> bool:
        let data = ref self.prog.modules[module.index]
        let c = data.children.get(name.to_string()) else:
            return False
        if data.imported.contains(name.to_string()):
            return False
        let d = data.items.get(name.to_string()) else:
            return False
        if let DefKind.Module(m) = self.prog.defs[d.index].kind():
            return m == c
        return False

    ## Records that an import bound `name` in `module`, with the import's
    ## visibility (a `pub` import re-exports it).
    pure def bind_import(mut self, module: ModuleId, name: str, def_: DefId, vis: Vis):
        if let Some(old) = self.prog.modules[module.index].items.get(name.to_string()):
            if old == def_:
                return
            if let DefKind.Module(a) = self.prog.defs[old.index].kind():
                if let DefKind.Module(b) = self.prog.defs[def_.index].kind():
                    if a == b:
                        return
            # A child module's name gives way to an import (RULES.md, R74).
            if not self.child_link(module, name):
                self.bind(module, name, def_)
                return
        _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        _ = self.prog.modules[module.index].imported.insert(name.to_string(), vis)

    ## `import a.b.Item`, an item named as a module (09: `import` names a
    ## module, `from a.b import Item` an item of one): `E0223`, with the fix
    ## that imports it from its module (RULES.md, R60), when the path but
    ## its last name is a module, of the program or std, and that module has
    ## no module of the last name. An item std's module does not declare is
    ## `E0204`. Whether it reported.
    pure def item_imported(
        mut self, module: ModuleId, imp: Import, item_at: TextRange, whole: TextRange, vis: Vis
    ) -> bool:
        if len(imp.path) < 2:
            return False
        var words: list[String] = []
        for n in imp.path:
            words.push(n.text.copy())
        let last = words[len(words) - 1].copy()
        var prefix: list[String] = []
        for k in range(len(words) - 1):
            prefix.push(words[k].copy())
        var found: ModuleId? = None
        let package = self.prog.package_of(module)
        var root: ModuleId? = None
        if package < len(self.prog.packages):
            let this = ref self.prog.packages[package]
            if not this.name.is_empty() and this.name == words[0]:
                root = this.root
            else:
                for (n, d) in this.deps:
                    if n == words[0] and root.is_none() and d < len(self.prog.packages):
                        root = self.prog.packages[d].root
        var std = False
        if let Some(r) = root:
            var m = r
            for k in range(1, len(prefix)):
                if let Some(c) = self.prog.modules[m.index].children.get(prefix[k].copy()):
                    m = c
                    continue
                let d = self.prog.lookup_in(m, prefix[k]) else:
                    return False
                var next: ModuleId? = None
                if let DefKind.Module(c) = self.prog.defs[d.index].kind():
                    next = Some(c)
                let c = next else:
                    return False
                m = c
            found = Some(m)
        elif module_for(prefix).is_some() and module_for(words).is_none():
            var names: list[Name] = []
            for k in range(len(prefix)):
                names.push(imp.path[k].copy())
            let (m, _) = self.import_target(module, names, whole)
            found = m
            std = True
        let m = found else:
            return False
        if self.prog.modules[m.index].children.contains(last.copy()):
            return False
        let item = self.prog.lookup_in(m, last)
        if let Some(d) = item:
            if let DefKind.Module(_) = self.prog.defs[d.index].kind():
                return False
        elif not std:
            return False
        let path = prefix.join(".")
        if self.is_root(module):
            self.other_error = True
        if item.is_none():
            var diag = Diagnostic.new(Msg.ResolveNotInModule, whole.start, whole.end)
            self.report_other(module, diag.with("module", path).with("name", last))
            return True
        var text = "from {path} import {last}"
        var end = whole.end
        if let Some(a) = imp.alias:
            text = "{text} as {a.text}"
            end = a.range.end
        if let Vis.Pub = vis:
            text = "pub {text}"
        var diag = Diagnostic.new(Msg.ResolveNotAModule, whole.start, whole.end)
        diag = diag.with("name", words.join("."))
        self.report_other(
            module, diag.fix_at(Msg.ResolveImportFromModule, item_at.start, end, text)
        )
        return True

    pure def import_module(mut self, module: ModuleId, imp: Import, range: TextRange, vis: Vis):
        if imp.c_header.is_some():
            let what = "a C header import"
            self.unsupported_in(module, range, what, "foreign functions (Phase 8)")
            return
        var bound = String.new()
        var at = range
        match imp.alias:
            case Some(a):
                bound = a.text.copy()
                at = a.range
            case None:
                if let Some(last) = imp.path.last():
                    bound = last.text.copy()
                    at = last.range
        var whole = range
        if let Some(a) = imp.path.first():
            if let Some(b) = imp.path.last():
                whole = a.range.cover(b.range)
        if self.item_imported(module, imp, range, whole, vis):
            self.poison_import(module, bound, None)
            return
        let (target, similar) = self.import_target(module, imp.path, whole)
        let m = target else:
            self.poison_import(module, bound, similar)
            return
        let def_ = self.new_def(module, bound, at, vis, DefKind.Module(m))
        if self.is_std(module):
            self.bind(module, bound, def_)
        else:
            self.bind_import(module, bound, def_, vis)

    pure def import_from(mut self, module: ModuleId, imp: FromImport, range: TextRange, vis: Vis):
        var whole = range
        if let Some(a) = imp.path.first():
            if let Some(b) = imp.path.last():
                whole = a.range.cover(b.range)
        let (target, similar) = self.import_target(module, imp.path, whole)
        let m = target else:
            for (n, alias) in imp.names:
                var bound = n.text.copy()
                if let Some(a) = alias:
                    bound = a.text.copy()
                self.poison_import(module, bound, similar)
            return
        let mname = self.prog.modules[m.index].name.copy()
        let prelude = self.prog.prelude
        for (n, alias) in imp.names:
            var found = self.prog.member(m, n.text, module)
            var reexported = False
            for x in reexports(mname):
                if x == n.text:
                    reexported = True
            if found.is_none() and self.is_std(m) and reexported:
                if let Some(d) = self.prog.lookup_in(prelude, n.text):
                    found = Some((d, True))
            match found:
                case Some((d, visible)):
                    if not visible:
                        self.report_other(module, self.prog.private_item(d, m, n.range))
                    var bound = n.text.copy()
                    if let Some(a) = alias:
                        bound = a.text.copy()
                    self.bind_import(module, bound, d, vis)
                case None:
                    var path: list[String] = []
                    for x in imp.path:
                        path.push(x.text.copy())
                    var d = Diagnostic.new(Msg.ResolveNotInModule, n.range.start, n.range.end)
                    d = d.with("module", path.join(".")).with("name", n.text)
                    # An item a `@cfg` left out of this build says which
                    # condition did (RULES.md, R91).
                    if m.index < len(self.sources):
                        for (gone, cond) in self.sources[m.index].left_out:
                            if gone == n.text:
                                let ps = [
                                    MsgParam(name="name".to_string(), value=gone.copy()),
                                    MsgParam(name="cfg".to_string(), value=cond.copy()),
                                ]
                                d = d.note_params(Msg.ResolveCfgLeftOut, ps)
                                break
                    # A variant of one of the module's enums or error sets
                    # is named through its type (RULES.md, R104).
                    if let Some(owner) = self.variant_owner(m, n.text):
                        let ps = [
                            MsgParam(name="name".to_string(), value=n.text.copy()),
                            MsgParam(name="ty".to_string(), value=owner),
                        ]
                        d = d.note_params(Msg.ResolveVariantOfType, ps)
                    self.report_other(module, d)

    ## Whether an impl of a trait of another package for a type of another
    ## package is `package`'s own all the same (RULES.md, R105): one of the
    ## trait's type arguments is a type of `package`, `impl Mul[Vector] for
    ## f64` in the package that declares `Vector`, and no type parameter of
    ## the impl stands bare before it, the type implementing it first (the
    ## first local type, as Rust's rule has it), so that no other package's
    ## impl can be the same one.
    pure def local_argument(self, package: int, self_ty: Ty, trait_args: list[Ty]) -> bool:
        var order = [self_ty]
        for a in trait_args:
            order.push(a)
        for t in order:
            match self.types.data(t):
                case TyData.Param(_):
                    return False
                case TyData.Adt(d, _):
                    if self.prog.package_of(self.prog.defs[d.index].module) == package:
                        return True
                case _:
                    pass
        return False

    ## The enum or error set of module `m`, visible outside it, with a
    ## variant `name`.
    pure def variant_owner(self, m: ModuleId, name: str) -> String?:
        if m.index >= len(self.sources):
            return None
        for item in self.ast(m).items:
            if item.vis == Vis.Private:
                continue
            match item.kind:
                case ItemKind.Enum(e) | ItemKind.ErrorSet(e):
                    for v in e.variants:
                        if v.name.text == name:
                            return Some(e.name.text.copy())
                case _:
                    pass
        return None

    # ---------------------------------------------------------------- scripts

    ## The items of a script (10, "REPL and scripts"): its top-level
    ## statements are the body of its `main`, `def main(sys: System) ->
    ## !:` with `return Ok(())` after them, declared after the other items.
    ## A script that declares its own `main` keeps it (stage 0 reports the
    ## statements, `resolve.script-main`).
    pure def script_items(mut self, module: ModuleId, items: list[ItemId]) -> list[ItemId]:
        var stmts: list[StmtId] = []
        var out: list[ItemId] = []
        var own_main: TextRange? = None
        for i in items:
            match self.ast(module).item(i).kind:
                case ItemKind.Stmt(st):
                    stmts.push(st)
                case ItemKind.Fn(f):
                    if f.name.text == "main" and own_main.is_none():
                        own_main = Some(f.name.range)
                    out.push(i)
                case _:
                    out.push(i)
        if stmts.is_empty():
            return items.copy()
        if let Some(at) = own_main:
            self.report_other(module, Diagnostic.new(Msg.ResolveScriptMain, at.start, at.end))
            return items.copy()
        let first = self.ast(module).stmt(stmts[0]).copy()
        let last = self.ast(module).stmt(stmts[len(stmts) - 1]).copy()
        let node = first.node
        let at = TextRange.empty(first.range.start)
        let end = TextRange.empty(last.range.end)
        var body = stmts.copy()
        var returns = False
        if let StmtKind.Return(_) = last.kind:
            returns = True
        if not returns:
            let ok_name = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=end, kind=ExprKind.Name("Ok".to_string()))
            )
            let unit = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=end, kind=ExprKind.Tuple([]))
            )
            let arg = Arg(node=node, range=end, name=None, mutable=False, value=unit)
            let call = Expr(
                node=node, range=end, kind=ExprKind.Call(callee=ok_name, args=[arg], trailing=None)
            )
            let ok = self.sources[module.index].ast.add_expr(call)
            body.push(
                self.sources[module.index].ast.add_stmt(
                    Stmt(node=node, range=end, kind=StmtKind.Return(Some(ok)))
                )
            )
        let range = TextRange.new(first.range.start, last.range.end)
        let system = TypeExpr(
            node=node,
            range=at,
            kind=TypeKind.Path(segments=[Name(text="System".to_string(), range=at)], args=[]),
        )
        let sys_ty = self.sources[module.index].ast.add_type(system)
        let ret = self.sources[module.index].ast.add_type(
            TypeExpr(node=node, range=at, kind=TypeKind.Result(ok=None, err=None))
        )
        let param = Param(
            node=node,
            range=at,
            mode=Mode.Borrow,
            kind=ParamKind.Named(
                name=Name(text="sys".to_string(), range=at), ty=sys_ty, default=None
            ),
        )
        let f = FnDef(
            node=node,
            range=range,
            name=Name(text="main".to_string(), range=at),
            is_pure=False,
            is_comptime=False,
            is_unsafe=False,
            generics=[],
            params=[param],
            ret=Some(ret),
            from_=[],
            where_=[],
            body=Some(Block(node=node, range=range, stmts=body)),
            attrs=[],
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )
        let item = Item(
            node=node, range=range, attrs=[], vis=Vis.Private, docs=[], kind=ItemKind.Fn(f)
        )
        out.push(self.sources[module.index].ast.add_item(item))
        return out

    # ---------------------------------------------------------------- doc examples

    ## The root module's doc examples as tests (stage 0's `doctests.rs`; 10,
    ## "Testing"): a module of its own whose text keeps every example line
    ## where it is, so that a diagnostic in an example points at it, and
    ## whose scope is the root module's.
    pure def declare_doc_tests(mut self, module: ModuleId, items: list[ItemId], test_prefix: str):
        let source = self.text_of_module(module)
        let starts = item_starts(self.ast(module), items)
        self.declare_doc_tests_in(module, starts, test_prefix, source)

    ## `sir --tests --std` (`sisu test --std`; RULES.md, R185): the doc
    ## examples of the prelude, as `std.core`, and of every std module
    ## `doc --std` documents, as `std.NAME`, each loaded when the base has
    ## not, in stage 0's order, as tests named `std.core/zip (doc
    ## example)`.
    pure def declare_std_doc_tests(mut self):
        let texts = self.std_doc_texts.copy()
        let p = self.prog.prelude
        # The examples' modules made once for the check (RULES.md, R224).
        if not self.std_docs.is_empty():
            if let Some(doc) = self.std_docs.get("prelude"):
                self.declare_std_doc(p, doc.copy(), "std.core")
            for name in documented():
                if not texts.contains(name.to_string()):
                    continue
                let m = self.std_module_named(name) else:
                    continue
                if let Some(doc) = self.std_docs.get(name.to_string()):
                    self.declare_std_doc(m, doc.copy(), display_path(name))
            return
        # The base keeps no syntax of its modules for a program (the type
        # checker never checks their bodies): the items' starts are read
        # from the text.
        if let Some(t) = texts.get("prelude"):
            let syntax = build.module(parse(t, Catalog.parse("")).tree)
            self.declare_doc_tests_in(p, item_starts(syntax.ast, syntax.items), "std.core", t)
        for name in documented():
            let text = texts.get(name.to_string()) else:
                continue
            let m = self.std_module_named(name) else:
                continue
            let syntax = build.module(parse(text, Catalog.parse("")).tree)
            let starts = item_starts(syntax.ast, syntax.items)
            self.declare_doc_tests_in(m, starts, display_path(name), text)

    ## The std module `name`, loaded as an import loads it when the base
    ## has not; `None` when stage 1 cannot load it.
    pure def std_module_named(mut self, name: str) -> ModuleId?:
        let loaded = self.std_loaded.get(name.to_string()).copied()
        if let Some(m) = loaded:
            self.complete_std(name, m, Templates.none())
            return Some(m)
        var found: Module? = None
        if let Some(m) = self.std_parsed.get(name.to_string()):
            found = Some(m.copy())
        if found.is_none():
            if let Some(text) = self.std_sources.get(name.to_string()):
                found = Some(build.module(parse(text, Catalog.parse("")).tree))
        let parsed = found else:
            return None
        if not self.std_derived.contains(name.to_string()):
            return None
        return Some(self.load_std_module(name, parsed.copy(), "", Templates.none()))

    ## `declare_doc_tests_in` of a std module whose examples' module `doc`
    ## holds, made before (RULES.md, R224).
    pure def declare_std_doc(mut self, module: ModuleId, own doc: StdDoc, test_prefix: str):
        let g_items = doc.syntax.items.copy()
        let name = "<doc>/{self.prog.modules[module.index].name}.sisu"
        let g = self.add_module(name, False, doc.syntax)
        self.prog.modules[g.index].parent = Some(module)
        self.prog.modules[g.index].package = self.prog.modules[module.index].package
        self.prog.modules[g.index].file = self.prog.modules[module.index].file.copy()
        for d in doc.diagnostics:
            self.report_other(g, d.copy())
        _ = self.module_texts.insert(g, doc.text.copy())
        self.docs.push((g, doc.text.copy()))
        self.declare_items(g, g_items, test_prefix)

    ## `declare_doc_tests` of a module whose text is `source`, whose items
    ## that can carry a doc comment start at `starts`.
    pure def declare_doc_tests_in(
        mut self, module: ModuleId, starts: list[(int, String)], test_prefix: str, source: str
    ):
        let examples = doc_examples(source, starts)
        if examples.is_empty():
            return
        let text = doc_test_module(source, examples)
        let parsed = parse(text, Shared.get(self.catalog))
        let generated = build.module(parsed.tree)
        let g_items = generated.items.copy()
        let name = "<doc>/{self.prog.modules[module.index].name}.sisu"
        let g = self.add_module(name, False, generated)
        self.prog.modules[g.index].parent = Some(module)
        self.prog.modules[g.index].package = self.prog.modules[module.index].package
        # The file keeps the module's name: its lines are the module's.
        self.prog.modules[g.index].file = self.prog.modules[module.index].file.copy()
        # A syntax error in an example is in the examples' file (stage 0's
        # `parse_generated`), at the line the module's file has it on.
        for d in parsed.diagnostics:
            self.report_other(g, d.copy())
        _ = self.module_texts.insert(g, text.copy())
        self.docs.push((g, text))
        self.declare_items(g, g_items, test_prefix)

    # ---------------------------------------------------------------- interceptors and fakes

    ## The interceptor and the fake of each trait among `items` (stage 0's
    ## `shims.rs`; 06, "Interceptors and trace context"; 17, "Fakes"), when
    ## the module's text names `Wrap` or `Fake`: `cap.Wrap(inner=x,
    ## hook=h)` implements the trait by showing each call to the
    ## interceptor and forwarding it, and `cap.Fake[Trait]` is a recording
    ## fake of it. Stage 0 writes them as source text, in a module of their
    ## own whose scope is the trait's; so does stage 1, which then parses
    ## and declares that text.
    pure def declare_trait_shims(mut self, module: ModuleId, items: list[ItemId]):
        if self.is_std(module):
            return
        let source = self.text_of_module(module)
        let wrap = source.contains("Wrap")
        let fakes = source.contains("Fake")
        if not wrap and not fakes:
            return
        var text = String.new()
        var faked: list[String] = []
        for it in items:
            let ItemKind.Trait(t) = self.ast(module).item(it).kind.copy() else:
                continue
            let ms = self.shim_methods(module, t) else:
                continue
            if wrap:
                text.push("\n")
                text.push(wrap_impl(t.name.text, ms))
            if fakes:
                text.push("\n")
                text.push(fake_text(t.name.text, ms))
                faked.push(t.name.text.copy())
        if text.is_empty():
            return
        let generated = build.module(parse(text, Catalog.parse("")).tree)
        let g_items = generated.items.copy()
        let name = "<shims>/{self.prog.modules[module.index].name}.sisu"
        let g = self.add_module(name, False, generated)
        self.prog.modules[g.index].parent = Some(module)
        self.prog.modules[g.index].package = self.prog.modules[module.index].package
        _ = self.module_texts.insert(g, text.copy())
        self.shims.push((g, text.copy()))
        self.declare_items(g, g_items, "")
        for name in faked:
            let tr = self.prog.lookup_in(module, name)
            let st = self.prog.lookup_in(g, "__Fake_{name}")
            if let Some(a) = tr:
                if let Some(b) = st:
                    _ = self.prog.fakes.insert(a, b)

    ## The methods of a trait, when every one can be forwarded: a `self` or
    ## `mut self` receiver, no type parameters of its own, and no borrow or
    ## `Self` in its signature; the trait itself has no type parameters,
    ## associated types or supertraits.
    pure def shim_methods(self, module: ModuleId, t: TraitDef) -> list[ShimMethod]?:
        if not t.generics.is_empty()
                or not t.supertraits.is_empty()
                or not t.assoc_types.is_empty():
            return None
        var out: list[ShimMethod] = []
        for m in t.methods:
            if m.is_comptime:
                continue
            if not m.generics.is_empty()
                    or not m.where_.is_empty()
                    or not m.from_.is_empty()
                    or m.header_broken:
                return None
            if m.params.is_empty():
                return None
            match m.params[0].kind:
                case ParamKind.SelfParam:
                    pass
                case _:
                    return None
            if m.params[0].mode == Mode.Own:
                return None
            var args: list[(String, bool)] = []
            for k in range(1, len(m.params)):
                let p = ref m.params[k]
                match p.kind:
                    case ParamKind.Named(name, ty, _):
                        if self.borrows(module, ty):
                            return None
                        args.push((name.text.copy(), p.mode == Mode.Mut))
                    case _:
                        return None
            var ret = String.new()
            var result: String? = None
            if let Some(r) = m.ret:
                if self.borrows(module, r):
                    return None
                let written = self.text_in(module, self.ast(module).type_expr(r).range)
                ret = " -> {written}"
                if written != "()":
                    result = Some(written.copy())
            var params: list[String] = []
            for p in m.params:
                params.push(self.text_in(module, p.range))
            out.push(
                ShimMethod(
                    name=m.name.text.copy(),
                    params=params.join(", "),
                    ret=ret,
                    result=result,
                    args=args,
                )
            )
        if out.is_empty():
            return None
        return Some(out)

    ## Whether a type mentions a borrow or `Self`.
    pure def borrows(self, module: ModuleId, t: TypeExprId) -> bool:
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Ref(_, _):
                return True
            case TypeKind.Path(segments, args):
                for s in segments:
                    if s.text == "Self":
                        return True
                for a in args:
                    if self.borrows(module, a):
                        return True
                return False
            case TypeKind.Option(x):
                return self.borrows(module, x)
            case TypeKind.Dyn(x):
                return self.borrows(module, x)
            case TypeKind.Result(ok, err):
                if let Some(o) = ok:
                    if self.borrows(module, o):
                        return True
                if let Some(e) = err:
                    if self.borrows(module, e):
                        return True
                return False
            case TypeKind.Union(xs):
                for x in xs:
                    if self.borrows(module, x):
                        return True
                return False
            case TypeKind.Tuple(xs):
                for (_, x) in xs:
                    if self.borrows(module, x):
                        return True
                return False
            case TypeKind.Fn(_, params, ret):
                for x in params:
                    if self.borrows(module, x):
                        return True
                return self.borrows(module, ret)
            case TypeKind.ConstArg(_) | TypeKind.ConstExpr(_):
                return False
            case TypeKind.PtrMut(_, x):
                return self.borrows(module, x)
            case TypeKind.Unsupported(_):
                return True
            case TypeKind.Error:
                return True

    # ---------------------------------------------------------------- tests

    ## The tests a declaration named `name` declares, with their names
    ## (stage 0's `tests_of::cases`): `test "name" for x, y in [(1, 2), (3,
    ## 4)]:` over a list written out is one test per element, whose body
    ## starts by binding the pattern to the element; over a list computed
    ## some other way, one test whose body is a `for` over it.
    pure def test_cases(
        mut self, module: ModuleId, name: str, t: TestDef
    ) -> list[(String, TestDef)]:
        var pat = PatternId(index=0)
        var list = ExprId(index=0)
        match t.cases:
            case Some((p, l)):
                pat = p
                list = l
            case None:
                return [(name.to_string(), t.copy())]
        let pat_node = self.ast(module).pattern(pat).node
        var out: list[(String, TestDef)] = []
        match self.ast(module).expr(list).kind.copy():
            case ExprKind.List(elems):
                for k in range(len(elems)):
                    let e = elems[k]
                    let at = self.ast(module).expr(e).range
                    let bind = Stmt(
                        node=pat_node,
                        range=at,
                        kind=StmtKind.Let(
                            mutable=False, pat=pat, ty=None, init=Some(e), else_=None
                        ),
                    )
                    let first = self.sources[module.index].ast.add_stmt(bind)
                    # Each case is named after its element as written.
                    var shown = "?".to_string()
                    if self.is_root(module):
                        shown = self.text_in(module, at)
                    out.push(("{name} {shown}", self.case_def(t, first, False)))
            case _:
                # `for PAT in LIST:` around the body.
                let at = self.ast(module).expr(list).range
                let list_node = self.ast(module).expr(list).node
                var body = Block(node=list_node, range=at, stmts=[])
                if let Some(b) = t.body:
                    body = b.copy()
                let body_range = body.range
                let looped = Stmt(
                    node=list_node,
                    range=body_range,
                    kind=StmtKind.For(pat=pat, mode=Mode.Borrow, iter=list, body=body),
                )
                let first = self.sources[module.index].ast.add_stmt(looped)
                out.push((name.to_string(), self.case_def(t, first, True)))
        return out

    ## A test `t` whose body starts with the statement `first` (and, when
    ## `alone`, is only that statement).
    pure def case_def(self, t: TestDef, first: StmtId, alone: bool) -> TestDef:
        var body: Block? = None
        if let Some(b) = t.body:
            var stmts = [first]
            if not alone:
                for s in b.stmts:
                    stmts.push(s)
            body = Some(Block(node=b.node, range=b.range, stmts=stmts))
        return TestDef(
            name=t.name.copy(),
            name_range=t.name_range,
            cases=None,
            params=t.params.copy(),
            body=body,
            fixtures=t.fixtures.copy(),
        )

    # ---------------------------------------------------------------- associated constants

    ## An associated constant of a type (03), named `Type.NAME`.
    pure def declare_assoc_const(mut self, module: ModuleId, key: TyKey, owner: str, c: ConstDef):
        let info = ConstInfo(ty=Ty.error(), value=None, value_module=None, terms=[])
        let name = "{owner}.{c.name.text}"
        let def_ = self.new_def(module, name, c.name.range, Vis.Pub, DefKind.Const(info))
        let k = (key, c.name.text.copy())
        if self.prog.assoc_consts.contains(k.copy()) or self.prog.methods.contains(k.copy()):
            let at = c.name.range
            var d = Diagnostic.new(Msg.ResolveDuplicateMethod, at.start, at.end).with(
                "owner", owner
            )
            self.report_other(module, d.with("name", c.name.text))
            return
        _ = self.prog.assoc_consts.insert(k, def_)
        self.pending.push(Pending.Const(def_=def_, module=module, ast=c.copy()))

    # ---------------------------------------------------------------- functions the compiler writes

    ## `invariant e` lines (07): a method of the struct that checks them,
    ## `pure def __check_invariant(self)`, whose body is the lines; and the
    ## invariant as a `bool`, `pure def __invariant(self) -> bool`, which
    ## reports nothing of its own.
    pure def declare_invariant(mut self, module: ModuleId, def_: DefId, node: int, s: StructDef):
        let range = s.invariants[0].range
        var stmts: list[StmtId] = []
        for c in s.invariants:
            let st = Stmt(node=node, range=c.range, kind=StmtKind.Contract(c.copy()))
            stmts.push(self.sources[module.index].ast.add_stmt(st))
        let body = Block(node=node, range=range, stmts=stmts)
        let check = self.written_fn(node, range, "__check_invariant", body, None, True)
        let m = self.new_def(
            module,
            "__check_invariant",
            range,
            Vis.Private,
            DefKind.Fn(self.placeholder_fn(FnKind.Method)),
        )
        _ = self.special_kinds.insert(m, FnKind.Invariant(def_))
        self.pending.push(
            Pending.Fn(def_=m, module=module, ast=check, owner=Some(Owner.Type(def_)))
        )
        var cond: ExprId? = None
        for c in s.invariants:
            let at = self.sources[module.index].ast.expr(c.expr).range
            let part = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=at, kind=ExprKind.Paren(c.expr))
            )
            match cond:
                case None:
                    cond = Some(part)
                case Some(l):
                    let both = Expr(
                        node=node, range=range, kind=ExprKind.Binary(op=BinOp.And, lhs=l, rhs=part)
                    )
                    cond = Some(self.sources[module.index].ast.add_expr(both))
        var whole = ExprId(index=0)
        match cond:
            case Some(c):
                whole = c
            case None:
                let t = Expr(node=node, range=range, kind=ExprKind.Name("True".to_string()))
                whole = self.sources[module.index].ast.add_expr(t)
        let holds = self.predicate_fn(module, node, whole, "__invariant", True)
        let h = self.new_def(
            module,
            "__invariant",
            range,
            Vis.Private,
            DefKind.Fn(self.placeholder_fn(FnKind.Method)),
        )
        _ = self.quiet_fns.add(h)
        self.pending.push(
            Pending.Fn(def_=h, module=module, ast=holds, owner=Some(Owner.Type(def_)))
        )

    ## `pure def name(self) -> bool: return pred`, written for a predicate.
    pure def predicate_fn(
        mut self, module: ModuleId, node: int, pred: ExprId, name: str, internal: bool
    ) -> FnDef:
        let range = self.sources[module.index].ast.expr(pred).range
        let ret_ty = TypeExpr(
            node=node,
            range=range,
            kind=TypeKind.Path(segments=[Name(text="bool".to_string(), range=range)], args=[]),
        )
        let ret = self.sources[module.index].ast.add_type(ret_ty)
        let st = Stmt(node=node, range=range, kind=StmtKind.Return(Some(pred)))
        let body = Block(
            node=node, range=range, stmts=[self.sources[module.index].ast.add_stmt(st)]
        )
        return self.written_fn(node, range, name, body, Some(ret), internal)

    ## A `pure` method of `self` the compiler writes, with a body; an
    ## `internal` one only the compiler's checks call.
    pure def written_fn(
        self,
        node: int,
        range: TextRange,
        name: str,
        own body: Block,
        ret: TypeExprId?,
        internal: bool,
    ) -> FnDef:
        var attrs: list[Attr] = []
        if internal:
            attrs.push(Attr(name="internal".to_string(), args=[], range=range))
        return FnDef(
            node=node,
            range=range,
            name=Name(text=name.to_string(), range=range),
            is_pure=True,
            is_comptime=False,
            is_unsafe=False,
            generics=[],
            params=[Param(node=node, range=range, mode=Mode.Borrow, kind=ParamKind.SelfParam)],
            ret=ret,
            from_=[],
            where_=[],
            body=Some(body),
            attrs=attrs,
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )

    ## A refinement type's predicate as a function the compiler writes:
    ## `def where(self) -> bool: return pred`, `pure`, with `self` a value
    ## of the base.
    pure def declare_predicate(
        mut self, module: ModuleId, def_: DefId, node: int, a: TypeAlias, range: TextRange
    ):
        var pred = ExprId(index=0)
        match a.predicate:
            case Some(p):
                pred = p
            case None:
                pred = self.sources[module.index].ast.add_expr(
                    Expr(node=node, range=range, kind=ExprKind.Error)
                )
        let f = self.predicate_fn(module, node, pred, "where", False)
        let at = self.sources[module.index].ast.expr(pred).range
        let pd = self.new_def(
            module, "where", at, Vis.Private, DefKind.Fn(self.placeholder_fn(FnKind.Free))
        )
        _ = self.special_kinds.insert(pd, FnKind.Predicate(def_))
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Refinement(r) = ref mut kind_now:
            r.predicate = Some(pd)
        self.prog.defs[def_.index].set_kind(kind_now)
        self.pending.push(
            Pending.Fn(def_=pd, module=module, ast=f, owner=Some(Owner.Refinement(def_)))
        )

    # ---------------------------------------------------------------- derived impls

    ## The traits a struct's `@delegate` forwards, with where each is
    ## named, after checking the attribute (stage 0's `delegations`).
    pub pure def delegations(
        mut self,
        module: ModuleId,
        attrs: list[Attr],
        ty: str,
        is_struct: bool,
        fields: list[String],
    ) -> list[(String, String, TextRange)]:
        var out: list[(String, String, TextRange)] = []
        for a in attrs:
            if a.name != "delegate":
                continue
            var field: String? = None
            var to_at: TextRange? = None
            for arg in a.args:
                if let Some(n) = arg.name:
                    if n.text == "to" and to_at.is_none():
                        to_at = Some(arg.range)
                        if let ExprKind.Str(parts) = self.ast(module).expr(arg.value).kind:
                            field = Some(build.plain_text(parts))
            var ok = False
            var to = String.new()
            if let Some(f) = field:
                ok = is_struct and fields.contains(f)
                to = f.copy()
            if not ok:
                let at = to_at ?? a.range
                let d = Diagnostic.new(Msg.ResolveDelegateTo, at.start, at.end).with("ty", ty)
                self.report_other(module, d)
                continue
            for arg in a.args:
                if arg.name.is_some():
                    continue
                var n = String.new()
                if let ExprKind.Name(x) = self.ast(module).expr(arg.value).kind:
                    n = x.copy()
                if not delegable(n):
                    let shown = self.text_in(module, arg.range)
                    var d = Diagnostic.new(Msg.ResolveNotDelegable, arg.range.start, arg.range.end)
                    self.report_other(module, d.with("name", shown))
                    continue
                if returns_self(n) and len(fields) != 1:
                    var d = Diagnostic.new(Msg.ResolveDelegateSelf, arg.range.start, arg.range.end)
                    d = d.with("trait", n).with("ty", ty).with("field", to)
                    self.report_other(module, d)
                    continue
                var seen = False
                for (t, _, _) in out:
                    if t == n:
                        seen = True
                if not seen:
                    out.push((n, to.copy(), arg.range))
        return out

    ## Whether `items` has its own `impl trait_name for ty`.
    pub pure def has_impl(
        self, module: ModuleId, items: list[ItemId], trait_name: str, ty: str
    ) -> bool:
        for id in items:
            if let ItemKind.Impl(i) = self.ast(module).item(id).kind:
                let t = i.trait_ty else:
                    continue
                if self.last_segment(module, t) == Some(trait_name.to_string())
                        and self.last_segment(module, i.self_ty) == Some(ty.to_string()):
                    return True
        return False

    pure def last_segment(self, module: ModuleId, te: TypeExprId) -> String?:
        if let TypeKind.Path(segments, _) = self.ast(module).type_expr(te).kind:
            if let Some(s) = segments.last():
                return Some(s.text.copy())
        return None

    ## Whether each generic parameter is named in one of the field types:
    ## one that is not (`Key[T]`'s `T`) needs no bound in a derived impl.
    pub pure def used_params(
        self, module: ModuleId, gps: list[GenericParam], tys: list[TypeExprId]
    ) -> list[bool]:
        var names: list[String] = []
        for t in tys:
            self.type_names(module, t, mut names)
        var out: list[bool] = []
        for g in gps:
            out.push(names.contains(g.name.text))
        return out

    pure def type_names(self, module: ModuleId, t: TypeExprId, mut names: list[String]):
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Path(segments, args):
                if let Some(s) = segments.first():
                    names.push(s.text.copy())
                for a in args:
                    self.type_names(module, a, mut names)
            case TypeKind.Option(i):
                self.type_names(module, i, mut names)
            case TypeKind.Dyn(i):
                self.type_names(module, i, mut names)
            case TypeKind.Ref(_, inner):
                self.type_names(module, inner, mut names)
            case TypeKind.Result(ok, err):
                if let Some(o) = ok:
                    self.type_names(module, o, mut names)
                if let Some(e) = err:
                    self.type_names(module, e, mut names)
            case TypeKind.Tuple(es):
                for (_, e) in es:
                    self.type_names(module, e, mut names)
            case TypeKind.Fn(_, params, ret):
                for p in params:
                    self.type_names(module, p, mut names)
                self.type_names(module, ret, mut names)
            case TypeKind.Union(us):
                for u in us:
                    self.type_names(module, u, mut names)
            case _:
                pass

    # ---------------------------------------------------------------- checks of impls

    ## The checks of the impls from the definition `first` on, once every
    ## impl is known (stage 0's `check_traits`): an impl's method is as
    ## `pure` as the trait's; an impl of the root module without one of the
    ## trait's required methods is an error stage 0 reports; and
    ## `@derive(Copy)` holds only for a type whose fields are `Copy`.
    pure def check_traits(mut self, first: int):
        let impls = self.prog.impls.copy()
        for i in impls:
            if i.index < first:
                continue
            let info = self.prog.impl_info(i) else:
                continue
            let tr = info.trait_ref.def_
            let methods = info.methods.copy()
            let derived = info.derived
            let bound_assoc = info.assoc.copy()
            let self_ty = info.self_ty
            let trait_args = info.trait_ref.args.copy()
            let predicates = info.predicates.copy()
            let tinfo = self.prog.trait_info(tr) else:
                continue
            let trait_methods = tinfo.methods.copy()
            let sealed = tinfo.sealed
            let declared_assoc = tinfo.assoc.copy()
            let supertraits = tinfo.supertraits.copy()
            let module = self.prog.defs[i.index].module
            let span = self.prog.defs[i.index].span
            let trait_name = self.prog.display_trait_in(self.types, info.trait_ref, [])
            var names: list[String] = []
            for g in info.generics:
                names.push(g.name.copy())
            let n_generics = len(info.generics)
            let ty_name = self.prog.display_in(self.types, self_ty, names)
            # Only std implements a sealed trait.
            if sealed and not self.is_std(module):
                var d = Diagnostic.new(Msg.ResolveSealedTrait, span.start, span.end)
                self.report_other(module, d.with("trait", trait_name).with("ty", ty_name))
                continue
            # The orphan rule: an impl lives in the package of the trait or of
            # the type, except in the root package, which nothing depends on
            # (`resolve.orphan-impl`).
            let package = self.prog.package_of(module)
            if package != 0 and not self.is_std(module):
                let trait_pkg = self.prog.package_of(self.prog.defs[tr.index].module)
                var type_pkg = -1
                if let TyData.Adt(d, _) = self.types.data(self_ty):
                    type_pkg = self.prog.package_of(self.prog.defs[d.index].module)
                if trait_pkg != package
                        and type_pkg != package
                        and not self.local_argument(package, self_ty, trait_args):
                    var d = Diagnostic.new(Msg.ResolveOrphanImpl, span.start, span.end)
                    d = d.with("trait", trait_name).with("ty", ty_name)
                    let ps = [
                        MsgParam(
                            name="trait".to_string(), value=self.prog.defs[tr.index].name.copy()
                        ),
                        MsgParam(name="ty".to_string(), value=ty_name.copy()),
                    ]
                    self.report_other(module, d.note_params(Msg.ResolveOrphanLocalType, ps))
            # An associated type the impl does not bind is reported below;
            # the signatures that name it would only repeat that.
            var assoc_missing = False
            for a in declared_assoc:
                if a.default.is_none():
                    var bound = False
                    for (n, _) in bound_assoc:
                        if n == a.name:
                            bound = True
                    if not bound:
                        assoc_missing = True
            let method_env = self.prog.elaborate_env(mut self.types, predicates)
            for (mname, mdef) in methods:
                let given_const = self.is_assoc_const(mdef)
                let tm = self.prog.trait_method(tr, mname) else:
                    let s = self.prog.defs[mdef.index].span
                    let m = if given_const: Msg.ResolveNotATraitConstant else: Msg.ResolveNotATraitMethod
                    var d = Diagnostic.new(m, s.start, s.end)
                    # A misspelt constant, `WARMUP` for the trait's
                    # `WARM_UP`: the trait's constant with a similar name
                    # (RULES.md, R97).
                    if given_const:
                        var constants: list[String] = []
                        if let Some(info) = self.prog.trait_info(tr):
                            for c in info.methods:
                                if self.is_assoc_const(c):
                                    constants.push(self.prog.defs[c.index].name.copy())
                        if let Some(similar) = self.prog.closest(mname, constants):
                            d = d.fix(
                                Msg.ResolveSimilarName, "name", similar, s.start, s.end, similar
                            )
                    self.report_other(module, d.with("name", mname).with("trait", trait_name))
                    continue
                # A constant is given as a constant and a method as a method
                # (RULES.md, R37); a constant has the trait's type.
                if given_const != self.is_assoc_const(tm):
                    let s = self.prog.defs[mdef.index].span
                    var d = Diagnostic.new(Msg.ResolveConstOrMethod, s.start, s.end)
                    d = d.with("name", mname).with("trait", trait_name)
                    if given_const:
                        d = d.with("what", "a method").with("given", "a constant")
                    else:
                        d = d.with("what", "a constant").with("given", "a method")
                    self.report_other(module, d)
                    continue
                if given_const:
                    let tref = TraitRef(def_=tr, args=trait_args.copy())
                    self.check_const_type(module, tm, mdef, tref, self_ty, method_env, names)
                    continue
                var tpure = False
                if let Some(f) = self.prog.fn_info(tm):
                    tpure = f.pure
                # An impl's method is `unsafe def` exactly when the trait's
                # is (22): its callers take the trait's obligations.
                let tref = TraitRef(def_=tr, args=trait_args.copy())
                self.check_unsafe_method(module, tm, mdef, tref, self_ty, names)
                if not assoc_missing and not derived and self.is_root(module):
                    self.check_method_types(module, tm, mdef, tref, self_ty, method_env)
                if tpure:
                    var kind_now = self.prog.defs[mdef.index].kind().copy()
                    if let DefKind.Fn(f) = ref mut kind_now:
                        f.pure = True
                    self.prog.defs[mdef.index].set_kind(kind_now)
            # A derived or delegated impl's are checked at its attribute
            # (`check_derives`).
            if derived
                    or self.prog.modules[module.index].name.starts_with("<delegate>/")
                    or not self.is_root(module):
                continue
            # Each associated type the trait declares without a default is
            # bound (`resolve.missing-assoc-type`).
            for a in declared_assoc:
                if a.default.is_some():
                    continue
                var bound = False
                for (n, _) in bound_assoc:
                    if n == a.name:
                        bound = True
                if not bound:
                    var d = Diagnostic.new(Msg.ResolveMissingAssocType, span.start, span.end)
                    d = d.with("trait", trait_name).with("ty", ty_name).with("name", a.name)
                    self.report_other(module, d)
                    # The type is the error's from here on, so that a use of
                    # it is not reported again (RULES.md, R104).
                    var kind_now = self.prog.defs[i.index].kind().copy()
                    if let DefKind.Impl(ii) = ref mut kind_now:
                        ii.assoc.push((a.name.copy(), Ty.error()))
                    self.prog.defs[i.index].set_kind(kind_now)
            # Implementing `Container(Len)` needs `Len` too
            # (`resolve.supertrait-missing`).
            var targs = [self_ty]
            for x in trait_args:
                targs.push(x)
            let env = self.prog.elaborate_env(mut self.types, predicates)
            for s in supertraits:
                var sargs: list[Ty] = []
                for x in s.args:
                    sargs.push(self.types.subst(x, targs))
                let st = TraitRef(def_=s.def_, args=sargs)
                if self.prog.implements(mut self.types, self_ty, st, env) == Answer.No:
                    let shown = self.prog.display_trait_in(self.types, st, names)
                    var d = Diagnostic.new(Msg.ResolveSupertraitMissing, span.start, span.end)
                    d = d.with("ty", ty_name).with("trait", trait_name).with("super", shown)
                    self.report_other(module, d)
            var missing: list[DefId] = []
            for m in trait_methods:
                let f = self.prog.fn_info(m) else:
                    continue
                # A body that is the method's contract alone is no default
                # (RULES.md, R29).
                var provided = f.body.is_some()
                let tm = self.prog.defs[m.index].module
                if let Some(b) = f.body:
                    if not self.is_std(tm) and contract_only(self.ast(tm), b):
                        provided = False
                if provided or f.intrinsic.is_some() or f.header_broken:
                    continue
                var found = False
                for (n, _) in methods:
                    if n == self.prog.defs[m.index].name:
                        found = True
                if not found:
                    missing.push(m)
            if not missing.is_empty():
                var listed = String.new()
                for m in missing:
                    if not listed.is_empty():
                        listed.push(", ")
                    listed.push("`{self.prog.defs[m.index].name}`")
                var d = Diagnostic.new(Msg.ResolveMissingTraitMethod, span.start, span.end)
                d = d.with("trait", trait_name).with("ty", ty_name).with("methods", listed)
                # Each with the signature the impl must write.
                for m in missing:
                    let found = self.prog.fn_info(m) else:
                        continue
                    let f = found.copy()
                    let name = self.prog.defs[m.index].name.copy()
                    var args = targs.copy()
                    for k in range(max(len(f.generics) - f.impl_generics, 0)):
                        args.push(self.types.param(n_generics + k))
                    var signature = self.signature_text(name, f, Some(args.copy()), env, names)
                    if f.assoc_const:
                        let declared = self.types.subst(f.ret, args)
                        let ty = self.prog.normalize(mut self.types, declared, env)
                        signature = "const {name}: {self.prog.display_in(self.types, ty, names)} = ..."
                    d = d.note_with(Msg.ResolveWriteTraitMethod, "signature", signature)
                self.report_other(module, d)
        let checks = self.copy_checks.copy()
        self.copy_checks = []
        for (d, at) in checks:
            self.check_copy_fields(d, at)
        self.check_trait_cycles(first)
        self.check_coherence(first)
        self.check_object_safety()
        self.check_derives(first)

    ## A trait that is its own supertrait through others, `trait A(B)` and
    ## `trait B(A)`, is `E0247` as one that names itself is (RULES.md, R43):
    ## each trait from the definition `first` on whose supertraits lead
    ## back to it, at its name.
    pure def check_trait_cycles(mut self, first: int):
        for i in range(first, len(self.prog.defs)):
            let t = DefId(index=i)
            let info = self.prog.trait_info(t) else:
                continue
            var seen: list[DefId] = []
            var todo: list[DefId] = []
            for s in info.supertraits:
                # A trait that names itself was reported where it is named.
                if s.def_ != t:
                    todo.push(s.def_)
            var cycle = False
            while let Some(x) = todo.pop():
                if x == t:
                    cycle = True
                    break
                if seen.contains(x):
                    continue
                seen.push(x)
                if let Some(xi) = self.prog.trait_info(x):
                    for s in xi.supertraits:
                        todo.push(s.def_)
            if not cycle:
                continue
            let module = self.prog.defs[i].module
            let at = self.prog.defs[i].span
            let d = Diagnostic.new(Msg.ResolveTraitCycle, at.start, at.end)
            self.report_other(module, d.with("name", self.prog.defs[i].name))

    ## At most one impl of a trait for any type (D-013): each impl from
    ## `first` on against the earlier ones of its trait
    ## (`resolve.overlapping-impl`). Two headers whose self types have
    ## different outermost constructors cannot overlap; the others are
    ## unified, each impl's parameters apart from the other's.
    pure def check_coherence(mut self, first: int):
        let impls = self.prog.impls.copy()
        for k in range(len(impls)):
            let a = impls[k]
            # The standard library's impls do not overlap.
            if a.index < first or self.is_std(self.prog.defs[a.index].module):
                continue
            let found_a = self.prog.impl_info(a) else:
                continue
            let ia = found_a.copy()
            let ha = self.header(ia.self_ty, ia.trait_ref.args)
            let na = len(ia.generics)
            let ta = ia.trait_ref.def_
            # The earlier impls of its trait, in their order among all the
            # impls (`Program.impls_of`, which lists them as they come).
            var earlier: list[DefId] = []
            if let Some(of_trait) = self.prog.impls_of.get(ta):
                for b in of_trait:
                    if b.index == a.index:
                        break
                    earlier.push(b)
            for b in earlier:
                let found_b = self.prog.impl_info(b) else:
                    continue
                let ib = found_b.copy()
                let oa = outermost(self.types, ia.self_ty)
                let ob = outermost(self.types, ib.self_ty)
                if oa.is_some() and ob.is_some() and oa != ob:
                    continue
                let hb = self.header(ib.self_ty, ib.trait_ref.args)
                let shifted = self.shift_params(hb, na)
                var binds: list[Ty?] = []
                for _ in range(na + len(ib.generics)):
                    binds.push(None)
                if self.unify_patterns(ha, shifted, mut binds):
                    let module = self.prog.defs[a.index].module
                    var names: list[String] = []
                    for g in ia.generics:
                        names.push(g.name.copy())
                    let at = self.prog.defs[a.index].span
                    let first_at = self.prog.defs[b.index].span
                    var d = Diagnostic.new(Msg.ResolveOverlappingImpl, at.start, at.end)
                    d = d.with("trait", self.prog.display_trait_in(self.types, ia.trait_ref, names))
                    d = d.with("ty", self.prog.display_in(self.types, ia.self_ty, names))
                    let first_module = self.prog.defs[b.index].module
                    if first_module == module:
                        d = d.label(Msg.ResolveFirstImpl, first_at.start, first_at.end)
                    else:
                        # The first impl is in another file.
                        let (s, e) = (first_at.start, first_at.end)
                        d = d.label_in(Msg.ResolveFirstImpl, s, e, first_module.index)
                    self.report_other(module, d)
                    break

    ## An impl's header as one type: its self type and its trait's
    ## arguments.
    pure def header(mut self, self_ty: Ty, args: list[Ty]) -> Ty:
        var es = [self_ty]
        for x in args:
            es.push(x)
        return self.types.tuple(es)

    pure def shift_params(mut self, t: Ty, by: int) -> Ty:
        match self.types.data(t).copy():
            case TyData.Param(i):
                return self.types.param(i + by)
            case TyData.Adt(d, a):
                var out: list[Ty] = []
                for x in a:
                    out.push(self.shift_params(x, by))
                return self.types.adt(d, out)
            case TyData.Tuple(e, l):
                var out: list[Ty] = []
                for x in e:
                    out.push(self.shift_params(x, by))
                return self.types.intern(TyData.Tuple(elems=out, labels=l))
            case TyData.Ref(x, m):
                let s = self.shift_params(x, by)
                return self.types.ref_(s, m)
            case TyData.Fn(ps, r, pure):
                var out: list[Ty] = []
                for x in ps:
                    out.push(self.shift_params(x, by))
                let rr = self.shift_params(r, by)
                return self.types.fn_(out, rr, pure)
            case TyData.Dyn(tr):
                var out: list[Ty] = []
                for x in tr.args:
                    out.push(self.shift_params(x, by))
                return self.types.intern(TyData.Dyn(TraitRef(def_=tr.def_, args=out)))
            case _:
                return t

    ## A type with each bound parameter replaced by what it is bound to.
    pure def resolve_bind(self, t: Ty, binds: list[Ty?]) -> Ty:
        var cur = t
        for _ in range(64):
            let TyData.Param(i) = self.types.data(cur) else:
                return cur
            if i >= len(binds):
                return cur
            let b = binds[i] else:
                return cur
            cur = b
        return cur

    ## Two-way unification of patterns whose parameters are all variables.
    pure def unify_patterns(self, x: Ty, y: Ty, mut binds: list[Ty?]) -> bool:
        let a = self.resolve_bind(x, binds)
        let b = self.resolve_bind(y, binds)
        let da = self.types.data(a).copy()
        let db = self.types.data(b).copy()
        if let TyData.Param(i) = da:
            if let TyData.Param(j) = db:
                if i == j:
                    return True
            if i < len(binds):
                binds[i] = Some(b)
                return True
        if let TyData.Param(j) = db:
            if j < len(binds):
                binds[j] = Some(a)
                return True
        match da:
            case TyData.Assoc(_, _, _):
                return True
            case _:
                pass
        if let TyData.Assoc(_, _, _) = db:
            return True
        match da:
            case TyData.Adt(d1, a1):
                let TyData.Adt(d2, a2) = db else:
                    return False
                return d1 == d2 and self.unify_all(a1, a2, mut binds)
            case TyData.Tuple(e1, _):
                let TyData.Tuple(e2, _) = db else:
                    return False
                return self.unify_all(e1, e2, mut binds)
            case TyData.Ref(x1, m1):
                let TyData.Ref(x2, m2) = db else:
                    return False
                return m1 == m2 and self.unify_patterns(x1, x2, mut binds)
            case TyData.Fn(p1, r1, _):
                let TyData.Fn(p2, r2, _) = db else:
                    return False
                return self.unify_all(p1, p2, mut binds) and self.unify_patterns(r1, r2, mut binds)
            case TyData.Dyn(t1):
                let TyData.Dyn(t2) = db else:
                    return False
                return t1.def_ == t2.def_ and self.unify_all(t1.args, t2.args, mut binds)
            case _:
                return a == b

    pure def unify_all(self, xs: list[Ty], ys: list[Ty], mut binds: list[Ty?]) -> bool:
        if len(xs) != len(ys):
            return False
        for k in range(len(xs)):
            if not self.unify_patterns(xs[k], ys[k], mut binds):
                return False
        return True

    ## The traits written as `dyn T` that cannot be (`resolve.not-object-safe`):
    ## a method without `self` by reference, with type parameters of its
    ## own, or mentioning `Self` besides its receiver.
    pure def check_object_safety(mut self):
        let uses = self.dyn_uses.copy()
        self.dyn_uses = []
        var seen: list[(DefId, ModuleId, TextRange)] = []
        for (t, m, at) in uses:
            if seen.contains((t, m, at)):
                continue
            seen.push((t, m, at))
            if let Some((method, reason)) = self.object_safety_problem(t):
                var d = Diagnostic.new(Msg.ResolveNotObjectSafe, at.start, at.end)
                d = d.with("trait", self.prog.defs[t.index].name).with("method", method)
                self.report_other(m, d.with("reason", reason))

    ## Why a trait cannot be `dyn`, if it cannot: the method, and the
    ## reason.
    pure def object_safety_problem(mut self, t: DefId) -> (String, String)?:
        return self.prog.object_safety_problem(mut self.types, t)

    ## `@derive(Copy)` only for a type whose fields are all `Copy` (03); a
    ## field of a type parameter's type is, since the type is `Copy` only
    ## for `Copy` arguments.
    pure def check_copy_fields(mut self, d: DefId, at: TextRange):
        var fields: list[(String, Ty)] = []
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(s):
                for f in s.fields:
                    fields.push((f.name.copy(), f.ty))
            case DefKind.Enum(e):
                for v in e.variants:
                    var k = 0
                    for (n, t) in v.fields:
                        let shown = n.copy() ?? "{k}"
                        fields.push(("{v.name}.{shown}", t))
                        k += 1
            case _:
                return
        var generics: list[String] = []
        for g in self.prog.type_generics(d):
            generics.push(g.name.copy())
        var as_copy: list[Ty] = []
        for _ in range(len(generics)):
            as_copy.push(Ty.int())
        for (fname, fty) in fields:
            if self.types.contains_error(fty):
                continue
            let t = self.types.subst(fty, as_copy)
            if self.prog.is_copy(mut self.types, t):
                continue
            var diag = Diagnostic.new(Msg.ResolveDeriveField, at.start, at.end)
            diag = diag.with("ty", self.prog.defs[d.index].name).with("trait", "Copy")
            diag = diag.with("field", fname).with(
                "fty", self.prog.display_in(self.types, fty, generics)
            )
            self.report_other(self.prog.defs[d.index].module, diag)
            var kind_now = self.prog.defs[d.index].kind().copy()
            match ref mut kind_now:
                case DefKind.Struct(s):
                    s.copy = False
                case DefKind.Enum(e):
                    e.copy = False
                case _:
                    pass
            self.prog.defs[d.index].set_kind(kind_now)
            return

    # ---------------------------------------------------------------- headers and bounds

    ## The generic parameters of every struct, enum and trait, with their
    ## defaults, then the bounds of the parameters of structs and enums.
    pure def resolve_headers(mut self):
        var ints: list[int] = []
        for d in self.type_params.keys():
            if not self.headers_done.contains(d):
                ints.push(d.index)
        ints.sort()
        for i in ints:
            _ = self.headers_done.add(DefId(index=i))
        for i in ints:
            let d = DefId(index=i)
            let gps = self.params_of(d)
            let module = self.prog.defs[i].module
            var is_trait = False
            if let DefKind.Trait(_) = self.prog.defs[i].kind():
                is_trait = True
            var names: list[String] = []
            if is_trait:
                names.push("Self".to_string())
            var generics: list[Generic] = []
            var seen_default = False
            for g in gps:
                var default: Ty? = None
                if let Some(t) = g.default:
                    seen_default = True
                    var ctx = TyCtx.plain(module, names, True)
                    if is_trait:
                        ctx.self_ty = Some(self.types.param(0))
                    default = Some(self.resolve_ty(t, ctx))
                elif seen_default:
                    let at = g.name.range
                    let diag = Diagnostic.new(Msg.ResolveGenericDefaultOrder, at.start, at.end)
                    self.report_other(module, diag)
                names.push(g.name.text.copy())
                generics.push(
                    Generic(name=g.name.text.copy(), default=default, is_const=g.is_const)
                )
            # A builtin collection's allocator at its default is left out of
            # its types (RULES.md, R227).
            if allocated(self.prog.defs[i].name) and self.prog.defs[i].module == self.prog.prelude:
                if let Some(last) = generics.last():
                    if let Some(t) = last.default:
                        self.types.intern_default(d, len(generics), t)
            var kind_now = self.prog.defs[i].kind().copy()
            match ref mut kind_now:
                case DefKind.Struct(s):
                    s.generics = generics
                case DefKind.Enum(e):
                    e.generics = generics
                case DefKind.ErrorSet(e):
                    e.generics = generics
                case DefKind.Trait(t):
                    t.generics = generics
                case DefKind.Refinement(r):
                    r.generics = generics
                case _:
                    pass
            self.prog.defs[i].set_kind(kind_now)
        for i in ints:
            let d = DefId(index=i)
            if let DefKind.Trait(_) = self.prog.defs[i].kind():
                continue
            let gps = self.params_of(d)
            let module = self.prog.defs[i].module
            var names: list[String] = []
            for g in gps:
                names.push(g.name.text.copy())
            let preds = self.resolve_bounds(module, gps, names, 0, None)
            _ = self.type_preds.insert(d, preds)

    ## The bounds of the generic parameters `gps`, which are the names from
    ## `offset` on in `names`, as predicates on `Param(offset + i)`.
    pure def resolve_bounds(
        mut self,
        module: ModuleId,
        gps: list[GenericParam],
        names: list[String],
        offset: int,
        in_trait: DefId?,
    ) -> list[Predicate]:
        var out: list[Predicate] = []
        for k in range(len(gps)):
            let g = ref gps[k]
            let subject = self.types.param(offset + k)
            # A `const` parameter's "bound" is its type, which is `int` in
            # stage 0.
            if g.is_const:
                for b in g.bounds:
                    var is_int = False
                    if let TypeKind.Path(segments, args) = self.ast(module).type_expr(b).kind:
                        if args.is_empty() and len(segments) == 1:
                            is_int = segments[0].text == "int" or segments[0].text == "i64"
                    if not is_int:
                        let at = self.ast(module).type_expr(b).range
                        let shown = "a `const` parameter of a type other than `int`"
                        self.unsupported_in(
                            module, at, shown, "const generics over other types (Phase 4)"
                        )
                continue
            for b in g.bounds:
                var ctx = TyCtx.plain(module, names, True)
                ctx.predicates = out.copy()
                ctx.in_trait = in_trait
                if let Some(tr) = self.resolve_bound(b, subject, ctx):
                    out.push(
                        Predicate(ty=subject, bound=tr, span=self.ast(module).type_expr(b).range)
                    )
        return out

    ## A trait named in a bound, a supertraits list or an impl header, for
    ## `subject` (which a defaulted parameter `Rhs = Self` takes).
    pure def resolve_bound(mut self, te: TypeExprId, subject: Ty, ctx: TyCtx) -> TraitRef?:
        let written = self.ast(ctx.module).type_expr(te).copy()
        let at = written.range
        let TypeKind.Path(segments, args) = written.kind else:
            if let TypeKind.Error = written.kind:
                return None
            let d = Diagnostic.new(Msg.ResolveNotATrait, at.start, at.end)
            self.report_other(ctx.module, d.with("name", self.text_in(ctx.module, at)))
            return None
        let d = self.lookup_path(segments, ctx, at) else:
            return None
        var words: list[String] = []
        for s in segments:
            words.push(s.text.copy())
        let name = words.join(".")
        let info = self.prog.trait_info(d) else:
            let diag = Diagnostic.new(Msg.ResolveNotATrait, at.start, at.end)
            self.report_other(ctx.module, diag.with("name", name))
            return None
        let generics = info.generics.copy()
        # A deprecated trait named in a bound, an impl's header, a
        # supertraits list or a `dyn` type (RULES.md, R51).
        let last = segments[len(segments) - 1].range
        self.deprecated_type_use(d, ctx.module, TextRange.new(at.start, last.end))
        var targs: list[Ty] = []
        for a in args:
            targs.push(self.resolve_ty(a, ctx))
        if len(targs) > len(generics):
            self.argument_count(ctx.module, at, name, len(generics), len(targs))
            return None
        # Omitted trailing arguments take their defaults, `Self` being the
        # subject.
        while len(targs) < len(generics):
            let default = generics[len(targs)].default else:
                self.argument_count(ctx.module, at, name, len(generics), len(targs))
                return None
            var env = [subject]
            for t in targs:
                env.push(t)
            targs.push(self.types.subst(default, env))
        return Some(TraitRef(def_=d, args=targs))

    ## A possibly qualified name (`cli.Error`) as a definition, written at
    ## `span`, reporting what cannot be found (a first name that names
    ## nothing is the name pass's, in the program's own modules).
    pure def lookup_path(mut self, segments: list[Name], ctx: TyCtx, span: TextRange) -> DefId?:
        var module = ctx.module
        for i in range(len(segments)):
            let seg = ref segments[i]
            var found: DefId? = None
            if i == 0:
                found = self.prog.lookup(module, seg.text)
            else:
                # Through a module: only what it lets other modules see (09).
                if let Some((d, visible)) = self.prog.member(module, seg.text, ctx.module):
                    if not visible:
                        self.report_other(ctx.module, self.prog.private_item(d, module, seg.range))
                    found = Some(d)
            let d = found else:
                if i > 0:
                    let mname = self.prog.modules[module.index].name.copy()
                    var diag = Diagnostic.new(Msg.ResolveNotInModule, span.start, span.end)
                    self.report_other(ctx.module, diag.with("module", mname).with("name", seg.text))
                else:
                    self.undefined_type(ctx.module, seg.text, span)
                return None
            if i + 1 == len(segments):
                return Some(d)
            match self.prog.defs[d.index].kind():
                case DefKind.Module(m):
                    module = m
                case _:
                    let diag = Diagnostic.new(Msg.ResolveNotAModule, span.start, span.end)
                    self.report_other(ctx.module, diag.with("name", seg.text))
                    return None
        return None

    # ---------------------------------------------------------------- types

    pure def resolve_ty(mut self, te: TypeExprId, ctx: TyCtx) -> Ty:
        let written = self.ast(ctx.module).type_expr(te).copy()
        let range = written.range
        match written.kind:
            case TypeKind.Error:
                return Ty.error()
            case TypeKind.Path(segments, args):
                if len(args) == 1 and self.is_fake_marker(segments, ctx.module):
                    return self.fake_ty(args[0], ctx, range)
                var targs: list[Ty] = []
                for a in args:
                    targs.push(self.resolve_ty(a, ctx))
                let t = self.resolve_path_ty(segments, targs, ctx, range)
                self.written_ref_items(t, args, ctx)
                return t
            case TypeKind.Option(inner):
                let t = self.resolve_ty(inner, ctx)
                let o = self.prog.wk.option else:
                    return Ty.error()
                return self.types.adt(o, [t])
            case TypeKind.Result(ok, err):
                var ok_ty = Ty.unit()
                if let Some(o) = ok:
                    ok_ty = self.resolve_ty(o, ctx)
                var err_ty = Ty.error()
                match err:
                    case Some(e):
                        err_ty = self.resolve_error_set(e, ctx)
                    case None:
                        let d = Diagnostic.new(
                            Msg.ResolveInferredSetPosition, range.start, range.end
                        )
                        self.report_other(ctx.module, d)
                let r = self.prog.wk.result else:
                    return Ty.error()
                return self.types.adt(r, [ok_ty, err_ty])
            case TypeKind.Union(_):
                let d = Diagnostic.new(Msg.ResolveUnionOutsideResult, range.start, range.end)
                self.report_other(ctx.module, d)
                return Ty.error()
            case TypeKind.Tuple(elems):
                var tys: list[Ty] = []
                var labels: list[String] = []
                var all_named = not elems.is_empty()
                for (n, t) in elems:
                    tys.push(self.resolve_ty(t, ctx))
                    match n:
                        case Some(name):
                            labels.push(name.text.copy())
                        case None:
                            all_named = False
                if tys.is_empty():
                    return Ty.unit()
                if not all_named:
                    labels = []
                return self.types.intern(TyData.Tuple(elems=tys, labels=labels))
            case TypeKind.Fn(pure, params, ret):
                var ps: list[Ty] = []
                for p in params:
                    ps.push(self.resolve_ty(p, ctx))
                let r = self.resolve_ty(ret, ctx)
                return self.types.fn_(ps, r, pure)
            case TypeKind.Ref(mutable, inner):
                if not ctx.allow_ref:
                    self.beyond_in(ctx.module, "a reference type in a declaration")
                let t = self.resolve_ty(inner, ctx)
                # A shared borrow of a view is the view: `ref str` is a `str`.
                if t == Ty.str() and not mutable:
                    return Ty.str()
                return self.types.ref_(t, mutable)
            case TypeKind.Dyn(inner):
                match self.resolve_bound(inner, Ty.error(), ctx):
                    case Some(tr):
                        self.dyn_uses.push((tr.def_, ctx.module, range))
                        return self.types.intern(TyData.Dyn(tr))
                    case None:
                        return Ty.error()
            case TypeKind.ConstArg(n):
                return self.types.intern(TyData.Const(n))
            case TypeKind.ConstExpr(e):
                # Which generic parameters are `const` is checked in bodies;
                # a signature takes any parameter here.
                let ts = folding.terms(self.ast(ctx.module), e)
                let scope = ConstScope.signature(ctx.generics)
                let (t, err) = consts.const_arg(self.prog, mut self.types, ctx.module, ts, scope)
                if let Some(x) = err:
                    self.report_const(ctx.module, consts.diagnostic(x, Shared.get(self.catalog)))
                return t
            # `ptr mut T` (22): the mutable form of the `ptr` in scope, which
            # is `std.mem`'s.
            case TypeKind.PtrMut(ptr_name, inner):
                let t = self.resolve_ty(inner, ctx)
                let p = self.resolve_path_ty([ptr_name.copy()], [t], ctx, ptr_name.range)
                if let TyData.Adt(d, _) = self.types.data(p):
                    if let Some(m) = self.prog.ptr_mut_of(d):
                        return self.types.adt(m, [t])
                    let at = ptr_name.range
                    let found = "`{self.prog.display(self.types, p)}`"
                    var diag = Diagnostic.new(Msg.UnsafeNotPtr, at.start, at.end)
                    diag = diag.with("name", ptr_name.text).with("found", found)
                    self.report_other(ctx.module, diag.note(Msg.UnsafeImportPtr))
                return Ty.error()
            case TypeKind.Unsupported(what):
                var phase = "reflection beyond derive (Phase 8)"
                if what.contains("pointer"):
                    phase = "foreign functions (Phase 8)"
                let at = self.ast(ctx.module).type_expr(te).range
                self.unsupported_in(ctx.module, at, what, phase)
                return Ty.error()

    ## A collection a declaration writes with references as its items
    ## (RULES.md, R21; 04, rule 3): `E0438` at the item's type, with the fix
    ## that holds the values themselves.
    pure def written_ref_items(mut self, t: Ty, args: list[TypeExprId], ctx: TyCtx):
        let TyData.Adt(d, targs) = self.types.data(t).copy() else:
            return
        if self.prog.collection_name(d).is_none() or len(targs) < len(args):
            return
        for i in range(len(args)):
            let written = self.ast(ctx.module).type_expr(args[i]).copy()
            let TypeKind.Ref(_, inner) = written.kind else:
                continue
            if not is_ref_item(self.types, targs[i])
                    or self.types.is_allocator_arg(d, len(targs), i):
                continue
            let inner_start = self.ast(ctx.module).type_expr(inner).range.start
            var owned: list[Ty] = []
            for x in targs:
                owned.push(self.types.strip_ref(x))
            let owned_ty = self.types.adt(d, owned)
            let shown_owned = self.prog.display_in(self.types, owned_ty, ctx.generics)
            let shown = self.prog.display_in(self.types, t, ctx.generics)
            let at = written.range
            let edit = Edit(start=at.start, end=inner_start, text=String.new())
            let params = [MsgParam(name="ty".to_string(), value=shown_owned)]
            let found = Diagnostic.new(Msg.BorrowRefInCollection, at.start, at.end).with(
                "ty", shown
            )
            self.report_other(ctx.module, found.fix_params(Msg.BorrowOwnItems, params, [edit]))
            return

    ## `cap.Fake[Trait]`, written at `range`: the fake the compiler wrote
    ## for the trait (17); a trait without one is `comptime.no-fake`.
    pure def fake_ty(mut self, arg: TypeExprId, ctx: TyCtx, range: TextRange) -> Ty:
        let written = self.ast(ctx.module).type_expr(arg).copy()
        let TypeKind.Path(segments, args) = written.kind else:
            let shown = self.text_in(ctx.module, written.range)
            let d = Diagnostic.new(Msg.ComptimeNoFake, range.start, range.end).with("name", shown)
            self.report_other(ctx.module, d)
            return Ty.error()
        var found: DefId? = None
        if args.is_empty():
            found = self.lookup_path(segments, ctx, range)
        var words: list[String] = []
        for s in segments:
            words.push(s.text.copy())
        if let Some(t) = found:
            if let Some(f) = self.prog.fakes.get(t):
                return self.types.adt(f, [])
        let d = Diagnostic.new(Msg.ComptimeNoFake, range.start, range.end).with(
            "name", words.join(".")
        )
        self.report_other(ctx.module, d)
        return Ty.error()

    ## Whether `segments` name `cap.Fake` in the program's code.
    pure def is_fake_marker(self, segments: list[Name], module: ModuleId) -> bool:
        if self.is_std(module):
            return False
        var d: DefId? = None
        var m = module
        for i in range(len(segments)):
            var found: DefId? = None
            if i == 0:
                found = self.prog.lookup(m, segments[i].text)
            else:
                found = self.prog.lookup_in(m, segments[i].text)
            let x = found else:
                return False
            if let DefKind.Module(next) = self.prog.defs[x.index].kind():
                m = next
            d = Some(x)
        let x = d else:
            return False
        let item = ref self.prog.defs[x.index]
        let owner = ref self.prog.modules[item.module.index]
        return item.name == "Fake" and owner.is_std and owner.name == "cap"

    ## A `dyn Trait` has no size of its own: it is held only behind `ref`
    ## or in a `Box` (E0395).
    pure def check_sized(mut self, module: ModuleId, ty: Ty, range: TextRange):
        if let Some(d) = self.prog.unsized_part(self.types, ty):
            let shown = self.prog.display(self.types, d)
            self.report_at(module, Msg.TypeUnsizedDyn, range, "ty", shown)

    pure def resolve_error_set(mut self, te: TypeExprId, ctx: TyCtx) -> Ty:
        var parts: list[TypeExprId] = []
        if let TypeKind.Union(list) = self.ast(ctx.module).type_expr(te).kind:
            parts = list.copy()
        else:
            parts = [te]
        var members: list[DefId] = []
        for p in parts:
            let t = self.resolve_ty(p, ctx)
            match self.types.data(t):
                case TyData.ErrSet(m):
                    for d in m:
                        members.push(d)
                case TyData.Error:
                    return Ty.error()
                case _:
                    return Ty.error()
        return self.types.err_set(sorted_members(members))

    ## The associated type `name` of `subject`, from the bounds in scope
    ## (and, inside a trait, the trait itself).
    pure def assoc_of(mut self, subject: Ty, name: str, ctx: TyCtx) -> Ty?:
        var candidates: list[TraitRef] = []
        if let Some(t) = ctx.in_trait:
            if subject == self.types.param(0):
                var args: list[Ty] = []
                if let Some(info) = self.prog.trait_info(t):
                    for i in range(len(info.generics)):
                        args.push(self.types.param(i + 1))
                candidates.push(TraitRef(def_=t, args=args))
        for p in ctx.predicates:
            if p.ty == subject:
                candidates.push(p.bound.copy())
        for c in candidates:
            for tr in self.prog.elaborate(mut self.types, subject, c):
                var declares = False
                if let Some(info) = self.prog.trait_info(tr.def_):
                    for a in info.assoc:
                        if a.name == name:
                            declares = True
                if declares:
                    return Some(
                        self.types.intern(
                            TyData.Assoc(self_ty=subject, trait_=tr.copy(), name=name.to_string())
                        )
                    )
        return None

    ## The trait among `subject`'s bounds that declares the constant
    ## `name` (a function of the trait without `self`, RULES.md, R37).
    pure def bound_constant(mut self, subject: Ty, name: str, ctx: TyCtx) -> String?:
        var candidates: list[TraitRef] = []
        for p in ctx.predicates:
            if p.ty == subject:
                candidates.push(p.bound.copy())
        for c in candidates:
            for tr in self.prog.elaborate(mut self.types, subject, c):
                let owner = self.prog.defs[tr.def_.index].name.copy()
                if let Some(info) = self.prog.trait_info(tr.def_):
                    for m in info.methods:
                        if self.prog.defs[m.index].name == name:
                            return Some(owner)
                # A trait whose members are not declared yet: its text.
                let m = self.prog.defs[tr.def_.index].module
                if m.index < len(self.sources):
                    let source = ref self.sources[m.index]
                    for id in source.items:
                        if let ItemKind.Trait(t) = source.ast.item(id).kind:
                            if t.name.text == owner:
                                for c in t.consts:
                                    if c.name.text == name:
                                        return Some(owner.copy())
        return None

    pure def resolve_path_ty(
        mut self, segments: list[Name], args: list[Ty], ctx: TyCtx, at: TextRange
    ) -> Ty:
        let first = segments.first() else:
            return Ty.error()
        if len(segments) == 1:
            let name = first.text.copy()
            for i in range(len(ctx.generics)):
                if ctx.generics[i] == name:
                    if not args.is_empty():
                        self.report_at(ctx.module, Msg.TypeNotGeneric, at, "name", name)
                    return self.types.param(i)
            if let Some(p) = primitive(name):
                if not args.is_empty():
                    self.report_at(ctx.module, Msg.TypeNotGeneric, at, "name", name)
                return p
            if name == "Self":
                match ctx.self_ty:
                    case Some(t):
                        return t
                    case None:
                        let d = Diagnostic.new(Msg.ResolveSelfTypeOutside, at.start, at.end)
                        self.report_other(ctx.module, d)
                        return Ty.error()
            # Inside a trait, its associated types are named bare.
            if ctx.in_trait.is_some() and self.prog.lookup(ctx.module, name).is_none():
                let p0 = self.types.param(0)
                if let Some(t) = self.assoc_of(p0, name, ctx):
                    return t
            if let Some(d) = self.prog.lookup(ctx.module, name):
                # A constant where a type's constant argument goes:
                # `Array[int, SIZE]`.
                if let DefKind.Const(_) = self.prog.defs[d.index].kind():
                    if args.is_empty():
                        let (t, err) = consts.const_item(
                            self.prog, mut self.types, ctx.module, name, first.range
                        )
                        if let Some(x) = err:
                            var diag = consts.diagnostic(x, Shared.get(self.catalog))
                            diag.start = at.start
                            diag.end = at.end
                            self.report_const(ctx.module, diag)
                        return t
                return self.def_as_type(d, name, args, ctx.module, at)
            self.undefined_type(ctx.module, name, at)
            return Ty.error()
        # `C.Item` and `Self.Item`: an associated type.
        if len(segments) == 2:
            let base = first.text.copy()
            var subject: Ty? = None
            for i in range(len(ctx.generics)):
                if ctx.generics[i] == base and subject.is_none():
                    subject = Some(self.types.param(i))
            if subject.is_none() and base == "Self":
                subject = ctx.self_ty
            if let Some(s) = subject:
                let name = segments[1].text.copy()
                if base == "Self":
                    for (n, t) in ctx.impl_assoc:
                        if n == name:
                            return t
                if let Some(t) = self.assoc_of(s, name, ctx):
                    return t
                let shown = self.prog.display_in(self.types, s, ctx.generics)
                var d = Diagnostic.new(Msg.ResolveNoAssocType, at.start, at.end).with("ty", shown)
                # A constant of a bound's trait is named as one, not as an
                # associated type (RULES.md, R68).
                if let Some(owner) = self.bound_constant(s, name, ctx):
                    d = Diagnostic.new(Msg.ResolveConstNotType, at.start, at.end).with("ty", shown)
                    d = d.with("trait", owner)
                # A trait's constant through a type parameter is a value of
                # the instance, not a constant argument (RULES.md, R50).
                if is_screaming(name):
                    d = d.note_params(
                        Msg.ResolveConstThroughParam,
                        [MsgParam(name="name".to_string(), value=name.copy())],
                    )
                self.report_other(ctx.module, d.with("name", name))
                return Ty.error()
            # `Square.SIDES`: a constant of a type, where a type's constant
            # argument goes (RULES.md, R50).
            if let Some(t) = self.assoc_const_arg(ctx.module, segments, at, True):
                return t
        # A qualified name: module.Type.
        let d = self.lookup_path(segments, ctx, at) else:
            return Ty.error()
        let last = segments[len(segments) - 1].text.copy()
        return self.def_as_type(d, last, args, ctx.module, at)

    ## The constants of the program's types whose values folding computes
    ## (RULES.md, R50), for the checker, which reads `Square.SIDES` in a
    ## body's types from `Program.const_args`.
    pure def fold_const_args(mut self, ids: list[ModuleId]):
        for mid in ids:
            if self.is_std(mid) or mid.index >= len(self.sources):
                continue
            var wanted: list[list[Name]] = []
            for it in self.sources[mid.index].items:
                match self.ast(mid).item(it).kind.copy():
                    case ItemKind.Impl(i):
                        if let TypeKind.Path(segs, args) = self.ast(mid).type_expr(i.self_ty).kind:
                            if args.is_empty() and len(segs) == 1:
                                for c in i.consts:
                                    wanted.push([segs[0].copy(), c.name.copy()])
                    case ItemKind.Struct(st):
                        for c in st.consts:
                            wanted.push([st.name.copy(), c.name.copy()])
                    case ItemKind.Enum(e):
                        for c in e.consts:
                            wanted.push([e.name.copy(), c.name.copy()])
                    case _:
                        pass
            for path in wanted:
                if let Some(d) = self.prog.lookup(mid, path[0].text):
                    if self.prog.const_args.contains((d, path[1].text.copy())):
                        continue
                    let at = path[1].range
                    _ = self.assoc_const_arg(mid, path, at, False)

    ## `Square.SIDES` where a type's constant argument goes (RULES.md,
    ## R50): the value the program gives the constant of the type, in an
    ## impl or in the type's own body, when folding computes it; `None` when
    ## the path names no such constant.
    pure def assoc_const_arg(
        mut self, module: ModuleId, segments: list[Name], at: TextRange, report: bool
    ) -> Ty?:
        let d = self.prog.lookup(module, segments[0].text)?
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(_) | DefKind.Enum(_):
                pass
            case _:
                return None
        let name = segments[1].text.copy()
        var found: (ModuleId, ExprId)? = None
        for m in range(len(self.sources)):
            let mid = ModuleId(index=m)
            if found.is_some() or m >= len(self.prog.modules) or self.is_std(mid):
                continue
            for it in self.sources[m].items:
                match self.ast(mid).item(it).kind.copy():
                    case ItemKind.Impl(i):
                        if let TypeKind.Path(segs, args) = self.ast(mid).type_expr(i.self_ty).kind:
                            if args.is_empty() and self.path_def(mid, segs) == Some(d):
                                for c in i.consts:
                                    if c.name.text == name:
                                        if let Some(v) = c.value:
                                            found = Some((mid, v))
                    case ItemKind.Struct(st):
                        if self.prog.lookup_in(mid, st.name.text) == Some(d):
                            for c in st.consts:
                                if c.name.text == name:
                                    if let Some(v) = c.value:
                                        found = Some((mid, v))
                    case ItemKind.Enum(e):
                        if self.prog.lookup_in(mid, e.name.text) == Some(d):
                            for c in e.consts:
                                if c.name.text == name:
                                    if let Some(v) = c.value:
                                        found = Some((mid, v))
                    case _:
                        pass
        let (vm, v) = found?
        let ts = self.value_terms(vm, Some(v))
        let (t, err) = consts.const_arg(self.prog, mut self.types, vm, ts, ConstScope.items())
        if let Some(x) = err:
            # Where the constant is written as a type's argument; the
            # record of the folded ones for the checker reports nothing.
            if report:
                var diag = consts.diagnostic(x, Shared.get(self.catalog))
                diag.start = at.start
                diag.end = at.end
                self.report_const(module, diag)
        else:
            # A body's annotation reads it from here (`Checker.resolve_ty`).
            _ = self.prog.const_args.insert((d, name), t)
        return Some(t)

    pure def def_as_type(
        mut self, d: DefId, name: str, args: list[Ty], module: ModuleId, at: TextRange
    ) -> Ty:
        self.deprecated_type_use(d, module, at)
        var generics: list[Generic] = []
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(s):
                generics = s.generics.copy()
            case DefKind.Enum(e):
                generics = e.generics.copy()
            case DefKind.Refinement(r):
                generics = r.generics.copy()
            case DefKind.ErrorSet(_):
                if not args.is_empty():
                    self.report_at(module, Msg.TypeNotGeneric, at, "name", name)
                return self.types.err_set([d])
            case DefKind.TypeAlias(_):
                var declared = 0
                if let Some((_, a)) = self.aliases.get(d):
                    declared = len(a.generics)
                if len(args) != declared and not (args.is_empty() and declared == 0):
                    self.argument_count(module, at, name, declared, len(args))
                    return Ty.error()
                # An alias the compiler declares for an instance may stand
                # for a type parameter of the impl it is in (decision 251).
                let t = self.resolve_alias(d)
                if args.is_empty():
                    return t
                return self.types.subst(t, args)
            case DefKind.Trait(_):
                var diag = Diagnostic.new(Msg.ResolveTraitAsType, at.start, at.end).with(
                    "name", name
                )
                # A parameter's whole type: a reference to some value that
                # implements it, `ref dyn T` (a `dyn` has no size of its own,
                # E0395), or a generic parameter (RULES.md, R63).
                if self.param_type_at == Some(at):
                    diag = diag.fix(
                        Msg.ResolveAddRefDyn, "name", name, at.start, at.start, "ref dyn "
                    )
                    diag = diag.note_with(Msg.ResolveTraitGeneric, "name", name)
                else:
                    diag = diag.fix(Msg.ResolveAddDyn, "name", name, at.start, at.start, "dyn ")
                self.report_other(module, diag)
                return Ty.error()
            case DefKind.Unsupported:
                return Ty.error()
            case _:
                let diag = Diagnostic.new(Msg.ResolveNotAType, at.start, at.end).with("name", name)
                self.report_other(module, diag)
                return Ty.error()
        # Generics of a type not yet resolved are counted from its AST.
        let declared = self.declared_generics(d) ?? len(generics)
        var targs = args.copy()
        # Omitted trailing arguments take their defaults (D-060).
        if len(targs) < declared:
            var filled = targs.copy()
            while len(filled) < len(generics):
                let default = generics[len(filled)].default else:
                    break
                let t = self.types.subst(default, filled)
                filled.push(t)
            if len(filled) == declared:
                targs = filled
        if len(targs) != declared:
            if targs.is_empty():
                self.report_at(module, Msg.TypeTypeArgumentsNeeded, at, "name", name)
            else:
                self.argument_count(module, at, name, declared, len(targs))
            var errors: list[Ty] = []
            for _ in range(declared):
                errors.push(Ty.error())
            return self.types.adt(d, errors)
        # A `const` parameter takes a constant, any other a type.
        var consts: list[bool] = []
        match self.type_params.get(d):
            case Some(gps):
                for g in gps:
                    consts.push(g.is_const)
            case None:
                for g in generics:
                    consts.push(g.is_const)
        for i in range(len(targs)):
            if i >= len(consts):
                continue
            var wrong = False
            match self.types.data(targs[i]):
                case TyData.Const(_) | TyData.ConstOp(_, _):
                    wrong = not consts[i]
                case TyData.Param(_) | TyData.Error | TyData.Var(_):
                    wrong = False
                case _:
                    wrong = consts[i]
            if wrong:
                var param = "{i + 1}"
                if i < len(generics):
                    param = generics[i].name.copy()
                var m = Msg.ResolveTypeArgument
                if consts[i]:
                    m = Msg.ResolveConstArgument
                let diag = Diagnostic.new(m, at.start, at.end).with("name", name)
                self.report_other(module, diag.with("param", param))
                var errors: list[Ty] = []
                for _ in range(declared):
                    errors.push(Ty.error())
                return self.types.adt(d, errors)
        return self.types.adt(d, targs)

    ## The bounds of a type's generic parameters.
    pure def preds_of(self, d: DefId) -> list[Predicate]:
        if let Some(p) = self.type_preds.get(d):
            return p.copy()
        return []

    ## The generic parameters a type, trait or refinement declares.
    pure def params_of(self, d: DefId) -> list[GenericParam]:
        if let Some(p) = self.type_params.get(d):
            return p.copy()
        return []

    ## The number of generic parameters a type declares, from its AST.
    pure def declared_generics(self, d: DefId) -> int?:
        if let Some(g) = self.type_params.get(d):
            return Some(len(g))
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(s):
                return Some(len(s.generics))
            case DefKind.Enum(e):
                return Some(len(e.generics))
            case _:
                return None

## A test's name within its suite: `suite/name`.
## The attribute the compiler puts on the function that gives an
## associated constant's value (RULES.md, R37), which no program writes.
pub const ASSOC_CONST_ATTR: str = "<const>"

## The module a std module's doc examples make (`sir --tests --std`,
## RULES.md, R185 and R224): its text, the diagnostics of its parse and its
## syntax.
pub struct StdDoc:
    text: String
    diagnostics: list[Diagnostic]
    syntax: Module

## The module of each std module's doc examples that has one, by the
## module's name (the prelude's as `prelude`), from `texts`, the std
## modules' sources: made once for a check, where each round of its
## resolution made them again, the module's text parsed for its items'
## starts and the examples' text for their module (RULES.md, R224).
pub pure def std_docs_of(texts: dict[String, String], catalog: Catalog) -> dict[String, StdDoc]:
    var out: dict[String, StdDoc] = {}
    var names: list[str] = ["prelude"]
    for name in documented():
        names.push(name)
    for name in names:
        let text = texts.get(name.to_string()) else:
            continue
        if out.contains(name.to_string()):
            continue
        let syntax = build.module(parse(text, Catalog.parse("")).tree)
        let examples = doc_examples(text, item_starts(syntax.ast, syntax.items))
        if examples.is_empty():
            continue
        let generated = doc_test_module(text, examples)
        let parsed = parse(generated, catalog)
        let doc = StdDoc(
            text=generated.copy(),
            diagnostics=parsed.diagnostics.copy(),
            syntax=build.module(parsed.tree),
        )
        _ = out.insert(name.to_string(), doc)
    return out

## Where each item among `items` that can carry a doc comment starts, with
## the name its examples' tests are named after: a method as
## `Type.method`.
pure def item_starts(ast: Ast, items: list[ItemId]) -> list[(int, String)]:
    # Where each item that can carry a doc comment starts, with the name
    # its examples' tests are named after: a method as `Type.method`.
    var starts: list[(int, String)] = []
    for it in items:
        let start = ast.item(it).range.start
        match ast.item(it).kind:
            case ItemKind.Fn(f):
                starts.push((start, f.name.text.copy()))
            case ItemKind.Const(c):
                starts.push((start, c.name.text.copy()))
            case ItemKind.TypeAlias(a):
                starts.push((start, a.name.text.copy()))
            case ItemKind.Struct(st):
                starts.push((start, st.name.text.copy()))
                for m in st.methods:
                    starts.push((m.range.start, "{st.name.text}.{m.name.text}"))
            case ItemKind.Enum(e):
                starts.push((start, e.name.text.copy()))
                for m in e.methods:
                    starts.push((m.range.start, "{e.name.text}.{m.name.text}"))
            case ItemKind.ErrorSet(e):
                starts.push((start, e.name.text.copy()))
                for m in e.methods:
                    starts.push((m.range.start, "{e.name.text}.{m.name.text}"))
            case ItemKind.Trait(t):
                starts.push((start, t.name.text.copy()))
                for m in t.methods:
                    starts.push((m.range.start, "{t.name.text}.{m.name.text}"))
            case ItemKind.Impl(i):
                let owner = impl_owner_name(ast, i.self_ty)
                for m in i.methods:
                    starts.push((m.range.start, "{owner}.{m.name.text}"))
            case _:
                pass
    return starts

pure def prefixed(prefix: str, name: str) -> String:
    if prefix.is_empty():
        return name.to_string()
    return "{prefix}/{name}"

## Error set members in order of definition, each once.
pure def sorted_members(own v: list[DefId]) -> list[DefId]:
    var ints: list[int] = []
    for d in v:
        ints.push(d.index)
    ints.sort()
    var out: list[DefId] = []
    for i in ints:
        if let Some(last) = out.last():
            if last.index == i:
                continue
        out.push(DefId(index=i))
    return out

## The text of `r` in `text`, or nothing when `r` is not in it.
## A module of a program's own source, for `Resolver.add_program`: its path
## (`["atlas", "geo", "point"]`; empty for a single file), the name of its
## file as diagnostics give it, its syntax and text, and its package (an
## index of the program's packages, the root package first).
pub struct SourceModule:
    pub path: list[String]
    pub file: String
    pub syntax: Module
    pub text: String
    pub package: int

## A package of a program's source: its name (empty for a single file), its
## dependencies (by the names its imports give them, as indices of the
## program's packages) and whether `[trust]` lets it use `unsafe` and
## `extern`.
pub struct SourcePackage:
    pub name: String
    pub deps: list[(String, int)]
    pub trusted: bool
    ## The dependencies whose `when` excludes the target (RULES.md, R71).
    pub excluded: list[String]
    ## The package's own dev-dependencies, which only its `@cfg(test)`
    ## imports name (RULES.md, R75).
    pub dev_only: list[String]

## The package of the program's `k`th package in the resolved program, where
## std is `STD_PACKAGE` (stage 0's `package_id`).
pure def package_id(k: int) -> int:
    return if k == 0: 0 else: k + 1

## The prefix of the names of a module's tests: its path within its package
## (`parser/accepts leading zeros`); none for a root module.
pure def test_prefix(path: list[String]) -> String:
    if len(path) <= 1:
        return String.new()
    var rest: list[String] = []
    for i in range(1, len(path)):
        rest.push(path[i].copy())
    return rest.join(".")

pure def slice_text(text: str, r: TextRange) -> String:
    if r.start < 0 or r.end > text.byte_len() or r.start > r.end:
        return String.new()
    return text.byte_slice(r.start, r.end).to_string()

pub pure def has_attr(attrs: list[Attr], name: str) -> bool:
    for a in attrs:
        if a.name == name:
            return True
    return False

## The type a primitive name stands for.
pure def primitive(name: str) -> Ty?:
    return match name:
        case "int": Some(Ty.int())
        case "f64": Some(Ty.float())
        case "bool": Some(Ty.bool())
        case "char": Some(Ty.char())
        case "str": Some(Ty.str())
        case "Never": Some(Ty.never())
        case _: None

## A std module's text, from the texts read by name.
## The `comptime def derive` of each trait of a module (the prelude's),
## with the module's syntax and text: what `@derive` unfolds.
## Whether a byte ends a header line without being part of it: its `:`, a
## carriage return or a space.
pure def is_header_tail(b: int) -> bool:
    return b == 58 or b == 13 or b == 32

pure def derive_templates(own syntax: Module, text: str) -> Templates:
    var derives: dict[String, FnDef] = {}
    for it in syntax.items:
        if let ItemKind.Trait(t) = syntax.ast.item(it).kind:
            for m in t.methods:
                if m.is_comptime and m.name.text == "derive":
                    let src = Src(ast=ref syntax.ast, source="")
                    if template_parts(src, m).is_some():
                        _ = derives.insert(t.name.text.copy(), m.copy())
    return Templates(syntax=syntax.ast, text=text.to_string(), derives=derives)

pure def text_of(texts: dict[String, String], name: str) -> String:
    if let Some(t) = texts.get(name.to_string()):
        return t.copy()
    return String.new()

## Whether `f`'s body has code that runs at compile time by unfolding (08,
## "Reflection"; stage 0's `instances::unfolds`): a `reflect` query, a
## field reached by a compile-time descriptor (`x.[f]`), a `comptime for` or
## `comptime if` (among statements or a `match`'s arms), or a compile-time
## expression that names one of `names` (the type parameters in scope).
pure def unfolds(ast: Ast, f: FnDef, names: list[String]) -> bool:
    var stmts: Block? = None
    if let Some(b) = f.body:
        stmts = Some(b.copy())
    let body = stmts else:
        return False
    if comptime_stmts(ast, body):
        return True
    for e in visit.exprs_in_block(ast, body):
        match ast.expr(e).kind:
            case ExprKind.FieldOf(_, _):
                return True
            case ExprKind.Call(callee, _, _):
                if let ExprKind.Field(base, _) = ast.expr(callee).kind:
                    if let ExprKind.Name(n) = ast.expr(base).kind:
                        if n == "reflect":
                            return True
            case ExprKind.Comptime(inner):
                for x in visit.exprs_of(ast, inner):
                    if let ExprKind.Name(n) = ast.expr(x).kind:
                        if names.contains(n):
                            return True
            case ExprKind.Match(_, arms):
                for a in arms:
                    if a.generated.is_some():
                        return True
                    if let ArmBody.Block(b) = a.body:
                        if comptime_stmts(ast, b):
                            return True
            case ExprKind.Closure(c):
                if let ClosureBody.Block(b) = c.body:
                    if comptime_stmts(ast, b):
                        return True
            case _:
                pass
    return False

## Whether a value (a constant's, a field's default) runs code at compile
## time by unfolding: a `reflect` query or a field reached by a
## compile-time descriptor (stage 0's `instances::value_unfolds`; decision
## 251).
pub pure def value_unfolds(ast: Ast, e: ExprId) -> bool:
    for x in visit.exprs_of(ast, e):
        match ast.expr(x).kind:
            case ExprKind.FieldOf(_, _):
                return True
            case ExprKind.Call(callee, _, _):
                if let ExprKind.Field(base, _) = ast.expr(callee).kind:
                    if let ExprKind.Name(n) = ast.expr(base).kind:
                        if n == "reflect":
                            return True
            case _:
                pass
    return False

## A test as the function its body is, for unfolding it (decision 251):
## its name's range starts the header the instance's is cut from.
pure def test_fn(name: str, t: TestDef) -> FnDef:
    var node = 0
    if let Some(b) = t.body:
        node = b.node
    return FnDef(
        node=node,
        range=t.name_range,
        name=Name(text=name.to_string(), range=t.name_range),
        is_pure=False,
        is_comptime=False,
        is_unsafe=False,
        generics=[],
        params=t.params.copy(),
        ret=None,
        from_=[],
        where_=[],
        body=t.body.copy(),
        attrs=[],
        header_broken=False,
        body_broken=False,
        vis=Vis.Private,
    )

## Whether a block has a `comptime for` or `comptime if` among its
## statements, at any depth of statements.
pure def comptime_stmts(ast: Ast, b: Block) -> bool:
    for s in b.stmts:
        if comptime_stmt(ast, s):
            return True
    return False

pure def comptime_stmt(ast: Ast, s: StmtId) -> bool:
    match ast.stmt(s).kind:
        case StmtKind.Comptime(inner):
            return match ast.stmt(inner).kind:
                case StmtKind.Assert(_, _) | StmtKind.Expr(_): False
                case _: True
        case StmtKind.If(branches, else_block):
            for (_, b) in branches:
                if comptime_stmts(ast, b):
                    return True
            if let Some(b) = else_block:
                return comptime_stmts(ast, b)
            return False
        case StmtKind.While(_, body) | StmtKind.Defer(body):
            return comptime_stmts(ast, body)
        case StmtKind.For(_, _, _, body) | StmtKind.With(_, _, body):
            return comptime_stmts(ast, body)
        case StmtKind.Let(_, _, _, _, else_):
            if let Some(le) = else_:
                if let ElseBody.Block(b) = le.body:
                    return comptime_stmts(ast, b)
            return False
        case _:
            return False

## The builtin scalars a misspelt type's name is compared with (stage 0's
## `similar_type_fix`, `i64` among them).
const SIMILAR_SCALARS: list[str] = [
    "int",
    "f64",
    "f32",
    "bool",
    "char",
    "str",
    "u8",
    "u16",
    "u32",
    "u64",
    "u128",
    "i8",
    "i16",
    "i32",
    "i64",
    "i128",
]

## The last part of a dotted path: `json` for `std.json`.
pure def last_word(path: str) -> String:
    var out = String.new()
    for part in path.split("."):
        out = part.to_string()
    return out

## The traits `@delegate` forwards (03, "Coherence").
pure def delegable(name: str) -> bool:
    return match name:
        case "Add" | "Sub" | "Mul" | "Div" | "Rem" | "Neg" | "Eq" | "PartialOrd" | "Ord": True
        case "Hash" | "Display" | "Debug" | "Len": True
        case _: False

## The delegable traits whose methods return `Self`.
pure def returns_self(name: str) -> bool:
    return match name:
        case "Add" | "Sub" | "Mul" | "Div" | "Rem" | "Neg": True
        case _: False

## A method of a trait, as the interceptor and the fake write it.
struct ShimMethod:
    name: String
    ## The receiver and parameters as written: `mut self, x: int`.
    params: String
    ## ` -> T ! E` as written, or empty.
    ret: String
    ## The result type as written (`T ! E`), when it is not `()`.
    result: String?
    ## The parameters' names, and whether each is passed `mut`.
    args: list[(String, bool)]

## `"{a:?}, {b:?}"`: the arguments of a call as an interceptor and a fake
## show them.
pure def shown_args(m: ShimMethod) -> String:
    var parts: list[String] = []
    for (n, _) in m.args:
        parts.push("{{{n}:?}}")
    return parts.join(", ")

## `x, mut y`: the arguments of the forwarded call.
pure def passed(m: ShimMethod) -> String:
    var parts: list[String] = []
    for (n, by_mut) in m.args:
        if by_mut:
            parts.push("mut {n}")
        else:
            parts.push(n.copy())
    return parts.join(", ")

## The impl of `trait_name` for `cap.Wrap`.
pure def wrap_impl(trait_name: str, ms: list[ShimMethod]) -> String:
    var s: String = "impl[__T: {trait_name}, __I: cap.Interceptor] {trait_name} for cap.Wrap[__T, __I]:\n"
    for m in ms:
        s.push("    def {m.name}({m.params}){m.ret}:\n")
        s.push(
            "        let __call = cap.Call(capability=\"{trait_name}\".to_string(), method=\"{m.name}\".to_string(), args=\"{shown_args(m)}\")\n"
        )
        s.push("        self.hook.before(__call.copy())\n")
        match m.result:
            case Some(_):
                s.push("        let __result = self.inner.{m.name}({passed(m)})\n")
                s.push("        self.hook.after(__call, \"{{__result:?}}\")\n")
                s.push("        return __result\n")
            case None:
                s.push("        self.inner.{m.name}({passed(m)})\n")
                s.push("        self.hook.after(__call, \"()\")\n")
    return s

## The fake of `trait_name`: a struct, its own methods, and its impl of
## the trait.
pure def fake_text(trait_name: str, ms: list[ShimMethod]) -> String:
    let ty = "__Fake_{trait_name}"
    var s: String = "## A recording fake of `{trait_name}` (17): `cap.Fake[{trait_name}]`. Its copies share\n"
    s.push(
        "## what it recorded.\n@derive(Copy)\nstruct {ty}:\n    __log: Cap[Mutex[list[String]]]\n"
    )
    for m in ms:
        if let Some(r) = m.result:
            s.push("    __on_{m.name}: Cap[Mutex[list[{r}]]]\n")
    var fields = ["__log=Cap(Mutex(list()))".to_string()]
    for m in ms:
        if m.result.is_some():
            fields.push("__on_{m.name}=Cap(Mutex(list()))")
    s.push("\nimpl {ty}:\n")
    s.push("    ## A fake of `{trait_name}` that has seen no calls and has no results queued.\n")
    s.push("    def new() -> {ty}:\n        return {ty}({fields.join(", ")})\n")
    s.push("    ## The calls so far, in order, each written `method(arguments)`.\n")
    s.push(
        "    def calls(self) -> list[String]:\n        return self.__log.get().lock().value.copy()\n"
    )
    for m in ms:
        if let Some(r) = m.result:
            s.push(
                "    ## Queues what a call of `{m.name}` returns; the last result queued is returned\n"
            )
            s.push("    ## again once the others are used.\n")
            s.push("    def on_{m.name}(self, own result: {r}):\n")
            s.push("        self.__on_{m.name}.get().lock().value.push(result)\n")
    s.push("\nimpl {trait_name} for {ty}:\n")
    for m in ms:
        s.push("    def {m.name}({m.params}){m.ret}:\n")
        s.push("        self.__log.get().lock().value.push(\"{m.name}({shown_args(m)})\")\n")
        if m.result.is_some():
            s.push("        var __queued = self.__on_{m.name}.get().lock()\n")
            s.push("        if __queued.value.is_empty():\n")
            s.push(
                "            panic(\"`cap.Fake[{trait_name}]`: `{m.name}` was called with no result queued (`on_{m.name}`)\")\n"
            )
            s.push("        if len(__queued.value) == 1:\n")
            s.push("            return __queued.value[0].copy()\n")
            s.push("        return __queued.value.remove(0)\n")
    return s

## One fenced example of a run of `##` lines: the line of its opening
## fence, and each of its lines (the line, the column its text starts at,
## and the text).
struct DocExample:
    ## The documented item's name, `Type.method` for a method, and which
    ## example of it this is, from 1.
    item: String
    ordinal: int
    fence_line: int
    lines: list[(int, int, String)]

impl DocExample:
    ## The test's name.
    pure def test_name(self) -> String:
        if self.ordinal == 1:
            return "{self.item} (doc example)"
        return "{self.item} (doc example {self.ordinal})"

## The name a doc test gives the type an `impl` is for: its path, with `T?`
## named `Option` and `T ! E` named `Result`, as they are declared.
pure def impl_owner_name(ast: Ast, ty: TypeExprId) -> String:
    match ast.type_expr(ty).kind:
        case TypeKind.Path(segments, _):
            var parts: list[String] = []
            for s in segments:
                parts.push(s.text.copy())
            return parts.join(".")
        case TypeKind.Option(_):
            return "Option".to_string()
        case TypeKind.Result(_, _):
            return "Result".to_string()
        case TypeKind.Ref(_, inner):
            return impl_owner_name(ast, inner)
        case _:
            return "impl".to_string()

## A `##` line's indentation and its text after the marker; `None` for any
## other line (`##!` is a module's doc).
pure def doc_line(line: str) -> (int, String)?:
    var indent = 0
    while indent < line.byte_len() and line.byte_at(indent) == 32:
        indent += 1
    let rest = line.byte_slice(indent, line.byte_len())
    if not rest.starts_with("##") or rest.starts_with("##!"):
        return None
    return Some((indent, rest.byte_slice(2, rest.byte_len()).to_string()))

## The examples in a text (stage 0's `doctests::examples`): an example is
## a fenced block in a run of `##` lines, opened by "```" or "```sisu" and
## closed by "```", and documents the first item that starts after the run;
## one with no item after it, or no line, is none.
pure def doc_examples(text: str, starts: list[(int, String)]) -> list[DocExample]:
    var counts: dict[String, int] = {}
    var out: list[DocExample] = []
    var run: list[DocExample] = []
    var open: DocExample? = None
    var offset = 0
    var index = 0
    for raw in text.split("\n"):
        let start = offset
        offset += raw.byte_len() + 1
        var bare = raw.to_string()
        if bare.ends_with("\r"):
            bare = bare.byte_slice(0, bare.byte_len() - 1).to_string()
        match doc_line(bare):
            case Some((indent, content)):
                let fence = content.trim()
                match open:
                    case Some(e):
                        if fence == "```":
                            run.push(e.copy())
                            open = None
                        else:
                            var col = indent + 2
                            var body = content.copy()
                            if content.starts_with(" "):
                                col = indent + 3
                                body = content.byte_slice(1, content.byte_len()).to_string()
                            if not body.trim().is_empty():
                                if let Some(x) = ref mut open:
                                    x.lines.push((index, col, body))
                    case None:
                        if fence == "```" or fence == "```sisu":
                            open = Some(
                                DocExample(item=String.new(), ordinal=0, fence_line=index, lines=[])
                            )
            case None:
                open = None
                finish_doc_run(mut run, start, starts, mut counts, mut out)
        index += 1
    finish_doc_run(mut run, text.byte_len(), starts, mut counts, mut out)
    var kept: list[DocExample] = []
    for e in out:
        if not e.lines.is_empty():
            kept.push(e.copy())
    return kept

## The examples of a run that ended at `at` document the first item that
## starts there or later; without one they are none.
pure def finish_doc_run(
    mut run: list[DocExample],
    at: int,
    starts: list[(int, String)],
    mut counts: dict[String, int],
    mut out: list[DocExample],
):
    if run.is_empty():
        return
    var item: (int, String)? = None
    for (s, name) in starts:
        if s < at:
            continue
        match item:
            case Some((best, _)):
                if s < best:
                    item = Some((s, name.copy()))
            case None:
                item = Some((s, name.copy()))
    if let Some((_, name)) = item:
        for e in run:
            let n = (counts.get(name.copy()) ?? 0) + 1
            _ = counts.insert(name.copy(), n)
            var x = e.copy()
            x.item = name.copy()
            x.ordinal = n
            out.push(x)
    run.clear()

## The module of tests for the examples (stage 0's `doctests::test_module`):
## as many lines as `text`, the opening fence's line holding the test's
## header, the example's lines its body, every other line empty.
pure def doc_test_module(text: str, examples: list[DocExample]) -> String:
    var count = 0
    for _ in text.split("\n"):
        count += 1
    if text.ends_with("\n"):
        count -= 1
    if count < 1:
        count = 1
    var lines: list[String] = []
    for _ in range(count):
        lines.push(String.new())
    for k in range(len(examples)):
        let e = ref examples[k]
        if e.fence_line < count:
            lines[e.fence_line] = "test {quote(e.test_name())}:"
        for (line, col, body) in e.lines:
            if line < count:
                var l = String.new()
                for _ in range(col):
                    l.push(" ")
                l.push(body)
                lines[line] = l
    var out = lines.join("\n")
    out.push("\n")
    return out

## A type's outermost constructor, for telling impl headers apart without
## unifying them; `None` for what unifies with anything.
pure def outermost(types: Types, t: Ty) -> (int, int)?:
    return match types.data(t):
        case TyData.Param(_) | TyData.Assoc(_, _, _) | TyData.Var(_) | TyData.Error: None
        case TyData.ErrSet(_) | TyData.ConstOp(_, _): None
        case TyData.Int: Some((0, 0))
        case TyData.Float: Some((1, 0))
        case TyData.Bool: Some((2, 0))
        case TyData.Char: Some((3, 0))
        case TyData.Str: Some((4, 0))
        case TyData.Unit: Some((5, 0))
        case TyData.Never: Some((6, 0))
        case TyData.Adt(d, _): Some((7, d.index))
        case TyData.Tuple(e, _): Some((8, len(e)))
        case TyData.Fn(ps, _, _): Some((9, len(ps)))
        case TyData.Ref(_, m): Some((10, if m: 1 else: 0))
        case TyData.Dyn(tr): Some((11, tr.def_.index))
        case TyData.Const(c): Some((12, c))

## How a parameter is passed, as a signature writes it.
pure def mode_text(m: Mode) -> str:
    return match m:
        case Mode.Borrow: ""
        case Mode.Mut: "mut "
        case Mode.Own: "own "

## Whether a byte is a space or a line break.
pure def is_blank_byte(b: u8) -> bool:
    return b == 32 or b == 10 or b == 13 or b == 9

## Whether a name is written in SCREAMING_CASE, as a constant's is.
pure def is_screaming(name: str) -> bool:
    var letter = False
    for c in name.chars():
        if c.is_lowercase():
            return False
        if c.is_alphabetic():
            letter = True
    return letter

## `W0028` (`W0029` without a text) for a use at `at` of the preview item
## `name` (13, D-072; RULES.md, R115): it may change or go before it is
## stable, as the attribute's text says.
pub pure def preview_warning(name: str, why: str, at: TextRange) -> Diagnostic:
    if why.is_empty():
        return Diagnostic.new(Msg.TypePreviewPlain, at.start, at.end).with("name", name)
    let d = Diagnostic.new(Msg.TypePreview, at.start, at.end).with("name", name)
    return d.with("reason", why)

## The `##` comment above what starts at `at`, when it starts its own line
## (only spaces before it); none otherwise (RULES.md, R129).
pure def own_line_doc(text: str, at: int) -> String:
    var i = at
    while i > 0:
        let b = text.byte_at(i - 1).to_int()
        if b == 10:
            break
        if b != 32:
            return String.new()
        i -= 1
    return doc_above(text, at).join("\n")
