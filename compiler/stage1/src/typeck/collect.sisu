##! The declarations of a program, collected and resolved (stage 0's
##! `sisu-resolve`: `collect.rs`, with the types as written of `types.rs`
##! and the traits and impls of `traits.rs`): every module's items become
##! definitions, every signature a type, every method an entry of the
##! method table.
##!
##! The prelude, the ambient std modules, `target` and `builtin_impls` are
##! resolved once (`Resolver.base`); each file is then its root module's
##! items, declared and resolved on a copy. Stage 0 declares every module's
##! items before it resolves any, so its definitions of a file's root
##! module come before those the prelude's impls and traits make; here they
##! come after, which changes no name the checker reports.
##!
##! The resolver reports the type checker's own messages it finds in
##! signatures (`type.not-generic`, `type.type-arguments-needed`,
##! `type.unsized-dyn`); the names it cannot find are the name pass's to
##! report. What it does not implement in the root module (imports, derive
##! templates, refinements, contracts, parametrised tests, a script's
##! statements) puts the module beyond the slice the checker covers.

import stage1.typeck.consts
import stage1.typeck.folding
from stage1.diag import Catalog, Diagnostic, Edit, Label, Msg, TextRange, quote
from stage1.diag import Param as MsgParam
from stage1.parser import parse
from stage1.resolve import closest
from stage1.syntax.ast import (
    Arg,
    Ast,
    Attr,
    BinOp,
    Block,
    ConstDef,
    EnumDef,
    Expr,
    ExprId,
    ExprKind,
    FnDef,
    FromImport,
    GenericParam,
    ImplDef,
    Import,
    Item,
    ItemId,
    ItemKind,
    Mode,
    Module,
    Name,
    Param,
    ParamKind,
    PatternId,
    Stmt,
    StmtId,
    StmtKind,
    StructDef,
    TestDef,
    TraitDef,
    TypeAlias,
    TypeExpr,
    TypeExprId,
    TypeKind,
    Vis,
)
from stage1.syntax.ast import build
from stage1.syntax.ast import visit
from stage1.typeck.borrows import ResultShape
from stage1.typeck.consts import ConstScope
from stage1.typeck.folding import Term
from stage1.typeck.instances import DeriveCheck
from stage1.typeck.program import (
    Answer,
    AssocInfo,
    ConstInfo,
    Def,
    DefKind,
    EnumInfo,
    FieldInfo,
    FnInfo,
    FnKind,
    Generic,
    ImplInfo,
    ModuleData,
    ModuleId,
    PackageData,
    ParamInfo,
    Predicate,
    Program,
    RefinementInfo,
    StructInfo,
    TraitInfo,
    VariantInfo,
    WellKnown,
)
from stage1.typeck.std_sources import ambient, builtin_impls, importable, module_for, module_paths, reexports, target
from stage1.typeck.template import Src, Templates, template_parts
from stage1.typeck.ty import DefId, TraitRef, Ty, TyData, TyKey, Types

## Where a method is declared, which decides the generics, bounds and
## `Self` of its signature.
enum Owner:
    ## Written in a struct's or enum's body.
    Type(DefId)
    ## `impl[...] Type:`.
    Inherent(generics: list[Generic], names: list[String], predicates: list[Predicate], self_ty: Ty)
    ## A trait's method.
    Trait(DefId)
    ## A trait impl's method.
    Impl(DefId)
    ## A refinement type's predicate, whose `self` is a value of the base.
    Refinement(DefId)

## A declaration waiting for its signature.
pub enum Pending:
    Fn(def_: DefId, module: ModuleId, ast: FnDef, owner: Owner?)
    Struct(def_: DefId, module: ModuleId, ast: StructDef, attrs: list[Attr])
    Enum(def_: DefId, module: ModuleId, ast: EnumDef, attrs: list[Attr])
    Trait(def_: DefId, module: ModuleId, ast: TraitDef, attrs: list[Attr])
    Impl(module: ModuleId, ast: ImplDef, range: TextRange)
    Test(def_: DefId, module: ModuleId, ast: TestDef)
    Const(def_: DefId, module: ModuleId, ast: ConstDef)
    Refinement(def_: DefId, module: ModuleId, ast: TypeAlias, node: int, range: TextRange)

## What a type expression may mention where it is written.
struct TyCtx:
    module: ModuleId
    generics: list[String]
    self_ty: Ty?
    allow_ref: bool
    ## Bounds in scope, which give `C.Item` its trait.
    predicates: list[Predicate]
    ## Inside a trait: its own associated types may be named bare.
    in_trait: DefId?
    ## Inside a trait impl: what it binds its associated types to.
    impl_assoc: list[(String, Ty)]

impl TyCtx:
    pure def plain(module: ModuleId, generics: list[String], allow_ref: bool) -> TyCtx:
        return TyCtx(
            module=module,
            generics=generics.copy(),
            self_ty=None,
            allow_ref=allow_ref,
            predicates=[],
            in_trait=None,
            impl_assoc=[],
        )

pub struct Resolver:
    pub prog: Program
    pub types: Types
    ## Each module's syntax, by module index.
    pub sources: list[Module]
    ## The type checker's messages found in signatures, with their module.
    pub diags: list[(ModuleId, Diagnostic)]
    ## Why the root module is beyond the checker's slice, when it is.
    pub beyond: String?
    pub pending: list[Pending]
    aliases: dict[DefId, (ModuleId, TypeAlias)]
    resolving_alias: list[DefId]
    ## The generic parameters of every struct, enum, trait and refinement,
    ## known before any of them is resolved.
    type_params: dict[DefId, list[GenericParam]]
    headers_done: set[DefId]
    ## The bounds of every struct's and enum's generic parameters.
    type_preds: dict[DefId, list[Predicate]]
    ## The std modules a program may import, parsed once by the base and
    ## shared by each copy of it (a program's resolver is one).
    std_parsed: Shared[dict[String, Module]]
    ## The std modules loaded, by name.
    std_loaded: dict[String, ModuleId]
    ## While the root module's items are declared: its imports, declared
    ## once every item is (stage 0's deferred imports).
    deferring: bool
    deferred: list[(ModuleId, ItemId)]
    ## Stage 0 reports an error about the root module's declarations that
    ## is not the type checker's (a `resolve.` message).
    pub other_error: bool
    ## The rules of such errors that stage 1 notes without rendering them
    ## (a second declaration of a name is the name pass's, which it
    ## renders).
    pub noted: list[String]
    ## The functions the compiler writes and checks elsewhere too, which
    ## report nothing of their own.
    pub quiet_fns: set[DefId]
    ## The kinds of the functions the compiler writes.
    special_kinds: dict[DefId, FnKind]
    ## `@derive(Copy)` to check against the fields, with the type.
    pub copy_checks: list[(DefId, TextRange)]
    ## The root module's text.
    pub root_text: String
    ## The text of each module of the program, and of each module the
    ## compiler wrote for it, by module.
    pub module_texts: dict[ModuleId, String]
    ## The modules of the program's doc examples, a test each, with their
    ## texts, which keep every example line where the module's file has it.
    pub docs: list[(ModuleId, String)]
    ## The message catalog, for the texts of the messages that are
    ## parameters of others (a panic folding a constant reports): the
    ## program's, which `typeck.base` gives the base, shared by each copy of
    ## it.
    pub catalog: Shared[Catalog]
    ## The derive templates of the program's modules, by module and their
    ## trait's name.
    pub derive_templates: dict[(int, String), FnDef]
    ## The syntax of each template, for its instances.
    pub template_fns: dict[DefId, FnDef]
    ## Generic functions the last check found calling a template with their
    ## own type parameters: templates too.
    pub promoted: set[DefId]
    ## How many instances this resolution was asked for, made or not, and
    ## whether the bound on them was reported.
    pub instances_asked: int
    pub instances_bounded: bool
    ## The attributes on the root module's types, as data for
    ## `reflect.attributes_of`: each name and its arguments' text.
    pub attrs_of: dict[DefId, list[(String, list[String])]]
    ## The modules the compiler wrote from templates (derived impls and
    ## instances), with their text, in the order they were made: their
    ## bodies are checked.
    pub generated: list[(ModuleId, String)]
    ## The module of the interceptors and fakes the compiler wrote for the
    ## program's traits, with its text, whose bodies are checked when
    ## lowering reaches them.
    pub shims: list[(ModuleId, String)]
    ## The derived and delegated impls to check once every impl is known.
    pub derive_checks: list[DeriveCheck]
    ## The text of each std module that has templates, by name.
    pub std_texts: dict[String, String]
    ## The syntax of the modules the base resolves, by module, which
    ## `typeck.base` takes so that lowering can check a std body it reaches.
    pub std_kept: list[Module]
    ## The traits written as `dyn T` in signatures, with the module, for the
    ## check that they can be (stage 0's `dyn_uses`).
    dyn_uses: list[(DefId, ModuleId, TextRange)]
    ## The phase the definitions made now belong to: 0 while modules are
    ## declared, 1 to 4 while the types, the traits, the impls and the rest
    ## are resolved, 9 once the root module is.
    pub phase: int
    ## The prelude's derive templates, with its syntax and text, which the
    ## base keeps until `typeck.base` takes them (they are not copied with
    ## the program for each file).
    pub std_derives: Templates
    ## The text of each std module's derived impls (its `<derive>/NAME.sisu`
    ## module), by the module's name, which the base makes from the
    ## prelude's templates for every std module, those a program may import
    ## included: a program that imports one declares the text made here.
    pub std_derived: dict[String, String]

impl Resolver:
    pub pure def new() -> Resolver:
        let parsed: dict[String, Module] = {}
        return Resolver(
            prog=Program.new(),
            types=Types.new(),
            sources=[],
            diags=[],
            beyond=None,
            pending=[],
            aliases={},
            resolving_alias=[],
            type_params={},
            headers_done=set(),
            type_preds={},
            std_parsed=Shared(parsed),
            std_loaded={},
            deferring=False,
            deferred=[],
            other_error=False,
            noted=[],
            quiet_fns=set(),
            special_kinds={},
            copy_checks=[],
            root_text=String.new(),
            module_texts={},
            docs=[],
            catalog=Shared(Catalog.parse("")),
            derive_templates={},
            template_fns={},
            promoted=set(),
            instances_asked=0,
            instances_bounded=False,
            attrs_of={},
            generated=[],
            shims=[],
            derive_checks=[],
            std_texts={},
            std_kept=[],
            dyn_uses=[],
            phase=0,
            std_derives=Templates.none(),
            std_derived={},
        )

    ## The prelude, the ambient std modules, `target` and `builtin_impls`,
    ## resolved: `texts` gives each std module's source by name.
    pub pure def base(texts: dict[String, String]) -> Resolver:
        var r = Resolver.new()
        # The prelude's derive templates, with its syntax and text, which
        # unfold the derived impls of every std module and stay for the
        # program's.
        let prelude_text = text_of(texts, "prelude")
        let prelude_module = build.module(parse(prelude_text, Catalog.parse("")).tree)
        let templates = derive_templates(prelude_module.copy(), prelude_text)
        let prelude = r.load_std_module("prelude", prelude_module, prelude_text, templates)
        r.prog.prelude = prelude
        r.fill_well_known()
        for name in ambient():
            let m = r.load_std(name, text_of(texts, name), templates)
            let d = r.new_def(prelude, name, TextRange.empty(0), Vis.Pub, DefKind.Module(m))
            _ = r.prog.modules[prelude.index].items.insert(name.to_string(), d)
        let t = r.load_std("target", target(), templates)
        let td = r.new_def(prelude, "target", TextRange.empty(0), Vis.Pub, DefKind.Module(t))
        _ = r.prog.modules[prelude.index].items.insert("target".to_string(), td)
        _ = r.load_std("builtin_impls", builtin_impls(), templates)
        r.resolve_pending()
        r.build_variant_index(0)
        r.check_traits(0)
        # The type checker never checks the std modules' bodies: their syntax
        # goes from the program, which each file copies, and stays for
        # lowering.
        r.std_kept = r.sources.copy()
        for i in range(len(r.sources)):
            r.sources[i] = Module(ast=Ast.new(), items=[], docs=[], broken_names=[])
        # The text of each std module a program may import that has
        # templates, for their instances.
        for name in importable():
            let text = text_of(texts, name)
            if text.contains("reflect."):
                _ = r.std_texts.insert(name.to_string(), text.to_string())
        # The std modules a program may import, parsed once.
        var parsed: dict[String, Module] = {}
        for name in importable():
            let text = text_of(texts, name)
            if not text.is_empty():
                let module = build.module(parse(text, Catalog.parse("")).tree)
                _ = parsed.insert(name.to_string(), module)
        r.std_parsed = Shared(parsed)
        # Their derived impls, unfolded now on a copy that loads them all:
        # stage 0 unfolds them whenever a program loads the module, and the
        # text is the same each time.
        var all = r.copy()
        for name in importable():
            if let Some(module) = r.std_parsed.get(name.to_string()):
                _ = all.load_std_module(name, module.copy(), text_of(texts, name), templates)
        r.std_derived = all.std_derived.copy()
        # The std modules' texts were for the bounds their derived impls
        # repeat.
        r.module_texts = {}
        r.std_derives = templates
        return r

    ## A prelude of the given text alone, resolved: no ambient modules, no
    ## `target` and no `builtin_impls` (for the tests).
    pub pure def base_from(prelude_text: str) -> Resolver:
        var r = Resolver.new()
        let prelude_module = build.module(parse(prelude_text, Catalog.parse("")).tree)
        let templates = derive_templates(prelude_module.copy(), prelude_text)
        let prelude = r.load_std_module("prelude", prelude_module, prelude_text, templates)
        r.prog.prelude = prelude
        r.fill_well_known()
        r.resolve_pending()
        r.build_variant_index(0)
        r.check_traits(0)
        r.module_texts = {}
        return r

    ## Declares and resolves the root module, `module`, the syntax of a
    ## file: the base with the file's module added, a program of one module.
    pub pure def add_root(mut self, own module: Module, text: str, templates: Templates):
        let source = SourceModule(
            path=[], file=String.new(), syntax=module, text=text.to_string(), package=0
        )
        let package = SourcePackage(name=String.new(), deps=[], trusted=True)
        self.add_program([source], [package], templates)

    ## Declares and resolves a program of several modules and packages
    ## (stage 0's `resolve_session`; 09): every module of the program is
    ## declared before any import is resolved, so the modules of a package
    ## may name each other in any order; then the impls the compiler writes
    ## for each, and everything is resolved. The root module comes first,
    ## and the root package.
    pub pure def add_program(
        mut self,
        own modules: list[SourceModule],
        packages: list[SourcePackage],
        templates: Templates,
    ):
        let first_def = len(self.prog.defs)
        if not modules.is_empty():
            self.root_text = modules[0].text.copy()
        # The packages: the root package, std, then the dependencies.
        for k in range(len(packages)):
            var deps: list[(String, int)] = []
            for (n, d) in packages[k].deps:
                deps.push((n.copy(), package_id(d)))
            let data = PackageData(
                name=packages[k].name.copy(),
                trusted=packages[k].trusted or k == 0,
                deps=deps,
                root=None,
            )
            self.prog.packages.push(data)
            if k == 0:
                self.prog.packages.push(
                    PackageData(name="std".to_string(), trusted=True, deps=[], root=None)
                )
        # The program's own modules, the root module first: each is a module
        # of its package, and a child of the module its path's prefix names.
        var ids: list[ModuleId] = []
        var all_items: list[list[ItemId]] = []
        for i in range(len(modules)):
            let m = ref modules[i]
            let items = m.syntax.items.copy()
            all_items.push(items)
            var name = "main".to_string()
            if i > 0:
                name = m.path.join(".")
            let id = self.add_module(name, False, m.syntax.copy())
            self.prog.modules[id.index].package = package_id(m.package)
            self.prog.modules[id.index].path = m.path.copy()
            self.prog.modules[id.index].file = m.file.copy()
            _ = self.module_texts.insert(id, m.text.copy())
            self.prog.user_modules.push(id)
            ids.push(id)
        if let Some(root) = ids.first():
            self.prog.root = root
        if let Some(m) = modules.first():
            for n in m.syntax.broken_names:
                _ = self.prog.poisoned.add(n.copy())
        for i in range(len(modules)):
            self.link_module(ids[i], modules[i].path, modules[i].package, modules[i].file)
        # Every module's items, then the imports between them.
        self.deferring = True
        var owned: list[list[ItemId]] = []
        for i in range(len(modules)):
            let id = ids[i]
            # A dependency's tests and benchmarks are its own package's
            # business (stage 0's `own_items`).
            var items: list[ItemId] = []
            for it in all_items[i]:
                var tested = False
                match self.ast(id).item(it).kind:
                    case ItemKind.Test(_) | ItemKind.Suite(_) | ItemKind.Bench(_):
                        tested = True
                    case _:
                        pass
                if not (tested and modules[i].package != 0):
                    items.push(it)
            owned.push(items.copy())
            var declared = items.copy()
            # A script's top-level statements are its `main` (10).
            if modules[i].text.starts_with("#!"):
                declared = self.script_items(id, items)
            let prefix = test_prefix(modules[i].path)
            self.declare_items(id, declared, prefix)
            self.declare_trait_shims(id, declared)
            # The root package's doc examples are its tests too (10).
            if modules[i].package == 0:
                self.declare_doc_tests(id, declared, prefix)
        self.deferring = False
        let deferred = self.deferred.copy()
        self.deferred = []
        for (m, id) in deferred:
            self.declare_import(m, id)
        for i in range(len(modules)):
            self.declare_derived(ids[i], owned[i], templates)
            self.declare_generators(ids[i], owned[i])
        self.resolve_pending()
        self.build_variant_index(first_def)
        self.check_traits(first_def)
        self.check_borrow_signatures(first_def)
        # What is made from now on (the instances of templates) comes after
        # everything, as in stage 0.
        self.phase = 9

    ## Makes a module of the program's source the child of the module its
    ## path's prefix names (a directory with no file of its own is a module
    ## too, whose items are its children), and a package's root module the
    ## one its imports name the package by (stage 0's `link_module`).
    pure def link_module(mut self, id: ModuleId, path: list[String], package: int, file: str):
        let pid = package_id(package)
        if len(path) == 1:
            if pid < len(self.prog.packages) and self.prog.packages[pid].root.is_none():
                self.prog.packages[pid].root = Some(id)
            return
        if len(path) < 2:
            return
        var prefix = path.copy()
        let last = prefix.pop() ?? String.new()
        let parent = self.module_at(prefix, pid, file)
        let d = self.new_def(parent, last, TextRange.empty(0), Vis.Pub, DefKind.Module(id))
        _ = self.prog.modules[parent.index].items.insert(last, d)

    ## The module of the program at `path`, made (as a directory's module,
    ## with no items but its children) when no file is (stage 0's
    ## `module_at`); `pid` is its package's index in the program.
    pure def module_at(mut self, path: list[String], pid: int, file: str) -> ModuleId:
        for m in self.prog.user_modules:
            if self.prog.modules[m.index].path == path:
                return m
        let empty = Module(ast=Ast.new(), items=[], docs=[], broken_names=[])
        let id = self.add_module(path.join("."), False, empty)
        self.prog.modules[id.index].package = pid
        self.prog.modules[id.index].path = path.copy()
        self.prog.modules[id.index].file = file.to_string()
        self.prog.user_modules.push(id)
        # Linked as `link_module` would, with this package.
        if len(path) == 1:
            if pid < len(self.prog.packages) and self.prog.packages[pid].root.is_none():
                self.prog.packages[pid].root = Some(id)
        elif len(path) > 1:
            var prefix = path.copy()
            let last = prefix.pop() ?? String.new()
            let parent = self.module_at(prefix, pid, file)
            let d = self.new_def(parent, last, TextRange.empty(0), Vis.Pub, DefKind.Module(id))
            _ = self.prog.modules[parent.index].items.insert(last, d)
        return id

    ## The text of a module of the program, or of one the compiler wrote,
    ## by which a range of its syntax is read.
    pub pure def text_of_module(self, module: ModuleId) -> String:
        if let Some(t) = self.module_texts.get(module):
            return t.copy()
        return self.root_text.copy()

    ## The text at `range` of a module's text.
    pub pure def text_in(self, module: ModuleId, range: TextRange) -> String:
        if let Some(t) = self.module_texts.get(module):
            return slice_text(t, range)
        # A std module's text is the base's, which a program does not keep.
        if self.is_std(module):
            return String.new()
        return slice_text(self.root_text, range)

    ## The `from` clauses and the elision rules of every function from the
    ## definition `first` on that is not the standard library's (stage 0's
    ## `check_borrow_signatures`; 04, "Borrowing rules in detail"): stage 0
    ## reports a `from` clause on a result that cannot borrow, one that
    ## names no borrowed parameter, and a borrowing result of more than one
    ## borrowed parameter without one.
    pure def check_borrow_signatures(mut self, first: int):
        for i in range(first, len(self.prog.defs)):
            let module = self.prog.defs[i].module
            if self.prog.modules[module.index].is_std:
                continue
            let DefKind.Fn(f) = self.prog.defs[i].kind().copy() else:
                continue
            if f.header_broken:
                continue
            let shape = self.prog.result_shape(mut self.types, f.ret)
            let params = self.prog.sig_params(f)
            let def_span = self.prog.defs[i].span
            let fname = self.prog.defs[i].name.copy()
            let ret_span = f.ret_span ?? def_span
            if not f.from_.is_empty():
                if shape == ResultShape.Plain:
                    let span = f.from_spans[0]
                    let shown = self.prog.display(self.types, f.ret)
                    # The fix removes ` from a, b`: from the end of the
                    # result type to the end of the last name.
                    let last = f.from_spans[len(f.from_spans) - 1].end
                    var d = Diagnostic.new(Msg.BorrowFromWithoutBorrow, span.start, span.end)
                    d = d.with("function", fname).with("ty", shown)
                    d = d.label_with(
                        Msg.BorrowResultCannotBorrow, ret_span.start, ret_span.end, "ty", shown
                    )
                    let edit = Edit(start=ret_span.end, end=last, text=String.new())
                    self.report_other(module, d.fix_params(Msg.BorrowRemoveFrom, [], [edit]))
                    continue
                for k in range(len(f.from_)):
                    let name = f.from_[k].copy()
                    var ok = False
                    var named = False
                    for p in params:
                        if p.name == name:
                            named = True
                            if self.prog.is_borrowed_param(mut self.types, p):
                                ok = True
                    if not ok:
                        let span = f.from_spans[k]
                        var d = Diagnostic.new(Msg.BorrowFromNotAParameter, span.start, span.end)
                        d = d.with("name", name).with("function", fname)
                        if named:
                            # Where the parameter is written; `self` has no
                            # span of its own.
                            var at = def_span
                            for p in f.params:
                                if p.name == name:
                                    at = p.span
                                    break
                            d = d.label_with(
                                Msg.BorrowNotBorrowedParam, at.start, at.end, "name", name
                            )
                        else:
                            var label = Label(
                                msg=Msg.BorrowNoSuchParam,
                                start=def_span.start,
                                end=def_span.end,
                                params=[
                                    MsgParam(name="function".to_string(), value=fname.copy()),
                                    MsgParam(name="name".to_string(), value=name.copy()),
                                ],
                            )
                            d.labels.push(label)
                        self.report_other(module, d)
                continue
            if shape == ResultShape.Plain:
                continue
            var borrowed: list[String] = []
            for p in params:
                if self.prog.is_borrowed_param(mut self.types, p):
                    borrowed.push(p.name.copy())
            let self_wins = f.self_mode.is_some()
                and not borrowed.is_empty()
                and borrowed[0] == "self"
            if len(borrowed) >= 2 and not self_wins:
                var names = String.new()
                for n in borrowed:
                    if not names.is_empty():
                        names.push(", ")
                    names.push(n)
                let shown = self.prog.display(self.types, f.ret)
                var d = Diagnostic.new(Msg.BorrowFromRequired, ret_span.start, ret_span.end)
                d = d.with("name", self.prog.defs[i].name).with("ret", shown).with("params", names)
                for n in borrowed:
                    # Where the parameter is written; `self` has no span of
                    # its own.
                    var at = def_span
                    for p in f.params:
                        if p.name == n:
                            at = p.span
                            break
                    d = d.label_with(Msg.BorrowBorrowedParam, at.start, at.end, "name", n)
                # The fix names them all, which is always allowed; the author
                # may then drop the ones the result never borrows.
                let edit = Edit(start=ret_span.end, end=ret_span.end, text=" from {names}")
                let param = MsgParam(name="param".to_string(), value=names.copy())
                self.report_other(module, d.fix_params(Msg.BorrowAddFrom, [param], [edit]))

    ## The program, its table of types and the root module's syntax.
    pub pure def into_parts(own self) -> (Program, Types, Module):
        var sources = self.sources
        var root = Module(ast=Ast.new(), items=[], docs=[], broken_names=[])
        let at = self.prog.root.index
        if at < len(sources):
            # The modules the root module imports come after it.
            while len(sources) > at + 1:
                _ = sources.pop()
            root = sources.pop() ?? root
        return (self.prog, self.types, root)

    ## The syntax of the module of doc examples, when there is one.
    pub pure def doc_syntax(self) -> Module?:
        let (m, _) = self.docs.first() else:
            return None
        if m.index >= len(self.sources):
            return None
        return Some(self.sources[m.index].copy())

    pub pure def add_module(mut self, name: str, is_std: bool, own module: Module) -> ModuleId:
        let id = ModuleId(index=len(self.prog.modules))
        self.prog.modules.push(ModuleData.new(name, is_std))
        self.sources.push(module)
        return id

    ## `@comptime_budget(steps=N)` (08): the item's own budget for its
    ## `comptime` expressions; one written otherwise is stage 0's
    ## `comptime.budget-attribute`.
    pure def comptime_budget(mut self, module: ModuleId, def_: DefId, attrs: list[Attr]):
        for a in attrs:
            if a.name != "comptime_budget":
                continue
            var steps: int? = None
            if len(a.args) == 1:
                if let Some(n) = a.args[0].name:
                    if n.text == "steps":
                        if let ExprKind.Int(_, value, suffix) = self.ast(module).expr(
                            a.args[0].value
                        ).kind:
                            if let Some(v) = value:
                                if suffix.is_none():
                                    if let Some(k) = v.to_int():
                                        if k > 0:
                                            steps = Some(k)
            match steps:
                case Some(k):
                    _ = self.prog.comptime_budgets.insert(def_, k)
                case None:
                    # The attribute without the line break after it.
                    let written = self.text_in(module, a.range)
                    let end = a.range.start + written.trim_end().byte_len()
                    let d = Diagnostic.new(Msg.ComptimeBudgetAttribute, a.range.start, end)
                    self.report_other(module, d)

    ## Whether the std module `name` is loaded.
    pub pure def is_loaded(self, name: str) -> bool:
        return self.std_loaded.contains(name.to_string())

    pure def load_std(mut self, name: str, text: str, templates: Templates) -> ModuleId:
        let module = build.module(parse(text, Catalog.parse("")).tree)
        return self.load_std_module(name, module, text, templates)

    ## Declares a parsed std module, once, and its derived impls: unfolded
    ## from the prelude's `templates` while the base is made, with the
    ## module's `text` for the bounds they repeat; the text the base made
    ## (`std_derived`) for a module a program imports.
    pure def load_std_module(
        mut self, name: str, own module: Module, text: str, templates: Templates
    ) -> ModuleId:
        if let Some(m) = self.std_loaded.get(name.to_string()):
            return m
        let items = module.items.copy()
        let m = self.add_module(name, True, module)
        _ = self.std_loaded.insert(name.to_string(), m)
        if not text.is_empty():
            _ = self.module_texts.insert(m, text.to_string())
        self.declare_items(m, items, "")
        self.declare_derived(m, items, templates)
        return m

    pure def fill_well_known(mut self):
        let p = self.prog.prelude
        var wk = WellKnown.none()
        wk.option = self.prog.lookup_in(p, "Option")
        wk.result = self.prog.lookup_in(p, "Result")
        wk.ordering = self.prog.lookup_in(p, "Ordering")
        wk.string = self.prog.lookup_in(p, "String")
        wk.list = self.prog.lookup_in(p, "list")
        wk.dict = self.prog.lookup_in(p, "dict")
        wk.set = self.prog.lookup_in(p, "set")
        wk.iter = self.prog.lookup_in(p, "Iter")
        wk.iterable = self.prog.lookup_in(p, "Iterable")
        wk.range = self.prog.lookup_in(p, "range")
        wk.boxed = self.prog.lookup_in(p, "Box")
        wk.display = self.prog.lookup_in(p, "Display")
        wk.debug = self.prog.lookup_in(p, "Debug")
        wk.eq = self.prog.lookup_in(p, "Eq")
        wk.partial_ord = self.prog.lookup_in(p, "PartialOrd")
        wk.ord = self.prog.lookup_in(p, "Ord")
        wk.hash = self.prog.lookup_in(p, "Hash")
        wk.len = self.prog.lookup_in(p, "Len")
        wk.copy = self.prog.lookup_in(p, "Copy")
        wk.drop = self.prog.lookup_in(p, "Drop")
        wk.iterator = self.prog.lookup_in(p, "Iterator")
        wk.add = self.prog.lookup_in(p, "Add")
        wk.sub = self.prog.lookup_in(p, "Sub")
        wk.mul = self.prog.lookup_in(p, "Mul")
        wk.div = self.prog.lookup_in(p, "Div")
        wk.rem = self.prog.lookup_in(p, "Rem")
        wk.neg = self.prog.lookup_in(p, "Neg")
        wk.from_literal = self.prog.lookup_in(p, "FromLiteral")
        wk.send = self.prog.lookup_in(p, "Send")
        wk.sync = self.prog.lookup_in(p, "Sync")
        wk.escapable = self.prog.lookup_in(p, "Escapable")
        wk.system = self.prog.lookup_in(p, "System")
        wk.formatter = self.prog.lookup_in(p, "Formatter")
        wk.fs_ops = self.prog.lookup_in(p, "FsOps")
        wk.net_ops = self.prog.lookup_in(p, "NetOps")
        wk.clock_ops = self.prog.lookup_in(p, "ClockOps")
        wk.rand_ops = self.prog.lookup_in(p, "RandOps")
        wk.env_ops = self.prog.lookup_in(p, "EnvOps")
        wk.stdin_ops = self.prog.lookup_in(p, "StdinOps")
        wk.proc_ops = self.prog.lookup_in(p, "ProcOps")
        self.prog.wk = wk

    pub pure def is_std(self, module: ModuleId) -> bool:
        return self.prog.modules[module.index].is_std

    pure def is_root(self, module: ModuleId) -> bool:
        return not self.is_std(module)

    ## A diagnostic of a type's constant argument: the type checker's are
    ## kept, and the others reported but an undefined name, which the name
    ## pass reports.
    pure def report_const(mut self, module: ModuleId, own d: Diagnostic):
        if d.msg.id().starts_with("type."):
            self.diags.push((module, d))
        elif d.msg == Msg.ResolveUndefinedName:
            if self.is_root(module):
                self.other_error = True
        else:
            self.report_other(module, d)

    ## A constant's value as folding reads it.
    pure def value_terms(self, module: ModuleId, value: ExprId?) -> list[Term]:
        let e = value else:
            return []
        return folding.terms(self.ast(module), e)

    ## Puts the root module beyond the slice, for `why`.
    pure def beyond_in(mut self, module: ModuleId, why: str):
        if self.is_root(module) and self.beyond.is_none():
            self.beyond = Some(why.to_string())

    ## `stage0.unsupported` at `range` of `module`: a construct stage 0
    ## does not implement yet.
    pure def unsupported_in(
        mut self, module: ModuleId, range: TextRange, construct: str, phase: str
    ):
        var d = Diagnostic.new(Msg.Stage0Unsupported, range.start, range.end)
        self.report_other(module, d.with("construct", construct).with("phase", phase))

    ## `resolve.type-argument-count` for `name` at `range` of `module`.
    pure def argument_count(
        mut self, module: ModuleId, range: TextRange, name: str, expected: int, found: int
    ):
        var d = Diagnostic.new(Msg.ResolveTypeArgumentCount, range.start, range.end).with(
            "name", name
        )
        self.report_other(module, d.with("expected", "{expected}").with("found", "{found}"))

    ## Reports `m` at `at` with one parameter, for the module `module`.
    pure def report_at(mut self, module: ModuleId, m: Msg, at: TextRange, name: str, value: str):
        let diag = Diagnostic.new(m, at.start, at.end).with(name, value)
        self.diags.push((module, diag))

    pub pure def new_def(
        mut self, module: ModuleId, name: str, range: TextRange, vis: Vis, own kind: DefKind
    ) -> DefId:
        let id = DefId(index=len(self.prog.defs))
        self.prog.defs.push(Def.new(name.to_string(), module, range, vis, kind))
        self.prog.phases.push(self.phase)
        return id

    ## Declares a name in a module; a second declaration is the name pass's
    ## to report, and the first stays.
    pure def bind(mut self, module: ModuleId, name: str, def_: DefId):
        if name.is_empty():
            return
        if self.prog.modules[module.index].items.contains(name.to_string()):
            # `resolve.duplicate-definition`.
            if self.is_root(module):
                self.other_error = True
            return
        _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        self.prog.modules[module.index].order.push(def_)

    ## Reports an error of the resolver's that is not the type checker's
    ## own (a `resolve.` or `borrow.` message) in `module`, when that is
    ## the root module: `check` prints it with the rest.
    pub pure def report_other(mut self, module: ModuleId, own d: Diagnostic):
        if self.is_root(module):
            self.other_error = True
            self.diags.push((module, d))

    ## Where `keyword` is written last before byte `start` on its line, as an
    ## empty range for a fix to write before it (stage 0's `keyword_before`).
    pure def keyword_before(self, module: ModuleId, start: int, keyword: str) -> int?:
        let owned = self.text_of_module(module)
        let text: str = owned
        if start > text.byte_len():
            return None
        var line_start = start
        while line_start > 0 and text.byte_at(line_start - 1) != 10:
            line_start -= 1
        let line = text.byte_slice(line_start, start)
        var found: int? = None
        var from_ = 0
        while let Some(k) = line.byte_slice(from_, line.byte_len()).find(keyword):
            found = Some(line_start + from_ + k)
            from_ = from_ + k + 1
        return found

    ## A signature as an impl must write it (stage 0's `signature_text`):
    ## `pure def name(self, x: T) -> R`, each type substituted with `args`,
    ## when given, and normalized, shown with the generic parameters named
    ## `names`.
    pure def signature_text(
        mut self, name: str, f: FnInfo, args: list[Ty]?, env: list[Predicate], names: list[String]
    ) -> String:
        var parts = String.new()
        if let Some(m) = f.self_mode:
            parts.push("{mode_text(m)}self")
        for p in f.params:
            if not parts.is_empty():
                parts.push(", ")
            parts.push("{mode_text(p.mode)}{p.name}: {self.signature_ty(p.ty, args, env, names)}")
        var ret = String.new()
        if f.ret != Ty.unit():
            ret = " -> {self.signature_ty(f.ret, args, env, names)}"
        let prefix = if f.pure: "pure " else: ""
        return "{prefix}def {name}({parts}){ret}"

    pure def signature_ty(
        mut self, t: Ty, args: list[Ty]?, env: list[Predicate], names: list[String]
    ) -> String:
        var ty = t
        if let Some(a) = args:
            let s = self.types.subst(t, a)
            ty = self.prog.normalize(mut self.types, s, env)
        return self.prog.display_in(self.types, ty, names)

    ## Notes that stage 0 reports an error of the resolver's in `module`,
    ## when that is the root module (the compiler's modules are checked by
    ## what they are written from).
    pub pure def note_error(mut self, module: ModuleId, rule: str):
        if self.is_root(module):
            self.other_error = True
            self.noted.push(rule.to_string())

    pub pure def placeholder_fn(self, own kind: FnKind) -> FnInfo:
        return FnInfo(
            generics=[],
            impl_generics=0,
            predicates=[],
            trait_=None,
            impl_=None,
            self_mode=None,
            owner=None,
            params=[],
            keyword_only_from=None,
            positional_only_until=0,
            ret=Ty.unit(),
            ret_span=None,
            err_inferred=False,
            pure=False,
            comptime_=False,
            intrinsic=None,
            structural=None,
            keeps=[],
            from_=[],
            from_spans=[],
            internal=False,
            body=None,
            kind=kind,
            header_broken=False,
            body_broken=False,
            contracts=False,
            template=False,
        )

    pub pure def ast(self, module: ModuleId) -> ref Ast:
        return ref self.sources[module.index].ast

    # ---------------------------------------------------------------- pass 1

    pub pure def declare_items(mut self, module: ModuleId, items: list[ItemId], test_prefix: str):
        var attributed: list[(String, list[(String, list[String])])] = []
        for id in items:
            let item = self.sources[module.index].ast.item(id).copy()
            # The attributes of a type of the program, as data for
            # `reflect.attributes_of`.
            if not self.is_std(module) and not item.attrs.is_empty():
                var type_name: String? = None
                match item.kind:
                    case ItemKind.Struct(s):
                        type_name = Some(s.name.text.copy())
                    case ItemKind.Enum(e):
                        type_name = Some(e.name.text.copy())
                    case ItemKind.ErrorSet(e):
                        type_name = Some(e.name.text.copy())
                    case _:
                        pass
                if let Some(n) = type_name:
                    var attrs: list[(String, list[String])] = []
                    for a in item.attrs:
                        var args: list[String] = []
                        for x in a.args:
                            args.push(self.text_in(module, x.range))
                        attrs.push((a.name.copy(), args))
                    attributed.push((n.copy(), attrs))
            match item.kind:
                case ItemKind.Fn(f):
                    let info = self.placeholder_fn(FnKind.Free)
                    let def_ = self.new_def(
                        module, f.name.text, f.name.range, item.vis, DefKind.Fn(info)
                    )
                    self.bind(module, f.name.text, def_)
                    self.comptime_budget(module, def_, item.attrs)
                    self.pending.push(
                        Pending.Fn(def_=def_, module=module, ast=f.copy(), owner=None)
                    )
                case ItemKind.Struct(s):
                    let info = StructInfo(
                        generics=[],
                        fields=[],
                        builtin=None,
                        copy=False,
                        view_=s.is_view,
                        must_consume=False,
                        derives=[],
                        drop=None,
                    )
                    let def_ = self.new_def(
                        module, s.name.text, s.name.range, item.vis, DefKind.Struct(info)
                    )
                    self.bind(module, s.name.text, def_)
                    _ = self.type_params.insert(def_, s.generics.copy())
                    self.declare_methods(module, def_, s.methods)
                    for c in s.consts:
                        self.declare_assoc_const(module, TyKey.Adt(def_), s.name.text, c)
                    # `invariant e` lines (07): a method of the struct that
                    # checks them, which construction, every `mut self`
                    # method and the `Mutex` rule call.
                    if not s.invariants.is_empty():
                        self.declare_invariant(module, def_, item.node, s)
                    self.pending.push(
                        Pending.Struct(
                            def_=def_, module=module, ast=s.copy(), attrs=item.attrs.copy()
                        )
                    )
                case ItemKind.Enum(e):
                    self.declare_enum(module, e, item.vis, item.attrs, False)
                case ItemKind.ErrorSet(e):
                    self.declare_enum(module, e, item.vis, item.attrs, True)
                case ItemKind.Impl(i):
                    self.pending.push(Pending.Impl(module=module, ast=i.copy(), range=item.range))
                case ItemKind.Trait(t):
                    let def_ = self.new_def(
                        module, t.name.text, t.name.range, item.vis, DefKind.Trait(TraitInfo.new())
                    )
                    self.bind(module, t.name.text, def_)
                    _ = self.type_params.insert(def_, t.generics.copy())
                    # The trait's derive, which `@derive` runs at compile time.
                    for m in t.methods:
                        if not m.is_comptime or m.name.text != "derive":
                            continue
                        let source = self.text_of_module(module)
                        let src = Src(ast=ref self.sources[module.index].ast, source=source)
                        if template_parts(src, m).is_some():
                            if not self.is_std(module):
                                let key = (module.index, t.name.text.copy())
                                _ = self.derive_templates.insert(key, m.copy())
                        else:
                            let at = m.name.range
                            let d = Diagnostic.new(Msg.ComptimeDeriveTemplate, at.start, at.end)
                            self.report_other(module, d.with("trait", t.name.text))
                    self.pending.push(
                        Pending.Trait(
                            def_=def_, module=module, ast=t.copy(), attrs=item.attrs.copy()
                        )
                    )
                case ItemKind.Import(_) | ItemKind.FromImport(_):
                    if self.deferring:
                        self.deferred.push((module, id))
                    else:
                        self.declare_import(module, id)
                case ItemKind.Test(t):
                    let name = prefixed(test_prefix, t.name)
                    # A parametrised test is a test for each case (17).
                    for (case_name, case_def) in self.test_cases(module, name, t):
                        let info = self.placeholder_fn(FnKind.Test(case_name.copy()))
                        let def_ = self.new_def(
                            module, case_name, t.name_range, Vis.Private, DefKind.Fn(info)
                        )
                        self.prog.tests.push(def_)
                        self.pending.push(
                            Pending.Test(def_=def_, module=module, ast=case_def.copy())
                        )
                case ItemKind.Suite(s):
                    let prefix = prefixed(test_prefix, s.name)
                    self.declare_items(module, s.items, prefix)
                # A benchmark is checked like a test; `sisu bench` runs it.
                case ItemKind.Bench(t):
                    let name = prefixed(test_prefix, t.name)
                    let info = self.placeholder_fn(FnKind.Test(name.copy()))
                    let def_ = self.new_def(
                        module, name, t.name_range, Vis.Private, DefKind.Fn(info)
                    )
                    self.prog.benches.push(def_)
                    self.pending.push(Pending.Test(def_=def_, module=module, ast=t.copy()))
                case ItemKind.Const(c):
                    # The value is known from here on, for a type's
                    # constant argument that names it (`typeck.consts`).
                    let ts = self.value_terms(module, c.value)
                    let info = ConstInfo(ty=Ty.error(), value=c.value, terms=ts)
                    let def_ = self.new_def(
                        module, c.name.text, c.name.range, item.vis, DefKind.Const(info)
                    )
                    self.bind(module, c.name.text, def_)
                    self.comptime_budget(module, def_, item.attrs)
                    self.pending.push(Pending.Const(def_=def_, module=module, ast=c.copy()))
                case ItemKind.TypeAlias(a):
                    if a.refinement:
                        # The predicate as written, which a failed conversion
                        # shows.
                        var text = String.new()
                        if let Some(p) = a.predicate:
                            let r = self.ast(module).expr(p).range
                            text = self.text_in(module, r).trim().to_string()
                        let info = RefinementInfo(
                            generics=[], base=Ty.error(), predicate=None, text=text
                        )
                        let def_ = self.new_def(
                            module, a.name.text, a.name.range, item.vis, DefKind.Refinement(info)
                        )
                        self.bind(module, a.name.text, def_)
                        _ = self.type_params.insert(def_, a.generics.copy())
                        self.pending.push(
                            Pending.Refinement(
                                def_=def_,
                                module=module,
                                ast=a.copy(),
                                node=item.node,
                                range=item.range,
                            )
                        )
                    else:
                        let def_ = self.new_def(
                            module,
                            a.name.text,
                            a.name.range,
                            item.vis,
                            DefKind.TypeAlias(Ty.error()),
                        )
                        self.bind(module, a.name.text, def_)
                        _ = self.aliases.insert(def_, (module, a.copy()))
                case ItemKind.Extern(_):
                    # Nothing is declared.
                    self.unsupported_in(
                        module, item.range, "`extern`", "foreign functions (Phase 8)"
                    )
                case _:
                    pass
        for (n, attrs) in attributed:
            if let Some(d) = self.prog.modules[module.index].items.get(n):
                _ = self.attrs_of.insert(d, attrs.copy())

    pure def declare_enum(
        mut self, module: ModuleId, e: EnumDef, vis: Vis, attrs: list[Attr], error_set: bool
    ):
        let info = EnumInfo(
            generics=[],
            variants=[],
            open=e.open,
            copy=False,
            must_consume=False,
            derives=[],
            drop=None,
        )
        let kind = if error_set: DefKind.ErrorSet(info) else: DefKind.Enum(info)
        let def_ = self.new_def(module, e.name.text, e.name.range, vis, kind)
        self.bind(module, e.name.text, def_)
        _ = self.type_params.insert(def_, e.generics.copy())
        self.declare_methods(module, def_, e.methods)
        self.pending.push(Pending.Enum(def_=def_, module=module, ast=e.copy(), attrs=attrs.copy()))

    pure def declare_methods(mut self, module: ModuleId, owner: DefId, methods: list[FnDef]):
        for m in methods:
            let vis = if self.is_std(module): Vis.Pub else: m.vis
            let info = self.placeholder_fn(FnKind.Method)
            let def_ = self.new_def(module, m.name.text, m.name.range, vis, DefKind.Fn(info))
            self.pending.push(
                Pending.Fn(def_=def_, module=module, ast=m.copy(), owner=Some(Owner.Type(owner)))
            )

    # ---------------------------------------------------------------- pass 2

    pub pure def resolve_pending(mut self):
        # The generic parameters of every type and trait first.
        self.resolve_headers()
        # Aliases next, so that later declarations can use them.
        var alias_ids: list[int] = []
        for d in self.aliases.keys():
            if not self.headers_done.contains(d):
                alias_ids.push(d.index)
        alias_ids.sort()
        for i in alias_ids:
            _ = self.headers_done.add(DefId(index=i))
        for i in alias_ids:
            _ = self.resolve_alias(DefId(index=i))
        # Types, then traits, then impls, then functions.
        var pending: list[Pending] = []
        while let Some(p) = self.pending.pop():
            pending.push(p)
        pending.reverse()
        for p in pending:
            if let Pending.Trait(def_, module, t, attrs) = p:
                self.resolve_trait_header(def_, module, t, attrs)
        var types: list[Pending] = []
        var traits: list[Pending] = []
        var impls: list[Pending] = []
        var rest: list[Pending] = []
        for p in own pending:
            match p:
                case Pending.Struct(_, _, _, _) | Pending.Enum(_, _, _, _):
                    types.push(p)
                case Pending.Refinement(_, _, _, _, _):
                    types.push(p)
                case Pending.Trait(_, _, _, _):
                    traits.push(p)
                case Pending.Impl(_, _, _):
                    impls.push(p)
                case _:
                    rest.push(p)
        let declaring = self.phase
        self.phase = max(declaring, 1)
        for p in own types:
            self.resolve_one(p)
        self.phase = max(declaring, 2)
        for p in own traits:
            self.resolve_one(p)
        self.phase = max(declaring, 3)
        for p in own impls:
            self.resolve_one(p)
        self.phase = max(declaring, 4)
        var queue = rest
        # Traits and impls push the functions they declare, which follow in
        # the order they were pushed.
        var pushed: list[Pending] = []
        while let Some(p) = self.pending.pop():
            pushed.push(p)
        pushed.reverse()
        for p in own pushed:
            queue.push(p)
        while not queue.is_empty():
            for p in own queue:
                self.resolve_one(p)
            queue = []
            var more: list[Pending] = []
            while let Some(p) = self.pending.pop():
                more.push(p)
            more.reverse()
            queue = more
        self.phase = declaring

    pure def resolve_alias(mut self, d: DefId) -> Ty:
        if let DefKind.TypeAlias(t) = self.prog.defs[d.index].kind():
            if t != Ty.error():
                return t
        let entry = self.aliases.get(d) else:
            return Ty.error()
        let module = entry.0
        let alias = entry.1.copy()
        if self.resolving_alias.contains(d):
            let at = alias.name.range
            let diag = Diagnostic.new(Msg.ResolveAliasCycle, at.start, at.end)
            self.report_other(module, diag.with("name", alias.name.text))
            return Ty.error()
        self.resolving_alias.push(d)
        var names: list[String] = []
        for g in alias.generics:
            names.push(g.name.text.copy())
        let ctx = TyCtx.plain(module, names, self.is_std(module))
        var ty = Ty.error()
        if let Some(t) = alias.ty:
            if let TypeKind.Union(_) = self.ast(module).type_expr(t).kind:
                ty = self.resolve_error_set(t, ctx)
            else:
                ty = self.resolve_ty(t, ctx)
        _ = self.resolving_alias.pop()
        self.prog.defs[d.index].set_kind(DefKind.TypeAlias(ty))
        return ty

    ## Whether an attribute list has `@derive(what)`.
    pure def has_derive(self, module: ModuleId, attrs: list[Attr], what: str) -> bool:
        return self.derives(module, attrs).contains(what.to_string())

    ## The names `@derive(...)` and `@delegate(...)` list.
    pure def derives(self, module: ModuleId, attrs: list[Attr]) -> list[String]:
        var out: list[String] = []
        for a in attrs:
            if a.name != "derive" and a.name != "delegate":
                continue
            for arg in a.args:
                if let ExprKind.Name(n) = self.ast(module).expr(arg.value).kind:
                    out.push(n.copy())
        return out

    ## The text of `@name("...")`, its first argument.
    pure def builtin_attr(self, module: ModuleId, attrs: list[Attr], name: str) -> String?:
        for a in attrs:
            if a.name == name:
                if let Some(arg) = a.args.first():
                    if let ExprKind.Str(parts) = self.ast(module).expr(arg.value).kind:
                        return Some(build.plain_text(parts))
                return None
        return None

    pure def resolve_one(mut self, own p: Pending):
        match p:
            case Pending.Struct(def_, module, s, attrs):
                self.resolve_struct(def_, module, s, attrs)
            case Pending.Enum(def_, module, e, attrs):
                self.resolve_enum(def_, module, e, attrs)
            case Pending.Trait(def_, module, t, _):
                self.resolve_trait(def_, module, t)
            case Pending.Fn(def_, module, f, owner):
                self.resolve_fn(def_, module, f, owner)
            case Pending.Test(def_, module, t):
                self.resolve_test(def_, module, t)
            case Pending.Const(def_, module, c):
                var ty = Ty.error()
                match c.ty:
                    case Some(t):
                        ty = self.resolve_ty(t, TyCtx.plain(module, [], False))
                    case None:
                        let at = c.name.range
                        let d = Diagnostic.new(Msg.ResolveConstTypeRequired, at.start, at.end)
                        self.report_other(module, d.with("name", c.name.text))
                let ts = self.value_terms(module, c.value)
                let info = ConstInfo(ty=ty, value=c.value, terms=ts)
                self.prog.defs[def_.index].set_kind(DefKind.Const(info))
            case Pending.Impl(module, imp, rng):
                self.resolve_impl(module, imp, rng)
            case Pending.Refinement(def_, module, a, node, rng):
                var names: list[String] = []
                for g in a.generics:
                    names.push(g.name.text.copy())
                var ctx = TyCtx.plain(module, names, False)
                ctx.predicates = self.preds_of(def_)
                var base = Ty.error()
                if let Some(t) = a.ty:
                    base = self.resolve_ty(t, ctx)
                # A refinement of a refinement keeps it as its base; a chain
                # that comes back is a cycle (`resolve.alias-cycle`).
                var at = base
                var cycle = False
                for _ in range(64):
                    let TyData.Adt(d, args) = self.types.data(at).copy() else:
                        break
                    if d == def_:
                        cycle = True
                        break
                    let b = self.prog.refinement_base(mut self.types, d, args) else:
                        break
                    at = b
                if cycle:
                    let d = Diagnostic.new(
                        Msg.ResolveAliasCycle, a.name.range.start, a.name.range.end
                    )
                    self.report_other(module, d.with("name", a.name.text))
                    base = Ty.error()
                var kind_now = self.prog.defs[def_.index].kind().copy()
                if let DefKind.Refinement(r) = ref mut kind_now:
                    r.base = base
                self.prog.defs[def_.index].set_kind(kind_now)
                self.declare_predicate(module, def_, node, a, rng)

    pure def resolve_struct(
        mut self, def_: DefId, module: ModuleId, s: StructDef, attrs: list[Attr]
    ):
        let (names, predicates) = self.type_param_scope(def_)
        let self_ty = self.self_type(def_, len(names))
        var fields: list[FieldInfo] = []
        for f in s.fields:
            var dup = False
            for x in fields:
                if x.name == f.name.text:
                    dup = True
            if dup:
                continue
            var ctx = TyCtx.plain(module, names, True)
            ctx.self_ty = Some(self_ty)
            ctx.predicates = predicates.copy()
            let ty = self.resolve_ty(f.ty, ctx)
            let at = self.ast(module).type_expr(f.ty).range
            self.check_sized(module, ty, at)
            # Views are infectious upwards (04): only a `view struct` may
            # hold a reference or a view (`borrow.view-field-in-plain-struct`).
            if not self.is_std(module)
                    and not s.is_view
                    and self.prog.is_view_type(mut self.types, ty):
                let whole = f.name.range.cover(at)
                let fty = self.prog.display(self.types, ty)
                let named = s.name.range
                var d = Diagnostic.new(Msg.BorrowViewFieldInPlainStruct, whole.start, whole.end)
                d = d.with("ty", s.name.text).with("field", f.name.text).with("fty", fty)
                d = d.label_with(
                    Msg.BorrowTypeDeclaredHere, named.start, named.end, "ty", s.name.text
                )
                # The fix writes `view ` before the `struct` keyword.
                var edits: list[Edit] = []
                if let Some(k) = self.keyword_before(module, named.start, "struct"):
                    edits.push(Edit(start=k, end=k, text="view ".to_string()))
                let param = MsgParam(name="ty".to_string(), value=s.name.text.copy())
                self.report_other(module, d.fix_params(Msg.BorrowDeclareView, [param], edits))
            fields.push(
                FieldInfo(
                    name=f.name.text.copy(), ty=ty, default=f.default, span=f.range, vis=f.vis
                )
            )
        if not s.unsupported.is_empty():
            self.beyond_in(module, "a contract in a struct")
        let builtin = self.builtin_attr(module, attrs, "builtin")
        let copy = self.has_derive(module, attrs, "Copy")
        let must_consume = has_attr(attrs, "must_consume")
        let derives = self.derives(module, attrs)
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Struct(info) = ref mut kind_now:
            info.fields = fields
            info.builtin = builtin
            info.copy = copy
            info.must_consume = must_consume
            info.derives = derives
        self.prog.defs[def_.index].set_kind(kind_now)

    pure def resolve_enum(mut self, def_: DefId, module: ModuleId, e: EnumDef, attrs: list[Attr]):
        let (names, predicates) = self.type_param_scope(def_)
        let self_ty = self.self_type(def_, len(names))
        let std = self.is_std(module)
        var variants: list[VariantInfo] = []
        for v in e.variants:
            var dup = False
            for x in variants:
                if x.name == v.name.text:
                    dup = True
            if dup:
                continue
            var ctx = TyCtx.plain(module, names, std)
            ctx.self_ty = Some(self_ty)
            ctx.predicates = predicates.copy()
            var fields: list[(String?, Ty)] = []
            for f in v.fields:
                let ty = self.resolve_ty(f.ty, ctx)
                let at = self.ast(module).type_expr(f.ty).range
                self.check_sized(module, ty, at)
                # An enum has no `view` form (`borrow.view-in-enum`).
                if not std and self.prog.is_view_type(mut self.types, ty):
                    let fty = self.prog.display(self.types, ty)
                    let named = e.name.range
                    var d = Diagnostic.new(Msg.BorrowViewInEnum, at.start, at.end)
                    d = d.with("ty", e.name.text).with("fty", fty)
                    d = d.label_with(
                        Msg.BorrowTypeDeclaredHere, named.start, named.end, "ty", e.name.text
                    )
                    self.report_other(module, d)
                var fname: String? = None
                if let Some(n) = f.name:
                    fname = Some(n.text.copy())
                fields.push((fname, ty))
            variants.push(VariantInfo(name=v.name.text.copy(), fields=fields, span=v.range))
        let copy = self.has_derive(module, attrs, "Copy")
        let must_consume = has_attr(attrs, "must_consume")
        let derives = self.derives(module, attrs)
        var kind_now = self.prog.defs[def_.index].kind().copy()
        match ref mut kind_now:
            case DefKind.Enum(info):
                info.variants = variants
                info.copy = copy
                info.must_consume = must_consume
                info.derives = derives
            case DefKind.ErrorSet(info):
                info.variants = variants
                info.copy = copy
                info.must_consume = must_consume
                info.derives = derives
            case _:
                pass
        self.prog.defs[def_.index].set_kind(kind_now)

    pure def resolve_test(mut self, def_: DefId, module: ModuleId, t: TestDef):
        let name = self.prog.defs[def_.index].name.copy()
        var info = self.placeholder_fn(FnKind.Test(name))
        for p in t.params:
            if let ParamKind.Named(n, ty, _) = p.kind:
                let resolved = self.resolve_ty(ty, TyCtx.plain(module, [], False))
                info.params.push(
                    ParamInfo(
                        name=n.text.copy(), mode=p.mode, ty=resolved, default=None, span=p.range
                    )
                )
        info.body = t.body.copy()
        self.prog.defs[def_.index].set_kind(DefKind.Fn(info))

    ## `Adt(d, [Param(0), ..., Param(n - 1)])`: a type in terms of its own
    ## parameters.
    pure def self_type(mut self, d: DefId, n: int) -> Ty:
        var args: list[Ty] = []
        for i in range(n):
            args.push(self.types.param(i))
        return self.types.adt(d, args)

    ## The names and bounds of a struct's or enum's generic parameters.
    pure def type_param_scope(self, d: DefId) -> (list[String], list[Predicate]):
        var names: list[String] = []
        for g in self.prog.type_generics(d):
            names.push(g.name.copy())
        return (names, self.preds_of(d))

    pure def resolve_fn(mut self, def_: DefId, module: ModuleId, f: FnDef, owner: Owner?):
        # The generics, bounds and `Self` the owner brings.
        var outer: list[Generic] = []
        var outer_names: list[String] = []
        var predicates: list[Predicate] = []
        var self_ty: Ty? = None
        var in_trait: DefId? = None
        var impl_def: DefId? = None
        match owner:
            case Some(Owner.Type(t)):
                outer = self.prog.type_generics(t)
                for g in outer:
                    outer_names.push(g.name.copy())
                predicates = self.preds_of(t)
                self_ty = Some(self.self_type(t, len(outer)))
            case Some(Owner.Inherent(generics, names, preds, st)):
                outer = generics.copy()
                outer_names = names.copy()
                predicates = preds.copy()
                self_ty = Some(st)
            case Some(Owner.Trait(t)):
                var generics = [Generic(name="Self".to_string(), default=None, is_const=False)]
                if let Some(info) = self.prog.trait_info(t):
                    for g in info.generics:
                        generics.push(g.copy())
                for g in generics:
                    outer_names.push(g.name.copy())
                var args: list[Ty] = []
                for i in range(1, len(generics)):
                    args.push(self.types.param(i))
                let tr = TraitRef(def_=t, args=args)
                predicates = [
                    Predicate(ty=self.types.param(0), bound=tr, span=self.prog.defs[t.index].span)
                ]
                outer = generics
                self_ty = Some(self.types.param(0))
                in_trait = Some(t)
            case Some(Owner.Impl(i)):
                if let Some(info) = self.prog.impl_info(i):
                    outer = info.generics.copy()
                    for g in info.generics:
                        outer_names.push(g.name.copy())
                    predicates = info.predicates.copy()
                    self_ty = Some(info.self_ty)
                    impl_def = Some(i)
            case Some(Owner.Refinement(r)):
                outer = self.prog.type_generics(r)
                for g in outer:
                    outer_names.push(g.name.copy())
                predicates = self.preds_of(r)
                if let Some(ri) = self.prog.refinement(r):
                    self_ty = Some(ri.base)
            case _:
                pass
        var names = outer_names.copy()
        for g in f.generics:
            names.push(g.name.text.copy())
        var generics = outer.copy()
        for k in range(len(f.generics)):
            let g = ref f.generics[k]
            # A function's type parameters take no defaults.
            if let Some(d) = g.default:
                var seen: list[String] = []
                for j in range(len(outer) + k):
                    seen.push(names[j].copy())
                _ = self.resolve_ty(d, TyCtx.plain(module, seen, True))
                let at = g.name.range
                self.report_other(module, Diagnostic.new(Msg.ResolveImplDefault, at.start, at.end))
            generics.push(Generic(name=g.name.text.copy(), default=None, is_const=g.is_const))
        var impl_assoc: list[(String, Ty)] = []
        if let Some(i) = impl_def:
            if let Some(info) = self.prog.impl_info(i):
                impl_assoc = info.assoc.copy()
        # The function's own bounds, then its `where` clause.
        let own_preds = self.resolve_bounds(module, f.generics, names, len(outer), in_trait)
        for p in own_preds:
            predicates.push(p.copy())
        for w in f.where_:
            let ctx = TyCtx(
                module=module,
                generics=names.copy(),
                self_ty=self_ty,
                allow_ref=True,
                predicates=predicates.copy(),
                in_trait=in_trait,
                impl_assoc=impl_assoc.copy(),
            )
            let ty = self.resolve_ty(w.ty, ctx)
            var new: list[Predicate] = []
            for b in w.bounds:
                if let Some(tr) = self.resolve_bound(b, ty, ctx):
                    new.push(Predicate(ty=ty, bound=tr, span=self.ast(module).type_expr(b).range))
            for p in own new:
                predicates.push(p)
        var info = self.placeholder_fn(FnKind.Free)
        info.generics = generics
        info.impl_generics = len(outer)
        info.predicates = predicates.copy()
        info.trait_ = in_trait
        info.impl_ = impl_def
        info.owner = self_ty
        info.pure = f.is_pure
        info.comptime_ = f.is_comptime
        info.body = f.body.copy()
        info.intrinsic = self.builtin_attr(module, f.attrs, "intrinsic")
        info.structural = self.builtin_attr(module, f.attrs, "structural")
        info.internal = has_attr(f.attrs, "internal")
        # A free generic function that reflects on its type parameters, or
        # was promoted for calling one with them, is a template (08): it is
        # checked in its instances.
        if owner.is_none()
                and in_trait.is_none()
                and impl_def.is_none()
                and not f.generics.is_empty():
            var reflecting = False
            if let Some(b) = f.body:
                reflecting = reflects(self.ast(module), b, f.generics)
            if reflecting or self.promoted.contains(def_):
                info.template = True
                _ = self.template_fns.insert(def_, f.copy())
        if self.is_root(module):
            info.contracts = not f.contracts(self.ast(module)).is_empty()
            if has_attr(f.attrs, "structural") or has_attr(f.attrs, "keeps"):
                self.beyond_in(module, "an attribute of a function")
        let ctx = TyCtx(
            module=module,
            generics=names.copy(),
            self_ty=self_ty,
            allow_ref=True,
            predicates=predicates.copy(),
            in_trait=in_trait,
            impl_assoc=impl_assoc.copy(),
        )
        var seen_default = False
        for i in range(len(f.params)):
            let p = ref f.params[i]
            match p.kind:
                case ParamKind.SelfParam:
                    if owner.is_none():
                        let d = Diagnostic.new(
                            Msg.ResolveSelfOutsideMethod, p.range.start, p.range.end
                        )
                        self.report_other(module, d)
                    elif i != 0:
                        let d = Diagnostic.new(Msg.ResolveSelfNotFirst, p.range.start, p.range.end)
                        self.report_other(module, d)
                    else:
                        info.self_mode = Some(p.mode)
                case ParamKind.Named(name, ty, default):
                    var twice = False
                    for x in info.params:
                        if x.name == name.text:
                            twice = True
                    if twice:
                        var d = Diagnostic.new(
                            Msg.ResolveDuplicateParameter, name.range.start, name.range.end
                        )
                        self.report_other(module, d.with("name", name.text))
                    if default.is_some():
                        seen_default = True
                    elif seen_default and info.keyword_only_from.is_none():
                        let at = name.range
                        let d = Diagnostic.new(Msg.ResolveParameterDefaultOrder, at.start, at.end)
                        self.report_other(module, d)
                    let resolved = self.resolve_ty(ty, ctx)
                    self.check_sized(module, resolved, p.range)
                    info.params.push(
                        ParamInfo(
                            name=name.text.copy(),
                            mode=p.mode,
                            ty=resolved,
                            default=default,
                            span=p.range,
                        )
                    )
                case ParamKind.KeywordOnly:
                    info.keyword_only_from = Some(len(info.params))
                case ParamKind.PositionalOnly:
                    info.positional_only_until = len(info.params)
                case ParamKind.Variadic(_, _):
                    self.beyond_in(module, "variadic parameters")
                case ParamKind.Error:
                    pass
        for n in f.from_:
            info.from_.push(n.text.copy())
            info.from_spans.push(n.range)
        # `@keeps(self, x)`: positions among `self` and the parameters.
        for a in f.attrs:
            if a.name != "keeps":
                continue
            for arg in a.args:
                var name = String.new()
                match self.ast(module).expr(arg.value).kind:
                    case ExprKind.Name(n):
                        name = n.copy()
                    case ExprKind.SelfValue:
                        name = "self".to_string()
                    case _:
                        continue
                let offset = if info.self_mode.is_some(): 1 else: 0
                if name == "self" and info.self_mode.is_some():
                    info.keeps.push(0)
                    continue
                for k in range(len(info.params)):
                    if info.params[k].name == name:
                        info.keeps.push(k + offset)
                        break
        # The result type; `T !` infers the error set from the body.
        match f.ret:
            case None:
                info.ret = Ty.unit()
            case Some(t):
                let written = self.ast(module).type_expr(t).copy()
                info.ret_span = Some(written.range)
                match written.kind:
                    case TypeKind.Result(ok, None):
                        var ok_ty = Ty.unit()
                        if let Some(o) = ok:
                            ok_ty = self.resolve_ty(o, ctx)
                        info.err_inferred = True
                        info.ret = Ty.error()
                        if let Some(r) = self.prog.wk.result:
                            let empty = self.types.err_set([])
                            info.ret = self.types.adt(r, [ok_ty, empty])
                    case _:
                        info.ret = self.resolve_ty(t, ctx)
                self.check_sized(module, info.ret, written.range)
        info.body_broken = f.body_broken
        if f.header_broken:
            info.header_broken = True
            info.ret = Ty.error()
            info.err_inferred = False
        # A function without a body that is no trait's (`resolve.missing-body`).
        if info.body.is_none()
                and info.intrinsic.is_none()
                and not f.name.text.is_empty()
                and in_trait.is_none():
            let d = Diagnostic.new(Msg.ResolveMissingBody, f.name.range.start, f.name.range.end)
            self.report_other(module, d.with("name", f.name.text))
        # Register methods and associated functions.
        if let Some(o) = owner:
            if self.is_drop_impl(impl_def):
                info.kind = FnKind.Drop
            elif info.self_mode.is_some():
                info.kind = FnKind.Method
            else:
                info.kind = FnKind.Assoc
            match o:
                case Owner.Type(_) | Owner.Inherent(_, _, _, _):
                    if let Some(st) = self_ty:
                        if let Some(key) = self.types.key(st):
                            let k = (key, f.name.text.copy())
                            if not self.prog.methods.contains(k.copy()):
                                _ = self.prog.methods.insert(k, def_)
                            else:
                                let at = f.name.range
                                var d = Diagnostic.new(Msg.ResolveDuplicateMethod, at.start, at.end)
                                d = d.with("owner", self.prog.display(self.types, st))
                                self.report_other(module, d.with("name", f.name.text))
                case Owner.Trait(t):
                    var kind_now = self.prog.defs[t.index].kind().copy()
                    if let DefKind.Trait(ti) = ref mut kind_now:
                        ti.methods.push(def_)
                    self.prog.defs[t.index].set_kind(kind_now)
                case Owner.Impl(i):
                    var kind_now = self.prog.defs[i.index].kind().copy()
                    if let DefKind.Impl(ii) = ref mut kind_now:
                        ii.methods.push((f.name.text.copy(), def_))
                    self.prog.defs[i.index].set_kind(kind_now)
                # A refinement's predicate is nobody's method.
                case Owner.Refinement(_):
                    pass
        if let Some(k) = self.special_kinds.get(def_):
            info.kind = k.copy()
        self.prog.defs[def_.index].set_kind(DefKind.Fn(info))

    ## Whether an impl is of `Drop`.
    pure def is_drop_impl(self, impl_def: DefId?) -> bool:
        let i = impl_def else:
            return False
        let info = self.prog.impl_info(i) else:
            return False
        return Some(info.trait_ref.def_) == self.prog.wk.drop

    ## Every variant by its unqualified name, for the definitions from
    ## `first` on.
    pure def build_variant_index(mut self, first: int):
        for i in range(first, len(self.prog.defs)):
            var names: list[String] = []
            if let Some(e) = self.prog.enum_info(DefId(index=i)):
                for v in e.variants:
                    names.push(v.name.copy())
            for vi in range(len(names)):
                var entry: list[(DefId, int)] = []
                if let Some(l) = self.prog.variants.get(names[vi].copy()):
                    entry = l.copy()
                entry.push((DefId(index=i), vi))
                _ = self.prog.variants.insert(names[vi].copy(), entry)

    # ---------------------------------------------------------------- traits

    ## A trait's associated type names and supertraits, before any struct
    ## or enum.
    pure def resolve_trait_header(
        mut self, def_: DefId, module: ModuleId, t: TraitDef, attrs: list[Attr]
    ):
        var names = ["Self".to_string()]
        if let Some(info) = self.prog.trait_info(def_):
            for g in info.generics:
                names.push(g.name.copy())
        let self_ty = self.types.param(0)
        var assoc: list[AssocInfo] = []
        for a in t.assoc_types:
            var dup = False
            for x in assoc:
                if x.name == a.name.text:
                    dup = True
            if not dup:
                assoc.push(AssocInfo(name=a.name.text.copy(), default=None))
        let sealed = has_attr(attrs, "sealed")
        let marker = has_attr(attrs, "marker")
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Trait(info) = ref mut kind_now:
            info.assoc = assoc
            info.sealed = sealed
            info.marker = marker
        self.prog.defs[def_.index].set_kind(kind_now)
        var supers: list[TraitRef] = []
        for s in t.supertraits:
            var ctx = TyCtx.plain(module, names, True)
            ctx.self_ty = Some(self_ty)
            ctx.in_trait = Some(def_)
            if let Some(tr) = self.resolve_bound(s, self_ty, ctx):
                if tr.def_ == def_:
                    let at = self.ast(module).type_expr(s).range
                    let d = Diagnostic.new(Msg.ResolveTraitCycle, at.start, at.end)
                    self.report_other(module, d.with("name", t.name.text))
                else:
                    supers.push(tr)
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Trait(info) = ref mut kind_now:
            info.supertraits = supers
        self.prog.defs[def_.index].set_kind(kind_now)

    ## The rest of a trait, once types are known: its associated types'
    ## defaults and its methods.
    pure def resolve_trait(mut self, def_: DefId, module: ModuleId, t: TraitDef):
        var names = ["Self".to_string()]
        if let Some(info) = self.prog.trait_info(def_):
            for g in info.generics:
                names.push(g.name.copy())
        let self_ty = self.types.param(0)
        for i in range(len(t.assoc_types)):
            if let Some(te) = t.assoc_types[i].ty:
                var ctx = TyCtx.plain(module, names, True)
                ctx.self_ty = Some(self_ty)
                ctx.in_trait = Some(def_)
                let ty = self.resolve_ty(te, ctx)
                var kind_now = self.prog.defs[def_.index].kind().copy()
                if let DefKind.Trait(info) = ref mut kind_now:
                    if i < len(info.assoc):
                        info.assoc[i].default = Some(ty)
                self.prog.defs[def_.index].set_kind(kind_now)
        for k in range(len(t.methods)):
            let m = ref t.methods[k]
            # A `comptime def` runs at compile time: the trait's derive is
            # not one of its methods.
            if m.is_comptime:
                continue
            var first = k
            for j in range(len(t.methods)):
                if t.methods[j].name.text == m.name.text:
                    first = min(first, j)
            if first != k:
                continue
            let info = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(info))
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=Some(Owner.Trait(def_)))
            )

    pure def resolve_impl(mut self, module: ModuleId, imp: ImplDef, range_in: TextRange):
        # The impl is named by its header, `impl[...] Trait for Type`.
        let self_range = self.ast(module).type_expr(imp.self_ty).range
        var range = range_in
        if self_range.end > range_in.start and self_range.end <= range_in.end:
            range = TextRange.new(range_in.start, self_range.end)
        var names: list[String] = []
        var generics: list[Generic] = []
        for g in imp.generics:
            names.push(g.name.text.copy())
            if g.default.is_some():
                let at = g.name.range
                self.report_other(module, Diagnostic.new(Msg.ResolveImplDefault, at.start, at.end))
            generics.push(Generic(name=g.name.text.copy(), default=None, is_const=g.is_const))
        let predicates = self.resolve_bounds(module, imp.generics, names, 0, None)
        var ctx = TyCtx.plain(module, names, True)
        ctx.predicates = predicates.copy()
        let self_ty = self.resolve_ty(imp.self_ty, ctx)
        let trait_ty = imp.trait_ty else:
            # An inherent impl adds methods to a type.
            let key = self.types.key(self_ty) else:
                if self_ty != Ty.error():
                    let at = self_range
                    var d = Diagnostic.new(Msg.ResolveNotAType, at.start, at.end)
                    self.report_other(
                        module, d.with("name", self.prog.display(self.types, self_ty))
                    )
                return
            # An associated type belongs in an impl of a trait.
            for a in imp.assoc_types:
                let at = a.name.range
                let d = Diagnostic.new(Msg.ResolveAssocOutsideTraitImpl, at.start, at.end)
                self.report_other(module, d)
            let shown = self.prog.display(self.types, self_ty)
            var owner_name = String.new()
            for part in shown.split("["):
                if owner_name.is_empty():
                    owner_name = part.to_string()
            for c in imp.consts:
                self.declare_assoc_const(module, key, owner_name, c)
            for m in imp.methods:
                let vis = if self.is_std(module): Vis.Pub else: m.vis
                let info = self.placeholder_fn(FnKind.Method)
                let def_ = self.new_def(module, m.name.text, m.name.range, vis, DefKind.Fn(info))
                let owner = Owner.Inherent(
                    generics=generics.copy(),
                    names=names.copy(),
                    predicates=predicates.copy(),
                    self_ty=self_ty,
                )
                self.pending.push(
                    Pending.Fn(def_=def_, module=module, ast=m.copy(), owner=Some(owner))
                )
            return
        ctx.self_ty = Some(self_ty)
        let trait_ref = self.resolve_bound(trait_ty, self_ty, ctx) else:
            return
        if self_ty == Ty.error():
            return
        # A refinement has its base's reading impls and no others (07).
        if let TyData.Adt(d, args) = self.types.data(self_ty).copy():
            if let Some(base) = self.prog.refinement_base(mut self.types, d, args):
                var diag = Diagnostic.new(Msg.RefineOwnImpl, range.start, range.end)
                diag = diag.with("ty", self.prog.display(self.types, self_ty))
                diag = diag.with("base", self.prog.display(self.types, base))
                diag = diag.with("trait", self.prog.display_trait_in(self.types, trait_ref, []))
                self.report_other(module, diag)
                return
        # `Drop` is for a struct or enum of this module, with exactly
        # `def drop(mut self)`, and for all of a generic type: the drop glue
        # (a SIR function per type) runs it for every value, whatever the
        # type arguments.
        if Some(trait_ref.def_) == self.prog.wk.drop:
            var target: DefId? = None
            if let TyData.Adt(d, _) = self.types.data(self_ty):
                if self.prog.defs[d.index].module == module:
                    match self.prog.defs[d.index].kind():
                        case DefKind.Struct(_) | DefKind.Enum(_):
                            target = Some(d)
                        case _:
                            pass
            let t = target else:
                self.report_other(
                    module, Diagnostic.new(Msg.ResolveDropTarget, range.start, range.end)
                )
                return
            let params = len(self.prog.type_generics(t))
            if params > 0:
                let declared_preds = self.preds_of(t)
                var whole = len(generics) == params and self_ty == self.self_type(t, params)
                for p in predicates:
                    var declared = False
                    for q in declared_preds:
                        if q.ty == p.ty and q.bound == p.bound:
                            declared = True
                    if not declared:
                        whole = False
                if not whole:
                    var own_names: list[String] = []
                    for g in self.prog.type_generics(t):
                        own_names.push(g.name.copy())
                    let list = own_names.join(", ")
                    let name = self.prog.defs[t.index].name.copy()
                    var d = Diagnostic.new(Msg.ResolveDropGeneric, range.start, range.end)
                    d = d.with("ty", self.prog.display_in(self.types, self_ty, names))
                    d = d.with("name", name).with(
                        "expected", "impl[{list}] Drop for {name}[{list}]"
                    )
                    self.report_other(module, d)
                    return
            var ok = len(imp.methods) == 1
            if ok:
                let m = ref imp.methods[0]
                ok = m.name.text == "drop" and len(m.params) == 1 and m.ret.is_none()
                if ok:
                    ok = m.params[0].mode == Mode.Mut
                    if let ParamKind.SelfParam = m.params[0].kind:
                        pass
                    else:
                        ok = False
            if not ok:
                let d = Diagnostic.new(Msg.ResolveDropSignature, range.start, range.end)
                self.report_other(module, d)
                return
        # What the impl binds its associated types to.
        var assoc: list[(String, Ty)] = []
        var declared: list[String] = []
        if let Some(i) = self.prog.trait_info(trait_ref.def_):
            for a in i.assoc:
                declared.push(a.name.copy())
        for a in imp.assoc_types:
            if not declared.contains(a.name.text):
                let at = a.name.range
                var d = Diagnostic.new(Msg.ResolveUnknownAssocType, at.start, at.end)
                d = d.with("trait", self.prog.display_trait_in(self.types, trait_ref, names))
                self.report_other(module, d.with("name", a.name.text))
                continue
            var ty = Ty.error()
            match a.ty:
                case Some(te):
                    ty = self.resolve_ty(te, ctx)
                case None:
                    let d = Diagnostic.new(Msg.ResolveAssocNeedsType, a.range.start, a.range.end)
                    self.report_other(module, d.with("name", a.name.text))
            assoc.push((a.name.text.copy(), ty))
        let shown_trait = self.prog.display_trait_in(self.types, trait_ref, names)
        let shown_ty = self.prog.display_in(self.types, self_ty, names)
        let info = ImplInfo(
            generics=generics,
            predicates=predicates,
            trait_ref=trait_ref.copy(),
            self_ty=self_ty,
            methods=[],
            assoc=assoc,
            derived=self.prog.modules[module.index].name.starts_with("<derive>/"),
        )
        let def_ = self.new_def(
            module, "impl {shown_trait} for {shown_ty}", range, Vis.Pub, DefKind.Impl(info)
        )
        self.prog.impls.push(def_)
        var of_trait: list[DefId] = []
        if let Some(x) = self.prog.impls_of.get(trait_ref.def_):
            of_trait = x.copy()
        of_trait.push(def_)
        _ = self.prog.impls_of.insert(trait_ref.def_, of_trait)
        if Some(trait_ref.def_) == self.prog.wk.drop:
            if let TyData.Adt(d, _) = self.types.data(self_ty):
                _ = self.prog.drop_types.add(d)
        for m in imp.methods:
            let finfo = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(finfo))
            # A value of the type runs its `impl Drop`'s method when dropped.
            if Some(trait_ref.def_) == self.prog.wk.drop:
                if let TyData.Adt(d, _) = self.types.data(self_ty).copy():
                    var kind_now = self.prog.defs[d.index].kind().copy()
                    if let DefKind.Struct(s) = ref mut kind_now:
                        s.drop = Some(fdef)
                    if let DefKind.Enum(e) = ref mut kind_now:
                        e.drop = Some(fdef)
                    self.prog.defs[d.index].set_kind(kind_now)
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=Some(Owner.Impl(def_)))
            )

    # ---------------------------------------------------------------- imports

    ## An `import` or `from ... import` item of `module` (09, "Modules").
    pure def declare_import(mut self, module: ModuleId, id: ItemId):
        let item = self.sources[module.index].ast.item(id).copy()
        match item.kind:
            case ItemKind.Import(imp):
                self.import_module(module, imp, item.range, item.vis)
            case ItemKind.FromImport(imp):
                self.import_from(module, imp, item.range, item.vis)
            case _:
                pass

    ## The module an import path names (09, "Modules"): a module of the
    ## importing package (by the package's own name), of one of its
    ## dependencies (by the dependency's name), or of the standard library
    ## (`std.json`, and stage 0's short names), loaded; `None` after noting
    ## that stage 0 reports the path (`resolve.import-unknown`, with the name
    ## a similar module's import would bind; `resolve.not-a-dependency`;
    ## `resolve.unknown-module`).
    pure def import_target(
        mut self, module: ModuleId, path: list[Name], at: TextRange
    ) -> (ModuleId?, String?):
        var words: list[String] = []
        for n in path:
            words.push(n.text.copy())
        let first = words.first() else:
            return (None, None)
        let package = self.prog.package_of(module)
        var root: ModuleId? = None
        if package < len(self.prog.packages):
            let this = ref self.prog.packages[package]
            if not this.name.is_empty() and this.name == first:
                root = this.root
            else:
                for (n, d) in this.deps:
                    if n == first and root.is_none() and d < len(self.prog.packages):
                        root = self.prog.packages[d].root
        if let Some(found) = root:
            var m = found
            for i in range(1, len(path)):
                let seg = path[i].text.copy()
                var next: ModuleId? = None
                if let Some(d) = self.prog.lookup_in(m, seg):
                    if let DefKind.Module(c) = self.prog.defs[d.index].kind():
                        if not self.prog.modules[m.index].imported.contains(seg.copy()):
                            next = Some(c)
                let c = next else:
                    var named: list[String] = []
                    for k in range(i + 1):
                        named.push(words[k].copy())
                    var d = Diagnostic.new(Msg.ResolveUnknownModule, at.start, at.end)
                    self.report_other(module, d.with("name", named.join(".")))
                    return (None, None)
                m = c
            return (Some(m), None)
        # A package of the program that this package does not depend on
        # (`resolve.not-a-dependency`).
        if not self.is_std(module) and module_for(words).is_none():
            for k in range(2, len(self.prog.packages)):
                if self.prog.packages[k].name == first:
                    var this = String.new()
                    if package < len(self.prog.packages):
                        this = self.prog.packages[package].name.copy()
                    var d = Diagnostic.new(Msg.ResolveNotADependency, at.start, at.end)
                    d = d.with("name", words.join(".")).with("package", self.prog.packages[k].name)
                    self.report_other(module, d.with("this", this))
                    return (None, None)
        let name = module_for(words) else:
            # `resolve.import-unknown`, the name pass's.
            if self.is_root(module):
                self.other_error = True
            # The closest module a path can name: std's, or a package's.
            var candidates = module_paths()
            for p in self.prog.packages:
                if not p.name.is_empty():
                    candidates.push(p.name.copy())
            var similar: String? = None
            if let Some(c) = closest(words.join("."), candidates):
                similar = Some(last_word(c))
            return (None, similar)
        if let Some(m) = self.std_loaded.get(name.copy()):
            return (Some(m), None)
        let parsed = self.std_parsed.get(name.copy()) else:
            # Stage 1 reads every std module it may import; one missing is
            # not one it can check against.
            self.beyond_in(module, "an import of a std module stage 1 has not read")
            return (None, None)
        if not self.std_derived.contains(name.copy()):
            self.beyond_in(
                module, "an import of a std module whose derived impls the base did not make"
            )
            return (None, None)
        let m = self.load_std_module(name, parsed.copy(), "", Templates.none())
        return (Some(m), None)

    ## The names an import that failed would have bound: their uses are not
    ## reported again.
    pure def poison_import(mut self, module: ModuleId, name: str, similar: String?):
        if not self.is_root(module):
            return
        if let Some(s) = similar:
            _ = self.prog.poisoned.add(s.copy())
        _ = self.prog.poisoned.add(name.to_string())

    ## Records that an import bound `name` in `module`, with the import's
    ## visibility (a `pub` import re-exports it).
    pure def bind_import(mut self, module: ModuleId, name: str, def_: DefId, vis: Vis):
        if let Some(old) = self.prog.modules[module.index].items.get(name.to_string()):
            if old == def_:
                return
            if let DefKind.Module(a) = self.prog.defs[old.index].kind():
                if let DefKind.Module(b) = self.prog.defs[def_.index].kind():
                    if a == b:
                        return
            self.bind(module, name, def_)
            return
        _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        _ = self.prog.modules[module.index].imported.insert(name.to_string(), vis)

    pure def import_module(mut self, module: ModuleId, imp: Import, range: TextRange, vis: Vis):
        if imp.c_header.is_some():
            let what = "a C header import"
            self.unsupported_in(module, range, what, "foreign functions (Phase 8)")
            return
        var bound = String.new()
        var at = range
        match imp.alias:
            case Some(a):
                bound = a.text.copy()
                at = a.range
            case None:
                if let Some(last) = imp.path.last():
                    bound = last.text.copy()
                    at = last.range
        var whole = range
        if let Some(a) = imp.path.first():
            if let Some(b) = imp.path.last():
                whole = a.range.cover(b.range)
        let (target, similar) = self.import_target(module, imp.path, whole)
        let m = target else:
            self.poison_import(module, bound, similar)
            return
        let def_ = self.new_def(module, bound, at, vis, DefKind.Module(m))
        if self.is_std(module):
            self.bind(module, bound, def_)
        else:
            self.bind_import(module, bound, def_, vis)

    pure def import_from(mut self, module: ModuleId, imp: FromImport, range: TextRange, vis: Vis):
        var whole = range
        if let Some(a) = imp.path.first():
            if let Some(b) = imp.path.last():
                whole = a.range.cover(b.range)
        let (target, similar) = self.import_target(module, imp.path, whole)
        let m = target else:
            for (n, alias) in imp.names:
                var bound = n.text.copy()
                if let Some(a) = alias:
                    bound = a.text.copy()
                self.poison_import(module, bound, similar)
            return
        let mname = self.prog.modules[m.index].name.copy()
        let prelude = self.prog.prelude
        for (n, alias) in imp.names:
            var found = self.prog.member(m, n.text, module)
            var reexported = False
            for x in reexports(mname):
                if x == n.text:
                    reexported = True
            if found.is_none() and self.is_std(m) and reexported:
                if let Some(d) = self.prog.lookup_in(prelude, n.text):
                    found = Some((d, True))
            match found:
                case Some((d, visible)):
                    if not visible:
                        self.report_other(module, self.prog.private_item(d, m, n.range))
                    var bound = n.text.copy()
                    if let Some(a) = alias:
                        bound = a.text.copy()
                    self.bind_import(module, bound, d, vis)
                case None:
                    var path: list[String] = []
                    for x in imp.path:
                        path.push(x.text.copy())
                    var d = Diagnostic.new(Msg.ResolveNotInModule, n.range.start, n.range.end)
                    d = d.with("module", path.join(".")).with("name", n.text)
                    self.report_other(module, d)

    # ---------------------------------------------------------------- scripts

    ## The items of a script (10, "REPL and scripts"): its top-level
    ## statements are the body of its `main`, `def main(sys: System) ->
    ## !:` with `return Ok(())` after them, declared after the other items.
    ## A script that declares its own `main` keeps it (stage 0 reports the
    ## statements, `resolve.script-main`).
    pure def script_items(mut self, module: ModuleId, items: list[ItemId]) -> list[ItemId]:
        var stmts: list[StmtId] = []
        var out: list[ItemId] = []
        var own_main: TextRange? = None
        for i in items:
            match self.ast(module).item(i).kind:
                case ItemKind.Stmt(st):
                    stmts.push(st)
                case ItemKind.Fn(f):
                    if f.name.text == "main" and own_main.is_none():
                        own_main = Some(f.name.range)
                    out.push(i)
                case _:
                    out.push(i)
        if stmts.is_empty():
            return items.copy()
        if let Some(at) = own_main:
            self.report_other(module, Diagnostic.new(Msg.ResolveScriptMain, at.start, at.end))
            return items.copy()
        let first = self.ast(module).stmt(stmts[0]).copy()
        let last = self.ast(module).stmt(stmts[len(stmts) - 1]).copy()
        let node = first.node
        let at = TextRange.empty(first.range.start)
        let end = TextRange.empty(last.range.end)
        var body = stmts.copy()
        var returns = False
        if let StmtKind.Return(_) = last.kind:
            returns = True
        if not returns:
            let ok_name = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=end, kind=ExprKind.Name("Ok".to_string()))
            )
            let unit = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=end, kind=ExprKind.Tuple([]))
            )
            let arg = Arg(node=node, range=end, name=None, mutable=False, value=unit)
            let call = Expr(
                node=node, range=end, kind=ExprKind.Call(callee=ok_name, args=[arg], trailing=None)
            )
            let ok = self.sources[module.index].ast.add_expr(call)
            body.push(
                self.sources[module.index].ast.add_stmt(
                    Stmt(node=node, range=end, kind=StmtKind.Return(Some(ok)))
                )
            )
        let range = TextRange.new(first.range.start, last.range.end)
        let system = TypeExpr(
            node=node,
            range=at,
            kind=TypeKind.Path(segments=[Name(text="System".to_string(), range=at)], args=[]),
        )
        let sys_ty = self.sources[module.index].ast.add_type(system)
        let ret = self.sources[module.index].ast.add_type(
            TypeExpr(node=node, range=at, kind=TypeKind.Result(ok=None, err=None))
        )
        let param = Param(
            node=node,
            range=at,
            mode=Mode.Borrow,
            kind=ParamKind.Named(
                name=Name(text="sys".to_string(), range=at), ty=sys_ty, default=None
            ),
        )
        let f = FnDef(
            node=node,
            range=range,
            name=Name(text="main".to_string(), range=at),
            is_pure=False,
            is_comptime=False,
            generics=[],
            params=[param],
            ret=Some(ret),
            from_=[],
            where_=[],
            body=Some(Block(node=node, range=range, stmts=body)),
            attrs=[],
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )
        let item = Item(
            node=node, range=range, attrs=[], vis=Vis.Private, docs=[], kind=ItemKind.Fn(f)
        )
        out.push(self.sources[module.index].ast.add_item(item))
        return out

    # ---------------------------------------------------------------- doc examples

    ## The root module's doc examples as tests (stage 0's `doctests.rs`; 10,
    ## "Testing"): a module of its own whose text keeps every example line
    ## where it is, so that a diagnostic in an example points at it, and
    ## whose scope is the root module's.
    pure def declare_doc_tests(mut self, module: ModuleId, items: list[ItemId], test_prefix: str):
        # Where each item that can carry a doc comment starts, with the name
        # its examples' tests are named after: a method as `Type.method`.
        var starts: list[(int, String)] = []
        for it in items:
            let start = self.ast(module).item(it).range.start
            match self.ast(module).item(it).kind:
                case ItemKind.Fn(f):
                    starts.push((start, f.name.text.copy()))
                case ItemKind.Const(c):
                    starts.push((start, c.name.text.copy()))
                case ItemKind.TypeAlias(a):
                    starts.push((start, a.name.text.copy()))
                case ItemKind.Struct(st):
                    starts.push((start, st.name.text.copy()))
                    for m in st.methods:
                        starts.push((m.range.start, "{st.name.text}.{m.name.text}"))
                case ItemKind.Enum(e):
                    starts.push((start, e.name.text.copy()))
                    for m in e.methods:
                        starts.push((m.range.start, "{e.name.text}.{m.name.text}"))
                case ItemKind.ErrorSet(e):
                    starts.push((start, e.name.text.copy()))
                    for m in e.methods:
                        starts.push((m.range.start, "{e.name.text}.{m.name.text}"))
                case ItemKind.Trait(t):
                    starts.push((start, t.name.text.copy()))
                    for m in t.methods:
                        starts.push((m.range.start, "{t.name.text}.{m.name.text}"))
                case ItemKind.Impl(i):
                    let owner = impl_owner_name(self.ast(module), i.self_ty)
                    for m in i.methods:
                        starts.push((m.range.start, "{owner}.{m.name.text}"))
                case _:
                    pass
        let source = self.text_of_module(module)
        let examples = doc_examples(source, starts)
        if examples.is_empty():
            return
        let text = doc_test_module(source, examples)
        let parsed = parse(text, Catalog.parse(""))
        if not parsed.diagnostics.is_empty():
            self.other_error = True
            self.noted.push("a syntax error in a doc example".to_string())
        let generated = build.module(parsed.tree)
        let g_items = generated.items.copy()
        let name = "<doc>/{self.prog.modules[module.index].name}.sisu"
        let g = self.add_module(name, False, generated)
        self.prog.modules[g.index].parent = Some(module)
        self.prog.modules[g.index].package = self.prog.modules[module.index].package
        # The file keeps the module's name: its lines are the module's.
        self.prog.modules[g.index].file = self.prog.modules[module.index].file.copy()
        _ = self.module_texts.insert(g, text.copy())
        self.docs.push((g, text))
        self.declare_items(g, g_items, test_prefix)

    # ---------------------------------------------------------------- interceptors and fakes

    ## The interceptor and the fake of each trait among `items` (stage 0's
    ## `shims.rs`; 06, "Interceptors and trace context"; 17, "Fakes"), when
    ## the module's text names `Wrap` or `Fake`: `cap.Wrap(inner=x,
    ## hook=h)` implements the trait by showing each call to the
    ## interceptor and forwarding it, and `cap.Fake[Trait]` is a recording
    ## fake of it. Stage 0 writes them as source text, in a module of their
    ## own whose scope is the trait's; so does stage 1, which then parses
    ## and declares that text.
    pure def declare_trait_shims(mut self, module: ModuleId, items: list[ItemId]):
        if self.is_std(module):
            return
        let source = self.text_of_module(module)
        let wrap = source.contains("Wrap")
        let fakes = source.contains("Fake")
        if not wrap and not fakes:
            return
        var text = String.new()
        var faked: list[String] = []
        for it in items:
            let ItemKind.Trait(t) = self.ast(module).item(it).kind.copy() else:
                continue
            let ms = self.shim_methods(module, t) else:
                continue
            if wrap:
                text.push("\n")
                text.push(wrap_impl(t.name.text, ms))
            if fakes:
                text.push("\n")
                text.push(fake_text(t.name.text, ms))
                faked.push(t.name.text.copy())
        if text.is_empty():
            return
        let generated = build.module(parse(text, Catalog.parse("")).tree)
        let g_items = generated.items.copy()
        let name = "<shims>/{self.prog.modules[module.index].name}.sisu"
        let g = self.add_module(name, False, generated)
        self.prog.modules[g.index].parent = Some(module)
        self.prog.modules[g.index].package = self.prog.modules[module.index].package
        _ = self.module_texts.insert(g, text.copy())
        self.shims.push((g, text.copy()))
        self.declare_items(g, g_items, "")
        for name in faked:
            let tr = self.prog.lookup_in(module, name)
            let st = self.prog.lookup_in(g, "__Fake_{name}")
            if let Some(a) = tr:
                if let Some(b) = st:
                    _ = self.prog.fakes.insert(a, b)

    ## The methods of a trait, when every one can be forwarded: a `self` or
    ## `mut self` receiver, no type parameters of its own, and no borrow or
    ## `Self` in its signature; the trait itself has no type parameters,
    ## associated types or supertraits.
    pure def shim_methods(self, module: ModuleId, t: TraitDef) -> list[ShimMethod]?:
        if not t.generics.is_empty()
                or not t.supertraits.is_empty()
                or not t.assoc_types.is_empty():
            return None
        var out: list[ShimMethod] = []
        for m in t.methods:
            if m.is_comptime:
                continue
            if not m.generics.is_empty()
                    or not m.where_.is_empty()
                    or not m.from_.is_empty()
                    or m.header_broken:
                return None
            if m.params.is_empty():
                return None
            match m.params[0].kind:
                case ParamKind.SelfParam:
                    pass
                case _:
                    return None
            if m.params[0].mode == Mode.Own:
                return None
            var args: list[(String, bool)] = []
            for k in range(1, len(m.params)):
                let p = ref m.params[k]
                match p.kind:
                    case ParamKind.Named(name, ty, _):
                        if self.borrows(module, ty):
                            return None
                        args.push((name.text.copy(), p.mode == Mode.Mut))
                    case _:
                        return None
            var ret = String.new()
            var result: String? = None
            if let Some(r) = m.ret:
                if self.borrows(module, r):
                    return None
                let written = self.text_in(module, self.ast(module).type_expr(r).range)
                ret = " -> {written}"
                if written != "()":
                    result = Some(written.copy())
            var params: list[String] = []
            for p in m.params:
                params.push(self.text_in(module, p.range))
            out.push(
                ShimMethod(
                    name=m.name.text.copy(),
                    params=params.join(", "),
                    ret=ret,
                    result=result,
                    args=args,
                )
            )
        if out.is_empty():
            return None
        return Some(out)

    ## Whether a type mentions a borrow or `Self`.
    pure def borrows(self, module: ModuleId, t: TypeExprId) -> bool:
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Ref(_, _):
                return True
            case TypeKind.Path(segments, args):
                for s in segments:
                    if s.text == "Self":
                        return True
                for a in args:
                    if self.borrows(module, a):
                        return True
                return False
            case TypeKind.Option(x):
                return self.borrows(module, x)
            case TypeKind.Dyn(x):
                return self.borrows(module, x)
            case TypeKind.Result(ok, err):
                if let Some(o) = ok:
                    if self.borrows(module, o):
                        return True
                if let Some(e) = err:
                    if self.borrows(module, e):
                        return True
                return False
            case TypeKind.Union(xs):
                for x in xs:
                    if self.borrows(module, x):
                        return True
                return False
            case TypeKind.Tuple(xs):
                for (_, x) in xs:
                    if self.borrows(module, x):
                        return True
                return False
            case TypeKind.Fn(_, params, ret):
                for x in params:
                    if self.borrows(module, x):
                        return True
                return self.borrows(module, ret)
            case TypeKind.ConstArg(_) | TypeKind.ConstExpr(_):
                return False
            case TypeKind.Unsupported(_):
                return True
            case TypeKind.Error:
                return True

    # ---------------------------------------------------------------- tests

    ## The tests a declaration named `name` declares, with their names
    ## (stage 0's `tests_of::cases`): `test "name" for x, y in [(1, 2), (3,
    ## 4)]:` over a list written out is one test per element, whose body
    ## starts by binding the pattern to the element; over a list computed
    ## some other way, one test whose body is a `for` over it.
    pure def test_cases(
        mut self, module: ModuleId, name: str, t: TestDef
    ) -> list[(String, TestDef)]:
        var pat = PatternId(index=0)
        var list = ExprId(index=0)
        match t.cases:
            case Some((p, l)):
                pat = p
                list = l
            case None:
                return [(name.to_string(), t.copy())]
        let pat_node = self.ast(module).pattern(pat).node
        var out: list[(String, TestDef)] = []
        match self.ast(module).expr(list).kind.copy():
            case ExprKind.List(elems):
                for k in range(len(elems)):
                    let e = elems[k]
                    let at = self.ast(module).expr(e).range
                    let bind = Stmt(
                        node=pat_node,
                        range=at,
                        kind=StmtKind.Let(
                            mutable=False, pat=pat, ty=None, init=Some(e), else_=None
                        ),
                    )
                    let first = self.sources[module.index].ast.add_stmt(bind)
                    # Each case is named after its element as written.
                    var shown = "?".to_string()
                    if self.is_root(module):
                        shown = self.text_in(module, at)
                    out.push(("{name} {shown}", self.case_def(t, first, False)))
            case _:
                # `for PAT in LIST:` around the body.
                let at = self.ast(module).expr(list).range
                let list_node = self.ast(module).expr(list).node
                var body = Block(node=list_node, range=at, stmts=[])
                if let Some(b) = t.body:
                    body = b.copy()
                let body_range = body.range
                let looped = Stmt(
                    node=list_node,
                    range=body_range,
                    kind=StmtKind.For(pat=pat, mode=Mode.Borrow, iter=list, body=body),
                )
                let first = self.sources[module.index].ast.add_stmt(looped)
                out.push((name.to_string(), self.case_def(t, first, True)))
        return out

    ## A test `t` whose body starts with the statement `first` (and, when
    ## `alone`, is only that statement).
    pure def case_def(self, t: TestDef, first: StmtId, alone: bool) -> TestDef:
        var body: Block? = None
        if let Some(b) = t.body:
            var stmts = [first]
            if not alone:
                for s in b.stmts:
                    stmts.push(s)
            body = Some(Block(node=b.node, range=b.range, stmts=stmts))
        return TestDef(
            name=t.name.copy(),
            name_range=t.name_range,
            cases=None,
            params=t.params.copy(),
            body=body,
        )

    # ---------------------------------------------------------------- associated constants

    ## An associated constant of a type (03), named `Type.NAME`.
    pure def declare_assoc_const(mut self, module: ModuleId, key: TyKey, owner: str, c: ConstDef):
        let info = ConstInfo(ty=Ty.error(), value=None, terms=[])
        let name = "{owner}.{c.name.text}"
        let def_ = self.new_def(module, name, c.name.range, Vis.Pub, DefKind.Const(info))
        let k = (key, c.name.text.copy())
        if self.prog.assoc_consts.contains(k.copy()) or self.prog.methods.contains(k.copy()):
            let at = c.name.range
            var d = Diagnostic.new(Msg.ResolveDuplicateMethod, at.start, at.end).with(
                "owner", owner
            )
            self.report_other(module, d.with("name", c.name.text))
            return
        _ = self.prog.assoc_consts.insert(k, def_)
        self.pending.push(Pending.Const(def_=def_, module=module, ast=c.copy()))

    # ---------------------------------------------------------------- functions the compiler writes

    ## `invariant e` lines (07): a method of the struct that checks them,
    ## `pure def __check_invariant(self)`, whose body is the lines; and the
    ## invariant as a `bool`, `pure def __invariant(self) -> bool`, which
    ## reports nothing of its own.
    pure def declare_invariant(mut self, module: ModuleId, def_: DefId, node: int, s: StructDef):
        let range = s.invariants[0].range
        var stmts: list[StmtId] = []
        for c in s.invariants:
            let st = Stmt(node=node, range=c.range, kind=StmtKind.Contract(c.copy()))
            stmts.push(self.sources[module.index].ast.add_stmt(st))
        let body = Block(node=node, range=range, stmts=stmts)
        let check = self.written_fn(node, range, "__check_invariant", body, None, True)
        let m = self.new_def(
            module,
            "__check_invariant",
            range,
            Vis.Private,
            DefKind.Fn(self.placeholder_fn(FnKind.Method)),
        )
        _ = self.special_kinds.insert(m, FnKind.Invariant(def_))
        self.pending.push(
            Pending.Fn(def_=m, module=module, ast=check, owner=Some(Owner.Type(def_)))
        )
        var cond: ExprId? = None
        for c in s.invariants:
            let at = self.sources[module.index].ast.expr(c.expr).range
            let part = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=at, kind=ExprKind.Paren(c.expr))
            )
            match cond:
                case None:
                    cond = Some(part)
                case Some(l):
                    let both = Expr(
                        node=node, range=range, kind=ExprKind.Binary(op=BinOp.And, lhs=l, rhs=part)
                    )
                    cond = Some(self.sources[module.index].ast.add_expr(both))
        var whole = ExprId(index=0)
        match cond:
            case Some(c):
                whole = c
            case None:
                let t = Expr(node=node, range=range, kind=ExprKind.Name("True".to_string()))
                whole = self.sources[module.index].ast.add_expr(t)
        let holds = self.predicate_fn(module, node, whole, "__invariant", True)
        let h = self.new_def(
            module,
            "__invariant",
            range,
            Vis.Private,
            DefKind.Fn(self.placeholder_fn(FnKind.Method)),
        )
        _ = self.quiet_fns.add(h)
        self.pending.push(
            Pending.Fn(def_=h, module=module, ast=holds, owner=Some(Owner.Type(def_)))
        )

    ## `pure def name(self) -> bool: return pred`, written for a predicate.
    pure def predicate_fn(
        mut self, module: ModuleId, node: int, pred: ExprId, name: str, internal: bool
    ) -> FnDef:
        let range = self.sources[module.index].ast.expr(pred).range
        let ret_ty = TypeExpr(
            node=node,
            range=range,
            kind=TypeKind.Path(segments=[Name(text="bool".to_string(), range=range)], args=[]),
        )
        let ret = self.sources[module.index].ast.add_type(ret_ty)
        let st = Stmt(node=node, range=range, kind=StmtKind.Return(Some(pred)))
        let body = Block(
            node=node, range=range, stmts=[self.sources[module.index].ast.add_stmt(st)]
        )
        return self.written_fn(node, range, name, body, Some(ret), internal)

    ## A `pure` method of `self` the compiler writes, with a body; an
    ## `internal` one only the compiler's checks call.
    pure def written_fn(
        self,
        node: int,
        range: TextRange,
        name: str,
        own body: Block,
        ret: TypeExprId?,
        internal: bool,
    ) -> FnDef:
        var attrs: list[Attr] = []
        if internal:
            attrs.push(Attr(name="internal".to_string(), args=[], range=range))
        return FnDef(
            node=node,
            range=range,
            name=Name(text=name.to_string(), range=range),
            is_pure=True,
            is_comptime=False,
            generics=[],
            params=[Param(node=node, range=range, mode=Mode.Borrow, kind=ParamKind.SelfParam)],
            ret=ret,
            from_=[],
            where_=[],
            body=Some(body),
            attrs=attrs,
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )

    ## A refinement type's predicate as a function the compiler writes:
    ## `def where(self) -> bool: return pred`, `pure`, with `self` a value
    ## of the base.
    pure def declare_predicate(
        mut self, module: ModuleId, def_: DefId, node: int, a: TypeAlias, range: TextRange
    ):
        var pred = ExprId(index=0)
        match a.predicate:
            case Some(p):
                pred = p
            case None:
                pred = self.sources[module.index].ast.add_expr(
                    Expr(node=node, range=range, kind=ExprKind.Error)
                )
        let f = self.predicate_fn(module, node, pred, "where", False)
        let at = self.sources[module.index].ast.expr(pred).range
        let pd = self.new_def(
            module, "where", at, Vis.Private, DefKind.Fn(self.placeholder_fn(FnKind.Free))
        )
        _ = self.special_kinds.insert(pd, FnKind.Predicate(def_))
        var kind_now = self.prog.defs[def_.index].kind().copy()
        if let DefKind.Refinement(r) = ref mut kind_now:
            r.predicate = Some(pd)
        self.prog.defs[def_.index].set_kind(kind_now)
        self.pending.push(
            Pending.Fn(def_=pd, module=module, ast=f, owner=Some(Owner.Refinement(def_)))
        )

    # ---------------------------------------------------------------- derived impls

    ## The traits a struct's `@delegate` forwards, with where each is
    ## named, after checking the attribute (stage 0's `delegations`).
    pub pure def delegations(
        mut self,
        module: ModuleId,
        attrs: list[Attr],
        ty: str,
        is_struct: bool,
        fields: list[String],
    ) -> list[(String, String, TextRange)]:
        var out: list[(String, String, TextRange)] = []
        for a in attrs:
            if a.name != "delegate":
                continue
            var field: String? = None
            var to_at: TextRange? = None
            for arg in a.args:
                if let Some(n) = arg.name:
                    if n.text == "to" and to_at.is_none():
                        to_at = Some(arg.range)
                        if let ExprKind.Str(parts) = self.ast(module).expr(arg.value).kind:
                            field = Some(build.plain_text(parts))
            var ok = False
            var to = String.new()
            if let Some(f) = field:
                ok = is_struct and fields.contains(f)
                to = f.copy()
            if not ok:
                let at = to_at ?? a.range
                let d = Diagnostic.new(Msg.ResolveDelegateTo, at.start, at.end).with("ty", ty)
                self.report_other(module, d)
                continue
            for arg in a.args:
                if arg.name.is_some():
                    continue
                var n = String.new()
                if let ExprKind.Name(x) = self.ast(module).expr(arg.value).kind:
                    n = x.copy()
                if not delegable(n):
                    let shown = self.text_in(module, arg.range)
                    var d = Diagnostic.new(Msg.ResolveNotDelegable, arg.range.start, arg.range.end)
                    self.report_other(module, d.with("name", shown))
                    continue
                if returns_self(n) and len(fields) != 1:
                    var d = Diagnostic.new(Msg.ResolveDelegateSelf, arg.range.start, arg.range.end)
                    d = d.with("trait", n).with("ty", ty).with("field", to)
                    self.report_other(module, d)
                    continue
                var seen = False
                for (t, _, _) in out:
                    if t == n:
                        seen = True
                if not seen:
                    out.push((n, to.copy(), arg.range))
        return out

    ## Whether `items` has its own `impl trait_name for ty`.
    pub pure def has_impl(
        self, module: ModuleId, items: list[ItemId], trait_name: str, ty: str
    ) -> bool:
        for id in items:
            if let ItemKind.Impl(i) = self.ast(module).item(id).kind:
                let t = i.trait_ty else:
                    continue
                if self.last_segment(module, t) == Some(trait_name.to_string())
                        and self.last_segment(module, i.self_ty) == Some(ty.to_string()):
                    return True
        return False

    pure def last_segment(self, module: ModuleId, te: TypeExprId) -> String?:
        if let TypeKind.Path(segments, _) = self.ast(module).type_expr(te).kind:
            if let Some(s) = segments.last():
                return Some(s.text.copy())
        return None

    ## Whether each generic parameter is named in one of the field types:
    ## one that is not (`Key[T]`'s `T`) needs no bound in a derived impl.
    pub pure def used_params(
        self, module: ModuleId, gps: list[GenericParam], tys: list[TypeExprId]
    ) -> list[bool]:
        var names: list[String] = []
        for t in tys:
            self.type_names(module, t, mut names)
        var out: list[bool] = []
        for g in gps:
            out.push(names.contains(g.name.text))
        return out

    pure def type_names(self, module: ModuleId, t: TypeExprId, mut names: list[String]):
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Path(segments, args):
                if let Some(s) = segments.first():
                    names.push(s.text.copy())
                for a in args:
                    self.type_names(module, a, mut names)
            case TypeKind.Option(i):
                self.type_names(module, i, mut names)
            case TypeKind.Dyn(i):
                self.type_names(module, i, mut names)
            case TypeKind.Ref(_, inner):
                self.type_names(module, inner, mut names)
            case TypeKind.Result(ok, err):
                if let Some(o) = ok:
                    self.type_names(module, o, mut names)
                if let Some(e) = err:
                    self.type_names(module, e, mut names)
            case TypeKind.Tuple(es):
                for (_, e) in es:
                    self.type_names(module, e, mut names)
            case TypeKind.Fn(_, params, ret):
                for p in params:
                    self.type_names(module, p, mut names)
                self.type_names(module, ret, mut names)
            case TypeKind.Union(us):
                for u in us:
                    self.type_names(module, u, mut names)
            case _:
                pass

    # ---------------------------------------------------------------- checks of impls

    ## The checks of the impls from the definition `first` on, once every
    ## impl is known (stage 0's `check_traits`): an impl's method is as
    ## `pure` as the trait's; an impl of the root module without one of the
    ## trait's required methods is an error stage 0 reports; and
    ## `@derive(Copy)` holds only for a type whose fields are `Copy`.
    pure def check_traits(mut self, first: int):
        let impls = self.prog.impls.copy()
        for i in impls:
            if i.index < first:
                continue
            let info = self.prog.impl_info(i) else:
                continue
            let tr = info.trait_ref.def_
            let methods = info.methods.copy()
            let derived = info.derived
            let bound_assoc = info.assoc.copy()
            let self_ty = info.self_ty
            let trait_args = info.trait_ref.args.copy()
            let predicates = info.predicates.copy()
            let tinfo = self.prog.trait_info(tr) else:
                continue
            let trait_methods = tinfo.methods.copy()
            let sealed = tinfo.sealed
            let declared_assoc = tinfo.assoc.copy()
            let supertraits = tinfo.supertraits.copy()
            let module = self.prog.defs[i.index].module
            let span = self.prog.defs[i.index].span
            let trait_name = self.prog.display_trait_in(self.types, info.trait_ref, [])
            var names: list[String] = []
            for g in info.generics:
                names.push(g.name.copy())
            let n_generics = len(info.generics)
            let ty_name = self.prog.display_in(self.types, self_ty, names)
            # Only std implements a sealed trait.
            if sealed and not self.is_std(module):
                var d = Diagnostic.new(Msg.ResolveSealedTrait, span.start, span.end)
                self.report_other(module, d.with("trait", trait_name).with("ty", ty_name))
                continue
            # The orphan rule: an impl lives in the package of the trait or of
            # the type, except in the root package, which nothing depends on
            # (`resolve.orphan-impl`).
            let package = self.prog.package_of(module)
            if package != 0 and not self.is_std(module):
                let trait_pkg = self.prog.package_of(self.prog.defs[tr.index].module)
                var type_pkg = -1
                if let TyData.Adt(d, _) = self.types.data(self_ty):
                    type_pkg = self.prog.package_of(self.prog.defs[d.index].module)
                if trait_pkg != package and type_pkg != package:
                    var d = Diagnostic.new(Msg.ResolveOrphanImpl, span.start, span.end)
                    self.report_other(module, d.with("trait", trait_name).with("ty", ty_name))
            for (mname, mdef) in methods:
                let tm = self.prog.trait_method(tr, mname) else:
                    let s = self.prog.defs[mdef.index].span
                    var d = Diagnostic.new(Msg.ResolveNotATraitMethod, s.start, s.end)
                    self.report_other(module, d.with("name", mname).with("trait", trait_name))
                    continue
                var tpure = False
                if let Some(f) = self.prog.fn_info(tm):
                    tpure = f.pure
                if tpure:
                    var kind_now = self.prog.defs[mdef.index].kind().copy()
                    if let DefKind.Fn(f) = ref mut kind_now:
                        f.pure = True
                    self.prog.defs[mdef.index].set_kind(kind_now)
            # A derived or delegated impl's are checked at its attribute
            # (`check_derives`).
            if derived
                    or self.prog.modules[module.index].name.starts_with("<delegate>/")
                    or not self.is_root(module):
                continue
            # Each associated type the trait declares without a default is
            # bound (`resolve.missing-assoc-type`).
            for a in declared_assoc:
                if a.default.is_some():
                    continue
                var bound = False
                for (n, _) in bound_assoc:
                    if n == a.name:
                        bound = True
                if not bound:
                    var d = Diagnostic.new(Msg.ResolveMissingAssocType, span.start, span.end)
                    d = d.with("trait", trait_name).with("ty", ty_name).with("name", a.name)
                    self.report_other(module, d)
            # Implementing `Container(Len)` needs `Len` too
            # (`resolve.supertrait-missing`).
            var targs = [self_ty]
            for x in trait_args:
                targs.push(x)
            let env = self.prog.elaborate_env(mut self.types, predicates)
            for s in supertraits:
                var sargs: list[Ty] = []
                for x in s.args:
                    sargs.push(self.types.subst(x, targs))
                let st = TraitRef(def_=s.def_, args=sargs)
                if self.prog.implements(mut self.types, self_ty, st, env) == Answer.No:
                    let shown = self.prog.display_trait_in(self.types, st, names)
                    var d = Diagnostic.new(Msg.ResolveSupertraitMissing, span.start, span.end)
                    d = d.with("ty", ty_name).with("trait", trait_name).with("super", shown)
                    self.report_other(module, d)
            var missing: list[DefId] = []
            for m in trait_methods:
                let f = self.prog.fn_info(m) else:
                    continue
                if f.body.is_some() or f.intrinsic.is_some() or f.header_broken:
                    continue
                var found = False
                for (n, _) in methods:
                    if n == self.prog.defs[m.index].name:
                        found = True
                if not found:
                    missing.push(m)
            if not missing.is_empty():
                var listed = String.new()
                for m in missing:
                    if not listed.is_empty():
                        listed.push(", ")
                    listed.push("`{self.prog.defs[m.index].name}`")
                var d = Diagnostic.new(Msg.ResolveMissingTraitMethod, span.start, span.end)
                d = d.with("trait", trait_name).with("ty", ty_name).with("methods", listed)
                # Each with the signature the impl must write.
                for m in missing:
                    let found = self.prog.fn_info(m) else:
                        continue
                    let f = found.copy()
                    let name = self.prog.defs[m.index].name.copy()
                    var args = targs.copy()
                    for k in range(max(len(f.generics) - f.impl_generics, 0)):
                        args.push(self.types.param(n_generics + k))
                    let signature = self.signature_text(name, f, Some(args), env, names)
                    d = d.note_with(Msg.ResolveWriteTraitMethod, "signature", signature)
                self.report_other(module, d)
        let checks = self.copy_checks.copy()
        self.copy_checks = []
        for (d, at) in checks:
            self.check_copy_fields(d, at)
        self.check_coherence(first)
        self.check_object_safety()
        self.check_derives()

    ## At most one impl of a trait for any type (D-013): each impl from
    ## `first` on against the earlier ones of its trait
    ## (`resolve.overlapping-impl`). Two headers whose self types have
    ## different outermost constructors cannot overlap; the others are
    ## unified, each impl's parameters apart from the other's.
    pure def check_coherence(mut self, first: int):
        let impls = self.prog.impls.copy()
        for k in range(len(impls)):
            let a = impls[k]
            # The standard library's impls do not overlap.
            if a.index < first or self.is_std(self.prog.defs[a.index].module):
                continue
            let found_a = self.prog.impl_info(a) else:
                continue
            let ia = found_a.copy()
            let ha = self.header(ia.self_ty, ia.trait_ref.args)
            let na = len(ia.generics)
            let ta = ia.trait_ref.def_
            for j in range(k):
                let b = impls[j]
                let found_b = self.prog.impl_info(b) else:
                    continue
                if found_b.trait_ref.def_ != ta:
                    continue
                let ib = found_b.copy()
                let oa = outermost(self.types, ia.self_ty)
                let ob = outermost(self.types, ib.self_ty)
                if oa.is_some() and ob.is_some() and oa != ob:
                    continue
                let hb = self.header(ib.self_ty, ib.trait_ref.args)
                let shifted = self.shift_params(hb, na)
                var binds: list[Ty?] = []
                for _ in range(na + len(ib.generics)):
                    binds.push(None)
                if self.unify_patterns(ha, shifted, mut binds):
                    let module = self.prog.defs[a.index].module
                    var names: list[String] = []
                    for g in ia.generics:
                        names.push(g.name.copy())
                    let at = self.prog.defs[a.index].span
                    let first_at = self.prog.defs[b.index].span
                    var d = Diagnostic.new(Msg.ResolveOverlappingImpl, at.start, at.end)
                    d = d.with("trait", self.prog.display_trait_in(self.types, ia.trait_ref, names))
                    d = d.with("ty", self.prog.display_in(self.types, ia.self_ty, names))
                    if self.prog.defs[b.index].module == module:
                        d = d.label(Msg.ResolveFirstImpl, first_at.start, first_at.end)
                        self.report_other(module, d)
                    else:
                        # The first impl is in another file.
                        self.note_error(module, "resolve.overlapping-impl")
                    break

    ## An impl's header as one type: its self type and its trait's
    ## arguments.
    pure def header(mut self, self_ty: Ty, args: list[Ty]) -> Ty:
        var es = [self_ty]
        for x in args:
            es.push(x)
        return self.types.tuple(es)

    pure def shift_params(mut self, t: Ty, by: int) -> Ty:
        match self.types.data(t).copy():
            case TyData.Param(i):
                return self.types.param(i + by)
            case TyData.Adt(d, a):
                var out: list[Ty] = []
                for x in a:
                    out.push(self.shift_params(x, by))
                return self.types.adt(d, out)
            case TyData.Tuple(e, l):
                var out: list[Ty] = []
                for x in e:
                    out.push(self.shift_params(x, by))
                return self.types.intern(TyData.Tuple(elems=out, labels=l))
            case TyData.Ref(x, m):
                let s = self.shift_params(x, by)
                return self.types.ref_(s, m)
            case TyData.Fn(ps, r, pure):
                var out: list[Ty] = []
                for x in ps:
                    out.push(self.shift_params(x, by))
                let rr = self.shift_params(r, by)
                return self.types.fn_(out, rr, pure)
            case TyData.Dyn(tr):
                var out: list[Ty] = []
                for x in tr.args:
                    out.push(self.shift_params(x, by))
                return self.types.intern(TyData.Dyn(TraitRef(def_=tr.def_, args=out)))
            case _:
                return t

    ## A type with each bound parameter replaced by what it is bound to.
    pure def resolve_bind(self, t: Ty, binds: list[Ty?]) -> Ty:
        var cur = t
        for _ in range(64):
            let TyData.Param(i) = self.types.data(cur) else:
                return cur
            if i >= len(binds):
                return cur
            let b = binds[i] else:
                return cur
            cur = b
        return cur

    ## Two-way unification of patterns whose parameters are all variables.
    pure def unify_patterns(self, x: Ty, y: Ty, mut binds: list[Ty?]) -> bool:
        let a = self.resolve_bind(x, binds)
        let b = self.resolve_bind(y, binds)
        let da = self.types.data(a).copy()
        let db = self.types.data(b).copy()
        if let TyData.Param(i) = da:
            if let TyData.Param(j) = db:
                if i == j:
                    return True
            if i < len(binds):
                binds[i] = Some(b)
                return True
        if let TyData.Param(j) = db:
            if j < len(binds):
                binds[j] = Some(a)
                return True
        match da:
            case TyData.Assoc(_, _, _):
                return True
            case _:
                pass
        if let TyData.Assoc(_, _, _) = db:
            return True
        match da:
            case TyData.Adt(d1, a1):
                let TyData.Adt(d2, a2) = db else:
                    return False
                return d1 == d2 and self.unify_all(a1, a2, mut binds)
            case TyData.Tuple(e1, _):
                let TyData.Tuple(e2, _) = db else:
                    return False
                return self.unify_all(e1, e2, mut binds)
            case TyData.Ref(x1, m1):
                let TyData.Ref(x2, m2) = db else:
                    return False
                return m1 == m2 and self.unify_patterns(x1, x2, mut binds)
            case TyData.Fn(p1, r1, _):
                let TyData.Fn(p2, r2, _) = db else:
                    return False
                return self.unify_all(p1, p2, mut binds) and self.unify_patterns(r1, r2, mut binds)
            case TyData.Dyn(t1):
                let TyData.Dyn(t2) = db else:
                    return False
                return t1.def_ == t2.def_ and self.unify_all(t1.args, t2.args, mut binds)
            case _:
                return a == b

    pure def unify_all(self, xs: list[Ty], ys: list[Ty], mut binds: list[Ty?]) -> bool:
        if len(xs) != len(ys):
            return False
        for k in range(len(xs)):
            if not self.unify_patterns(xs[k], ys[k], mut binds):
                return False
        return True

    ## The traits written as `dyn T` that cannot be (`resolve.not-object-safe`):
    ## a method without `self` by reference, with type parameters of its
    ## own, or mentioning `Self` besides its receiver.
    pure def check_object_safety(mut self):
        let uses = self.dyn_uses.copy()
        self.dyn_uses = []
        var seen: list[(DefId, ModuleId, TextRange)] = []
        for (t, m, at) in uses:
            if seen.contains((t, m, at)):
                continue
            seen.push((t, m, at))
            if let Some((method, reason)) = self.object_safety_problem(t):
                var d = Diagnostic.new(Msg.ResolveNotObjectSafe, at.start, at.end)
                d = d.with("trait", self.prog.defs[t.index].name).with("method", method)
                self.report_other(m, d.with("reason", reason))

    ## Why a trait cannot be `dyn`, if it cannot: the method, and the
    ## reason.
    pure def object_safety_problem(mut self, t: DefId) -> (String, String)?:
        let p0 = self.types.param(0)
        for tr in self.prog.elaborate(mut self.types, p0, TraitRef(def_=t, args=[])):
            let info = self.prog.trait_info(tr.def_) else:
                continue
            for m in info.methods.copy():
                let f = self.prog.fn_info(m) else:
                    continue
                let name = self.prog.defs[m.index].name.copy()
                match f.self_mode:
                    case Some(Mode.Borrow) | Some(Mode.Mut):
                        pass
                    case _:
                        return Some((name, "it does not take `self` or `mut self`".to_string()))
                if len(f.generics) > f.impl_generics:
                    return Some((name, "it has type parameters of its own".to_string()))
                var mentions = False
                for p in f.params:
                    if self.types.walk(p.ty).contains(p0):
                        mentions = True
                if mentions or self.types.walk(f.ret).contains(p0):
                    return Some((name, "its signature mentions `Self` besides `self`".to_string()))
        return None

    ## `@derive(Copy)` only for a type whose fields are all `Copy` (03); a
    ## field of a type parameter's type is, since the type is `Copy` only
    ## for `Copy` arguments.
    pure def check_copy_fields(mut self, d: DefId, at: TextRange):
        var fields: list[(String, Ty)] = []
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(s):
                for f in s.fields:
                    fields.push((f.name.copy(), f.ty))
            case DefKind.Enum(e):
                for v in e.variants:
                    var k = 0
                    for (n, t) in v.fields:
                        let shown = n.copy() ?? "{k}"
                        fields.push(("{v.name}.{shown}", t))
                        k += 1
            case _:
                return
        var generics: list[String] = []
        for g in self.prog.type_generics(d):
            generics.push(g.name.copy())
        var as_copy: list[Ty] = []
        for _ in range(len(generics)):
            as_copy.push(Ty.int())
        for (fname, fty) in fields:
            if self.types.contains_error(fty):
                continue
            let t = self.types.subst(fty, as_copy)
            if self.prog.is_copy(mut self.types, t):
                continue
            var diag = Diagnostic.new(Msg.ResolveDeriveField, at.start, at.end)
            diag = diag.with("ty", self.prog.defs[d.index].name).with("trait", "Copy")
            diag = diag.with("field", fname).with(
                "fty", self.prog.display_in(self.types, fty, generics)
            )
            self.report_other(self.prog.defs[d.index].module, diag)
            var kind_now = self.prog.defs[d.index].kind().copy()
            match ref mut kind_now:
                case DefKind.Struct(s):
                    s.copy = False
                case DefKind.Enum(e):
                    e.copy = False
                case _:
                    pass
            self.prog.defs[d.index].set_kind(kind_now)
            return

    # ---------------------------------------------------------------- headers and bounds

    ## The generic parameters of every struct, enum and trait, with their
    ## defaults, then the bounds of the parameters of structs and enums.
    pure def resolve_headers(mut self):
        var ints: list[int] = []
        for d in self.type_params.keys():
            if not self.headers_done.contains(d):
                ints.push(d.index)
        ints.sort()
        for i in ints:
            _ = self.headers_done.add(DefId(index=i))
        for i in ints:
            let d = DefId(index=i)
            let gps = self.params_of(d)
            let module = self.prog.defs[i].module
            var is_trait = False
            if let DefKind.Trait(_) = self.prog.defs[i].kind():
                is_trait = True
            var names: list[String] = []
            if is_trait:
                names.push("Self".to_string())
            var generics: list[Generic] = []
            var seen_default = False
            for g in gps:
                var default: Ty? = None
                if let Some(t) = g.default:
                    seen_default = True
                    var ctx = TyCtx.plain(module, names, True)
                    if is_trait:
                        ctx.self_ty = Some(self.types.param(0))
                    default = Some(self.resolve_ty(t, ctx))
                elif seen_default:
                    let at = g.name.range
                    let diag = Diagnostic.new(Msg.ResolveGenericDefaultOrder, at.start, at.end)
                    self.report_other(module, diag)
                names.push(g.name.text.copy())
                generics.push(
                    Generic(name=g.name.text.copy(), default=default, is_const=g.is_const)
                )
            var kind_now = self.prog.defs[i].kind().copy()
            match ref mut kind_now:
                case DefKind.Struct(s):
                    s.generics = generics
                case DefKind.Enum(e):
                    e.generics = generics
                case DefKind.ErrorSet(e):
                    e.generics = generics
                case DefKind.Trait(t):
                    t.generics = generics
                case DefKind.Refinement(r):
                    r.generics = generics
                case _:
                    pass
            self.prog.defs[i].set_kind(kind_now)
        for i in ints:
            let d = DefId(index=i)
            if let DefKind.Trait(_) = self.prog.defs[i].kind():
                continue
            let gps = self.params_of(d)
            let module = self.prog.defs[i].module
            var names: list[String] = []
            for g in gps:
                names.push(g.name.text.copy())
            let preds = self.resolve_bounds(module, gps, names, 0, None)
            _ = self.type_preds.insert(d, preds)

    ## The bounds of the generic parameters `gps`, which are the names from
    ## `offset` on in `names`, as predicates on `Param(offset + i)`.
    pure def resolve_bounds(
        mut self,
        module: ModuleId,
        gps: list[GenericParam],
        names: list[String],
        offset: int,
        in_trait: DefId?,
    ) -> list[Predicate]:
        var out: list[Predicate] = []
        for k in range(len(gps)):
            let g = ref gps[k]
            let subject = self.types.param(offset + k)
            # A `const` parameter's "bound" is its type, which is `int` in
            # stage 0.
            if g.is_const:
                for b in g.bounds:
                    var is_int = False
                    if let TypeKind.Path(segments, args) = self.ast(module).type_expr(b).kind:
                        if args.is_empty() and len(segments) == 1:
                            is_int = segments[0].text == "int" or segments[0].text == "i64"
                    if not is_int:
                        let at = self.ast(module).type_expr(b).range
                        let shown = "a `const` parameter of a type other than `int`"
                        self.unsupported_in(
                            module, at, shown, "const generics over other types (Phase 4)"
                        )
                continue
            for b in g.bounds:
                var ctx = TyCtx.plain(module, names, True)
                ctx.predicates = out.copy()
                ctx.in_trait = in_trait
                if let Some(tr) = self.resolve_bound(b, subject, ctx):
                    out.push(
                        Predicate(ty=subject, bound=tr, span=self.ast(module).type_expr(b).range)
                    )
        return out

    ## A trait named in a bound, a supertraits list or an impl header, for
    ## `subject` (which a defaulted parameter `Rhs = Self` takes).
    pure def resolve_bound(mut self, te: TypeExprId, subject: Ty, ctx: TyCtx) -> TraitRef?:
        let written = self.ast(ctx.module).type_expr(te).copy()
        let at = written.range
        let TypeKind.Path(segments, args) = written.kind else:
            if let TypeKind.Error = written.kind:
                return None
            let d = Diagnostic.new(Msg.ResolveNotATrait, at.start, at.end)
            self.report_other(ctx.module, d.with("name", self.text_in(ctx.module, at)))
            return None
        let d = self.lookup_path(segments, ctx, at) else:
            return None
        var words: list[String] = []
        for s in segments:
            words.push(s.text.copy())
        let name = words.join(".")
        let info = self.prog.trait_info(d) else:
            let diag = Diagnostic.new(Msg.ResolveNotATrait, at.start, at.end)
            self.report_other(ctx.module, diag.with("name", name))
            return None
        let generics = info.generics.copy()
        var targs: list[Ty] = []
        for a in args:
            targs.push(self.resolve_ty(a, ctx))
        if len(targs) > len(generics):
            self.argument_count(ctx.module, at, name, len(generics), len(targs))
            return None
        # Omitted trailing arguments take their defaults, `Self` being the
        # subject.
        while len(targs) < len(generics):
            let default = generics[len(targs)].default else:
                self.argument_count(ctx.module, at, name, len(generics), len(targs))
                return None
            var env = [subject]
            for t in targs:
                env.push(t)
            targs.push(self.types.subst(default, env))
        return Some(TraitRef(def_=d, args=targs))

    ## Resolves a possibly qualified name (`cli.Error`) to a definition.
    ## A possibly qualified name (`cli.Error`) as a definition, written at
    ## `span`, reporting what cannot be found (a first name that names
    ## nothing is the name pass's).
    pure def lookup_path(mut self, segments: list[Name], ctx: TyCtx, span: TextRange) -> DefId?:
        var module = ctx.module
        for i in range(len(segments)):
            let seg = ref segments[i]
            var found: DefId? = None
            if i == 0:
                found = self.prog.lookup(module, seg.text)
            else:
                # Through a module: only what it lets other modules see (09).
                if let Some((d, visible)) = self.prog.member(module, seg.text, ctx.module):
                    if not visible:
                        self.report_other(ctx.module, self.prog.private_item(d, module, seg.range))
                    found = Some(d)
            let d = found else:
                if i > 0:
                    let mname = self.prog.modules[module.index].name.copy()
                    var diag = Diagnostic.new(Msg.ResolveNotInModule, span.start, span.end)
                    self.report_other(ctx.module, diag.with("module", mname).with("name", seg.text))
                return None
            if i + 1 == len(segments):
                return Some(d)
            match self.prog.defs[d.index].kind():
                case DefKind.Module(m):
                    module = m
                case _:
                    let diag = Diagnostic.new(Msg.ResolveNotAModule, span.start, span.end)
                    self.report_other(ctx.module, diag.with("name", seg.text))
                    return None
        return None

    # ---------------------------------------------------------------- types

    pure def resolve_ty(mut self, te: TypeExprId, ctx: TyCtx) -> Ty:
        let written = self.ast(ctx.module).type_expr(te).copy()
        let range = written.range
        match written.kind:
            case TypeKind.Error:
                return Ty.error()
            case TypeKind.Path(segments, args):
                if len(args) == 1 and self.is_fake_marker(segments, ctx.module):
                    return self.fake_ty(args[0], ctx, range)
                var targs: list[Ty] = []
                for a in args:
                    targs.push(self.resolve_ty(a, ctx))
                return self.resolve_path_ty(segments, targs, ctx, range)
            case TypeKind.Option(inner):
                let t = self.resolve_ty(inner, ctx)
                let o = self.prog.wk.option else:
                    return Ty.error()
                return self.types.adt(o, [t])
            case TypeKind.Result(ok, err):
                var ok_ty = Ty.unit()
                if let Some(o) = ok:
                    ok_ty = self.resolve_ty(o, ctx)
                var err_ty = Ty.error()
                match err:
                    case Some(e):
                        err_ty = self.resolve_error_set(e, ctx)
                    case None:
                        let d = Diagnostic.new(
                            Msg.ResolveInferredSetPosition, range.start, range.end
                        )
                        self.report_other(ctx.module, d)
                let r = self.prog.wk.result else:
                    return Ty.error()
                return self.types.adt(r, [ok_ty, err_ty])
            case TypeKind.Union(_):
                let d = Diagnostic.new(Msg.ResolveUnionOutsideResult, range.start, range.end)
                self.report_other(ctx.module, d)
                return Ty.error()
            case TypeKind.Tuple(elems):
                var tys: list[Ty] = []
                var labels: list[String] = []
                var all_named = not elems.is_empty()
                for (n, t) in elems:
                    tys.push(self.resolve_ty(t, ctx))
                    match n:
                        case Some(name):
                            labels.push(name.text.copy())
                        case None:
                            all_named = False
                if tys.is_empty():
                    return Ty.unit()
                if not all_named:
                    labels = []
                return self.types.intern(TyData.Tuple(elems=tys, labels=labels))
            case TypeKind.Fn(pure, params, ret):
                var ps: list[Ty] = []
                for p in params:
                    ps.push(self.resolve_ty(p, ctx))
                let r = self.resolve_ty(ret, ctx)
                return self.types.fn_(ps, r, pure)
            case TypeKind.Ref(mutable, inner):
                if not ctx.allow_ref:
                    self.beyond_in(ctx.module, "a reference type in a declaration")
                let t = self.resolve_ty(inner, ctx)
                # A shared borrow of a view is the view: `ref str` is a `str`.
                if t == Ty.str() and not mutable:
                    return Ty.str()
                return self.types.ref_(t, mutable)
            case TypeKind.Dyn(inner):
                match self.resolve_bound(inner, Ty.error(), ctx):
                    case Some(tr):
                        self.dyn_uses.push((tr.def_, ctx.module, range))
                        return self.types.intern(TyData.Dyn(tr))
                    case None:
                        return Ty.error()
            case TypeKind.ConstArg(n):
                return self.types.intern(TyData.Const(n))
            case TypeKind.ConstExpr(e):
                # Which generic parameters are `const` is checked in bodies;
                # a signature takes any parameter here.
                let ts = folding.terms(self.ast(ctx.module), e)
                let scope = ConstScope.signature(ctx.generics)
                let (t, err) = consts.const_arg(self.prog, mut self.types, ctx.module, ts, scope)
                if let Some(x) = err:
                    self.report_const(ctx.module, consts.diagnostic(x, Shared.get(self.catalog)))
                return t
            case TypeKind.Unsupported(what):
                var phase = "reflection beyond derive (Phase 8)"
                if what.contains("pointer"):
                    phase = "foreign functions (Phase 8)"
                let at = self.ast(ctx.module).type_expr(te).range
                self.unsupported_in(ctx.module, at, what, phase)
                return Ty.error()

    ## `cap.Fake[Trait]`, written at `range`: the fake the compiler wrote
    ## for the trait (17); a trait without one is `comptime.no-fake`.
    pure def fake_ty(mut self, arg: TypeExprId, ctx: TyCtx, range: TextRange) -> Ty:
        let written = self.ast(ctx.module).type_expr(arg).copy()
        let TypeKind.Path(segments, args) = written.kind else:
            let shown = self.text_in(ctx.module, written.range)
            let d = Diagnostic.new(Msg.ComptimeNoFake, range.start, range.end).with("name", shown)
            self.report_other(ctx.module, d)
            return Ty.error()
        var found: DefId? = None
        if args.is_empty():
            found = self.lookup_path(segments, ctx, range)
        var words: list[String] = []
        for s in segments:
            words.push(s.text.copy())
        if let Some(t) = found:
            if let Some(f) = self.prog.fakes.get(t):
                return self.types.adt(f, [])
        let d = Diagnostic.new(Msg.ComptimeNoFake, range.start, range.end).with(
            "name", words.join(".")
        )
        self.report_other(ctx.module, d)
        return Ty.error()

    ## Whether `segments` name `cap.Fake` in the program's code.
    pure def is_fake_marker(self, segments: list[Name], module: ModuleId) -> bool:
        if self.is_std(module):
            return False
        var d: DefId? = None
        var m = module
        for i in range(len(segments)):
            var found: DefId? = None
            if i == 0:
                found = self.prog.lookup(m, segments[i].text)
            else:
                found = self.prog.lookup_in(m, segments[i].text)
            let x = found else:
                return False
            if let DefKind.Module(next) = self.prog.defs[x.index].kind():
                m = next
            d = Some(x)
        let x = d else:
            return False
        let item = ref self.prog.defs[x.index]
        let owner = ref self.prog.modules[item.module.index]
        return item.name == "Fake" and owner.is_std and owner.name == "cap"

    ## A `dyn Trait` has no size of its own: it is held only behind `ref`
    ## or in a `Box` (E0395).
    pure def check_sized(mut self, module: ModuleId, ty: Ty, range: TextRange):
        if let Some(d) = self.prog.unsized_part(self.types, ty):
            let shown = self.prog.display(self.types, d)
            self.report_at(module, Msg.TypeUnsizedDyn, range, "ty", shown)

    pure def resolve_error_set(mut self, te: TypeExprId, ctx: TyCtx) -> Ty:
        var parts: list[TypeExprId] = []
        if let TypeKind.Union(list) = self.ast(ctx.module).type_expr(te).kind:
            parts = list.copy()
        else:
            parts = [te]
        var members: list[DefId] = []
        for p in parts:
            let t = self.resolve_ty(p, ctx)
            match self.types.data(t):
                case TyData.ErrSet(m):
                    for d in m:
                        members.push(d)
                case TyData.Error:
                    return Ty.error()
                case _:
                    return Ty.error()
        return self.types.err_set(sorted_members(members))

    ## The associated type `name` of `subject`, from the bounds in scope
    ## (and, inside a trait, the trait itself).
    pure def assoc_of(mut self, subject: Ty, name: str, ctx: TyCtx) -> Ty?:
        var candidates: list[TraitRef] = []
        if let Some(t) = ctx.in_trait:
            if subject == self.types.param(0):
                var args: list[Ty] = []
                if let Some(info) = self.prog.trait_info(t):
                    for i in range(len(info.generics)):
                        args.push(self.types.param(i + 1))
                candidates.push(TraitRef(def_=t, args=args))
        for p in ctx.predicates:
            if p.ty == subject:
                candidates.push(p.bound.copy())
        for c in candidates:
            for tr in self.prog.elaborate(mut self.types, subject, c):
                var declares = False
                if let Some(info) = self.prog.trait_info(tr.def_):
                    for a in info.assoc:
                        if a.name == name:
                            declares = True
                if declares:
                    return Some(
                        self.types.intern(
                            TyData.Assoc(self_ty=subject, trait_=tr.copy(), name=name.to_string())
                        )
                    )
        return None

    pure def resolve_path_ty(
        mut self, segments: list[Name], args: list[Ty], ctx: TyCtx, at: TextRange
    ) -> Ty:
        let first = segments.first() else:
            return Ty.error()
        if len(segments) == 1:
            let name = first.text.copy()
            for i in range(len(ctx.generics)):
                if ctx.generics[i] == name:
                    if not args.is_empty():
                        self.report_at(ctx.module, Msg.TypeNotGeneric, at, "name", name)
                    return self.types.param(i)
            if let Some(p) = primitive(name):
                if not args.is_empty():
                    self.report_at(ctx.module, Msg.TypeNotGeneric, at, "name", name)
                return p
            if name == "Self":
                match ctx.self_ty:
                    case Some(t):
                        return t
                    case None:
                        let d = Diagnostic.new(Msg.ResolveSelfTypeOutside, at.start, at.end)
                        self.report_other(ctx.module, d)
                        return Ty.error()
            # Inside a trait, its associated types are named bare.
            if ctx.in_trait.is_some() and self.prog.lookup(ctx.module, name).is_none():
                let p0 = self.types.param(0)
                if let Some(t) = self.assoc_of(p0, name, ctx):
                    return t
            if let Some(d) = self.prog.lookup(ctx.module, name):
                # A constant where a type's constant argument goes:
                # `Array[int, SIZE]`.
                if let DefKind.Const(_) = self.prog.defs[d.index].kind():
                    if args.is_empty():
                        let (t, err) = consts.const_item(
                            self.prog, mut self.types, ctx.module, name, first.range
                        )
                        if let Some(x) = err:
                            var diag = consts.diagnostic(x, Shared.get(self.catalog))
                            diag.start = at.start
                            diag.end = at.end
                            self.report_const(ctx.module, diag)
                        return t
                return self.def_as_type(d, name, args, ctx.module, at)
            return Ty.error()
        # `C.Item` and `Self.Item`: an associated type.
        if len(segments) == 2:
            let base = first.text.copy()
            var subject: Ty? = None
            for i in range(len(ctx.generics)):
                if ctx.generics[i] == base and subject.is_none():
                    subject = Some(self.types.param(i))
            if subject.is_none() and base == "Self":
                subject = ctx.self_ty
            if let Some(s) = subject:
                let name = segments[1].text.copy()
                if base == "Self":
                    for (n, t) in ctx.impl_assoc:
                        if n == name:
                            return t
                if let Some(t) = self.assoc_of(s, name, ctx):
                    return t
                let shown = self.prog.display_in(self.types, s, ctx.generics)
                var d = Diagnostic.new(Msg.ResolveNoAssocType, at.start, at.end).with("ty", shown)
                self.report_other(ctx.module, d.with("name", name))
                return Ty.error()
        # A qualified name: module.Type.
        let d = self.lookup_path(segments, ctx, at) else:
            return Ty.error()
        let last = segments[len(segments) - 1].text.copy()
        return self.def_as_type(d, last, args, ctx.module, at)

    pure def def_as_type(
        mut self, d: DefId, name: str, args: list[Ty], module: ModuleId, at: TextRange
    ) -> Ty:
        var generics: list[Generic] = []
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(s):
                generics = s.generics.copy()
            case DefKind.Enum(e):
                generics = e.generics.copy()
            case DefKind.Refinement(r):
                generics = r.generics.copy()
            case DefKind.ErrorSet(_):
                if not args.is_empty():
                    self.report_at(module, Msg.TypeNotGeneric, at, "name", name)
                return self.types.err_set([d])
            case DefKind.TypeAlias(_):
                var declared = 0
                if let Some((_, a)) = self.aliases.get(d):
                    declared = len(a.generics)
                if len(args) != declared and not (args.is_empty() and declared == 0):
                    self.argument_count(module, at, name, declared, len(args))
                    return Ty.error()
                let t = self.resolve_alias(d)
                return self.types.subst(t, args)
            case DefKind.Trait(_):
                var diag = Diagnostic.new(Msg.ResolveTraitAsType, at.start, at.end).with(
                    "name", name
                )
                diag = diag.fix(Msg.ResolveAddDyn, "name", name, at.start, at.start, "dyn ")
                self.report_other(module, diag)
                return Ty.error()
            case DefKind.Unsupported:
                return Ty.error()
            case _:
                let diag = Diagnostic.new(Msg.ResolveNotAType, at.start, at.end).with("name", name)
                self.report_other(module, diag)
                return Ty.error()
        # Generics of a type not yet resolved are counted from its AST.
        let declared = self.declared_generics(d) ?? len(generics)
        var targs = args.copy()
        # Omitted trailing arguments take their defaults (D-060).
        if len(targs) < declared:
            var filled = targs.copy()
            while len(filled) < len(generics):
                let default = generics[len(filled)].default else:
                    break
                let t = self.types.subst(default, filled)
                filled.push(t)
            if len(filled) == declared:
                targs = filled
        if len(targs) != declared:
            if targs.is_empty():
                self.report_at(module, Msg.TypeTypeArgumentsNeeded, at, "name", name)
            else:
                self.argument_count(module, at, name, declared, len(targs))
            var errors: list[Ty] = []
            for _ in range(declared):
                errors.push(Ty.error())
            return self.types.adt(d, errors)
        # A `const` parameter takes a constant, any other a type.
        var consts: list[bool] = []
        match self.type_params.get(d):
            case Some(gps):
                for g in gps:
                    consts.push(g.is_const)
            case None:
                for g in generics:
                    consts.push(g.is_const)
        for i in range(len(targs)):
            if i >= len(consts):
                continue
            var wrong = False
            match self.types.data(targs[i]):
                case TyData.Const(_) | TyData.ConstOp(_, _):
                    wrong = not consts[i]
                case TyData.Param(_) | TyData.Error | TyData.Var(_):
                    wrong = False
                case _:
                    wrong = consts[i]
            if wrong:
                var param = "{i + 1}"
                if i < len(generics):
                    param = generics[i].name.copy()
                var m = Msg.ResolveTypeArgument
                if consts[i]:
                    m = Msg.ResolveConstArgument
                let diag = Diagnostic.new(m, at.start, at.end).with("name", name)
                self.report_other(module, diag.with("param", param))
                var errors: list[Ty] = []
                for _ in range(declared):
                    errors.push(Ty.error())
                return self.types.adt(d, errors)
        return self.types.adt(d, targs)

    ## The bounds of a type's generic parameters.
    pure def preds_of(self, d: DefId) -> list[Predicate]:
        if let Some(p) = self.type_preds.get(d):
            return p.copy()
        return []

    ## The generic parameters a type, trait or refinement declares.
    pure def params_of(self, d: DefId) -> list[GenericParam]:
        if let Some(p) = self.type_params.get(d):
            return p.copy()
        return []

    ## The number of generic parameters a type declares, from its AST.
    pure def declared_generics(self, d: DefId) -> int?:
        if let Some(g) = self.type_params.get(d):
            return Some(len(g))
        match self.prog.defs[d.index].kind():
            case DefKind.Struct(s):
                return Some(len(s.generics))
            case DefKind.Enum(e):
                return Some(len(e.generics))
            case _:
                return None

## A test's name within its suite: `suite/name`.
pure def prefixed(prefix: str, name: str) -> String:
    if prefix.is_empty():
        return name.to_string()
    return "{prefix}/{name}"

## Error set members in order of definition, each once.
pure def sorted_members(own v: list[DefId]) -> list[DefId]:
    var ints: list[int] = []
    for d in v:
        ints.push(d.index)
    ints.sort()
    var out: list[DefId] = []
    for i in ints:
        if let Some(last) = out.last():
            if last.index == i:
                continue
        out.push(DefId(index=i))
    return out

## The text of `r` in `text`, or nothing when `r` is not in it.
## A module of a program's own source, for `Resolver.add_program`: its path
## (`["atlas", "geo", "point"]`; empty for a single file), the name of its
## file as diagnostics give it, its syntax and text, and its package (an
## index of the program's packages, the root package first).
pub struct SourceModule:
    pub path: list[String]
    pub file: String
    pub syntax: Module
    pub text: String
    pub package: int

## A package of a program's source: its name (empty for a single file), its
## dependencies (by the names its imports give them, as indices of the
## program's packages) and whether `[trust]` lets it use `unsafe` and
## `extern`.
pub struct SourcePackage:
    pub name: String
    pub deps: list[(String, int)]
    pub trusted: bool

## The package of the program's `k`th package in the resolved program, where
## std is `STD_PACKAGE` (stage 0's `package_id`).
pure def package_id(k: int) -> int:
    return if k == 0: 0 else: k + 1

## The prefix of the names of a module's tests: its path within its package
## (`parser/accepts leading zeros`); none for a root module.
pure def test_prefix(path: list[String]) -> String:
    if len(path) <= 1:
        return String.new()
    var rest: list[String] = []
    for i in range(1, len(path)):
        rest.push(path[i].copy())
    return rest.join(".")

pure def slice_text(text: str, r: TextRange) -> String:
    if r.start < 0 or r.end > text.byte_len() or r.start > r.end:
        return String.new()
    return text.byte_slice(r.start, r.end).to_string()

pub pure def has_attr(attrs: list[Attr], name: str) -> bool:
    for a in attrs:
        if a.name == name:
            return True
    return False

## The type a primitive name stands for.
pure def primitive(name: str) -> Ty?:
    return match name:
        case "int": Some(Ty.int())
        case "f64": Some(Ty.float())
        case "bool": Some(Ty.bool())
        case "char": Some(Ty.char())
        case "str": Some(Ty.str())
        case "Never": Some(Ty.never())
        case _: None

## A std module's text, from the texts read by name.
## The `comptime def derive` of each trait of a module (the prelude's),
## with the module's syntax and text: what `@derive` unfolds.
pure def derive_templates(own syntax: Module, text: str) -> Templates:
    var derives: dict[String, FnDef] = {}
    for it in syntax.items:
        if let ItemKind.Trait(t) = syntax.ast.item(it).kind:
            for m in t.methods:
                if m.is_comptime and m.name.text == "derive":
                    let src = Src(ast=ref syntax.ast, source="")
                    if template_parts(src, m).is_some():
                        _ = derives.insert(t.name.text.copy(), m.copy())
    return Templates(syntax=syntax.ast, text=text.to_string(), derives=derives)

pure def text_of(texts: dict[String, String], name: str) -> String:
    if let Some(t) = texts.get(name.to_string()):
        return t.copy()
    return String.new()

## Whether a body reflects on one of the type parameters `generics`: a
## `reflect` query, a field reached by a compile-time descriptor, or a
## compile-time expression that names a type parameter (stage 0's
## `instances::reflects`).
pure def reflects(ast: Ast, body: Block, generics: list[GenericParam]) -> bool:
    for e in visit.exprs_in_block(ast, body):
        match ast.expr(e).kind:
            case ExprKind.FieldOf(_, _):
                return True
            case ExprKind.Call(callee, _, _):
                if let ExprKind.Field(base, _) = ast.expr(callee).kind:
                    if let ExprKind.Name(n) = ast.expr(base).kind:
                        if n == "reflect":
                            return True
            case ExprKind.Comptime(inner):
                for x in visit.exprs_of(ast, inner):
                    if let ExprKind.Name(n) = ast.expr(x).kind:
                        for g in generics:
                            if g.name.text == n:
                                return True
            case _:
                pass
    return False

## The last part of a dotted path: `json` for `std.json`.
pure def last_word(path: str) -> String:
    var out = String.new()
    for part in path.split("."):
        out = part.to_string()
    return out

## The traits `@delegate` forwards (03, "Coherence").
pure def delegable(name: str) -> bool:
    return match name:
        case "Add" | "Sub" | "Mul" | "Div" | "Rem" | "Neg" | "Eq" | "PartialOrd" | "Ord": True
        case "Hash" | "Display" | "Debug" | "Len": True
        case _: False

## The delegable traits whose methods return `Self`.
pure def returns_self(name: str) -> bool:
    return match name:
        case "Add" | "Sub" | "Mul" | "Div" | "Rem" | "Neg": True
        case _: False

## A method of a trait, as the interceptor and the fake write it.
struct ShimMethod:
    name: String
    ## The receiver and parameters as written: `mut self, x: int`.
    params: String
    ## ` -> T ! E` as written, or empty.
    ret: String
    ## The result type as written (`T ! E`), when it is not `()`.
    result: String?
    ## The parameters' names, and whether each is passed `mut`.
    args: list[(String, bool)]

## `"{a:?}, {b:?}"`: the arguments of a call as an interceptor and a fake
## show them.
pure def shown_args(m: ShimMethod) -> String:
    var parts: list[String] = []
    for (n, _) in m.args:
        parts.push("{{{n}:?}}")
    return parts.join(", ")

## `x, mut y`: the arguments of the forwarded call.
pure def passed(m: ShimMethod) -> String:
    var parts: list[String] = []
    for (n, by_mut) in m.args:
        if by_mut:
            parts.push("mut {n}")
        else:
            parts.push(n.copy())
    return parts.join(", ")

## The impl of `trait_name` for `cap.Wrap`.
pure def wrap_impl(trait_name: str, ms: list[ShimMethod]) -> String:
    var s: String = "impl[__T: {trait_name}, __I: cap.Interceptor] {trait_name} for cap.Wrap[__T, __I]:\n"
    for m in ms:
        s.push("    def {m.name}({m.params}){m.ret}:\n")
        s.push(
            "        let __call = cap.Call(capability=\"{trait_name}\".to_string(), method=\"{m.name}\".to_string(), args=\"{shown_args(m)}\")\n"
        )
        s.push("        self.hook.before(__call.copy())\n")
        match m.result:
            case Some(_):
                s.push("        let __result = self.inner.{m.name}({passed(m)})\n")
                s.push("        self.hook.after(__call, \"{{__result:?}}\")\n")
                s.push("        return __result\n")
            case None:
                s.push("        self.inner.{m.name}({passed(m)})\n")
                s.push("        self.hook.after(__call, \"()\")\n")
    return s

## The fake of `trait_name`: a struct, its own methods, and its impl of
## the trait.
pure def fake_text(trait_name: str, ms: list[ShimMethod]) -> String:
    let ty = "__Fake_{trait_name}"
    var s: String = "## A recording fake of `{trait_name}` (17): `cap.Fake[{trait_name}]`. Its copies share\n"
    s.push(
        "## what it recorded.\n@derive(Copy)\nstruct {ty}:\n    __log: Cap[Mutex[list[String]]]\n"
    )
    for m in ms:
        if let Some(r) = m.result:
            s.push("    __on_{m.name}: Cap[Mutex[list[{r}]]]\n")
    var fields = ["__log=Cap(Mutex(list()))".to_string()]
    for m in ms:
        if m.result.is_some():
            fields.push("__on_{m.name}=Cap(Mutex(list()))")
    s.push("\nimpl {ty}:\n")
    s.push("    ## A fake of `{trait_name}` that has seen no calls and has no results queued.\n")
    s.push("    def new() -> {ty}:\n        return {ty}({fields.join(", ")})\n")
    s.push("    ## The calls so far, in order, each written `method(arguments)`.\n")
    s.push(
        "    def calls(self) -> list[String]:\n        return self.__log.get().lock().value.copy()\n"
    )
    for m in ms:
        if let Some(r) = m.result:
            s.push(
                "    ## Queues what a call of `{m.name}` returns; the last result queued is returned\n"
            )
            s.push("    ## again once the others are used.\n")
            s.push("    def on_{m.name}(self, own result: {r}):\n")
            s.push("        self.__on_{m.name}.get().lock().value.push(result)\n")
    s.push("\nimpl {trait_name} for {ty}:\n")
    for m in ms:
        s.push("    def {m.name}({m.params}){m.ret}:\n")
        s.push("        self.__log.get().lock().value.push(\"{m.name}({shown_args(m)})\")\n")
        if m.result.is_some():
            s.push("        var __queued = self.__on_{m.name}.get().lock()\n")
            s.push("        if __queued.value.is_empty():\n")
            s.push(
                "            panic(\"`cap.Fake[{trait_name}]`: `{m.name}` was called with no result queued (`on_{m.name}`)\")\n"
            )
            s.push("        if len(__queued.value) == 1:\n")
            s.push("            return __queued.value[0].copy()\n")
            s.push("        return __queued.value.remove(0)\n")
    return s

## One fenced example of a run of `##` lines: the line of its opening
## fence, and each of its lines (the line, the column its text starts at,
## and the text).
struct DocExample:
    ## The documented item's name, `Type.method` for a method, and which
    ## example of it this is, from 1.
    item: String
    ordinal: int
    fence_line: int
    lines: list[(int, int, String)]

impl DocExample:
    ## The test's name.
    pure def test_name(self) -> String:
        if self.ordinal == 1:
            return "{self.item} (doc example)"
        return "{self.item} (doc example {self.ordinal})"

## The name a doc test gives the type an `impl` is for: its path, with `T?`
## named `Option` and `T ! E` named `Result`, as they are declared.
pure def impl_owner_name(ast: Ast, ty: TypeExprId) -> String:
    match ast.type_expr(ty).kind:
        case TypeKind.Path(segments, _):
            var parts: list[String] = []
            for s in segments:
                parts.push(s.text.copy())
            return parts.join(".")
        case TypeKind.Option(_):
            return "Option".to_string()
        case TypeKind.Result(_, _):
            return "Result".to_string()
        case TypeKind.Ref(_, inner):
            return impl_owner_name(ast, inner)
        case _:
            return "impl".to_string()

## A `##` line's indentation and its text after the marker; `None` for any
## other line (`##!` is a module's doc).
pure def doc_line(line: str) -> (int, String)?:
    var indent = 0
    while indent < line.byte_len() and line.byte_at(indent) == 32:
        indent += 1
    let rest = line.byte_slice(indent, line.byte_len())
    if not rest.starts_with("##") or rest.starts_with("##!"):
        return None
    return Some((indent, rest.byte_slice(2, rest.byte_len()).to_string()))

## The examples in a text (stage 0's `doctests::examples`): an example is
## a fenced block in a run of `##` lines, opened by "```" or "```sisu" and
## closed by "```", and documents the first item that starts after the run;
## one with no item after it, or no line, is none.
pure def doc_examples(text: str, starts: list[(int, String)]) -> list[DocExample]:
    var counts: dict[String, int] = {}
    var out: list[DocExample] = []
    var run: list[DocExample] = []
    var open: DocExample? = None
    var offset = 0
    var index = 0
    for raw in text.split("\n"):
        let start = offset
        offset += raw.byte_len() + 1
        var bare = raw.to_string()
        if bare.ends_with("\r"):
            bare = bare.byte_slice(0, bare.byte_len() - 1).to_string()
        match doc_line(bare):
            case Some((indent, content)):
                let fence = content.trim()
                match open:
                    case Some(e):
                        if fence == "```":
                            run.push(e.copy())
                            open = None
                        else:
                            var col = indent + 2
                            var body = content.copy()
                            if content.starts_with(" "):
                                col = indent + 3
                                body = content.byte_slice(1, content.byte_len()).to_string()
                            if not body.trim().is_empty():
                                if let Some(x) = ref mut open:
                                    x.lines.push((index, col, body))
                    case None:
                        if fence == "```" or fence == "```sisu":
                            open = Some(
                                DocExample(item=String.new(), ordinal=0, fence_line=index, lines=[])
                            )
            case None:
                open = None
                finish_doc_run(mut run, start, starts, mut counts, mut out)
        index += 1
    finish_doc_run(mut run, text.byte_len(), starts, mut counts, mut out)
    var kept: list[DocExample] = []
    for e in out:
        if not e.lines.is_empty():
            kept.push(e.copy())
    return kept

## The examples of a run that ended at `at` document the first item that
## starts there or later; without one they are none.
pure def finish_doc_run(
    mut run: list[DocExample],
    at: int,
    starts: list[(int, String)],
    mut counts: dict[String, int],
    mut out: list[DocExample],
):
    if run.is_empty():
        return
    var item: (int, String)? = None
    for (s, name) in starts:
        if s < at:
            continue
        match item:
            case Some((best, _)):
                if s < best:
                    item = Some((s, name.copy()))
            case None:
                item = Some((s, name.copy()))
    if let Some((_, name)) = item:
        for e in run:
            let n = (counts.get(name.copy()) ?? 0) + 1
            _ = counts.insert(name.copy(), n)
            var x = e.copy()
            x.item = name.copy()
            x.ordinal = n
            out.push(x)
    run.clear()

## The module of tests for the examples (stage 0's `doctests::test_module`):
## as many lines as `text`, the opening fence's line holding the test's
## header, the example's lines its body, every other line empty.
pure def doc_test_module(text: str, examples: list[DocExample]) -> String:
    var count = 0
    for _ in text.split("\n"):
        count += 1
    if text.ends_with("\n"):
        count -= 1
    if count < 1:
        count = 1
    var lines: list[String] = []
    for _ in range(count):
        lines.push(String.new())
    for k in range(len(examples)):
        let e = ref examples[k]
        if e.fence_line < count:
            lines[e.fence_line] = "test {quote(e.test_name())}:"
        for (line, col, body) in e.lines:
            if line < count:
                var l = String.new()
                for _ in range(col):
                    l.push(" ")
                l.push(body)
                lines[line] = l
    var out = lines.join("\n")
    out.push("\n")
    return out

## A type's outermost constructor, for telling impl headers apart without
## unifying them; `None` for what unifies with anything.
pure def outermost(types: Types, t: Ty) -> (int, int)?:
    return match types.data(t):
        case TyData.Param(_) | TyData.Assoc(_, _, _) | TyData.Var(_) | TyData.Error: None
        case TyData.ErrSet(_) | TyData.ConstOp(_, _): None
        case TyData.Int: Some((0, 0))
        case TyData.Float: Some((1, 0))
        case TyData.Bool: Some((2, 0))
        case TyData.Char: Some((3, 0))
        case TyData.Str: Some((4, 0))
        case TyData.Unit: Some((5, 0))
        case TyData.Never: Some((6, 0))
        case TyData.Adt(d, _): Some((7, d.index))
        case TyData.Tuple(e, _): Some((8, len(e)))
        case TyData.Fn(ps, _, _): Some((9, len(ps)))
        case TyData.Ref(_, m): Some((10, if m: 1 else: 0))
        case TyData.Dyn(tr): Some((11, tr.def_.index))
        case TyData.Const(c): Some((12, c))

## How a parameter is passed, as a signature writes it.
pure def mode_text(m: Mode) -> str:
    return match m:
        case Mode.Borrow: ""
        case Mode.Mut: "mut "
        case Mode.Own: "own "
