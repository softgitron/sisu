##! The declarations of a program, collected and resolved (stage 0's
##! `sisu-resolve`: `collect.rs`, with the types as written of `types.rs`
##! and the traits and impls of `traits.rs`): every module's items become
##! definitions, every signature a type, every method an entry of the
##! method table.
##!
##! The prelude, the ambient std modules, `target` and `builtin_impls` are
##! resolved once (`Resolver.base`); each file is then its root module's
##! items, declared and resolved on a copy. Stage 0 declares every module's
##! items before it resolves any, so its definitions of a file's root
##! module come before those the prelude's impls and traits make; here they
##! come after, which changes no name the checker reports.
##!
##! The resolver reports the type checker's own messages it finds in
##! signatures (`type.not-generic`, `type.type-arguments-needed`,
##! `type.unsized-dyn`); the names it cannot find are the name pass's to
##! report. What it does not implement in the root module (imports, derive
##! templates, refinements, contracts, parametrised tests, a script's
##! statements) puts the module beyond the slice the checker covers.

from stage1.diag import Catalog, Diagnostic, Msg, TextRange
from stage1.parser import parse
from stage1.resolve import closest
from stage1.syntax.ast import (
    Arg,
    Ast,
    Attr,
    BinOp,
    Block,
    ClosureBody,
    ConstDef,
    EnumDef,
    Expr,
    ExprId,
    ExprKind,
    FnDef,
    FromImport,
    GenericParam,
    ImplDef,
    Import,
    IndexArg,
    Item,
    ItemId,
    ItemKind,
    Mode,
    Module,
    Name,
    Param,
    ParamKind,
    PatternId,
    Stmt,
    StmtId,
    StmtKind,
    StructDef,
    TestDef,
    TraitDef,
    TypeAlias,
    TypeExpr,
    TypeExprId,
    TypeKind,
    Vis,
)
from stage1.syntax.ast import build
from stage1.syntax.ast import visit
from stage1.typeck.program import (
    AssocInfo,
    ConstInfo,
    Def,
    DefKind,
    EnumInfo,
    FieldInfo,
    FnInfo,
    FnKind,
    Generic,
    ImplInfo,
    ModuleData,
    ModuleId,
    ParamInfo,
    Predicate,
    Program,
    RefinementInfo,
    StructInfo,
    TraitInfo,
    VariantInfo,
    WellKnown,
    derivable,
)
from stage1.typeck.std_sources import ambient, builtin_impls, importable, module_for, module_paths, reexports, target
from stage1.typeck.ty import DefId, TraitRef, Ty, TyData, TyKey, Types

## Where a method is declared, which decides the generics, bounds and
## `Self` of its signature.
enum Owner:
    ## Written in a struct's or enum's body.
    Type(DefId)
    ## `impl[...] Type:`.
    Inherent(generics: list[Generic], names: list[String], predicates: list[Predicate], self_ty: Ty)
    ## A trait's method.
    Trait(DefId)
    ## A trait impl's method.
    Impl(DefId)
    ## A refinement type's predicate, whose `self` is a value of the base.
    Refinement(DefId)

## A declaration waiting for its signature.
enum Pending:
    Fn(def_: DefId, module: ModuleId, ast: FnDef, owner: Owner?)
    Struct(def_: DefId, module: ModuleId, ast: StructDef, attrs: list[Attr])
    Enum(def_: DefId, module: ModuleId, ast: EnumDef, attrs: list[Attr])
    Trait(def_: DefId, module: ModuleId, ast: TraitDef, attrs: list[Attr])
    Impl(module: ModuleId, ast: ImplDef, range: TextRange)
    Test(def_: DefId, module: ModuleId, ast: TestDef)
    Const(def_: DefId, module: ModuleId, ast: ConstDef)
    Refinement(def_: DefId, module: ModuleId, ast: TypeAlias, node: int, range: TextRange)
    ## An impl the compiler writes: `@derive(trait_)` (or the `Debug` every
    ## struct and enum has), or `@delegate(trait_, to=...)`.
    Derived(
        ty: DefId,
        module: ModuleId,
        trait_: String,
        derived: bool,
        used: list[bool],
        range: TextRange
    )

## What a type expression may mention where it is written.
struct TyCtx:
    module: ModuleId
    generics: list[String]
    self_ty: Ty?
    allow_ref: bool
    ## Bounds in scope, which give `C.Item` its trait.
    predicates: list[Predicate]
    ## Inside a trait: its own associated types may be named bare.
    in_trait: DefId?
    ## Inside a trait impl: what it binds its associated types to.
    impl_assoc: list[(String, Ty)]

impl TyCtx:
    pure def plain(module: ModuleId, generics: list[String], allow_ref: bool) -> TyCtx:
        return TyCtx(
            module=module,
            generics=generics.copy(),
            self_ty=None,
            allow_ref=allow_ref,
            predicates=[],
            in_trait=None,
            impl_assoc=[],
        )

pub struct Resolver:
    pub prog: Program
    pub types: Types
    ## Each module's syntax, by module index.
    pub sources: list[Module]
    ## The type checker's messages found in signatures, with their module.
    pub diags: list[(ModuleId, Diagnostic)]
    ## Why the root module is beyond the checker's slice, when it is.
    pub beyond: String?
    pending: list[Pending]
    aliases: dict[DefId, (ModuleId, TypeAlias)]
    resolving_alias: list[DefId]
    ## The generic parameters of every struct, enum, trait and refinement,
    ## known before any of them is resolved.
    type_params: dict[DefId, list[GenericParam]]
    headers_done: set[DefId]
    ## The bounds of every struct's and enum's generic parameters.
    type_preds: dict[DefId, list[Predicate]]
    ## The std modules a program may import, parsed once by the base.
    std_parsed: dict[String, Module]
    ## The std modules loaded, by name.
    std_loaded: dict[String, ModuleId]
    ## While the root module's items are declared: its imports, declared
    ## once every item is (stage 0's deferred imports).
    deferring: bool
    deferred: list[(ModuleId, ItemId)]
    ## Stage 0 reports an error about the root module's declarations that
    ## is not the type checker's (a `resolve.` message).
    pub other_error: bool
    ## The functions the compiler writes and checks elsewhere too, which
    ## report nothing of their own.
    pub quiet_fns: set[DefId]
    ## The kinds of the functions the compiler writes.
    special_kinds: dict[DefId, FnKind]
    ## `@derive(Copy)` to check against the fields, with the type.
    copy_checks: list[DefId]
    ## The functions the compiler writes without a body here.
    written: set[DefId]
    ## The root module's text.
    root_text: String
    ## The module of the root module's doc examples, a test each, and its
    ## text, which keeps every example line where the file has it.
    pub doc_module: ModuleId?
    pub doc_text: String

impl Resolver:
    pub pure def new() -> Resolver:
        return Resolver(
            prog=Program.new(),
            types=Types.new(),
            sources=[],
            diags=[],
            beyond=None,
            pending=[],
            aliases={},
            resolving_alias=[],
            type_params={},
            headers_done=set(),
            type_preds={},
            std_parsed={},
            std_loaded={},
            deferring=False,
            deferred=[],
            other_error=False,
            quiet_fns=set(),
            special_kinds={},
            copy_checks=[],
            written=set(),
            root_text=String.new(),
            doc_module=None,
            doc_text=String.new(),
        )

    ## The prelude, the ambient std modules, `target` and `builtin_impls`,
    ## resolved: `texts` gives each std module's source by name.
    pub pure def base(texts: dict[String, String]) -> Resolver:
        var r = Resolver.new()
        let prelude = r.load_std("prelude", text_of(texts, "prelude"))
        r.prog.prelude = prelude
        r.fill_well_known()
        for name in ambient():
            let m = r.load_std(name, text_of(texts, name))
            let d = r.new_def(prelude, name, TextRange.empty(0), Vis.Pub, DefKind.Module(m))
            _ = r.prog.modules[prelude.index].items.insert(name.to_string(), d)
        let t = r.load_std("target", target())
        let td = r.new_def(prelude, "target", TextRange.empty(0), Vis.Pub, DefKind.Module(t))
        _ = r.prog.modules[prelude.index].items.insert("target".to_string(), td)
        _ = r.load_std("builtin_impls", builtin_impls())
        r.resolve_pending()
        r.build_variant_index(0)
        r.check_traits(0)
        # The std modules' bodies are never checked: their syntax goes.
        for i in range(len(r.sources)):
            r.sources[i] = Module(ast=Ast.new(), items=[], docs=[], broken_names=[])
        # The std modules a program may import, parsed once.
        for name in importable():
            let text = text_of(texts, name)
            if not text.is_empty():
                let module = build.module(parse(text, Catalog.parse("")).tree)
                _ = r.std_parsed.insert(name.to_string(), module)
        return r

    ## A prelude of the given text alone, resolved: no ambient modules, no
    ## `target` and no `builtin_impls` (for the tests).
    pub pure def base_from(prelude_text: str) -> Resolver:
        var r = Resolver.new()
        let prelude = r.load_std("prelude", prelude_text)
        r.prog.prelude = prelude
        r.fill_well_known()
        r.resolve_pending()
        r.build_variant_index(0)
        r.check_traits(0)
        return r

    ## Declares and resolves the root module, `module`, the syntax of a
    ## file: the base with the file's module added.
    pub pure def add_root(mut self, own module: Module, text: str):
        let script = text.starts_with("#!")
        self.root_text = text.to_string()
        let first_def = len(self.prog.defs)
        let poisoned = module.broken_names.copy()
        let items = module.items.copy()
        let root = self.add_module("main", False, module)
        self.prog.root = root
        for n in poisoned:
            _ = self.prog.poisoned.add(n.copy())
        var items_declared = items.copy()
        if script:
            items_declared = self.script_items(root, items)
        # Every item, then the imports, then the impls the compiler writes.
        self.deferring = True
        self.declare_items(root, items_declared, "")
        self.declare_trait_shims(root, items_declared)
        self.declare_doc_tests(root, items_declared)
        self.deferring = False
        let deferred = self.deferred.copy()
        self.deferred = []
        for (m, id) in deferred:
            self.declare_import(m, id)
        self.declare_derived(root, items)
        self.declare_generators(root, items)
        self.resolve_pending()
        self.build_variant_index(first_def)
        self.check_traits(first_def)

    ## The program, its table of types and the root module's syntax.
    pub pure def into_parts(own self) -> (Program, Types, Module):
        var sources = self.sources
        var root = Module(ast=Ast.new(), items=[], docs=[], broken_names=[])
        let at = self.prog.root.index
        if at < len(sources):
            # The modules the root module imports come after it.
            while len(sources) > at + 1:
                _ = sources.pop()
            root = sources.pop() ?? root
        return (self.prog, self.types, root)

    ## The syntax of the module of doc examples, when there is one.
    pub pure def doc_syntax(self) -> Module?:
        let m = self.doc_module else:
            return None
        if m.index >= len(self.sources):
            return None
        return Some(self.sources[m.index].copy())

    pure def add_module(mut self, name: str, is_std: bool, own module: Module) -> ModuleId:
        let id = ModuleId(index=len(self.prog.modules))
        self.prog.modules.push(
            ModuleData(
                name=name.to_string(), items={}, order=[], is_std=is_std, parent=None, imported={}
            )
        )
        self.sources.push(module)
        return id

    pure def load_std(mut self, name: str, text: str) -> ModuleId:
        let module = build.module(parse(text, Catalog.parse("")).tree)
        return self.load_std_module(name, module)

    ## Declares a parsed std module, once.
    pure def load_std_module(mut self, name: str, own module: Module) -> ModuleId:
        if let Some(m) = self.std_loaded.get(name.to_string()):
            return m
        let items = module.items.copy()
        let m = self.add_module(name, True, module)
        _ = self.std_loaded.insert(name.to_string(), m)
        self.declare_items(m, items, "")
        self.declare_derived(m, items)
        return m

    pure def fill_well_known(mut self):
        let p = self.prog.prelude
        var wk = WellKnown.none()
        wk.option = self.prog.lookup_in(p, "Option")
        wk.result = self.prog.lookup_in(p, "Result")
        wk.ordering = self.prog.lookup_in(p, "Ordering")
        wk.string = self.prog.lookup_in(p, "String")
        wk.list = self.prog.lookup_in(p, "list")
        wk.dict = self.prog.lookup_in(p, "dict")
        wk.set = self.prog.lookup_in(p, "set")
        wk.iter = self.prog.lookup_in(p, "Iter")
        wk.iterable = self.prog.lookup_in(p, "Iterable")
        wk.range = self.prog.lookup_in(p, "range")
        wk.boxed = self.prog.lookup_in(p, "Box")
        wk.display = self.prog.lookup_in(p, "Display")
        wk.debug = self.prog.lookup_in(p, "Debug")
        wk.eq = self.prog.lookup_in(p, "Eq")
        wk.partial_ord = self.prog.lookup_in(p, "PartialOrd")
        wk.ord = self.prog.lookup_in(p, "Ord")
        wk.hash = self.prog.lookup_in(p, "Hash")
        wk.len = self.prog.lookup_in(p, "Len")
        wk.copy = self.prog.lookup_in(p, "Copy")
        wk.drop = self.prog.lookup_in(p, "Drop")
        wk.iterator = self.prog.lookup_in(p, "Iterator")
        wk.add = self.prog.lookup_in(p, "Add")
        wk.sub = self.prog.lookup_in(p, "Sub")
        wk.mul = self.prog.lookup_in(p, "Mul")
        wk.div = self.prog.lookup_in(p, "Div")
        wk.rem = self.prog.lookup_in(p, "Rem")
        wk.neg = self.prog.lookup_in(p, "Neg")
        wk.from_literal = self.prog.lookup_in(p, "FromLiteral")
        wk.send = self.prog.lookup_in(p, "Send")
        wk.sync = self.prog.lookup_in(p, "Sync")
        wk.escapable = self.prog.lookup_in(p, "Escapable")
        wk.system = self.prog.lookup_in(p, "System")
        wk.formatter = self.prog.lookup_in(p, "Formatter")
        wk.fs_ops = self.prog.lookup_in(p, "FsOps")
        wk.net_ops = self.prog.lookup_in(p, "NetOps")
        wk.clock_ops = self.prog.lookup_in(p, "ClockOps")
        wk.rand_ops = self.prog.lookup_in(p, "RandOps")
        wk.env_ops = self.prog.lookup_in(p, "EnvOps")
        wk.stdin_ops = self.prog.lookup_in(p, "StdinOps")
        wk.proc_ops = self.prog.lookup_in(p, "ProcOps")
        self.prog.wk = wk

    pure def is_std(self, module: ModuleId) -> bool:
        return self.prog.modules[module.index].is_std

    pure def is_root(self, module: ModuleId) -> bool:
        return not self.is_std(module)

    ## Puts the root module beyond the slice, for `why`.
    pure def beyond_in(mut self, module: ModuleId, why: str):
        if self.is_root(module) and self.beyond.is_none():
            self.beyond = Some(why.to_string())

    ## Reports `m` at `at` with one parameter, for the module `module`.
    pure def report_at(mut self, module: ModuleId, m: Msg, at: TextRange, name: str, value: str):
        let diag = Diagnostic.new(m, at.start, at.end).with(name, value)
        self.diags.push((module, diag))

    pub pure def new_def(
        mut self, module: ModuleId, name: str, range: TextRange, vis: Vis, own kind: DefKind
    ) -> DefId:
        let id = DefId(index=len(self.prog.defs))
        self.prog.defs.push(
            Def(name=name.to_string(), module=module, span=range, vis=vis, kind=kind)
        )
        return id

    ## Declares a name in a module; a second declaration is the name pass's
    ## to report, and the first stays.
    pure def bind(mut self, module: ModuleId, name: str, def_: DefId):
        if name.is_empty():
            return
        if self.prog.modules[module.index].items.contains(name.to_string()):
            # `resolve.duplicate-definition`.
            if self.is_root(module):
                self.other_error = True
            return
        _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        self.prog.modules[module.index].order.push(def_)

    pub pure def placeholder_fn(self, own kind: FnKind) -> FnInfo:
        return FnInfo(
            generics=[],
            impl_generics=0,
            predicates=[],
            trait_=None,
            impl_=None,
            self_mode=None,
            owner=None,
            params=[],
            keyword_only_from=None,
            positional_only_until=0,
            ret=Ty.unit(),
            ret_span=None,
            err_inferred=False,
            pure=False,
            comptime_=False,
            intrinsic=None,
            internal=False,
            body=None,
            kind=kind,
            header_broken=False,
            body_broken=False,
            contracts=False,
        )

    pure def ast(self, module: ModuleId) -> ref Ast:
        return ref self.sources[module.index].ast

    # ---------------------------------------------------------------- pass 1

    pub pure def declare_items(mut self, module: ModuleId, items: list[ItemId], test_prefix: str):
        for id in items:
            let item = self.sources[module.index].ast.item(id).copy()
            match item.kind:
                case ItemKind.Fn(f):
                    let info = self.placeholder_fn(FnKind.Free)
                    let def_ = self.new_def(
                        module, f.name.text, f.name.range, item.vis, DefKind.Fn(info)
                    )
                    self.bind(module, f.name.text, def_)
                    self.pending.push(
                        Pending.Fn(def_=def_, module=module, ast=f.copy(), owner=None)
                    )
                case ItemKind.Struct(s):
                    let info = StructInfo(
                        generics=[],
                        fields=[],
                        builtin=None,
                        copy=False,
                        view_=s.is_view,
                        must_consume=False,
                        derives=[],
                    )
                    let def_ = self.new_def(
                        module, s.name.text, s.name.range, item.vis, DefKind.Struct(info)
                    )
                    self.bind(module, s.name.text, def_)
                    _ = self.type_params.insert(def_, s.generics.copy())
                    self.declare_methods(module, def_, s.methods)
                    for c in s.consts:
                        self.declare_assoc_const(module, TyKey.Adt(def_), s.name.text, c)
                    # `invariant e` lines (07): a method of the struct that
                    # checks them, which construction, every `mut self`
                    # method and the `Mutex` rule call.
                    if not s.invariants.is_empty():
                        self.declare_invariant(module, def_, item.node, s)
                    self.pending.push(
                        Pending.Struct(
                            def_=def_, module=module, ast=s.copy(), attrs=item.attrs.copy()
                        )
                    )
                case ItemKind.Enum(e):
                    self.declare_enum(module, e, item.vis, item.attrs, False)
                case ItemKind.ErrorSet(e):
                    self.declare_enum(module, e, item.vis, item.attrs, True)
                case ItemKind.Impl(i):
                    self.pending.push(Pending.Impl(module=module, ast=i.copy(), range=item.range))
                case ItemKind.Trait(t):
                    let def_ = self.new_def(
                        module, t.name.text, t.name.range, item.vis, DefKind.Trait(TraitInfo.new())
                    )
                    self.bind(module, t.name.text, def_)
                    _ = self.type_params.insert(def_, t.generics.copy())
                    self.pending.push(
                        Pending.Trait(
                            def_=def_, module=module, ast=t.copy(), attrs=item.attrs.copy()
                        )
                    )
                case ItemKind.Import(_) | ItemKind.FromImport(_):
                    if self.deferring:
                        self.deferred.push((module, id))
                    else:
                        self.declare_import(module, id)
                case ItemKind.Test(t):
                    let name = prefixed(test_prefix, t.name)
                    # A parametrised test is a test for each case (17).
                    for (case_name, case_def) in self.test_cases(module, name, t):
                        let info = self.placeholder_fn(FnKind.Test(case_name.copy()))
                        let def_ = self.new_def(
                            module, case_name, t.name_range, Vis.Private, DefKind.Fn(info)
                        )
                        self.prog.tests.push(def_)
                        self.pending.push(
                            Pending.Test(def_=def_, module=module, ast=case_def.copy())
                        )
                case ItemKind.Suite(s):
                    let prefix = prefixed(test_prefix, s.name)
                    self.declare_items(module, s.items, prefix)
                case ItemKind.Bench(t):
                    let name = prefixed(test_prefix, t.name)
                    let info = self.placeholder_fn(FnKind.Test(name.copy()))
                    let def_ = self.new_def(
                        module, name, t.name_range, Vis.Private, DefKind.Fn(info)
                    )
                    self.pending.push(Pending.Test(def_=def_, module=module, ast=t.copy()))
                case ItemKind.Const(c):
                    let info = ConstInfo(ty=Ty.error(), value=None)
                    let def_ = self.new_def(
                        module, c.name.text, c.name.range, item.vis, DefKind.Const(info)
                    )
                    self.bind(module, c.name.text, def_)
                    self.pending.push(Pending.Const(def_=def_, module=module, ast=c.copy()))
                case ItemKind.TypeAlias(a):
                    if a.refinement:
                        let info = RefinementInfo(
                            generics=[], base=Ty.error(), predicate=None, text=String.new()
                        )
                        let def_ = self.new_def(
                            module, a.name.text, a.name.range, item.vis, DefKind.Refinement(info)
                        )
                        self.bind(module, a.name.text, def_)
                        _ = self.type_params.insert(def_, a.generics.copy())
                        self.pending.push(
                            Pending.Refinement(
                                def_=def_,
                                module=module,
                                ast=a.copy(),
                                node=item.node,
                                range=item.range,
                            )
                        )
                    else:
                        let def_ = self.new_def(
                            module,
                            a.name.text,
                            a.name.range,
                            item.vis,
                            DefKind.TypeAlias(Ty.error()),
                        )
                        self.bind(module, a.name.text, def_)
                        _ = self.aliases.insert(def_, (module, a.copy()))
                case ItemKind.Extern(_):
                    # `stage0.unsupported`: nothing is declared.
                    if self.is_root(module):
                        self.other_error = True
                case _:
                    pass

    pure def declare_enum(
        mut self, module: ModuleId, e: EnumDef, vis: Vis, attrs: list[Attr], error_set: bool
    ):
        let info = EnumInfo(
            generics=[], variants=[], open=e.open, copy=False, must_consume=False, derives=[]
        )
        let kind = if error_set: DefKind.ErrorSet(info) else: DefKind.Enum(info)
        let def_ = self.new_def(module, e.name.text, e.name.range, vis, kind)
        self.bind(module, e.name.text, def_)
        _ = self.type_params.insert(def_, e.generics.copy())
        self.declare_methods(module, def_, e.methods)
        self.pending.push(Pending.Enum(def_=def_, module=module, ast=e.copy(), attrs=attrs.copy()))

    pure def declare_methods(mut self, module: ModuleId, owner: DefId, methods: list[FnDef]):
        for m in methods:
            let vis = if self.is_std(module): Vis.Pub else: m.vis
            let info = self.placeholder_fn(FnKind.Method)
            let def_ = self.new_def(module, m.name.text, m.name.range, vis, DefKind.Fn(info))
            self.pending.push(
                Pending.Fn(def_=def_, module=module, ast=m.copy(), owner=Some(Owner.Type(owner)))
            )

    # ---------------------------------------------------------------- pass 2

    pub pure def resolve_pending(mut self):
        # The generic parameters of every type and trait first.
        self.resolve_headers()
        # Aliases next, so that later declarations can use them.
        var alias_ids: list[int] = []
        for d in self.aliases.keys():
            if not self.headers_done.contains(d):
                alias_ids.push(d.index)
        alias_ids.sort()
        for i in alias_ids:
            _ = self.headers_done.add(DefId(index=i))
        for i in alias_ids:
            _ = self.resolve_alias(DefId(index=i))
        # Types, then traits, then impls, then functions.
        var pending: list[Pending] = []
        while let Some(p) = self.pending.pop():
            pending.push(p)
        pending.reverse()
        for p in pending:
            if let Pending.Trait(def_, module, t, attrs) = p:
                self.resolve_trait_header(def_, module, t, attrs)
        var types: list[Pending] = []
        var traits: list[Pending] = []
        var impls: list[Pending] = []
        var rest: list[Pending] = []
        for p in own pending:
            match p:
                case Pending.Struct(_, _, _, _) | Pending.Enum(_, _, _, _):
                    types.push(p)
                case Pending.Refinement(_, _, _, _, _):
                    types.push(p)
                case Pending.Trait(_, _, _, _):
                    traits.push(p)
                case Pending.Impl(_, _, _) | Pending.Derived(_, _, _, _, _, _):
                    impls.push(p)
                case _:
                    rest.push(p)
        for p in own types:
            self.resolve_one(p)
        for p in own traits:
            self.resolve_one(p)
        for p in own impls:
            self.resolve_one(p)
        var queue = rest
        # Traits and impls push the functions they declare.
        while let Some(p) = self.pending.pop():
            queue.push(p)
        while not queue.is_empty():
            for p in own queue:
                self.resolve_one(p)
            queue = []
            var more: list[Pending] = []
            while let Some(p) = self.pending.pop():
                more.push(p)
            more.reverse()
            queue = more

    pure def resolve_alias(mut self, d: DefId) -> Ty:
        if let DefKind.TypeAlias(t) = self.prog.defs[d.index].kind:
            if t != Ty.error():
                return t
        let entry = self.aliases.get(d) else:
            return Ty.error()
        let module = entry.0
        let alias = entry.1.copy()
        if self.resolving_alias.contains(d):
            return Ty.error()
        self.resolving_alias.push(d)
        var names: list[String] = []
        for g in alias.generics:
            names.push(g.name.text.copy())
        let ctx = TyCtx.plain(module, names, self.is_std(module))
        var ty = Ty.error()
        if let Some(t) = alias.ty:
            if let TypeKind.Union(_) = self.ast(module).type_expr(t).kind:
                ty = self.resolve_error_set(t, ctx)
            else:
                ty = self.resolve_ty(t, ctx)
        _ = self.resolving_alias.pop()
        self.prog.defs[d.index].kind = DefKind.TypeAlias(ty)
        return ty

    ## Whether an attribute list has `@derive(what)`.
    pure def has_derive(self, module: ModuleId, attrs: list[Attr], what: str) -> bool:
        return self.derives(module, attrs).contains(what.to_string())

    ## The names `@derive(...)` and `@delegate(...)` list.
    pure def derives(self, module: ModuleId, attrs: list[Attr]) -> list[String]:
        var out: list[String] = []
        for a in attrs:
            if a.name != "derive" and a.name != "delegate":
                continue
            for arg in a.args:
                if let ExprKind.Name(n) = self.ast(module).expr(arg.value).kind:
                    out.push(n.copy())
        return out

    ## The text of `@name("...")`, its first argument.
    pure def builtin_attr(self, module: ModuleId, attrs: list[Attr], name: str) -> String?:
        for a in attrs:
            if a.name == name:
                if let Some(arg) = a.args.first():
                    if let ExprKind.Str(parts) = self.ast(module).expr(arg.value).kind:
                        return Some(build.plain_text(parts))
                return None
        return None

    pure def resolve_one(mut self, own p: Pending):
        match p:
            case Pending.Struct(def_, module, s, attrs):
                self.resolve_struct(def_, module, s, attrs)
            case Pending.Enum(def_, module, e, attrs):
                self.resolve_enum(def_, module, e, attrs)
            case Pending.Trait(def_, module, t, _):
                self.resolve_trait(def_, module, t)
            case Pending.Fn(def_, module, f, owner):
                self.resolve_fn(def_, module, f, owner)
            case Pending.Test(def_, module, t):
                self.resolve_test(def_, module, t)
            case Pending.Const(def_, module, c):
                var ty = Ty.error()
                if let Some(t) = c.ty:
                    ty = self.resolve_ty(t, TyCtx.plain(module, [], False))
                self.prog.defs[def_.index].kind = DefKind.Const(ConstInfo(ty=ty, value=c.value))
            case Pending.Impl(module, imp, rng):
                self.resolve_impl(module, imp, rng)
            case Pending.Derived(ty, module, t, derived, used, rng):
                self.resolve_derived(ty, module, t, derived, used, rng)
            case Pending.Refinement(def_, module, a, node, rng):
                var names: list[String] = []
                for g in a.generics:
                    names.push(g.name.text.copy())
                var ctx = TyCtx.plain(module, names, False)
                ctx.predicates = self.preds_of(def_)
                var base = Ty.error()
                if let Some(t) = a.ty:
                    base = self.resolve_ty(t, ctx)
                # A refinement of a refinement keeps it as its base; a chain
                # that comes back is a cycle (`resolve.alias-cycle`).
                var at = base
                var cycle = False
                for _ in range(64):
                    let TyData.Adt(d, args) = self.types.data(at).copy() else:
                        break
                    if d == def_:
                        cycle = True
                        break
                    let b = self.prog.refinement_base(mut self.types, d, args) else:
                        break
                    at = b
                if cycle:
                    if self.is_root(module):
                        self.other_error = True
                    base = Ty.error()
                if let DefKind.Refinement(r) = ref mut self.prog.defs[def_.index].kind:
                    r.base = base
                self.declare_predicate(module, def_, node, a, rng)

    pure def resolve_struct(
        mut self, def_: DefId, module: ModuleId, s: StructDef, attrs: list[Attr]
    ):
        let (names, predicates) = self.type_param_scope(def_)
        let self_ty = self.self_type(def_, len(names))
        var fields: list[FieldInfo] = []
        for f in s.fields:
            var dup = False
            for x in fields:
                if x.name == f.name.text:
                    dup = True
            if dup:
                continue
            var ctx = TyCtx.plain(module, names, True)
            ctx.self_ty = Some(self_ty)
            ctx.predicates = predicates.copy()
            let ty = self.resolve_ty(f.ty, ctx)
            let at = self.ast(module).type_expr(f.ty).range
            self.check_sized(module, ty, at)
            fields.push(
                FieldInfo(
                    name=f.name.text.copy(), ty=ty, default=f.default, span=f.range, vis=f.vis
                )
            )
        if not s.unsupported.is_empty():
            self.beyond_in(module, "a contract in a struct")
        let builtin = self.builtin_attr(module, attrs, "builtin")
        let copy = self.has_derive(module, attrs, "Copy")
        let must_consume = has_attr(attrs, "must_consume")
        let derives = self.derives(module, attrs)
        if let DefKind.Struct(info) = ref mut self.prog.defs[def_.index].kind:
            info.fields = fields
            info.builtin = builtin
            info.copy = copy
            info.must_consume = must_consume
            info.derives = derives

    pure def resolve_enum(mut self, def_: DefId, module: ModuleId, e: EnumDef, attrs: list[Attr]):
        let (names, predicates) = self.type_param_scope(def_)
        let self_ty = self.self_type(def_, len(names))
        let std = self.is_std(module)
        var variants: list[VariantInfo] = []
        for v in e.variants:
            var dup = False
            for x in variants:
                if x.name == v.name.text:
                    dup = True
            if dup:
                continue
            var ctx = TyCtx.plain(module, names, std)
            ctx.self_ty = Some(self_ty)
            ctx.predicates = predicates.copy()
            var fields: list[(String?, Ty)] = []
            for f in v.fields:
                let ty = self.resolve_ty(f.ty, ctx)
                let at = self.ast(module).type_expr(f.ty).range
                self.check_sized(module, ty, at)
                var fname: String? = None
                if let Some(n) = f.name:
                    fname = Some(n.text.copy())
                fields.push((fname, ty))
            variants.push(VariantInfo(name=v.name.text.copy(), fields=fields, span=v.range))
        let copy = self.has_derive(module, attrs, "Copy")
        let must_consume = has_attr(attrs, "must_consume")
        let derives = self.derives(module, attrs)
        match ref mut self.prog.defs[def_.index].kind:
            case DefKind.Enum(info):
                info.variants = variants
                info.copy = copy
                info.must_consume = must_consume
                info.derives = derives
            case DefKind.ErrorSet(info):
                info.variants = variants
                info.copy = copy
                info.must_consume = must_consume
                info.derives = derives
            case _:
                pass

    pure def resolve_test(mut self, def_: DefId, module: ModuleId, t: TestDef):
        let name = self.prog.defs[def_.index].name.copy()
        var info = self.placeholder_fn(FnKind.Test(name))
        for p in t.params:
            if let ParamKind.Named(n, ty, _) = p.kind:
                let resolved = self.resolve_ty(ty, TyCtx.plain(module, [], False))
                info.params.push(
                    ParamInfo(
                        name=n.text.copy(), mode=p.mode, ty=resolved, default=None, span=p.range
                    )
                )
        info.body = t.body.copy()
        self.prog.defs[def_.index].kind = DefKind.Fn(info)

    ## `Adt(d, [Param(0), ..., Param(n - 1)])`: a type in terms of its own
    ## parameters.
    pure def self_type(mut self, d: DefId, n: int) -> Ty:
        var args: list[Ty] = []
        for i in range(n):
            args.push(self.types.param(i))
        return self.types.adt(d, args)

    ## The names and bounds of a struct's or enum's generic parameters.
    pure def type_param_scope(self, d: DefId) -> (list[String], list[Predicate]):
        var names: list[String] = []
        for g in self.prog.type_generics(d):
            names.push(g.name.copy())
        return (names, self.preds_of(d))

    pure def resolve_fn(mut self, def_: DefId, module: ModuleId, f: FnDef, owner: Owner?):
        # The generics, bounds and `Self` the owner brings.
        var outer: list[Generic] = []
        var outer_names: list[String] = []
        var predicates: list[Predicate] = []
        var self_ty: Ty? = None
        var in_trait: DefId? = None
        var impl_def: DefId? = None
        match owner:
            case Some(Owner.Type(t)):
                outer = self.prog.type_generics(t)
                for g in outer:
                    outer_names.push(g.name.copy())
                predicates = self.preds_of(t)
                self_ty = Some(self.self_type(t, len(outer)))
            case Some(Owner.Inherent(generics, names, preds, st)):
                outer = generics.copy()
                outer_names = names.copy()
                predicates = preds.copy()
                self_ty = Some(st)
            case Some(Owner.Trait(t)):
                var generics = [Generic(name="Self".to_string(), default=None, is_const=False)]
                if let Some(info) = self.prog.trait_info(t):
                    for g in info.generics:
                        generics.push(g.copy())
                for g in generics:
                    outer_names.push(g.name.copy())
                var args: list[Ty] = []
                for i in range(1, len(generics)):
                    args.push(self.types.param(i))
                let tr = TraitRef(def_=t, args=args)
                predicates = [
                    Predicate(ty=self.types.param(0), bound=tr, span=self.prog.defs[t.index].span)
                ]
                outer = generics
                self_ty = Some(self.types.param(0))
                in_trait = Some(t)
            case Some(Owner.Impl(i)):
                if let Some(info) = self.prog.impl_info(i):
                    outer = info.generics.copy()
                    for g in info.generics:
                        outer_names.push(g.name.copy())
                    predicates = info.predicates.copy()
                    self_ty = Some(info.self_ty)
                    impl_def = Some(i)
            case Some(Owner.Refinement(r)):
                outer = self.prog.type_generics(r)
                for g in outer:
                    outer_names.push(g.name.copy())
                predicates = self.preds_of(r)
                if let Some(ri) = self.prog.refinement(r):
                    self_ty = Some(ri.base)
            case _:
                pass
        var names = outer_names.copy()
        for g in f.generics:
            names.push(g.name.text.copy())
        var generics = outer.copy()
        for g in f.generics:
            generics.push(Generic(name=g.name.text.copy(), default=None, is_const=g.is_const))
        var impl_assoc: list[(String, Ty)] = []
        if let Some(i) = impl_def:
            if let Some(info) = self.prog.impl_info(i):
                impl_assoc = info.assoc.copy()
        # The function's own bounds, then its `where` clause.
        let own_preds = self.resolve_bounds(module, f.generics, names, len(outer), in_trait)
        for p in own_preds:
            predicates.push(p.copy())
        for w in f.where_:
            let ctx = TyCtx(
                module=module,
                generics=names.copy(),
                self_ty=self_ty,
                allow_ref=True,
                predicates=predicates.copy(),
                in_trait=in_trait,
                impl_assoc=impl_assoc.copy(),
            )
            let ty = self.resolve_ty(w.ty, ctx)
            var new: list[Predicate] = []
            for b in w.bounds:
                if let Some(tr) = self.resolve_bound(b, ty, ctx):
                    new.push(Predicate(ty=ty, bound=tr, span=self.ast(module).type_expr(b).range))
            for p in own new:
                predicates.push(p)
        var info = self.placeholder_fn(FnKind.Free)
        info.generics = generics
        info.impl_generics = len(outer)
        info.predicates = predicates.copy()
        info.trait_ = in_trait
        info.impl_ = impl_def
        info.owner = self_ty
        info.pure = f.is_pure
        info.comptime_ = f.is_comptime
        info.body = f.body.copy()
        info.intrinsic = self.builtin_attr(module, f.attrs, "intrinsic")
        info.internal = has_attr(f.attrs, "internal")
        # A free generic function that reflects on its type parameters is a
        # template (08): stage 0 checks the instances its calls ask for.
        if self.is_root(module) and owner.is_none() and not f.generics.is_empty():
            if let Some(b) = f.body:
                if reflects(self.ast(module), b, f.generics):
                    self.beyond_in(
                        module, "a generic function that reflects on its type parameters"
                    )
        if self.is_root(module):
            info.contracts = not f.contracts(self.ast(module)).is_empty()
            if has_attr(f.attrs, "structural") or has_attr(f.attrs, "keeps"):
                self.beyond_in(module, "an attribute of a function")
        let ctx = TyCtx(
            module=module,
            generics=names.copy(),
            self_ty=self_ty,
            allow_ref=True,
            predicates=predicates.copy(),
            in_trait=in_trait,
            impl_assoc=impl_assoc.copy(),
        )
        for i in range(len(f.params)):
            let p = ref f.params[i]
            match p.kind:
                case ParamKind.SelfParam:
                    if owner.is_some() and i == 0:
                        info.self_mode = Some(p.mode)
                case ParamKind.Named(name, ty, default):
                    let resolved = self.resolve_ty(ty, ctx)
                    self.check_sized(module, resolved, p.range)
                    info.params.push(
                        ParamInfo(
                            name=name.text.copy(),
                            mode=p.mode,
                            ty=resolved,
                            default=default,
                            span=p.range,
                        )
                    )
                case ParamKind.KeywordOnly:
                    info.keyword_only_from = Some(len(info.params))
                case ParamKind.PositionalOnly:
                    info.positional_only_until = len(info.params)
                case ParamKind.Variadic(_, _):
                    self.beyond_in(module, "variadic parameters")
                case ParamKind.Error:
                    pass
        # The result type; `T !` infers the error set from the body.
        match f.ret:
            case None:
                info.ret = Ty.unit()
            case Some(t):
                let written = self.ast(module).type_expr(t).copy()
                info.ret_span = Some(written.range)
                match written.kind:
                    case TypeKind.Result(ok, None):
                        var ok_ty = Ty.unit()
                        if let Some(o) = ok:
                            ok_ty = self.resolve_ty(o, ctx)
                        info.err_inferred = True
                        info.ret = Ty.error()
                        if let Some(r) = self.prog.wk.result:
                            let empty = self.types.err_set([])
                            info.ret = self.types.adt(r, [ok_ty, empty])
                    case _:
                        info.ret = self.resolve_ty(t, ctx)
                self.check_sized(module, info.ret, written.range)
        info.body_broken = f.body_broken
        if f.header_broken:
            info.header_broken = True
            info.ret = Ty.error()
            info.err_inferred = False
        # A function without a body that is no trait's (`resolve.missing-body`).
        if info.body.is_none()
                and info.intrinsic.is_none()
                and not f.name.text.is_empty()
                and in_trait.is_none():
            if self.is_root(module) and not self.written.contains(def_):
                self.other_error = True
        # Register methods and associated functions.
        if let Some(o) = owner:
            if self.is_drop_impl(impl_def):
                info.kind = FnKind.Drop
            elif info.self_mode.is_some():
                info.kind = FnKind.Method
            else:
                info.kind = FnKind.Assoc
            match o:
                case Owner.Type(_) | Owner.Inherent(_, _, _, _):
                    if let Some(st) = self_ty:
                        if let Some(key) = self.types.key(st):
                            let k = (key, f.name.text.copy())
                            if not self.prog.methods.contains(k.copy()):
                                _ = self.prog.methods.insert(k, def_)
                            elif self.is_root(module):
                                # `resolve.duplicate-method`.
                                self.other_error = True
                case Owner.Trait(t):
                    if let DefKind.Trait(ti) = ref mut self.prog.defs[t.index].kind:
                        ti.methods.push(def_)
                case Owner.Impl(i):
                    if let DefKind.Impl(ii) = ref mut self.prog.defs[i.index].kind:
                        ii.methods.push((f.name.text.copy(), def_))
                # A refinement's predicate is nobody's method.
                case Owner.Refinement(_):
                    pass
        if let Some(k) = self.special_kinds.get(def_):
            info.kind = k.copy()
        self.prog.defs[def_.index].kind = DefKind.Fn(info)

    ## Whether an impl is of `Drop`.
    pure def is_drop_impl(self, impl_def: DefId?) -> bool:
        let i = impl_def else:
            return False
        let info = self.prog.impl_info(i) else:
            return False
        return Some(info.trait_ref.def_) == self.prog.wk.drop

    ## Every variant by its unqualified name, for the definitions from
    ## `first` on.
    pure def build_variant_index(mut self, first: int):
        for i in range(first, len(self.prog.defs)):
            var names: list[String] = []
            if let Some(e) = self.prog.enum_info(DefId(index=i)):
                for v in e.variants:
                    names.push(v.name.copy())
            for vi in range(len(names)):
                var entry: list[(DefId, int)] = []
                if let Some(l) = self.prog.variants.get(names[vi].copy()):
                    entry = l.copy()
                entry.push((DefId(index=i), vi))
                _ = self.prog.variants.insert(names[vi].copy(), entry)

    # ---------------------------------------------------------------- traits

    ## A trait's associated type names and supertraits, before any struct
    ## or enum.
    pure def resolve_trait_header(
        mut self, def_: DefId, module: ModuleId, t: TraitDef, attrs: list[Attr]
    ):
        var names = ["Self".to_string()]
        if let Some(info) = self.prog.trait_info(def_):
            for g in info.generics:
                names.push(g.name.copy())
        let self_ty = self.types.param(0)
        var assoc: list[AssocInfo] = []
        for a in t.assoc_types:
            var dup = False
            for x in assoc:
                if x.name == a.name.text:
                    dup = True
            if not dup:
                assoc.push(AssocInfo(name=a.name.text.copy(), default=None))
        let sealed = has_attr(attrs, "sealed")
        let marker = has_attr(attrs, "marker")
        if let DefKind.Trait(info) = ref mut self.prog.defs[def_.index].kind:
            info.assoc = assoc
            info.sealed = sealed
            info.marker = marker
        var supers: list[TraitRef] = []
        for s in t.supertraits:
            var ctx = TyCtx.plain(module, names, True)
            ctx.self_ty = Some(self_ty)
            ctx.in_trait = Some(def_)
            if let Some(tr) = self.resolve_bound(s, self_ty, ctx):
                if tr.def_ != def_:
                    supers.push(tr)
        if let DefKind.Trait(info) = ref mut self.prog.defs[def_.index].kind:
            info.supertraits = supers

    ## The rest of a trait, once types are known: its associated types'
    ## defaults and its methods.
    pure def resolve_trait(mut self, def_: DefId, module: ModuleId, t: TraitDef):
        var names = ["Self".to_string()]
        if let Some(info) = self.prog.trait_info(def_):
            for g in info.generics:
                names.push(g.name.copy())
        let self_ty = self.types.param(0)
        for i in range(len(t.assoc_types)):
            if let Some(te) = t.assoc_types[i].ty:
                var ctx = TyCtx.plain(module, names, True)
                ctx.self_ty = Some(self_ty)
                ctx.in_trait = Some(def_)
                let ty = self.resolve_ty(te, ctx)
                if let DefKind.Trait(info) = ref mut self.prog.defs[def_.index].kind:
                    if i < len(info.assoc):
                        info.assoc[i].default = Some(ty)
        for k in range(len(t.methods)):
            let m = ref t.methods[k]
            # A `comptime def` runs at compile time: the trait's derive is
            # not one of its methods.
            if m.is_comptime:
                continue
            var first = k
            for j in range(len(t.methods)):
                if t.methods[j].name.text == m.name.text:
                    first = min(first, j)
            if first != k:
                continue
            let info = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(info))
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=Some(Owner.Trait(def_)))
            )

    pure def resolve_impl(mut self, module: ModuleId, imp: ImplDef, range_in: TextRange):
        # The impl is named by its header, `impl[...] Trait for Type`.
        let self_range = self.ast(module).type_expr(imp.self_ty).range
        var range = range_in
        if self_range.end > range_in.start and self_range.end <= range_in.end:
            range = TextRange.new(range_in.start, self_range.end)
        var names: list[String] = []
        var generics: list[Generic] = []
        for g in imp.generics:
            names.push(g.name.text.copy())
            generics.push(Generic(name=g.name.text.copy(), default=None, is_const=g.is_const))
        let predicates = self.resolve_bounds(module, imp.generics, names, 0, None)
        var ctx = TyCtx.plain(module, names, True)
        ctx.predicates = predicates.copy()
        let self_ty = self.resolve_ty(imp.self_ty, ctx)
        let trait_ty = imp.trait_ty else:
            # An inherent impl adds methods to a type.
            let key = self.types.key(self_ty) else:
                if self_ty != Ty.error() and self.is_root(module):
                    # `resolve.not-a-type`.
                    self.other_error = True
                return
            let shown = self.prog.display(self.types, self_ty)
            var owner_name = String.new()
            for part in shown.split("["):
                if owner_name.is_empty():
                    owner_name = part.to_string()
            for c in imp.consts:
                self.declare_assoc_const(module, key, owner_name, c)
            for m in imp.methods:
                let vis = if self.is_std(module): Vis.Pub else: m.vis
                let info = self.placeholder_fn(FnKind.Method)
                let def_ = self.new_def(module, m.name.text, m.name.range, vis, DefKind.Fn(info))
                let owner = Owner.Inherent(
                    generics=generics.copy(),
                    names=names.copy(),
                    predicates=predicates.copy(),
                    self_ty=self_ty,
                )
                self.pending.push(
                    Pending.Fn(def_=def_, module=module, ast=m.copy(), owner=Some(owner))
                )
            return
        ctx.self_ty = Some(self_ty)
        let trait_ref = self.resolve_bound(trait_ty, self_ty, ctx) else:
            return
        if self_ty == Ty.error():
            return
        if let TyData.Adt(d, _) = self.types.data(self_ty):
            if let DefKind.Refinement(_) = self.prog.defs[d.index].kind:
                return
        # What the impl binds its associated types to.
        var assoc: list[(String, Ty)] = []
        var declared: list[String] = []
        if let Some(i) = self.prog.trait_info(trait_ref.def_):
            for a in i.assoc:
                declared.push(a.name.copy())
        for a in imp.assoc_types:
            if not declared.contains(a.name.text):
                continue
            var ty = Ty.error()
            if let Some(te) = a.ty:
                ty = self.resolve_ty(te, ctx)
            assoc.push((a.name.text.copy(), ty))
        let shown_trait = self.prog.display_trait_in(self.types, trait_ref, names)
        let shown_ty = self.prog.display_in(self.types, self_ty, names)
        let info = ImplInfo(
            generics=generics,
            predicates=predicates,
            trait_ref=trait_ref.copy(),
            self_ty=self_ty,
            methods=[],
            assoc=assoc,
            derived=False,
        )
        let def_ = self.new_def(
            module, "impl {shown_trait} for {shown_ty}", range, Vis.Pub, DefKind.Impl(info)
        )
        self.prog.impls.push(def_)
        for m in imp.methods:
            let finfo = self.placeholder_fn(FnKind.Method)
            let fdef = self.new_def(module, m.name.text, m.name.range, Vis.Pub, DefKind.Fn(finfo))
            self.pending.push(
                Pending.Fn(def_=fdef, module=module, ast=m.copy(), owner=Some(Owner.Impl(def_)))
            )

    # ---------------------------------------------------------------- imports

    ## An `import` or `from ... import` item of `module` (09, "Modules").
    pure def declare_import(mut self, module: ModuleId, id: ItemId):
        let item = self.sources[module.index].ast.item(id).copy()
        match item.kind:
            case ItemKind.Import(imp):
                self.import_module(module, imp, item.range, item.vis)
            case ItemKind.FromImport(imp):
                self.import_from(module, imp, item.range, item.vis)
            case _:
                pass

    ## The std module an import path names, loaded; `None` after noting
    ## that stage 0 reports the path (`resolve.import-unknown`), with the
    ## name a similar module's import would bind.
    pure def import_target(mut self, module: ModuleId, path: list[Name]) -> (ModuleId?, String?):
        var words: list[String] = []
        for n in path:
            words.push(n.text.copy())
        let name = module_for(words) else:
            if self.is_root(module):
                self.other_error = True
            var similar: String? = None
            if let Some(c) = closest(words.join("."), module_paths()):
                similar = Some(last_word(c))
            return (None, similar)
        if let Some(m) = self.std_loaded.get(name.copy()):
            return (Some(m), None)
        let parsed = self.std_parsed.get(name.copy()) else:
            # Stage 1 reads every std module it may import; one missing is
            # not one it can check against.
            self.beyond_in(module, "an import of a std module stage 1 has not read")
            return (None, None)
        let m = self.load_std_module(name, parsed.copy())
        return (Some(m), None)

    ## The names an import that failed would have bound: their uses are not
    ## reported again.
    pure def poison_import(mut self, module: ModuleId, name: str, similar: String?):
        if not self.is_root(module):
            return
        if let Some(s) = similar:
            _ = self.prog.poisoned.add(s.copy())
        _ = self.prog.poisoned.add(name.to_string())

    ## Records that an import bound `name` in `module`, with the import's
    ## visibility (a `pub` import re-exports it).
    pure def bind_import(mut self, module: ModuleId, name: str, def_: DefId, vis: Vis):
        if let Some(old) = self.prog.modules[module.index].items.get(name.to_string()):
            if old == def_:
                return
            if let DefKind.Module(a) = self.prog.defs[old.index].kind:
                if let DefKind.Module(b) = self.prog.defs[def_.index].kind:
                    if a == b:
                        return
            self.bind(module, name, def_)
            return
        _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        _ = self.prog.modules[module.index].imported.insert(name.to_string(), vis)

    pure def import_module(mut self, module: ModuleId, imp: Import, range: TextRange, vis: Vis):
        if imp.c_header.is_some():
            # `stage0.unsupported`.
            if self.is_root(module):
                self.other_error = True
            return
        var bound = String.new()
        var at = range
        match imp.alias:
            case Some(a):
                bound = a.text.copy()
                at = a.range
            case None:
                if let Some(last) = imp.path.last():
                    bound = last.text.copy()
                    at = last.range
        let (target, similar) = self.import_target(module, imp.path)
        let m = target else:
            self.poison_import(module, bound, similar)
            return
        let def_ = self.new_def(module, bound, at, vis, DefKind.Module(m))
        if self.is_std(module):
            self.bind(module, bound, def_)
        else:
            self.bind_import(module, bound, def_, vis)

    pure def import_from(mut self, module: ModuleId, imp: FromImport, range: TextRange, vis: Vis):
        let (target, similar) = self.import_target(module, imp.path)
        let m = target else:
            for (n, alias) in imp.names:
                var bound = n.text.copy()
                if let Some(a) = alias:
                    bound = a.text.copy()
                self.poison_import(module, bound, similar)
            return
        let mname = self.prog.modules[m.index].name.copy()
        let prelude = self.prog.prelude
        for (n, alias) in imp.names:
            var found = self.prog.member(m, n.text, module)
            var reexported = False
            for x in reexports(mname):
                if x == n.text:
                    reexported = True
            if found.is_none() and self.is_std(m) and reexported:
                if let Some(d) = self.prog.lookup_in(prelude, n.text):
                    found = Some((d, True))
            match found:
                case Some((d, visible)):
                    if not visible and self.is_root(module):
                        # `resolve.private-item` and its kin.
                        self.other_error = True
                    var bound = n.text.copy()
                    if let Some(a) = alias:
                        bound = a.text.copy()
                    self.bind_import(module, bound, d, vis)
                case None:
                    # `resolve.not-in-module`.
                    if self.is_root(module):
                        self.other_error = True

    # ---------------------------------------------------------------- scripts

    ## The items of a script (10, "REPL and scripts"): its top-level
    ## statements are the body of its `main`, `def main(sys: System) ->
    ## !:` with `return Ok(())` after them, declared after the other items.
    ## A script that declares its own `main` keeps it (stage 0 reports the
    ## statements, `resolve.script-main`).
    pure def script_items(mut self, module: ModuleId, items: list[ItemId]) -> list[ItemId]:
        var stmts: list[StmtId] = []
        var out: list[ItemId] = []
        var own_main = False
        for i in items:
            match self.ast(module).item(i).kind:
                case ItemKind.Stmt(st):
                    stmts.push(st)
                case ItemKind.Fn(f):
                    if f.name.text == "main":
                        own_main = True
                    out.push(i)
                case _:
                    out.push(i)
        if stmts.is_empty():
            return items.copy()
        if own_main:
            self.other_error = True
            return items.copy()
        let first = self.ast(module).stmt(stmts[0]).copy()
        let last = self.ast(module).stmt(stmts[len(stmts) - 1]).copy()
        let node = first.node
        let at = TextRange.empty(first.range.start)
        let end = TextRange.empty(last.range.end)
        var body = stmts.copy()
        var returns = False
        if let StmtKind.Return(_) = last.kind:
            returns = True
        if not returns:
            let ok_name = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=end, kind=ExprKind.Name("Ok".to_string()))
            )
            let unit = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=end, kind=ExprKind.Tuple([]))
            )
            let arg = Arg(node=node, range=end, name=None, mutable=False, value=unit)
            let call = Expr(
                node=node, range=end, kind=ExprKind.Call(callee=ok_name, args=[arg], trailing=None)
            )
            let ok = self.sources[module.index].ast.add_expr(call)
            body.push(
                self.sources[module.index].ast.add_stmt(
                    Stmt(node=node, range=end, kind=StmtKind.Return(Some(ok)))
                )
            )
        let range = TextRange.new(first.range.start, last.range.end)
        let system = TypeExpr(
            node=node,
            range=at,
            kind=TypeKind.Path(segments=[Name(text="System".to_string(), range=at)], args=[]),
        )
        let sys_ty = self.sources[module.index].ast.add_type(system)
        let ret = self.sources[module.index].ast.add_type(
            TypeExpr(node=node, range=at, kind=TypeKind.Result(ok=None, err=None))
        )
        let param = Param(
            node=node,
            range=at,
            mode=Mode.Borrow,
            kind=ParamKind.Named(
                name=Name(text="sys".to_string(), range=at), ty=sys_ty, default=None
            ),
        )
        let f = FnDef(
            node=node,
            range=range,
            name=Name(text="main".to_string(), range=at),
            is_pure=False,
            is_comptime=False,
            generics=[],
            params=[param],
            ret=Some(ret),
            from_=[],
            where_=[],
            body=Some(Block(node=node, range=range, stmts=body)),
            attrs=[],
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )
        let item = Item(
            node=node, range=range, attrs=[], vis=Vis.Private, docs=[], kind=ItemKind.Fn(f)
        )
        out.push(self.sources[module.index].ast.add_item(item))
        return out

    # ---------------------------------------------------------------- generators

    ## The generators of the property tests of the root module (stage 0's
    ## `arbitrary.rs`): for each type written in `arbitrary[T]` or
    ## `exhaustive[T](...)`, whether it has a generator, and if so the
    ## function the compiler writes for it, `def __arbitrary_site_N(d:
    ## Draws) -> T` (declared here by its signature: its body, and the
    ## generators of the module's types it calls, are in a file of their
    ## own), with the call that stands for the site, `Gen.of(...)` or
    ## `Gen.every(..., max_len=n)`.
    pure def declare_generators(mut self, module: ModuleId, items: list[ItemId]):
        # The module's types and the parts their generators draw.
        var shapes: dict[String, (list[String], list[TypeExprId])] = {}
        var order: list[String] = []
        for it in items:
            let item = self.ast(module).item(it).copy()
            let builtin = has_attr(item.attrs, "builtin")
            match item.kind:
                case ItemKind.Struct(s):
                    var has_const = False
                    for g in s.generics:
                        if g.is_const:
                            has_const = True
                    if s.is_view or builtin or s.name.text.is_empty() or has_const:
                        continue
                    var parts: list[TypeExprId] = []
                    for f in s.fields:
                        parts.push(f.ty)
                    _ = shapes.insert(s.name.text.copy(), (generic_names(s.generics), parts))
                    order.push(s.name.text.copy())
                case ItemKind.Enum(e):
                    if e.name.text.is_empty():
                        continue
                    var parts: list[TypeExprId] = []
                    for v in e.variants:
                        for f in v.fields:
                            parts.push(f.ty)
                    _ = shapes.insert(e.name.text.copy(), (generic_names(e.generics), parts))
                    order.push(e.name.text.copy())
                case ItemKind.TypeAlias(a):
                    if not a.refinement or a.name.text.is_empty():
                        continue
                    let base = a.ty else:
                        continue
                    _ = shapes.insert(a.name.text.copy(), (generic_names(a.generics), [base]))
                    order.push(a.name.text.copy())
                case _:
                    pass
        # Which types have a generator: assume all do, then drop those with
        # a part that has none, until nothing changes.
        var ok: set[String] = set()
        for n in order:
            _ = ok.add(n.copy())
        var changed = True
        while changed:
            changed = False
            for n in order:
                if not ok.contains(n.copy()):
                    continue
                let shape = shapes.get(n.copy()) else:
                    continue
                var fine = True
                for t in shape.1:
                    if not self.type_ok(module, t, shape.0, shapes, ok):
                        fine = False
                if not fine:
                    _ = ok.remove(n.copy())
                    changed = True
        # The calls whose callee is a site, with their arguments.
        var calls: dict[int, (ExprId, list[Arg])] = {}
        let exprs = visit.exprs_in_items(self.ast(module), items)
        for e in exprs:
            if let ExprKind.Call(callee, args, _) = self.ast(module).expr(e).kind:
                if let ExprKind.Index(_, _) = self.ast(module).expr(callee).kind:
                    _ = calls.insert(callee.index, (e, args.copy()))
        # The types written in `arbitrary[T]` and `exhaustive[T](...)`.
        var keys: list[String] = []
        for e in exprs:
            let ExprKind.Index(base, targs) = self.ast(module).expr(e).kind.copy() else:
                continue
            var kind = String.new()
            if let ExprKind.Name(n) = self.ast(module).expr(base).kind:
                kind = n.copy()
            if kind != "arbitrary" and kind != "exhaustive":
                continue
            if len(targs) != 1:
                continue
            var t = ExprId(index=0)
            match targs[0]:
                case IndexArg.Expr(x):
                    t = x
                case _:
                    continue
            let key = without_spaces(self.root_text_of(self.ast(module).expr(t).range))
            if not keys.contains(key.copy()):
                keys.push(key.copy())
                let i = len(keys) - 1
                match self.expr_as_type(module, t):
                    case Some(te):
                        if self.type_ok(module, te, [], shapes, ok):
                            let name = "__arbitrary_site_{i}"
                            self.declare_site(module, name, te)
                            _ = self.prog.generator_sites.insert(key.copy(), Some(name))
                        else:
                            _ = self.prog.generator_sites.insert(key.copy(), None)
                    case None:
                        _ = self.prog.generator_sites.insert(key.copy(), None)
            # The call that stands for this site.
            var site = String.new()
            if let Some(entry) = self.prog.generator_sites.get(key.copy()):
                if let Some(n) = entry:
                    site = n.copy()
            if site.is_empty():
                continue
            var whole = e
            var call_args: list[Arg]? = None
            if let Some(c) = calls.get(e.index):
                whole = c.0
                call_args = Some(c.1.copy())
            let at = self.ast(module).expr(whole).range
            let node = self.ast(module).expr(whole).node
            var method = "of"
            let callee_name = self.add_name_expr(module, node, at, site)
            var args = [Arg(node=node, range=at, name=None, mutable=False, value=callee_name)]
            if kind == "exhaustive":
                method = "every"
                var max_len: ExprId? = None
                if let Some(given) = call_args:
                    for a in given:
                        if max_len.is_none():
                            match a.name:
                                case None:
                                    max_len = Some(a.value)
                                case Some(n):
                                    if n.text == "max_len":
                                        max_len = Some(a.value)
                let three = Expr(
                    node=node,
                    range=at,
                    kind=ExprKind.Int(text="3".to_string(), value=Some(three_u128()), suffix=None),
                )
                var value = ExprId(index=0)
                match max_len:
                    case Some(v):
                        value = v
                    case None:
                        value = self.sources[module.index].ast.add_expr(three)
                args.push(
                    Arg(
                        node=node,
                        range=at,
                        name=Some(Name(text="max_len".to_string(), range=at)),
                        mutable=False,
                        value=value,
                    )
                )
            let gen = self.add_name_expr(module, node, at, "Gen")
            let field = Expr(
                node=node,
                range=at,
                kind=ExprKind.Field(base=gen, name=Name(text=method.to_string(), range=at)),
            )
            let f = self.sources[module.index].ast.add_expr(field)
            let call = Expr(
                node=node, range=at, kind=ExprKind.Call(callee=f, args=args, trailing=None)
            )
            _ = self.prog.generator_calls.insert(
                e.index, self.sources[module.index].ast.add_expr(call)
            )

    pure def add_name_expr(
        mut self, module: ModuleId, node: int, at: TextRange, name: str
    ) -> ExprId:
        return self.sources[module.index].ast.add_expr(
            Expr(node=node, range=at, kind=ExprKind.Name(name.to_string()))
        )

    ## `def name(d: Draws) -> T` with no body of its own here, bound in the
    ## module (the names of the generated module are the served module's).
    pure def declare_site(mut self, module: ModuleId, name: str, te: TypeExprId):
        let at = self.ast(module).type_expr(te).range
        let node = self.ast(module).type_expr(te).node
        let draws = TypeExpr(
            node=node,
            range=at,
            kind=TypeKind.Path(segments=[Name(text="Draws".to_string(), range=at)], args=[]),
        )
        let draws_ty = self.sources[module.index].ast.add_type(draws)
        let param = Param(
            node=node,
            range=at,
            mode=Mode.Borrow,
            kind=ParamKind.Named(
                name=Name(text="d".to_string(), range=at), ty=draws_ty, default=None
            ),
        )
        let f = FnDef(
            node=node,
            range=at,
            name=Name(text=name.to_string(), range=at),
            is_pure=False,
            is_comptime=False,
            generics=[],
            params=[param],
            ret=Some(te),
            from_=[],
            where_=[],
            body=None,
            attrs=[],
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )
        let def_ = self.new_def(
            module, name, at, Vis.Private, DefKind.Fn(self.placeholder_fn(FnKind.Free))
        )
        _ = self.written.add(def_)
        if not self.prog.modules[module.index].items.contains(name.to_string()):
            _ = self.prog.modules[module.index].items.insert(name.to_string(), def_)
        self.pending.push(Pending.Fn(def_=def_, module=module, ast=f, owner=None))

    ## An index argument read as a type: `list[int]` in `arbitrary[list[int]]`.
    pure def expr_as_type(mut self, module: ModuleId, e: ExprId) -> TypeExprId?:
        let x = self.ast(module).expr(e).copy()
        var kind = TypeKind.Error
        match x.kind:
            case ExprKind.Name(n):
                kind = TypeKind.Path(segments=[Name(text=n.copy(), range=x.range)], args=[])
            case ExprKind.Index(base, args):
                let ExprKind.Name(n) = self.ast(module).expr(base).kind.copy() else:
                    return None
                let base_range = self.ast(module).expr(base).range
                var targs: list[TypeExprId] = []
                for a in args:
                    var y = ExprId(index=0)
                    match a:
                        case IndexArg.Expr(x):
                            y = x
                        case _:
                            return None
                    let t = self.expr_as_type(module, y) else:
                        return None
                    targs.push(t)
                kind = TypeKind.Path(segments=[Name(text=n, range=base_range)], args=targs)
            case ExprKind.Tuple(xs):
                if xs.is_empty():
                    return None
                var es: list[(Name?, TypeExprId)] = []
                for y in xs:
                    let t = self.expr_as_type(module, y) else:
                        return None
                    es.push((None, t))
                kind = TypeKind.Tuple(es)
            case ExprKind.Paren(inner):
                return self.expr_as_type(module, inner)
            # `(int) -> bool` reads as a closure.
            case ExprKind.Closure(c):
                if c.implicit_param:
                    return None
                var params: list[TypeExprId] = []
                for p in c.params:
                    if p.ty.is_some():
                        return None
                    let pt = TypeExpr(
                        node=x.node,
                        range=p.name.range,
                        kind=TypeKind.Path(segments=[p.name.copy()], args=[]),
                    )
                    params.push(self.sources[module.index].ast.add_type(pt))
                var body = ExprId(index=0)
                match c.body:
                    case ClosureBody.Expr(x):
                        body = x
                    case _:
                        return None
                let ret = self.expr_as_type(module, body) else:
                    return None
                kind = TypeKind.Fn(pure=False, params=params, ret=ret)
            case _:
                return None
        return Some(
            self.sources[module.index].ast.add_type(TypeExpr(node=x.node, range=x.range, kind=kind))
        )

    ## Whether every part of a type has a generator; `params` are the type
    ## parameters in scope (each given by a generator parameter).
    pure def type_ok(
        self,
        module: ModuleId,
        t: TypeExprId,
        params: list[String],
        shapes: dict[String, (list[String], list[TypeExprId])],
        ok: set[String],
    ) -> bool:
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Path(segments, args):
                if len(segments) != 1:
                    return False
                let n = segments[0].text.copy()
                if params.contains(n.copy()) and args.is_empty():
                    return True
                var all = True
                for a in args:
                    if not self.type_ok(module, a, params, shapes, ok):
                        all = False
                if args.is_empty() and leaf_generator(n):
                    return True
                if len(args) == 1
                        and (
                            n == "list" or n == "set" or n == "Option" or n == "Box" or n == "Slice"
                        ):
                    return all
                if len(args) == 2 and n == "dict":
                    return all
                if let Some(shape) = shapes.get(n.copy()):
                    if len(shape.0) == len(args) and ok.contains(n.copy()):
                        return all
                return False
            case TypeKind.Option(inner):
                return self.type_ok(module, inner, params, shapes, ok)
            case TypeKind.Tuple(es):
                if es.is_empty():
                    return False
                for (_, e) in es:
                    if not self.type_ok(module, e, params, shapes, ok):
                        return False
                return True
            case _:
                return False

    ## The text of the root module at `range`.
    pure def root_text_of(self, range: TextRange) -> String:
        if range.start < 0 or range.end > self.root_text.byte_len() or range.start > range.end:
            return String.new()
        return self.root_text.byte_slice(range.start, range.end).to_string()

    # ---------------------------------------------------------------- doc examples

    ## The root module's doc examples as tests (stage 0's `doctests.rs`; 10,
    ## "Testing"): a module of its own whose text keeps every example line
    ## where it is, so that a diagnostic in an example points at it, and
    ## whose scope is the root module's.
    pure def declare_doc_tests(mut self, module: ModuleId, items: list[ItemId]):
        var starts: list[int] = []
        for it in items:
            let start = self.ast(module).item(it).range.start
            match self.ast(module).item(it).kind:
                case ItemKind.Fn(_) | ItemKind.Const(_) | ItemKind.TypeAlias(_):
                    starts.push(start)
                case ItemKind.Struct(st):
                    starts.push(start)
                    for m in st.methods:
                        starts.push(m.range.start)
                case ItemKind.Enum(e):
                    starts.push(start)
                    for m in e.methods:
                        starts.push(m.range.start)
                case ItemKind.ErrorSet(e):
                    starts.push(start)
                    for m in e.methods:
                        starts.push(m.range.start)
                case ItemKind.Trait(t):
                    starts.push(start)
                    for m in t.methods:
                        starts.push(m.range.start)
                case ItemKind.Impl(i):
                    for m in i.methods:
                        starts.push(m.range.start)
                case _:
                    pass
        let examples = doc_examples(self.root_text, starts)
        if examples.is_empty():
            return
        let text = doc_test_module(self.root_text, examples)
        let parsed = parse(text, Catalog.parse(""))
        if not parsed.diagnostics.is_empty():
            self.other_error = True
        let generated = build.module(parsed.tree)
        let g_items = generated.items.copy()
        let g = self.add_module("<doc>/main.sisu", False, generated)
        self.prog.modules[g.index].parent = Some(module)
        self.doc_module = Some(g)
        self.doc_text = text
        self.declare_items(g, g_items, "")

    # ---------------------------------------------------------------- interceptors and fakes

    ## The interceptor and the fake of each trait among `items` (stage 0's
    ## `shims.rs`; 06, "Interceptors and trace context"; 17, "Fakes"), when
    ## the module's text names `Wrap` or `Fake`: `cap.Wrap(inner=x,
    ## hook=h)` implements the trait by showing each call to the
    ## interceptor and forwarding it, and `cap.Fake[Trait]` is a recording
    ## fake of it. Stage 0 writes them as source text, in a module of their
    ## own whose scope is the trait's; so does stage 1, which then parses
    ## and declares that text.
    pure def declare_trait_shims(mut self, module: ModuleId, items: list[ItemId]):
        if self.is_std(module):
            return
        let wrap = self.root_text.contains("Wrap")
        let fakes = self.root_text.contains("Fake")
        if not wrap and not fakes:
            return
        var text = String.new()
        var faked: list[String] = []
        for it in items:
            let ItemKind.Trait(t) = self.ast(module).item(it).kind.copy() else:
                continue
            let ms = self.shim_methods(module, t) else:
                continue
            if wrap:
                text.push("\n")
                text.push(wrap_impl(t.name.text, ms))
            if fakes:
                text.push("\n")
                text.push(fake_text(t.name.text, ms))
                faked.push(t.name.text.copy())
        if text.is_empty():
            return
        let generated = build.module(parse(text, Catalog.parse("")).tree)
        let g_items = generated.items.copy()
        let g = self.add_module("<shims>/main.sisu", False, generated)
        self.prog.modules[g.index].parent = Some(module)
        self.declare_items(g, g_items, "")
        for name in faked:
            let tr = self.prog.lookup_in(module, name)
            let st = self.prog.lookup_in(g, "__Fake_{name}")
            if let Some(a) = tr:
                if let Some(b) = st:
                    _ = self.prog.fakes.insert(a, b)

    ## The methods of a trait, when every one can be forwarded: a `self` or
    ## `mut self` receiver, no type parameters of its own, and no borrow or
    ## `Self` in its signature; the trait itself has no type parameters,
    ## associated types or supertraits.
    pure def shim_methods(self, module: ModuleId, t: TraitDef) -> list[ShimMethod]?:
        if not t.generics.is_empty()
                or not t.supertraits.is_empty()
                or not t.assoc_types.is_empty():
            return None
        var out: list[ShimMethod] = []
        for m in t.methods:
            if m.is_comptime:
                continue
            if not m.generics.is_empty()
                    or not m.where_.is_empty()
                    or not m.from_.is_empty()
                    or m.header_broken:
                return None
            if m.params.is_empty():
                return None
            match m.params[0].kind:
                case ParamKind.SelfParam:
                    pass
                case _:
                    return None
            if m.params[0].mode == Mode.Own:
                return None
            var args: list[(String, bool)] = []
            for k in range(1, len(m.params)):
                let p = ref m.params[k]
                match p.kind:
                    case ParamKind.Named(name, ty, _):
                        if self.borrows(module, ty):
                            return None
                        args.push((name.text.copy(), p.mode == Mode.Mut))
                    case _:
                        return None
            var ret = String.new()
            var result: String? = None
            if let Some(r) = m.ret:
                if self.borrows(module, r):
                    return None
                let written = self.root_text_of(self.ast(module).type_expr(r).range)
                ret = " -> {written}"
                if written != "()":
                    result = Some(written.copy())
            var params: list[String] = []
            for p in m.params:
                params.push(self.root_text_of(p.range))
            out.push(
                ShimMethod(
                    name=m.name.text.copy(),
                    params=params.join(", "),
                    ret=ret,
                    result=result,
                    args=args,
                )
            )
        if out.is_empty():
            return None
        return Some(out)

    ## Whether a type mentions a borrow or `Self`.
    pure def borrows(self, module: ModuleId, t: TypeExprId) -> bool:
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Ref(_, _):
                return True
            case TypeKind.Path(segments, args):
                for s in segments:
                    if s.text == "Self":
                        return True
                for a in args:
                    if self.borrows(module, a):
                        return True
                return False
            case TypeKind.Option(x):
                return self.borrows(module, x)
            case TypeKind.Dyn(x):
                return self.borrows(module, x)
            case TypeKind.Result(ok, err):
                if let Some(o) = ok:
                    if self.borrows(module, o):
                        return True
                if let Some(e) = err:
                    if self.borrows(module, e):
                        return True
                return False
            case TypeKind.Union(xs):
                for x in xs:
                    if self.borrows(module, x):
                        return True
                return False
            case TypeKind.Tuple(xs):
                for (_, x) in xs:
                    if self.borrows(module, x):
                        return True
                return False
            case TypeKind.Fn(_, params, ret):
                for x in params:
                    if self.borrows(module, x):
                        return True
                return self.borrows(module, ret)
            case TypeKind.ConstArg(_):
                return False
            case TypeKind.Unsupported(_):
                return True
            case TypeKind.Error:
                return True

    # ---------------------------------------------------------------- tests

    ## The tests a declaration named `name` declares, with their names
    ## (stage 0's `tests_of::cases`): `test "name" for x, y in [(1, 2), (3,
    ## 4)]:` over a list written out is one test per element, whose body
    ## starts by binding the pattern to the element; over a list computed
    ## some other way, one test whose body is a `for` over it.
    pure def test_cases(
        mut self, module: ModuleId, name: str, t: TestDef
    ) -> list[(String, TestDef)]:
        var pat = PatternId(index=0)
        var list = ExprId(index=0)
        match t.cases:
            case Some((p, l)):
                pat = p
                list = l
            case None:
                return [(name.to_string(), t.copy())]
        let pat_node = self.ast(module).pattern(pat).node
        var out: list[(String, TestDef)] = []
        match self.ast(module).expr(list).kind.copy():
            case ExprKind.List(elems):
                for k in range(len(elems)):
                    let e = elems[k]
                    let at = self.ast(module).expr(e).range
                    let bind = Stmt(
                        node=pat_node,
                        range=at,
                        kind=StmtKind.Let(
                            mutable=False, pat=pat, ty=None, init=Some(e), else_=None
                        ),
                    )
                    let first = self.sources[module.index].ast.add_stmt(bind)
                    out.push(("{name} {k}", self.case_def(t, first, False)))
            case _:
                # `for PAT in LIST:` around the body.
                let at = self.ast(module).expr(list).range
                let list_node = self.ast(module).expr(list).node
                var body = Block(node=list_node, range=at, stmts=[])
                if let Some(b) = t.body:
                    body = b.copy()
                let body_range = body.range
                let looped = Stmt(
                    node=list_node,
                    range=body_range,
                    kind=StmtKind.For(pat=pat, mode=Mode.Borrow, iter=list, body=body),
                )
                let first = self.sources[module.index].ast.add_stmt(looped)
                out.push((name.to_string(), self.case_def(t, first, True)))
        return out

    ## A test `t` whose body starts with the statement `first` (and, when
    ## `alone`, is only that statement).
    pure def case_def(self, t: TestDef, first: StmtId, alone: bool) -> TestDef:
        var body: Block? = None
        if let Some(b) = t.body:
            var stmts = [first]
            if not alone:
                for s in b.stmts:
                    stmts.push(s)
            body = Some(Block(node=b.node, range=b.range, stmts=stmts))
        return TestDef(
            name=t.name.copy(),
            name_range=t.name_range,
            cases=None,
            params=t.params.copy(),
            body=body,
        )

    # ---------------------------------------------------------------- associated constants

    ## An associated constant of a type (03), named `Type.NAME`.
    pure def declare_assoc_const(mut self, module: ModuleId, key: TyKey, owner: str, c: ConstDef):
        let info = ConstInfo(ty=Ty.error(), value=None)
        let name = "{owner}.{c.name.text}"
        let def_ = self.new_def(module, name, c.name.range, Vis.Pub, DefKind.Const(info))
        let k = (key, c.name.text.copy())
        if self.prog.assoc_consts.contains(k.copy()) or self.prog.methods.contains(k.copy()):
            # `resolve.duplicate-method`.
            if self.is_root(module):
                self.other_error = True
            return
        _ = self.prog.assoc_consts.insert(k, def_)
        self.pending.push(Pending.Const(def_=def_, module=module, ast=c.copy()))

    # ---------------------------------------------------------------- functions the compiler writes

    ## `invariant e` lines (07): a method of the struct that checks them,
    ## `pure def __check_invariant(self)`, whose body is the lines; and the
    ## invariant as a `bool`, `pure def __invariant(self) -> bool`, which
    ## reports nothing of its own.
    pure def declare_invariant(mut self, module: ModuleId, def_: DefId, node: int, s: StructDef):
        let range = s.invariants[0].range
        var stmts: list[StmtId] = []
        for c in s.invariants:
            let st = Stmt(node=node, range=c.range, kind=StmtKind.Contract(c.copy()))
            stmts.push(self.sources[module.index].ast.add_stmt(st))
        let body = Block(node=node, range=range, stmts=stmts)
        let check = self.written_fn(node, range, "__check_invariant", body, None, True)
        let m = self.new_def(
            module,
            "__check_invariant",
            range,
            Vis.Private,
            DefKind.Fn(self.placeholder_fn(FnKind.Method)),
        )
        _ = self.special_kinds.insert(m, FnKind.Invariant(def_))
        self.pending.push(
            Pending.Fn(def_=m, module=module, ast=check, owner=Some(Owner.Type(def_)))
        )
        var cond: ExprId? = None
        for c in s.invariants:
            let at = self.sources[module.index].ast.expr(c.expr).range
            let part = self.sources[module.index].ast.add_expr(
                Expr(node=node, range=at, kind=ExprKind.Paren(c.expr))
            )
            match cond:
                case None:
                    cond = Some(part)
                case Some(l):
                    let both = Expr(
                        node=node, range=range, kind=ExprKind.Binary(op=BinOp.And, lhs=l, rhs=part)
                    )
                    cond = Some(self.sources[module.index].ast.add_expr(both))
        var whole = ExprId(index=0)
        match cond:
            case Some(c):
                whole = c
            case None:
                let t = Expr(node=node, range=range, kind=ExprKind.Name("True".to_string()))
                whole = self.sources[module.index].ast.add_expr(t)
        let holds = self.predicate_fn(module, node, whole, "__invariant", True)
        let h = self.new_def(
            module,
            "__invariant",
            range,
            Vis.Private,
            DefKind.Fn(self.placeholder_fn(FnKind.Method)),
        )
        _ = self.quiet_fns.add(h)
        self.pending.push(
            Pending.Fn(def_=h, module=module, ast=holds, owner=Some(Owner.Type(def_)))
        )

    ## `pure def name(self) -> bool: return pred`, written for a predicate.
    pure def predicate_fn(
        mut self, module: ModuleId, node: int, pred: ExprId, name: str, internal: bool
    ) -> FnDef:
        let range = self.sources[module.index].ast.expr(pred).range
        let ret_ty = TypeExpr(
            node=node,
            range=range,
            kind=TypeKind.Path(segments=[Name(text="bool".to_string(), range=range)], args=[]),
        )
        let ret = self.sources[module.index].ast.add_type(ret_ty)
        let st = Stmt(node=node, range=range, kind=StmtKind.Return(Some(pred)))
        let body = Block(
            node=node, range=range, stmts=[self.sources[module.index].ast.add_stmt(st)]
        )
        return self.written_fn(node, range, name, body, Some(ret), internal)

    ## A `pure` method of `self` the compiler writes, with a body; an
    ## `internal` one only the compiler's checks call.
    pure def written_fn(
        self,
        node: int,
        range: TextRange,
        name: str,
        own body: Block,
        ret: TypeExprId?,
        internal: bool,
    ) -> FnDef:
        var attrs: list[Attr] = []
        if internal:
            attrs.push(Attr(name="internal".to_string(), args=[], range=range))
        return FnDef(
            node=node,
            range=range,
            name=Name(text=name.to_string(), range=range),
            is_pure=True,
            is_comptime=False,
            generics=[],
            params=[Param(node=node, range=range, mode=Mode.Borrow, kind=ParamKind.SelfParam)],
            ret=ret,
            from_=[],
            where_=[],
            body=Some(body),
            attrs=attrs,
            header_broken=False,
            body_broken=False,
            vis=Vis.Private,
        )

    ## A refinement type's predicate as a function the compiler writes:
    ## `def where(self) -> bool: return pred`, `pure`, with `self` a value
    ## of the base.
    pure def declare_predicate(
        mut self, module: ModuleId, def_: DefId, node: int, a: TypeAlias, range: TextRange
    ):
        var pred = ExprId(index=0)
        match a.predicate:
            case Some(p):
                pred = p
            case None:
                pred = self.sources[module.index].ast.add_expr(
                    Expr(node=node, range=range, kind=ExprKind.Error)
                )
        let f = self.predicate_fn(module, node, pred, "where", False)
        let at = self.sources[module.index].ast.expr(pred).range
        let pd = self.new_def(
            module, "where", at, Vis.Private, DefKind.Fn(self.placeholder_fn(FnKind.Free))
        )
        _ = self.special_kinds.insert(pd, FnKind.Predicate(def_))
        if let DefKind.Refinement(r) = ref mut self.prog.defs[def_.index].kind:
            r.predicate = Some(pd)
        self.pending.push(
            Pending.Fn(def_=pd, module=module, ast=f, owner=Some(Owner.Refinement(def_)))
        )

    # ---------------------------------------------------------------- derived impls

    ## The impls the compiler writes for the structs and enums among
    ## `items` (stage 0's `derive.rs`): each `@derive`d trait's, `PartialOrd`
    ## with `Ord`, `Debug` for every type without its own, and each
    ## `@delegate`d trait's. Stage 0 writes them as source from the traits'
    ## `derive` templates; stage 1 declares their headers, which are what
    ## the checker reads.
    pure def declare_derived(mut self, module: ModuleId, items: list[ItemId]):
        for id in items:
            let item = self.sources[module.index].ast.item(id).copy()
            var name = String.new()
            var gps: list[GenericParam] = []
            var field_tys: list[TypeExprId] = []
            var field_names: list[String] = []
            var is_struct = False
            match item.kind:
                case ItemKind.Struct(s):
                    name = s.name.text.copy()
                    gps = s.generics.copy()
                    for f in s.fields:
                        field_tys.push(f.ty)
                        field_names.push(f.name.text.copy())
                    is_struct = True
                case ItemKind.Enum(e):
                    name = e.name.text.copy()
                    gps = e.generics.copy()
                    for v in e.variants:
                        for f in v.fields:
                            field_tys.push(f.ty)
                case _:
                    continue
            let builtin = is_struct and has_attr(item.attrs, "builtin")
            var has_const = False
            for g in gps:
                if g.is_const:
                    has_const = True
            if name.is_empty() or has_const:
                continue
            let ty = self.prog.lookup_in(module, name) else:
                continue
            let used = self.used_params(module, gps, field_tys)
            var wanted: list[(String, TextRange)] = []
            for a in item.attrs:
                if a.name != "derive":
                    continue
                for arg in a.args:
                    var written = String.new()
                    if let ExprKind.Name(n) = self.ast(module).expr(arg.value).kind:
                        written = n.copy()
                    if written == "Copy":
                        self.copy_checks.push(ty)
                    elif derivable(written):
                        var seen = False
                        for (w, _) in wanted:
                            if w == written:
                                seen = True
                        if not seen:
                            wanted.push((written, arg.range))
                    elif not written.is_empty() and self.has_derive_template(module, written):
                        # Stage 0 runs the trait's `comptime def derive`.
                        self.beyond_in(module, "a derive template of the program's own")
                    elif self.is_root(module):
                        # `resolve.not-derivable`.
                        self.other_error = True
            let delegated = self.delegations(module, item.attrs, is_struct, field_names)
            for (t, at) in delegated:
                self.pending.push(
                    Pending.Derived(
                        ty=ty,
                        module=module,
                        trait_=t.copy(),
                        derived=False,
                        used=used.copy(),
                        range=at,
                    )
                )
            # `Ord` brings `PartialOrd`, which it determines.
            var has_ord = False
            var has_partial = False
            var ord_at = item.range
            for (w, at) in wanted:
                if w == "Ord":
                    has_ord = True
                    ord_at = at
                if w == "PartialOrd":
                    has_partial = True
            if has_ord and not has_partial and not self.has_impl(module, items, "PartialOrd", name):
                wanted.push(("PartialOrd".to_string(), ord_at))
            # Every type has `Debug` (11): the derived one unless it has its
            # own.
            var debug = False
            for (w, _) in wanted:
                if w == "Debug":
                    debug = True
            for (w, _) in delegated:
                if w == "Debug":
                    debug = True
            if not builtin and not debug and not self.has_impl(module, items, "Debug", name):
                wanted.push(("Debug".to_string(), TextRange.empty(item.range.start)))
            for (t, at) in wanted:
                self.pending.push(
                    Pending.Derived(
                        ty=ty,
                        module=module,
                        trait_=t.copy(),
                        derived=True,
                        used=used.copy(),
                        range=at,
                    )
                )

    ## Whether a trait `name` of `module` has a `comptime def derive` (the
    ## prelude's that have one are the derivable traits).
    pure def has_derive_template(self, module: ModuleId, name: str) -> bool:
        for it in self.sources[module.index].items:
            if let ItemKind.Trait(t) = self.ast(module).item(it).kind:
                if t.name.text == name:
                    for f in t.methods:
                        if f.is_comptime and f.name.text == "derive":
                            return True
        return False

    ## The traits a struct's `@delegate` forwards, with where each is
    ## named, after checking the attribute (stage 0's `delegations`).
    pure def delegations(
        mut self, module: ModuleId, attrs: list[Attr], is_struct: bool, fields: list[String]
    ) -> list[(String, TextRange)]:
        var out: list[(String, TextRange)] = []
        for a in attrs:
            if a.name != "delegate":
                continue
            var field: String? = None
            for arg in a.args:
                if let Some(n) = arg.name:
                    if n.text == "to":
                        if let ExprKind.Str(parts) = self.ast(module).expr(arg.value).kind:
                            field = Some(build.plain_text(parts))
            var ok = False
            if let Some(f) = field:
                ok = is_struct and fields.contains(f)
            if not ok:
                # `resolve.delegate-to`.
                if self.is_root(module):
                    self.other_error = True
                continue
            for arg in a.args:
                if arg.name.is_some():
                    continue
                var n = String.new()
                if let ExprKind.Name(x) = self.ast(module).expr(arg.value).kind:
                    n = x.copy()
                if not delegable(n):
                    if self.is_root(module):
                        self.other_error = True
                    continue
                if returns_self(n) and len(fields) != 1:
                    if self.is_root(module):
                        self.other_error = True
                    continue
                var seen = False
                for (t, _) in out:
                    if t == n:
                        seen = True
                if not seen:
                    out.push((n, arg.range))
        return out

    ## Whether `items` has its own `impl trait_name for ty`.
    pure def has_impl(
        self, module: ModuleId, items: list[ItemId], trait_name: str, ty: str
    ) -> bool:
        for id in items:
            if let ItemKind.Impl(i) = self.ast(module).item(id).kind:
                let t = i.trait_ty else:
                    continue
                if self.last_segment(module, t) == Some(trait_name.to_string())
                        and self.last_segment(module, i.self_ty) == Some(ty.to_string()):
                    return True
        return False

    pure def last_segment(self, module: ModuleId, te: TypeExprId) -> String?:
        if let TypeKind.Path(segments, _) = self.ast(module).type_expr(te).kind:
            if let Some(s) = segments.last():
                return Some(s.text.copy())
        return None

    ## Whether each generic parameter is named in one of the field types:
    ## one that is not (`Key[T]`'s `T`) needs no bound in a derived impl.
    pure def used_params(
        self, module: ModuleId, gps: list[GenericParam], tys: list[TypeExprId]
    ) -> list[bool]:
        var names: list[String] = []
        for t in tys:
            self.type_names(module, t, mut names)
        var out: list[bool] = []
        for g in gps:
            out.push(names.contains(g.name.text))
        return out

    pure def type_names(self, module: ModuleId, t: TypeExprId, mut names: list[String]):
        match self.ast(module).type_expr(t).kind:
            case TypeKind.Path(segments, args):
                if let Some(s) = segments.first():
                    names.push(s.text.copy())
                for a in args:
                    self.type_names(module, a, mut names)
            case TypeKind.Option(i):
                self.type_names(module, i, mut names)
            case TypeKind.Dyn(i):
                self.type_names(module, i, mut names)
            case TypeKind.Ref(_, inner):
                self.type_names(module, inner, mut names)
            case TypeKind.Result(ok, err):
                if let Some(o) = ok:
                    self.type_names(module, o, mut names)
                if let Some(e) = err:
                    self.type_names(module, e, mut names)
            case TypeKind.Tuple(es):
                for (_, e) in es:
                    self.type_names(module, e, mut names)
            case TypeKind.Fn(_, params, ret):
                for p in params:
                    self.type_names(module, p, mut names)
                self.type_names(module, ret, mut names)
            case TypeKind.Union(us):
                for u in us:
                    self.type_names(module, u, mut names)
            case _:
                pass

    ## The header of an impl the compiler writes: `impl[A: Bound + Trait]
    ## Trait for P[A]`, each parameter that a field names bounded by the
    ## trait too.
    pure def resolve_derived(
        mut self,
        ty: DefId,
        module: ModuleId,
        trait_name: str,
        derived: bool,
        used: list[bool],
        rng: TextRange,
    ):
        let tr = self.prog.lookup(module, trait_name) else:
            return
        if self.prog.trait_info(tr).is_none():
            return
        let generics = self.prog.type_generics(ty)
        var names: list[String] = []
        var predicates: list[Predicate] = []
        let own_preds = self.preds_of(ty)
        for i in range(len(generics)):
            names.push(generics[i].name.copy())
            let p = self.types.param(i)
            for q in own_preds:
                if q.ty == p:
                    predicates.push(q.copy())
            if i >= len(used) or used[i]:
                predicates.push(Predicate(ty=p, bound=TraitRef(def_=tr, args=[]), span=rng))
        let self_ty = self.self_type(ty, len(generics))
        var gs: list[Generic] = []
        for g in generics:
            gs.push(Generic(name=g.name.copy(), default=None, is_const=g.is_const))
        let info = ImplInfo(
            generics=gs,
            predicates=predicates,
            trait_ref=TraitRef(def_=tr, args=[]),
            self_ty=self_ty,
            methods=[],
            assoc=[],
            derived=derived,
        )
        let shown_trait = self.prog.defs[tr.index].name.copy()
        let shown_ty = self.prog.display_in(self.types, self_ty, names)
        let def_ = self.new_def(
            module, "impl {shown_trait} for {shown_ty}", rng, Vis.Pub, DefKind.Impl(info)
        )
        self.prog.impls.push(def_)

    # ---------------------------------------------------------------- checks of impls

    ## The checks of the impls from the definition `first` on, once every
    ## impl is known (stage 0's `check_traits`): an impl's method is as
    ## `pure` as the trait's; an impl of the root module without one of the
    ## trait's required methods is an error stage 0 reports; and
    ## `@derive(Copy)` holds only for a type whose fields are `Copy`.
    pure def check_traits(mut self, first: int):
        let impls = self.prog.impls.copy()
        for i in impls:
            if i.index < first:
                continue
            let info = self.prog.impl_info(i) else:
                continue
            let tr = info.trait_ref.def_
            let methods = info.methods.copy()
            let derived = info.derived
            let tinfo = self.prog.trait_info(tr) else:
                continue
            let trait_methods = tinfo.methods.copy()
            let sealed = tinfo.sealed
            let module = self.prog.defs[i.index].module
            if sealed and not self.is_std(module):
                if self.is_root(module):
                    self.other_error = True
                continue
            for (mname, mdef) in methods:
                let tm = self.prog.trait_method(tr, mname) else:
                    # `resolve.not-a-trait-method`.
                    if self.is_root(module):
                        self.other_error = True
                    continue
                var tpure = False
                if let Some(f) = self.prog.fn_info(tm):
                    tpure = f.pure
                if tpure:
                    if let DefKind.Fn(f) = ref mut self.prog.defs[mdef.index].kind:
                        f.pure = True
            if derived or not self.is_root(module):
                continue
            for m in trait_methods:
                let f = self.prog.fn_info(m) else:
                    continue
                if f.body.is_some() or f.intrinsic.is_some() or f.header_broken:
                    continue
                var found = False
                for (n, _) in methods:
                    if n == self.prog.defs[m.index].name:
                        found = True
                if not found:
                    # `resolve.missing-trait-method`.
                    self.other_error = True
        let checks = self.copy_checks.copy()
        self.copy_checks = []
        for d in checks:
            self.check_copy_fields(d)

    ## `@derive(Copy)` only for a type whose fields are all `Copy` (03); a
    ## field of a type parameter's type is, since the type is `Copy` only
    ## for `Copy` arguments.
    pure def check_copy_fields(mut self, d: DefId):
        var fields: list[Ty] = []
        match self.prog.defs[d.index].kind:
            case DefKind.Struct(s):
                for f in s.fields:
                    fields.push(f.ty)
            case DefKind.Enum(e):
                for v in e.variants:
                    for (_, t) in v.fields:
                        fields.push(t)
            case _:
                return
        var as_copy: list[Ty] = []
        for _ in range(len(self.prog.type_generics(d))):
            as_copy.push(Ty.int())
        for fty in fields:
            if self.types.contains_error(fty):
                continue
            let t = self.types.subst(fty, as_copy)
            if self.prog.is_copy(mut self.types, t):
                continue
            # `resolve.derive-field`.
            if self.is_root(self.prog.defs[d.index].module):
                self.other_error = True
            match ref mut self.prog.defs[d.index].kind:
                case DefKind.Struct(s):
                    s.copy = False
                case DefKind.Enum(e):
                    e.copy = False
                case _:
                    pass
            return

    # ---------------------------------------------------------------- headers and bounds

    ## The generic parameters of every struct, enum and trait, with their
    ## defaults, then the bounds of the parameters of structs and enums.
    pure def resolve_headers(mut self):
        var ints: list[int] = []
        for d in self.type_params.keys():
            if not self.headers_done.contains(d):
                ints.push(d.index)
        ints.sort()
        for i in ints:
            _ = self.headers_done.add(DefId(index=i))
        for i in ints:
            let d = DefId(index=i)
            let gps = self.params_of(d)
            let module = self.prog.defs[i].module
            var is_trait = False
            if let DefKind.Trait(_) = self.prog.defs[i].kind:
                is_trait = True
            var names: list[String] = []
            if is_trait:
                names.push("Self".to_string())
            var generics: list[Generic] = []
            for g in gps:
                var default: Ty? = None
                if let Some(t) = g.default:
                    var ctx = TyCtx.plain(module, names, True)
                    if is_trait:
                        ctx.self_ty = Some(self.types.param(0))
                    default = Some(self.resolve_ty(t, ctx))
                names.push(g.name.text.copy())
                generics.push(
                    Generic(name=g.name.text.copy(), default=default, is_const=g.is_const)
                )
            match ref mut self.prog.defs[i].kind:
                case DefKind.Struct(s):
                    s.generics = generics
                case DefKind.Enum(e):
                    e.generics = generics
                case DefKind.ErrorSet(e):
                    e.generics = generics
                case DefKind.Trait(t):
                    t.generics = generics
                case DefKind.Refinement(r):
                    r.generics = generics
                case _:
                    pass
        for i in ints:
            let d = DefId(index=i)
            if let DefKind.Trait(_) = self.prog.defs[i].kind:
                continue
            let gps = self.params_of(d)
            let module = self.prog.defs[i].module
            var names: list[String] = []
            for g in gps:
                names.push(g.name.text.copy())
            let preds = self.resolve_bounds(module, gps, names, 0, None)
            _ = self.type_preds.insert(d, preds)

    ## The bounds of the generic parameters `gps`, which are the names from
    ## `offset` on in `names`, as predicates on `Param(offset + i)`.
    pure def resolve_bounds(
        mut self,
        module: ModuleId,
        gps: list[GenericParam],
        names: list[String],
        offset: int,
        in_trait: DefId?,
    ) -> list[Predicate]:
        var out: list[Predicate] = []
        for k in range(len(gps)):
            let g = ref gps[k]
            let subject = self.types.param(offset + k)
            if g.is_const:
                continue
            for b in g.bounds:
                var ctx = TyCtx.plain(module, names, True)
                ctx.predicates = out.copy()
                ctx.in_trait = in_trait
                if let Some(tr) = self.resolve_bound(b, subject, ctx):
                    out.push(
                        Predicate(ty=subject, bound=tr, span=self.ast(module).type_expr(b).range)
                    )
        return out

    ## A trait named in a bound, a supertraits list or an impl header, for
    ## `subject` (which a defaulted parameter `Rhs = Self` takes).
    pure def resolve_bound(mut self, te: TypeExprId, subject: Ty, ctx: TyCtx) -> TraitRef?:
        let written = self.ast(ctx.module).type_expr(te).copy()
        let TypeKind.Path(segments, args) = written.kind else:
            return None
        let d = self.lookup_path(segments, ctx) else:
            return None
        let info = self.prog.trait_info(d) else:
            return None
        let generics = info.generics.copy()
        var targs: list[Ty] = []
        for a in args:
            targs.push(self.resolve_ty(a, ctx))
        if len(targs) > len(generics):
            return None
        # Omitted trailing arguments take their defaults, `Self` being the
        # subject.
        while len(targs) < len(generics):
            let default = generics[len(targs)].default else:
                return None
            var env = [subject]
            for t in targs:
                env.push(t)
            targs.push(self.types.subst(default, env))
        return Some(TraitRef(def_=d, args=targs))

    ## Resolves a possibly qualified name (`cli.Error`) to a definition.
    pure def lookup_path(self, segments: list[Name], ctx: TyCtx) -> DefId?:
        var module = ctx.module
        for i in range(len(segments)):
            let seg = ref segments[i]
            var found: DefId? = None
            if i == 0:
                found = self.prog.lookup(module, seg.text)
            else:
                found = self.prog.lookup_in(module, seg.text)
            let d = found else:
                return None
            if i + 1 == len(segments):
                return Some(d)
            match self.prog.defs[d.index].kind:
                case DefKind.Module(m):
                    module = m
                case _:
                    return None
        return None

    # ---------------------------------------------------------------- types

    pure def resolve_ty(mut self, te: TypeExprId, ctx: TyCtx) -> Ty:
        let written = self.ast(ctx.module).type_expr(te).copy()
        let range = written.range
        match written.kind:
            case TypeKind.Error:
                return Ty.error()
            case TypeKind.Path(segments, args):
                if len(args) == 1 and self.is_fake_marker(segments, ctx.module):
                    return self.fake_ty(args[0], ctx)
                var targs: list[Ty] = []
                for a in args:
                    targs.push(self.resolve_ty(a, ctx))
                return self.resolve_path_ty(segments, targs, ctx, range)
            case TypeKind.Option(inner):
                let t = self.resolve_ty(inner, ctx)
                let o = self.prog.wk.option else:
                    return Ty.error()
                return self.types.adt(o, [t])
            case TypeKind.Result(ok, err):
                var ok_ty = Ty.unit()
                if let Some(o) = ok:
                    ok_ty = self.resolve_ty(o, ctx)
                var err_ty = Ty.error()
                if let Some(e) = err:
                    err_ty = self.resolve_error_set(e, ctx)
                let r = self.prog.wk.result else:
                    return Ty.error()
                return self.types.adt(r, [ok_ty, err_ty])
            case TypeKind.Union(_):
                return Ty.error()
            case TypeKind.Tuple(elems):
                var tys: list[Ty] = []
                var labels: list[String] = []
                var all_named = not elems.is_empty()
                for (n, t) in elems:
                    tys.push(self.resolve_ty(t, ctx))
                    match n:
                        case Some(name):
                            labels.push(name.text.copy())
                        case None:
                            all_named = False
                if tys.is_empty():
                    return Ty.unit()
                if not all_named:
                    labels = []
                return self.types.intern(TyData.Tuple(elems=tys, labels=labels))
            case TypeKind.Fn(pure, params, ret):
                var ps: list[Ty] = []
                for p in params:
                    ps.push(self.resolve_ty(p, ctx))
                let r = self.resolve_ty(ret, ctx)
                return self.types.fn_(ps, r, pure)
            case TypeKind.Ref(mutable, inner):
                if not ctx.allow_ref:
                    self.beyond_in(ctx.module, "a reference type in a declaration")
                let t = self.resolve_ty(inner, ctx)
                # A shared borrow of a view is the view: `ref str` is a `str`.
                if t == Ty.str() and not mutable:
                    return Ty.str()
                return self.types.ref_(t, mutable)
            case TypeKind.Dyn(inner):
                match self.resolve_bound(inner, Ty.error(), ctx):
                    case Some(tr):
                        return self.types.intern(TyData.Dyn(tr))
                    case None:
                        return Ty.error()
            case TypeKind.ConstArg(n):
                return self.types.intern(TyData.Const(n))
            case TypeKind.Unsupported(_):
                # `stage0.unsupported`.
                if self.is_root(ctx.module):
                    self.other_error = True
                return Ty.error()

    ## `cap.Fake[Trait]`: the fake the compiler wrote for the trait (17); a
    ## trait without one is `comptime.no-fake`.
    pure def fake_ty(mut self, arg: TypeExprId, ctx: TyCtx) -> Ty:
        let written = self.ast(ctx.module).type_expr(arg).copy()
        if let TypeKind.Path(segments, args) = written.kind:
            if args.is_empty():
                if let Some(t) = self.lookup_path(segments, ctx):
                    if let Some(f) = self.prog.fakes.get(t):
                        return self.types.adt(f, [])
        if self.is_root(ctx.module):
            self.other_error = True
        return Ty.error()

    ## Whether `segments` name `cap.Fake` in the program's code.
    pure def is_fake_marker(self, segments: list[Name], module: ModuleId) -> bool:
        if self.is_std(module):
            return False
        var d: DefId? = None
        var m = module
        for i in range(len(segments)):
            var found: DefId? = None
            if i == 0:
                found = self.prog.lookup(m, segments[i].text)
            else:
                found = self.prog.lookup_in(m, segments[i].text)
            let x = found else:
                return False
            if let DefKind.Module(next) = self.prog.defs[x.index].kind:
                m = next
            d = Some(x)
        let x = d else:
            return False
        let item = ref self.prog.defs[x.index]
        let owner = ref self.prog.modules[item.module.index]
        return item.name == "Fake" and owner.is_std and owner.name == "cap"

    ## A `dyn Trait` has no size of its own: it is held only behind `ref`
    ## or in a `Box` (E0395).
    pure def check_sized(mut self, module: ModuleId, ty: Ty, range: TextRange):
        if let Some(d) = self.prog.unsized_part(self.types, ty):
            let shown = self.prog.display(self.types, d)
            self.report_at(module, Msg.TypeUnsizedDyn, range, "ty", shown)

    pure def resolve_error_set(mut self, te: TypeExprId, ctx: TyCtx) -> Ty:
        var parts: list[TypeExprId] = []
        if let TypeKind.Union(list) = self.ast(ctx.module).type_expr(te).kind:
            parts = list.copy()
        else:
            parts = [te]
        var members: list[DefId] = []
        for p in parts:
            let t = self.resolve_ty(p, ctx)
            match self.types.data(t):
                case TyData.ErrSet(m):
                    for d in m:
                        members.push(d)
                case TyData.Error:
                    return Ty.error()
                case _:
                    return Ty.error()
        return self.types.err_set(sorted_members(members))

    ## The associated type `name` of `subject`, from the bounds in scope
    ## (and, inside a trait, the trait itself).
    pure def assoc_of(mut self, subject: Ty, name: str, ctx: TyCtx) -> Ty?:
        var candidates: list[TraitRef] = []
        if let Some(t) = ctx.in_trait:
            if subject == self.types.param(0):
                var args: list[Ty] = []
                if let Some(info) = self.prog.trait_info(t):
                    for i in range(len(info.generics)):
                        args.push(self.types.param(i + 1))
                candidates.push(TraitRef(def_=t, args=args))
        for p in ctx.predicates:
            if p.ty == subject:
                candidates.push(p.bound.copy())
        for c in candidates:
            for tr in self.prog.elaborate(mut self.types, subject, c):
                var declares = False
                if let Some(info) = self.prog.trait_info(tr.def_):
                    for a in info.assoc:
                        if a.name == name:
                            declares = True
                if declares:
                    return Some(
                        self.types.intern(
                            TyData.Assoc(self_ty=subject, trait_=tr.copy(), name=name.to_string())
                        )
                    )
        return None

    pure def resolve_path_ty(
        mut self, segments: list[Name], args: list[Ty], ctx: TyCtx, at: TextRange
    ) -> Ty:
        let first = segments.first() else:
            return Ty.error()
        if len(segments) == 1:
            let name = first.text.copy()
            for i in range(len(ctx.generics)):
                if ctx.generics[i] == name:
                    if not args.is_empty():
                        self.report_at(ctx.module, Msg.TypeNotGeneric, at, "name", name)
                    return self.types.param(i)
            if let Some(p) = primitive(name):
                if not args.is_empty():
                    self.report_at(ctx.module, Msg.TypeNotGeneric, at, "name", name)
                return p
            if name == "Self":
                return ctx.self_ty ?? Ty.error()
            # Inside a trait, its associated types are named bare.
            if ctx.in_trait.is_some() and self.prog.lookup(ctx.module, name).is_none():
                let p0 = self.types.param(0)
                if let Some(t) = self.assoc_of(p0, name, ctx):
                    return t
            if let Some(d) = self.prog.lookup(ctx.module, name):
                return self.def_as_type(d, name, args, ctx.module, at)
            if name == "f32":
                self.beyond_in(ctx.module, "`f32`")
            return Ty.error()
        # `C.Item` and `Self.Item`: an associated type.
        if len(segments) == 2:
            let base = first.text.copy()
            var subject: Ty? = None
            for i in range(len(ctx.generics)):
                if ctx.generics[i] == base and subject.is_none():
                    subject = Some(self.types.param(i))
            if subject.is_none() and base == "Self":
                subject = ctx.self_ty
            if let Some(s) = subject:
                let name = segments[1].text.copy()
                if base == "Self":
                    for (n, t) in ctx.impl_assoc:
                        if n == name:
                            return t
                if let Some(t) = self.assoc_of(s, name, ctx):
                    return t
                return Ty.error()
        # A qualified name: module.Type.
        let d = self.lookup_path(segments, ctx) else:
            return Ty.error()
        let last = segments[len(segments) - 1].text.copy()
        return self.def_as_type(d, last, args, ctx.module, at)

    pure def def_as_type(
        mut self, d: DefId, name: str, args: list[Ty], module: ModuleId, at: TextRange
    ) -> Ty:
        var generics: list[Generic] = []
        match self.prog.defs[d.index].kind:
            case DefKind.Struct(s):
                generics = s.generics.copy()
            case DefKind.Enum(e):
                generics = e.generics.copy()
            case DefKind.Refinement(r):
                generics = r.generics.copy()
            case DefKind.ErrorSet(_):
                if not args.is_empty():
                    self.report_at(module, Msg.TypeNotGeneric, at, "name", name)
                return self.types.err_set([d])
            case DefKind.TypeAlias(_):
                var declared = 0
                if let Some((_, a)) = self.aliases.get(d):
                    declared = len(a.generics)
                if len(args) != declared and not (args.is_empty() and declared == 0):
                    return Ty.error()
                let t = self.resolve_alias(d)
                return self.types.subst(t, args)
            case _:
                return Ty.error()
        # Generics of a type not yet resolved are counted from its AST.
        let declared = self.declared_generics(d) ?? len(generics)
        var targs = args.copy()
        # Omitted trailing arguments take their defaults (D-060).
        if len(targs) < declared:
            var filled = targs.copy()
            while len(filled) < len(generics):
                let default = generics[len(filled)].default else:
                    break
                let t = self.types.subst(default, filled)
                filled.push(t)
            if len(filled) == declared:
                targs = filled
        if len(targs) != declared:
            if targs.is_empty():
                self.report_at(module, Msg.TypeTypeArgumentsNeeded, at, "name", name)
            var errors: list[Ty] = []
            for _ in range(declared):
                errors.push(Ty.error())
            return self.types.adt(d, errors)
        # A `const` parameter takes a constant, any other a type.
        var consts: list[bool] = []
        match self.type_params.get(d):
            case Some(gps):
                for g in gps:
                    consts.push(g.is_const)
            case None:
                for g in generics:
                    consts.push(g.is_const)
        for i in range(len(targs)):
            if i >= len(consts):
                continue
            var wrong = False
            match self.types.data(targs[i]):
                case TyData.Const(_):
                    wrong = not consts[i]
                case TyData.Param(_) | TyData.Error | TyData.Var(_):
                    wrong = False
                case _:
                    wrong = consts[i]
            if wrong:
                var errors: list[Ty] = []
                for _ in range(declared):
                    errors.push(Ty.error())
                return self.types.adt(d, errors)
        return self.types.adt(d, targs)

    ## The bounds of a type's generic parameters.
    pure def preds_of(self, d: DefId) -> list[Predicate]:
        if let Some(p) = self.type_preds.get(d):
            return p.copy()
        return []

    ## The generic parameters a type, trait or refinement declares.
    pure def params_of(self, d: DefId) -> list[GenericParam]:
        if let Some(p) = self.type_params.get(d):
            return p.copy()
        return []

    ## The number of generic parameters a type declares, from its AST.
    pure def declared_generics(self, d: DefId) -> int?:
        if let Some(g) = self.type_params.get(d):
            return Some(len(g))
        match self.prog.defs[d.index].kind:
            case DefKind.Struct(s):
                return Some(len(s.generics))
            case DefKind.Enum(e):
                return Some(len(e.generics))
            case _:
                return None

## A test's name within its suite: `suite/name`.
pure def prefixed(prefix: str, name: str) -> String:
    if prefix.is_empty():
        return name.to_string()
    return "{prefix}/{name}"

## Error set members in order of definition, each once.
pure def sorted_members(own v: list[DefId]) -> list[DefId]:
    var ints: list[int] = []
    for d in v:
        ints.push(d.index)
    ints.sort()
    var out: list[DefId] = []
    for i in ints:
        if let Some(last) = out.last():
            if last.index == i:
                continue
        out.push(DefId(index=i))
    return out

pure def has_attr(attrs: list[Attr], name: str) -> bool:
    for a in attrs:
        if a.name == name:
            return True
    return False

## The type a primitive name stands for.
pure def primitive(name: str) -> Ty?:
    return match name:
        case "int": Some(Ty.int())
        case "f64": Some(Ty.float())
        case "bool": Some(Ty.bool())
        case "char": Some(Ty.char())
        case "str": Some(Ty.str())
        case "Never": Some(Ty.never())
        case _: None

## A std module's text, from the texts read by name.
pure def text_of(texts: dict[String, String], name: str) -> String:
    if let Some(t) = texts.get(name.to_string()):
        return t.copy()
    return String.new()

## Whether a body reflects on one of the type parameters `generics`: a
## `reflect` query, a field reached by a compile-time descriptor, or a
## compile-time expression that names a type parameter (stage 0's
## `instances::reflects`).
pure def reflects(ast: Ast, body: Block, generics: list[GenericParam]) -> bool:
    for e in visit.exprs_in_block(ast, body):
        match ast.expr(e).kind:
            case ExprKind.FieldOf(_, _):
                return True
            case ExprKind.Call(callee, _, _):
                if let ExprKind.Field(base, _) = ast.expr(callee).kind:
                    if let ExprKind.Name(n) = ast.expr(base).kind:
                        if n == "reflect":
                            return True
            case ExprKind.Comptime(inner):
                for x in visit.exprs_of(ast, inner):
                    if let ExprKind.Name(n) = ast.expr(x).kind:
                        for g in generics:
                            if g.name.text == n:
                                return True
            case _:
                pass
    return False

## The last part of a dotted path: `json` for `std.json`.
pure def last_word(path: str) -> String:
    var out = String.new()
    for part in path.split("."):
        out = part.to_string()
    return out

## The traits `@delegate` forwards (03, "Coherence").
pure def delegable(name: str) -> bool:
    return match name:
        case "Add" | "Sub" | "Mul" | "Div" | "Rem" | "Neg" | "Eq" | "PartialOrd" | "Ord": True
        case "Hash" | "Display" | "Debug" | "Len": True
        case _: False

## The delegable traits whose methods return `Self`.
pure def returns_self(name: str) -> bool:
    return match name:
        case "Add" | "Sub" | "Mul" | "Div" | "Rem" | "Neg": True
        case _: False

## The names of generic parameters.
pure def generic_names(gs: list[GenericParam]) -> list[String]:
    var out: list[String] = []
    for g in gs:
        out.push(g.name.text.copy())
    return out

## The types whose values the prelude's `Draws` draws itself.
pure def leaf_generator(n: str) -> bool:
    return match n:
        case "int" | "i64" | "bool" | "f64" | "char" | "String" | "u8" | "u16" | "u32": True
        case "i8" | "i16" | "i32" | "Duration": True
        case _: False

## A text without its whitespace: a site's key.
pure def without_spaces(text: str) -> String:
    var out = String.new()
    for c in text.chars():
        if c != ' ' and c != '\n' and c != '\t' and c != '\r':
            out.push_char(c)
    return out

## `3`, as the value of an integer literal.
pure def three_u128() -> u128:
    var x: u128 = 0
    for _ in range(3):
        x = x + 1
    return x

## A method of a trait, as the interceptor and the fake write it.
struct ShimMethod:
    name: String
    ## The receiver and parameters as written: `mut self, x: int`.
    params: String
    ## ` -> T ! E` as written, or empty.
    ret: String
    ## The result type as written (`T ! E`), when it is not `()`.
    result: String?
    ## The parameters' names, and whether each is passed `mut`.
    args: list[(String, bool)]

## `"{a:?}, {b:?}"`: the arguments of a call as an interceptor and a fake
## show them.
pure def shown_args(m: ShimMethod) -> String:
    var parts: list[String] = []
    for (n, _) in m.args:
        parts.push("{{{n}:?}}")
    return parts.join(", ")

## `x, mut y`: the arguments of the forwarded call.
pure def passed(m: ShimMethod) -> String:
    var parts: list[String] = []
    for (n, by_mut) in m.args:
        if by_mut:
            parts.push("mut {n}")
        else:
            parts.push(n.copy())
    return parts.join(", ")

## The impl of `trait_name` for `cap.Wrap`.
pure def wrap_impl(trait_name: str, ms: list[ShimMethod]) -> String:
    var s: String = "impl[__T: {trait_name}, __I: cap.Interceptor] {trait_name} for cap.Wrap[__T, __I]:\n"
    for m in ms:
        s.push("    def {m.name}({m.params}){m.ret}:\n")
        s.push(
            "        let __call = cap.Call(capability=\"{trait_name}\".to_string(), method=\"{m.name}\".to_string(), args=\"{shown_args(m)}\")\n"
        )
        s.push("        self.hook.before(__call.copy())\n")
        match m.result:
            case Some(_):
                s.push("        let __result = self.inner.{m.name}({passed(m)})\n")
                s.push("        self.hook.after(__call, \"{{__result:?}}\")\n")
                s.push("        return __result\n")
            case None:
                s.push("        self.inner.{m.name}({passed(m)})\n")
                s.push("        self.hook.after(__call, \"()\")\n")
    return s

## The fake of `trait_name`: a struct, its own methods, and its impl of
## the trait.
pure def fake_text(trait_name: str, ms: list[ShimMethod]) -> String:
    let ty = "__Fake_{trait_name}"
    var s: String = "## A recording fake of `{trait_name}` (17): `cap.Fake[{trait_name}]`. Its copies share\n"
    s.push(
        "## what it recorded.\n@derive(Copy)\nstruct {ty}:\n    __log: Cap[Mutex[list[String]]]\n"
    )
    for m in ms:
        if let Some(r) = m.result:
            s.push("    __on_{m.name}: Cap[Mutex[list[{r}]]]\n")
    var fields = ["__log=Cap(Mutex(list()))".to_string()]
    for m in ms:
        if m.result.is_some():
            fields.push("__on_{m.name}=Cap(Mutex(list()))")
    s.push("\nimpl {ty}:\n")
    s.push("    ## A fake of `{trait_name}` that has seen no calls and has no results queued.\n")
    s.push("    def new() -> {ty}:\n        return {ty}({fields.join(", ")})\n")
    s.push("    ## The calls so far, in order, each written `method(arguments)`.\n")
    s.push(
        "    def calls(self) -> list[String]:\n        return self.__log.get().lock().value.copy()\n"
    )
    for m in ms:
        if let Some(r) = m.result:
            s.push(
                "    ## Queues what a call of `{m.name}` returns; the last result queued is returned\n"
            )
            s.push("    ## again once the others are used.\n")
            s.push("    def on_{m.name}(self, own result: {r}):\n")
            s.push("        self.__on_{m.name}.get().lock().value.push(result)\n")
    s.push("\nimpl {trait_name} for {ty}:\n")
    for m in ms:
        s.push("    def {m.name}({m.params}){m.ret}:\n")
        s.push("        self.__log.get().lock().value.push(\"{m.name}({shown_args(m)})\")\n")
        if m.result.is_some():
            s.push("        var __queued = self.__on_{m.name}.get().lock()\n")
            s.push("        if __queued.value.is_empty():\n")
            s.push(
                "            panic(\"`cap.Fake[{trait_name}]`: `{m.name}` was called with no result queued (`on_{m.name}`)\")\n"
            )
            s.push("        if len(__queued.value) == 1:\n")
            s.push("            return __queued.value[0].copy()\n")
            s.push("        return __queued.value.remove(0)\n")
    return s

## One fenced example of a run of `##` lines: the line of its opening
## fence, and each of its lines (the line, the column its text starts at,
## and the text).
struct DocExample:
    fence_line: int
    lines: list[(int, int, String)]

## A `##` line's indentation and its text after the marker; `None` for any
## other line (`##!` is a module's doc).
pure def doc_line(line: str) -> (int, String)?:
    var indent = 0
    while indent < line.byte_len() and line.byte_at(indent) == 32:
        indent += 1
    let rest = line.byte_slice(indent, line.byte_len())
    if not rest.starts_with("##") or rest.starts_with("##!"):
        return None
    return Some((indent, rest.byte_slice(2, rest.byte_len()).to_string()))

## The examples in a text (stage 0's `doctests::examples`): an example is
## a fenced block in a run of `##` lines, opened by "```" or "```sisu" and
## closed by "```", and documents the first item that starts after the run;
## one with no item after it, or no line, is none.
pure def doc_examples(text: str, starts: list[int]) -> list[DocExample]:
    var out: list[DocExample] = []
    var run: list[DocExample] = []
    var open: DocExample? = None
    var offset = 0
    var index = 0
    for raw in text.split("\n"):
        let start = offset
        offset += raw.byte_len() + 1
        var bare = raw.to_string()
        if bare.ends_with("\r"):
            bare = bare.byte_slice(0, bare.byte_len() - 1).to_string()
        match doc_line(bare):
            case Some((indent, content)):
                let fence = content.trim()
                match open:
                    case Some(e):
                        if fence == "```":
                            run.push(e.copy())
                            open = None
                        else:
                            var col = indent + 2
                            var body = content.copy()
                            if content.starts_with(" "):
                                col = indent + 3
                                body = content.byte_slice(1, content.byte_len()).to_string()
                            if not body.trim().is_empty():
                                if let Some(x) = ref mut open:
                                    x.lines.push((index, col, body))
                    case None:
                        if fence == "```" or fence == "```sisu":
                            open = Some(DocExample(fence_line=index, lines=[]))
            case None:
                open = None
                finish_doc_run(mut run, start, starts, mut out)
        index += 1
    finish_doc_run(mut run, text.byte_len(), starts, mut out)
    var kept: list[DocExample] = []
    for e in out:
        if not e.lines.is_empty():
            kept.push(e.copy())
    return kept

## The examples of a run that ended at `at` document the first item that
## starts there or later; without one they are none.
pure def finish_doc_run(
    mut run: list[DocExample], at: int, starts: list[int], mut out: list[DocExample]
):
    if run.is_empty():
        return
    var found = False
    for s in starts:
        if s >= at:
            found = True
    if found:
        for e in run:
            out.push(e.copy())
    run.clear()

## The module of tests for the examples (stage 0's `doctests::test_module`):
## as many lines as `text`, the opening fence's line holding the test's
## header, the example's lines its body, every other line empty.
pure def doc_test_module(text: str, examples: list[DocExample]) -> String:
    var count = 0
    for _ in text.split("\n"):
        count += 1
    if text.ends_with("\n"):
        count -= 1
    if count < 1:
        count = 1
    var lines: list[String] = []
    for _ in range(count):
        lines.push(String.new())
    for k in range(len(examples)):
        let e = ref examples[k]
        if e.fence_line < count:
            lines[e.fence_line] = "test \"doc example {k}\":"
        for (line, col, body) in e.lines:
            if line < count:
                var l = String.new()
                for _ in range(col):
                    l.push(" ")
                l.push(body)
                lines[line] = l
    var out = lines.join("\n")
    out.push("\n")
    return out
