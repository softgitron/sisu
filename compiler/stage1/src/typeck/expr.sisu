##! Expressions (stage 0's `sisu-typeck/src/expr.rs`): literals, names,
##! operators, collections, interpolation, `if` and `match` expressions,
##! closures, `?`, `??`, `?.`, fields and indexing, and the coercions
##! between them.

from stage1.diag import Diagnostic, Edit, Fix, Msg, Param, TextRange
from stage1.syntax.ast import (
    Arg,
    Arm,
    ArmBody,
    Ast,
    BinOp,
    Block,
    Closure,
    ClosureBody,
    CmpOp,
    CompClause,
    CompKind,
    ExprId,
    ExprKind,
    IndexArg,
    Mode,
    Name,
    StrPart,
    TypeExprId,
    UnOp,
)
from stage1.syntax.ast import build
from stage1.typeck.check import Checker, Cx, PASSED, RetCtx, first_of
from stage1.typeck.program import Answer, DefKind, FnInfo, param_local_ty
from stage1.typeck.std_sources import int_width, sized, widens
from stage1.typeck.thir import (
    ArgMode,
    BindMode,
    BlockId,
    Callee,
    Capture,
    ClosureId,
    ClosureRole,
    Coercion,
    ForMode,
    IndexKind,
    InterpPart,
    TArg,
    TArm,
    TArmBody,
    TClosure,
    TCompClause,
    TCompKind,
    TCond,
    TCondPart,
    TExprId,
    TExprKind,
    TPatKind,
    TStmt,
    TryKind,
)
from stage1.typeck.ty import DefId, TraitRef, Ty, TyData, TyKey, is_subset

## The body of a closure being checked.
pub enum ClosureSource:
    Expr(ExprId)
    Block(Block)

## A parameter of a closure being checked: its name, its written type,
## where it is written.
pub struct ClosureParamSrc:
    pub name: String
    pub ty: TypeExprId?
    pub range: TextRange

impl Checker:
    ## Checks an expression against a type: infer with the type as a hint,
    ## then coerce.
    pub pure def check_expr(mut self, cx: Cx, e: ExprId, ty: Ty) -> TExprId:
        # A constant where a refinement is expected is checked at compile
        # time (07); it is written as a value of the base.
        if let Some((d, args, base)) = self.refinement_of(cx, ty):
            if self.is_constant(cx, e):
                let x = self.check_expr(cx, e, base)
                let exp = self.resolved(ty)
                return self.refine_constant(cx, x, d, args, exp)
        let x = self.infer_expr(cx, e, Some(ty))
        return self.coerce(cx, x, ty)

    ## `check_expr` against a type written at `because` (a `let`'s
    ## annotation), which a mismatch points at.
    pub pure def check_expr_because(
        mut self, cx: Cx, e: ExprId, ty: Ty, because: TextRange
    ) -> TExprId:
        if self.refinement_of(cx, ty).is_some() and self.is_constant(cx, e):
            return self.check_expr(cx, e, ty)
        let x = self.infer_expr(cx, e, Some(ty))
        self.because = Some(because)
        let y = self.coerce(cx, x, ty)
        self.because = None
        return y

    ## Converts `x` to `expected`, or reports a mismatch.
    pub pure def coerce(mut self, cx: Cx, x: TExprId, expected: Ty) -> TExprId:
        let branch = self.branch.copy()
        self.branch = None
        let because = self.because
        self.because = None
        let actual = self.resolved(self.ty_of(x))
        let exp = self.resolved(expected)
        if actual == Ty.error() or exp == Ty.error():
            return x
        if actual == Ty.never():
            if exp == Ty.never():
                return x
            return self.wrap(x, Coercion.NeverToAny, exp)
        if self.infer.try_unify(mut self.types, actual, exp):
            self.check_purity_coercion(cx, x, exp)
            return x
        # A refinement where its base (or anything its base becomes) is
        # expected: the same value.
        if let Some((d, _, _)) = self.refinement_of(cx, actual):
            var same = False
            if let TyData.Adt(e, _) = self.types.data(exp):
                same = e == d
            if not same:
                let y = self.unrefined_once(cx, x)
                return self.coerce(cx, y, exp)
        # A value of the base where a refinement is expected: only a
        # constant is checked where it is written; anything else is
        # checked where it runs, with `X.try_from` (07).
        if let Some((d, _, base)) = self.refinement_of(cx, exp):
            var same = False
            if let TyData.Adt(a, _) = self.types.data(actual):
                same = a == d
            if not same:
                var under = [base]
                var walking = True
                while walking:
                    walking = False
                    let last = under[len(under) - 1]
                    if let TyData.Adt(b, args) = self.types.data(last).copy():
                        if len(under) < 64:
                            if let Some(t) = cx.prog.refinement_base(mut self.types, b, args):
                                under.push(t)
                                walking = True
                var base_ok = False
                # A reference to a `Copy` value of the base, a loop's `ref
                # int`, is read as the value (RULES.md, R101).
                var value = actual
                if let TyData.Ref(inner, _) = self.types.data(actual).copy():
                    if self.is_copy(cx, inner):
                        value = inner
                for b in under:
                    let snap = self.infer.snapshot()
                    if self.infer.unify(mut self.types, value, b):
                        base_ok = True
                    self.infer.rollback(snap)
                if base_ok or actual == Ty.never():
                    let name = cx.prog.defs[d.index].name.copy()
                    let shown_exp = self.show(cx, exp)
                    let shown_actual = self.show(cx, actual)
                    var diag = self.error(cx, Msg.RefineNeedsTryFrom, self.span_of(x))
                    diag = diag.with("expected", shown_exp).with("found", shown_actual)
                    diag = diag.with("name", name).note_with(Msg.RefineUseTryFrom, "name", name)
                    self.report_other(diag)
                    return self.wrap(x, Coercion.Mismatch, exp)
        let ad = self.types.data(actual).copy()
        let ed = self.types.data(exp).copy()
        let exp_is_str = exp == Ty.str()
        match ad:
            case TyData.Adt(d, _):
                if exp_is_str and cx.prog.is_builtin(d, "String"):
                    return self.wrap(x, Coercion.StrView, Ty.str())
            case TyData.Ref(inner, m):
                if exp_is_str and self.is_string(cx, inner):
                    return self.wrap(x, Coercion.RefStrView, Ty.str())
                if m:
                    if let TyData.Ref(target, False) = ed:
                        if self.infer.try_unify(mut self.types, inner, target):
                            return self.wrap(x, Coercion.MutToShared, exp)
            case TyData.ErrSet(a):
                if let TyData.ErrSet(b) = ed:
                    if is_subset(a, b):
                        return self.wrap(x, Coercion.Widen, exp)
            case _:
                pass
        if let TyData.Ref(inner, _) = ad:
            if self.is_copy(cx, inner):
                let snap = self.infer.snapshot()
                if self.infer.unify(mut self.types, inner, exp):
                    return self.wrap(x, Coercion.DerefCopy, exp)
                self.infer.rollback(snap)
            if exp_is_str and self.resolved(inner) == Ty.str():
                return self.wrap(x, Coercion.DerefCopy, Ty.str())
        # `T ! A` where `T ! {A, B}` is expected.
        if let Some((t1, e1)) = self.as_result(cx, actual):
            if let Some((t2, e2)) = self.as_result(cx, exp):
                if let TyData.ErrSet(a) = self.data(e1):
                    if let TyData.ErrSet(b) = self.data(e2):
                        if is_subset(a, b) and self.infer.try_unify(mut self.types, t1, t2):
                            return self.wrap(x, Coercion.Widen, exp)
        # A value of a type that implements a trait, as `dyn Trait`; a
        # `ref T` as a `ref dyn Trait`; a `Box[T]` as a `Box[dyn Trait]`.
        if let TyData.Ref(inner, m1) = ad:
            if let TyData.Ref(target, m2) = ed:
                if m1 or not m2:
                    if let TyData.Dyn(tr) = self.data(target):
                        var concrete_ok = True
                        match self.data(inner):
                            case TyData.Dyn(_) | TyData.Var(_):
                                concrete_ok = False
                            case _:
                                pass
                        if concrete_ok:
                            let concrete = self.resolved(inner)
                            return self.coerce_to_dyn(cx, x, concrete, tr, exp, Coercion.RefToDyn)
        if let TyData.Dyn(tr) = ed:
            var concrete_ok = True
            match ad:
                case TyData.Dyn(_) | TyData.Var(_):
                    concrete_ok = False
                case _:
                    pass
            if concrete_ok:
                # A `dyn` expected by value was reported where it is
                # written (E0395); a reference to one is no second error.
                if let TyData.Ref(inner, _) = ad:
                    if let TyData.Dyn(_) = self.data(inner):
                        return self.wrap(x, Coercion.Mismatch, exp)
                return self.coerce_to_dyn(cx, x, actual, tr, exp, Coercion.ToDyn)
        if let TyData.Adt(d1, a1) = ad:
            if let TyData.Adt(d2, a2) = ed:
                if d1 == d2
                        and Some(d1) == cx.prog.wk.boxed
                        and not a1.is_empty()
                        and not a2.is_empty():
                    if let TyData.Dyn(tr) = self.data(a2[0]):
                        var concrete_ok = True
                        match self.data(a1[0]):
                            case TyData.Dyn(_) | TyData.Var(_):
                                concrete_ok = False
                            case _:
                                pass
                        if concrete_ok:
                            let inner = self.resolved(a1[0])
                            return self.coerce_to_dyn(cx, x, inner, tr, exp, Coercion.BoxToDyn)
        # A `list[T]` as a `Slice[T]`, and `bytes` as a `Slice[u8]`: a view.
        if let TyData.Adt(sd, sargs) = ed:
            if cx.prog.is_builtin(sd, "Slice"):
                let stripped = self.resolved(self.types.strip_ref(actual))
                if let TyData.Adt(src, srcargs) = self.types.data(stripped).copy():
                    let elem = first_of(sargs) ?? Ty.error()
                    var ok = False
                    if cx.prog.is_builtin(src, "bytes"):
                        let u8_ty = self.sized_ty(cx, "u8")
                        ok = self.infer.try_unify(mut self.types, elem, u8_ty)
                    elif cx.prog.is_builtin(src, "list"):
                        if let Some(t) = first_of(srcargs):
                            ok = self.infer.try_unify(mut self.types, t, elem)
                    if ok:
                        let src_ty = self.types.adt(src, srcargs)
                        if let Some(call) = self.builtin_call(cx, x, src_ty, "as_slice", exp):
                            return call
        # An integer as a wider integer type that holds all its values.
        if let Some(a) = self.int_kind(cx, actual):
            if let Some(b) = self.int_kind(cx, exp):
                if widens(a, b):
                    return self.wrap(x, Coercion.IntWiden, exp)
        # An `f32` as an `f64`, which holds every one (03, "Numbers").
        if self.float_kind(cx, actual) == Some("f32") and exp == Ty.float():
            return self.wrap(x, Coercion.FloatWiden, exp)
        # A value of a type that implements a capability's operations
        # trait, as the capability (06).
        if let TyData.Adt(d, _) = ed:
            if let Some(ops) = cx.prog.capability_ops(d):
                var y = x
                var concrete = actual
                if let TyData.Ref(inner, _) = ad:
                    if self.is_copy(cx, inner):
                        let inner_r = self.resolved(inner)
                        y = self.wrap(x, Coercion.DerefCopy, inner_r)
                        concrete = inner_r
                let z = self.infer.zonk(mut self.types, concrete)
                let norm = cx.prog.normalize(mut self.types, z, self.env)
                if norm == exp:
                    return y
                let tr = TraitRef(def_=ops, args=[])
                var is_var = False
                if let TyData.Var(_) = self.types.data(norm):
                    is_var = True
                if not is_var
                        and cx.prog.implements(mut self.types, norm, tr, self.env) != Answer.No:
                    return self.coerce_to_cap(cx, y, norm, tr, exp)
                let found_s = self.show(cx, norm)
                let expected_s = self.show(cx, exp)
                let dd = self.error(cx, Msg.TypeMismatch, self.span_of(y))
                self.report(dd.with("expected", expected_s).with("found", found_s))
                return self.wrap(y, Coercion.Mismatch, exp)
        # `Iterable[T]` accepts any collection or iterator of `T`; a
        # program's iterator through a generator that takes its items.
        if let TyData.Adt(d, args) = ed:
            if Some(d) == cx.prog.wk.iterable:
                if let Some((item, fmode)) = self.iteration_item(cx, actual, Mode.Borrow):
                    let it = self.decay_ty(cx, item)
                    if let Some(t) = first_of(args):
                        if self.infer.try_unify(mut self.types, it, t):
                            if fmode != ForMode.Trait:
                                return x
                            let (call, made) = self.iter_from(cx, x, t)
                            if made:
                                return call
        let range = self.span_of(x)
        # An error the expected error set does not include.
        var sets: (list[DefId], list[DefId])? = None
        if let TyData.ErrSet(a) = ad:
            if let TyData.ErrSet(b) = ed:
                sets = Some((a.copy(), b.copy()))
        if sets.is_none():
            if let Some((t1, e1)) = self.as_result(cx, actual):
                if let Some((t2, e2)) = self.as_result(cx, exp):
                    if self.infer.try_unify(mut self.types, t1, t2):
                        if let TyData.ErrSet(a) = self.data(e1):
                            if let TyData.ErrSet(b) = self.data(e2):
                                sets = Some((a.copy(), b.copy()))
        if let Some((from_, to)) = sets:
            if not is_subset(from_, to):
                let d = self.error_not_in_set(cx, range, from_, to)
                self.report(d)
                return self.wrap(x, Coercion.Mismatch, exp)
        let expected_s = self.show(cx, exp)
        let found_s = self.show(cx, actual)
        var d = Diagnostic.new(Msg.TypeMismatch, 0, 0)
        match branch:
            # Two branches that disagree, where nothing else asked for a
            # type: neither is the one expected.
            case Some((keyword, first)):
                d = self.error(cx, Msg.TypeIfBranches, range)
                d = d.with("keyword", keyword).with("first", expected_s).with("second", found_s)
                d = d.label_with(Msg.TypeFoundHere, first.start, first.end, "ty", expected_s)
            case None:
                d = self.error(cx, Msg.TypeMismatch, range)
                d = d.with("expected", expected_s).with("found", found_s)
                if let Some(r) = because:
                    d = d.label(Msg.TypeExpectedBecause, r.start, r.end)
        # An `int` where a float is expected is converted, which the fix
        # writes (RULES.md, R45: the note named an `=` a `return` does not
        # have).
        if actual == Ty.int():
            if let Some(k) = self.float_kind(cx, exp):
                let r = self.span_of(x)
                if r.start >= 0 and r.start < r.end and r.end <= cx.source.byte_len():
                    let edits = self.to_float_edits(cx, x, k)
                    let ty_param = Param(name="ty".to_string(), value=k)
                    d.fixes.push(Fix(msg=Msg.TypeConvertToFloat, params=[ty_param], edits=edits))
                    self.report(d)
                    return self.wrap(x, Coercion.Mismatch, exp)
        # An `int` where a sized integer is expected narrows through a
        # method that gives an option (RULES.md, R55): `large.to_u8()`.
        if self.int_kind(cx, self.resolved(actual)) == Some("int".to_string()):
            if let Some(k) = self.int_kind(cx, self.resolved(exp)):
                if k != "int" and k != "i64":
                    let params = [Param(name="ty".to_string(), value=k)]
                    d = d.note_params(Msg.TypeNarrowInt, params)
        d = self.mismatch_fix(cx, d, x, actual, exp)
        self.report(d)
        return self.wrap(x, Coercion.Mismatch, exp)

    ## E0321: `from_` errors cannot leave where `to` is expected.
    pub pure def error_not_in_set(
        mut self, cx: Cx, range: TextRange, from_: list[DefId], to: list[DefId]
    ) -> Diagnostic:
        let from_ty = self.types.err_set(from_.copy())
        let to_ty = self.types.err_set(to.copy())
        let shown_from = cx.prog.display(self.types, from_ty)
        let shown_to = cx.prog.display(self.types, to_ty)
        var d = self.error(cx, Msg.TypeErrorNotInSet, range)
        d = d.with("from", shown_from).with("to", shown_to)
        var missing = String.new()
        for e in from_:
            if not to.contains(e):
                if not missing.is_empty():
                    missing.push(", ")
                missing.push(cx.prog.qualified_name(e))
        let set = Param(name="set".to_string(), value=missing)
        return d.fix_params(Msg.TypeAddErrorSet, [set], [])

    ## For a function named where a function type is expected that takes
    ## by reference each `Copy` value the function takes by value: the
    ## closure that calls it, `x -> f(x)` (or `(a, b) -> f(a, b)`).
    pure def by_value_closure(mut self, cx: Cx, x: TExprId, actual: Ty, exp: Ty) -> Edit?:
        if let TExprKind.FnRef(_, _) = self.exprs[x.index].kind:
            pass
        else:
            return None
        var have: list[Ty] = []
        var want: list[Ty] = []
        if let TyData.Fn(ps, _, _) = self.data(actual):
            have = ps.copy()
        if let TyData.Fn(ps, _, _) = self.data(exp):
            want = ps.copy()
        if len(have) != len(want) or have.is_empty():
            return None
        var any = False
        for k in range(len(have)):
            let h = self.resolved(have[k])
            var w = self.resolved(want[k])
            if let TyData.Ref(inner, False) = self.data(w):
                w = self.resolved(inner)
                if w == h and self.is_copy(cx, h):
                    any = True
                    continue
                return None
            if not self.infer.try_unify(mut self.types, h, w):
                return None
        if not any:
            return None
        let r = self.span_of(x)
        let name = cx.source.byte_slice(r.start, r.end)
        var params: list[String] = []
        if len(have) == 1:
            params.push("x".to_string())
        else:
            for k in range(len(have)):
                params.push("x{k + 1}")
        let joined = params.join(", ")
        var head = joined.copy()
        if len(have) > 1:
            head = "({joined})"
        return Some(Edit(start=r.start, end=r.end, text="{head} -> {name}({joined})"))

    ## The fix of a value of the wrong type, where one is plain: a number
    ## written as text loses its quotes; a value whose type has a method of
    ## no arguments giving the type expected gets the call (`.count()` of an
    ## `Iter` where an `int` is expected), the first by name.
    pure def mismatch_fix(
        mut self, cx: Cx, own d: Diagnostic, x: TExprId, actual: Ty, exp: Ty
    ) -> Diagnostic:
        let r = self.span_of(x)
        if r.start < 0 or r.end > cx.source.byte_len() or r.start > r.end:
            return d
        # A value where an option of its type is expected: `Some(5)` for an
        # `int?` (RULES.md, R45).
        if let TyData.Adt(o, oa) = self.data(exp):
            if Some(o) == cx.prog.wk.option and len(oa) == 1 and r.start < r.end:
                if self.resolved(oa[0]) == self.resolved(actual) and actual != Ty.error():
                    let edits = [
                        Edit(start=r.start, end=r.start, text="Some(".to_string()),
                        Edit(start=r.end, end=r.end, text=")".to_string()),
                    ]
                    return d.fix_edits(Msg.TypeWrapSome, edits)
        # A function that takes a `Copy` value where one that takes it by
        # reference is expected, `map(f)` over a list's `iter()`: a closure
        # that calls it with the value, `x -> f(x)` (RULES.md, R63).
        if let Some(edit) = self.by_value_closure(cx, x, actual, exp):
            return d.fix_edits(Msg.TypeCallWithValue, [edit])
        # A value where a reference to a `dyn Trait` it implements is
        # expected, `total(b)` for `item: ref dyn Priced`: lend it (RULES.md,
        # R101).
        if let TyData.Ref(target, m) = self.data(exp):
            if let TyData.Dyn(tr) = self.data(target):
                var plain = True
                match self.data(actual):
                    case TyData.Ref(_, _) | TyData.Var(_) | TyData.Dyn(_):
                        plain = False
                    case _:
                        pass
                if plain and r.start < r.end and not self.types.contains_error(actual):
                    let concrete = self.resolved(actual)
                    let traits = TraitRef(def_=tr.def_, args=tr.args.copy())
                    if cx.prog.implements(mut self.types, concrete, traits, self.env) != Answer.No:
                        let word = if m: "mut " else: "ref "
                        return d.fix_at(Msg.TypeLendIt, r.start, r.start, word)
        # A capability, a test's `TestClock` among them, where a whole
        # `System` is expected: the parameter narrowed to the capability
        # takes it (RULES.md, R104).
        if self.is_builtin(cx, exp, "System") and not self.types.contains_error(actual):
            let concrete = self.resolved(self.types.strip_ref(actual))
            let wk = ref cx.prog.wk
            let caps = [
                ("Clock", "clock", wk.clock_ops),
                ("Fs", "fs", wk.fs_ops),
                ("Net", "net", wk.net_ops),
                ("Rand", "rand", wk.rand_ops),
                ("Env", "env", wk.env_ops),
                ("Stdin", "stdin", wk.stdin_ops),
            ]
            if let TyData.Adt(_, _) = self.data(concrete):
                for (cap, field, ops) in caps:
                    let t = ops else:
                        continue
                    let tr = TraitRef(def_=t, args=[])
                    if let Answer.Yes(_) = cx.prog.implements(mut self.types, concrete, tr, self.env):
                        let ps = [
                            Param(name="found".to_string(), value=self.show(cx, concrete)),
                            Param(name="cap".to_string(), value=cap.to_string()),
                            Param(name="field".to_string(), value=field.to_string()),
                        ]
                        return d.note_params(Msg.TypeNarrowCapability, ps)
        # Text where a `Path` is expected: `Path.new` makes one (R16).
        if self.is_builtin(cx, exp, "Path") and self.is_text(cx, self.types.strip_ref(actual)):
            let edits = [
                Edit(start=r.start, end=r.start, text="Path.new(".to_string()),
                Edit(start=r.end, end=r.end, text=")".to_string()),
            ]
            return d.fix_edits(Msg.TypeMakePath, edits)
        # A reference where what it refers to is expected, as an item of a
        # collection of owned values (RULES.md, R21): a copy of the value,
        # `aino.copy()` for `ref aino`.
        if let TyData.Ref(inner, _) = self.data(actual):
            if self.resolved(inner) == self.resolved(exp) and not self.types.contains_error(exp):
                if let TExprKind.Borrow(place, _) = self.exprs[x.index].kind:
                    let pr = self.span_of(place)
                    if pr.start >= r.start and pr.end <= r.end and pr.start < pr.end:
                        let place_text = cx.source.byte_slice(pr.start, pr.end)
                        return d.fix_at(Msg.TypeAddCopy, r.start, r.end, "{place_text}.copy()")
                var out = d.fix_at(Msg.TypeAddCopy, r.end, r.end, ".copy()")
                # A borrowed parameter given where a value is moved (RULES.md,
                # R55): it lends its value, so the function takes it with
                # `own` to give it on, or gives a copy.
                if let TExprKind.Local(l) = self.exprs[x.index].kind:
                    if let Some(f) = cx.prog.fn_info(self.def_):
                        for p in f.params:
                            if p.span == self.locals[l].span and p.mode == Mode.Borrow:
                                let named = Param(name="name".to_string(), value=p.name.copy())
                                if let Some(own_param) = self.arg_own.copy():
                                    var callee = "the call".to_string()
                                    if let Some((c, _)) = self.arg_callee:
                                        callee = "`{cx.prog.defs[c.index].name}`"
                                    let params = [
                                        named.copy(),
                                        Param(name="param".to_string(), value=own_param),
                                        Param(name="callee".to_string(), value=callee),
                                    ]
                                    out = out.note_params(Msg.TypeBorrowedToOwn, params)
                                let edit = Edit(
                                    start=p.span.start, end=p.span.start, text="own ".to_string()
                                )
                                out = out.fix_params(Msg.TypeTakeOwn, [named], [edit])
                                break
                return out
        let text = cx.source.byte_slice(r.start, r.end)
        var literal = False
        match self.exprs[x.index].kind:
            case TExprKind.Str(s):
                if text.starts_with("\""):
                    var number = False
                    if exp == Ty.int():
                        number = s.parse_int().is_some()
                    elif self.float_kind(cx, exp).is_some():
                        number = s.parse_float().is_some() and s.contains(".")
                    else:
                        number = self.int_kind(cx, exp).is_some() and s.parse_int().is_some()
                    if number and not s.is_empty():
                        return d.fix_at(Msg.TypeUnquote, r.start, r.end, s)
                literal = True
            case TExprKind.Int(_) | TExprKind.WideInt(_) | TExprKind.Float(_) | TExprKind.Bool(_):
                literal = True
            case TExprKind.Char(_) | TExprKind.Bytes(_) | TExprKind.Interp(_) | TExprKind.List(_):
                literal = True
            case TExprKind.Tuple(_) | TExprKind.Unit:
                literal = True
            case _:
                pass
        # A literal wants another literal, not a call on it.
        if literal:
            return d
        var keys: list[TyKey] = []
        if let Some(k) = self.types.key(actual):
            keys.push(k)
        if self.is_string(cx, actual):
            keys.push(TyKey.Str)
        var found: list[String] = []
        for (k, def_) in cx.prog.methods:
            if keys.contains(k.0) and not k.1.starts_with("_"):
                if let Some(f) = cx.prog.fn_info(def_):
                    if gives(f, exp):
                        found.push(k.1.copy())
        # The methods of the traits it implements (without parameters of
        # their own): `count` of an `Iter`.
        for i in range(len(cx.prog.defs)):
            let t = DefId(index=i)
            let info = cx.prog.trait_info(t) else:
                continue
            if not info.generics.is_empty():
                continue
            var wanted: list[String] = []
            for m in info.methods:
                if let Some(f) = cx.prog.fn_info(m):
                    if gives(f, exp):
                        wanted.push(cx.prog.defs[m.index].name.copy())
            if wanted.is_empty():
                continue
            let tr = TraitRef(def_=t, args=[])
            if cx.prog.implements(mut self.types, actual, tr, self.env).holds():
                for w in wanted:
                    found.push(w.copy())
        found.sort()
        # The conversion that keeps the value comes first: `to_string` for
        # text where a `String` is expected, not `to_lowercase` (RULES.md,
        # R24).
        if self.is_string(cx, exp) and found.contains("to_string".to_string()):
            found = ["to_string".to_string()]
        let m = found.first() else:
            return d
        var simple = not text.is_empty()
        for b in text.bytes():
            if not is_simple_byte(b) and b != 34:
                simple = False
        let method = [Param(name="method".to_string(), value=m.copy())]
        if simple:
            let edit = Edit(start=r.end, end=r.end, text=".{m}()")
            return d.fix_params(Msg.TypeCallConversion, method, [edit])
        let edits = [
            Edit(start=r.start, end=r.start, text="(".to_string()),
            Edit(start=r.end, end=r.end, text=").{m}()"),
        ]
        return d.fix_params(Msg.TypeCallConversion, method, edits)

    ## A coercion to `dyn Trait` of a value of type `concrete`: it must
    ## implement the trait, and it must own what it holds (04, "Views").
    pure def coerce_to_dyn(
        mut self, cx: Cx, x: TExprId, concrete_in: Ty, tr: TraitRef, exp: Ty, kind: Coercion
    ) -> TExprId:
        let z = self.infer.zonk(mut self.types, concrete_in)
        let concrete = cx.prog.normalize(mut self.types, z, self.env)
        if cx.prog.can_borrow(mut self.types, concrete) and not self.types.contains_error(concrete):
            let shown = self.show(cx, concrete)
            let dyn_ty = self.types.intern(TyData.Dyn(tr.copy()))
            let shown_dyn = self.show(cx, dyn_ty)
            let d = self.error(cx, Msg.TypeViewToDyn, self.span_of(x)).with("ty", shown).with(
                "dyn", shown_dyn
            )
            self.report(d.note(Msg.TypeDynOwned))
            return self.wrap(x, Coercion.Mismatch, exp)
        self.bounds.push((concrete, tr.copy(), self.span_of(x)))
        return self.wrap(x, kind, exp)

    ## A value as a capability handle: it implements the operations trait,
    ## owns what it holds, is not must-consume, and is `Send` and `Sync`
    ## (checked once types are known).
    pure def coerce_to_cap(
        mut self, cx: Cx, x: TExprId, concrete: Ty, tr: TraitRef, exp: Ty
    ) -> TExprId:
        let cap_name = self.show(cx, exp)
        var owner = "Proc".to_string()
        if let TyData.Adt(d, _) = self.types.data(exp):
            let b = cx.prog.builtin(d) ?? String.new()
            if b == "Fs" or b == "Net" or b == "Clock" or b == "Rand" or b == "Env" or b == "Stdin":
                owner = b
        self.bounds.push((concrete, tr.copy(), self.span_of(x)))
        self.owner_checks.push((concrete, owner, self.span_of(x)))
        self.cap_checks.push((concrete, cap_name, self.span_of(x)))
        return self.wrap(x, Coercion.ToCap, exp)

    ## A function passed where a `pure` one is required must be pure.
    pure def check_purity_coercion(mut self, cx: Cx, x: TExprId, expected: Ty):
        let z = self.infer.zonk(mut self.types, expected)
        let TyData.Fn(_, _, True) = self.types.data(z) else:
            return
        var callee: String? = None
        var passed: DefId? = None
        match self.exprs[x.index].kind:
            case TExprKind.FnRef(d, _):
                var pure = False
                if let Some(i) = cx.prog.fn_info(d):
                    pure = i.pure
                if not pure:
                    callee = Some(cx.prog.defs[d.index].name.copy())
                    passed = Some(d)
            case TExprKind.Closure(c):
                var body: BlockId? = None
                if let Some(cl) = self.closures[c.index]:
                    body = Some(cl.body)
                if let Some(b) = body:
                    callee = self.first_impure_in_block(cx, b)
            case _:
                pass
        if let Some(name) = callee:
            var d = self.error(cx, Msg.TypeImpureArgument, self.span_of(x)).with("callee", name)
            # The function passed, whose operation responsible is named once
            # every body is checked (RULES.md, R90).
            if let Some(p) = passed:
                d = d.with(PASSED, "{p.index}")
            self.report(d)

    ## A `ref T` of a `Copy` type used as a value becomes the `T`.
    pub pure def decay(mut self, cx: Cx, x: TExprId) -> TExprId:
        # An explicit `ref` keeps its reference.
        if let TExprKind.Borrow(_, _) = self.exprs[x.index].kind:
            return x
        if let TyData.Ref(inner, _) = self.data(self.ty_of(x)):
            if self.is_copy(cx, inner):
                return self.wrap(x, Coercion.DerefCopy, inner)
        return x

    pub pure def decay_ty(mut self, cx: Cx, ty: Ty) -> Ty:
        let t = self.resolved(ty)
        if let TyData.Ref(inner, _) = self.types.data(t):
            if self.is_copy(cx, inner):
                return inner
        return t

    ## A value of a type that implements `Iterator` given to an
    ## `Iterable[T]` parameter: `iter_from(x)` (the prelude), a generator
    ## that takes the items from it as they are asked for, since the
    ## functions that take an `Iterable[T]` iterate collections and `Iter`s
    ## and never call the program's impls (decision 247). `item` is the
    ## parameter's `T`. A reference to such an iterator is given back, with
    ## `False`: it cannot be moved into the generator.
    pub pure def iter_from(mut self, cx: Cx, x: TExprId, item: Ty) -> (TExprId, bool):
        let ty = self.resolved(self.ty_of(x))
        let f = cx.prog.lookup_in(cx.prog.prelude, "iter_from") else:
            return (x, False)
        let iter = cx.prog.wk.iter else:
            return (x, False)
        if let TyData.Ref(_, _) = self.types.data(ty):
            return (x, False)
        let (given0, _) = self.iterator_item(cx, ty) else:
            return (x, False)
        let given = self.decay_ty(cx, given0)
        if not self.infer.try_unify(mut self.types, given, item):
            return (x, False)
        let (raw, _) = self.iterator_item(cx, ty) else:
            return (x, False)
        let span = self.span_of(x)
        let moved = self.check_movable(cx, x)
        let args = [TArg(expr=moved, mode=ArgMode.Value)]
        let call = TExprKind.Call(callee=Callee.Fn(def_=f, type_args=[ty]), args=args)
        let ret = self.types.adt(iter, [raw])
        return (self.add(call, ret, span), True)

    ## Reports a move out of a borrowed place or an element.
    pub pure def check_movable(mut self, cx: Cx, x: TExprId) -> TExprId:
        let ty = self.ty_of(x)
        if self.is_place(x)
                and self.is_behind_ref(x)
                and not self.is_copy(cx, ty)
                and self.resolved(ty) != Ty.error():
            let r = self.span_of(x)
            let what = self.source_text(cx, r)
            var d = self.error(cx, Msg.TypeMoveOutOfBorrow, r).with("what", what)
            d = d.fix_at(Msg.TypeAddCopy, r.end, r.end, ".copy()")
            # An item of a list the function owns is taken out of it with
            # `remove` (RULES.md, R45).
            if let TExprKind.Index(base, index, kind) = self.exprs[x.index].kind:
                if kind == IndexKind.List and self.is_place(base):
                    if let TExprKind.Local(l) = self.exprs[base.index].kind:
                        # The list is the function's own, not borrowed: the
                        # item stays in it, which lends it (RULES.md, R104).
                        if let TyData.Adt(_, _) = self.data(self.ty_of(base)):
                            let lr = self.span_of(base)
                            let ps = [
                                Param(name="list".to_string(), value=self.source_text(cx, lr)),
                                Param(name="what".to_string(), value=what.copy()),
                            ]
                            d = d.note_params(Msg.TypeItemStaysInList, ps)
                        if self.locals[l].mutable:
                            let br = self.span_of(base)
                            let ir = self.span_of(index)
                            let list = self.source_text(cx, br)
                            let at = self.source_text(cx, ir)
                            d = d.fix_at(Msg.TypeTakeOut, r.start, r.end, "{list}.remove({at})")
            self.report(d)
        return x

    ## Dereferences a reference value, so that its place can be used.
    pub pure def auto_deref(mut self, x: TExprId) -> TExprId:
        var cur = x
        while let TyData.Ref(inner, _) = self.data(self.ty_of(cur)):
            let span = self.span_of(cur)
            cur = self.add(TExprKind.Deref(cur), inner, span)
        return cur

    ## Whether the type is a `Box[T]`.
    pub pure def is_box(self, cx: Cx, ty: Ty) -> bool:
        if let TyData.Adt(d, _) = self.data(ty):
            return Some(d) == cx.prog.wk.boxed
        return False

    ## The builtin name of the type, when it is one of the std's
    ## pointer-like types (`Shared`, `MutexGuard`).
    pub pure def smart_pointer(self, cx: Cx, ty: Ty) -> String?:
        if let TyData.Adt(d, _) = self.data(ty):
            if cx.prog.is_builtin(d, "Shared"):
                return Some("Shared".to_string())
            if cx.prog.is_builtin(d, "MutexGuard"):
                return Some("MutexGuard".to_string())
            if cx.prog.is_builtin(d, "ReadGuard"):
                return Some("ReadGuard".to_string())
        return None

    ## The value a `Shared` owns or a mutex guard holds, as a place.
    pub pure def deref_smart(mut self, x: TExprId) -> TExprId:
        var inner = Ty.error()
        if let TyData.Adt(_, a) = self.data(self.ty_of(x)):
            inner = first_of(a) ?? Ty.error()
        let span = self.span_of(x)
        return self.add(TExprKind.Deref(x), inner, span)

    ## The value a `Box` holds, as a place inside it.
    pub pure def unbox(mut self, x: TExprId) -> TExprId:
        var inner = Ty.error()
        if let TyData.Adt(_, a) = self.data(self.ty_of(x)):
            inner = first_of(a) ?? Ty.error()
        let span = self.span_of(x)
        return self.add(TExprKind.Field(base=x, index=0), inner, span)

    # ---------------------------------------------------------------- inference

    pub pure def infer_expr(mut self, cx: Cx, e_in: ExprId, expected: Ty?) -> TExprId:
        var e = e_in
        if let Some((from_, to)) = self.stand_in:
            if from_ == e_in:
                e = to
        let node = cx.ast.expr(e)
        let span = node.range
        match node.kind:
            case ExprKind.Int(text, value, suffix):
                let x = self.int_literal(cx, value, suffix, text, False, span, expected)
                if suffix.is_none():
                    return self.literal_via_trait(cx, x, expected)
                return x
            case ExprKind.Float(text, value, suffix):
                let x = self.float_literal(cx, value, suffix, text, False, span, expected)
                if suffix.is_none():
                    return self.literal_via_trait(cx, x, expected)
                return x
            case ExprKind.Char(c):
                return self.add(TExprKind.Char(c), Ty.char(), span)
            case ExprKind.Str(parts):
                return self.string_literal(cx, parts, span, expected)
            case ExprKind.RawStr(s):
                return self.plain_string(cx, s, span, expected)
            case ExprKind.ByteStr(b):
                var ty = Ty.error()
                if let Some(d) = cx.prog.lookup_in(cx.prog.prelude, "bytes"):
                    ty = self.types.adt(d, [])
                return self.add(TExprKind.Bytes(b.copy()), ty, span)
            case ExprKind.Name(n):
                return self.name_expr(cx, n, span, expected)
            case ExprKind.SelfValue:
                if let Some(l) = self.lookup_local("self"):
                    self.note_use(l, False)
                    return self.add(TExprKind.Local(l), self.local_ty(l), span)
                if not self.quiet_unknown_names:
                    let d = self.error(cx, Msg.TypeNoSelf, span)
                    self.report(d)
                return self.error_expr(span)
            case ExprKind.SelfType:
                var d = self.error(cx, Msg.TypeNotAValue, span)
                d = d.with("name", "Self").with("kind", "type")
                self.report(d)
                return self.error_expr(span)
            case ExprKind.Paren(inner):
                let x = self.infer_expr(cx, inner, expected)
                self.set_span(x, span)
                return x
            case ExprKind.Tuple(items):
                return self.tuple_expr(cx, items, span, expected)
            case ExprKind.List(items):
                var elem: Ty? = None
                if let Some(t) = expected:
                    if let TyData.Adt(d, a) = self.data(t):
                        if Some(d) == cx.prog.wk.list:
                            elem = first_of(a)
                let (elems, ty) = self.homogeneous(cx, items, elem)
                let list_ty = self.list_of(cx, ty)
                return self.add(TExprKind.List(elems), list_ty, span)
            case ExprKind.Set(items):
                var elem: Ty? = None
                if let Some(t) = expected:
                    if let TyData.Adt(d, a) = self.data(t):
                        if Some(d) == cx.prog.wk.set:
                            elem = first_of(a)
                let (elems, ty) = self.homogeneous(cx, items, elem)
                self.require(ty, cx.prog.wk.hash, span)
                var set_ty = Ty.error()
                if let Some(s) = cx.prog.wk.set:
                    set_ty = self.types.adt(s, [ty])
                return self.add(TExprKind.Set(elems), set_ty, span)
            case ExprKind.Dict(entries):
                var kt: Ty? = None
                var vt: Ty? = None
                if let Some(t) = expected:
                    if let TyData.Adt(d, a) = self.data(t):
                        if Some(d) == cx.prog.wk.dict and len(a) == 2:
                            kt = Some(a[0])
                            vt = Some(a[1])
                var keys: list[ExprId] = []
                var values: list[ExprId] = []
                for (k, v) in entries:
                    keys.push(k)
                    values.push(v)
                let (ks, k_ty) = self.homogeneous(cx, keys, kt)
                let (vs, v_ty) = self.homogeneous(cx, values, vt)
                self.require(k_ty, cx.prog.wk.hash, span)
                var ty = Ty.error()
                if let Some(d) = cx.prog.wk.dict:
                    ty = self.types.adt(d, [k_ty, v_ty])
                var pairs: list[(TExprId, TExprId)] = []
                for i in range(len(ks)):
                    pairs.push((ks[i], vs[i]))
                return self.add(TExprKind.Dict(pairs), ty, span)
            case ExprKind.Comprehension(kind, elem, value, clauses):
                return self.comprehension(cx, kind, elem, value, clauses, span)
            case ExprKind.Binary(op, lhs, rhs):
                return self.binary_expr(cx, op, lhs, rhs, span, expected)
            case ExprKind.Compare(first, rest):
                return self.compare_expr(cx, first, rest, span)
            case ExprKind.Unary(op, inner):
                return self.unary_expr(cx, op, inner, span, expected)
            case ExprKind.Ref(mutable, inner):
                let x = self.infer_expr(cx, inner, None)
                # A shared borrow of a value that is no place borrows the
                # temporary that holds it to the end of its statement, as an
                # argument a parameter borrows is (`show(ref Coffee(1))`,
                # RULES.md, R25; 04, rule 3: a reference may be passed).
                if not self.is_place(x) and self.ty_of(x) != Ty.error() and mutable:
                    let d = self.error(cx, Msg.TypeNotAPlace, cx.ast.expr(inner).range)
                    self.report(d)
                if mutable:
                    self.require_mutable(cx, x, cx.ast.expr(inner).range)
                let ty = self.types.ref_(self.ty_of(x), mutable)
                return self.add(TExprKind.Borrow(place=x, mutable=mutable), ty, span)
            case ExprKind.FromEnd(_):
                let d = self.error(cx, Msg.TypeFromEndOutsideIndex, span)
                self.report(d)
                return self.error_expr(span)
            case ExprKind.Call(callee, args, trailing):
                return self.call_expr(cx, callee, args, trailing, span, expected)
            case ExprKind.Field(base, name):
                return self.field_expr(cx, base, name, span)
            case ExprKind.OptField(base, name):
                return self.opt_chain(cx, base, name, None, None, span)
            case ExprKind.Index(base, args):
                if self.generator_kind(cx, base).is_some():
                    return self.generator_site(cx, e, base, args, None, span, expected)
                return self.index_expr(cx, base, args, span)
            case ExprKind.Try(inner):
                return self.try_expr(cx, inner, span)
            case ExprKind.Closure(c):
                var fn_ty: Ty? = None
                if let Some(t) = expected:
                    if let TyData.Fn(_, _, _) = self.data(t):
                        fn_ty = Some(self.resolved(t))
                return self.check_closure(cx, c, fn_ty)
            case ExprKind.If(branches, else_):
                return self.if_expr(cx, branches, else_, span, expected)
            case ExprKind.Match(scrutinee, arms):
                return self.match_expr(cx, scrutinee, arms, span, expected)
            case ExprKind.Comptime(inner):
                return self.comptime_expr(cx, inner, expected, span)
            case ExprKind.FieldOf(_, _):
                self.no_unfolding(cx, span, "a field named by a compile-time value (`x.[f]`)")
                return self.error_expr(span)
            # `unsafe e` (22): the unsafe operations of the one expression
            # are permitted; it is the expression it marks.
            case ExprKind.Unsafe(inner):
                self.enter_unsafe(cx, span, False)
                let x = self.infer_expr(cx, inner, expected)
                self.exit_unsafe()
                return x
            case ExprKind.Unsupported(what):
                self.unsupported(cx, span, what, "foreign functions (Phase 8)")
                return self.error_expr(span)
            case ExprKind.Error:
                return self.error_expr(span)

    pure def int_literal(
        mut self,
        cx: Cx,
        value: u128?,
        suffix: String?,
        text: str,
        negative: bool,
        range: TextRange,
        expected: Ty?,
    ) -> TExprId:
        # A sized integer: the suffix's, or the expected type's.
        var kind: String? = None
        match suffix:
            case None:
                if let Some(t) = expected:
                    if let Some(k) = self.int_kind(cx, t):
                        if k != "int":
                            kind = Some(k.copy())
            case Some(s):
                if s == "uint":
                    kind = Some("u64".to_string())
                elif is_sized(s):
                    kind = Some(s.copy())
        if let Some(k) = kind:
            return self.sized_literal(cx, k, value, text, negative, range)
        if let Some(s) = suffix:
            if s == "f64":
                var f = 0.0
                if let Some(v) = value:
                    f = u128_to_float(v)
                if negative:
                    f = -f
                return self.add(TExprKind.Float(f), Ty.float(), range)
            if s != "int" and s != "i64":
                self.unsupported(cx, range, "`{s}`", "the sized numeric types (Phase 4)")
                return self.error_expr(range)
        var to_float: String? = None
        if suffix.is_none():
            if let Some(t) = expected:
                to_float = self.float_kind(cx, t)
        let limit = if negative: pow2(63) else: pow2(63) - one()
        match value:
            case Some(v):
                if v <= limit:
                    # An integer literal where a float is expected is that
                    # float, rounded once (`v as f32` rounds to the nearest).
                    if to_float == Some("f32"):
                        var f: f32 = 0.0
                        if v == pow2(63):
                            f = u128_to_int(v, True).to_f32()
                        else:
                            f = u128_to_int(v, False).to_f32()
                            if negative:
                                f = -f
                        let ty = self.sized_ty(cx, "f32")
                        return self.add(TExprKind.Float(f.to_f64()), ty, range)
                    if to_float.is_some():
                        var f = u128_to_float(v)
                        if negative:
                            f = -f
                        return self.add(TExprKind.Float(f), Ty.float(), range)
                    let n = u128_to_int(v, negative)
                    return self.add(TExprKind.Int(n), Ty.int(), range)
            case None:
                pass
        let t = if negative: "-{text}" else: text.to_string()
        let d = self.error(cx, Msg.TypeLiteralOutOfRange, range).with("text", t).with("ty", "int")
        let min = Param(name="min".to_string(), value="-9223372036854775808".to_string())
        let max = Param(name="max".to_string(), value="9223372036854775807".to_string())
        let ty = Param(name="ty".to_string(), value="int".to_string())
        # A larger integer is a `BigInt` (RULES.md, R101).
        let noted = d.note_params(Msg.TypeIntRange, [ty, min, max])
        self.report(noted.note_with(Msg.TypeBigIntLiteral, "text", t))
        return self.error_expr(range)

    ## An integer literal of the sized type `k`, checked to fit. A `u64`
    ## literal is its 64-bit pattern.
    pure def sized_literal(
        mut self, cx: Cx, k: str, value: u128?, text: str, negative: bool, range: TextRange
    ) -> TExprId:
        var bits = 64
        var signed = True
        if let Some((b, s)) = int_width(k):
            bits = b
            signed = s
        let ty = self.sized_ty(cx, k)
        # `2^bits - 1` is `(2^(bits - 1) - 1) + 2^(bits - 1)`, which does not
        # overflow for 128 bits.
        let half = pow2(bits - 1)
        let max = if signed: half - one() else: half - one() + half
        var fits = False
        if let Some(v) = value:
            if negative:
                fits = signed and v <= max + one()
            else:
                fits = v <= max
        if not fits:
            let t = if negative: "-{text}" else: text.to_string()
            let d = self.error(cx, Msg.TypeLiteralOutOfRange, range).with("text", t).with("ty", k)
            let low = if signed: "-{max + one()}" else: "0".to_string()
            let params = [
                Param(name="ty".to_string(), value=k.to_string()),
                Param(name="min".to_string(), value=low),
                Param(name="max".to_string(), value="{max}"),
            ]
            self.report(d.note_params(Msg.TypeIntRange, params))
            return self.error_expr(range)
        let v = value ?? (0.to_u128() ?? one())
        # A 128-bit literal beyond `int` keeps its 128 bits.
        if bits == 128:
            if negative:
                if v <= pow2(63):
                    return self.add(TExprKind.Int(u128_to_int(v, True)), ty, range)
                # Its two's complement: `2^128 - v`.
                let wide = (pow2(127) - v) + pow2(127)
                return self.add(TExprKind.WideInt(wide), ty, range)
            if v <= pow2(63) - one():
                return self.add(TExprKind.Int(u128_to_int(v, False)), ty, range)
            return self.add(TExprKind.WideInt(v), ty, range)
        if negative:
            return self.add(TExprKind.Int(u128_to_int(v, True)), ty, range)
        if v <= pow2(63) - one():
            return self.add(TExprKind.Int(u128_to_int(v, False)), ty, range)
        # A `u64` above `int`'s range: its 64-bit pattern, `v - 2^64`.
        return self.add(TExprKind.Int(u128_to_int(pow2(64) - v, True)), ty, range)

    ## The sized integer type named `k` (`u8`), or `f32`.
    pub pure def sized_ty(mut self, cx: Cx, k: str) -> Ty:
        let d = cx.prog.lookup_in(cx.prog.prelude, k) else:
            return Ty.error()
        return self.types.adt(d, [])

    ## `f64` for `f64`, `f32` for `f32`, `None` for any other type.
    pub pure def float_kind(self, cx: Cx, t: Ty) -> String?:
        let r = self.resolved(t)
        match self.data(r):
            case TyData.Float:
                return Some("f64".to_string())
            case TyData.Adt(d, a):
                if a.is_empty() and cx.prog.builtin(d) == Some("f32"):
                    return Some("f32".to_string())
                return None
            case _:
                return None

    ## Whether `t` is a number type: an integer type or a float type.
    pub pure def is_number(self, cx: Cx, t: Ty) -> bool:
        return self.int_kind(cx, t).is_some() or self.float_kind(cx, t).is_some()

    ## Whether the expression's type is `int` or `f64`.
    pure def int_or_float(self, x: TExprId) -> bool:
        let t = self.resolved(self.ty_of(x))
        return t == Ty.int() or t == Ty.float()

    ## A float literal: an `f64`, or an `f32` by its suffix or where one is
    ## expected, rounded once from its text (03, "Numbers"); one whose
    ## magnitude its type cannot hold is `E0374`.
    pure def float_literal(
        mut self,
        cx: Cx,
        value: f64,
        suffix: String?,
        text: str,
        negative: bool,
        range: TextRange,
        expected: Ty?,
    ) -> TExprId:
        var kind = "f64".to_string()
        match suffix:
            case Some(s):
                if s == "f32" or s == "f64":
                    kind = s.copy()
                else:
                    let d = self.error(cx, Msg.TypeFloatSuffix, range).with("suffix", s)
                    self.report(d)
                    return self.error_expr(range)
            case None:
                if let Some(t) = expected:
                    if let Some(k) = self.float_kind(cx, t):
                        kind = k
        var v = if negative: -value else: value
        var ty = Ty.float()
        if kind == "f32":
            let digits = text.strip_suffix("f32").replace("_", "")
            let f: f32 = digits.parse_f32() ?? 0.0
            v = if negative: (-f).to_f64() else: f.to_f64()
            ty = self.sized_ty(cx, "f32")
        # An infinity: beyond the largest finite `f64`.
        if v.abs() > 1.7976931348623157e308:
            let t = if negative: "-{text}" else: text.to_string()
            let d = self.error(cx, Msg.TypeLiteralOutOfRange, range).with("text", t).with(
                "ty", kind
            )
            # The largest finite value of the type, as Rust's `{:e}` writes it.
            let largest = if kind == "f32": "3.4028235e38" else: "1.7976931348623157e308"
            let params = [
                Param(name="ty".to_string(), value=kind.to_string()),
                Param(name="max".to_string(), value=largest.to_string()),
            ]
            self.report(d.note_params(Msg.TypeFloatRange, params))
            return self.error_expr(range)
        return self.add(TExprKind.Float(v), ty, range)

    ## An expression as the borrowed receiver of a builtin method: a
    ## reference is passed on, a `Copy` value copied, anything else
    ## borrowed.
    pub pure def receiver_arg(mut self, cx: Cx, x: TExprId) -> TArg:
        var mode = ArgMode.Borrow
        if let TyData.Ref(_, _) = self.data(self.ty_of(x)):
            mode = ArgMode.Value
        elif self.is_copy(cx, self.resolved(self.ty_of(x))):
            mode = ArgMode.Value
        return TArg(expr=x, mode=mode)

    ## A call of the builtin method `name` of `owner` on `recv`, with the
    ## owner's type arguments and the result type `ret`.
    pub pure def builtin_call(
        mut self, cx: Cx, recv: TExprId, owner: Ty, name: str, ret: Ty
    ) -> TExprId?:
        let TyData.Adt(d, a) = self.types.data(owner).copy() else:
            return None
        let m = cx.prog.method(TyKey.Adt(d), name) else:
            return None
        let span = self.span_of(recv)
        let r = self.receiver_arg(cx, recv)
        return Some(
            self.add(TExprKind.Call(callee=Callee.Fn(def_=m, type_args=a), args=[r]), ret, span)
        )

    ## `int` for `int`, the type's name for a sized integer type.
    pub pure def int_kind(self, cx: Cx, t: Ty) -> String?:
        match self.data(t):
            case TyData.Int:
                return Some("int".to_string())
            case TyData.Adt(d, a):
                if not a.is_empty():
                    return None
                let b = cx.prog.builtin(d) else:
                    return None
                if is_sized(b):
                    return Some(b)
                return None
            case _:
                return None

    pure def plain_string(mut self, cx: Cx, s: str, span: TextRange, expected: Ty?) -> TExprId:
        # A literal takes the expected type when it is `String` or `Path`.
        var ty = Ty.str()
        if let Some(t) = expected:
            let r = self.resolved(t)
            if let TyData.Adt(d, _) = self.types.data(r):
                if cx.prog.is_builtin(d, "String") or cx.prog.is_builtin(d, "Path"):
                    ty = r
        let x = self.add(TExprKind.Str(s.to_string()), ty, span)
        if ty == Ty.str():
            return self.literal_via_trait(cx, x, expected)
        return x

    ## A literal whose expected type is not the literal's own but
    ## implements `FromLiteral[L]` for the literal's type `L`: the call
    ## `FromLiteral.from_literal(x)` (02, "Literals").
    pure def literal_via_trait(mut self, cx: Cx, x: TExprId, expected: Ty?) -> TExprId:
        let exp_in = expected else:
            return x
        let tr_def = cx.prog.wk.from_literal else:
            return x
        let z = self.infer.zonk(mut self.types, exp_in)
        let exp = cx.prog.normalize(mut self.types, z, self.env)
        match self.types.data(exp):
            case TyData.Adt(_, _) | TyData.Param(_) | TyData.Assoc(_, _, _):
                pass
            case _:
                return x
        if self.ty_of(x) == Ty.error():
            return x
        let lit = self.ty_of(x)
        let tr = TraitRef(def_=tr_def, args=[lit])
        if not cx.prog.implements(mut self.types, exp, tr, self.env).holds():
            return x
        let span = self.span_of(x)
        # A float literal reaches a `Decimal` as written, its places kept
        # (03, "Numbers"; RULES.md, R33): from its text, not its `f64`.
        if let TExprKind.Float(_) = self.exprs[x.index].kind:
            if self.is_std_named(cx, exp, "num", "Decimal"):
                if let TyData.Adt(d, _) = self.types.data(exp):
                    if let Some(of) = cx.prog.method(TyKey.Adt(d), "of_literal"):
                        let text = self.source_text(cx, span)
                        let written = self.add(TExprKind.Str(text), Ty.str(), span)
                        let made = TExprKind.Call(
                            callee=Callee.Fn(def_=of, type_args=[]),
                            args=[TArg(expr=written, mode=ArgMode.Ref)],
                        )
                        return self.add(made, exp, span)
        let m = cx.prog.trait_method(tr_def, "from_literal") else:
            return x
        let call = TExprKind.Call(
            callee=Callee.Fn(def_=m, type_args=[exp, lit]), args=[TArg(expr=x, mode=ArgMode.Ref)]
        )
        return self.add(call, exp, span)

    pure def string_literal(
        mut self, cx: Cx, parts: list[StrPart], range: TextRange, expected: Ty?
    ) -> TExprId:
        var plain = True
        for p in parts:
            if let StrPart.Interp(_, _, _, _) = p:
                plain = False
        if plain:
            return self.plain_string(cx, build.plain_text(parts), range, expected)
        var out: list[InterpPart] = []
        for p in parts:
            match p:
                case StrPart.Text(t):
                    out.push(InterpPart.Text(t.copy()))
                case StrPart.Interp(expr, debug, spec_in, _):
                    if let ExprKind.OptField(_, _) = cx.ast.expr(expr).kind:
                        self.reading_chain = True
                    if let ExprKind.Binary(BinOp.Coalesce, _, _) = cx.ast.expr(expr).kind:
                        self.reading_coalesce = True
                    let x = self.infer_expr(cx, expr, None)
                    self.reading_chain = False
                    self.reading_coalesce = False
                    let spec = spec_in.copy() ?? String.new()
                    # A spec ending in `?` asks for `Debug` (`{x:>8?}`).
                    var wanted = cx.prog.wk.debug
                    if debug.is_none() and not spec.ends_with("?"):
                        wanted = cx.prog.wk.display
                    let at = cx.ast.expr(expr).range
                    self.require(self.ty_of(x), wanted, at)
                    let stripped = self.types.strip_ref(self.ty_of(x))
                    let is_time = self.is_builtin(cx, stripped, "DateTime")
                    if not spec.is_empty() and not is_time and not is_format_spec(spec):
                        let d = self.error(cx, Msg.TypeBadFormatSpec, at).with("spec", spec)
                        self.report(d)
                    elif not is_time and not spec.is_empty():
                        let letter = last_char(spec)
                        if "boxXdeEfF%".contains(letter):
                            # The spec's letter must fit a value whose
                            # rendering the compiler knows (E0380).
                            let t = self.resolved(stripped)
                            let integers_only = "boxXd".contains(letter)
                            var wrong = self.is_string(cx, t)
                            if self.float_kind(cx, t).is_some():
                                wrong = integers_only
                            else:
                                match self.types.data(t):
                                    case TyData.Bool | TyData.Char | TyData.Str:
                                        wrong = True
                                    case _:
                                        pass
                            if wrong:
                                let shown = self.show(cx, t)
                                var d = self.error(cx, Msg.TypeNoDisplay, at)
                                d = d.with("ty", shown).with("spec", spec)
                                self.report(d.note(Msg.TypeSpecLetters))
                    out.push(InterpPart.Value(expr=x, debug=debug.copy(), spec=spec))
        let s = self.string_ty(cx)
        return self.add(TExprKind.Interp(out), s, range)

    pure def tuple_expr(
        mut self, cx: Cx, items: list[ExprId], at: TextRange, expected: Ty?
    ) -> TExprId:
        if items.is_empty():
            return self.add(TExprKind.Unit, Ty.unit(), at)
        var exp: list[Ty]? = None
        var labels: list[String] = []
        if let Some(t) = expected:
            if let TyData.Tuple(ts, l) = self.data(t):
                if len(ts) == len(items):
                    exp = Some(ts.copy())
                    labels = l.copy()
        var elems: list[TExprId] = []
        var tys: list[Ty] = []
        for i in range(len(items)):
            var x = TExprId(index=0)
            match exp:
                case Some(ts):
                    x = self.check_expr(cx, items[i], ts[i])
                case None:
                    let y = self.infer_expr(cx, items[i], None)
                    x = self.decay(cx, y)
            let m = self.check_movable(cx, x)
            elems.push(m)
            tys.push(self.ty_of(m))
        let ty = self.types.intern(TyData.Tuple(elems=tys, labels=labels))
        return self.add(TExprKind.Tuple(elems), ty, at)

    ## Elements that share one type: the expected one, or the first's.
    pure def homogeneous(mut self, cx: Cx, items: list[ExprId], elem: Ty?) -> (list[TExprId], Ty):
        var ty = elem
        var out: list[TExprId] = []
        for it in items:
            match ty:
                case Some(t):
                    let x = self.check_expr(cx, it, t)
                    out.push(self.check_movable(cx, x))
                case None:
                    let y = self.infer_expr(cx, it, None)
                    let x = self.decay(cx, y)
                    ty = Some(self.ty_of(x))
                    out.push(self.check_movable(cx, x))
        let t = ty ?? self.infer.fresh(mut self.types)
        return (out, t)

    # ---------------------------------------------------------------- names

    pure def name_expr(mut self, cx: Cx, n: str, at: TextRange, expected: Ty?) -> TExprId:
        if let Some(l) = self.lookup_local(n):
            self.note_use(l, False)
            return self.add(TExprKind.Local(l), self.local_ty(l), at)
        if n == "True":
            return self.add(TExprKind.Bool(True), Ty.bool(), at)
        if n == "False":
            return self.add(TExprKind.Bool(False), Ty.bool(), at)
        if n == "it":
            # `it` makes a closure of a call's argument only (02), so an
            # item of a list of functions, `[heat, it - 15]`, writes the
            # closure (RULES.md, R77).
            let d = self.error(cx, Msg.TypeItOutsideClosure, at)
            self.report(d.note(Msg.TypeItArgumentOnly))
            return self.error_expr(at)
        # A `const` generic parameter is an `int`.
        for i in range(len(self.generic_names)):
            if self.generic_names[i] == n
                    and i < len(self.const_generics)
                    and self.const_generics[i]:
                return self.add(TExprKind.ConstParam(i), Ty.int(), at)
        # A variant of the expected type wins over a declaration.
        if let Some(exp) = expected:
            if let Some((def_, vi)) = self.variant_in(cx, exp, n):
                return self.unit_variant(cx, def_, vi, Some(exp), at)
        if let Some(d) = cx.prog.lookup(self.module, n):
            # A trait is no value: a variant of that name is what the name
            # means (RULES.md, R13).
            if let DefKind.Trait(_) = cx.prog.defs[d.index].kind():
                if let Some((def_, vi)) = self.global_variant(cx, n, at):
                    return self.unit_variant(cx, def_, vi, expected, at)
            return self.def_value(cx, d, n, at)
        if let Some((def_, vi)) = self.global_variant(cx, n, at):
            return self.unit_variant(cx, def_, vi, expected, at)
        if self.quiet_unknown_names or cx.prog.poisoned.contains(n.to_string()):
            return self.error_expr(at)
        # The compile-time module `reflect` (08) exists only in a derive's
        # template and in a template, which is made for its type arguments.
        if n == "reflect":
            self.no_unfolding(cx, at, "`reflect`")
            return self.error_expr(at)
        if n == "target":
            self.unsupported(cx, at, "`target`", "conditional compilation on the target (Phase 8)")
            return self.error_expr(at)
        # Another field of the struct whose default this is (E0221).
        if let Some(s) = self.field_default_of:
            if let Some(info) = cx.prog.struct_info(s):
                var field = False
                for f in info.fields:
                    if f.name == n:
                        field = True
                if field:
                    let d = self.error(cx, Msg.ResolveFieldDefaultOrder, at)
                    self.report_other(d.note_with(Msg.ResolveDefaultInFunction, "name", n))
                    return self.error_expr(at)
        # A scalar type's name as a value, which the name pass leaves to the
        # checker as a call's argument (RULES.md, R61): no value, with the
        # name pass's note on Python's conversions.
        let scalar = match n:
            case "int" | "f64" | "bool" | "char" | "str" | "Never": True
            case _: False
        if scalar:
            var d = self.error(cx, Msg.ResolveUndefinedName, at).with("name", n)
            if n == "int" or n == "str" or n == "bool":
                d = d.note(Msg.ResolvePythonConversion)
            self.report(d)
            return self.error_expr(at)
        # A name nothing declares (`resolve.undefined-name`).
        self.undefined_name(cx, n, at)
        return self.error_expr(at)

    ## A declaration used as a value.
    pub pure def def_value(mut self, cx: Cx, d: DefId, n: str, range: TextRange) -> TExprId:
        match cx.prog.defs[d.index].kind():
            case DefKind.Fn(f):
                # A generic intrinsic has no body to make an instance of.
                let generic_intrinsic = not f.generics.is_empty() and f.intrinsic.is_some()
                if f.self_mode.is_some() or generic_intrinsic:
                    let kind = if f.self_mode.is_some(): "method" else: "generic function"
                    var diag = self.error(cx, Msg.TypeNotAValue, range)
                    diag = diag.with("name", n).with("kind", kind)
                    self.report(diag)
                    return self.error_expr(range)
                if f.comptime_ and not self.in_comptime:
                    self.report_other(self.error(cx, Msg.ComptimeOnly, range).with("name", n))
                self.check_internal(cx, d, range)
                # A call through a function value is no unsafe operation, so
                # an `unsafe def` or a foreign function is never one (22).
                if f.unsafe_ or f.foreign:
                    self.unsafe_fn_value(cx, d, f, range)
                    return self.error_expr(range)
                # A function value takes its arguments by value, so a
                # function that returns a borrow of a parameter it borrows
                # cannot be one (decision 225).
                let env = cx.prog.elaborate_env(mut self.types, f.predicates)
                let deep = cx.prog.result_borrows_of(mut self.types, f).deep
                # (`range` is the parameter here, so the loop counts itself.)
                var i = 0
                while i < len(f.params):
                    let p = ref f.params[i]
                    i += 1
                    if not deep.contains(i - 1):
                        continue
                    if let TyData.Ref(_, _) = self.types.data(p.ty):
                        continue
                    let local = param_local_ty(cx.prog, mut self.types, p.ty, p.mode, env)
                    if let TyData.Ref(_, _) = self.types.data(local):
                        var diag = self.error(cx, Msg.TypeValueReturnsBorrow, range)
                        diag = diag.with("name", n).with("param", p.name.copy())
                        self.report(diag.note(Msg.TypeCallInstead))
                        return self.error_expr(range)
                # A generic function's type arguments are inferred where the
                # value is used, and its bounds required of them, as a
                # call's are (decision 225).
                if not f.generics.is_empty():
                    let sig = self.instantiate(cx, d, None, range)
                    var params: list[Ty] = []
                    for p in sig.params:
                        params.push(p.ty)
                    let ty = self.types.fn_(params, sig.ret, f.pure)
                    let kind = TExprKind.FnRef(def_=d, type_args=sig.type_args.copy())
                    return self.add(kind, ty, range)
                let ret = self.fn_ret(cx, d)
                var params: list[Ty] = []
                for p in f.params:
                    params.push(p.ty)
                let ty = self.types.fn_(params, ret, f.pure)
                return self.add(TExprKind.FnRef(def_=d, type_args=[]), ty, range)
            case DefKind.Const(c):
                return self.add(TExprKind.Const(d), c.ty, range)
            case DefKind.Struct(_) | DefKind.Enum(_) | DefKind.ErrorSet(_):
                return self.not_a_value(cx, n, "type", range)
            case DefKind.TypeAlias(_) | DefKind.Refinement(_):
                return self.not_a_value(cx, n, "type", range)
            case DefKind.Module(_):
                return self.not_a_value(cx, n, "module", range)
            case _:
                return self.not_a_value(cx, n, "declaration", range)

    ## E0350: a declaration that is not a value, used as one.
    pure def not_a_value(mut self, cx: Cx, n: str, kind: str, range: TextRange) -> TExprId:
        let diag = self.error(cx, Msg.TypeNotAValue, range).with("name", n).with("kind", kind)
        self.report(diag)
        return self.error_expr(range)

    ## The result type of a function, with its inferred error set filled in.
    pub pure def fn_ret(mut self, cx: Cx, d: DefId) -> Ty:
        let f = cx.prog.fn_info(d) else:
            return Ty.error()
        if f.err_inferred:
            if let TyData.Adt(r, a) = self.types.data(f.ret).copy():
                if Some(r) == cx.prog.wk.result and len(a) == 2:
                    var set: list[DefId] = []
                    if let Some(s) = cx.inferred.get(d):
                        set = s.copy()
                    return self.result_of(cx, a[0], set)
        return f.ret

    ## The variant `name` of an expected enum, error set, option or result.
    pub pure def variant_in(self, cx: Cx, expected: Ty, name: str) -> (DefId, int)?:
        var defs: list[DefId] = []
        match self.data(expected):
            case TyData.Adt(d, _):
                defs = [d]
            case TyData.ErrSet(m):
                defs = m.copy()
            case _:
                return None
        for d in defs:
            if let Some(e) = cx.prog.enum_info(d):
                for i in range(len(e.variants)):
                    if e.variants[i].name == name:
                        return Some((d, i))
        return None

    ## A variant found by its unqualified name alone; ambiguity is reported.
    pub pure def global_variant(mut self, cx: Cx, name: str, range: TextRange) -> (DefId, int)?:
        let candidates = cx.prog.variants.get(name.to_string()) else:
            return None
        var visible: list[(DefId, int)] = []
        for (d, vi) in candidates:
            let m = cx.prog.defs[d.index].module
            var seen = m == self.module or m == cx.prog.prelude
            if not seen:
                for (_, x) in cx.prog.modules[self.module.index].items:
                    if let DefKind.Module(mm) = cx.prog.defs[x.index].kind():
                        if mm == m:
                            seen = True
            if seen:
                visible.push((d, vi))
        # A variant declared in this module wins over one from the prelude
        # or an imported module.
        var local: list[(DefId, int)] = []
        for (d, vi) in visible:
            if cx.prog.defs[d.index].module == self.module:
                local.push((d, vi))
        if len(local) == 1:
            visible = local
        if visible.is_empty():
            return None
        if len(visible) > 1:
            var names: list[String] = []
            for (d, _) in visible:
                names.push(cx.prog.qualified_name(d))
            let example = "{names[0]}.{name}"
            var d = self.error(cx, Msg.ResolveAmbiguousVariant, range).with("name", name)
            d = d.with("candidates", names.join(", ")).with("example", example)
            self.report_other(d)
        return Some(visible[0])

    ## The type of a value of an enum or error-set definition, with fresh
    ## arguments for a generic enum (unified with `expected` if given).
    pub pure def variant_owner_ty(mut self, cx: Cx, def_: DefId, expected: Ty?) -> (Ty, list[Ty]):
        if cx.prog.is_error_set(def_):
            return (self.types.err_set([def_]), [])
        var n = 0
        if let Some(e) = cx.prog.enum_info(def_):
            n = len(e.generics)
        var args: list[Ty] = []
        for _ in range(n):
            args.push(self.infer.fresh(mut self.types))
        let ty = self.types.adt(def_, args.copy())
        if let Some(exp) = expected:
            let r = self.resolved(exp)
            if let TyData.Adt(d, _) = self.types.data(r):
                if d == def_:
                    _ = self.infer.try_unify(mut self.types, ty, r)
        return (ty, args)

    pub pure def unit_variant(
        mut self, cx: Cx, def_: DefId, vi: int, expected: Ty?, range: TextRange
    ) -> TExprId:
        var name = String.new()
        var has_fields = False
        if let Some(e) = cx.prog.enum_info(def_):
            if vi < len(e.variants):
                name = e.variants[vi].name.copy()
                has_fields = not e.variants[vi].fields.is_empty()
        if has_fields:
            let d = self.error(cx, Msg.TypeVariantNeedsFields, range).with("name", name)
            self.report(d)
            return self.error_expr(range)
        let (ty, _) = self.variant_owner_ty(cx, def_, expected)
        return self.add(TExprKind.Variant(def_=def_, variant=vi, args=[]), ty, range)

    # ---------------------------------------------------------------- operators

    pure def binary_expr(
        mut self, cx: Cx, op: BinOp, lhs: ExprId, rhs: ExprId, range: TextRange, expected: Ty?
    ) -> TExprId:
        if op == BinOp.And or op == BinOp.Or:
            let l = self.check_condition_expr(cx, lhs)
            let r = self.check_condition_expr(cx, rhs)
            return self.add(TExprKind.Logic(and_=op == BinOp.And, lhs=l, rhs=r), Ty.bool(), range)
        if op == BinOp.Coalesce:
            return self.coalesce(cx, lhs, rhs, range, expected)
        var hint: Ty? = None
        if let Some(t) = expected:
            let r = self.resolved(t)
            if self.is_number(cx, r):
                hint = Some(r)
        let l0 = self.infer_expr(cx, lhs, hint)
        let l1 = self.decay(cx, l0)
        var l = self.unrefined(cx, l1)
        let lt = self.resolved(self.ty_of(l))
        var rhint: Ty? = None
        if self.is_number(cx, lt):
            rhint = Some(lt)
        let r0 = self.infer_expr(cx, rhs, rhint)
        # A reference to what is not known yet, against a number, reads a
        # number.
        if let Some(num) = rhint:
            if let TyData.Ref(inner, _) = self.data(self.ty_of(r0)):
                if let TyData.Var(_) = self.data(inner):
                    _ = self.infer.unify(mut self.types, inner, num)
        let r1 = self.decay(cx, r0)
        var r = self.unrefined(cx, r1)
        # A literal on the left takes the type of a float on the right.
        let right = self.resolved(self.ty_of(r))
        match self.exprs[l.index].kind:
            case TExprKind.Int(n):
                if right == Ty.float():
                    l = self.add(TExprKind.Float(n.to_f64()), Ty.float(), self.span_of(l))
                elif self.float_kind(cx, right) == Some("f32") and self.int_or_float(l):
                    l = self.infer_expr(cx, lhs, Some(right))
            case TExprKind.Float(_):
                if self.float_kind(cx, right) == Some("f32") and self.int_or_float(l):
                    l = self.infer_expr(cx, lhs, Some(right))
            case _:
                pass
        # A shift's amount is a count of bits, which takes no part in the
        # shifted value's type (RULES.md, R80): a literal on the left keeps
        # its own, and neither side widens to the other.
        let shift = op == BinOp.Shl or op == BinOp.Shr
        # A literal on the left takes the sized integer type on the right.
        let rt = self.resolved(self.ty_of(r))
        if let Some(k) = self.int_kind(cx, rt):
            if k != "int" and not shift:
                if let TExprKind.Int(_) = self.exprs[l.index].kind:
                    if self.resolved(self.ty_of(l)) == Ty.int():
                        l = self.infer_expr(cx, lhs, Some(rt))
        # Integers of two types: the narrower widens when that loses nothing.
        var widened = shift and self.shifts_sized(cx, self.ty_of(l), self.ty_of(r))
        if widened:
            pass
        elif let Some(a) = self.int_kind(cx, self.ty_of(l)):
            if let Some(b) = self.int_kind(cx, self.ty_of(r)):
                if a != b and widens(a, b):
                    let to = self.resolved(self.ty_of(r))
                    l = self.wrap(l, Coercion.IntWiden, to)
                    widened = True
                elif a != b and widens(b, a):
                    let to = self.resolved(self.ty_of(l))
                    r = self.wrap(r, Coercion.IntWiden, to)
                    widened = True
        # An `f32` beside an `f64` widens, as an integer does.
        if not widened:
            let lk = self.float_kind(cx, self.ty_of(l))
            let rk = self.float_kind(cx, self.ty_of(r))
            if lk == Some("f32") and rk == Some("f64"):
                l = self.wrap(l, Coercion.FloatWiden, Ty.float())
            elif lk == Some("f64") and rk == Some("f32"):
                r = self.wrap(r, Coercion.FloatWiden, Ty.float())
        # A literal beside a type that takes literals through `FromLiteral`,
        # a `BigInt` or a `Decimal`, is of that type, when the operator has
        # no impl for the literal's own (D-076; RULES.md, R78).
        if not widened:
            r = self.literal_beside(cx, op, l, r)
            l = self.literal_beside(cx, op, r, l)
        if let Some(call) = self.operator_call(cx, op, l, Some(r), range):
            return call
        let (ty, _) = self.binary_result(cx, op, l, r, range)
        if ty == Ty.str() or self.is_string(cx, ty):
            # String concatenation views both sides as `str`.
            l = self.coerce(cx, l, Ty.str())
            r = self.coerce(cx, r, Ty.str())
        return self.add(TExprKind.Binary(op=op, lhs=l, rhs=r), ty, range)

    ## The literal `lit` (an integer or a float written as such) as a value
    ## of the type of `other`, the other operand of `op`, when that type is
    ## no number, implements `FromLiteral` for the literal's type, and the
    ## operator has no impl that takes the literal as it is; else `lit`.
    pure def literal_beside(mut self, cx: Cx, op: BinOp, other: TExprId, lit: TExprId) -> TExprId:
        match self.exprs[lit.index].kind:
            case TExprKind.Int(_) | TExprKind.Float(_):
                pass
            case _:
                return lit
        let ot = self.resolved(self.types.strip_ref(self.ty_of(other)))
        let TyData.Adt(_, _) = self.types.data(ot) else:
            return lit
        if self.is_number(cx, ot) or self.is_string(cx, ot):
            return lit
        let lt = self.resolved(self.ty_of(lit))
        if let Some((tr_def, _)) = self.operator_trait(cx, op):
            let as_is = TraitRef(def_=tr_def, args=[lt])
            if cx.prog.implements(mut self.types, ot, as_is, self.env).holds():
                return lit
            let flipped = TraitRef(def_=tr_def, args=[ot])
            if cx.prog.implements(mut self.types, lt, flipped, self.env).holds():
                return lit
        let made = self.literal_via_trait(cx, lit, Some(ot))
        return made

    ## The trait behind an operator of the fixed set (D-022), and its method.
    pub pure def operator_trait(self, cx: Cx, op: BinOp) -> (DefId, String)?:
        let wk = ref cx.prog.wk
        return match op:
            case BinOp.Add: pair(wk.add, "add")
            case BinOp.Sub: pair(wk.sub, "sub")
            case BinOp.Mul: pair(wk.mul, "mul")
            case BinOp.Div: pair(wk.div, "div")
            case BinOp.Mod: pair(wk.rem, "rem")
            case _: None

    pure def operand_base(mut self, cx: Cx, t: Ty) -> Ty:
        let stripped = self.types.strip_ref(self.resolved(t))
        let z = self.infer.zonk(mut self.types, stripped)
        return cx.prog.normalize(mut self.types, z, self.env)

    ## `l op r` (or `-l`, for `r` = `None`) on a type that is not a number
    ## or text: a call of the operator's trait method, when the type
    ## implements the trait. `None` leaves it to the builtin operators.
    pub pure def operator_call(
        mut self, cx: Cx, op: BinOp, l: TExprId, r: TExprId?, range: TextRange
    ) -> TExprId?:
        let lt = self.operand_base(cx, self.ty_of(l))
        var builtin_left = False
        match self.types.data(lt):
            case TyData.Int | TyData.Float | TyData.Str:
                builtin_left = True
            case TyData.Var(_) | TyData.Error | TyData.Never:
                return None
            case _:
                pass
        if self.is_string(cx, lt) or self.float_kind(cx, lt).is_some():
            builtin_left = True
        # A number or text on the left reaches an impl of the operator for
        # it when the right is a type of the program's own: `2.0 * v` with
        # `impl Mul[Vector] for f64` (RULES.md, R43).
        if builtin_left:
            let x = r else:
                return None
            let other = self.operand_base(cx, self.ty_of(x))
            let TyData.Adt(_, _) = self.types.data(other) else:
                return None
            if self.is_string(cx, other) or self.float_kind(cx, other).is_some():
                return None
            if self.int_kind(cx, other).is_some():
                return None
        var tdef = DefId(index=0)
        var method = String.new()
        var rt: Ty? = None
        match r:
            case Some(x):
                let operator = self.operator_trait(cx, op) else:
                    return None
                let (d, m) = operator
                tdef = d
                method = m
                rt = Some(self.operand_base(cx, self.ty_of(x)))
            case None:
                let d = cx.prog.wk.neg else:
                    return None
                tdef = d
                method = "neg".to_string()
        var targs: list[Ty] = []
        if let Some(t) = rt:
            targs.push(t)
        let tr = TraitRef(def_=tdef, args=targs)
        if cx.prog.implements(mut self.types, lt, tr, self.env) == Answer.No:
            return None
        let m = cx.prog.trait_method(tdef, method) else:
            return None
        let sig = self.instantiate(cx, m, None, range)
        if let Some(v) = sig.type_args.first():
            _ = self.infer.try_unify(mut self.types, v, lt)
        if let Some(t) = rt:
            if len(sig.type_args) > 1:
                _ = self.infer.try_unify(mut self.types, sig.type_args[1], t)
        var args = [self.as_ref_arg(l)]
        if let Some(x) = r:
            args.push(self.as_ref_arg(x))
        let z = self.infer.zonk(mut self.types, sig.ret)
        let ret = cx.prog.normalize(mut self.types, z, self.env)
        let call = TExprKind.Call(
            callee=Callee.Fn(def_=m, type_args=sig.type_args.copy()), args=args
        )
        return Some(self.add(call, ret, range))

    pure def as_ref_arg(self, x: TExprId) -> TArg:
        if let TyData.Ref(_, _) = self.data(self.ty_of(x)):
            return TArg(expr=x, mode=ArgMode.Value)
        return TArg(expr=x, mode=ArgMode.Ref)

    ## Whether `l << r` (or `>>`) shifts a sized integer, of a type other
    ## than `int`, by an amount of an integer type: its value keeps `l`'s
    ## type (RULES.md, R80).
    pure def shifts_sized(self, cx: Cx, l: Ty, r: Ty) -> bool:
        let a = self.int_kind(cx, self.resolved(l)) else:
            return False
        if a == "int":
            return False
        return self.int_kind(cx, self.resolved(r)).is_some()

    ## The type of `lhs op rhs`, reporting a misuse.
    pub pure def binary_result(
        mut self, cx: Cx, op: BinOp, l: TExprId, r: TExprId, range: TextRange
    ) -> (Ty, bool):
        var lt = self.resolved(self.ty_of(l))
        var rt = self.resolved(self.ty_of(r))
        if lt == Ty.error() or rt == Ty.error():
            return (Ty.error(), False)
        # Unify variables with the other side when one side is known.
        let lvar = is_var_data(self.types.data(lt))
        let rvar = is_var_data(self.types.data(rt))
        if lvar and not rvar:
            _ = self.infer.unify(mut self.types, lt, rt)
        elif rvar and not lvar:
            _ = self.infer.unify(mut self.types, rt, lt)
        lt = self.resolved(lt)
        rt = self.resolved(rt)
        # A sized integer shifted by an amount of any integer type keeps its
        # type, and an amount outside its width traps (03; RULES.md, R80).
        if op == BinOp.Shl or op == BinOp.Shr:
            if self.shifts_sized(cx, lt, rt):
                return (lt, True)
        # Two values of one sized integer type: what `int` allows.
        if let Some(a) = self.int_kind(cx, lt):
            if let Some(b) = self.int_kind(cx, rt):
                if a == b and a != "int":
                    if op == BinOp.Div:
                        let d = self.error(cx, Msg.TypeIntegerDivision, range)
                        self.report(d)
                        return (lt, False)
                    if op == BinOp.And or op == BinOp.Or or op == BinOp.Coalesce:
                        return (Ty.error(), False)
                    return (lt, True)
        # Two `f32`s: what two `f64`s allow, giving an `f32`.
        if self.float_kind(cx, lt) == Some("f32") and self.float_kind(cx, rt) == Some("f32"):
            match op:
                case BinOp.FloorDiv:
                    let d = self.error(cx, Msg.TypeFloatFloorDivision, range)
                    self.report(d)
                    return (lt, False)
                case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.Div | BinOp.Mod | BinOp.Pow:
                    return (lt, True)
                case _:
                    pass
        let both_int = lt == Ty.int() and rt == Ty.int()
        let both_float = lt == Ty.float() and rt == Ty.float()
        if op == BinOp.Div and both_int:
            let at = self.op_span(cx, l, r, "/")
            let d = self.error(cx, Msg.TypeIntegerDivision, range)
            var fixed = d.fix_at(Msg.TypeUseFloorDivision, at.start, at.end, "//")
            # Or the float division 03 spells, both sides made `f64`
            # (RULES.md, R104).
            var edits = self.float_operand_edits(cx, l)
            for e in self.float_operand_edits(cx, r):
                edits.push(e.copy())
            var compound = False
            if let TExprKind.Error = self.exprs[l.index].kind:
                compound = True
            if len(edits) >= 2 and not compound:
                fixed = fixed.fix_edits(Msg.TypeFloatDivision, edits)
            self.report(fixed)
            return (Ty.int(), False)
        if op == BinOp.FloorDiv and both_float:
            let d = self.error(cx, Msg.TypeFloatFloorDivision, range)
            self.report(d)
            return (Ty.float(), False)
        var result: Ty? = None
        match op:
            case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.FloorDiv | BinOp.Mod | BinOp.Pow:
                if both_int:
                    result = Some(Ty.int())
            case BinOp.WrapAdd | BinOp.WrapSub | BinOp.WrapMul | BinOp.SatAdd | BinOp.SatSub | BinOp.SatMul:
                if both_int:
                    result = Some(Ty.int())
            case BinOp.Shl | BinOp.Shr | BinOp.BitAnd | BinOp.BitOr | BinOp.BitXor:
                if both_int:
                    result = Some(Ty.int())
            case _:
                pass
        if result.is_none():
            match op:
                case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.Div | BinOp.Mod | BinOp.Pow:
                    if both_float:
                        result = Some(Ty.float())
                case _:
                    pass
        if result.is_none() and op == BinOp.Add and self.is_text(cx, lt) and self.is_text(cx, rt):
            result = Some(self.string_ty(cx))
        if result.is_none():
            let mixed = (lt == Ty.int() and self.float_kind(cx, rt).is_some())
                or (self.float_kind(cx, lt).is_some() and rt == Ty.int())
            if mixed:
                # The fix converts the `int` side: a literal gets its `.0`,
                # anything else `.to_f64()` (or `.to_f32()`).
                let int_side = if lt == Ty.int(): l else: r
                let float = if lt == Ty.int(): rt else: lt
                let kind = self.float_kind(cx, float) ?? "f64".to_string()
                let shown_l = self.show(cx, lt)
                let shown_r = self.show(cx, rt)
                var d = self.error(cx, Msg.TypeMixedNumbers, range)
                d = d.with("op", op.text()).with("lhs", shown_l).with("rhs", shown_r)
                let edits = self.to_float_edits(cx, int_side, kind)
                let ty_param = Param(name="ty".to_string(), value=kind)
                d.fixes.push(Fix(msg=Msg.TypeConvertToFloat, params=[ty_param], edits=edits))
                self.report(d)
                return (Ty.error(), False)
        if let Some(t) = result:
            return (t, True)
        # Operands whose types nothing has told yet, the parameters of a
        # closure kept in a `let` (`(a, b) -> a + b`): what is missing is
        # their types, not an impl (RULES.md, R25).
        if let TyData.Var(_) = self.data(lt):
            if let TyData.Var(_) = self.data(rt):
                let lr = self.span_of(l)
                let name = self.source_text(cx, lr)
                var d = Diagnostic.new(Msg.TypeCannotInfer, lr.start, lr.end).with("name", name)
                self.report(d.note(Msg.TypeAnnotateParams))
                return (Ty.error(), False)
        let shown_l = self.show(cx, lt)
        let shown_r = self.show(cx, rt)
        var d = self.error(cx, Msg.TypeBinaryOperator, range)
        d = d.with("op", op.text()).with("lhs", shown_l).with("rhs", shown_r)
        # Text and a number, a `bool` or a `char` joined by `+`:
        # interpolation writes the value into the text.
        if op == BinOp.Add:
            let text_first = self.is_text(cx, lt) and self.is_shown(cx, rt)
            let text_second = self.is_shown(cx, lt) and self.is_text(cx, rt)
            if text_first or text_second:
                if let Some(text) = self.interpolated(cx, l, r):
                    d = d.fix_at(Msg.TypeInterpolate, range.start, range.end, text)
        # Two sized integers neither of which holds the other's values, an
        # `i16` and a `u32`, which an `int` both holds: the left made an
        # `int`, beside which the right widens (03; RULES.md, R98).
        if let Some(a) = self.int_kind(cx, lt):
            if let Some(b) = self.int_kind(cx, rt):
                let arithmetic = match op:
                    case BinOp.Add | BinOp.Sub | BinOp.Mul | BinOp.FloorDiv | BinOp.Mod: True
                    case BinOp.BitAnd | BinOp.BitOr | BinOp.BitXor: True
                    case _: False
                if arithmetic and a != b and widens(a, "int") and widens(b, "int"):
                    let edits = self.method_edits(cx, l, "to_int")
                    let ty_param = Param(name="ty".to_string(), value=a.copy())
                    d.fixes.push(Fix(msg=Msg.TypeConvertToInt, params=[ty_param], edits=edits))
        # An optional value used as the value it may hold.
        if self.is_option(cx, lt) or self.is_option(cx, rt):
            d = d.note(Msg.TypeOptionNotValue)
        # Two `Decimal`s divided: the quotient is rounded where it is made
        # (D-076; RULES.md, R33).
        if op == BinOp.Div and self.is_std_named(cx, lt, "num", "Decimal"):
            if self.is_std_named(cx, rt, "num", "Decimal"):
                d = d.note(Msg.TypeDecimalQuotient)
        # Python's `"0" * 64`: text is repeated with `repeat` (RULES.md, R45).
        elif op == BinOp.Mul and self.is_text(cx, lt) and rt == Ty.int():
            let lr = self.span_of(l)
            let rr = self.span_of(r)
            if lr.start < lr.end and rr.start < rr.end and rr.end <= cx.source.byte_len():
                let text = cx.source.byte_slice(lr.start, lr.end)
                let count = cx.source.byte_slice(rr.start, rr.end)
                var receiver = text.to_string()
                if not text.starts_with("\"") and text.contains(" "):
                    receiver = "({text})"
                let fixed = "{receiver}.repeat({count})"
                d = d.fix_at(Msg.TypeSisuSpelling, range.start, range.end, fixed)
        # A type of the program's own without the operator: its trait is
        # what an impl gives it (RULES.md, R45).
        elif let TyData.Adt(own_d, _) = self.data(lt):
            let home = cx.prog.defs[own_d.index].module
            if not cx.prog.modules[home.index].is_std:
                if let Some((t, _)) = self.operator_trait(cx, op):
                    var ps = [
                        Param(name="op".to_string(), value=op.text().to_string()),
                        Param(name="trait".to_string(), value=cx.prog.defs[t.index].name.copy()),
                    ]
                    ps.push(Param(name="ty".to_string(), value=shown_l.copy()))
                    ps.push(Param(name="rhs".to_string(), value=shown_r.copy()))
                    d = d.note_params(Msg.TypeOperatorTrait, ps)
        # A number on the left of a type of the program's own, `3.0 * step`:
        # the impl is the left type's, which only the root package may write
        # for a type that is not its own (RULES.md, R101).
        if let TyData.Adt(own_r, _) = self.data(rt):
            let home = cx.prog.defs[own_r.index].module
            if not cx.prog.modules[home.index].is_std and self.is_number(cx, lt):
                if let Some((t, _)) = self.operator_trait(cx, op):
                    var ps = [
                        Param(name="op".to_string(), value=op.text().to_string()),
                        Param(name="trait".to_string(), value=cx.prog.defs[t.index].name.copy()),
                    ]
                    ps.push(Param(name="ty".to_string(), value=shown_l.copy()))
                    ps.push(Param(name="rhs".to_string(), value=shown_r.copy()))
                    d = d.note_params(Msg.TypeOperatorTraitLeft, ps)
        self.report(d)
        return (Ty.error(), False)

    ## Whether `t` is the std module `module`'s type `name`.
    pub pure def is_std_named(self, cx: Cx, t: Ty, module: str, name: str) -> bool:
        if let TyData.Adt(d, _) = self.types.data(self.resolved(t)):
            let def_ = ref cx.prog.defs[d.index]
            let m = ref cx.prog.modules[def_.module.index]
            return def_.name == name and m.is_std and m.name == module
        return False

    pub pure def is_text(self, cx: Cx, t: Ty) -> bool:
        return t == Ty.str() or self.is_string(cx, t)

    pure def is_shown(self, cx: Cx, t: Ty) -> bool:
        match self.types.data(t):
            case TyData.Int | TyData.Bool | TyData.Char:
                return True
            case _:
                return self.is_number(cx, t)

    ## The edits that make an `int` operand a float of kind `kind` (`f64` or
    ## `f32`): `2` becomes `2.0`, a name or a call gets `.to_f64()` (or
    ## `.to_f32()`), anything else is parenthesised first.
    pure def to_float_edits(self, cx: Cx, x: TExprId, kind: str) -> list[Edit]:
        let r = self.span_of(x)
        let text = cx.source.byte_slice(r.start, r.end)
        var digits = not text.is_empty()
        for b in text.bytes():
            if not (is_digit(b) or b == 95):
                digits = False
        if digits:
            return [Edit(start=r.end, end=r.end, text=".0".to_string())]
        var simple = not text.is_empty()
        for b in text.bytes():
            if not is_simple_byte(b):
                simple = False
        if simple:
            let first = text.byte_at(0)
            simple = is_alpha(first) or first == 95
        if simple:
            return [Edit(start=r.end, end=r.end, text=".to_{kind}()")]
        return [
            Edit(start=r.start, end=r.start, text="(".to_string()),
            Edit(start=r.end, end=r.end, text=").to_{kind}()"),
        ]

    ## The edits that make an `int` operand an `f64`: a literal gets its
    ## `.0`, anything else `.to_f64()`; none for an operand without text.
    pure def float_operand_edits(self, cx: Cx, x: TExprId) -> list[Edit]:
        let r = self.span_of(x)
        if r.start < 0 or r.end > cx.source.byte_len() or r.start >= r.end:
            return []
        let text = cx.source.byte_slice(r.start, r.end)
        var digits = True
        for b in text.bytes():
            if not (is_digit(b) or b == 95):
                digits = False
        if digits:
            return [Edit(start=r.end, end=r.end, text=".0".to_string())]
        return self.method_edits(cx, x, "to_f64")

    ## The edits that call `method` on an operand: after a name, a call or
    ## a parenthesised expression, around anything else parenthesised
    ## first.
    pure def method_edits(self, cx: Cx, x: TExprId, method: str) -> list[Edit]:
        let r = self.span_of(x)
        let text = cx.source.byte_slice(r.start, r.end)
        if enclosed(text):
            return [Edit(start=r.end, end=r.end, text=".{method}()")]
        var simple = not text.is_empty()
        for b in text.bytes():
            if not is_simple_byte(b):
                simple = False
        if simple:
            let first = text.byte_at(0)
            simple = is_alpha(first) or first == 95
        if simple:
            return [Edit(start=r.end, end=r.end, text=".{method}()")]
        return [
            Edit(start=r.start, end=r.start, text="(".to_string()),
            Edit(start=r.end, end=r.end, text=").{method}()"),
        ]

    ## `"text" + x` (or `x + "text"`) as one interpolated string, when the
    ## text side is a plain string literal.
    pure def interpolated(self, cx: Cx, l: TExprId, r: TExprId) -> String?:
        let ls = self.span_of(l)
        let rs = self.span_of(r)
        let a = cx.source.byte_slice(ls.start, ls.end)
        let b = cx.source.byte_slice(rs.start, rs.end)
        let la = literal_inside(a)
        let lb = literal_inside(b)
        if let Some(text) = la:
            if lb.is_none():
                return Some("\"{text}{{{b}}}\"")
            return None
        if let Some(text) = lb:
            return Some("\"{{{a}}}{text}\"")
        return None

    ## The span of the operator between two operands, for a fix.
    pure def op_span(self, cx: Cx, l: TExprId, r: TExprId, op: str) -> TextRange:
        let start = self.span_of(l).end
        let end = self.span_of(r).start
        if start <= end:
            let between = cx.source.byte_slice(start, end)
            if let Some(i) = between.find(op):
                return TextRange.new(start + i, start + i + op.byte_len())
        return TextRange.empty(start)

    pure def unary_expr(
        mut self, cx: Cx, op: UnOp, inner: ExprId, range: TextRange, expected: Ty?
    ) -> TExprId:
        if op == UnOp.Neg:
            match cx.ast.expr(inner).kind:
                case ExprKind.Int(text, value, suffix):
                    let x = self.int_literal(cx, value, suffix, text, True, range, expected)
                    if suffix.is_none():
                        return self.literal_via_trait(cx, x, expected)
                    return x
                case ExprKind.Float(text, value, suffix):
                    let x = self.float_literal(cx, value, suffix, text, True, range, expected)
                    if suffix.is_none():
                        return self.literal_via_trait(cx, x, expected)
                    return x
                case _:
                    pass
        var x = TExprId(index=0)
        if op == UnOp.Not:
            x = self.check_condition_expr(cx, inner)
        else:
            var hint: Ty? = None
            if let Some(t) = expected:
                let r = self.resolved(t)
                if r == Ty.int() or self.float_kind(cx, r).is_some():
                    hint = Some(r)
            let y = self.infer_expr(cx, inner, hint)
            let z = self.decay(cx, y)
            x = self.unrefined(cx, z)
        if op == UnOp.Neg:
            if let Some(call) = self.operator_call(cx, BinOp.Sub, x, None, range):
                return call
        let t = self.resolved(self.ty_of(x))
        var ty = Ty.error()
        if t == Ty.error():
            ty = Ty.error()
        elif op == UnOp.Not:
            ty = Ty.bool()
        elif op == UnOp.Neg and (t == Ty.int() or t == Ty.float()):
            ty = t
        elif op == UnOp.Neg and self.float_kind(cx, t).is_some():
            ty = t
        elif op == UnOp.BitNot and t == Ty.int():
            ty = Ty.int()
        elif op == UnOp.BitNot and self.int_kind(cx, t).is_some():
            ty = t
        else:
            let shown = self.show(cx, t)
            var d = self.error(cx, Msg.TypeUnaryOperator, range)
            d = d.with("op", op.text()).with("ty", shown)
            self.report(d)
        return self.add(TExprKind.Unary(op=op, operand=x), ty, range)

    pure def compare_expr(
        mut self, cx: Cx, first: ExprId, rest: list[(CmpOp, ExprId)], range: TextRange
    ) -> TExprId:
        let f0 = self.infer_expr(cx, first, None)
        var f = self.unrefined(cx, f0)
        var prev = f
        var out: list[(CmpOp, TExprId)] = []
        for (op, e) in rest:
            let pt = self.decay_ty(cx, self.ty_of(prev))
            let hint = if op == CmpOp.In or op == CmpOp.NotIn: None else: Some(pt)
            let x0 = self.infer_expr(cx, e, hint)
            var x = self.unrefined(cx, x0)
            # `x in xs` on a collection of a type's own is `xs.contains(x)`
            # by its `Contains` impl (02; decision 252).
            if len(rest) == 1 and (op == CmpOp.In or op == CmpOp.NotIn):
                if let Some(call) = self.contains_call(cx, prev, x, op == CmpOp.NotIn, range):
                    return call
            # Integers of two types compare as they add: the narrower widens
            # when that loses nothing (D-016; RULES.md, R43).
            if op != CmpOp.In and op != CmpOp.NotIn:
                if let Some(a) = self.int_kind(cx, self.ty_of(prev)):
                    if let Some(b) = self.int_kind(cx, self.ty_of(x)):
                        if a != b and widens(b, a):
                            x = self.wrap(x, Coercion.IntWiden, self.resolved(self.ty_of(prev)))
                        elif a != b and widens(a, b):
                            let to = self.resolved(self.ty_of(x))
                            prev = self.wrap(prev, Coercion.IntWiden, to)
                            match out.pop():
                                case Some((o, _)):
                                    out.push((o, prev))
                                case None:
                                    f = prev
            self.check_comparison(cx, op, prev, x, range)
            prev = x
            out.push((op, x))
        return self.add(TExprKind.Compare(first=f, rest=out), Ty.bool(), range)

    ## `x in xs` (`not in` with `negate`) on a type that is not a builtin
    ## collection or text: a call of its `Contains` method (02), when the
    ## type implements `Contains`. `None` leaves the builtin ones to the
    ## comparison.
    pure def contains_call(
        mut self, cx: Cx, x: TExprId, xs: TExprId, negate: bool, range: TextRange
    ) -> TExprId?:
        let tdef = cx.prog.wk.contains else:
            return None
        let cz = self.infer.zonk(
            mut self.types, self.types.strip_ref(self.resolved(self.ty_of(xs)))
        )
        let ct = cx.prog.normalize(mut self.types, cz, self.env)
        var builtin = False
        match self.types.data(ct):
            case TyData.Adt(d, _):
                builtin = (
                    Some(d) == cx.prog.wk.list
                        or Some(d) == cx.prog.wk.set
                        or Some(d) == cx.prog.wk.dict
                        or cx.prog.is_builtin(d, "Array")
                        or self.is_string(cx, ct)
                )
            case TyData.Str | TyData.Var(_) | TyData.Error:
                builtin = True
            case _:
                pass
        if builtin:
            return None
        let xz = self.infer.zonk(mut self.types, self.types.strip_ref(self.resolved(self.ty_of(x))))
        let xt = cx.prog.normalize(mut self.types, xz, self.env)
        let tr = TraitRef(def_=tdef, args=[xt])
        if cx.prog.implements(mut self.types, ct, tr, self.env) == Answer.No:
            return None
        let m = cx.prog.trait_method(tdef, "contains") else:
            return None
        let sig = self.instantiate(cx, m, None, range)
        if let Some(v) = sig.type_args.first():
            _ = self.infer.try_unify(mut self.types, v, ct)
        if len(sig.type_args) > 1:
            _ = self.infer.try_unify(mut self.types, sig.type_args[1], xt)
        let args = [self.contains_arg(xs), self.contains_arg(x)]
        let call = TExprKind.Call(
            callee=Callee.Fn(def_=m, type_args=sig.type_args.copy()), args=args
        )
        let made = self.add(call, Ty.bool(), range)
        if negate:
            return Some(self.add(TExprKind.Unary(op=UnOp.Not, operand=made), Ty.bool(), range))
        return Some(made)

    ## An operand of `contains_call`: a reference as it is, anything else
    ## borrowed.
    pure def contains_arg(self, e: TExprId) -> TArg:
        if let TyData.Ref(_, _) = self.types.data(self.resolved(self.ty_of(e))):
            return TArg(expr=e, mode=ArgMode.Value)
        return TArg(expr=e, mode=ArgMode.Ref)

    pure def strip_text(mut self, cx: Cx, t: Ty) -> Ty:
        let s = self.resolved(self.types.strip_ref(t))
        if self.is_string(cx, s):
            return Ty.str()
        return s

    pure def check_comparison(
        mut self, cx: Cx, op: CmpOp, l: TExprId, r: TExprId, range: TextRange
    ):
        let lt = self.infer.zonk(mut self.types, self.ty_of(l))
        let rt = self.infer.zonk(mut self.types, self.ty_of(r))
        if self.types.contains_error(lt) or self.types.contains_error(rt):
            return
        if op == CmpOp.In or op == CmpOp.NotIn:
            let container = self.resolved(self.types.strip_ref(rt))
            var elem: Ty? = None
            var keyed = False
            match self.types.data(container).copy():
                case TyData.Adt(d, a):
                    if Some(d) == cx.prog.wk.list
                            or Some(d) == cx.prog.wk.set
                            or cx.prog.is_builtin(d, "Array"):
                        elem = first_of(a)
                        keyed = Some(d) == cx.prog.wk.set
                    elif Some(d) == cx.prog.wk.dict:
                        elem = first_of(a)
                        keyed = True
                    elif self.is_string(cx, container):
                        elem = Some(Ty.str())
                case TyData.Str:
                    elem = Some(Ty.str())
                case _:
                    pass
            match elem:
                case Some(el):
                    let a = self.strip_text(cx, lt)
                    let b = self.strip_text(cx, el)
                    self.require(b, cx.prog.wk.eq, range)
                    if keyed:
                        self.require(b, cx.prog.wk.hash, range)
                    if not self.infer.try_unify(mut self.types, a, b):
                        let shown_l = self.show(cx, lt)
                        let shown_e = self.show(cx, el)
                        var d = self.error(cx, Msg.TypeComparisonTypes, range)
                        d = d.with("lhs", shown_l).with("rhs", shown_e)
                        # A character looked for in text, as Python's
                        # `c in "aeiou"`: text is looked for in text (R16).
                        if self.resolved(a) == Ty.char() and self.resolved(b) == Ty.str():
                            d = self.char_as_text_fix(cx, d, l)
                        self.report(d)
                case None:
                    let shown_l = self.show(cx, lt)
                    let shown_r = self.show(cx, rt)
                    var d = self.error(cx, Msg.TypeBinaryOperator, range)
                    d = d.with("op", op.text()).with("lhs", shown_l).with("rhs", shown_r)
                    self.report(d)
            return
        let a = self.strip_text(cx, lt)
        let b = self.strip_text(cx, rt)
        if not self.infer.try_unify(mut self.types, a, b):
            let shown_l = self.show(cx, lt)
            let shown_r = self.show(cx, rt)
            var d = self.error(cx, Msg.TypeComparisonTypes, range)
            d = d.with("lhs", shown_l).with("rhs", shown_r)
            # A `T ! E` compared with a `T`, as `ensures result > 0` of a
            # function that returns one (RULES.md, R77).
            let l_result = self.as_result(cx, a).is_some()
            if l_result != self.as_result(cx, b).is_some():
                d = d.note(Msg.TypeCompareResult)
            self.report(d)
            return
        if op == CmpOp.Lt or op == CmpOp.Le or op == CmpOp.Gt or op == CmpOp.Ge:
            let z = self.infer.zonk(mut self.types, a)
            let t = cx.prog.normalize(mut self.types, z, self.env)
            var ordered = True
            if let Some(def_) = cx.prog.wk.partial_ord:
                let tr = TraitRef(def_=def_, args=[])
                ordered = cx.prog.implements(mut self.types, t, tr, self.env) != Answer.No
            if not ordered:
                let shown = self.show(cx, t)
                var d = self.error(cx, Msg.TypeNotOrdered, range)
                d = d.with("ty", shown).with("op", op.text())
                if let TyData.Param(i) = self.types.data(t):
                    if let Some((name, edit)) = self.bound_edit(cx, i, "PartialOrd"):
                        let params = [
                            Param(name="param".to_string(), value=name),
                            Param(name="bound".to_string(), value="PartialOrd".to_string()),
                        ]
                        d = d.fix_params(Msg.TypeAddBound, params, [edit])
                if let Some(po) = cx.prog.wk.partial_ord:
                    d = self.derive_fix(cx, d, t, po)
                self.report(d)
        elif let TyData.Fn(_, _, _) = self.data(a):
            let shown_l = self.show(cx, lt)
            let shown_r = self.show(cx, rt)
            var d = self.error(cx, Msg.TypeComparisonTypes, range)
            d = d.with("lhs", shown_l).with("rhs", shown_r)
            self.report(d)
        else:
            self.require(a, cx.prog.wk.eq, range)

    pure def coalesce(
        mut self, cx: Cx, lhs: ExprId, rhs: ExprId, range: TextRange, expected: Ty?
    ) -> TExprId:
        # An open expected type (a generic call's parameter) says nothing
        # yet.
        var opt_hint: Ty? = None
        if let Some(t) = expected:
            if not is_var_data(self.data(t)):
                opt_hint = Some(self.option_of(cx, t))
        let reading = self.reading_coalesce
        self.reading_coalesce = False
        var o = self.infer_expr(cx, lhs, opt_hint)
        # In an interpolation, which only reads its value, an optional
        # `String` place before `??` is read as an optional `str` rather
        # than moved out of the place, `{b.note ?? "-"}` (RULES.md, R61).
        if reading and self.is_place(o):
            if let Some(t) = self.as_option(cx, self.ty_of(o)):
                if self.is_string(cx, self.resolved(t)):
                    o = self.read_option(cx, o, cx.ast.expr(lhs).range)
        let inner = self.as_option(cx, self.ty_of(o)) else:
            if self.ty_of(o) != Ty.error():
                let shown = self.show(cx, self.ty_of(o))
                var d = self.error(cx, Msg.TypeCoalesce, cx.ast.expr(lhs).range).with("ty", shown)
                # A result's value or a default is its `or` (RULES.md, R45).
                if self.as_result(cx, self.ty_of(o)).is_some():
                    let lr = cx.ast.expr(lhs).range
                    let rr = cx.ast.expr(rhs).range
                    if lr.end <= rr.start and rr.end <= cx.source.byte_len():
                        let edits = [
                            Edit(start=lr.end, end=rr.start, text=".or(".to_string()),
                            Edit(start=rr.end, end=rr.end, text=")".to_string()),
                        ]
                        d = d.fix_edits(Msg.TypeResultOr, edits)
                self.report(d)
            let r = self.infer_expr(cx, rhs, None)
            let kind = TExprKind.Coalesce(opt=o, default=r, deref=False)
            return self.add(kind, self.ty_of(r), range)
        let inner_r = self.resolved(inner)
        # `a ?? b ?? c`: an optional default keeps the option.
        let d = self.infer_expr(cx, rhs, Some(inner_r))
        if self.as_option(cx, self.ty_of(d)).is_some()
                and self.infer.try_unify(mut self.types, self.ty_of(d), self.ty_of(o)):
            let ty = self.ty_of(o)
            return self.add(TExprKind.Coalesce(opt=o, default=d, deref=False), ty, range)
        if let TyData.Ref(target, _) = self.types.data(inner_r).copy():
            if self.is_copy(cx, target):
                let dd = self.coerce(cx, d, target)
                return self.add(TExprKind.Coalesce(opt=o, default=dd, deref=True), target, range)
            if self.is_string(cx, target) and self.resolved(self.ty_of(d)) == Ty.str():
                let shown = self.show(cx, inner_r)
                let e = self.error(cx, Msg.TypeMismatch, cx.ast.expr(rhs).range)
                self.report(e.with("expected", shown).with("found", "str"))
                return self.error_expr(range)
        let dd = self.coerce(cx, d, inner_r)
        return self.add(TExprKind.Coalesce(opt=o, default=dd, deref=False), inner_r, range)

    # ---------------------------------------------------------------- collections

    ## The items a `for` loop over a value of type `ty` yields, and how.
    pub pure def iteration_item(mut self, cx: Cx, ty: Ty, mode: Mode) -> (Ty, ForMode)?:
        let t = self.resolved(self.types.strip_ref(self.resolved(ty)))
        if let Some((_, _, base)) = self.refinement_of(cx, t):
            var b = base
            if let TyData.Ref(_, m) = self.data(ty):
                b = self.types.ref_(base, m)
            return self.iteration_item(cx, b, mode)
        var behind_ref = False
        if let TyData.Ref(_, _) = self.data(ty):
            behind_ref = True
        let TyData.Adt(d, args) = self.types.data(t).copy() else:
            if t == Ty.error():
                return Some((Ty.error(), ForMode.Borrow))
            return self.iterator_item(cx, t)
        let fmode = match mode:
            case Mode.Borrow: ForMode.Borrow
            case Mode.Mut: ForMode.Mut
            case Mode.Own: ForMode.Own
        let b = cx.prog.builtin(d) ?? String.new()
        if b == "list" or b == "set" or b == "Array":
            let el = first_of(args) ?? Ty.error()
            let m = if behind_ref and fmode == ForMode.Own: ForMode.Borrow else: fmode
            return Some((self.wrap_item(el, m), m))
        if b == "dict":
            let k = first_of(args) ?? Ty.error()
            let v = if len(args) > 1: args[1] else: Ty.error()
            let m = if behind_ref and fmode == ForMode.Own: ForMode.Borrow else: fmode
            var item = Ty.error()
            match m:
                case ForMode.Own:
                    item = self.types.tuple([k, v])
                case ForMode.Mut:
                    let rk = self.types.ref_(k, False)
                    let rv = self.types.ref_(v, True)
                    item = self.types.tuple([rk, rv])
                case _:
                    let rk = self.types.ref_(k, False)
                    let rv = self.types.ref_(v, False)
                    item = self.types.tuple([rk, rv])
            return Some((item, m))
        if b == "Iter":
            return Some((first_of(args) ?? Ty.error(), ForMode.Iter))
        if b == "Receiver":
            return Some((first_of(args) ?? Ty.error(), ForMode.Borrow))
        return self.iterator_item(cx, t)

    pure def wrap_item(mut self, t: Ty, m: ForMode) -> Ty:
        return match m:
            case ForMode.Borrow: self.types.ref_(t, False)
            case ForMode.Mut: self.types.ref_(t, True)
            case _: t

    ## The item of a type that implements `Iterator`, which a `for` loop
    ## drives through the trait.
    pure def iterator_item(mut self, cx: Cx, t: Ty) -> (Ty, ForMode)?:
        let def_ = cx.prog.wk.iterator else:
            return None
        let tr = TraitRef(def_=def_, args=[])
        let z = self.infer.zonk(mut self.types, t)
        let n = cx.prog.normalize(mut self.types, z, self.env)
        if not cx.prog.implements(mut self.types, n, tr, self.env).holds():
            return None
        let item = self.types.intern(TyData.Assoc(self_ty=n, trait_=tr, name="Item".to_string()))
        return Some((cx.prog.normalize(mut self.types, item, self.env), ForMode.Trait))

    ## The iterable of a `for` loop or comprehension clause.
    pub pure def check_iterable(
        mut self, cx: Cx, iter: ExprId, mode: Mode
    ) -> (TExprId, ForMode, Ty):
        let x = self.infer_expr(cx, iter, None)
        return self.iterable_of(cx, x, cx.ast.expr(iter).range, mode)

    ## `bytes` and a `Slice` are iterated through their iterators: `x.iter()`
    ## for one, `x` itself for anything else (a `for` loop, and an argument
    ## for an `Iterable[T]` parameter, `sorted(xs)`; RULES.md, R61).
    pub pure def view_iter(mut self, cx: Cx, x: TExprId) -> TExprId:
        let base = self.resolved(self.types.strip_ref(self.ty_of(x)))
        if let TyData.Adt(d, a) = self.types.data(base).copy():
            if cx.prog.is_builtin(d, "bytes") or cx.prog.is_builtin(d, "Slice"):
                var item = Ty.error()
                if cx.prog.is_builtin(d, "bytes"):
                    item = self.sized_ty(cx, "u8")
                else:
                    item = self.types.ref_(first_of(a) ?? Ty.error(), False)
                var iter_ty = Ty.error()
                if let Some(i) = cx.prog.wk.iter:
                    iter_ty = self.types.adt(i, [item])
                if let Some(call) = self.builtin_call(cx, x, base, "iter", iter_ty):
                    return call
        return x

    ## How a `for` iterates the value `x` written at `range`.
    pub pure def iterable_of(
        mut self, cx: Cx, x_in: TExprId, range: TextRange, mode: Mode
    ) -> (TExprId, ForMode, Ty):
        var x = self.view_iter(cx, x_in)
        match self.iteration_item(cx, self.ty_of(x), mode):
            case Some((item, fmode)):
                match fmode:
                    case ForMode.Own | ForMode.Iter | ForMode.Trait:
                        x = self.check_movable(cx, x)
                    case ForMode.Mut:
                        self.require_mutable(cx, x, range)
                    case ForMode.Borrow:
                        pass
                return (x, fmode, item)
            case None:
                if not is_var_data(self.data(self.ty_of(x))):
                    let shown = self.show(cx, self.ty_of(x))
                    var d = self.error(cx, Msg.TypeNotIterable, range).with("ty", shown)
                    # Text is walked by its characters or its bytes (R16).
                    if self.is_text(cx, self.resolved(self.types.strip_ref(self.ty_of(x)))):
                        d = d.fix_at(Msg.TypeIterateChars, range.end, range.end, ".chars()")
                        d = d.fix_at(Msg.TypeIterateBytes, range.end, range.end, ".bytes()")
                    self.report(d)
                else:
                    let text = self.source_text(cx, range)
                    let d = self.error(cx, Msg.TypeCannotInfer, range).with("name", text)
                    self.report(d)
                return (x, ForMode.Borrow, Ty.error())

    pure def comprehension(
        mut self,
        cx: Cx,
        kind: CompKind,
        elem: ExprId,
        value: ExprId?,
        clauses: list[CompClause],
        range: TextRange,
    ) -> TExprId:
        # A generator expression is a lazy `Iter` (02; RULES.md, R42).
        if kind == CompKind.Gen:
            return self.generator_comprehension(cx, elem, clauses, range)
        self.push_scope()
        var out: list[TCompClause] = []
        for c in clauses:
            match c:
                case CompClause.For(pat, iter):
                    let (x, mode, item) = self.check_iterable(cx, iter, Mode.Borrow)
                    let p = self.check_pat(cx, pat, item, None)
                    out.push(TCompClause.For(pat=p, iter=x, mode=mode, item=item))
                case CompClause.If(e):
                    let cnd = self.check_condition_expr(cx, e)
                    out.push(TCompClause.If(cnd))
        let el0 = self.infer_expr(cx, elem, None)
        let el1 = self.decay(cx, el0)
        let el = self.check_movable(cx, el1)
        var val: TExprId? = None
        if let Some(v) = value:
            let x0 = self.infer_expr(cx, v, None)
            let x1 = self.decay(cx, x0)
            val = Some(self.check_movable(cx, x1))
        self.pop_scope()
        var tkind = TCompKind.List
        var ty = Ty.error()
        if kind == CompKind.Dict and val.is_some():
            tkind = TCompKind.Dict
            if let Some(d) = cx.prog.wk.dict:
                let vt = self.ty_of(val ?? el)
                ty = self.types.adt(d, [self.ty_of(el), vt])
        elif kind == CompKind.Set:
            tkind = TCompKind.Set
            if let Some(d) = cx.prog.wk.set:
                ty = self.types.adt(d, [self.ty_of(el)])
        else:
            ty = self.list_of(cx, self.ty_of(el))
        let k = TExprKind.Comprehension(kind=tkind, clauses=out, elem=el, value=val)
        return self.add(k, ty, range)

    ## A generator expression, `(f(x) for x in xs if c(x))` (02: a
    ## comprehension in parentheses is a lazy `Iter`; RULES.md, R42): the
    ## closure that runs the clauses as loops and tests around a `yield` of
    ## the element, task-like as a generator function's body is, whose
    ## value is the `Iter` that runs it. It borrows what it reads of the
    ## function's own, as a loop over it would, while the `Iter` lives, and
    ## copies what is `Copy`.
    pure def generator_comprehension(
        mut self, cx: Cx, elem: ExprId, clauses: list[CompClause], range: TextRange
    ) -> TExprId:
        # The first iterable is evaluated where the expression is, as
        # Python evaluates it (02; RULES.md, R49): a place, a name or a field
        # of one, the closure borrows as a loop over it would, and any other
        # value is computed here, into a local the generator keeps by value.
        var kept: (int, TExprId)? = None
        if let Some(CompClause.For(_, iter)) = clauses.first():
            if not names_place(cx.ast, iter, 0):
                let x0 = self.infer_expr(cx, iter, None)
                let x = self.decay(cx, x0)
                let h = self.new_local("(iterable)", self.ty_of(x), False, self.span_of(x))
                self.kept_iterables.push(h)
                kept = Some((h, x))
        let id = ClosureId(index=len(self.closures))
        self.closures.push(None)
        let first_local = len(self.locals)
        self.ret.push(
            RetCtx(ty=Ty.unit(), closure=Some(id), first_local=first_local, loops=0, captures=[])
        )
        self.push_scope()
        var shells: list[TCompClause] = []
        var k = 0
        for c in clauses:
            k += 1
            match c:
                case CompClause.For(pat, iter):
                    var checked: (TExprId, ForMode, Ty)? = None
                    if k == 1:
                        if let Some((h, x)) = kept:
                            let at = cx.ast.expr(iter).range
                            let held = self.add(TExprKind.Local(h), self.ty_of(x), self.span_of(x))
                            self.note_use(h, False)
                            checked = Some(self.iterable_of(cx, held, at, Mode.Borrow))
                    let (x, mode, item) = checked ?? self.check_iterable(cx, iter, Mode.Borrow)
                    let p = self.check_pat(cx, pat, item, None)
                    shells.push(TCompClause.For(pat=p, iter=x, mode=mode, item=item))
                case CompClause.If(e):
                    shells.push(TCompClause.If(self.check_condition_expr(cx, e)))
        let el0 = self.infer_expr(cx, elem, None)
        let el1 = self.decay(cx, el0)
        let el = self.check_movable(cx, el1)
        let item_ty = self.ty_of(el)
        let espan = self.span_of(el)
        var body = self.new_block([TStmt.Yield(value=el, span=espan)], espan)
        k = len(shells)
        while k > 0:
            k -= 1
            match shells[k].copy():
                case TCompClause.For(p, x, mode, item):
                    let st = TStmt.For(pat=p, iter=x, mode=mode, item=item, body=body, span=range)
                    body = self.new_block([st], range)
                case TCompClause.If(cnd):
                    let cond = TCond(parts=[TCondPart.Bool(cnd)])
                    let st = TStmt.If(branches=[(cond, body)], else_=None, span=range)
                    body = self.new_block([st], range)
        self.pop_scope()
        var captures: list[Capture] = []
        if let Some(ctx) = self.ret.pop():
            captures = ctx.captures
        let pure = self.first_impure_in_block(cx, body).is_none()
        let fn_ty = self.types.fn_([], Ty.unit(), pure)
        self.closures[id.index] = Some(
            TClosure(
                params=[],
                captures=captures,
                own_=False,
                ret=Ty.unit(),
                body=body,
                span=range,
                fn_ty=fn_ty,
                comptime_=False,
                role=ClosureRole.Task,
            )
        )
        var iter_ty = Ty.error()
        if let Some(it) = cx.prog.wk.iter:
            iter_ty = self.types.adt(it, [item_ty])
        let generator = self.add(TExprKind.Generator(id), iter_ty, range)
        let (h, x) = kept else:
            return generator
        # `match value: case kept: the generator`, which binds the value
        # the generator then keeps.
        let pat = self.add_pat(
            TPatKind.Bind(local=h, mode=BindMode.Value), self.ty_of(x), self.span_of(x)
        )
        let arm = TArm(pat=pat, guard=None, body=TArmBody.Expr(generator), span=range)
        return self.add(TExprKind.Match(scrutinee=x, arms=[arm]), iter_ty, range)

    # ---------------------------------------------------------------- if and match expressions

    ## A later branch of an `if` or `match`, checked against `ty`: the type
    ## expected of the whole, or with `first` the type of the first branch.
    pure def branch_expr(
        mut self, cx: Cx, e: ExprId, ty: Ty, first: (String, TextRange)?
    ) -> TExprId:
        if first.is_none():
            return self.check_expr(cx, e, ty)
        let x = self.infer_expr(cx, e, Some(ty))
        self.branch = first.copy()
        let y = self.coerce(cx, x, ty)
        self.branch = None
        return y

    pure def if_expr(
        mut self,
        cx: Cx,
        branches: list[(ExprId, ExprId)],
        else_: ExprId?,
        range: TextRange,
        expected: Ty?,
    ) -> TExprId:
        var target = expected
        var conds: list[TExprId] = []
        var values: list[TExprId] = []
        var all: list[ExprId] = []
        for (_, v) in branches:
            all.push(v)
        if let Some(e) = else_:
            all.push(e)
        for (c, _) in branches:
            conds.push(self.check_condition_expr(cx, c))
        # The branch whose type the later ones must have, when no type is
        # expected.
        var first: TextRange? = None
        for v in all:
            match target:
                case Some(t):
                    var keyed: (String, TextRange)? = None
                    if let Some(r) = first:
                        keyed = Some(("if".to_string(), r))
                    values.push(self.branch_expr(cx, v, t, keyed))
                case None:
                    let y = self.infer_expr(cx, v, None)
                    let x = self.decay(cx, y)
                    if self.resolved(self.ty_of(x)) != Ty.never():
                        target = Some(self.ty_of(x))
                        first = Some(cx.ast.expr(v).range)
                    values.push(x)
        let ty = target ?? Ty.never()
        # Build the chain from the end: `if c1: v1 elif c2: v2 else: v3`.
        var acc = TExprId(index=0)
        var k = len(branches) - 1
        if else_.is_some():
            acc = values[len(values) - 1]
        else:
            acc = self.error_expr(range)
        while k >= 0:
            let v = self.coerce(cx, values[k], ty)
            acc = self.add(TExprKind.If(cond=conds[k], then=v, else_=acc), ty, range)
            k -= 1
        return acc

    pure def match_expr(
        mut self, cx: Cx, scrutinee: ExprId, arms: list[Arm], rng: TextRange, expected: Ty?
    ) -> TExprId:
        let scrutinee_end = cx.ast.expr(scrutinee).range.end
        let s = self.infer_expr(cx, scrutinee, None)
        let by_ref = self.scrutinee_by_ref(s)
        let sty = self.ty_of(s)
        var target = expected
        var first: TextRange? = None
        var out: list[TArm] = []
        for a in arms:
            if self.arm_made_at_compile_time(cx, a):
                continue
            self.push_scope()
            let p = self.check_pat(cx, a.pat, sty, by_ref)
            var guard: TExprId? = None
            if let Some(g) = a.guard:
                guard = Some(self.check_condition_expr(cx, g))
            var body = TArmBody.Expr(TExprId(index=0))
            match a.body:
                case ArmBody.Expr(e):
                    match target:
                        case Some(t):
                            var keyed: (String, TextRange)? = None
                            if let Some(r) = first:
                                keyed = Some(("match".to_string(), r))
                            body = TArmBody.Expr(self.branch_expr(cx, e, t, keyed))
                        case None:
                            let y = self.infer_expr(cx, e, None)
                            let x = self.decay(cx, y)
                            if self.resolved(self.ty_of(x)) != Ty.never():
                                target = Some(self.ty_of(x))
                                first = Some(cx.ast.expr(e).range)
                            body = TArmBody.Expr(x)
                case ArmBody.Block(b):
                    let d = self.error(cx, Msg.TypeArmNeedsExpression, b.range)
                    self.report(d)
                    body = TArmBody.Block(self.check_block(cx, b))
            self.pop_scope()
            out.push(TArm(pat=p, guard=guard, body=body, span=a.range))
        let ty = target ?? Ty.never()
        for i in range(len(out)):
            if let TArmBody.Expr(x) = out[i].body:
                let y = self.coerce(cx, x, ty)
                out[i].body = TArmBody.Expr(y)
        self.check_exhaustive(cx, sty, out, TextRange.new(rng.start, scrutinee_end))
        return self.add(TExprKind.Match(scrutinee=s, arms=out), ty, rng)

    ## Arms made by `comptime for` or `comptime if` exist only in a
    ## derive's template and in a template (08); anywhere else they are
    ## reported.
    pure def arm_made_at_compile_time(mut self, cx: Cx, a: Arm) -> bool:
        if a.generated.is_none():
            return False
        self.no_unfolding(cx, a.range, "arms made at compile time")
        return True

    ## A `match` in statement position: arms may hold blocks.
    pub pure def check_match_stmt(
        mut self, cx: Cx, scrutinee: ExprId, arms: list[Arm], range: TextRange
    ) -> TStmt:
        let s = self.infer_expr(cx, scrutinee, None)
        let by_ref = self.scrutinee_by_ref(s)
        let sty = self.ty_of(s)
        var out: list[TArm] = []
        for a in arms:
            if self.arm_made_at_compile_time(cx, a):
                continue
            self.push_scope()
            let p = self.check_pat(cx, a.pat, sty, by_ref)
            var guard: TExprId? = None
            if let Some(g) = a.guard:
                guard = Some(self.check_condition_expr(cx, g))
            var body = TArmBody.Expr(TExprId(index=0))
            match a.body:
                case ArmBody.Expr(e):
                    body = TArmBody.Expr(self.infer_expr(cx, e, None))
                case ArmBody.Block(b):
                    body = TArmBody.Block(self.check_block(cx, b))
            self.pop_scope()
            out.push(TArm(pat=p, guard=guard, body=body, span=a.range))
        let end = cx.ast.expr(scrutinee).range.end
        self.check_exhaustive(cx, sty, out, TextRange.new(range.start, end))
        return TStmt.Match(scrutinee=s, arms=out, span=range)

    ## How a scrutinee's bindings take their parts: a place is borrowed
    ## (`Some(False)`), a temporary is moved (`None`).
    pub pure def scrutinee_by_ref(self, s: TExprId) -> bool?:
        if self.is_place(s):
            return Some(False)
        return None

    # ---------------------------------------------------------------- closures

    ## Checks a closure literal or `do` block against an expected function
    ## type, if one is known.
    pub pure def check_closure(mut self, cx: Cx, c: Closure, expected: Ty?) -> TExprId:
        var names: list[ClosureParamSrc] = []
        if c.implicit_param:
            if let Some(f) = expected:
                if let TyData.Fn(ps, _, _) = self.types.data(f):
                    if len(ps) == 1:
                        names.push(ClosureParamSrc(name="it".to_string(), ty=None, range=c.range))
        else:
            for p in c.params:
                names.push(ClosureParamSrc(name=p.name.text.copy(), ty=p.ty, range=p.name.range))
        var body = ClosureSource.Expr(ExprId(index=0))
        match c.body:
            case ClosureBody.Expr(e):
                body = ClosureSource.Expr(e)
            case ClosureBody.Block(b):
                body = ClosureSource.Block(b.copy())
        let x = self.closure_from_parts(cx, names, body, expected, c.range)
        if c.own_:
            if let TExprKind.Closure(id) = self.exprs[x.index].kind:
                self.own_closure(id, c.range)
        return x

    ## `comptime e` (08): `e` is checked as the body of a closure that takes
    ## nothing, which must capture nothing and name none of the function's
    ## type parameters.
    pub pure def comptime_expr(
        mut self, cx: Cx, inner: ExprId, expected: Ty?, range: TextRange
    ) -> TExprId:
        var ret = Ty.error()
        match expected:
            case Some(t):
                ret = t
            case None:
                ret = self.infer.fresh(mut self.types)
        let fn_ty = self.types.fn_([], ret, True)
        let was = self.in_comptime
        self.in_comptime = True
        let x = self.closure_from_parts(cx, [], ClosureSource.Expr(inner), Some(fn_ty), range)
        self.in_comptime = was
        let TExprKind.Closure(id) = self.exprs[x.index].kind else:
            return self.error_expr(range)
        self.comptime_closure(cx, id, range)
        return self.add(TExprKind.Comptime(id), ret, range)

    ## `comptime assert c, m` and other statements run at compile time: a
    ## `comptime` closure whose body is the statement.
    pub pure def comptime_block(mut self, cx: Cx, b: Block, range: TextRange) -> TExprId:
        let fn_ty = self.types.fn_([], Ty.unit(), True)
        let was = self.in_comptime
        self.in_comptime = True
        let x = self.closure_from_parts(cx, [], ClosureSource.Block(b.copy()), Some(fn_ty), range)
        self.in_comptime = was
        let TExprKind.Closure(id) = self.exprs[x.index].kind else:
            return self.error_expr(range)
        self.comptime_closure(cx, id, range)
        return self.add(TExprKind.Comptime(id), Ty.unit(), range)

    pure def comptime_closure(mut self, cx: Cx, id: ClosureId, range: TextRange):
        var names: list[String] = []
        if let Some(cl) = self.closures[id.index]:
            for cap in cl.captures:
                let n = self.locals[cap.local].name.copy()
                if not names.contains(n):
                    names.push(n)
        for n in names:
            self.report_other(self.error(cx, Msg.ComptimeNotConstant, range).with("name", n))
        if let Some(cl) = ref mut self.closures[id.index]:
            cl.comptime_ = True
        self.comptime_sites.push((id, range))

    ## An `own` closure keeps what it captures (04, "Closures").
    pure def own_closure(mut self, id: ClosureId, range: TextRange):
        if let Some(cl) = ref mut self.closures[id.index]:
            cl.own_ = True
        self.own_checks.push((id, range))

    ## The captures of `own` closures: a task's are moved in; any other
    ## `own` closure copies them, so each must be `Copy`, and it cannot
    ## change one.
    pub pure def check_own_closures(mut self, cx: Cx):
        let checks = self.own_checks.copy()
        self.own_checks = []
        for (id, range) in checks:
            var caps: list[Capture2] = []
            var task = False
            if let Some(cl) = self.closures[id.index]:
                task = cl.role == ClosureRole.Task
                for cap in cl.captures:
                    caps.push(Capture2(local=cap.local, mutable=cap.mutable))
            if task:
                continue
            for cap in caps:
                let name = self.locals[cap.local].name.copy()
                let ty = self.locals[cap.local].ty
                if cap.mutable:
                    let d = self.error(cx, Msg.TypeOwnClosureChanges, range).with("name", name)
                    self.report(d.note(Msg.TypePlainClosure))
                elif not self.is_copy(cx, ty) and self.infer.zonk(mut self.types, ty) != Ty.error():
                    let shown = self.show(cx, ty)
                    let d = self.error(cx, Msg.TypeOwnClosureCapture, range).with(
                        "name", name
                    ).with("ty", shown)
                    # A copy made first is no `Copy` value either: the plain
                    # closure is the way (RULES.md, R45).
                    self.report(d.note_with(Msg.TypeCaptureBorrow, "name", name))

    pub pure def closure_from_parts(
        mut self,
        cx: Cx,
        names: list[ClosureParamSrc],
        body: ClosureSource,
        expected: Ty?,
        rng: TextRange,
    ) -> TExprId:
        var expected_params: list[Ty]? = None
        var expected_ret: Ty? = None
        if let Some(f) = expected:
            if let TyData.Fn(ps, r, _) = self.types.data(f):
                expected_params = Some(ps.copy())
                expected_ret = Some(r)
        if let Some(ps) = expected_params:
            if len(ps) != len(names):
                var d = self.error(cx, Msg.TypeClosureParameterCount, rng)
                d = d.with("found", "{len(names)}").with("expected", "{len(ps)}")
                self.report(d)
        let id = ClosureId(index=len(self.closures))
        self.closures.push(None)
        let ret = expected_ret ?? self.infer.fresh(mut self.types)
        let first_local = len(self.locals)
        self.ret.push(
            RetCtx(ty=ret, closure=Some(id), first_local=first_local, loops=0, captures=[])
        )
        self.push_scope()
        var params: list[int] = []
        var ptys: list[Ty] = []
        for i in range(len(names)):
            let p = ref names[i]
            var ty = Ty.error()
            match p.ty:
                case Some(t):
                    ty = self.resolve_ty(cx, t)
                case None:
                    var given: Ty? = None
                    if let Some(ps) = expected_params:
                        if i < len(ps):
                            given = Some(ps[i])
                    ty = given ?? self.infer.fresh(mut self.types)
            let l = self.new_local(p.name, ty, False, p.range)
            self.declare(cx, p.name, l, False, p.range)
            params.push(l)
            ptys.push(ty)
        var block = BlockId(index=0)
        match body:
            case ClosureSource.Expr(e):
                let x0 = self.check_expr(cx, e, ret)
                let x = self.check_movable(cx, x0)
                let er = cx.ast.expr(e).range
                block = self.new_block([TStmt.Return(value=Some(x), span=er)], er)
            case ClosureSource.Block(b):
                block = self.check_block_in_scope(cx, b)
                let r = self.resolved(ret)
                if is_var_data(self.types.data(r)):
                    _ = self.infer.unify(mut self.types, r, Ty.unit())
                elif r != Ty.unit() and r != Ty.error() and not self.block_diverges(block):
                    let shown = self.show(cx, r)
                    var d = self.error(cx, Msg.TypeMissingReturn, b.range)
                    d = d.with("name", "this closure").with("ty", shown)
                    self.report(d)
        self.pop_scope()
        var captures: list[Capture] = []
        if let Some(ctx) = self.ret.pop():
            captures = ctx.captures
        let pure = self.first_impure_in_block(cx, block).is_none()
        let fn_ty = self.types.fn_(ptys, ret, pure)
        self.closures[id.index] = Some(
            TClosure(
                params=params,
                captures=captures,
                own_=False,
                ret=ret,
                body=block,
                span=rng,
                fn_ty=fn_ty,
                comptime_=False,
                role=ClosureRole.Plain,
            )
        )
        return self.add(TExprKind.Closure(id), fn_ty, rng)

    # ---------------------------------------------------------------- `?`, `?.`

    pure def try_expr(mut self, cx: Cx, inner: ExprId, range: TextRange) -> TExprId:
        let x = self.infer_expr(cx, inner, None)
        if self.ty_of(x) == Ty.error():
            return self.error_expr(range)
        let ret = self.ret_ty()
        # A closure whose result is not known yet returns what `?` needs:
        # an option for an option, a result for a result.
        if is_var_data(self.data(ret)) and not self.infer.is_absorbing(self.types, ret):
            var shape: Ty? = None
            if self.as_option(cx, self.ty_of(x)).is_some():
                if let Some(o) = cx.prog.wk.option:
                    let v = self.infer.fresh(mut self.types)
                    shape = Some(self.types.adt(o, [v]))
            elif self.as_result(cx, self.ty_of(x)).is_some():
                if let Some(r) = cx.prog.wk.result:
                    let v1 = self.infer.fresh(mut self.types)
                    let v2 = self.infer.fresh(mut self.types)
                    shape = Some(self.types.adt(r, [v1, v2]))
            if let Some(s) = shape:
                _ = self.infer.unify(mut self.types, ret, s)
        if let Some(t) = self.as_option(cx, self.ty_of(x)):
            if self.as_option(cx, ret).is_none() and self.resolved(ret) != Ty.error():
                let shown = self.show(cx, self.ty_of(x))
                let shown_ret = self.show(cx, ret)
                var d = self.error(cx, Msg.TypeTryContext, range)
                d = d.with("ty", shown).with("needed", "T?").with("found", shown_ret)
                self.report(d)
            return self.add(TExprKind.Try(expr=x, kind=TryKind.Option), t, range)
        if let Some((t, e)) = self.as_result(cx, self.ty_of(x)):
            let parts = self.as_result(cx, ret) else:
                if self.resolved(ret) != Ty.error():
                    let shown = self.show(cx, self.ty_of(x))
                    let shown_ret = self.show(cx, ret)
                    var d = self.error(cx, Msg.TypeTryContext, range)
                    d = d.with("ty", shown).with("needed", "T ! E").with("found", shown_ret)
                    d = self.return_errors_fix(cx, d, e)
                    self.report(d)
                return self.add(
                    TExprKind.Try(expr=x, kind=TryKind.Result(from_=[], to=[])), t, range
                )
            let (_, fe) = parts
            var from_: list[DefId] = []
            if let TyData.ErrSet(m) = self.data(e):
                from_ = m.copy()
            if self.infer.is_absorbing(self.types, fe):
                let set = self.types.err_set(from_.copy())
                _ = self.infer.unify(mut self.types, fe, set)
                let k = TryKind.Result(from_=from_.copy(), to=from_.copy())
                return self.add(TExprKind.Try(expr=x, kind=k), t, range)
            var to: list[DefId] = []
            match self.data(fe):
                case TyData.ErrSet(m):
                    to = m.copy()
                case TyData.Var(_):
                    let set = self.types.err_set(from_.copy())
                    _ = self.infer.unify(mut self.types, fe, set)
                    to = from_.copy()
                case _:
                    pass
            if not is_subset(from_, to):
                let d = self.error_not_in_set(cx, range, from_, to)
                self.report(d)
            return self.add(
                TExprKind.Try(expr=x, kind=TryKind.Result(from_=from_, to=to)), t, range
            )
        let shown = self.show(cx, self.ty_of(x))
        let d = self.error(cx, Msg.TypeTryNeedsFallible, range).with("ty", shown)
        self.report(d)
        return self.error_expr(range)

    ## A character written as text: a literal's own text in double quotes,
    ## anything else interpolated.
    pure def char_as_text_fix(self, cx: Cx, own d: Diagnostic, x: TExprId) -> Diagnostic:
        let r = self.span_of(x)
        if r.start < 0 or r.end > cx.source.byte_len() or r.start >= r.end:
            return d
        let written = cx.source.byte_slice(r.start, r.end)
        var text = "\"{{{written}}}\""
        if written.starts_with("'") and written.ends_with("'") and written.byte_len() >= 3:
            let inner = written.byte_slice(1, written.byte_len() - 1)
            if inner != "\"" and inner != "{{" and inner != "}}":
                text = "\"{inner}\""
        return d.fix_at(Msg.TypeCharAsText, r.start, r.end, text)

    ## The fix of `?` on a result in a function that returns nothing,
    ## written without a result type (R16): it returns `! E`, the operand's
    ## error set (`!` when that is not known), and `Ok(())` at its end.
    pure def return_errors_fix(mut self, cx: Cx, own d: Diagnostic, e: Ty) -> Diagnostic:
        if len(self.ret) != 1 or self.resolved(self.ret_ty()) != Ty.unit():
            return d
        let f = cx.prog.fn_info(self.def_) else:
            return d
        if f.ret_span.is_some() or f.header_broken:
            return d
        let body = f.body.copy() else:
            return d
        let last = body.stmts.last() else:
            return d
        let text = cx.source
        let name = cx.prog.defs[self.def_.index].span
        let header = params_end(text, name.end) else:
            return d
        var set = "!".to_string()
        let shown = self.show(cx, e)
        if not shown.contains("unknown") and not shown.contains("?"):
            set = "! {shown}"
        # The body's last line, and the indentation of its first.
        let first_stmt = cx.ast.stmt(body.stmts[0]).range.start
        var indent_at = first_stmt
        while indent_at > 0 and text.byte_at(indent_at - 1) == 32:
            indent_at -= 1
        let indent = text.byte_slice(indent_at, first_stmt)
        var end = cx.ast.stmt(last).range.end
        while end > 0 and is_blank(text.byte_at(end - 1)):
            end -= 1
        while end < text.byte_len() and text.byte_at(end) != 10:
            end += 1
        var returned = Edit(start=end, end=end, text="\n{indent}return Ok(())".to_string())
        if end < text.byte_len():
            returned = Edit(start=end + 1, end=end + 1, text="{indent}return Ok(())\n".to_string())
        let written = Edit(start=header, end=header, text=" -> {set}".to_string())
        let n = Param(name="name".to_string(), value=cx.prog.defs[self.def_.index].name.copy())
        return d.fix_params(Msg.TypeReturnErrors, [n], [written, returned])

    ## `base?.name` and `base?.name(args)`.
    pub pure def opt_chain(
        mut self,
        cx: Cx,
        base: ExprId,
        name: Name,
        args: list[Arg]?,
        trailing: Closure?,
        range: TextRange,
    ) -> TExprId:
        # In an interpolation the chain only reads what it reaches through
        # a place, as `{u.name}` reads the field (RULES.md, R14).
        let reading = self.reading_chain and args.is_none()
        self.reading_chain = False
        if reading:
            return self.reading_chain_of(cx, base, name, range)
        let b = self.infer_expr(cx, base, None)
        return self.opt_chain_on(cx, b, cx.ast.expr(base).range, name, args, trailing, range)

    ## `b?.name` and `b?.name(args)` for a typed base `b`, written at
    ## `base_range`.
    pure def opt_chain_on(
        mut self,
        cx: Cx,
        b: TExprId,
        base_range: TextRange,
        name: Name,
        args: list[Arg]?,
        trailing: Closure?,
        range: TextRange,
    ) -> TExprId:
        let inner = self.as_option(cx, self.ty_of(b)) else:
            if self.ty_of(b) != Ty.error():
                let shown = self.show(cx, self.ty_of(b))
                var d = self.error(cx, Msg.TypeOptionalChain, base_range).with("ty", shown)
                # Rust's `read(path)?.lines()`: `?.` is one token here, and a
                # result is passed on first (RULES.md, R45).
                if self.as_result(cx, self.ty_of(b)).is_some():
                    d = d.note(Msg.TypeQuestionDot)
                self.report(d)
            return self.error_expr(range)
        self.push_scope()
        let binder = self.new_local("?", inner, False, self.span_of(b))
        let recv = self.add(TExprKind.Local(binder), inner, self.span_of(b))
        var then = TExprId(index=0)
        match args:
            case None:
                then = self.field_of(cx, recv, name, range)
            case Some(a):
                then = self.method_call_on(cx, recv, name, a, trailing, range, None)
        self.pop_scope()
        then = self.decay(cx, then)
        # Through a reference, a field that is not `Copy` cannot be moved
        # out: the chain borrows it, a `String` as a `str` view.
        if self.is_place(then)
                and self.is_behind_ref(then)
                and not self.is_copy(cx, self.ty_of(then)):
            then = self.read_place(cx, then)
        return self.chain_of(cx, b, binder, then, range)

    ## The chain over `b` that binds `binder` and gives `then`: `Some` of
    ## it, or `then` itself when it is optional.
    pure def chain_of(
        mut self, cx: Cx, b: TExprId, binder: int, then: TExprId, range: TextRange
    ) -> TExprId:
        let flatten = self.as_option(cx, self.ty_of(then)).is_some()
        var ty = self.ty_of(then)
        if not flatten:
            ty = self.option_of(cx, self.ty_of(then))
        let k = TExprKind.OptChain(base=b, binder=binder, then=then, flatten=flatten)
        return self.add(k, ty, range)

    ## A place read rather than moved: a `String` as a `str` view, another
    ## type borrowed.
    pure def read_place(mut self, cx: Cx, then: TExprId) -> TExprId:
        let ty = self.resolved(self.ty_of(then))
        if self.is_string(cx, ty):
            return self.wrap(then, Coercion.StrView, Ty.str())
        if ty == Ty.error():
            return then
        let span = self.span_of(then)
        let rt = self.types.ref_(ty, False)
        return self.add(TExprKind.Borrow(place=then, mutable=False), rt, span)

    ## An interpolation's chain of fields, `x?.a?.b` (R14): over a place
    ## `x`, each link reads the field in place (`x?.(a?.b)`), and the last
    ## one's value, when it is not `Copy`, is read too; an optional last
    ## field gives its value read, `Option[ref T]`. Over a value, the links
    ## are the plain chain's.
    pure def reading_chain_of(
        mut self, cx: Cx, base: ExprId, name: Name, whole: TextRange
    ) -> TExprId:
        var names = [name.copy()]
        var ranges = [whole]
        var root = base
        while True:
            if let ExprKind.OptField(inner, n) = cx.ast.expr(root).kind:
                names.push(n.copy())
                ranges.push(cx.ast.expr(root).range)
                root = inner
            else:
                break
        names.reverse()
        ranges.reverse()
        let b = self.infer_expr(cx, root, None)
        let root_range = cx.ast.expr(root).range
        if self.is_place(b) and self.as_option(cx, self.ty_of(b)).is_some():
            return self.reading_link(cx, b, root_range, names, ranges, 0)
        var cur = b
        var at = root_range
        for i in range(len(names)):
            cur = self.opt_chain_on(cx, cur, at, names[i], None, None, ranges[i])
            at = ranges[i]
        return cur

    ## The links of a reading chain from the `i`th, over the optional place
    ## `p`.
    pure def reading_link(
        mut self,
        cx: Cx,
        p: TExprId,
        p_range: TextRange,
        names: list[Name],
        ranges: list[TextRange],
        i: int,
    ) -> TExprId:
        let inner = self.as_option(cx, self.ty_of(p)) else:
            return self.opt_chain_on(cx, p, p_range, names[i], None, None, ranges[i])
        self.push_scope()
        let binder = self.new_local("?", inner, False, self.span_of(p))
        let recv = self.add(TExprKind.Local(binder), inner, self.span_of(p))
        let field = self.field_of(cx, recv, names[i], ranges[i])
        var then = self.decay(cx, field)
        let optional = self.as_option(cx, self.ty_of(then)).is_some()
        if i + 1 < len(names):
            if self.is_place(then) and optional:
                then = self.reading_link(cx, then, ranges[i], names, ranges, i + 1)
            else:
                for k in range(i + 1, len(names)):
                    then = self.opt_chain_on(
                        cx, then, ranges[k - 1], names[k], None, None, ranges[k]
                    )
        elif self.is_place(then) and not self.is_copy(cx, self.ty_of(then)):
            if optional:
                then = self.read_option(cx, then, ranges[i])
            else:
                then = self.read_place(cx, then)
        self.pop_scope()
        return self.chain_of(cx, p, binder, then, ranges[i])

    ## An optional place read as an optional reference to its value.
    pure def read_option(mut self, cx: Cx, p: TExprId, range: TextRange) -> TExprId:
        let inner = self.as_option(cx, self.ty_of(p)) else:
            return p
        self.push_scope()
        let binder = self.new_local("?", inner, False, self.span_of(p))
        var then = self.add(TExprKind.Local(binder), inner, self.span_of(p))
        if not self.is_copy(cx, inner):
            then = self.read_place(cx, then)
        self.pop_scope()
        return self.chain_of(cx, p, binder, then, range)

    # ---------------------------------------------------------------- fields and indexing

    pure def field_expr(mut self, cx: Cx, base: ExprId, name: Name, range: TextRange) -> TExprId:
        # `module.item`, `Type.Variant`, `Type.function`.
        if let Some(path) = self.static_path(cx, base):
            return self.static_member(cx, path, name, range, None, None, None)
        let b = self.infer_expr(cx, base, None)
        return self.field_of(cx, b, name, range)

    ## Field `name` of a value (through references).
    pub pure def field_of(mut self, cx: Cx, b0: TExprId, name: Name, at: TextRange) -> TExprId:
        let b1 = self.auto_deref(b0)
        var b = self.unrefined(cx, b1)
        # A `Box` lends its fields to its value: `boxed` is its own. So does
        # a `Shared`, and a mutex guard's `value` is the value.
        var looping = True
        while looping:
            looping = False
            if self.is_box(cx, self.ty_of(b)) and name.text != "boxed":
                b = self.unbox(b)
                b = self.auto_deref(b)
                looping = True
                continue
            match self.smart_pointer(cx, self.ty_of(b)):
                case Some(p):
                    let guard = p == "MutexGuard" or p == "ReadGuard"
                    if guard and name.text == "value":
                        return self.deref_smart(b)
                    b = self.deref_smart(b)
                    b = self.auto_deref(b)
                    looping = True
                case None:
                    pass
        let t = self.resolved(self.ty_of(b))
        match self.types.data(t).copy():
            case TyData.Error:
                return self.error_expr(at)
            case TyData.Tuple(elems, labels):
                var idx: int? = None
                if let Some(n) = name.text.parse_int():
                    if n >= 0 and is_all_digits(name.text):
                        idx = Some(n)
                if idx.is_none():
                    for i in range(len(labels)):
                        if labels[i] == name.text and idx.is_none():
                            idx = Some(i)
                if let Some(i) = idx:
                    if i < len(elems):
                        return self.add(TExprKind.Field(base=b, index=i), elems[i], at)
                let shown = self.show(cx, t)
                var d = self.error(cx, Msg.TypeTupleIndex, name.range)
                d = d.with("ty", shown).with("index", name.text)
                self.report(d)
                return self.error_expr(at)
            case TyData.Adt(d, args):
                if let Some(s) = cx.prog.struct_info(d):
                    for i in range(len(s.fields)):
                        if s.fields[i].name == name.text:
                            self.check_field_vis(cx, d, i, name.range)
                            let ty = self.types.subst(s.fields[i].ty, args)
                            return self.add(TExprKind.Field(base=b, index=i), ty, at)
            case TyData.Var(_):
                let text = self.source_text(cx, self.span_of(b))
                let d = self.error(cx, Msg.TypeCannotInfer, self.span_of(b)).with("name", text)
                self.report(d)
                return self.error_expr(at)
            case _:
                pass
        if let Some(key) = self.types.key(t):
            var method = cx.prog.method(key, name.text).is_some()
            if not method and self.is_string(cx, t):
                method = cx.prog.method(TyKey.Str, name.text).is_some()
            if method:
                var d = self.error(cx, Msg.TypeMethodNeedsReceiver, name.range)
                d = d.with("name", name.text)
                self.report(d)
                return self.error_expr(at)
        let shown = self.show(cx, t)
        var d = self.error(cx, Msg.TypeUnknownField, name.range)
        d = d.with("ty", shown).with("name", name.text)
        if let Some(similar) = self.similar_member(cx, t, name.text):
            d = d.fix_at(Msg.TypeSimilarMember, name.range.start, name.range.end, similar)
        self.report(d)
        return self.error_expr(at)

    ## The edit that bounds the function's own type parameter `i` by `bound`
    ## in its header (`[T]` becomes `[T: Ord]`, `[T: Hash]` becomes
    ## `[T: Hash + Ord]`); `None` for an impl's parameter or a header that
    ## does not read as expected.
    pub pure def bound_edit(self, cx: Cx, i: int, bound: str) -> (String, Edit)?:
        let f = cx.prog.fn_info(self.def_) else:
            return None
        if i < f.impl_generics or i >= len(f.generics):
            return None
        let name = f.generics[i].name.copy()
        let after = cx.prog.defs[self.def_.index].span.end
        if after >= cx.source.byte_len() or cx.source.byte_at(after) != 91:
            return None
        # The parameter list, split at its top-level commas.
        var depth = 0
        var seg_start = after + 1
        var segments: list[(int, int)] = []
        var k = after
        let n = cx.source.byte_len()
        var done = False
        while k < n and not done:
            let c = cx.source.byte_at(k)
            if c == 91 or c == 40:
                depth += 1
            elif c == 93 or c == 41:
                depth -= 1
                if depth == 0:
                    segments.push((seg_start, k))
                    done = True
            elif c == 44 and depth == 1:
                segments.push((seg_start, k))
                seg_start = k + 1
            k += 1
        for (a, b) in segments:
            let seg = cx.source.byte_slice(a, b)
            let trimmed = seg.trim_start()
            let lead = seg.byte_len() - trimmed.byte_len()
            let word = leading_word(trimmed)
            if word != name:
                continue
            let name_end = a + lead + word.byte_len()
            match seg.find(":"):
                case None:
                    return Some((name.copy(), Edit(start=name_end, end=name_end, text=": {bound}")))
                case Some(_):
                    # After the last bound, before a default.
                    var end = b
                    if let Some(eq) = seg.find("="):
                        end = a + eq
                    let text = cx.source.byte_slice(a, end)
                    let at = a + text.trim_end().byte_len()
                    return Some((name.copy(), Edit(start=at, end=at, text=" + {bound}")))
        return None

    ## The field or method of a type closest to a misspelt one.
    pub pure def similar_member(self, cx: Cx, t: Ty, n: str) -> String?:
        var names: list[String] = []
        if let TyData.Adt(d, _) = self.types.data(t):
            if let Some(s) = cx.prog.struct_info(d):
                for f in s.fields:
                    names.push(f.name.copy())
        var keys: list[TyKey] = []
        if let Some(k) = self.types.key(t):
            keys.push(k)
        if self.is_string(cx, t):
            keys.push(TyKey.Str)
        for (k, _) in cx.prog.methods:
            if keys.contains(k.0) and not k.1.starts_with("_"):
                names.push(k.1.copy())
        return cx.prog.closest(n, names)

    ## A field of a struct of another module is reached only when it is
    ## `pub` (09).
    pub pure def check_field_vis(mut self, cx: Cx, d: DefId, i: int, range: TextRange):
        let s = cx.prog.struct_info(d) else:
            return
        if i >= len(s.fields):
            return
        let home = cx.prog.defs[d.index].module
        if not cx.prog.vis_allows(s.fields[i].vis, home, self.module):
            var diag = self.error(cx, Msg.ResolvePrivateField, range).with(
                "field", s.fields[i].name
            )
            diag = diag.with("ty", cx.prog.defs[d.index].name).with(
                "module", cx.prog.module_path(home)
            )
            self.report_other(diag)

    ## A method or associated function of a type of another module is
    ## called only when it is `pub` (09); a trait's methods are as visible
    ## as the trait.
    pub pure def check_method_vis(mut self, cx: Cx, m: DefId, range: TextRange):
        let f = cx.prog.fn_info(m) else:
            return
        if f.trait_.is_some() or f.impl_.is_some() or cx.prog.visible_from(m, self.module):
            return
        var owner = String.new()
        if let Some(o) = f.owner:
            owner = cx.prog.display(self.types, o)
        let home = cx.prog.defs[m.index].module
        var diag = self.error(cx, Msg.ResolvePrivateMethod, range).with(
            "name", cx.prog.defs[m.index].name
        )
        diag = diag.with("ty", owner).with("module", cx.prog.module_path(home))
        self.report_other(diag)

    ## A bound of a list's slice, an `int`, and whether it is written `^k`,
    ## counting from the end (02; RULES.md, R43).
    pure def slice_bound(mut self, cx: Cx, x: ExprId) -> (TExprId, bool):
        if let ExprKind.FromEnd(inner) = cx.ast.expr(x).kind:
            return (self.check_expr(cx, inner, Ty.int()), True)
        return (self.check_expr(cx, x, Ty.int()), False)

    pure def index_expr(
        mut self, cx: Cx, base: ExprId, args: list[IndexArg], at: TextRange
    ) -> TExprId:
        let b0 = self.infer_expr(cx, base, None)
        let b1 = self.auto_deref(b0)
        let b = self.unrefined(cx, b1)
        let t = self.resolved(self.ty_of(b))
        if t == Ty.error():
            for a in args:
                if let IndexArg.Expr(e) = a:
                    _ = self.infer_expr(cx, e, None)
            return self.error_expr(at)
        if args.is_empty():
            return self.error_expr(at)
        let arg = ref args[0]
        if let TyData.Adt(d, a) = self.types.data(t).copy():
            let elem = first_of(a) ?? Ty.error()
            let list = cx.prog.is_builtin(d, "list")
            match arg:
                case IndexArg.Expr(e):
                    if list or cx.prog.is_builtin(d, "Array"):
                        var idx = TExprId(index=0)
                        var kind = IndexKind.List
                        match cx.ast.expr(e).kind:
                            case ExprKind.FromEnd(inner):
                                idx = self.check_expr(cx, inner, Ty.int())
                                kind = IndexKind.ListFromEnd
                            case ExprKind.Unary(UnOp.Neg, inner):
                                if let ExprKind.Int(_, _, _) = cx.ast.expr(inner).kind:
                                    # `xs[-1]` does not compile (D-062).
                                    let digits = self.source_text(cx, cx.ast.expr(inner).range)
                                    let written = self.source_text(cx, cx.ast.expr(base).range)
                                    let r = cx.ast.expr(e).range
                                    var d2 = self.error(cx, Msg.TypeConstantNegativeIndex, r)
                                    d2 = d2.with("fix", "{written}[^{digits}]")
                                    self.report(
                                        d2.fix_at(Msg.TypeFromEndIndex, r.start, r.end, "^{digits}")
                                    )
                                    idx = self.check_expr(cx, inner, Ty.int())
                                    kind = IndexKind.ListFromEnd
                                else:
                                    idx = self.check_expr(cx, e, Ty.int())
                            case _:
                                idx = self.check_expr(cx, e, Ty.int())
                        return self.add(TExprKind.Index(base=b, index=idx, kind=kind), elem, at)
                    if cx.prog.is_builtin(d, "Arena"):
                        var key = Ty.error()
                        if let Some(kd) = cx.prog.lookup_in(cx.prog.prelude, "Key"):
                            key = self.types.adt(kd, [elem])
                        let idx = self.check_expr(cx, e, key)
                        return self.add(
                            TExprKind.Index(base=b, index=idx, kind=IndexKind.Dict), elem, at
                        )
                    if cx.prog.is_builtin(d, "dict"):
                        let k = elem
                        let v = if len(a) > 1: a[1] else: Ty.error()
                        self.require(k, cx.prog.wk.hash, at)
                        let idx = self.check_expr(cx, e, k)
                        return self.add(
                            TExprKind.Index(base=b, index=idx, kind=IndexKind.Dict), v, at
                        )
                case IndexArg.Slice(lo, hi):
                    if list:
                        # A bound may count from the end, `xs[1:^1]` (02).
                        var l: TExprId? = None
                        var h: TExprId? = None
                        var lo_end = False
                        var hi_end = False
                        if let Some(x) = lo:
                            let (y, e) = self.slice_bound(cx, x)
                            l = Some(y)
                            lo_end = e
                        if let Some(x) = hi:
                            let (y, e) = self.slice_bound(cx, x)
                            h = Some(y)
                            hi_end = e
                        let ty = self.types.adt(d, a)
                        let k = TExprKind.Slice(base=b, lo=l, hi=h, lo_end=lo_end, hi_end=hi_end)
                        return self.add(k, ty, at)
            # `b[i]` and `s[i]`: a byte, a reference to a value; `b[i:j]` and
            # `s[i:j]`: a copy of the bytes, a view of the values.
            if cx.prog.is_builtin(d, "bytes") or cx.prog.is_builtin(d, "Slice"):
                # A bound counted from the end, `^k`, as a list's (02;
                # RULES.md, R48): the method that reads the length of the
                # value it is given, so the base is evaluated once.
                var name = "at"
                var call_args: list[TExprId] = []
                match arg:
                    case IndexArg.Expr(e):
                        let (k, end) = self.slice_bound(cx, e)
                        if end:
                            name = "at_end"
                        call_args.push(k)
                    case IndexArg.Slice(lo, hi):
                        name = "cut"
                        var bounds: list[(TExprId, bool)] = []
                        for bound in [lo, hi]:
                            match bound:
                                case Some(x):
                                    bounds.push(self.slice_bound(cx, x))
                                case None:
                                    let least = TExprKind.Int(-9223372036854775807 - 1)
                                    bounds.push((self.add(least, Ty.int(), at), False))
                        let counted = bounds[0].1 or bounds[1].1
                        for (x, end) in bounds:
                            call_args.push(x)
                            if counted:
                                call_args.push(self.add(TExprKind.Bool(end), Ty.bool(), at))
                        if counted:
                            name = "cut_end"
                let m = cx.prog.method(TyKey.Adt(d), name) else:
                    return self.error_expr(at)
                var ret = t
                if name == "at" or name == "at_end":
                    if cx.prog.is_builtin(d, "bytes"):
                        ret = self.sized_ty(cx, "u8")
                    else:
                        ret = self.types.ref_(elem, False)
                var targs: list[TArg] = [self.receiver_arg(cx, b)]
                for x in call_args:
                    targs.push(TArg(expr=x, mode=ArgMode.Value))
                let call = TExprKind.Call(callee=Callee.Fn(def_=m, type_args=a), args=targs)
                return self.add(call, ret, at)
        if t == Ty.str() or self.is_string(cx, t):
            let shown = self.show(cx, t)
            let d = self.error(cx, Msg.TypeStrNotIndexable, at).with("ty", shown)
            self.report(d)
            return self.error_expr(at)
        let shown = self.show(cx, t)
        let d = self.error(cx, Msg.TypeNotIndexable, at).with("ty", shown)
        self.report(d)
        return self.error_expr(at)

## A capture as `check_own_closures` reads it.
@derive(Copy)
struct Capture2:
    local: int
    mutable: bool

## Whether the expression names a place: a name, `self`, or a field of
## one, in parentheses or not (what a generator expression's closure
## borrows rather than evaluates; RULES.md, R49).
pure def names_place(ast: Ast, e: ExprId, depth: int) -> bool:
    if depth > 32:
        return False
    return match ast.expr(e).kind:
        case ExprKind.Name(_) | ExprKind.SelfValue: True
        case ExprKind.Field(base, _) | ExprKind.Paren(base): names_place(ast, base, depth + 1)
        case _: False

## Whether a method gives the type `exp` without arguments: what the fix
## of a mismatch may call.
pure def gives(f: FnInfo, exp: Ty) -> bool:
    let mode = f.self_mode else:
        return False
    if mode == Mode.Mut:
        return False
    return f.params.is_empty()
        and len(f.generics) == f.impl_generics
        and not f.err_inferred
        and f.ret == exp

pub pure def is_var_data(d: TyData) -> bool:
    if let TyData.Var(_) = d:
        return True
    return False

pure def pair(d: DefId?, m: str) -> (DefId, String)?:
    let x = d else:
        return None
    return Some((x, m.to_string()))

## The text inside the quotes of a plain string literal.
pure def literal_inside(t: str) -> String?:
    if t.byte_len() < 2 or not t.starts_with("\"") or not t.ends_with("\""):
        return None
    let inner = t.byte_slice(1, t.byte_len() - 1)
    if inner.contains("\"") or inner.contains("{{"):
        return None
    return Some(inner.to_string())

## The last character of a text, as a text.
pure def last_char(s: str) -> String:
    var last = String.new()
    for c in s.chars():
        last = String.new()
        last.push_char(c)
    return last

## The name a text starts with: its letters, digits and `_`.
pure def leading_word(s: str) -> String:
    var out = String.new()
    for c in s.chars():
        if c.is_alphabetic() or c.is_digit() or c == '_':
            out.push_char(c)
        else:
            return out
    return out

pure def is_all_digits(s: str) -> bool:
    if s.is_empty():
        return False
    for b in s.bytes():
        if not is_digit(b):
            return False
    return True

## Whether `spec` is a format spec (03, "Strings"):
## `[[fill]align][sign][#][0][width][,|_][.precision][type]`.
pub pure def is_format_spec(spec: str) -> bool:
    var cs: list[char] = []
    for c in spec.chars():
        cs.push(c)
    var i = 0
    if len(cs) >= 2 and is_align(cs[1]):
        i = 2
    elif len(cs) >= 1 and is_align(cs[0]):
        i = 1
    if i < len(cs) and (cs[i] == '+' or cs[i] == '-' or cs[i] == ' '):
        i += 1
    if i < len(cs) and cs[i] == '#':
        i += 1
    if i < len(cs) and cs[i] == '0':
        i += 1
    while i < len(cs) and cs[i] >= '0' and cs[i] <= '9':
        i += 1
    if i < len(cs) and (cs[i] == ',' or cs[i] == '_'):
        i += 1
    if i < len(cs) and cs[i] == '.':
        i += 1
        while i < len(cs) and cs[i] >= '0' and cs[i] <= '9':
            i += 1
    if i < len(cs) and is_spec_type(cs[i]):
        i += 1
    return i == len(cs)

pure def is_spec_type(c: char) -> bool:
    for x in "boxXdeEfF%s?".chars():
        if x == c:
            return True
    return False

## Whether `name` is a sized integer type.
pub pure def is_sized(name: str) -> bool:
    return sized().contains(name)

pure def is_align(c: char) -> bool:
    return c == '<' or c == '>' or c == '^' or c == '='

## A byte of a name, a call or an index written plainly: what a fix may
## append a method call to without parentheses.
pure def is_simple_byte(b: u8) -> bool:
    return match b:
        case 95 | 46 | 40 | 41 | 91 | 93: True
        case _: is_alnum(b)

pure def is_digit(b: u8) -> bool:
    return b >= 48 and b <= 57

pure def is_alpha(b: u8) -> bool:
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122)

pure def is_alnum(b: u8) -> bool:
    return is_digit(b) or is_alpha(b)

## 1, as a `u128`.
pure def one() -> u128:
    return 1.to_u128() ?? 0.to_u128().unwrap()

## 2 to the power `n`, as a `u128` (for `n` below 128).
pure def pow2(n: int) -> u128:
    var p = one()
    let two = 2.to_u128() ?? one()
    for _ in range(n):
        p = p * two
    return p

## A `u128` of at most 2^63 as an `int`, negated when `negative`.
pure def u128_to_int(v: u128, negative: bool) -> int:
    if v == pow2(63):
        return -9223372036854775807 - 1
    let n = v.to_int() ?? 0
    return if negative: -n else: n

pure def u128_to_float(v: u128) -> f64:
    if let Some(n) = v.to_int():
        return n.to_f64()
    return 18446744073709551616.0

test "format specs as `Spec.parse` reads them":
    assert is_format_spec(">8.2f")
    assert is_format_spec("08")
    assert is_format_spec("*^10")
    assert is_format_spec(",d")
    assert is_format_spec("?")
    assert not is_format_spec("8.2q")
    assert not is_format_spec("abc")

## Where a function's parameter list ends, after its `)`: the name ends at
## `from_`, and generic parameters may come between.
pure def params_end(text: str, from_: int) -> int?:
    var i = from_
    let n = text.byte_len()
    var depth = 0
    var opened = False
    while i < n:
        let b = text.byte_at(i)
        if b == 91 and not opened:
            depth += 1
        elif b == 93 and not opened:
            depth -= 1
        elif b == 40 and depth == 0:
            opened = True
            depth = 1
            i += 1
            while i < n and depth > 0:
                let c = text.byte_at(i)
                if c == 40:
                    depth += 1
                elif c == 41:
                    depth -= 1
                i += 1
            return Some(i)
        elif (b == 58 or b == 10) and depth == 0:
            return None
        i += 1
    return None

## Whether a byte is a space or a line break.
pure def is_blank(b: u8) -> bool:
    return b == 32 or b == 10 or b == 13 or b == 9

## Whether `text` is one parenthesised expression, `(a * 2)`: its first
## bracket closes at its end.
pure def enclosed(text: str) -> bool:
    if not text.starts_with("(") or not text.ends_with(")"):
        return False
    var depth = 0
    for i in range(text.byte_len()):
        let b = text.byte_at(i)
        if b == 40:
            depth += 1
        elif b == 41:
            depth -= 1
            if depth == 0:
                return i == text.byte_len() - 1
    return False
