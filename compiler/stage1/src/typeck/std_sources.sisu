##! The standard-library sources stage 0 writes itself (its
##! `sisu-resolve/src/std_sources.rs`): `target`, the build target's facts,
##! and `builtin_impls`, the impls of the leaf types and of tuples, which
##! are the same text for each type and so are written by a loop. The std
##! modules on disk are read from `../std/`.

## The std modules every module sees by name without an import.
pub pure def ambient() -> list[str]:
    return ["task", "log", "cap", "live"]

## The std modules a program imports by path, besides the ambient ones.
pub pure def importable() -> list[str]:
    return [
        "cli",
        "math",
        "net",
        "time",
        "http",
        "sim",
        "json",
        "test",
        "collections",
        "num",
        "string",
        "fmt",
        "par",
        "io",
        "fs",
        "rand",
        "encoding",
        "hash",
        "sort",
        "search",
        "process",
        "env",
        "regex",
        "mem",
        "ffi",
        "rt",
    ]

## Whether the std module `name` is one only stage 1 reads (22): `std.mem`,
## `std.ffi` and `std.rt` declare `unsafe def`s, `unsafe trait`s and
## `unsafe impl`s, which the frozen Rust front end does not parse, so they
## live in `stage1/std/` beside stage 1, not in `std/`, which the Rust front
## end formats and reads, until it is retired.
pub pure def stage1_only(name: str) -> bool:
    return name == "mem" or name == "ffi" or name == "rt"

## The file of the std module `name` under the compiler's directory
## `home`. Stage 1's own modules are reached through `std/`, the directory
## beside them: the home the `sisu` driver gives stage 1 is a directory of
## links to the compiler's `catalog/` and `std/` (decision 268), in which
## `std/../stage1` is the compiler's `stage1/`.
pub pure def std_file(home: str, name: str) -> String:
    if stage1_only(name) or stage1_copy(name):
        return "{home}/std/../stage1/std/{name}.sisu"
    return "{home}/std/{name}.sisu"

## Whether `name` is one of the prelude's collections that take their
## allocator as a last type parameter, `A: Allocator = Global` (04,
## "Allocators"; 11; D-060; RULES.md, R227).
pub pure def allocated(name: str) -> bool:
    return name == "list" or name == "dict" or name == "set" or name == "String"

## The names of `std.mem` that the prelude's collections name, which every
## module sees as the prelude's (RULES.md, R227): the allocators', and the
## error of the collections' `try_` growth (R234).
pub pure def allocator_names() -> list[str]:
    return ["Allocator", "Global", "OutOfMemory"]

## The headers of the prelude's collections as `std/prelude.sisu` writes
## them, each with the header stage 1 reads in its place: the collection
## with its allocator parameter (RULES.md, R227). The frozen Rust front end
## builds the same file into its executable and fills a defaulted
## parameter into every type it resolves, where its literals and its
## builtins make a collection's type of one argument, so the shared text
## keeps the headers it reads until it is retired.
pub pure def allocator_headers() -> list[(str, str)]:
    return [
        ("pub struct String:\n", "pub struct String[A: Allocator = Global]:\n"),
        ("pub struct list[T]:\n", "pub struct list[T, A: Allocator = Global]:\n"),
        ("pub struct dict[K, V]:\n", "pub struct dict[K, V, A: Allocator = Global]:\n"),
        ("pub struct set[T]:\n", "pub struct set[T, A: Allocator = Global]:\n"),
    ]

## The prelude stage 1 reads: `text`, the prelude's source, with each
## collection's header given its allocator parameter (`allocator_headers`),
## on the line it was, so that every other line of the prelude, and every
## position on it, is the shared file's.
pub pure def with_allocators(text: str) -> String:
    var out = text.to_string()
    for (written, read) in allocator_headers():
        out = out.replace(written, read)
    return out

## The std modules stage 1 reads in a copy of its own, which a rule of
## RULES.md changes where the Rust front end, which reads the original,
## cannot evaluate the change: `json`, whose decoder validates refinements
## and invariants with reflection the Rust front end lacks (R32).
pub pure def stage1_copy(name: str) -> bool:
    return name == "json"

## The paths an import may name a std module by, for the fix of one that
## names none.
pub pure def module_paths() -> list[String]:
    var out: list[String] = []
    for p in [
        "std.x.cli",
        "std.math",
        "std.task",
        "std.log",
        "std.cap",
        "std.net",
        "std.time",
        "std.x.http",
        "std.sim",
        "std.json",
        "std.test",
        "std.collections",
        "std.num",
        "std.live",
        "std.core",
        "std.string",
        "std.fmt",
        "std.par",
        "std.io",
        "std.fs",
        "std.rand",
        "std.encoding",
        "std.hash",
        "std.sort",
        "std.search",
        "std.process",
        "std.env",
        "std.regex",
    ]:
        out.push(p.to_string())
    return out

## The std module an import path names (`std.json`, and stage 0's short
## names `cli`, `http`, `json`, ...).
pub pure def module_for(words: list[String]) -> String?:
    let joined = words.join(".")
    let path: str = joined
    return match path:
        case "cli" | "std.x.cli": Some("cli".to_string())
        case "std.math" | "math": Some("math".to_string())
        case "std.task" | "task": Some("task".to_string())
        case "std.log" | "log": Some("log".to_string())
        case "std.cap" | "cap": Some("cap".to_string())
        case "std.net" | "net": Some("net".to_string())
        case "std.time" | "time": Some("time".to_string())
        case "std.x.http" | "http": Some("http".to_string())
        case "std.sim" | "sim": Some("sim".to_string())
        case "std.json" | "json": Some("json".to_string())
        case "std.test": Some("test".to_string())
        case "std.collections": Some("collections".to_string())
        case "std.num": Some("num".to_string())
        case "std.live": Some("live".to_string())
        # The prelude is `std.core` (11).
        case "std.core": Some("prelude".to_string())
        case "std.string": Some("string".to_string())
        case "std.fmt": Some("fmt".to_string())
        case "std.par": Some("par".to_string())
        case "std.io": Some("io".to_string())
        case "std.fs": Some("fs".to_string())
        case "std.rand": Some("rand".to_string())
        case "std.encoding": Some("encoding".to_string())
        case "std.hash": Some("hash".to_string())
        case "std.sort": Some("sort".to_string())
        case "std.search": Some("search".to_string())
        case "std.process": Some("process".to_string())
        case "std.env": Some("env".to_string())
        case "std.regex": Some("regex".to_string())
        # Stage 1's (22): raw memory, the C types, and the runtime's layer,
        # internal to `std`.
        case "std.mem": Some("mem".to_string())
        case "std.ffi": Some("ffi".to_string())
        case "std.rt": Some("rt".to_string())
        case _: None

## The std modules whose doc examples `sisu test --std` runs and whose
## pages `sisu doc --std` writes, besides the prelude's, in stage 0's order
## (its `DOCUMENTED`).
pub pure def documented() -> list[str]:
    return [
        "cap",
        "cli",
        "collections",
        "encoding",
        "env",
        "fmt",
        "fs",
        "hash",
        "io",
        "live",
        "num",
        "par",
        "process",
        "rand",
        "regex",
        "http",
        "json",
        "log",
        "math",
        "net",
        "search",
        "sim",
        "sort",
        "string",
        "task",
        "test",
        "time",
        # Stage 1's (22): raw memory and the C types. `std.rt` is internal.
        "ffi",
        "mem",
    ]

## A std module's path as an import names it: `std.x.http` for `http`,
## and `std.core` for the prelude.
pub pure def display_path(name: str) -> String:
    return match name:
        case "prelude": "std.core".to_string()
        case "cli" | "http": "std.x.{name}"
        case _: "std.{name}"

## The prelude's names a std module re-exports (`from std.time import
## Duration`).
pub pure def reexports(module: str) -> list[str]:
    if module == "time":
        return ["DateTime", "Duration", "Timer", "TimeError", "TestClock", "Clock"]
    if module == "net":
        return ["Net", "NetOps", "NetError", "Conn", "Listener", "Stream", "Accept"]
    if module == "cap":
        return [
            "System",
            "Fs",
            "Net",
            "Clock",
            "Rand",
            "Env",
            "Proc",
            "Stdin",
            "FsOps",
            "NetOps",
            "ClockOps",
            "RandOps",
            "EnvOps",
            "ProcOps",
            "StdinOps",
            "Lent",
            "Cap",
            "Revoker",
            "TestClock",
        ]
    if module == "task":
        return [
            "Scope", "Handle", "TaskError", "Cancellation", "channel", "Sender", "Receiver", "Mutex"
        ]
    if module == "test":
        return ["check", "arbitrary", "exhaustive", "Gen", "Draws"]
    if module == "collections":
        return ["list", "dict", "set", "Arena", "Key", "Slice", "Iter", "Entry"]
    if module == "num":
        return [
            "Num",
            "u8",
            "u16",
            "u32",
            "u64",
            "u128",
            "i8",
            "i16",
            "i32",
            "i128",
            "f32",
            "bytes",
            "abs",
            "min",
            "max",
            "sum",
        ]
    if module == "string":
        return ["String"]
    if module == "fmt":
        return ["Display", "Debug", "Formatter", "Spec"]
    if module == "io":
        return ["Conn", "Stream", "IoError", "NetError", "Utf8Error", "Stdin"]
    if module == "fs":
        return ["Fs", "FsOps", "Path", "Metadata", "IoError"]
    if module == "rand":
        return ["Rand", "RandOps"]
    if module == "encoding":
        return ["Utf8Error"]
    if module == "process":
        return ["Proc", "ProcOps", "ProcOutput", "ProcError"]
    if module == "env":
        return ["Env", "EnvOps"]
    return []

## The sized integer types (03, "Numbers"), narrowest first in each kind.
pub pure def sized() -> list[str]:
    return ["u8", "u16", "u32", "u64", "u128", "i8", "i16", "i32", "i128"]

## The sized integer types some of whose values `int` cannot hold.
pub pure def own_kind(ty: str) -> bool:
    return ty == "u64" or ty == "u128" or ty == "i128"

## The bits of a sized integer type and whether it is signed; `int` is
## `i64`.
pub pure def int_width(ty: str) -> (int, bool)?:
    return match ty:
        case "u8": Some((8, False))
        case "u16": Some((16, False))
        case "u32": Some((32, False))
        case "u64": Some((64, False))
        case "u128": Some((128, False))
        case "i8": Some((8, True))
        case "i16": Some((16, True))
        case "i32": Some((32, True))
        case "i128": Some((128, True))
        case "int": Some((64, True))
        case _: None

## Whether every value of integer type `from_` is one of `to` (the
## implicit widening of 03).
pub pure def widens(from_: str, to: str) -> bool:
    let (fw, fs) = int_width(from_) else:
        return False
    let (tw, ts) = int_width(to) else:
        return False
    if from_ == to:
        return False
    if fs == ts:
        return tw >= fw
    return not fs and ts and tw > fw

## `target` (08, "Conditional compilation"): stage 0's target is the
## interpreter on the host. Stage 1 writes `linux` and `x86_64`, the
## values only `if comptime` reads.
pub pure def target() -> String:
    return target_for("interpreter", "full")

## The `target` module of a build for the runtime `runtime`, `interpreter`
## or `native` (RULES.md, R116), and of a package built for the runtime
## profile `profile`, `full` or `single` (12; RULES.md, R122).
pub pure def target_for(runtime: str, profile: str) -> String:
    var s: String = "##! The build target (08, \"Conditional compilation\").\n\n"
    s.push("## The operating system: `linux`, `macos`, `windows`, ...\n")
    s.push("const os: str = \"linux\"\n\n")
    s.push("## The processor: `x86_64`, `aarch64`, ...\n")
    s.push("const arch: str = \"x86_64\"\n\n")
    s.push("## How the target runs a program: `interpreter`, or `native` for a native build.\n")
    s.push("const runtime: str = \"{runtime}\"\n\n")
    s.push("## The runtime profile the package is built for (12, \"Runtime profiles\"):\n")
    s.push("## `full`, or `single`, as its manifest's `[package] runtime` names it.\n")
    s.push("const runtime_profile: str = \"{profile}\"\n")
    return s

## The leaf types and the traits each implements structurally.
pure def leaves() -> list[(str, list[str])]:
    let all = ["Display", "Debug", "Eq", "PartialOrd", "Ord", "Hash"]
    let text = ["Display", "Debug", "Eq", "PartialOrd", "Ord", "Hash", "Len"]
    let shown = ["Display", "Debug"]
    return [
        ("int", all.copy()),
        ("f64", ["Display", "Debug", "Eq", "PartialOrd"]),
        ("f32", ["Display", "Debug", "Eq", "PartialOrd"]),
        ("bool", all.copy()),
        ("char", all.copy()),
        ("str", text.copy()),
        ("String", text.copy()),
        ("Path", all.copy()),
        ("DateTime", all.copy()),
        ("()", all.copy()),
        ("bytes", all.copy()),
        ("u8", all.copy()),
        ("u16", all.copy()),
        ("u32", all.copy()),
        ("u64", all.copy()),
        ("i8", all.copy()),
        ("i16", all.copy()),
        ("i32", all.copy()),
        ("u128", all.copy()),
        ("i128", all.copy()),
        ("Fs", shown.copy()),
        ("Net", shown.copy()),
        ("Clock", shown.copy()),
        ("Rand", shown.copy()),
        ("Env", shown.copy()),
        ("Proc", shown.copy()),
        ("Stdin", shown.copy()),
        ("System", shown.copy()),
        ("TestClock", shown.copy()),
        ("HostFs", ["Debug"]),
        ("HostNet", ["Debug"]),
        ("HostClock", ["Debug"]),
        ("HostRand", ["Debug"]),
        ("HostEnv", ["Debug"]),
        ("HostProc", ["Debug"]),
        ("HostStdin", ["Debug"]),
    ]

## The largest tuple the generated impls cover.
pub pure def tuple_arity() -> int:
    return 6

## `<std>/builtin_impls.sisu`: the impls of the leaf types and of tuples
## of up to six elements.
pub pure def builtin_impls() -> String:
    var s = String.new()
    # The header stage 0 writes, line for line.
    s.push("##! Generated by compiler/crates/sisu-resolve/src/std_sources.rs: the\n")
    s.push("##! impls of the leaf types and of tuples of up to six elements.\n")
    s.push("##!\n")
    s.push("##! A leaf's `Display` and `Debug` apply the format spec when the leaf is\n")
    s.push("##! the value being rendered (`Spec` in the prelude) and otherwise write\n")
    s.push("##! its plain text, which `\"{{self}}\"` gives without a spec.\n")
    s.push("##! The intrinsics `structural.*` implement a trait the way the\n")
    s.push("##! interpreter compares, orders, hashes and prints values:\n")
    s.push("##! `structural.display` writes the plain text of a value (numbers,\n")
    s.push(
        "##! text, characters and paths as they read); `structural.debug` writes a value as it\n"
    )
    s.push("##! is written in Sisu (`\"text\"`, `'c'`, `1.0`); `structural.eq` is\n")
    s.push("##! equality of the values (`str` and `String` with the same text are\n")
    s.push("##! equal); `structural.partial_cmp` is the order of numbers, of text by\n")
    s.push("##! code points, `False < True`, and `None` for NaN; `structural.hash`\n")
    s.push("##! mixes the value into the hasher. `op.add`, `op.sub`, `op.mul`,\n")
    s.push("##! `op.div`, `op.rem` and `op.neg` are the operators `+`, `-`, `*`, `/`,\n")
    s.push("##! `%` and unary `-` on numbers, with their overflow and division\n")
    s.push("##! panics.\n")
    for (ty, traits) in leaves():
        for t in traits:
            s.push("\nimpl {t} for {ty}:\n")
            if let Some(body) = leaf_format(t, ty):
                s.push(body)
                continue
            let (name, sig) = leaf_method(t, ty)
            s.push("    @intrinsic(\"{name}\")\n    pure def {sig}\n")
    sized_impls(mut s)
    # The operators of the numbers, as traits for generic code.
    for ty in ["int", "f64", "f32"]:
        for (t, m) in [
            ("Add", "add"), ("Sub", "sub"), ("Mul", "mul"), ("Div", "div"), ("Rem", "rem")
        ]:
            s.push("\nimpl {t} for {ty}:\n")
            s.push("    @intrinsic(\"op.{m}\")\n    pure def {m}(self, other: {ty}) -> {ty}\n")
        s.push("\nimpl Neg for {ty}:\n")
        s.push("    @intrinsic(\"op.neg\")\n    pure def neg(self) -> {ty}\n")
    for n in range(1, tuple_arity() + 1):
        tuple_impls(mut s, n)
    # Stage 1's, after what stage 0 writes (RULES.md, R25): a `Box` has the
    # length of its value, whose methods it reaches, and a `Slice` prints as
    # the list it views does.
    s.push("\nimpl[T: Len] Len for Box[T]:\n")
    s.push("    pure def len(self) -> int:\n        return len(self.boxed)\n")
    s.push("\nimpl[T: Debug] Display for Slice[T]:\n")
    s.push("    pure def fmt(self, mut f: Formatter):\n        self.fmt_debug(mut f)\n")
    return s

## The capability handles and host objects among the leaves.
pure def is_handle(ty: str) -> bool:
    return match ty:
        case "Fs" | "Net" | "Clock" | "Rand" | "Env" | "Proc" | "Stdin" | "System" | "TestClock": True
        case "HostFs" | "HostNet" | "HostClock" | "HostRand" | "HostEnv" | "HostProc" | "HostStdin": True
        case _: False

## `Display` and `Debug` of the values a format spec applies to.
pure def leaf_format(t: str, ty: str) -> String?:
    if is_handle(ty):
        return None
    var sig = ""
    var plain = ""
    var with_spec = String.new()
    if t == "Display" and ty == "DateTime":
        var b: String = "    pure def fmt(self, mut f: Formatter):\n"
        b.push("        if f.depth > 0 or f.spec.is_empty():\n")
        b.push("            f.write(\"{{self}}\")\n        else:\n")
        b.push("            let pattern = f.spec.to_string()\n")
        b.push("            f.spec = String.new(\"\")\n")
        b.push("            f.write(Spec.strftime(self, pattern))\n")
        return Some(b)
    if t == "Display" and ty == "int":
        sig = "fmt"
        plain = "\"{{self}}\""
        with_spec = "f.write(s.int(self))".to_string()
    elif t == "Display" and (ty == "u64" or ty == "u128" or ty == "i128"):
        sig = "fmt"
        plain = "\"{{self}}\""
        let negative = if ty == "i128": "self < 0" else: "False"
        with_spec = "match self.to_int():\n                    case Some(n):\n                        f.write(s.int(n))\n                    case None:\n                        f.write(s.wide(self, {negative}))"
    elif t == "Display" and sized().contains(ty):
        sig = "fmt"
        plain = "\"{{self}}\""
        with_spec = "f.write(s.int(self.to_int()))".to_string()
    elif t == "Display" and ty == "f64":
        sig = "fmt"
        plain = "\"{{self}}\""
        with_spec = "f.write(s.float(self))".to_string()
    elif t == "Display" and ty == "f32":
        sig = "fmt"
        plain = "\"{{self}}\""
        with_spec = "f.write(s.float32(self))".to_string()
    elif t == "Display":
        sig = "fmt"
        plain = "\"{{self}}\""
        with_spec = "if s.kind == Some('?'):\n                    f.write(s.pad(\"{{self:?}}\"))\n                else:\n                    f.write(s.text(\"{{self}}\"))".to_string()
    elif t == "Debug" and ty == "f64":
        # A float's `Debug` text is its `Display` text, so a spec applies to
        # it as to `Display` (RULES.md, R20: `{x=:.2f}` rounds); `?` still
        # pads the `Debug` text.
        sig = "fmt_debug"
        plain = "\"{{self:?}}\""
        with_spec = "f.write(s.float(self))".to_string()
    elif t == "Debug" and ty == "f32":
        sig = "fmt_debug"
        plain = "\"{{self:?}}\""
        with_spec = "f.write(s.float32(self))".to_string()
    elif t == "Debug":
        sig = "fmt_debug"
        plain = "\"{{self:?}}\""
        with_spec = "f.write(s.pad(\"{{self:?}}\"))".to_string()
    else:
        return None
    var b: String = "    pure def {sig}(self, mut f: Formatter):\n"
    b.push("        match f.take_spec():\n            case Some(s):\n")
    b.push("                {with_spec}\n")
    b.push("            case None:\n                f.write({plain})\n")
    return Some(b)

pure def leaf_method(t: str, ty: str) -> (String, String):
    return match t:
        case "Display": pair("structural.display", "fmt(self, mut f: Formatter)")
        case "Debug": pair("structural.debug", "fmt_debug(self, mut f: Formatter)")
        case "Eq": pair("structural.eq", "eq(self, other: {ty}) -> bool")
        case "PartialOrd": pair(
            "structural.partial_cmp", "partial_cmp(self, other: {ty}) -> Ordering?"
        )
        case "Ord": pair("structural.cmp", "cmp(self, other: {ty}) -> Ordering")
        case "Hash": pair("structural.hash", "hash(self, mut h: Hasher)")
        case _: pair("len", "len(self) -> int")

pure def pair(a: str, b: str) -> (String, String):
    return (a.to_string(), b.to_string())

pure def tuple_impls(mut s: String, n: int):
    var names: list[String] = []
    for i in range(n):
        names.push("T{i}")
    let ty = if n == 1: "({names[0]},)" else: "({names.join(", ")})"
    s.push("\nimpl[{params(names, "Debug")}] Debug for {ty}:\n")
    s.push("    pure def fmt_debug(self, mut f: Formatter):\n")
    s.push("        f.write(\"(\")\n")
    s.push("        f.depth += 1\n")
    for i in range(n):
        if i > 0:
            s.push("        f.write(\", \")\n")
        s.push("        self.{i}.fmt_debug(mut f)\n")
    s.push("        f.depth -= 1\n")
    let close = if n == 1: "," else: ""
    s.push("        f.write(\"{close})\")\n")
    s.push("\nimpl[{params(names, "Debug")}] Display for {ty}:\n")
    s.push("    pure def fmt(self, mut f: Formatter):\n")
    s.push("        self.fmt_debug(mut f)\n")
    s.push("\nimpl[{params(names, "Eq")}] Eq for {ty}:\n")
    s.push("    pure def eq(self, other: {ty}) -> bool:\n")
    var parts: list[String] = []
    for i in range(n):
        parts.push("self.{i} == other.{i}")
    s.push("        return {parts.join(" and ")}\n")
    for (tr, method, eq, wrap) in [
        ("PartialOrd", "partial_cmp", "Some(Equal)", "Ordering?"),
        ("Ord", "cmp", "Equal", "Ordering"),
    ]:
        s.push("\nimpl[{params(names, tr)}] {tr} for {ty}:\n")
        s.push("    pure def {method}(self, other: {ty}) -> {wrap}:\n")
        for i in range(n):
            if i + 1 == n:
                s.push("        return self.{i}.{method}(other.{i})\n")
            else:
                s.push("        let c{i} = self.{i}.{method}(other.{i})\n")
                s.push("        if c{i} != {eq}:\n")
                s.push("            return c{i}\n")
    s.push("\nimpl[{params(names, "Hash")}] Hash for {ty}:\n")
    s.push("    pure def hash(self, mut h: Hasher):\n")
    for i in range(n):
        s.push("        self.{i}.hash(mut h)\n")

pure def params(names: list[String], bound: str) -> String:
    var out: list[String] = []
    for x in names:
        out.push("{x}: {bound}")
    return out.join(", ")

## The arithmetic of the sized integers: the operator traits for generic
## code, the conversions to and from `int`, and `Into` for each widening.
pure def sized_impls(mut s: String):
    for ty in sized():
        var signed = False
        if let Some((_, sg)) = int_width(ty):
            signed = sg
        for (t, m) in [("Add", "add"), ("Sub", "sub"), ("Mul", "mul"), ("Rem", "rem")]:
            s.push("\nimpl {t} for {ty}:\n")
            s.push("    @intrinsic(\"{ty}.{m}\")\n    pure def {m}(self, other: {ty}) -> {ty}\n")
        if signed:
            s.push("\nimpl Neg for {ty}:\n")
            s.push("    @intrinsic(\"{ty}.neg\")\n    pure def neg(self) -> {ty}\n")
        s.push("\nimpl {ty}:\n")
        if own_kind(ty):
            s.push("    ## The value as an `int`, or `None` outside `int`'s range.\n")
            s.push("    @intrinsic(\"{ty}.to_int\")\n    pure def to_int(self) -> int?\n")
        else:
            s.push("    ## The value as an `int`, which holds every one.\n")
            s.push("    @intrinsic(\"{ty}.to_int\")\n    pure def to_int(self) -> int\n")
        s.push("    @intrinsic(\"{ty}.cmp\")\n    pure def cmp(self, other: {ty}) -> Ordering\n")
        s.push("\nimpl Integer for {ty}:\n")
        s.push("    @intrinsic(\"{ty}.wrapping_from\")\n")
        s.push("    pure def wrapping_from(n: int) -> {ty}\n")
        s.push("\nimpl FromLiteral[int] for {ty}:\n")
        s.push("    @intrinsic(\"{ty}.from_literal\")\n")
        s.push("    pure def from_literal(literal: int) -> {ty}\n")
        var targets = sized()
        targets.push("int")
        for to in targets:
            if widens(ty, to):
                s.push("\nimpl Into[{to}] for {ty}:\n")
                s.push("    @intrinsic(\"{to}.widen\")\n    pure def into(self) -> {to}\n")
    s.push("\nimpl Integer for int:\n")
    s.push("    pure def wrapping_from(n: int) -> int:\n        return n\n")
    s.push("\nimpl int:\n")
    s.push("    ## The value reduced to `T`'s width, as two's complement wrapping does:\n")
    s.push("    ## `300.truncate_to[u8]()` is `44`, `-1.truncate_to[u32]()` is `4294967295`.\n")
    s.push("    pure def truncate_to[T: Integer](self) -> T:\n")
    s.push("        return T.wrapping_from(self)\n")
    for ty in sized():
        s.push("    ## The value as a `{ty}`, or `None` if it does not fit.\n")
        s.push("    @intrinsic(\"int.to_{ty}\")\n    pure def to_{ty}(self) -> {ty}?\n")

test "widening keeps every value":
    assert widens("u8", "int")
    assert widens("i8", "i32")
    assert not widens("int", "u8")
    assert not widens("u64", "int")
    assert not widens("int", "int")

test "the leaf impls are written as stage 0 writes them":
    let text = builtin_impls()
    assert text.contains("\nimpl Display for int:\n")
    assert text.contains("\nimpl[T0: Eq, T1: Eq] Eq for (T0, T1):\n")
    assert text.contains("\nimpl Into[int] for u8:\n")

test "a build names the runtime it is for":
    assert target() == target_for("interpreter", "full")
    assert target_for("native", "full").contains("\nconst runtime: str = \"native\"\n")
    assert target_for("native", "single").contains("\nconst runtime_profile: str = \"single\"\n")
