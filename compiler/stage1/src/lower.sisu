##! Lowering from the typed tree to SIR (stage 0's `sisu-lower/src/lib.rs`;
##! docs/architecture.md, "Lowering"): control flow becomes basic blocks;
##! drops are emitted at every scope exit in reverse declaration order,
##! with an unwind edge per block; closures become a function plus a tuple
##! of captured references; `?` becomes a switch and an early return that
##! records the error's trace; `for` becomes calls to the iterator
##! intrinsics.
##!
##! This module holds what is the program's rather than one function's:
##! the names of SIR functions and types, the translation of types, which
##! functions the entry, the tests and the root module's functions reach,
##! the declarations of the types, intrinsics, trait methods and impls
##! they use, and the numbering of the source files. One function is
##! lowered by `lower.func` and the modules it imports.
##!
##! Stage 1 checks the bodies of the root module and of the modules the
##! compiler writes for it, not the standard library's: a program that
##! reaches a body stage 1 has not checked is beyond the slice of lowering,
##! and says which (`Lowered.beyond`). A body of the standard library is
##! lowered once a run (`StdLowered`).

import stage1.lower.stmts
import stage1.sir.write
import stage1.typeck.borrows
from stage1.diag import Catalog
from stage1.diag import Lines, TextRange
from stage1.lower.func import lower_body
from stage1.lower.glue import glue_functions
from stage1.lower.names import CONTRACTS_ALL, Ctx
from stage1.sir import (
    Aggregate,
    Callee,
    Const,
    Entry,
    FieldDecl,
    FixtureUse,
    Function,
    ImplDecl,
    ImplTarget,
    IntrinsicDecl,
    Loc,
    Operand,
    Program,
    Rvalue,
    StatementKind,
    Type,
    TypeDecl,
    VALUE_WRAPPER,
    VariantDecl,
)
from stage1.syntax.ast import Mode
from stage1.typeck import (
    Base,
    StdBodies,
    Typed,
    base_from,
    body_module,
    check_file,
    check_std_body,
    std_lines,
    std_text,
)
from stage1.typeck.program import DefKind, EnumInfo, FnInfo, ModuleId, RANK_PHASE, RANK_STEP
from stage1.typeck.program import Program as Resolved
from stage1.typeck.thir import BodyKind, TBody
from stage1.typeck.ty import DefId, TyData, Types

## The types that have no declaration in SIR (stage 0's
## `validate::BUILTIN_TYPES`).
pub pure def is_builtin_type(n: str) -> bool:
    return match n:
        case "String" | "list" | "Array" | "dict" | "set" | "Iter" | "Entry" | "Path": True
        case "DateTime" | "Fs" | "Net" | "Clock" | "Rand" | "Env" | "Proc" | "Stdin": True
        case "System" | "Option" | "Result" | "Iterable": True
        case _: False

## The standard library's bodies lowered, kept from one program to the
## next of a run, as `typeck.StdBodies` keeps them typed and
## `borrowck.Placed` with their drops (stage 0 keeps a program's lowered
## bodies from one lowering of it to the next, its `LowerCache`): each body
## of a module the base resolved, whose definitions every program shares,
## by its definition and kind, with the functions it lowered to. What such
## a body lowers to is the same in every program but for the names of the
## prelude's functions that the program's own hide (`std.NAME`) and the
## instances of the standard library's templates the program declares, so
## an entry is taken again only by a program that agrees on those
## (`std_agreement`); and for its functions' source, which is the program's
## number of the module's file.
pub struct StdLowered:
    entries: dict[(DefId, BodyKind), (String, list[Function])]
    ## The std bodies lowered so far, and those taken again (stage 0's
    ## counters `bodies_lowered` and `lowered_reused`).
    pub lowered: int
    pub reused: int

impl StdLowered:
    pub pure def new() -> StdLowered:
        return StdLowered(entries={}, lowered=0, reused=0)

    ## The functions a body lowered to for an earlier program that agrees,
    ## with this program's number of their source.
    pure def reuse(self, d: DefId, kind: BodyKind, agreed: str, source: int) -> list[Function]?:
        let entry = self.entries.get((d, kind)) else:
            return None
        if entry.0 != agreed:
            return None
        var out: list[Function] = []
        for f in entry.1:
            var g = f.copy()
            g.source = source
            out.push(g)
        return Some(out)

    pure def keep(mut self, d: DefId, kind: BodyKind, agreed: str, fs: list[Function]):
        _ = self.entries.insert((d, kind), (agreed.to_string(), fs.copy()))

## What `lower` finds of the definitions the base resolved, the same for
## every program, found once a run rather than once a program (as stage 0
## finds them for each program): each declared type by its SIR name, the
## names of the trait impls' methods and how many impls of each trait for
## each type constructor they count, the bodies in their order (`body_key`,
## those of intrinsics left out) with the place of each module's first, and,
## for the programs that agree (`std_agreement`), the name of the function
## each body lowers to, the first body of a name.
pub struct StdSlots:
    ready: bool
    type_defs: dict[String, DefId]
    impl_names: dict[DefId, String]
    impl_counts: dict[String, int]
    slots: list[(int, DefId, BodyKind)]
    module_firsts: dict[ModuleId, int]
    agreed: String?
    names: dict[String, (int, DefId, BodyKind)]
    ## The base's definitions of the intrinsics, by the name each
    ## implements (`intrinsic_decls`).
    intrinsic_defs: dict[String, DefId]

impl StdSlots:
    pub pure def new() -> StdSlots:
        return StdSlots(
            ready=False,
            type_defs={},
            impl_names={},
            impl_counts={},
            slots=[],
            module_firsts={},
            agreed=None,
            names={},
            intrinsic_defs={},
        )

    ## Finds what does not depend on the program, the first time: of the
    ## first `shared` definitions and the first `impls` trait impls.
    pure def prepare(mut self, prog: Resolved, types: Types, shared: int, impls: int):
        if self.ready:
            return
        self.ready = True
        var named = Ctx.blank()
        self.type_defs = type_defs_in(named, prog, 0, shared, {})
        named.name_impls_from(prog, types, 0, impls, mut self.impl_counts)
        self.impl_names = named.impl_names.copy()
        self.slots = slots_in(prog, 0, shared)
        for (key, d, kind) in self.slots:
            let m = body_module(prog, d, kind)
            if not self.module_firsts.contains(m):
                _ = self.module_firsts.insert(m, key)
        intrinsic_defs_in(prog, 0, shared, mut self.intrinsic_defs)

    ## The names of the bodies' functions, for a program that agrees on
    ## `agreed`; `ctx` names them as that program does.
    pure def name(mut self, ctx: Ctx, prog: Resolved, types: Types, agreed: str):
        if let Some(a) = self.agreed:
            if a == agreed:
                return
        self.agreed = Some(agreed.to_string())
        self.names = {}
        for (key, d, kind) in self.slots:
            let n = slot_name(ctx, prog, types, d, kind)
            if not self.names.contains(n):
                _ = self.names.insert(n, (key, d, kind))

## Each declared type among the definitions from `first` to `end` by its
## SIR name, added to `known`, the first of a name.
pure def type_defs_in(
    ctx: Ctx, prog: Resolved, first: int, end: int, own known: dict[String, DefId]
) -> dict[String, DefId]:
    var out = known
    var i = first
    while i < end:
        let d = DefId(index=i)
        match prog.defs[i].kind():
            case DefKind.Struct(_) | DefKind.Enum(_) | DefKind.ErrorSet(_):
                let n = ctx.type_name(prog, d)
                if not out.contains(n):
                    _ = out.insert(n, d)
            case _:
                pass
        i += 1
    return out

## The bodies of the definitions from `first` to `end` (`body_slots`) in
## their order, those of intrinsics left out, each with its place.
pure def slots_in(prog: Resolved, first: int, end: int) -> list[(int, DefId, BodyKind)]:
    let slots = body_slots(prog, first, end)
    var keys: list[int] = []
    for (k, _) in slots.items():
        keys.push(k)
    keys.sort()
    var out: list[(int, DefId, BodyKind)] = []
    for k in keys:
        let (d, kind) = slots.get(k) ?? (DefId(index=0), BodyKind.Const)
        if kind == BodyKind.Fn:
            if let Some(f) = prog.fn_info(d):
                if f.intrinsic.is_some():
                    continue
        out.push((k, d, kind))
    return out

## What a body of the standard library lowers to depends on in the program
## (`StdLowered`): the prelude's functions its own free functions hide, and
## the instances it declares of templates of the modules the base resolved.
pure def std_agreement(ctx: Ctx, prog: Resolved, types: Types, shared: int) -> String:
    var hidden: list[String] = []
    for n in ctx.root_fns:
        if prog.lookup_in(prog.prelude, n).is_some():
            hidden.push(n.copy())
    hidden.sort()
    # The contracts the build checks, which change what a body lowers to.
    var out = "{ctx.level}|"
    out.push(hidden.join(","))
    for (t, args, _) in prog.instances:
        if t.index < shared:
            var shown: list[String] = []
            for a in args:
                shown.push(prog.display(types, a))
            out.push(";{t.index}:{shown.join(",")}")
    return out

## A program lowered, or why it is beyond the slice of lowering.
pub struct Lowered:
    pub program: Program
    pub beyond: list[String]
    ## The module whose file each of the program's sources is.
    pub source_modules: list[ModuleId]

## Lowers a checked program (stage 0's `lower_reaching` for `sisu sir`):
## what the entry, the tests and the root module's functions and constants
## reach, with the contracts `level` checks (`CONTRACTS_ALL` but for a
## build that asks for fewer), and the functions `extra` names (the world
## of transcripts, RULES.md, R120). `path` is the program's file as given.
pub pure def lower(
    own typed: Typed,
    base: Base,
    path: str,
    level: int,
    catalog: Catalog,
    mut kept: StdBodies,
    mut kept_lowered: StdLowered,
    mut kept_slots: StdSlots,
    extra: list[String],
) -> Lowered:
    return lower_covered(
        typed, base, path, level, catalog, mut kept, mut kept_lowered, mut kept_slots, extra, False
    )

## `lower`, with `cover` for `sir --tests --cover` (RULES.md, R231): each
## statement of the program's own that lowers to no statement at a place of
## its own, `pass`, `break`, `continue`, `defer` and a `let` without a
## value, lowers to a unit assignment at its place, which the runner counts
## when it runs.
pub pure def lower_covered(
    own typed: Typed,
    base: Base,
    path: str,
    level: int,
    catalog: Catalog,
    mut kept: StdBodies,
    mut kept_lowered: StdLowered,
    mut kept_slots: StdSlots,
    extra: list[String],
    cover: bool,
) -> Lowered:
    let prog = ref typed.prog
    var types = typed.types.copy()
    var ctx = Ctx(
        files={},
        file_names=[],
        path=path.to_string(),
        impl_names={},
        level=level,
        root_fns=set(),
        type_defs={},
        texts=typed.texts.copy(),
        lines={},
        tests={},
        benches={},
        instances={},
        traits=traits_by_name(prog),
        asserted=[],
        cover=cover,
    )
    ctx.index_names(prog)
    for (m, t) in typed.texts.items():
        _ = ctx.lines.insert(m, Lines.of(t))
    # What the base's definitions give is found once a run (`StdSlots`);
    # the program's own come after them.
    let shared = len(base.resolver.prog.defs)
    let base_impls = len(base.resolver.prog.impls)
    kept_slots.prepare(prog, types, shared, base_impls)
    ctx.type_defs = type_defs_in(ctx, prog, shared, len(prog.defs), kept_slots.type_defs.copy())
    # The base's definitions are none of the root module's.
    var i = shared
    while i < len(prog.defs):
        let def_ = ref prog.defs[i]
        i += 1
        let m = ref prog.modules[def_.module.index]
        if def_.module != prog.root and not m.name.starts_with("<arbitrary>/"):
            continue
        if let DefKind.Fn(f) = def_.kind():
            if f.owner.is_none() and f.trait_.is_none() and f.impl_.is_none():
                _ = ctx.root_fns.add(def_.name.copy())
    ctx.impl_names = kept_slots.impl_names.copy()
    var used = kept_slots.impl_counts.copy()
    ctx.name_impls_from(prog, types, base_impls, len(prog.impls), mut used)
    let agreed = std_agreement(ctx, prog, types, shared)
    kept_slots.name(ctx, prog, types, agreed)
    # Each body by the name of the function it lowers to, in stage 0's order
    # of the typed bodies. A body is lowered when a kept function first
    # names it; its files are numbered in the order the bodies come: the
    # root module's file is source 0, then each module's in the order of its
    # first body. A body stage 1 has not checked (the standard library's) is
    # checked when it is reached (`pending`, the program's own, and the
    # base's in `kept_slots`).
    _ = ctx.source_index(prog, prog.root)
    let own_slots = slots_in(prog, shared, len(prog.defs))
    var firsts = kept_slots.module_firsts.copy()
    for (key, d, kind) in own_slots:
        let m = body_module(prog, d, kind)
        let earlier = firsts.get(m) ?? key
        _ = firsts.insert(m, min(earlier, key))
    var module_order: list[(int, ModuleId)] = []
    for (m, key) in firsts.items():
        module_order.push((key, m))
    module_order.sort_by((a, b) -> a.0.cmp(b.0))
    for (_, m) in module_order:
        _ = ctx.source_index(prog, m)
    var bodies: dict[String, int] = {}
    for k in range(len(typed.bodies)):
        let b = ref typed.bodies[k]
        let n = ctx.body_name(prog, types, b)
        if not bodies.contains(n):
            _ = bodies.insert(n, k)
    var pending: dict[String, (int, DefId, BodyKind)] = {}
    for (key, d, kind) in own_slots:
        let n = slot_name(ctx, prog, types, d, kind)
        if not bodies.contains(n) and not pending.contains(n):
            _ = pending.insert(n, (key, d, kind))
    var entry: Entry? = None
    if let Some(m) = prog.main():
        if let Some(f) = prog.fn_info(m):
            var returns_result = False
            if let TyData.Adt(d, _) = types.data(f.ret):
                returns_result = Some(d) == prog.wk.result
            entry = Some(
                Entry(
                    function=ctx.fn_name(prog, types, m),
                    takes_system=len(f.params) == 1,
                    returns_result=returns_result,
                )
            )
    var tests: list[(String, String)] = []
    var test_tags: list[list[String]] = []
    var test_fixtures: list[list[FixtureUse]] = []
    var any_system = False
    for d in prog.tests:
        let f = prog.fn_info(d) else:
            continue
        if not f.params.is_empty():
            any_system = True
        if f.body.is_some():
            tests.push((prog.defs[d.index].name.copy(), ctx.fn_name(prog, types, d)))
            var tags: list[String] = []
            if let Some(found) = prog.test_tags.get(d):
                tags = found.copy()
            test_tags.push(tags)
            # Its fixtures, each with the function that makes it (RULES.md,
            # R219).
            var uses: list[FixtureUse] = []
            if let Some(found) = prog.test_fixtures.get(d):
                let m = prog.defs[d.index].module
                for x in found:
                    var function = x.name.copy()
                    if let Some(fd) = prog.lookup(m, x.name):
                        function = ctx.fn_name(prog, types, fd)
                    uses.push(
                        FixtureUse(
                            name=x.name.copy(),
                            function=function,
                            module_scope=x.module_scope,
                            param=x.param,
                        )
                    )
            test_fixtures.push(uses)
    # Each test's `@tag`s and the benchmarks, which `sisu test --from-sir`
    # and `sisu bench --from-sir` select and run (decision 285); the tags
    # end at the last tagged test.
    while not test_tags.is_empty() and test_tags[len(test_tags) - 1].is_empty():
        _ = test_tags.pop()
    while not test_fixtures.is_empty() and test_fixtures[len(test_fixtures) - 1].is_empty():
        _ = test_fixtures.pop()
    # The functions marked `@no_alloc` (RULES.md, R215), with the names the
    # program gives them, which the ownership checker's pass checks.
    var no_alloc: list[(String, String, Loc?)] = []
    for (d, at) in prog.no_alloc:
        if prog.fn_info(d).is_some():
            let line = attribute_line(ctx, prog.defs[d.index].module, at)
            no_alloc.push((ctx.fn_name(prog, types, d), prog.qualified_name(d), line))
    var benches: list[(String, String)] = []
    for d in prog.benches:
        if let Some(f) = prog.fn_info(d):
            if f.body.is_some():
                benches.push((prog.defs[d.index].name.copy(), ctx.fn_name(prog, types, d)))
    # The functions `@export("name")` gives a global symbol, in the order
    # of their bodies (decision 683; RULES.md, R120).
    var exports: list[(String, String)] = []
    for b in typed.bodies:
        if b.kind != BodyKind.Fn:
            continue
        let symbol = prog.exports.get(b.def_) else:
            continue
        let name = ctx.body_name(prog, types, b)
        var seen = False
        for (_, f) in exports:
            if f == name:
                seen = True
        if not seen:
            exports.push((symbol.copy(), name))
    # Keep what the entry, the exports, the tests, the world of transcripts
    # and the root module's functions reach.
    var roots: list[String] = []
    if let Some(e) = entry:
        roots.push(e.function.copy())
    for (_, f) in exports:
        roots.push(f.copy())
    for (_, f) in tests:
        roots.push(f.copy())
    for f in extra:
        roots.push(f.copy())
    # A test that declares a `System` gets `System.sim` in the `sim`
    # profile, which the run time calls (17); one that names capabilities
    # gets the fakes `System.fake` makes, a fake network and the test clock
    # (decision 241), or the simulated ones.
    if any_system:
        roots.push("System.sim".to_string())
        roots.push("System.fake".to_string())
        roots.push("Net.fake".to_string())
    # A constant is computed even when nothing uses it: a `comptime` in it
    # that fails is an error of the program (08).
    for b in typed.bodies:
        if prog.defs[b.def_.index].module == prog.root:
            if b.kind == BodyKind.Fn or b.kind == BodyKind.Const:
                roots.push(ctx.body_name(prog, types, b))
    # The benchmarks, after the rest, which a program of one module's
    # already reached as the root module's functions.
    for (_, f) in benches:
        roots.push(f.copy())
    var beyond: list[String] = []
    var all = typed.bodies.copy()
    let (reached, t) = lower_reached(
        mut ctx,
        typed,
        base,
        catalog,
        types,
        mut all,
        mut bodies,
        pending,
        roots,
        mut beyond,
        mut kept,
        mut kept_lowered,
        kept_slots.names,
    )
    types = t
    var functions = reached
    let decls = collect_types(ctx, prog, mut types, functions, set())
    for g in glue_functions(decls):
        functions.push(g.copy())
    var intrinsic_defs = kept_slots.intrinsic_defs.copy()
    intrinsic_defs_in(prog, shared, len(prog.defs), mut intrinsic_defs)
    let intrinsics = intrinsic_decls(prog, mut types, functions, intrinsic_defs)
    let (trait_methods, impls) = trait_decls(ctx, prog, mut types, functions)
    # A test that `@refines` makes stands at the attribute, in the file of
    # the function it checks, with the closure it checks the cases with
    # (RULES.md, R83).
    for d in prog.tests:
        let (m, r) = prog.refines_at.get(prog.defs[d.index].name.copy()) else:
            continue
        if prog.defs[d.index].module == m:
            continue
        let at = ctx.loc(m, r) else:
            continue
        let source = ctx.source_index(prog, m)
        let name = ctx.fn_name(prog, types, d)
        let inner = "{name}#"
        for k in range(len(functions)):
            if functions[k].name == name or functions[k].name.starts_with(inner):
                stand_at(mut functions[k], source, at)
    let (sources, renumbered) = renumber_sources(ctx.file_names, mut functions)
    var source_modules: list[ModuleId] = []
    for _ in sources:
        source_modules.push(prog.root)
    for (m, old) in ctx.files.items():
        if let Some(i) = renumbered.get(old):
            if i < len(source_modules) and source_modules[i] == prog.root:
                source_modules[i] = m
    source_modules[0] = prog.root
    # The `unsafe` blocks that assert purity, in the sources' numbering.
    var asserted: list[(int, Loc)] = []
    for (old, loc) in ctx.asserted:
        if let Some(i) = renumbered.get(old):
            asserted.push((i, loc))
    let program = Program(
        sources=sources,
        entry=entry,
        exports=exports,
        runtime=None,
        types=decls,
        intrinsics=intrinsics,
        functions=functions,
        tests=tests,
        test_tags=test_tags,
        test_fixtures=test_fixtures,
        no_alloc=no_alloc,
        benches=benches,
        trait_methods=trait_methods,
        impls=impls,
        asserted=asserted,
    )
    return Lowered(program=program, beyond=beyond, source_modules=source_modules)

## The trait methods the functions call through `call trait`, with their
## facts, and the impls of their traits, which the interpreter dispatches
## to.
pure def trait_decls(
    ctx: Ctx, prog: Resolved, mut types: Types, functions: list[Function]
) -> (list[IntrinsicDecl], list[ImplDecl]):
    let called = trait_calls(functions)
    var methods: list[IntrinsicDecl] = []
    var traits: list[DefId] = []
    for name in called:
        let m = trait_method_def(prog, ctx.traits, name) else:
            continue
        let f = prog.fn_info(m) else:
            continue
        methods.push(decl_of(prog, mut types, name, f))
        if let Some(t) = f.trait_:
            if not traits.contains(t):
                traits.push(t)
    var kept: set[String] = set()
    for f in functions:
        _ = kept.add(f.name.copy())
    # The traits whose associated types the functions name: the interpreter
    # finds `<T as Trait>.Name` in the impl for `T`.
    var projected: set[String] = set()
    var mentioned: set[String] = set()
    for f in functions:
        for l in f.locals:
            assoc_traits(l.ty, mut projected)
            type_names(l.ty, mut mentioned)
        for b in f.blocks:
            for st in b.stmts:
                match st.kind:
                    case StatementKind.Call(_, callee, _):
                        match callee:
                            case Callee.Fn(_, ts):
                                for t in ts:
                                    assoc_traits(t, mut projected)
                            case Callee.Trait(_, ts):
                                for t in ts:
                                    assoc_traits(t, mut projected)
                            case Callee.Intrinsic(_, ts):
                                for t in ts:
                                    assoc_traits(t, mut projected)
                            case _:
                                pass
                    case StatementKind.Assign(_, Rvalue.Closure(_, ts, _)):
                        for t in ts:
                            assoc_traits(t, mut projected)
                    case _:
                        pass
    var impls: list[ImplDecl] = []
    for i in prog.impls:
        let info = prog.impl_info(i) else:
            continue
        # An impl of a trait no function calls through, and without
        # associated types, gives nothing: its names and types are not made.
        let dispatched = traits.contains(info.trait_ref.def_)
        if not dispatched and info.assoc.is_empty():
            continue
        let trait_name = prog.qualified_name(info.trait_ref.def_)
        let self_ty = ctx.ty(prog, mut types, info.self_ty)
        var has_assoc = not info.assoc.is_empty() and projected.contains(trait_name)
        if has_assoc:
            if let Type.Named(n, _) = self_ty:
                has_assoc = mentioned.contains(n)
        if not dispatched and not has_assoc:
            continue
        # An impl for a type no kept function makes was pruned with its
        # methods.
        var pruned = False
        for (_, m) in info.methods:
            if let Some(f) = prog.fn_info(m):
                if f.body.is_some() and f.intrinsic.is_none():
                    if not kept.contains(ctx.fn_name(prog, types, m)):
                        pruned = True
        if pruned and not has_assoc:
            continue
        var ms: list[(String, ImplTarget)] = []
        for (n, m) in info.methods:
            let f = prog.fn_info(m) else:
                continue
            if f.body.is_none() and f.intrinsic.is_none():
                continue
            if let Some(intr) = f.intrinsic:
                ms.push((n.copy(), ImplTarget.Intrinsic(intr.copy())))
                continue
            let fname = ctx.fn_name(prog, types, m)
            if kept.contains(fname):
                ms.push((n.copy(), ImplTarget.Fn(fname)))
        var assoc: list[(String, Type)] = []
        for (n, t) in info.assoc:
            assoc.push((n.copy(), ctx.ty(prog, mut types, t)))
        impls.push(
            ImplDecl(
                params=len(info.generics),
                trait_name=trait_name,
                trait_args=ctx.tys(prog, mut types, info.trait_ref.args),
                self_ty=self_ty,
                methods=ms,
                assoc=assoc,
            )
        )
    return (methods, impls)

## The facts of a function's declaration the SIR checkers need.
pure def decl_of(prog: Resolved, mut types: Types, name: str, f: FnInfo) -> IntrinsicDecl:
    let b = prog.result_borrows_of(mut types, f)
    var owns: list[int] = []
    let ps = prog.sig_params(f)
    for i in range(len(ps)):
        if ps[i].mode == Mode.Own:
            owns.push(i)
    return IntrinsicDecl(
        name=name.to_string(),
        pure=f.pure,
        from_=b.deep.copy(),
        inner=b.inner.copy(),
        owns=owns,
        keeps=f.keeps.copy(),
    )

## The traits of the associated types a type names.
pure def assoc_traits(t: Type, mut out: set[String]):
    match t:
        case Type.Assoc(s, tr, args, _):
            _ = out.add(tr.copy())
            for x in s:
                assoc_traits(x, mut out)
            for a in args:
                assoc_traits(a, mut out)
        case Type.Named(_, args):
            for a in args:
                assoc_traits(a, mut out)
        case Type.Dyn(_, args):
            for a in args:
                assoc_traits(a, mut out)
        case Type.Tuple(es):
            for e in es:
                assoc_traits(e, mut out)
        case Type.Fn(ps, r, _):
            for p in ps:
                assoc_traits(p, mut out)
            for x in r:
                assoc_traits(x, mut out)
        case Type.Ref(x, _):
            for y in x:
                assoc_traits(y, mut out)
        case _:
            pass

## The names of the trait methods called through `call trait`, sorted.
pure def trait_calls(functions: list[Function]) -> list[String]:
    var names: list[String] = []
    for f in functions:
        for b in f.blocks:
            for s in b.stmts:
                if let StatementKind.Call(_, Callee.Trait(n, _), _) = s.kind:
                    if not names.contains(n):
                        names.push(n.copy())
    names.sort()
    return names

## The trait method a `Trait.method` name stands for: the method of the
## first trait of that qualified name that has one (`traits`, by
## `traits_by_name`).
pure def trait_method_def(prog: Resolved, traits: dict[String, list[DefId]], name: str) -> DefId?:
    let cut = last_index_of(name, ".") else:
        return None
    let t = name.byte_slice(0, cut)
    let m = name.byte_slice(cut + 1, name.byte_len())
    let ds = traits.get(t.to_string()) else:
        return None
    for d in ds:
        if let Some(x) = prog.trait_method(d, m):
            return Some(x)
    return None

## The program's traits by qualified name, each name's in the order of
## their definitions: found once a program, rather than by a walk of every
## definition for each `Trait.method` name.
pure def traits_by_name(prog: Resolved) -> dict[String, list[DefId]]:
    var out: dict[String, list[DefId]] = {}
    for i in range(len(prog.defs)):
        if let DefKind.Trait(_) = prog.defs[i].kind():
            let d = DefId(index=i)
            let n = prog.qualified_name(d)
            var ds: list[DefId] = []
            if let Some(earlier) = out.get(n):
                ds = earlier.copy()
            ds.push(d)
            _ = out.insert(n, ds)
    return out

## The definitions from `first` to `end` of the intrinsics, by the name
## each implements, added to `by_name`: the last declaration of a name
## wins, as a map's insertion does.
pure def intrinsic_defs_in(prog: Resolved, first: int, end: int, mut by_name: dict[String, DefId]):
    for i in range(first, end):
        if let DefKind.Fn(f) = prog.defs[i].kind():
            var n = f.intrinsic.copy()
            if n.is_none():
                n = f.structural.copy()
            if let Some(x) = n:
                _ = by_name.insert(x.copy(), DefId(index=i))

## The facts the SIR checkers need about every intrinsic the functions
## call (`by_name`, by `intrinsic_defs_in`): the prelude's declaration reduced to purity and the arguments the
## result borrows from, or, for the intrinsics lowering introduces, the
## table in docs/architecture.md ("Lowering-only intrinsics").
pure def intrinsic_decls(
    prog: Resolved, mut types: Types, functions: list[Function], by_name: dict[String, DefId]
) -> list[IntrinsicDecl]:
    var names: list[String] = []
    for f in functions:
        for b in f.blocks:
            for s in b.stmts:
                if let StatementKind.Call(_, Callee.Intrinsic(n, _), _) = s.kind:
                    if not names.contains(n):
                        names.push(n.copy())
    names.sort()
    var out: list[IntrinsicDecl] = []
    for name in names:
        if let Some(d) = by_name.get(name).copied():
            if let Some(f) = prog.fn_info(d):
                out.push(decl_of(prog, mut types, name, f))
                continue
        # A lookup by a `str` has the facts of its `String` form (decision
        # 784; RULES.md, R134).
        if name.ends_with("_str"):
            let base = name.byte_slice(0, name.byte_len() - 4).to_string()
            if let Some(d) = by_name.get(base).copied():
                if let Some(f) = prog.fn_info(d):
                    out.push(decl_of(prog, mut types, name, f))
                    continue
        var from_: list[int] = []
        var inner: list[int] = []
        let ns: str = name
        match ns:
            case "iter.ref" | "iter.mut" | "iter.own" | "gen.new" | "dict.index_str":
                from_ = [0]
            case "list.slice" | "list.slice_middle":
                inner = [0]
            case _:
                pass
        # `iter.own` takes the collection and keeps every element; a
        # generator keeps its body, and `yield` gives its item away; a
        # capability handle keeps its object for good.
        var owns: list[int] = []
        match ns:
            case "iter.own" | "gen.new" | "gen.yield" | "cap.new":
                owns = [0]
            case _:
                pass
        let keeps = owns.copy()
        # `select` observes the schedule (06, "Effects").
        let pure = name != "select.wait"
        out.push(
            IntrinsicDecl(
                name=name.copy(), pure=pure, from_=from_, inner=inner, owns=owns, keeps=keeps
            )
        )
    return out

## The body a function's name comes from: its own, or the one its closure,
## `comptime` expression or value wrapper is in (`f#closure2`,
## `T#field#comptime0`, `f#value`).
pure def owner_body(name: str, bodies: dict[String, int]) -> int?:
    var n = name.to_string()
    while True:
        if let Some(i) = bodies.get(n):
            return Some(i)
        var cut = -1
        if let Some(c) = last_index_of(n, "#closure"):
            cut = c
        if let Some(c) = last_index_of(n, "#comptime"):
            cut = max(cut, c)
        if let Some(c) = last_index_of(n, VALUE_WRAPPER):
            cut = max(cut, c)
        if cut < 0:
            return None
        n = n.byte_slice(0, cut).to_string()

## Where the last `part` in `s` starts.
## The line of a function's attribute whose name is `r` (after its `@`),
## from the line's start to the next line's, when the attribute stands
## alone on it: what the fix that removes `@no_alloc` removes (RULES.md,
## R229).
pure def attribute_line(ctx: Ctx, m: ModuleId, r: TextRange) -> Loc?:
    let text = ctx.texts.get(m) else:
        return None
    let lines = ctx.lines.get(m) else:
        return None
    let at = r.start - 1
    if at < 0 or r.end > text.byte_len() or text.byte_at(at) != 64:
        return None
    var b = at
    while b > 0 and text.byte_at(b - 1) == 32:
        b -= 1
    if b > 0 and text.byte_at(b - 1) != 10:
        return None
    var e = r.end
    while e < text.byte_len() and (text.byte_at(e) == 32 or text.byte_at(e) == 13):
        e += 1
    if e < text.byte_len():
        if text.byte_at(e) != 10:
            return None
        e += 1
    let (line, col) = lines.line_col(text, b)
    let (end_line, end_col) = lines.line_col(text, e)
    return Some(Loc(line=line, col=col, end_line=end_line, end_col=end_col))

pub pure def last_index_of(s: str, part: str) -> int?:
    let n = part.byte_len()
    var i = s.byte_len() - n
    while i >= 0:
        if s.byte_slice(i, i + n) == part:
            return Some(i)
        i -= 1
    return None

## Where each body stage 0 checks comes in its list of typed bodies: the
## functions with bodies (but templates), the root module's first, each by
## definition; then the defaults of struct fields and of parameters and the
## constants, by definition and then by position. The key orders them. Of
## the definitions from `first` to `end`.
pure def body_slots(prog: Resolved, first: int, end: int) -> dict[int, (DefId, BodyKind)]:
    var out: dict[int, (DefId, BodyKind)] = {}
    for i in range(first, end):
        let d = DefId(index=i)
        match prog.defs[i].kind():
            case DefKind.Fn(f):
                if f.body.is_some() and not f.template:
                    _ = out.insert(body_key(prog, d, BodyKind.Fn), (d, BodyKind.Fn))
                for k in range(len(f.params)):
                    if f.params[k].default.is_some():
                        let kind = BodyKind.ParamDefault(d, k)
                        _ = out.insert(body_key(prog, d, kind), (d, kind))
            case DefKind.Struct(s):
                for k in range(len(s.fields)):
                    if s.fields[k].default.is_some():
                        let kind = BodyKind.FieldDefault(d, k)
                        _ = out.insert(body_key(prog, d, kind), (d, kind))
            case DefKind.Const(c):
                if c.value.is_some():
                    _ = out.insert(body_key(prog, d, BodyKind.Const), (d, BodyKind.Const))
            case _:
                pass
    return out

## The place of a body in stage 0's list of typed bodies, as a number.
pure def body_key(prog: Resolved, d: DefId, kind: BodyKind) -> int:
    let rank = def_rank(prog, d) * 10000
    return match kind:
        case BodyKind.Fn: (if prog.defs[d.index].module == prog.root: 0 else: 10000000000000) + rank
        case BodyKind.FieldDefault(_, i): 100000000000000 + rank + i
        case BodyKind.ParamDefault(_, i): 100000000000000 + rank + i
        case BodyKind.Const: 100000000000000 + rank

## A definition's place in stage 0's order of definitions: its phase, then
## its index (`Program.phases`).
pub pure def def_rank(prog: Resolved, d: DefId) -> int:
    if let Some(r) = prog.reranked.get(d.index):
        return r
    var phase = 0
    if d.index < len(prog.phases):
        phase = prog.phases[d.index]
    return phase * RANK_PHASE + d.index * RANK_STEP

## The name of the function a body lowers to.
pure def slot_name(ctx: Ctx, prog: Resolved, types: Types, d: DefId, kind: BodyKind) -> String:
    return match kind:
        case BodyKind.Fn: ctx.fn_name(prog, types, d)
        case BodyKind.FieldDefault(s, i): ctx.field_default_name(prog, s, i)
        case BodyKind.ParamDefault(f, i): ctx.param_default_name(prog, types, f, i)
        case BodyKind.Const: ctx.const_name(prog, d)

## The body a function's name comes from among those not checked yet,
## with its name: of the program's own (`pending`) and the base's
## (`std_names`), the first in the order of the bodies.
pure def pending_owner(
    name: str,
    pending: dict[String, (int, DefId, BodyKind)],
    std_names: dict[String, (int, DefId, BodyKind)],
) -> (String, DefId, BodyKind)?:
    var n = name.to_string()
    while True:
        var found: (int, DefId, BodyKind)? = None
        if let Some(x) = pending.get(n.copy()):
            found = Some(x.copy())
        if let Some(y) = std_names.get(n.copy()):
            var earlier = True
            if let Some(x) = found:
                earlier = y.0 < x.0
            if earlier:
                found = Some(y.copy())
        if let Some((_, d, kind)) = found:
            return Some((n, d, kind))
        var cut = -1
        if let Some(c) = last_index_of(n, "#closure"):
            cut = c
        if let Some(c) = last_index_of(n, "#comptime"):
            cut = max(cut, c)
        if let Some(c) = last_index_of(n, VALUE_WRAPPER):
            cut = max(cut, c)
        if cut < 0:
            return None
        n = n.byte_slice(0, cut).to_string()

## Lowers what the roots reach, and only that: from each kept function,
## the functions it calls or names, the defaults, drops and invariant
## checks of the types it uses, and the methods of the impls of the traits
## it calls through `call trait` for the types the kept functions mention.
## The functions come in the order of their bodies. A body stage 1 has not
## checked is noted in `beyond`; one of the standard library lowered for
## an earlier program that agrees is taken again (`StdLowered`).
pure def lower_reached(
    mut ctx: Ctx,
    typed: Typed,
    base: Base,
    catalog: Catalog,
    own types_in: Types,
    mut all: list[TBody],
    mut bodies: dict[String, int],
    pending: dict[String, (int, DefId, BodyKind)],
    roots: list[String],
    mut beyond: list[String],
    mut kept: StdBodies,
    mut kept_lowered: StdLowered,
    std_names: dict[String, (int, DefId, BodyKind)],
) -> (list[Function], Types):
    var types = types_in
    let prog = ref typed.prog
    let shared = len(base.resolver.prog.defs)
    let agreed = std_agreement(ctx, prog, types, shared)
    var tried: set[String] = set()
    # Each body's functions by the body's place (`body_key`), and the body
    # each function comes from; the std bodies checked here, by their index
    # in `all`, to keep once they are lowered.
    var lowered: dict[int, list[Function]] = {}
    var where_is: dict[String, int] = {}
    var to_keep: dict[int, (DefId, BodyKind)] = {}
    var dispatched: set[DefId] = set()
    var added_impls: set[DefId] = set()
    var keep: set[String] = set()
    var mentioned: set[String] = set()
    var typed_names: set[String] = set()
    var work: list[String] = roots.copy()
    while True:
        while let Some(n) = work.pop():
            if keep.contains(n):
                continue
            _ = keep.add(n.copy())
            if not where_is.contains(n) and owner_body(n, bodies).is_none():
                # A body of the standard library: lowered for an earlier
                # program, or checked now.
                if let Some((owner, d, kind)) = pending_owner(n, pending, std_names):
                    if not tried.contains(owner):
                        _ = tried.add(owner.copy())
                        let m = prog.defs[d.index].module
                        var again = False
                        if d.index < shared:
                            let source = ctx.source_index(prog, m)
                            if let Some(fs) = kept_lowered.reuse(d, kind, agreed, source):
                                kept_lowered.reused += 1
                                let k = body_key(prog, d, kind)
                                for f in fs:
                                    _ = where_is.insert(f.name.copy(), k)
                                _ = lowered.insert(k, fs)
                                again = True
                        if not again:
                            let (tb, t) = check_std_body(
                                base, typed, types, d, kind, catalog, mut kept
                            )
                            types = t
                            match tb:
                                case Some(b):
                                    if not ctx.texts.contains(m):
                                        _ = ctx.lines.insert(m, std_lines(base, prog, m))
                                        _ = ctx.texts.insert(m, std_text(base, prog, m))
                                    all.push(b.copy())
                                    _ = bodies.insert(owner.copy(), len(all) - 1)
                                    if d.index < shared:
                                        _ = to_keep.insert(len(all) - 1, (d, kind))
                                case None:
                                    let why = "a body of the standard library beyond the type checker's slice, `{owner}`"
                                    if not beyond.contains(why):
                                        beyond.push(why)
            if not where_is.contains(n):
                if let Some(b) = owner_body(n, bodies):
                    let k = body_key(prog, all[b].def_, all[b].kind)
                    if not lowered.contains(k):
                        let (fs, t) = lower_body(mut ctx, prog, types, all[b])
                        types = t
                        for f in fs:
                            _ = where_is.insert(f.name.copy(), k)
                        if let Some((d, kind)) = to_keep.get(b):
                            kept_lowered.lowered += 1
                            kept_lowered.keep(d, kind, agreed, fs)
                        _ = lowered.insert(k, fs)
            let k = where_is.get(n) else:
                continue
            let fs = lowered.get(k) else:
                continue
            var at = -1
            var i = 0
            while i < len(fs):
                if fs[i].name == n:
                    at = i
                    break
                i += 1
            if at < 0:
                continue
            let f = ref fs[at]
            for l in f.locals:
                type_names(l.ty, mut mentioned)
            reach_from(prog, ctx.traits, f, mut work, mut dispatched, mut mentioned)
            # Defaults and drops of declared types are reached through the
            # types, and so is a type's invariant check, which the run time
            # calls when unwinding drops a mutex guard (D-077). A type met
            # before, and so the types it mentions, gave its own already.
            var names: set[String] = set()
            mentioned_types(f, mut names)
            for t in close_types(ctx, prog, mut types, names, typed_names):
                let tn = t.name().to_string()
                if typed_names.contains(tn):
                    continue
                _ = typed_names.add(tn.copy())
                match t:
                    case TypeDecl.Struct(name, _, fields, drop, _, _):
                        for fd in fields:
                            if let Some(d) = fd.default:
                                work.push(d.copy())
                        if let Some(d) = drop:
                            work.push(d.copy())
                        work.push("{name}.__invariant")
                    case TypeDecl.Enum(_, _, _, drop, _, _, _):
                        if let Some(d) = drop:
                            work.push(d.copy())
        for i in prog.impls:
            let info = prog.impl_info(i) else:
                continue
            if added_impls.contains(i) or not dispatched.contains(info.trait_ref.def_):
                continue
            var needed = True
            if let Type.Named(n, _) = ctx.ty(prog, mut types, info.self_ty):
                needed = mentioned.contains(n)
            if needed:
                _ = added_impls.add(i)
                for (_, m) in info.methods:
                    work.push(ctx.fn_name(prog, types, m))
        if work.is_empty():
            break
    # In stage 0's order of the typed bodies.
    var order: list[int] = []
    for k in lowered.keys():
        order.push(k)
    order.sort()
    var out: list[Function] = []
    for k in order:
        if let Some(fs) = lowered.get(k):
            for f in fs:
                if keep.contains(f.name):
                    out.push(f.copy())
    return (out, types)

## The names of the named types in a type.
pure def type_names(t: Type, mut out: set[String]):
    match t:
        case Type.Named(n, args):
            _ = out.add(n.copy())
            for a in args:
                type_names(a, mut out)
        case Type.Tuple(es):
            for e in es:
                type_names(e, mut out)
        case Type.Fn(ps, r, _):
            for p in ps:
                type_names(p, mut out)
            for x in r:
                type_names(x, mut out)
        case Type.Ref(x, _):
            for y in x:
                type_names(y, mut out)
        case Type.Dyn(_, args):
            for a in args:
                type_names(a, mut out)
        case Type.Assoc(s, _, args, _):
            for x in s:
                type_names(x, mut out)
            for a in args:
                type_names(a, mut out)
        case Type.ErrSet(ms):
            for m in ms:
                _ = out.add(m.copy())
        case _:
            pass

## What one function reaches: its callees, the functions it names as
## values, and the traits it calls through; and the types its calls take
## as type arguments, which a callee may make (`R.empty()` in a function
## generic over `R`, decision 252), as `mentioned`.
pure def reach_from(
    prog: Resolved,
    traits: dict[String, list[DefId]],
    f: Function,
    mut work: list[String],
    mut dispatched: set[DefId],
    mut mentioned: set[String],
):
    for b in f.blocks:
        for s in b.stmts:
            match s.kind:
                case StatementKind.Call(_, callee, args):
                    match callee:
                        case Callee.Fn(c, tys):
                            work.push(c.copy())
                            refs_in_operands(args, mut work)
                            for t in tys:
                                type_names(t, mut mentioned)
                        case Callee.Trait(c, tys):
                            for t in tys:
                                type_names(t, mut mentioned)
                            refs_in_operands(args, mut work)
                            work.push(c.copy())
                            if let Some(m) = trait_method_def(prog, traits, c):
                                if let Some(fi) = prog.fn_info(m):
                                    if let Some(t) = fi.trait_:
                                        _ = dispatched.add(t)
                        case _:
                            refs_in_operands(args, mut work)
                case StatementKind.Assign(_, r):
                    match r:
                        case Rvalue.Closure(c, _, ops):
                            work.push(c.copy())
                            refs_in_operands(ops, mut work)
                        case Rvalue.Use(o):
                            refs_in_operands([o.copy()], mut work)
                        case Rvalue.Aggregate(_, ops):
                            refs_in_operands(ops, mut work)
                        case _:
                            pass
                case _:
                    pass

## A function, and every statement and block of it, placed at `at` in the
## file numbered `source`.
pure def stand_at(mut f: Function, source: int, at: Loc):
    f.source = source
    f.loc = Some(at)
    for b in range(len(f.blocks)):
        if f.blocks[b].loc.is_some():
            f.blocks[b].loc = Some(at)
        for s in range(len(f.blocks[b].stmts)):
            if f.blocks[b].stmts[s].loc.is_some():
                f.blocks[b].stmts[s].loc = Some(at)
    for l in range(len(f.locals)):
        if f.locals[l].loc.is_some():
            f.locals[l].loc = Some(at)

## The sources the kept functions come from: the root module's file first,
## then the others in the order they were first met; each function's index
## is rewritten to match.
pure def renumber_sources(
    names: list[String], mut functions: list[Function]
) -> (list[String], dict[int, int]):
    var map: dict[int, int] = {}
    var out: list[String] = []
    if not names.is_empty():
        _ = map.insert(0, 0)
        out.push(names[0].copy())
    var used: list[int] = []
    for f in functions:
        if not used.contains(f.source):
            used.push(f.source)
    used.sort()
    for i in used:
        if not map.contains(i) and i < len(names):
            _ = map.insert(i, len(out))
            out.push(names[i].copy())
    for k in range(len(functions)):
        functions[k].source = map.get(functions[k].source) ?? 0
    return (out, map)

pure def refs_in_operands(ops: list[Operand], mut work: list[String]):
    for o in ops:
        if let Operand.Const(Const.Fn(n)) = o:
            work.push(n.copy())

## The declarations of every non-builtin type the functions mention, in
## definition order, but those `skip` names and the types theirs mention.
pure def collect_types(
    ctx: Ctx, prog: Resolved, mut types: Types, functions: list[Function], skip: set[String]
) -> list[TypeDecl]:
    var names: set[String] = set()
    for f in functions:
        mentioned_types(f, mut names)
    return close_types(ctx, prog, mut types, names, skip)

## The named types a function mentions: its locals', and those its
## aggregates make and its calls take as type arguments.
pure def mentioned_types(f: Function, mut names: set[String]):
    for l in f.locals:
        walk_type(l.ty, mut names)
    for b in f.blocks:
        for s in b.stmts:
            match s.kind:
                case StatementKind.Assign(_, Rvalue.Aggregate(kind, _)):
                    match kind:
                        case Aggregate.Struct(n):
                            _ = names.add(n.copy())
                        case Aggregate.Variant(n, _):
                            _ = names.add(n.copy())
                        case Aggregate.Dyn(t):
                            walk_type(t, mut names)
                        case _:
                            pass
                case StatementKind.Call(_, callee, _):
                    match callee:
                        case Callee.Fn(_, ts):
                            for t in ts:
                                walk_type(t, mut names)
                        case Callee.Trait(_, ts):
                            for t in ts:
                                walk_type(t, mut names)
                        case Callee.Intrinsic(_, ts):
                            for t in ts:
                                walk_type(t, mut names)
                        case _:
                            pass
                case _:
                    pass

## The declarations of the types `names` names and of the types their
## fields mention, in definition order, but those `skip` names and the
## types theirs mention.
pure def close_types(
    ctx: Ctx, prog: Resolved, mut types: Types, own names: set[String], skip: set[String]
) -> list[TypeDecl]:
    # Close over field types.
    var decls: dict[int, TypeDecl] = {}
    var done: set[String] = set()
    var queue: list[String] = []
    for n in names:
        queue.push(n.copy())
    queue.sort()
    while let Some(n) = queue.pop():
        if done.contains(n) or skip.contains(n):
            continue
        _ = done.add(n.copy())
        if is_builtin_type(n):
            continue
        let d = ctx.type_defs.get(n).copied() else:
            continue
        var decl: TypeDecl? = None
        match prog.defs[d.index].kind():
            case DefKind.Struct(s):
                var params: list[String] = []
                for g in s.generics:
                    params.push(g.name.copy())
                var fields: list[FieldDecl] = []
                for i in range(len(s.fields)):
                    let f = ref s.fields[i]
                    var default: String? = None
                    if f.default.is_some():
                        default = Some(ctx.field_default_name(prog, d, i))
                    fields.push(
                        FieldDecl(
                            name=f.name.copy(), ty=ctx.ty(prog, mut types, f.ty), default=default
                        )
                    )
                var drop: String? = None
                if let Some(x) = s.drop:
                    drop = Some(ctx.fn_name(prog, types, x))
                decl = Some(
                    TypeDecl.Struct(
                        name=n.copy(),
                        params=params,
                        fields=fields,
                        drop=drop,
                        view_=s.view_,
                        must_consume=s.must_consume,
                    )
                )
            case DefKind.Enum(e):
                decl = Some(enum_decl(ctx, prog, mut types, d, n, e))
            case DefKind.ErrorSet(e):
                decl = Some(enum_decl(ctx, prog, mut types, d, n, e))
            case _:
                pass
        let found = decl else:
            continue
        var inner: set[String] = set()
        match found:
            case TypeDecl.Struct(_, _, fields, _, _, _):
                for f in fields:
                    walk_type(f.ty, mut inner)
            case TypeDecl.Enum(_, _, variants, _, _, _, _):
                for v in variants:
                    for (_, t) in v.fields:
                        walk_type(t, mut inner)
        var more: list[String] = []
        for x in inner:
            more.push(x.copy())
        more.sort()
        for x in more:
            queue.push(x.copy())
        _ = decls.insert(def_rank(prog, d), found)
    var order: list[int] = []
    for i in decls.keys():
        order.push(i)
    order.sort()
    var out: list[TypeDecl] = []
    for i in order:
        if let Some(t) = decls.get(i):
            out.push(t.copy())
    return out

pure def enum_decl(
    ctx: Ctx, prog: Resolved, mut types: Types, d: DefId, n: str, e: EnumInfo
) -> TypeDecl:
    var params: list[String] = []
    for g in e.generics:
        params.push(g.name.copy())
    var variants: list[VariantDecl] = []
    for v in e.variants:
        var fields: list[(String?, Type)] = []
        for (fname, t) in v.fields:
            fields.push((fname.copy(), ctx.ty(prog, mut types, t)))
        variants.push(VariantDecl(name=v.name.copy(), fields=fields))
    var drop: String? = None
    if let Some(x) = e.drop:
        drop = Some(ctx.fn_name(prog, types, x))
    return TypeDecl.Enum(
        name=n.to_string(),
        params=params,
        variants=variants,
        drop=drop,
        error_=prog.is_error_set(d),
        open=e.open,
        must_consume=e.must_consume,
    )

## The named types a type mentions, for `collect_types`.
pure def walk_type(t: Type, mut out: set[String]):
    match t:
        case Type.Named(n, args):
            _ = out.add(n.copy())
            for a in args:
                walk_type(a, mut out)
        case Type.Tuple(es):
            for e in es:
                walk_type(e, mut out)
        case Type.ErrSet(ms):
            for m in ms:
                _ = out.add(m.copy())
        case Type.Fn(ps, r, _):
            for p in ps:
                walk_type(p, mut out)
            for x in r:
                walk_type(x, mut out)
        case Type.Ref(x, _):
            for y in x:
                walk_type(y, mut out)
        case Type.Dyn(_, args):
            for a in args:
                walk_type(a, mut out)
        case Type.Assoc(s, _, args, _):
            for x in s:
                walk_type(x, mut out)
            for a in args:
                walk_type(a, mut out)
        case _:
            pass

# ------------------------------------------------------------------ tests

## Why stage 1 does not lower a program: the type checker's reasons, then
## lowering's.
pure def beyond_of(program: str) -> list[String]:
    let catalog = Catalog.parse("")
    let base = base_from("@builtin(\"String\")\nstruct String:\n    pass\n", catalog)
    let checked = check_file(base, program, catalog, False, {}, True)
    if not checked.beyond.is_empty():
        return checked.beyond
    let typed = checked.typed else:
        return ["nothing to lower"]
    var kept = StdBodies.new()
    var kept_lowered = StdLowered.new()
    var kept_slots = StdSlots.new()
    return lower(
        typed,
        base,
        "main.sisu",
        CONTRACTS_ALL,
        catalog,
        mut kept,
        mut kept_lowered,
        mut kept_slots,
        [],
    ).beyond

test "comptime expressions and contracts are within the slice of lowering":
    assert beyond_of("def main():\n    let x = 1\n").is_empty()
    assert beyond_of("def main():\n    let x = comptime 6 * 7\n").is_empty()
    var kept: String = "struct Account:\n    balance: int\n    invariant self.balance >= 0\n\n"
    kept.push("    def set(mut self, b: int):\n        self.balance = b\n\n")
    kept.push("def main():\n    var a = Account(balance=1)\n    a.set(2)\n")
    assert beyond_of(kept).is_empty()

## The SIR of each program, lowered one after another in one run keeping
## what a run keeps (`StdBodies`, `StdLowered`, `StdSlots`), or why it is
## not lowered.
pure def lowered_in_turn(prelude: str, programs: list[String]) -> list[String]:
    let catalog = Catalog.parse("")
    let base = base_from(prelude, catalog)
    var kept = StdBodies.new()
    var kept_lowered = StdLowered.new()
    var kept_slots = StdSlots.new()
    var out: list[String] = []
    for program in programs:
        let checked = check_file(base, program, catalog, False, {}, True)
        let typed = checked.typed else:
            out.push("nothing to lower")
            continue
        let lowered = lower(
            typed,
            base,
            "main.sisu",
            CONTRACTS_ALL,
            catalog,
            mut kept,
            mut kept_lowered,
            mut kept_slots,
            [],
        )
        if lowered.beyond.is_empty():
            out.push(write.write(lowered.program))
        else:
            out.push(lowered.beyond.join("\n"))
    return out

test "a body of the standard library lowers the same whichever program reaches it first":
    # Two traits with a method of one name: a call of it on an `int` asks
    # whether `int` implements each, through every impl of each.
    var prelude: String = "trait Show:\n    def show(self) -> int\n\n"
    prelude.push("trait Size:\n    def show(self) -> int\n\n")
    prelude.push("impl Show for int:\n    def show(self) -> int:\n        return self\n\n")
    prelude.push("impl Size for bool:\n    def show(self) -> int:\n        return 1\n\n")
    prelude.push("def twice(x: int) -> int:\n    return x.show() + x.show()\n")
    # A program with an impl of the prelude's trait for a type of its own.
    var with_impl: String = "struct Point:\n    x: int\n\n"
    with_impl.push("impl Size for Point:\n    def show(self) -> int:\n        return self.x\n\n")
    with_impl.push("def main():\n    let p = Point(x=twice(1))\n    _ = p.show()\n")
    let plain = "def main():\n    _ = twice(2)\n".to_string()
    let first = lowered_in_turn(prelude, [with_impl.copy(), plain.copy()])
    let second = lowered_in_turn(prelude, [plain.copy(), with_impl.copy()])
    assert first[0].contains("fn twice(1)")
    assert first[0] == second[1]
    assert first[1] == second[0]
