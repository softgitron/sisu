##! The type checker (stage 0's `sisu-typeck/src/lib.rs`): the
##! declarations of a file resolved against the prelude (`typeck.collect`),
##! then each body of its root module checked (`typeck.check`,
##! `typeck.expr`, `typeck.call`, `typeck.pat`, `typeck.contracts`,
##! `typeck.tasks`), with the checks of the bounds the bodies required, of
##! `main`'s and the tests' signatures, and of parameter defaults and
##! constants. The error sets of the `T !` functions are inferred first,
##! to a fixpoint.
##!
##! It reports the type checker's own messages (the identifiers that begin
##! with `type.`), as `sisu check --format=ids` writes them, in the order
##! stage 0 sorts them. A body that uses something beyond the slice reports
##! nothing; `Checked.beyond` says why, so that a file with nothing beyond
##! the slice must match stage 0 exactly and any other a subset.
##!
##! Stage 0's ownership checker reports a few `type.` messages too (E0333,
##! E0366, E0367, E0392, E0393, E0397); it runs only when the front end
##! found no error. A body that may get one of them notes why
##! (`owner_beyond`): the file is beyond the slice unless an error was
##! found.

import stage1.typeck.call
import stage1.typeck.contracts
import stage1.typeck.expr
import stage1.typeck.instances
import stage1.typeck.pat
import stage1.typeck.tasks
from stage1.diag import Catalog, Diagnostic, Edit, Lines, Msg, TextRange, render_ids, sort_unique
from stage1.parser import parse
from stage1.syntax.ast import Ast, Block, ExprId, Mode, Module
from stage1.syntax.ast import build
from stage1.typeck.check import Checker, Cx, Finished, RetCtx
from stage1.typeck.collect import Resolver
from stage1.typeck.contracts import leading_contracts
from stage1.typeck.program import Answer, DefKind, FnKind, ModuleId, ParamInfo, Program, Request
from stage1.typeck.std_sources import builtin_impls, target
from stage1.typeck.tasks import has_yield
from stage1.typeck.template import Templates
from stage1.typeck.thir import (
    BlockId,
    BodyKind,
    Callee,
    Capture,
    ClosureId,
    ClosureRole,
    ForMode,
    TArmBody,
    TBody,
    TClosure,
    TCompClause,
    TExprId,
    TExprKind,
    TLetElse,
    TStmt,
)
from stage1.typeck.ty import DefId, TraitRef, Ty, TyData, Types

## The prelude and the std modules every file sees, resolved once, and the
## prelude's derive templates, kept apart so that they are not copied for
## each file.
pub struct Base:
    pub resolver: Resolver
    pub templates: Templates
    ## The syntax of the modules the base resolved, by module, for the std
    ## bodies lowering reaches.
    pub std_syntax: list[Module]
    ## The source of each std module, by name.
    pub texts: dict[String, String]

## The prelude and the std modules every file sees, resolved once: `texts`
## gives the source of each std module by name.
pub pure def base(texts: dict[String, String]) -> Base:
    var r = Resolver.base(texts)
    let templates = r.std_derives.copy()
    r.std_derives = Templates.none()
    let std_syntax = r.std_kept.copy()
    r.std_kept = []
    return Base(resolver=r, templates=templates, std_syntax=std_syntax, texts=texts.copy())

## A base of a prelude of the given text alone (for the tests).
pub pure def base_from(prelude_text: str) -> Base:
    var texts: dict[String, String] = {}
    _ = texts.insert("prelude".to_string(), prelude_text.to_string())
    var r = Resolver.base_from(prelude_text)
    let std_syntax = r.std_kept.copy()
    r.std_kept = []
    return Base(resolver=r, templates=Templates.none(), std_syntax=std_syntax, texts=texts)

## The type diagnostics of one file: those in the file, then those in each
## file the compiler wrote for it whose bodies are checked (its doc
## examples' module, its derived impls, the instances of templates), each
## with that file's text, in the order stage 0 makes the files; and why
## parts of it are beyond the slice (empty when the whole file is within
## it).
pub struct Checked:
    pub diagnostics: list[Diagnostic]
    pub files: list[(String, list[Diagnostic])]
    pub beyond: list[String]
    ## Those of `beyond` that are only the ownership checker's: a body that
    ## may get one of its `type.` messages, checked whole otherwise.
    pub owner_beyond: list[String]
    ## Whether the front end finds an error, as far as stage 1 knows: its
    ## own, or one stage 0 reports that is not the type checker's.
    pub has_error: bool
    ## What lowering reads, when it asked for it.
    pub typed: Typed?

## What lowering reads of a checked file (stage 0's `Program` and
## `Typed`): the resolved program, the table of types, and the typed bodies
## in stage 0's order (the root module's functions, then the other
## modules', each by definition, then the defaults of fields and
## parameters and the constants, by definition), with the text of each
## module whose bodies were checked.
pub struct Typed:
    pub prog: Program
    pub types: Types
    pub bodies: list[TBody]
    pub texts: dict[ModuleId, String]
    ## The functions the compiler wrote from code checked elsewhere too.
    pub quiet: set[DefId]
    ## The impls of `@delegate`, which stage 1 declares as headers.
    pub delegated: set[DefId]
    ## The syntax of each module (empty for those the base resolved, whose
    ## syntax `Base.std_syntax` holds), and the inferred error sets.
    pub syntax: list[Module]
    pub inferred: dict[DefId, list[DefId]]
    ## An item of the root module is `@refines(...)`.
    pub refines: bool

## The type diagnostics of a file, rendered as `sisu check --format=ids`
## writes them: each position in its own file's lines and columns.
pub pure def render(text: str, checked: Checked, catalog: Catalog) -> String:
    var out = render_ids(text, checked.diagnostics, catalog)
    for (t, ds) in checked.files:
        out.push(render_ids(t, ds, catalog))
    return out

## What checking one body left, but the table of types, which the next
## body's check continues.
struct BodyResult:
    diags: list[Diagnostic]
    beyond: String?
    owner_beyond: String?
    other_error: bool
    absorbed: list[DefId]
    requests: list[Request]
    typed: TBody?

pure def result_of(done: Finished) -> BodyResult:
    return BodyResult(
        diags=done.diags.copy(),
        beyond=done.beyond.copy(),
        owner_beyond=done.owner_beyond.copy(),
        other_error=done.other_error,
        absorbed=done.absorbed.copy(),
        requests=done.requests.copy(),
        typed=done.typed.copy(),
    )

## What checking the bodies of one file gave: the diagnostics, why bodies
## are beyond the slice, why the ownership checker may report about
## them, and whether stage 0 reports an error that is not the type
## checker's.
struct Bodies:
    diags: list[Diagnostic]
    beyond: list[String]
    owner_beyond: list[String]
    other_error: bool

impl Bodies:
    pure def new() -> Bodies:
        return Bodies(diags=[], beyond=[], owner_beyond=[], other_error=False)

    ## Adds what checking one body left; a body beyond the slice reports
    ## nothing, and a body the compiler wrote from code checked elsewhere
    ## too reports nothing of its own.
    pure def add(mut self, done: BodyResult, quiet: bool):
        if let Some(why) = done.owner_beyond:
            self.owner_beyond.push(why.copy())
        if quiet:
            return
        match done.beyond:
            case Some(why):
                self.beyond.push(why.copy())
            case None:
                if done.other_error:
                    self.other_error = True
                for x in done.diags:
                    self.diags.push(x.copy())

    pure def absorb(mut self, other: Bodies):
        for d in other.diags:
            self.diags.push(d.copy())
        for w in other.beyond:
            self.beyond.push(w.copy())
        for w in other.owner_beyond:
            self.owner_beyond.push(w.copy())
        if other.other_error:
            self.other_error = True

## The most rounds of checking and declaring instances (stage 0's
## `MAX_ROUNDS`): a template whose instances need ever larger types stops.
const MAX_ROUNDS: int = 32

## What one round of checking a resolved file gave: the table of types,
## the bodies of each file with their diagnostics (the root module's
## first, with the signatures of `main` and the tests, then the doc
## examples' module and the modules written from templates, each with its
## text), and the requests the bodies made.
struct Round:
    types: Types
    main: Bodies
    files: list[(String, Bodies)]
    requests: list[Request]
    ## The typed bodies, when lowering asked for them.
    typed: list[TBody]
    texts: dict[ModuleId, String]
    inferred: dict[DefId, list[DefId]]

## Checks one file against the resolved prelude. `name_error` says
## whether stage 0's name pass reports an error in it; `keep` asks for
## what lowering reads.
pub pure def check_file(
    base: Base,
    text: str,
    catalog: Catalog,
    name_error: bool,
    embedded: dict[String, bool],
    keep: bool,
) -> Checked:
    let parsed = parse(text, catalog)
    let module = build.module(parsed.tree)
    # The instances of templates the program needs (08, "Reflection"):
    # check, declare what the check asked for, and check again, until it
    # asks for nothing new. An instance is declared after everything else,
    # so a round's declarations stand in the next; a promotion (a generic
    # function that calls a template with its own type parameters becomes
    # one) changes a declaration, and resolves again (stage 0's
    # `Db::checked`).
    var requests: list[Request] = []
    var rounds = 0
    while True:
        var r = base.resolver.copy()
        r.prog.embedded = embedded.copy()
        r.catalog = catalog.copy()
        for q in requests:
            if let Request.Promote(d) = q:
                _ = r.promoted.add(d)
        r.add_root(module.copy(), text, base.templates)
        # A declaration beyond the slice changes how the bodies type: none
        # of them is checked.
        if let Some(why) = r.beyond:
            return Checked(
                diagnostics=[],
                files=[],
                beyond=[why.copy()],
                owner_beyond=[],
                has_error=False,
                typed=None,
            )
        r.declare_instances(requests)
        var memo: dict[DefId, BodyResult] = {}
        var again = False
        while not again:
            let round = check_round(r, text, catalog, mut memo, keep)
            var fresh: list[Request] = []
            for q in round.requests:
                if not has_request(requests, q) and not has_request(fresh, q):
                    fresh.push(q.copy())
            rounds += 1
            if fresh.is_empty() or rounds > MAX_ROUNDS:
                # Past the bound, `comptime.instances-unbounded`.
                let unbounded = not fresh.is_empty()
                var checked = finish_file(
                    r, round, parsed.diagnostics, text, catalog, name_error, unbounded
                )
                if keep:
                    checked.typed = Some(
                        Typed(
                            prog=r.prog,
                            types=round.types,
                            bodies=round.typed,
                            texts=round.texts,
                            quiet=r.quiet_fns,
                            delegated=r.delegated,
                            syntax=r.sources,
                            inferred=round.inferred,
                            refines=r.refines,
                        )
                    )
                return checked
            for q in fresh:
                requests.push(q.copy())
                if let Request.Promote(_) = q:
                    again = True
            if not again:
                r.types = round.types
                r.declare_instances(fresh)

pure def has_request(qs: list[Request], q: Request) -> bool:
    for x in qs:
        if x.same(q):
            return True
    return False

## Checks every body of the file once: its functions but the templates,
## those of the modules the compiler wrote for it, the defaults of fields
## and parameters and the constants, after the error sets of the `T !`
## functions are inferred; and `main`'s and the tests' signatures. A
## function's body is checked once a resolution (`memo`).
pure def check_round(
    r: Resolver, text: str, catalog: Catalog, mut memo: dict[DefId, BodyResult], keep: bool
) -> Round:
    let prog = ref r.prog
    let root_id = prog.root
    var types = r.types.copy()
    # The modules whose bodies are checked, each with its syntax and text,
    # in the order stage 0 makes their files.
    var modules: list[(ModuleId, String)] = [(root_id, text.to_string())]
    if let Some(dm) = r.doc_module:
        modules.push((dm, r.doc_text.copy()))
    for (m, t) in r.generated:
        modules.push((m, t.copy()))
    var at_module: dict[ModuleId, int] = {}
    for i in range(len(modules)):
        _ = at_module.insert(modules[i].0, i)
    # Every function with a body, the root module's first (stage 0's
    # `functions_with_bodies`); a template is checked in its instances.
    var fns: list[DefId] = []
    var inferred_fns: list[DefId] = []
    for pass_ in range(2):
        for i in range(len(prog.defs)):
            let m = prog.defs[i].module
            if not at_module.contains(m) or (m == root_id) != (pass_ == 0):
                continue
            let d = DefId(index=i)
            let f = prog.fn_info(d) else:
                continue
            if f.body.is_none() or f.template:
                continue
            # The impls the prelude's templates derive check whenever the
            # derive's checks pass (`check_derives` removes their bodies
            # otherwise): stage 1 trusts them, as stage 0's ownership
            # checker trusts std, and declares them for what follows.
            if prelude_derived(prog, d):
                continue
            fns.push(d)
            if f.err_inferred:
                inferred_fns.push(d)
    # Inferred error sets: iterate to a fixpoint over the functions that
    # declare `T !`, each pass using the sets known so far (05).
    var inferred: dict[DefId, list[DefId]] = {}
    for d in inferred_fns:
        _ = inferred.insert(d, [])
    for _ in range(32):
        var changed = False
        for d in inferred_fns:
            let (ast, src) = syntax_of(r, modules, at_module, d)
            let done = check_one(prog, ast, src, inferred, types, d, catalog, False)
            let absorbed = done.absorbed.copy()
            types = done.types
            var before: list[DefId] = []
            if let Some(x) = inferred.get(d):
                before = x.copy()
            if before != absorbed:
                _ = inferred.insert(d, absorbed)
                changed = True
        if not changed:
            break
    var main = Bodies.new()
    main.other_error = r.other_error
    for (m, d) in r.diags:
        if m == root_id:
            main.diags.push(d.copy())
    var files: list[Bodies] = []
    for _ in range(len(modules)):
        files.push(Bodies.new())
    var requests: list[Request] = []
    var typed: list[TBody] = []
    for d in fns:
        var result: BodyResult? = None
        if let Some(x) = memo.get(d):
            result = Some(x.copy())
        if result.is_none():
            let (ast, src) = syntax_of(r, modules, at_module, d)
            let done = check_one(prog, ast, src, inferred, types, d, catalog, keep)
            let x = result_of(done)
            types = done.types
            _ = memo.insert(d, x.copy())
            result = Some(x)
        let x = result ?? continue_never()
        if let Some(t) = x.typed:
            typed.push(t.copy())
        for q in x.requests:
            if not has_request(requests, q):
                requests.push(q.copy())
        let at = at_module.get(prog.defs[d.index].module) ?? 0
        files[at].add(x, r.quiet_fns.contains(d))
    # Defaults of fields and parameters, and constants.
    for i in range(len(prog.defs)):
        let d = DefId(index=i)
        let at = at_module.get(prog.defs[i].module) else:
            continue
        var values: list[(ExprId, Ty, DefId?, BodyKind)] = []
        match prog.defs[i].kind:
            case DefKind.Struct(s):
                for k in range(len(s.fields)):
                    if let Some(e) = s.fields[k].default:
                        values.push((e, s.fields[k].ty, Some(d), BodyKind.FieldDefault(d, k)))
            case DefKind.Fn(f):
                for k in range(len(f.params)):
                    if let Some(e) = f.params[k].default:
                        values.push((e, f.params[k].ty, None, BodyKind.ParamDefault(d, k)))
            case DefKind.Const(c):
                if let Some(e) = c.value:
                    values.push((e, c.ty, None, BodyKind.Const))
            case _:
                pass
        for (e, ty, field_of, kind) in values:
            let (ast, src) = syntax_of(r, modules, at_module, d)
            let done = check_value(
                prog, ast, src, inferred, types, d, e, ty, field_of, catalog, kind, keep
            )
            let x = result_of(done)
            types = done.types
            if let Some(t) = x.typed:
                typed.push(t.copy())
            for q in x.requests:
                if not has_request(requests, q):
                    requests.push(q.copy())
            files[at].add(x, False)
    # `main` takes nothing or one `System`, and returns nothing or `! E`.
    if let Some(main_fn) = prog.main():
        if let Some(f) = prog.fn_info(main_fn):
            let params_ok = takes_system(prog, types, f.params)
            var ret_ok = f.ret == Ty.unit()
            if let TyData.Adt(d, a) = types.data(f.ret):
                if Some(d) == prog.wk.result and not a.is_empty() and a[0] == Ty.unit():
                    ret_ok = True
            if not params_ok or not ret_ok or f.self_mode.is_some():
                let span = prog.defs[main_fn.index].span
                main.diags.push(Diagnostic.new(Msg.TypeMainSignature, span.start, span.end))
    # A test takes nothing, or the real `System`.
    for t in prog.tests:
        if prog.defs[t.index].module != root_id:
            continue
        let f = prog.fn_info(t) else:
            continue
        let ok = takes_system(prog, types, f.params)
        if not ok and not f.header_broken:
            var span = prog.defs[t.index].span
            if let Some(p) = f.params.first():
                span = p.span
            main.diags.push(Diagnostic.new(Msg.TypeTestSignature, span.start, span.end))
    # The root module's bodies are the file's; the others are files of
    # their own.
    main.absorb(files[0])
    var others: list[(String, Bodies)] = []
    for i in range(1, len(modules)):
        others.push((modules[i].1.copy(), files[i].copy()))
    var texts: dict[ModuleId, String] = {}
    if keep:
        for (m, t) in modules:
            _ = texts.insert(m, t.copy())
        for (m, t) in r.shims:
            _ = texts.insert(m, t.copy())
    return Round(
        types=types,
        main=main,
        files=others,
        requests=requests,
        typed=typed,
        texts=texts,
        inferred=inferred,
    )

## Never called: the `else` of a `let` whose value is always there.
pure def continue_never() -> BodyResult:
    return BodyResult(
        diags=[],
        beyond=None,
        owner_beyond=None,
        other_error=False,
        absorbed=[],
        requests=[],
        typed=None,
    )

## The syntax and the text a definition's body is checked with: its
## module's.
pure def syntax_of(
    r: Resolver, modules: list[(ModuleId, String)], at_module: dict[ModuleId, int], d: DefId
) -> (ref Ast, str) from r, modules:
    let m = r.prog.defs[d.index].module
    let at = at_module.get(m) ?? 0
    return (ref r.sources[m.index].ast, modules[at].1)

## The diagnostics of a file from its last round of checking: why parts of
## it are beyond the slice, those of the ownership checker's when the front
## end found no error, the file's own on the lines without a syntax error,
## and each other file's, sorted and with repeats dropped.
pure def finish_file(
    r: Resolver,
    round: Round,
    syntax: list[Diagnostic],
    text: str,
    catalog: Catalog,
    name_error: bool,
    unbounded: bool,
) -> Checked:
    var bodies = round.main.copy()
    if name_error or unbounded:
        bodies.other_error = True
    for d in syntax:
        if catalog.is_error(d.msg):
            bodies.other_error = True
    var beyond: list[String] = []
    var owner_beyond: list[String] = bodies.owner_beyond.copy()
    for why in bodies.beyond:
        beyond.push(why.copy())
    var any_error = bodies.other_error
    for d in bodies.diags:
        if catalog.is_error(d.msg):
            any_error = True
    for (_, b) in round.files:
        for why in b.beyond:
            beyond.push(why.copy())
        for why in b.owner_beyond:
            owner_beyond.push(why.copy())
        if b.other_error:
            any_error = True
        for d in b.diags:
            if catalog.is_error(d.msg):
                any_error = True
    # Stage 0's ownership checker runs when the front end found no error.
    var owned: list[String] = []
    if not any_error:
        for why in owner_beyond:
            let reason = "{why}, which stage 0's ownership checker checks"
            beyond.push(reason.copy())
            owned.push(reason)
    # A line with a syntax error has no reliable meaning.
    let lines = Lines.of(text)
    var broken: set[int] = set()
    for d in syntax:
        _ = broken.add(lines.index(d.start))
    var kept: list[Diagnostic] = []
    for d in bodies.diags:
        if not broken.contains(lines.index(d.start)):
            kept.push(d.copy())
    sort_unique(mut kept, catalog)
    # The other files are files the compiler wrote: their diagnostics are
    # kept whatever the file's syntax errors.
    var files: list[(String, list[Diagnostic])] = []
    for (t, b) in round.files:
        var ds = b.diags.copy()
        if ds.is_empty():
            continue
        sort_unique(mut ds, catalog)
        files.push((t.copy(), ds))
    return Checked(
        diagnostics=kept,
        files=files,
        beyond=beyond,
        owner_beyond=owned,
        has_error=any_error,
        typed=None,
    )

## Checks one function body.
pure def check_one(
    prog: Program,
    ast: Ast,
    text: str,
    inferred: dict[DefId, list[DefId]],
    own types: Types,
    d: DefId,
    catalog: Catalog,
    keep: bool,
) -> Finished:
    let cx = Cx(prog=ref prog, ast=ref ast, source=text, inferred=ref inferred, catalog=ref catalog)
    var c = Checker.new(cx, types, d)
    c.check_fn(cx)
    c.requests = c.template_requests(cx)
    var typed: TBody? = None
    if keep:
        let span = prog.defs[d.index].span
        typed = Some(c.typed_body(cx, BodyKind.Fn, span))
    var done = c.finish()
    done.typed = typed
    return done

## Checks a default value or a constant as a body returning it.
pure def check_value(
    prog: Program,
    ast: Ast,
    text: str,
    inferred: dict[DefId, list[DefId]],
    own types: Types,
    d: DefId,
    e: ExprId,
    ty: Ty,
    field_of: DefId?,
    catalog: Catalog,
    kind: BodyKind,
    keep: bool,
) -> Finished:
    let cx = Cx(prog=ref prog, ast=ref ast, source=text, inferred=ref inferred, catalog=ref catalog)
    var c = Checker.new(cx, types, d)
    c.check_value(cx, e, ty, field_of)
    c.requests = c.template_requests(cx)
    var typed: TBody? = None
    if keep:
        var span = TextRange.new(0, 0)
        if let Some(b) = c.body_block:
            span = c.blocks[b.index].span
        typed = Some(c.typed_body(cx, kind, span))
    var done = c.finish()
    done.typed = typed
    return done

## A body of the standard library that lowering reaches, checked as stage
## 0 checks it, with its module's syntax and text; `None` when it uses
## something beyond the type checker's slice. The table of types comes
## back with what checking added.
pub pure def check_std_body(
    base: Base, typed: Typed, own types: Types, d: DefId, kind: BodyKind, catalog: Catalog
) -> (TBody?, Types):
    let prog = ref typed.prog
    let m = prog.defs[d.index].module
    var syntax = Module(ast=Ast.new(), items=[], docs=[], broken_names=[])
    if m.index < len(typed.syntax) and not typed.syntax[m.index].items.is_empty():
        syntax = typed.syntax[m.index].copy()
    elif m.index < len(base.std_syntax):
        syntax = base.std_syntax[m.index].copy()
    var text = std_text(base, prog, m)
    if let Some(t) = typed.texts.get(m):
        text = t.copy()
    if kind == BodyKind.Fn:
        let done = check_one(prog, syntax.ast, text, typed.inferred, types, d, catalog, True)
        if done.beyond.is_some():
            return (None, done.types)
        return (done.typed, done.types)
    var e: ExprId? = None
    var ty = Ty.error()
    var field_of: DefId? = None
    match prog.defs[d.index].kind:
        case DefKind.Struct(s):
            if let BodyKind.FieldDefault(_, i) = kind:
                e = s.fields[i].default
                ty = s.fields[i].ty
                field_of = Some(d)
        case DefKind.Fn(f):
            if let BodyKind.ParamDefault(_, i) = kind:
                e = f.params[i].default
                ty = f.params[i].ty
        case DefKind.Const(c):
            e = c.value
            ty = c.ty
        case _:
            pass
    let x = e else:
        return (None, types)
    let done = check_value(
        prog, syntax.ast, text, typed.inferred, types, d, x, ty, field_of, catalog, kind, True
    )
    if done.beyond.is_some():
        return (None, done.types)
    return (done.typed, done.types)

## The text of a std module.
pub pure def std_text(base: Base, prog: Program, m: ModuleId) -> String:
    let name = ref prog.modules[m.index].name
    if name == "target":
        return target()
    if name == "builtin_impls":
        return builtin_impls()
    if let Some(x) = base.texts.get(name.copy()):
        return x.copy()
    return String.new()

## Whether a function is a method of an impl the compiler derived from a
## template of the prelude (`Debug`, `Eq`, `PartialOrd`, `Ord`, `Hash`).
pure def prelude_derived(prog: Program, d: DefId) -> bool:
    let f = prog.fn_info(d) else:
        return False
    let i = f.impl_ else:
        return False
    if not prog.modules[prog.defs[d.index].module.index].name.starts_with("<derive>/"):
        return False
    let info = prog.impl_info(i) else:
        return False
    return prog.defs[info.trait_ref.def_.index].module == prog.prelude

## Whether a definition is a template, checked in its instances.
pure def is_template(prog: Program, d: DefId) -> bool:
    if let Some(f) = prog.fn_info(d):
        return f.template
    return False

## Whether the template `d` has an instance for `args`.
pure def instance_declared(prog: Program, d: DefId, args: list[Ty]) -> bool:
    for (t, a, _) in prog.instances:
        if t == d and a == args:
            return True
    return False

## Whether parameters are none, or one `System`.
pure def takes_system(prog: Program, types: Types, params: list[ParamInfo]) -> bool:
    if params.is_empty():
        return True
    return len(params) == 1 and is_system(prog, types, params[0].ty)

## Whether a type is the prelude's `System`.
pure def is_system(prog: Program, types: Types, t: Ty) -> bool:
    if let TyData.Adt(d, _) = types.data(t):
        return Some(d) == prog.wk.system
    return False

## The type checker's messages that are warnings.
pure def is_warning(m: Msg) -> bool:
    return m == Msg.TypeHole or m == Msg.TypeUnreachableCode or m == Msg.TypeUnreachableArm

## Where `pure ` is written before a function's name on its line: the
## edit that removes it.
pure def remove_pure_edit(text: str, name_at: int) -> Edit?:
    if name_at > text.byte_len():
        return None
    var line_start = name_at
    while line_start > 0 and text.byte_at(line_start - 1) != 10:
        line_start -= 1
    var i = line_start
    while i + 5 <= name_at:
        if text.byte_slice(i, i + 5) == "pure ":
            return Some(Edit(start=i, end=i + 5, text=String.new()))
        i += 1
    return None

impl Checker:
    ## Checks one function body (stage 0's `check_fn`).
    pub pure def check_fn(mut self, cx: Cx):
        let f = cx.prog.fn_info(self.def_) else:
            return
        let body_full = f.body.copy() else:
            return
        self.self_ty = f.owner
        self.env = cx.prog.elaborate_env(mut self.types, f.predicates)
        for g in f.generics:
            self.generic_names.push(g.name.copy())
            self.const_generics.push(g.is_const)
        let def_span = cx.prog.defs[self.def_.index].span
        # A generator: its `return` gives nothing, and calling it makes the
        # `Iter` it declares.
        var generator: Ty? = None
        if has_yield(cx.ast, body_full):
            let declared = self.fn_ret(cx, self.def_)
            var item: Ty? = None
            if let TyData.Adt(d, a) = self.types.data(declared):
                if Some(d) == cx.prog.wk.iter and len(a) == 1:
                    item = Some(a[0])
            match item:
                case Some(t):
                    generator = Some(t)
                case None:
                    let span = f.ret_span ?? def_span
                    let name = cx.prog.defs[self.def_.index].name.copy()
                    let shown = cx.prog.display(self.types, declared)
                    let d = Diagnostic.new(Msg.TypeGeneratorResult, span.start, span.end)
                    self.report(d.with("name", name).with("ty", shown))
                    # Checked as a generator of unknown items, so the one
                    # mistake is reported once.
                    generator = Some(Ty.error())
        self.generator = generator
        var ret = Ty.error()
        if generator.is_some():
            ret = Ty.unit()
        elif f.err_inferred:
            var ok = Ty.unit()
            if let TyData.Adt(_, a) = self.types.data(f.ret):
                ok = a.first() ?? Ty.unit()
            let e = self.infer.fresh_absorbing(mut self.types)
            if let Some(r) = cx.prog.wk.result:
                ret = self.types.adt(r, [ok, e])
        else:
            ret = self.fn_ret(cx, self.def_)
        self.ret.push(RetCtx(ty=ret, closure=None, first_local=0, loops=0, captures=[]))
        var params: list[int] = []
        if let Some(mode) = f.self_mode:
            let owner = f.owner ?? Ty.error()
            let ty = self.param_local_ty(cx, owner, mode)
            let l = self.new_local("self", ty, False, def_span)
            self.declare("self", l)
            params.push(l)
        for p in f.params:
            let ty = self.param_local_ty(cx, p.ty, p.mode)
            if f.pure and cx.prog.is_capability(self.types, p.ty):
                let name = cx.prog.defs[self.def_.index].name.copy()
                let shown = cx.prog.display(self.types, p.ty)
                var d = Diagnostic.new(Msg.TypeImpureCapability, p.span.start, p.span.end)
                d = d.with("name", name).with("ty", shown)
                # `pure ` before `def` on the header's line goes.
                if let Some(edit) = remove_pure_edit(cx.source, def_span.start):
                    d = d.fix_edits(Msg.TypeRemovePure, [edit])
                self.report(d)
            let l = self.new_local(p.name, ty, False, p.span)
            self.declare(p.name, l)
            params.push(l)
        self.params = params.copy()
        self.body_ret = ret
        # The contract: the clauses the body starts with (07).
        let clauses = leading_contracts(cx.ast, body_full)
        var is_test = False
        if let FnKind.Test(_) = f.kind:
            is_test = True
        self.check_contracts(cx, is_test, clauses, ret)
        var stmts = body_full.stmts.copy()
        if not clauses.is_empty():
            stmts = []
            for k in range(len(clauses), len(body_full.stmts)):
                stmts.push(body_full.stmts[k])
        let body = Block(node=body_full.node, range=body_full.range, stmts=stmts)
        var block = self.check_block_in_scope(cx, body)
        let r = self.infer.zonk(mut self.types, ret)
        # A generator's body becomes a task-like closure that owns the
        # parameters; the function returns the iterator that runs it.
        if generator.is_some():
            let id = ClosureId(index=len(self.closures))
            var captures: list[Capture] = []
            for l in params:
                captures.push(Capture(local=l, mutable=False, by_value=True))
            let fn_ty = self.types.fn_([], Ty.unit(), f.pure)
            let span = self.blocks[block.index].span
            self.closures.push(
                Some(
                    TClosure(
                        params=[],
                        captures=captures,
                        own_=True,
                        ret=Ty.unit(),
                        body=block,
                        span=span,
                        fn_ty=fn_ty,
                        comptime_=False,
                        role=ClosureRole.Task,
                    )
                )
            )
            let gen_ty = self.fn_ret(cx, self.def_)
            self.body_ret = gen_ty
            let value = self.add(TExprKind.Generator(id), gen_ty, span)
            block = self.new_block([TStmt.Return(value=Some(value), span=span)], span)
        self.body_block = Some(block)
        let ends = r == Ty.unit() or r == Ty.never() or r == Ty.error()
        if not ends and not f.body_broken and not self.block_diverges(block):
            let name = cx.prog.defs[self.def_.index].name.copy()
            let shown = cx.prog.display(self.types, r)
            var d = Diagnostic.new(Msg.TypeMissingReturn, def_span.start, def_span.end)
            d = d.with("name", name).with("ty", shown)
            self.report(d)
        self.decide_captures(cx)
        self.check_own_closures(cx)
        self.check_bounds(cx)
        self.check_comptime_types(cx)
        self.report_uninferred(cx)
        # A pure body's calls and drops are checked on SIR, by stage 0's
        # ownership checker (E0333, E0392, E0393).
        if f.pure and self.pure_body_problem(cx, block):
            self.owner_go_beyond("a call or drop in a pure function that may not be pure")
        # So is a generic function's instance for a must-consume type
        # argument (E0397).
        if self.must_consume_generic_call(cx):
            self.owner_go_beyond("a must-consume value given to a generic function")

    ## Checks a default value or a constant as a body returning it.
    pub pure def check_value(mut self, cx: Cx, e: ExprId, ty: Ty, field_of: DefId?):
        if let Some(f) = cx.prog.fn_info(self.def_):
            self.env = cx.prog.elaborate_env(mut self.types, f.predicates)
            for g in f.generics:
                self.generic_names.push(g.name.copy())
        self.field_default_of = field_of
        self.body_ret = ty
        self.ret.push(RetCtx(ty=ty, closure=None, first_local=0, loops=0, captures=[]))
        let x = self.check_expr(cx, e, ty)
        let span = self.span_of(x)
        self.body_block = Some(self.new_block([TStmt.Return(value=Some(x), span=span)], span))
        self.decide_captures(cx)
        self.check_own_closures(cx)
        self.check_bounds(cx)
        self.check_comptime_types(cx)

    ## What the body asks of the next resolution (stage 0's
    ## `template_requests`, for one body): an instance of each template it
    ## calls with concrete type arguments that has none yet, and its own
    ## promotion when it calls one with its own type parameters. A template
    ## used as a value has no instance to be (`comptime.template-value`).
    pub pure def template_requests(mut self, cx: Cx) -> list[Request]:
        var exprs: list[TExprId] = []
        if let Some(b) = self.body_block:
            self.visit_block(b, mut exprs)
        for c in self.closures.copy():
            if let Some(cl) = c:
                self.visit_block(cl.body, mut exprs)
        var out: list[Request] = []
        for e in exprs:
            match self.exprs[e.index].kind.copy():
                case TExprKind.Call(Callee.Fn(def_, type_args), _):
                    if not is_template(cx.prog, def_):
                        continue
                    var param = False
                    var unknown = False
                    var args: list[Ty] = []
                    for t in type_args:
                        let ft = self.finalize(cx, t)
                        for x in self.types.walk(ft):
                            match self.types.data(x):
                                case TyData.Param(_):
                                    param = True
                                case TyData.Var(_) | TyData.Error:
                                    unknown = True
                                case _:
                                    pass
                        args.push(ft)
                    var q = Request.Promote(self.def_)
                    if not param:
                        if unknown or instance_declared(cx.prog, def_, args):
                            continue
                        q = Request.Instance(def_=def_, args=args)
                    var seen = False
                    for x in out:
                        if x.same(q):
                            seen = True
                    if not seen:
                        out.push(q)
                case TExprKind.FnRef(def_):
                    if is_template(cx.prog, def_):
                        self.other()
                case _:
                    pass
        return out

    ## A type as the typed body keeps it (stage 0's `zonk::finalize`): its
    ## variables resolved, one left open `()`, or the empty error set in a
    ## result's error position.
    pub pure def finalize(mut self, cx: Cx, t: Ty) -> Ty:
        let z = self.infer.zonk(mut self.types, t)
        return self.finalized(cx, z)

    pure def finalized(mut self, cx: Cx, t: Ty) -> Ty:
        match self.types.data(t).copy():
            case TyData.Var(_):
                return Ty.unit()
            case TyData.Adt(d, args):
                var out: list[Ty] = []
                let result = Some(d) == cx.prog.wk.result and len(args) == 2
                for i in range(len(args)):
                    if result and i == 1:
                        if let TyData.Var(_) = self.types.data(args[1]):
                            out.push(self.types.err_set([]))
                            continue
                    out.push(self.finalized(cx, args[i]))
                return self.types.adt(d, out)
            case TyData.Tuple(es, labels):
                var out: list[Ty] = []
                for x in es:
                    out.push(self.finalized(cx, x))
                return self.types.intern(TyData.Tuple(elems=out, labels=labels))
            case TyData.Fn(ps, ret, pure):
                var out: list[Ty] = []
                for x in ps:
                    out.push(self.finalized(cx, x))
                let r = self.finalized(cx, ret)
                return self.types.fn_(out, r, pure)
            case TyData.Ref(inner, m):
                let i = self.finalized(cx, inner)
                return self.types.ref_(i, m)
            case _:
                return t

    ## The type of a parameter as a local of its function: a borrowed
    ## parameter is a `ref T` unless `T` is `Copy` (04, rule 2). A borrowed
    ## parameter whose type is a generic parameter, or an associated type
    ## of one, is always a `ref` unless its bounds make it `Copy`.
    pub pure def param_local_ty(mut self, cx: Cx, ty: Ty, mode: Mode) -> Ty:
        match mode:
            case Mode.Own:
                return ty
            case Mode.Mut:
                return self.types.ref_(ty, True)
            case Mode.Borrow:
                var opaque = False
                match self.types.data(ty):
                    case TyData.Param(_) | TyData.Assoc(_, _, _):
                        opaque = True
                    case _:
                        pass
                var copy = False
                if opaque:
                    copy = cx.prog.is_copy_in(mut self.types, ty, self.env)
                else:
                    copy = cx.prog.is_copy(mut self.types, ty)
                if copy:
                    return ty
                return self.types.ref_(ty, False)

    ## Checks the bounds the body's calls and constructs required, once
    ## inference is done: each type must implement its trait (03, "Generic
    ## syntax"; a generic body is checked against its own bounds only).
    pub pure def check_bounds(mut self, cx: Cx):
        self.check_spawns(cx)
        self.check_capabilities(cx)
        self.check_owners(cx)
        var seen: list[(Ty, TraitRef)] = []
        var all: list[(Ty, TraitRef, TextRange, bool)] = []
        for (t, b, s) in self.bounds:
            all.push((t, b.copy(), s, True))
        for (t, b, s) in self.impl_bounds:
            all.push((t, b.copy(), s, False))
        self.bounds = []
        self.impl_bounds = []
        for (ty, bound, span, strict) in all:
            let z = self.infer.zonk(mut self.types, ty)
            let t = cx.prog.normalize(mut self.types, z, self.env)
            var args: list[Ty] = []
            var arg_error = False
            for a in bound.args:
                let za = self.infer.zonk(mut self.types, a)
                let n = cx.prog.normalize(mut self.types, za, self.env)
                if self.types.contains_error(n):
                    arg_error = True
                args.push(n)
            let b = TraitRef(def_=bound.def_, args=args)
            if self.infer.has_vars(mut self.types, t) or self.types.contains_error(t) or arg_error:
                continue
            var dup = False
            for (st, sb) in seen:
                if st == t and sb == b:
                    dup = True
            if dup:
                continue
            var answer = Answer.Unknown
            if strict:
                answer = cx.prog.bound_holds(mut self.types, t, b, self.env)
            else:
                answer = cx.prog.implements(mut self.types, t, b, self.env)
            if answer == Answer.No:
                seen.push((t, b.copy()))
                self.bound_not_satisfied(cx, t, b, span)
            elif Some(b.def_) == cx.prog.wk.hash and not self.types.has_params(t):
                # The host's `dict` and `set` hash and compare keys
                # structurally: a key type with impls of its own would be
                # found by the wrong rule.
                var own_impl: DefId? = None
                for tr in [cx.prog.wk.hash, cx.prog.wk.eq]:
                    if let Some(x) = tr:
                        if own_impl.is_none() and not cx.prog.is_structural(mut self.types, t, x):
                            own_impl = Some(x)
                if let Some(x) = own_impl:
                    seen.push((t, b.copy()))
                    let shown = self.show(cx, t)
                    var d = Diagnostic.new(Msg.TypeStructuralOnly, span.start, span.end)
                    d = d.with("callee", "a `dict` or `set` key")
                    d = d.with("trait", cx.prog.defs[x.index].name).with("ty", shown)
                    self.report(d)

    pure def bound_not_satisfied(mut self, cx: Cx, t: Ty, b: TraitRef, span: TextRange):
        let shown = self.show(cx, t)
        let bound = cx.prog.display_trait_in(self.types, b, self.generic_names)
        var d = Diagnostic.new(Msg.TypeBoundNotSatisfied, span.start, span.end)
        d = d.with("ty", shown).with("bound", bound)
        # Interpolated without `Display`: its `Debug` form shows it.
        if Some(b.def_) == cx.prog.wk.display
                and span.start > 0
                and span.end < cx.source.byte_len():
            let before = cx.source.byte_slice(span.start - 1, span.start)
            let after = cx.source.byte_slice(span.end, span.end + 1)
            if before == "{{" and after == "}}":
                d = d.fix_at(Msg.TypeShowDebug, span.end, span.end, ":?")
        # A type parameter without the bound: bound it.
        if let TyData.Param(i) = self.types.data(t):
            if let Some(edit) = self.bound_edit(cx, i, bound):
                d = d.fix_edits(Msg.TypeAddBound, [edit])
        let fixed = self.missing_impl_fix(cx, d, t, b)
        self.report(fixed)

    ## Reports the first local whose type inference left open, when the
    ## body has no error.
    pub pure def report_uninferred(mut self, cx: Cx):
        if self.other_error:
            return
        for d in self.diags:
            if not is_warning(d.msg):
                return
        for i in range(len(self.locals)):
            let name = self.locals[i].name.copy()
            if name == "?" or name.is_empty():
                continue
            if self.infer.has_vars(mut self.types, self.locals[i].ty):
                let span = self.locals[i].span
                let d = Diagnostic.new(Msg.TypeCannotInfer, span.start, span.end).with("name", name)
                self.report(d)
                return
        _ = cx

    ## What a `comptime` expression computes cannot depend on the
    ## function's type arguments, which are known only when it is called
    ## (`comptime.not-constant`).
    pub pure def check_comptime_types(mut self, cx: Cx):
        let sites = self.comptime_sites.copy()
        self.comptime_sites = []
        for (id, _) in sites:
            let cl = self.closures[id.index].copy() else:
                continue
            var tys: list[Ty] = [cl.ret]
            var exprs: list[TExprId] = []
            self.visit_block(cl.body, mut exprs)
            for x in exprs:
                tys.push(self.ty_of(x))
                if let TExprKind.Call(callee, _) = self.exprs[x.index].kind:
                    if let Callee.Fn(_, targs) = callee:
                        for a in targs:
                            tys.push(a)
            var param = False
            for t in tys:
                let z = self.infer.zonk(mut self.types, t)
                for w in self.types.walk(z):
                    if let TyData.Param(_) = self.types.data(w):
                        param = True
            if param:
                self.other()
        _ = cx

    ## Whether the body calls a generic function that has a body with a
    ## must-consume type argument.
    pure def must_consume_generic_call(mut self, cx: Cx) -> bool:
        for i in range(len(self.exprs)):
            var targs: list[Ty] = []
            var callee: DefId? = None
            if let TExprKind.Call(Callee.Fn(d, ts), _) = self.exprs[i].kind:
                callee = Some(d)
                targs = ts.copy()
            let d = callee else:
                continue
            let f = cx.prog.fn_info(d) else:
                continue
            if f.body.is_none() and f.trait_.is_none():
                continue
            for t in targs:
                let z = self.infer.zonk(mut self.types, t)
                if not self.types.has_params(z) and cx.prog.must_consume_ty(mut self.types, z, 0):
                    return True
        return False

    ## Whether a pure body may call something that is not `pure` or drop
    ## a value whose `Drop` is not: an impure function or function value,
    ## `select`, a loop over an `Iterator` (whose `next` is not `pure`),
    ## in the body or a closure it makes, or a local or a temporary of a
    ## type whose drop runs a `drop` that is not `pure`.
    pure def pure_body_problem(mut self, cx: Cx, block: BlockId) -> bool:
        var tys: list[Ty] = []
        for l in self.locals:
            tys.push(l.ty)
        for x in self.exprs:
            tys.push(x.ty)
        for t in tys:
            let z = self.infer.zonk(mut self.types, t)
            if cx.prog.drops_impure(mut self.types, z, 0):
                return True
        if self.first_impure_in_block(cx, block).is_some() or self.trait_loop_in(block):
            return True
        for c in self.closures:
            if let Some(cl) = c:
                if cl.comptime_:
                    continue
                if self.first_impure_in_block(cx, cl.body).is_some() or self.trait_loop_in(cl.body):
                    return True
        return False

    ## Whether a block, or a block inside it, loops over an `Iterator`.
    pure def trait_loop_in(self, b: BlockId) -> bool:
        var exprs: list[TExprId] = []
        self.visit_block(b, mut exprs)
        for x in exprs:
            match self.exprs[x.index].kind:
                case TExprKind.Comprehension(_, clauses, _, _):
                    for c in clauses:
                        if let TCompClause.For(_, _, ForMode.Trait, _) = c:
                            return True
                case _:
                    pass
        return self.trait_loop_stmts(b)

    pure def trait_loop_stmts(self, b: BlockId) -> bool:
        for s in self.blocks[b.index].stmts:
            var inner: list[BlockId] = []
            match s:
                case TStmt.For(_, _, mode, _, body, _):
                    if mode == ForMode.Trait:
                        return True
                    inner.push(body)
                case TStmt.If(branches, else_, _):
                    for (_, x) in branches:
                        inner.push(x)
                    if let Some(x) = else_:
                        inner.push(x)
                case TStmt.While(_, body, _):
                    inner.push(body)
                case TStmt.Defer(body, _):
                    inner.push(body)
                case TStmt.Block(body):
                    inner.push(body)
                case TStmt.Match(_, arms, _):
                    for a in arms:
                        if let TArmBody.Block(x) = a.body:
                            inner.push(x)
                case TStmt.Select(arms, _):
                    for a in arms:
                        inner.push(a.body)
                case TStmt.Let(_, _, _, else_, _):
                    if let Some(TLetElse.Diverge(_, x)) = else_:
                        inner.push(x)
                case _:
                    pass
            for x in inner:
                if self.trait_loop_stmts(x):
                    return True
        # Blocks inside expressions: the arms of a `match` expression.
        var exprs: list[TExprId] = []
        for s in self.blocks[b.index].stmts:
            for x in self.stmt_exprs(s):
                exprs.push(x)
        for x in exprs:
            if let TExprKind.Match(_, arms) = self.exprs[x.index].kind:
                for a in arms:
                    if let TArmBody.Block(y) = a.body:
                        if self.trait_loop_stmts(y):
                            return True
        return False

## The type checker's messages of a program, in order.
pure def messages(base: Base, text: str, catalog: Catalog) -> list[Msg]:
    var out: list[Msg] = []
    for d in check_file(base, text, catalog, False, {}, False).diagnostics:
        out.push(d.msg)
    return out

## A prelude with what the tests below use.
pure def test_prelude() -> String:
    var p = String.new()
    p.push("@builtin(\"String\")\nstruct String:\n    pass\n\n")
    p.push("@builtin(\"list\")\nstruct list[T]:\n    pass\n\n")
    p.push("trait Display:\n    def fmt(self)\n\n")
    p.push("enum Option[T]:\n    Some(T)\n    None\n\n")
    p.push("enum Result[T, E]:\n    Ok(T)\n    Err(E)\n\n")
    p.push("impl Display for int:\n    def fmt(self):\n        pass\n\n")
    p.push("impl[T] list[T]:\n    @intrinsic(\"list.push\")\n    def push(mut self, own x: T)\n\n")
    p.push("@intrinsic(\"print\")\ndef print[T: Display](x: T)\n\n")
    p.push("@intrinsic(\"todo\")\npure def todo[T](name: str = \"\") -> T\n")
    return p

test "stage 0's type errors have their messages":
    let catalog = Catalog.parse("")
    let r = base_from(test_prelude())
    # The cases of `type_errors_have_codes` in sisu-typeck's tests that are
    # within the slice.
    let cases = [
        ("def f() -> int:\n    return 1 / 2\n", Msg.TypeIntegerDivision),
        ("def f():\n    if 1:\n        pass\n", Msg.TypeNotBool),
        ("def f() -> int:\n    return \"x\"\n", Msg.TypeMismatch),
        ("def f():\n    let x = 1\n    x = 2\n", Msg.TypeAssignImmutable),
        ("def f() -> int:\n    let x = 1\n", Msg.TypeMissingReturn),
        ("def g() -> int?:\n    return None\ndef f():\n    g()\n", Msg.TypeUnusedResult),
        ("def f(xs: list[int]) -> int:\n    return xs[-1]\n", Msg.TypeConstantNegativeIndex),
        ("def f(x: int):\n    let y = x.nope()\n", Msg.TypeUnknownMethod),
        ("def f():\n    break\n", Msg.TypeBreakOutsideLoop),
        ("def f():\n    let xs = [1]\n    xs.push(2)\n", Msg.TypeNotMutable),
        ("def f(x: int) -> int:\n    return x + 1.5\n", Msg.TypeMixedNumbers),
        ("def f() -> f64:\n    return 7.0 // 2.0\n", Msg.TypeFloatFloorDivision),
        ("def f() -> int:\n    return todo(\"later\")\n", Msg.TypeHole),
    ]
    for (program, m) in cases:
        assert messages(r, program, catalog) == [m]
    var sets: String = "error A:\n    X\nerror B:\n    Y\n"
    sets.push("def a() -> int ! A:\n    return Err(X)\ndef f() -> int ! B:\n    return Ok(a()?)\n")
    assert messages(r, sets, catalog) == [Msg.TypeErrorNotInSet]
    var mut_arg: String = "def g(mut xs: list[int]):\n    xs.push(1)\n"
    mut_arg.push("def f():\n    var xs = [1]\n    g(xs)\n")
    assert messages(r, mut_arg, catalog) == [Msg.TypeMutArgumentMissing]
    let outside = "error A:\n    X\nerror B:\n    Y\ndef f() -> int ! A:\n    return Err(Y)\n"
    assert messages(r, outside, catalog) == [Msg.TypeErrorNotInSet]
    # A move out of a borrowed parameter's field, and its copy.
    let moved = "struct U:\n    name: String\ndef f(u: U) -> String:\n    return u.name\n"
    assert messages(r, moved, catalog) == [Msg.TypeMoveOutOfBorrow]
    let copied = "struct U:\n    name: String\ndef f(u: U) -> String:\n    return u.name.copy()\n"
    assert messages(r, copied, catalog).is_empty()
    # A broken header does not cascade: its body reports nothing more.
    var broken: String = "def f(x int) -> int:\n    let y = x + 1\n    return y\n"
    broken.push("def main():\n    print(f(1))\n")
    assert messages(r, broken, catalog).is_empty()

test "matches, patterns and inferred error sets":
    let catalog = Catalog.parse("")
    let r = base_from(test_prelude())
    var light: String = "enum Light:\n    Red\n    Amber\n    Green\n"
    light.push(
        "def f(l: Light) -> int:\n    match l:\n        case Light.Red:\n            return 1\n"
    )
    light.push("        case Light.Green:\n            return 2\n    return 3\n")
    # The arms that are there all return, so what follows is unreachable.
    assert messages(r, light, catalog) == [Msg.TypeNonExhaustive, Msg.TypeUnreachableCode]
    var unknown: String = "enum Shape:\n    Circle(int)\n"
    unknown.push(
        "def f(s: Shape) -> int:\n    match s:\n        case Shape.Square(x):\n            return x\n"
    )
    unknown.push("        case _:\n            return 0\n")
    assert messages(r, unknown, catalog) == [Msg.TypeUnknownVariant]
    # A `T !` function's set is what its body raises: `f` may fail with
    # `A`, which `g`'s `B` does not hold.
    var inferred: String = "error A:\n    X\nerror B:\n    Y\n"
    inferred.push(
        "def f(x: int) -> int !:\n    if x > 0:\n        return Err(X)\n    return Ok(x)\n"
    )
    inferred.push("def g() -> int ! B:\n    return Ok(f(1)?)\n")
    assert messages(r, inferred, catalog) == [Msg.TypeErrorNotInSet]

test "a body beyond the slice reports nothing, and says why":
    let catalog = Catalog.parse("")
    let r = base_from(test_prelude())
    # An attribute of a function stage 1 does not implement.
    var beyond: String = "@keeps\ndef f() -> int:\n    return 1\n"
    beyond.push("def g() -> int:\n    return \"x\"\n")
    let checked = check_file(r, beyond, catalog, False, {}, False)
    assert checked.diagnostics.is_empty()
    assert checked.beyond == ["an attribute of a function"]
