## The SHA-512 digest of `data`, 64 bytes.
##
## ```
## assert sha512(b"abc")[0:4] == b"\xdd\xaf\x35\xa1"
## ```
pub pure def sha512(data: bytes) -> bytes:
    var h: list[u64] = [
        0x6a09e667f3bcc908u64,
        0xbb67ae8584caa73bu64,
        0x3c6ef372fe94f82bu64,
        0xa54ff53a5f1d36f1u64,
        0x510e527fade682d1u64,
        0x9b05688c2b3e6c1fu64,
        0x1f83d9abfb41bd6bu64,
        0x5be0cd19137e2179u64,
    ]
    let msg = padded(data, 128, 16)
    var start = 0
    while start < len(msg):
        var w: list[u64] = []
        for t in range(16):
            w.push(be64(msg, start + 8 * t))
        for t in range(16, 80):
            let s0 = rotr64(w[t - 15], 1u64) ^ rotr64(w[t - 15], 8u64) ^ (w[t - 15] >> 7u64)
            let s1 = rotr64(w[t - 2], 19u64) ^ rotr64(w[t - 2], 61u64) ^ (w[t - 2] >> 6u64)
            w.push(w[t - 16] +% s0 +% w[t - 7] +% s1)
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for t in range(80):
            let s1 = rotr64(e, 14u64) ^ rotr64(e, 18u64) ^ rotr64(e, 41u64)
            let ch = (e & f) ^ (~e & g)
            let t1 = hh +% s1 +% ch +% SHA512_K[t] +% w[t]
            let s0 = rotr64(a, 28u64) ^ rotr64(a, 34u64) ^ rotr64(a, 39u64)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = s0 +% maj
            hh = g
            g = f
            f = e
            e = d +% t1
            d = c
            c = b
            b = a
            a = t1 +% t2
        h[0] = h[0] +% a
        h[1] = h[1] +% b
        h[2] = h[2] +% c
        h[3] = h[3] +% d
        h[4] = h[4] +% e
        h[5] = h[5] +% f
        h[6] = h[6] +% g
        h[7] = h[7] +% hh
        start += 128
    var out: list[u8] = []
    for x in h:
        push_be64(mut out, x)
    return bytes.from_list(out)

# ------------------------------------------------------------------ SipHash

pure def sip_round(mut v: list[u64]):
    v[0] = v[0] +% v[1]
    v[1] = rotl64(v[1], 13u64) ^ v[0]
    v[0] = rotl64(v[0], 32u64)
    v[2] = v[2] +% v[3]
    v[3] = rotl64(v[3], 16u64) ^ v[2]
    v[0] = v[0] +% v[3]
    v[3] = rotl64(v[3], 21u64) ^ v[0]
    v[2] = v[2] +% v[1]
    v[1] = rotl64(v[1], 17u64) ^ v[2]
    v[2] = rotl64(v[2], 32u64)

## SipHash-2-4 (Aumasson and Bernstein) of `data` under the 16-byte
## `key`: the keyed hash that resists flooding.
##
## ```
## var key: list[u8] = []
## for i in range(16):
##     key.push(i.truncate_to[u8]())
## assert siphash24(bytes.from_list(key), b"") == 0x726fdb47dd0e0e31u64
## ```
pub pure def siphash24(key: bytes, data: bytes) -> u64:
    requires len(key) == 16
    let k0 = le64(key, 0)
    let k1 = le64(key, 8)
    var v: list[u64] = [
        k0 ^ 0x736f6d6570736575u64,
        k1 ^ 0x646f72616e646f6du64,
        k0 ^ 0x6c7967656e657261u64,
        k1 ^ 0x7465646279746573u64,
    ]
    let n = len(data)
    var at = 0
    while at + 8 <= n:
        let m = le64(data, at)
        v[3] = v[3] ^ m
        sip_round(mut v)
        sip_round(mut v)
        v[0] = v[0] ^ m
        at += 8
    let last = le64(data.slice(at, n), 0) | ((n & 255).truncate_to[u64]() << 56u64)
    v[3] = v[3] ^ last
    sip_round(mut v)
    sip_round(mut v)
    v[0] = v[0] ^ last
    v[2] = v[2] ^ 255u64
    for _ in range(4):
        sip_round(mut v)
    return v[0] ^ v[1] ^ v[2] ^ v[3]

# ------------------------------------------------------------------ BLAKE3

const BLAKE3_IV: list[u32] = [
    0x6a09e667u32,
    0xbb67ae85u32,
    0x3c6ef372u32,
    0xa54ff53au32,
    0x510e527fu32,
    0x9b05688cu32,
    0x1f83d9abu32,
    0x5be0cd19u32,
]
const PERMUTATION: list[int] = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]
const CHUNK_START: u32 = 1u32
const CHUNK_END: u32 = 2u32
const PARENT: u32 = 4u32
const ROOT: u32 = 8u32

pure def mix(mut s: list[u32], a: int, b: int, c: int, d: int, x: u32, y: u32):
    s[a] = s[a] +% s[b] +% x
    s[d] = rotr32(s[d] ^ s[a], 16u32)
    s[c] = s[c] +% s[d]
    s[b] = rotr32(s[b] ^ s[c], 12u32)
    s[a] = s[a] +% s[b] +% y
    s[d] = rotr32(s[d] ^ s[a], 8u32)
    s[c] = s[c] +% s[d]
    s[b] = rotr32(s[b] ^ s[c], 7u32)

## BLAKE3's compression function: sixteen words from a chaining value, a
## block of sixteen words, a counter, the block's length and flags.
pure def compress(
    cv: list[u32], block: list[u32], counter: int, block_len: int, flags: u32
) -> list[u32]:
    var s = cv.copy()
    s.extend(BLAKE3_IV[0:4])
    s.push((counter & 0xffffffff).truncate_to[u32]())
    s.push(((counter >> 32) & 0xffffffff).truncate_to[u32]())
    s.push(block_len.truncate_to[u32]())
    s.push(flags)
    var m = block.copy()
    for r in range(7):
        mix(mut s, 0, 4, 8, 12, m[0], m[1])
        mix(mut s, 1, 5, 9, 13, m[2], m[3])
        mix(mut s, 2, 6, 10, 14, m[4], m[5])
        mix(mut s, 3, 7, 11, 15, m[6], m[7])
        mix(mut s, 0, 5, 10, 15, m[8], m[9])
        mix(mut s, 1, 6, 11, 12, m[10], m[11])
        mix(mut s, 2, 7, 8, 13, m[12], m[13])
        mix(mut s, 3, 4, 9, 14, m[14], m[15])
        if r < 6:
            m = [m[PERMUTATION[i]] for i in range(16)]
    for i in range(8):
        s[i] = s[i] ^ s[i + 8]
        s[i + 8] = s[i + 8] ^ cv[i]
    return s

## The sixteen words of the 64-byte block at `at` of `data`, zeros past
## its end.
pure def block_words(data: bytes, at: int) -> list[u32]:
    return [le32(data, at + 4 * i) for i in range(16)]

## A chunk's output, before the root flag decides what it is: its
## chaining value in, its last block, the counter, the length and flags.
struct Output:
    cv: list[u32]
    block: list[u32]
    counter: int
    block_len: int
    flags: u32

## The output of the chunk `data` (at most 1024 bytes), the chunk number
## `counter`.
pure def chunk_output(data: bytes, counter: int) -> Output:
    var cv = BLAKE3_IV.copy()
    let n = len(data)
    let blocks = if n == 0: 1 else: (n + 63) // 64
    for b in range(blocks - 1):
        let flags = if b == 0: CHUNK_START else: 0u32
        cv = compress(cv, block_words(data, 64 * b), counter, 64, flags)[0:8]
    let last = 64 * (blocks - 1)
    let start = if blocks == 1: CHUNK_START else: 0u32
    return Output(
        cv=cv,
        block=block_words(data, last),
        counter=counter,
        block_len=n - last,
        flags=start | CHUNK_END,
    )

pure def chaining_value(o: Output) -> list[u32]:
    return compress(o.cv, o.block, o.counter, o.block_len, o.flags)[0:8]

pure def parent_output(left: list[u32], right: list[u32]) -> Output:
    var block = left.copy()
    block.extend(right.copy())
    return Output(cv=BLAKE3_IV.copy(), block=block, counter=0, block_len=64, flags=PARENT)

## The BLAKE3 digest of `data`, 32 bytes (the default length).
##
## ```
## assert blake3(b"")[0:4] == b"\xaf\x13\x49\xb9"
## assert blake3(b"abc")[0:4] == b"\x64\x37\xb3\xac"
## ```
pub pure def blake3(data: bytes) -> bytes:
    let n = len(data)
    let chunks = if n == 0: 1 else: (n + 1023) // 1024
    # The chaining values of the subtrees finished so far: a chunk's,
    # merged with the stack's top while the count of chunks is even
    # (BLAKE3's reference implementation).
    var stack: list[list[u32]] = []
    for c in range(chunks - 1):
        var cv = chaining_value(chunk_output(data.slice(1024 * c, 1024 * c + 1024), c))
        var total = c + 1
        while total & 1 == 0:
            let left = stack.pop().expect("a subtree")
            cv = chaining_value(parent_output(left, cv))
            total = total >> 1
        stack.push(cv)
    let last = 1024 * (chunks - 1)
    var output = chunk_output(data.slice(last, n), chunks - 1)
    while let Some(left) = stack.pop():
        output = parent_output(left, chaining_value(output))
    let words = compress(output.cv, output.block, 0, output.block_len, output.flags | ROOT)
    var out: list[u8] = []
    for i in range(8):
        push_le32(mut out, words[i])
    return bytes.from_list(out)
