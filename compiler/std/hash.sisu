## The message padded to whole blocks of `block` bytes, its length in
## bits written big-endian in the last `size` bytes (FIPS 180-4, 5.1).
pure def padded(data: bytes, block: int, size: int) -> bytes:
    var tail: list[u8] = [128u8]
    let n = len(data)
    while (n + len(tail) + size) % block != 0:
        tail.push(0u8)
    for _ in range(size - 8):
        tail.push(0u8)
    push_be64(mut tail, (n * 8).truncate_to[u64]())
    return data + bytes.from_list(tail)

## The SHA-256 digest of `data`, 32 bytes.
##
## ```
## assert sha256(b"abc")[0:4] == b"\xba\x78\x16\xbf"
## assert sha256(b"")[28:32] == b"\x78\x52\xb8\x55"
## ```
pub pure def sha256(data: bytes) -> bytes:
    var h: list[u32] = [
        0x6a09e667u32,
        0xbb67ae85u32,
        0x3c6ef372u32,
        0xa54ff53au32,
        0x510e527fu32,
        0x9b05688cu32,
        0x1f83d9abu32,
        0x5be0cd19u32,
    ]
    let msg = padded(data, 64, 8)
    var start = 0
    while start < len(msg):
        var w: list[u32] = []
        for t in range(16):
            w.push(be32(msg, start + 4 * t))
        for t in range(16, 64):
            let s0 = rotr32(w[t - 15], 7u32) ^ rotr32(w[t - 15], 18u32) ^ (w[t - 15] >> 3u32)
            let s1 = rotr32(w[t - 2], 17u32) ^ rotr32(w[t - 2], 19u32) ^ (w[t - 2] >> 10u32)
            w.push(w[t - 16] +% s0 +% w[t - 7] +% s1)
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for t in range(64):
            let s1 = rotr32(e, 6u32) ^ rotr32(e, 11u32) ^ rotr32(e, 25u32)
            let ch = (e & f) ^ (~e & g)
            let t1 = hh +% s1 +% ch +% SHA256_K[t] +% w[t]
            let s0 = rotr32(a, 2u32) ^ rotr32(a, 13u32) ^ rotr32(a, 22u32)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = s0 +% maj
            hh = g
            g = f
            f = e
            e = d +% t1
            d = c
            c = b
            b = a
            a = t1 +% t2
        h[0] = h[0] +% a
        h[1] = h[1] +% b
        h[2] = h[2] +% c
        h[3] = h[3] +% d
        h[4] = h[4] +% e
        h[5] = h[5] +% f
        h[6] = h[6] +% g
        h[7] = h[7] +% hh
        start += 64
    var out: list[u8] = []
    for x in h:
        push_be32(mut out, x)
    return bytes.from_list(out)

