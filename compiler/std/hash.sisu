##! `std.hash` (11): hash functions over bytes. SipHash-2-4, the keyed
##! hash the prelude's `dict` and `set` use against flooding; FNV-1a, a
##! fast unkeyed one for small keys; CRC-32 (IEEE 802.3), the checksum of
##! zip and PNG; and the cryptographic SHA-256 and SHA-512 (FIPS 180-4) and
##! BLAKE3. Each digest is bytes, `std.encoding.hex_encode` writes it out.

# ------------------------------------------------------------------ words

## The little-endian `u32` at `at` in `data`, the bytes past its end
## counted as zeros.
pure def le32(data: bytes, at: int) -> u32:
    var w = 0u32
    for k in range(4):
        if at + k < len(data):
            w = w | (data[at + k].to_int().truncate_to[u32]() << (8 * k).truncate_to[u32]())
    return w

pure def be32(data: bytes, at: int) -> u32:
    var w = 0u32
    for k in range(4):
        w = (w << 8u32) | data[at + k].to_int().truncate_to[u32]()
    return w

pure def le64(data: bytes, at: int) -> u64:
    var w = 0u64
    for k in range(8):
        if at + k < len(data):
            w = w | (data[at + k].to_int().truncate_to[u64]() << (8 * k).truncate_to[u64]())
    return w

pure def be64(data: bytes, at: int) -> u64:
    var w = 0u64
    for k in range(8):
        w = (w << 8u64) | data[at + k].to_int().truncate_to[u64]()
    return w

pure def push_be32(mut out: list[u8], w: u32):
    for k in [24u32, 16u32, 8u32, 0u32]:
        out.push(((w >> k) & 255u32).to_int().truncate_to[u8]())

pure def push_le32(mut out: list[u8], w: u32):
    for k in [0u32, 8u32, 16u32, 24u32]:
        out.push(((w >> k) & 255u32).to_int().truncate_to[u8]())

pure def push_be64(mut out: list[u8], w: u64):
    var k = 56u64
    for _ in range(8):
        out.push(((w >> k) & 255u64).to_int().expect("a byte").truncate_to[u8]())
        k = k -% 8u64

pure def rotr32(x: u32, k: u32) -> u32:
    return (x >> k) | (x << (32u32 - k))

pure def rotr64(x: u64, k: u64) -> u64:
    return (x >> k) | (x << (64u64 - k))

pure def rotl64(x: u64, k: u64) -> u64:
    return (x << k) | (x >> (64u64 - k))

## The bits of `x` as an `int` (two's complement).
pure def signed(x: u64) -> int:
    match x.to_int():
        case Some(n):
            return n
        case None:
            return (x - 9223372036854775808u64).to_int().expect("below 2**63")
                + (-9223372036854775807 - 1)

# ------------------------------------------------------------------ FNV-1a

## FNV-1a with 32 bits (Fowler, Noll and Vo).
##
## ```
## assert fnv1a_32(b"") == 0x811c9dc5u32
## assert fnv1a_32(b"a") == 0xe40c292cu32
## ```
pub pure def fnv1a_32(data: bytes) -> u32:
    var h = 0x811c9dc5u32
    for b in data.iter():
        h = (h ^ b.to_int().truncate_to[u32]()) *% 16777619u32
    return h

## FNV-1a with 64 bits.
##
## ```
## assert fnv1a_64(b"") == 0xcbf29ce484222325u64
## assert fnv1a_64(b"foobar") == 0x85944171f73967e8u64
## ```
pub pure def fnv1a_64(data: bytes) -> u64:
    var h = 0xcbf29ce484222325u64
    for b in data.iter():
        h = (h ^ b.to_int().truncate_to[u64]()) *% 0x100000001b3u64
    return h

# ------------------------------------------------------------------ CRC-32

## The table of CRC-32 (the reflected polynomial `0xEDB88320`), one entry
## per byte value.
pure def crc_table() -> list[u32]:
    var table: list[u32] = []
    for n in range(256):
        var c = n.truncate_to[u32]()
        for _ in range(8):
            c = if c & 1u32 == 1u32: 0xedb88320u32 ^ (c >> 1u32) else: c >> 1u32
        table.push(c)
    return table

const CRC_TABLE: list[u32] = comptime crc_table()

## The CRC-32 of `data` (IEEE 802.3, as zip, gzip and PNG compute it).
##
## ```
## assert crc32(b"123456789") == 0xcbf43926u32
## assert crc32(b"") == 0u32
## ```
pub pure def crc32(data: bytes) -> u32:
    var c = 0xffffffffu32
    for b in data.iter():
        let i = ((c ^ b.to_int().truncate_to[u32]()) & 255u32).to_int()
        c = CRC_TABLE[i] ^ (c >> 8u32)
    return c ^ 0xffffffffu32

