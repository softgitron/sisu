##! `std.string` (11): text. A `String` is its UTF-8 bytes, `str` is the
##! type of a text literal, and `char` is a Unicode scalar value; their
##! methods (`len`, `chars`, `split`, `trim`, `find`, `replace`,
##! `to_lowercase` and `to_uppercase`, which map case over all of Unicode,
##! ...) are the prelude's, and `String` is reached from here too (`from
##! std.string import String`; `str` and `char` are built-in names).
##! `Builder` makes a text from many pieces. Grapheme iteration and the
##! normalisation forms need Unicode's tables, which are not here yet.

## A text made from many pieces: each `push` keeps its piece, and `build`
## copies them all into one `String` once, so making a long text from
## short pieces copies each byte once.
##
## ```
## var b = Builder.new()
## b.push("one")
## b.push_char(',')
## b.push(" two")
## b.push_line("")
## b.push_line("three")
## assert b.build() == "one, two\nthree\n"
## assert b.byte_len() == 15
## ```
pub struct Builder:
    pieces: list[String]
    bytes: int

    ## An empty builder.
    pub pure def new() -> Builder:
        return Builder(pieces=[], bytes=0)

    ## Adds `text`.
    pub pure def push(mut self, text: str):
        self.pieces.push(String.new(text))
        self.bytes += text.byte_len()

    ## Adds the character `c`.
    pub pure def push_char(mut self, c: char):
        var one = String.new()
        one.push_char(c)
        self.bytes += c.len_utf8()
        self.pieces.push(one)

    ## Adds `text` and then a line break.
    pub pure def push_line(mut self, text: str):
        self.push(text)
        self.push("\n")

    ## Adds the pieces of `parts` with `sep` between each two.
    ##
    ## ```
    ## var b = Builder.new()
    ## b.push("[")
    ## b.push_joined(["a", "b", "c"], "; ")
    ## b.push("]")
    ## assert b.build() == "[a; b; c]"
    ## ```
    pub pure def push_joined(mut self, parts: list[str], sep: str):
        for (i, p) in enumerate(parts):
            if i > 0:
                self.push(sep)
            self.push(p)

    ## The number of bytes of the text so far.
    pub pure def byte_len(self) -> int:
        return self.bytes

    pub pure def is_empty(self) -> bool:
        return self.bytes == 0

    ## The text so far, as one `String`; the builder keeps its pieces.
    pub pure def build(self) -> String:
        var out = String.new()
        for p in self.pieces:
            out.push(p)
        return out

# ---------------------------------------------------------------- the normalisation forms and graphemes

## Unicode's four normalisation forms of a text (11, "normalisation
## forms"; Unicode's UAX #15): `nfd` decomposes each character canonically
## and puts its marks in their canonical order, `nfc` composes the result
## again, and `nfkd` and `nfkc` do the same with the compatibility
## decompositions besides (`ﬁ` is `fi`, `²` is `2`). Two texts that read the
## same have the same `nfc`, and the same `nfkc` when they differ only in
## such forms.
##
## ```
## let composed = "\u{e9}t\u{e9}"
## let decomposed = "e\u{301}te\u{301}"
## assert decomposed.nfc() == composed and composed.nfd() == decomposed
## assert "\u{fb01}x\u{b2}".nfkc() == "fix2" and "\u{fb01}".nfc() == "\u{fb01}"
## assert "\u{d55c}".nfd() == "\u{1112}\u{1161}\u{11ab}" and "\u{1112}\u{1161}\u{11ab}".nfc() == "\u{d55c}"
## assert "a\u{323}\u{302}".nfc() == "\u{1ead}" and "a\u{302}\u{323}".nfc() == "\u{1ead}"
## ```
pub trait Normalize:
    ## The canonical composition: the canonical decomposition composed again.
    pure def nfc(self) -> String
    ## The canonical decomposition, its marks in canonical order.
    pure def nfd(self) -> String
    ## The compatibility composition.
    pure def nfkc(self) -> String
    ## The compatibility decomposition.
    pure def nfkd(self) -> String

impl Normalize for str:
    pure def nfc(self) -> String:
        return normalized(self, False, True)
    pure def nfd(self) -> String:
        return normalized(self, False, False)
    pure def nfkc(self) -> String:
        return normalized(self, True, True)
    pure def nfkd(self) -> String:
        return normalized(self, True, False)

## The graphemes of a text, what a reader takes for one character each (03:
## "`s.graphemes()` ... graphemes one method away"; Unicode's UAX #29), by
## the rules these tables carry: a base with the marks after it (and the
## variation selectors, the emoji modifiers and the tag characters), `\r\n`,
## a Hangul syllable written in jamo, two regional indicators (a flag), and
## a sequence joined by U+200D, each one grapheme; a control character is
## one of its own. The full rules would also keep a prepended character
## with what follows it (`Prepend`), join an Indic conjunct across its
## virama, and join after U+200D only between pictographs.
##
## ```
## var gs: list[str] = []
## for g in "e\u{301}a\r\n\u{1112}\u{1161}\u{11ab}\u{1f1eb}\u{1f1ee}".graphemes():
##     gs.push(g)
## assert gs == ["e\u{301}", "a", "\r\n", "\u{1112}\u{1161}\u{11ab}", "\u{1f1eb}\u{1f1ee}"]
## var family = 0
## for _ in "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}!".graphemes():
##     family += 1
## assert family == 2
## ```
pub trait Graphemes:
    ## Each grapheme, in order.
    pure def graphemes(self) -> Iter[str]

impl Graphemes for str:
    pure def graphemes(self) -> Iter[str]:
        var out: list[str] = []
        var start = 0
        var at = 0
        var previous: char? = None
        var flags = 0
        for c in self.chars():
            if let Some(p) = previous:
                if breaks_between(p, c, flags):
                    out.push(self.byte_slice(start, at))
                    start = at
                    flags = 0
            if is_regional(c):
                flags += 1
            previous = Some(c)
            at += c.len_utf8()
        if at > start:
            out.push(self.byte_slice(start, at))
        return iter_of(out)

## Whether a grapheme ends between `p` and `c`, `flags` being the regional
## indicators of the grapheme so far.
pure def breaks_between(p: char, c: char, flags: int) -> bool:
    let a = p.code()
    let b = c.code()
    if a == 13 and b == 10:
        return False
    if is_control(a) or is_control(b):
        return True
    # A syllable's jamo: a leading consonant before a consonant, a vowel or
    # a syllable; a vowel or an open syllable before a vowel or a final; a
    # final or a closed syllable before a final.
    let x = jamo(a)
    let y = jamo(b)
    if x == JAMO_L and y != JAMO_NONE:
        return False
    if (x == JAMO_V or x == JAMO_LV) and (y == JAMO_V or y == JAMO_T):
        return False
    if (x == JAMO_T or x == JAMO_LVT) and y == JAMO_T:
        return False
    if b == 0x200D or a == 0x200D or extends(b):
        return False
    if is_regional(c) and is_regional(p) and flags % 2 == 1:
        return False
    return True

pure def is_control(n: int) -> bool:
    return n < 0x20 or (0x7F <= n and n <= 0x9F) or n == 0x2028 or n == 0x2029

pure def is_regional(c: char) -> bool:
    return 0x1F1E6 <= c.code() and c.code() <= 0x1F1FF

## What a grapheme keeps after its base: a mark, a variation selector, an
## emoji modifier, a tag character.
pure def extends(n: int) -> bool:
    if (0xFE00 <= n and n <= 0xFE0F) or (0xE0100 <= n and n <= 0xE01EF):
        return True
    if (0x1F3FB <= n and n <= 0x1F3FF) or (0xE0020 <= n and n <= 0xE007F):
        return True
    return record_range(marks_table(), 13, n).is_some()

pure def jamo_l(n: int) -> bool:
    return (0x1100 <= n and n <= 0x115F) or (0xA960 <= n and n <= 0xA97C)

## What `n` is of Hangul: a leading, a vowel or a final jamo, an open or
## a closed syllable, or none.
pure def jamo(n: int) -> int:
    if jamo_l(n):
        return JAMO_L
    if (0x1160 <= n and n <= 0x11A7) or (0xD7B0 <= n and n <= 0xD7C6):
        return JAMO_V
    if (0x11A8 <= n and n <= 0x11FF) or (0xD7CB <= n and n <= 0xD7FB):
        return JAMO_T
    if is_hangul_syllable(n):
        return if (n - HANGUL_BASE) % HANGUL_FINALS == 0: JAMO_LV else: JAMO_LVT
    return JAMO_NONE

const JAMO_NONE: int = 0
const JAMO_L: int = 1
const JAMO_V: int = 2
const JAMO_T: int = 3
const JAMO_LV: int = 4
const JAMO_LVT: int = 5

const HANGUL_BASE: int = 0xAC00
const HANGUL_L: int = 0x1100
const HANGUL_V: int = 0x1161
const HANGUL_T: int = 0x11A7
const HANGUL_VOWELS: int = 21
const HANGUL_FINALS: int = 28
const HANGUL_COUNT: int = 11172

pure def is_hangul_syllable(n: int) -> bool:
    return HANGUL_BASE <= n and n < HANGUL_BASE + HANGUL_COUNT

## The text `s` decomposed, compatibly with `compat`, its marks put in
## canonical order, and composed again with `compose`.
pure def normalized(s: str, compat: bool, compose: bool) -> String:
    var cs: list[int] = []
    for c in s.chars():
        decompose(c.code(), compat, mut cs)
    reorder(mut cs)
    if compose:
        cs = composed(cs)
    var out = String.new()
    for n in cs:
        if let Some(c) = char.from_code(n):
            out.push_char(c)
    return out

## The full decomposition of `n`, pushed onto `out`.
pure def decompose(n: int, compat: bool, mut out: list[int]):
    if is_hangul_syllable(n):
        let i = n - HANGUL_BASE
        out.push(HANGUL_L + i // (HANGUL_VOWELS * HANGUL_FINALS))
        out.push(HANGUL_V + (i % (HANGUL_VOWELS * HANGUL_FINALS)) // HANGUL_FINALS)
        if i % HANGUL_FINALS != 0:
            out.push(HANGUL_T + i % HANGUL_FINALS)
        return
    if n < 0xA0:
        out.push(n)
        return
    let table = canonical_table()
    if let Some(at) = record_find(table, 22, n):
        decompose(hex_at(table, at + 7, 6), compat, mut out)
        let second = hex_at(table, at + 14, 6)
        if second != 0:
            decompose(second, compat, mut out)
        return
    if compat:
        let kept = compatibility_table()
        if let Some(at) = record_find(kept, 14, n):
            let first = hex_at(kept, at + 7, 4)
            let count = hex_at(kept, at + 12, 2)
            let pool = compatibility_pool()
            for k in range(count):
                decompose(pool_at(pool, first + k), compat, mut out)
            return
    out.push(n)

## The `k`th code point of the pool, six digits each, 24 to a line.
pure def pool_at(pool: str, k: int) -> int:
    return hex_at(pool, (k // 24) * 145 + (k % 24) * 6, 6)

## The canonical combining class of `n`.
pure def class_of(n: int) -> int:
    if n < 0x300:
        return 0
    let table = classes_table()
    let Some(at) = record_range(table, 16, n) else:
        return 0
    return hex_at(table, at + 14, 2)

## Each run of marks put in canonical order: by class, the marks of one
## class kept in the order written.
pure def reorder(mut cs: list[int]):
    var i = 1
    while i < len(cs):
        let k = class_of(cs[i])
        if k != 0:
            var j = i
            while j > 0 and class_of(cs[j - 1]) > k:
                let t = cs[j - 1]
                cs[j - 1] = cs[j]
                cs[j] = t
                j -= 1
        i += 1

## The canonical composition of a decomposed, ordered text.
pure def composed(cs: list[int]) -> list[int]:
    var out: list[int] = []
    var starter = -1
    var last_class = 0
    for n in cs:
        let k = class_of(n)
        if starter >= 0:
            let blocked = len(out) - 1 != starter and (last_class == 0 or last_class >= k)
            if not blocked:
                if let Some(c) = composition(out[starter], n):
                    out[starter] = c
                    continue
        if k == 0:
            starter = len(out)
            last_class = 0
        else:
            last_class = k
        out.push(n)
    return out

## The character `a` and `b` compose, if any.
pure def composition(a: int, b: int) -> int?:
    # A leading and a vowel jamo, or an open syllable and a final.
    if HANGUL_L <= a and a < HANGUL_L + 19 and HANGUL_V <= b and b < HANGUL_V + HANGUL_VOWELS:
        let l = a - HANGUL_L
        let v = b - HANGUL_V
        return Some(HANGUL_BASE + (l * HANGUL_VOWELS + v) * HANGUL_FINALS)
    if is_hangul_syllable(a) and (a - HANGUL_BASE) % HANGUL_FINALS == 0:
        if HANGUL_T < b and b < HANGUL_T + HANGUL_FINALS:
            return Some(a + b - HANGUL_T)
    let table = compositions_table()
    let size = 20
    var lo = 0
    var hi = table.byte_len() // (size + 1)
    while lo < hi:
        let mid = (lo + hi) // 2
        let at = mid * (size + 1)
        let x = hex_at(table, at, 6)
        let y = hex_at(table, at + 7, 6)
        if x < a or (x == a and y < b):
            lo = mid + 1
        elif x == a and y == b:
            return Some(hex_at(table, at + 14, 6))
        else:
            hi = mid
    return None

## The start of the record of `table` (records of `size` bytes, each with
## one separator after it) whose first field is `n`.
pure def record_find(table: str, size: int, n: int) -> int?:
    var lo = 0
    var hi = table.byte_len() // (size + 1)
    while lo < hi:
        let mid = (lo + hi) // 2
        let x = hex_at(table, mid * (size + 1), 6)
        if x < n:
            lo = mid + 1
        elif x == n:
            return Some(mid * (size + 1))
        else:
            hi = mid
    return None

## The start of the record of `table` whose range, its first two fields,
## holds `n`.
pure def record_range(table: str, size: int, n: int) -> int?:
    var lo = 0
    var hi = table.byte_len() // (size + 1)
    while lo < hi:
        let mid = (lo + hi) // 2
        let at = mid * (size + 1)
        if hex_at(table, at + 7, 6) < n:
            lo = mid + 1
        elif hex_at(table, at, 6) > n:
            hi = mid
        else:
            return Some(at)
    return None

## The number written in `width` hexadecimal digits from `at`.
pure def hex_at(text: str, at: int, width: int) -> int:
    var n = 0
    for i in range(width):
        let b = text.byte_at(at + i).to_int()
        var d = 0
        if 48 <= b and b <= 57:
            d = b - 48
        elif 97 <= b and b <= 102:
            d = b - 87
        n = n * 16 + d
    return n

# ---------------------------------------------------------------- Unicode's tables, generated

# Written by `stage1/tools/unicode_tables.py` from Unicode 15.1.0 as Python's
# `unicodedata` has it (RULES.md, R162): do not edit them by hand. Each is a
# text of fixed-width records in hexadecimal, sorted by their first field
# and each followed by one space or line break, which `record_find`
# searches.

## `CCCCCC-AAAAAA-BBBBBB-F`: the canonical decomposition of `C` into `A` and
## `B` (0 for none), but for the Hangul syllables, which are computed; `F` is
## 1 where the composition forms compose it again (2061 records).
