##! `std.env` (11): the program's arguments and environment variables
##! through the environment capability. `Env.args` and `Env.get` are the
##! prelude's; this module reads variables as numbers, flags and lists,
##! asks for the ones a program needs, and expands `$NAME` in text. The
##! working directory waits for the host contract to report it.

## A variable the program needs is missing or unreadable.
pub error EnvError:
    Missing(name: String)
    Unreadable(name: String, value: String)

## The variable `name`, or `Missing`.
##
## ```
## let env = Env.fake(vars={"HOME": "/home/ada"})
## assert require(env, "HOME") == Ok(String.new("/home/ada"))
## assert require(env, "SHELL") == Err(Missing(name=String.new("SHELL")))
## ```
pub def require(env: Env, name: str) -> String ! EnvError:
    match env.get(name):
        case Some(v):
            return Ok(v)
        case None:
            return Err(Missing(name=String.new(name)))

## The variable `name` as an integer: `None` when it is not set,
## `Unreadable` when it is not one.
##
## ```
## let env = Env.fake(vars={"PORT": "8080", "BAD": "eighty"})
## assert get_int(env, "PORT") == Ok(Some(8080))
## assert get_int(env, "NONE") == Ok(None)
## assert get_int(env, "BAD") == Err(Unreadable(name=String.new("BAD"), value=String.new("eighty")))
## ```
pub def get_int(env: Env, name: str) -> int? ! EnvError:
    match env.get(name):
        case Some(v):
            match v.trim().parse_int():
                case Some(n):
                    return Ok(Some(n))
                case None:
                    return Err(Unreadable(name=String.new(name), value=v))
        case None:
            return Ok(None)

## Whether the variable `name` is set to a true value: `1`, `true`, `yes`
## or `on`, in any case; `False` when it is not set or is `0`, `false`,
## `no`, `off` or empty, and `Unreadable` otherwise.
##
## ```
## let env = Env.fake(vars={"DEBUG": "Yes", "QUIET": "0", "ODD": "maybe"})
## assert is_set(env, "DEBUG") == Ok(True)
## assert is_set(env, "QUIET") == Ok(False)
## assert is_set(env, "MISSING") == Ok(False)
## assert is_set(env, "ODD") == Err(Unreadable(name=String.new("ODD"), value=String.new("maybe")))
## ```
pub def is_set(env: Env, name: str) -> bool ! EnvError:
    match env.get(name):
        case Some(v):
            let low = v.trim().to_lowercase()
            if low == "1" or low == "true" or low == "yes" or low == "on":
                return Ok(True)
            if low == "0" or low == "false" or low == "no" or low == "off" or low == "":
                return Ok(False)
            return Err(Unreadable(name=String.new(name), value=v))
        case None:
            return Ok(False)

## The variable `name` split at `sep` (`:` as `PATH` writes it), without
## empty parts; none when it is not set.
##
## ```
## let env = Env.fake(vars={"PATH": "/bin::/usr/bin"})
## assert get_list(env, "PATH") == ["/bin", "/usr/bin"]
## assert get_list(env, "NOPE") == []
## ```
pub def get_list(env: Env, name: str, sep: str = ":") -> list[String]:
    var out: list[String] = []
    if let Some(v) = env.get(name):
        for part in v.split(sep):
            if not part.is_empty():
                out.push(part.to_string())
    return out

## `text` with each `$NAME` and `${NAME}` replaced by the variable's value
## (empty when it is not set) and `$$` by `$`; a name is letters, digits
## and `_`.
##
## ```
## let env = Env.fake(vars={"USER": "ada", "DIR": "/tmp"})
## assert expand(env, "$USER at ${{DIR}}/x, $$5, $NONE.") == "ada at /tmp/x, $5, ."
## ```
pub def expand(env: Env, text: str) -> String:
    var out = String.new()
    let cs: list[char] = text.chars().collect()
    var i = 0
    while i < len(cs):
        let c = cs[i]
        if c != '$' or i + 1 >= len(cs):
            out.push_char(c)
            i += 1
            continue
        if cs[i + 1] == '$':
            out.push_char('$')
            i += 2
            continue
        var name = String.new()
        var j = i + 1
        if cs[j] == '{':
            j += 1
            while j < len(cs) and cs[j] != '}':
                name.push_char(cs[j])
                j += 1
            j += 1
        else:
            while j < len(cs) and (cs[j].is_alphabetic() or cs[j].is_digit() or cs[j] == '_'):
                name.push_char(cs[j])
                j += 1
        if name.is_empty():
            out.push_char(c)
            i += 1
            continue
        out.push(env.get(name) ?? String.new())
        i = j
    return out
