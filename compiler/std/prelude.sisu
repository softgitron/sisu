impl int:
    ## The value's 64 bits, two's complement, as a `u64`: `-1.to_bits()`
    ## is `u64`'s largest.
    ##
    ## ```
    ## assert (-1).to_bits() == 18446744073709551615u64
    ## assert int.from_bits((-5).to_bits()) == -5
    ## ```
    pure def to_bits(self) -> u64:
        return self.truncate_to[u64]()
    ## The `int` whose two's complement bits are `bits`.
    pure def from_bits(bits: u64) -> int:
        match bits.to_int():
            case Some(n):
                return n
            case None:
                return (bits - 9223372036854775808u64).to_int().expect("below 2**63")
                    + (-9223372036854775807 - 1)
    ## The number of bits that are 1, of the two's complement.
    ##
    ## ```
    ## assert (-1).count_ones() == 64
    ## ```
    pure def count_ones(self) -> int:
        return self.to_bits().count_ones()
    ## The number of bits that are 0, of the two's complement.
    pure def count_zeros(self) -> int:
        return self.to_bits().count_zeros()
    ## The number of 0 bits above the highest 1: 0 for a negative value.
    pure def leading_zeros(self) -> int:
        return self.to_bits().leading_zeros()
    ## The number of 0 bits below the lowest 1, 64 for 0.
    pure def trailing_zeros(self) -> int:
        return self.to_bits().trailing_zeros()
    ## The two's complement bits rotated as `u64.rotate_left` rotates them.
    pure def rotate_left(self, n: int) -> int:
        return int.from_bits(self.to_bits().rotate_left(n))
    ## The two's complement bits rotated as `u64.rotate_right` rotates them.
    pure def rotate_right(self, n: int) -> int:
        return int.from_bits(self.to_bits().rotate_right(n))
    ## The bytes of the two's complement in the opposite order.
    pure def swap_bytes(self) -> int:
        return int.from_bits(self.to_bits().swap_bytes())
    ## The value with its bytes in big-endian order in memory.
    pure def to_be(self) -> int:
        return int.from_bits(self.to_bits().to_be())
    ## The value with its bytes in little-endian order in memory: itself.
    pure def to_le(self) -> int:
        return int.from_bits(self.to_bits().to_le())

impl i128:
    ## The value's 128 bits, two's complement, as a `u128`.
    pure def to_bits(self) -> u128:
        if self < 0i128:
            return ~(-(self + 1i128)).to_bits()
        var out = 0u128
        var y = self
        var shift = 0u128
        while y != 0i128:
            let part = (y % 4294967296i128).to_int().expect("32 bits")
            out = out | (part.truncate_to[u128]() << shift)
            y = y // 4294967296i128
            shift = shift + 32u128
        return out
    ## The `i128` whose two's complement bits are `bits`.
    pure def from_bits(bits: u128) -> i128:
        if bits.leading_zeros() == 0:
            return -i128.from_bits(~bits) - 1i128
        var out = 0i128
        var y = bits
        var shift = 0i128
        while y != 0u128:
            let part: i128 = (y & 4294967295u128).to_int().expect("32 bits")
            out = out | (part << shift)
            y = y >> 32u128
            shift = shift + 32i128
        return out
    ## The number of bits that are 1, of the two's complement.
    pure def count_ones(self) -> int:
        return self.to_bits().count_ones()
    ## The number of bits that are 0, of the two's complement.
    pure def count_zeros(self) -> int:
        return self.to_bits().count_zeros()
    ## The number of 0 bits above the highest 1: 0 for a negative value.
    pure def leading_zeros(self) -> int:
        return self.to_bits().leading_zeros()
    ## The number of 0 bits below the lowest 1, 128 for 0.
    pure def trailing_zeros(self) -> int:
        return self.to_bits().trailing_zeros()
    ## The two's complement bits rotated as `u128.rotate_left` rotates them.
    pure def rotate_left(self, n: int) -> i128:
        return i128.from_bits(self.to_bits().rotate_left(n))
    ## The two's complement bits rotated as `u128.rotate_right` rotates them.
    pure def rotate_right(self, n: int) -> i128:
        return i128.from_bits(self.to_bits().rotate_right(n))
    ## The bytes of the two's complement in the opposite order.
    pure def swap_bytes(self) -> i128:
        return i128.from_bits(self.to_bits().swap_bytes())
    ## The value with its bytes in big-endian order in memory.
    pure def to_be(self) -> i128:
        return i128.from_bits(self.to_bits().to_be())
    ## The value with its bytes in little-endian order in memory: itself.
    pure def to_le(self) -> i128:
        return i128.from_bits(self.to_bits().to_le())

# ------------------------------------------------------------------ the bounds and truncation of the integers

# Each integer type's `MIN` and `MAX` (03 names `int.MIN`), and the sized
# types' `truncate_to`, which `int` has as a method of the front ends
# (decision 642): written in Sisu, at the end of the prelude so that the
# lines of the functions before them do not move.

impl u8:
    ## The least `u8`, 0.
    const MIN: u8 = 0u8
    ## The greatest `u8`, 255.
    const MAX: u8 = 255u8
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    ##
    ## ```
    ## assert 200u8.truncate_to[i8]() == -56i8
    ## assert u8.MAX.truncate_to[u32]() == 255u32
    ## ```
    pure def truncate_to[T: Integer](self) -> T:
        return T.wrapping_from(self.to_int())

impl u16:
    ## The least `u16`, 0.
    const MIN: u16 = 0u16
    ## The greatest `u16`, 65535.
    const MAX: u16 = 65535u16
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    pure def truncate_to[T: Integer](self) -> T:
        return T.wrapping_from(self.to_int())

impl u32:
    ## The least `u32`, 0.
    const MIN: u32 = 0u32
    ## The greatest `u32`, 4294967295.
    const MAX: u32 = 4294967295u32
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    pure def truncate_to[T: Integer](self) -> T:
        return T.wrapping_from(self.to_int())

impl u64:
    ## The least `u64`, 0.
    const MIN: u64 = 0u64
    ## The greatest `u64`, 18446744073709551615.
    const MAX: u64 = 18446744073709551615u64
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    ## A type of 128 bits holds every `u64`, so the value is kept whole
    ## there, as widening (`into`) keeps it.
    ##
    ## ```
    ## assert u64.MAX.truncate_to[u32]() == u32.MAX
    ## assert u64.MAX.truncate_to[int]() == -1
    ## ```
    pure def truncate_to[T: Integer](self) -> T:
        match self.to_int():
            case Some(n):
                return T.wrapping_from(n)
            case None:
                # Above `int.MAX`: whole in a type of 128 bits, which
                # `reflect` names (RULES.md, R115).
                if comptime reflect.name_of(T) == "u128":
                    let whole: u128 = self
                    return whole
                if comptime reflect.name_of(T) == "i128":
                    let whole: i128 = self
                    return whole
                return T.wrapping_from(int.from_bits(self))

impl u128:
    ## The least `u128`, 0.
    const MIN: u128 = 0u128
    ## The greatest `u128`, 340282366920938463463374607431768211455.
    const MAX: u128 = 340282366920938463463374607431768211455u128
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    ## A value outside `int`'s range taken to a type of 128 bits is its
    ## bits read as that type's, as `i128.from_bits` reads them.
    pure def truncate_to[T: Integer](self) -> T:
        match self.to_int():
            case Some(n):
                return T.wrapping_from(n)
            case None:
                # Outside `int`'s range: exact in a type of 128 bits, which
                # `reflect` names (RULES.md, R115).
                if comptime reflect.name_of(T) == "u128":
                    return self
                if comptime reflect.name_of(T) == "i128":
                    return i128.from_bits(self)
                let bits = self
                let high = ((bits >> 32u128) & 4294967295u128).to_int().expect("32 bits")
                let low = (bits & 4294967295u128).to_int().expect("32 bits")
                return T.wrapping_from(
                    int.from_bits((high.truncate_to[u64]() << 32u64) | low.truncate_to[u64]())
                )

impl i8:
    ## The least `i8`, -128.
    const MIN: i8 = -127i8 - 1i8
    ## The greatest `i8`, 127.
    const MAX: i8 = 127i8
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    pure def truncate_to[T: Integer](self) -> T:
        return T.wrapping_from(self.to_int())

impl i16:
    ## The least `i16`, -32768.
    const MIN: i16 = -32767i16 - 1i16
    ## The greatest `i16`, 32767.
    const MAX: i16 = 32767i16
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    pure def truncate_to[T: Integer](self) -> T:
        return T.wrapping_from(self.to_int())

impl i32:
    ## The least `i32`, -2147483648.
    const MIN: i32 = -2147483647i32 - 1i32
    ## The greatest `i32`, 2147483647.
    const MAX: i32 = 2147483647i32
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    pure def truncate_to[T: Integer](self) -> T:
        return T.wrapping_from(self.to_int())

impl int:
    ## The least `int`, -9223372036854775808.
    const MIN: int = -9223372036854775807 - 1
    ## The greatest `int`, 9223372036854775807.
    const MAX: int = 9223372036854775807

impl i128:
    ## The least `i128`, -170141183460469231731687303715884105728.
    const MIN: i128 = -170141183460469231731687303715884105727i128 - 1i128
    ## The greatest `i128`, 170141183460469231731687303715884105727.
    const MAX: i128 = 170141183460469231731687303715884105727i128
    ## The value reduced to `T`'s width, as two's complement wrapping does,
    ## as `int.truncate_to` reduces an `int`.
    ## A value outside `int`'s range taken to a type of 128 bits is its
    ## bits read as that type's, as `to_bits` reads them.
    pure def truncate_to[T: Integer](self) -> T:
        match self.to_int():
            case Some(n):
                return T.wrapping_from(n)
            case None:
                # Outside `int`'s range: exact in a type of 128 bits, which
                # `reflect` names (RULES.md, R115).
                if comptime reflect.name_of(T) == "i128":
                    return self
                if comptime reflect.name_of(T) == "u128":
                    return self.to_bits()
                let bits = self.to_bits()
                let high = ((bits >> 32u128) & 4294967295u128).to_int().expect("32 bits")
                let low = (bits & 4294967295u128).to_int().expect("32 bits")
                return T.wrapping_from(
                    int.from_bits((high.truncate_to[u64]() << 32u64) | low.truncate_to[u64]())
                )

# ------------------------------------------------------------------ checked arithmetic and fallible chains

# The checked arithmetic of the sized integers and `int`'s `checked_pow`
# (03: checked operations are spelled as methods, `.checked_add()`), and
# `Result.or_else`, `Iter.try_map` and `try_collect` (05, "Handling" and
# "Propagation"): written in Sisu, at the end of the prelude so that the
# lines of the functions before them do not move (stage 1's RULES.md,
# R137).

impl int:
    ## `self` to the power `exp` (not negative), or `None` where `pow`
    ## would overflow, as `num.checked_pow` gives it.
    ##
    ## ```
    ## assert 3.checked_pow(4) == Some(81)
    ## assert 2.checked_pow(63) == None
    ## ```
    pure def checked_pow(self, exp: int) -> int?:
        requires exp >= 0
        var result = 1
        var b = self
        var e = exp
        while e > 0:
            if e % 2 == 1:
                result = result.checked_mul(b)?
            e = e // 2
            if e > 0:
                b = b.checked_mul(b)?
        return Some(result)

impl u8:
    ## `self + other`, or `None` where it overflows `u8`.
    ##
    ## ```
    ## assert 200u8.checked_add(55u8) == Some(255u8)
    ## assert 200u8.checked_add(56u8) == None
    ## assert 3u8.checked_sub(4u8) == None
    ## assert 16u8.checked_mul(16u8) == None
    ## assert 2u8.checked_pow(7) == Some(128u8)
    ## ```
    pure def checked_add(self, other: u8) -> u8?:
        if other > u8.MAX - self:
            return None
        return Some(self + other)
    ## `self - other`, or `None` where it is below 0.
    pure def checked_sub(self, other: u8) -> u8?:
        if other > self:
            return None
        return Some(self - other)
    ## `self * other`, or `None` where it overflows `u8`.
    pure def checked_mul(self, other: u8) -> u8?:
        if self == 0u8 or other == 0u8:
            return Some(0u8)
        if other > u8.MAX // self:
            return None
        return Some(self * other)
    ## `self` to the power `exp` (not negative), or `None` where it
    ## overflows `u8`.
    pure def checked_pow(self, exp: int) -> u8?:
        requires exp >= 0
        var result = 1u8
        var b = self
        var e = exp
        while e > 0:
            if e % 2 == 1:
                result = result.checked_mul(b)?
            e = e // 2
            if e > 0:
                b = b.checked_mul(b)?
        return Some(result)

