impl i8:
    ## `self + other`, or `None` where it overflows `i8`.
    ##
    ## ```
    ## assert 100i8.checked_add(27i8) == Some(127i8)
    ## assert 100i8.checked_add(28i8) == None
    ## assert (-100i8).checked_sub(29i8) == None
    ## assert (-16i8).checked_mul(8i8) == Some(-128i8)
    ## assert (-2i8).checked_pow(7) == Some(-128i8)
    ## ```
    pure def checked_add(self, other: i8) -> i8?:
        if other > 0i8 and self > i8.MAX - other:
            return None
        if other < 0i8 and self < i8.MIN - other:
            return None
        return Some(self + other)
    ## `self - other`, or `None` where it overflows `i8`.
    pure def checked_sub(self, other: i8) -> i8?:
        if other < 0i8 and self > i8.MAX + other:
            return None
        if other > 0i8 and self < i8.MIN + other:
            return None
        return Some(self - other)
    ## `self * other`, or `None` where it overflows `i8`.
    pure def checked_mul(self, other: i8) -> i8?:
        if self == 0i8 or other == 0i8:
            return Some(0i8)
        # The least value has no magnitude of its own: only a factor of 1
        # keeps it.
        if self == i8.MIN or other == i8.MIN:
            let rest = if self == i8.MIN: other else: self
            if rest == 1i8:
                return Some(i8.MIN)
            return None
        let a = if self < 0i8: -self else: self
        let b = if other < 0i8: -other else: other
        # The largest magnitude `b` may multiply: one more below zero, which
        # reaches the least value, when `b` divides it.
        var bound = i8.MAX // b
        if (self < 0i8) != (other < 0i8) and i8.MAX % b == b - 1i8:
            bound += 1i8
        if a > bound:
            return None
        return Some(self * other)
    ## `self` to the power `exp` (not negative), or `None` where it
    ## overflows `i8`.
    pure def checked_pow(self, exp: int) -> i8?:
        requires exp >= 0
        var result = 1i8
        var b = self
        var e = exp
        while e > 0:
            if e % 2 == 1:
                result = result.checked_mul(b)?
            e = e // 2
            if e > 0:
                b = b.checked_mul(b)?
        return Some(result)

