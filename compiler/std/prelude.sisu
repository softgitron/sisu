impl[T, E] Result[T, E]:
    ## The value, or `f` of the error: the fallback that needs the error
    ## (05, "Handling").
    ##
    ## ```
    ## let lost: Result[int, String] = Err("lost".to_string())
    ## let length = lost.or_else(e -> e.byte_len())
    ## assert length == 4
    ## let found: Result[int, String] = Ok(7)
    ## let seven = found.or_else(e -> 0)
    ## assert seven == 7
    ## ```
    def or_else(own self, f: (E) -> T) -> T:
        if self.is_ok():
            return self.expect("a value")
        return f(self.err().expect("an error"))

impl[T] Iter[T]:
    ## `f` of each item, in a list, or the first error `f` gives, after which
    ## no item is taken: the map of a chain that can fail, since a `?` in a
    ## closure returns from the closure (05, "Propagation").
    ##
    ## ```
    ## let halves: Result[list[int], String] = [2, 4].iter().try_map(
    ##     n -> if n % 2 == 0: Ok(n // 2) else: Err("odd")
    ## )
    ## assert halves == Ok([1, 2])
    ## let odd: Result[list[int], String] = [2, 3].iter().try_map(
    ##     n -> if n % 2 == 0: Ok(n // 2) else: Err("odd")
    ## )
    ## assert odd.is_err()
    ## ```
    def try_map[U, E](own self, f: (T) -> Result[U, E]) -> Result[list[U], E]:
        var out: list[U] = []
        for x in self:
            match f(x):
                case Ok(v):
                    out.push(v)
                case Err(e):
                    return Err(e)
        return Ok(out)

impl[T, E] list[Result[T, E]]:
    ## The values of the results, in a list, or the first error among them:
    ## the collection of a chain that can fail (05, "Propagation").
    ##
    ## ```
    ## let all: list[Result[int, String]] = [Ok(4), Ok(5)]
    ## let values = all.try_collect()
    ## assert values == Ok([4, 5])
    ## let one: list[Result[int, String]] = [Ok(4), Err("lost"), Err("late")]
    ## let first = one.try_collect()
    ## assert first == Err("lost")
    ## ```
    pure def try_collect(own self) -> Result[list[T], E]:
        var out: list[T] = []
        for x in own self:
            if x.is_err():
                return Err(x.err().expect("an error"))
            out.push(x.expect("a value"))
        return Ok(out)

# `try_collect` after an adapter's `map` (05, "Propagation"; 11 puts it on
# the iterators), appended as R137's were (stage 1's RULES.md, R146).

impl[I: Iterator, T, E] Map[I, Result[T, E]]:
    ## The values the map gives, in a list, or the first error among them,
    ## after which no item is taken: the collection of a chain that can
    ## fail, `xs.iter().map(f).try_collect()`.
    ##
    ## ```
    ## let halves: Result[list[int], String] = [2, 4].iter().map(
    ##     n -> if n % 2 == 0: Ok(n // 2) else: Err("odd: {n}")
    ## ).try_collect()
    ## assert halves == Ok([1, 2])
    ## let odd: Result[list[int], String] = [2, 3, 5].iter().map(
    ##     n -> if n % 2 == 0: Ok(n // 2) else: Err("odd: {n}")
    ## ).try_collect()
    ## assert odd == Err("odd: 3")
    ## ```
    def try_collect(own self) -> Result[list[T], E]:
        var out: list[T] = []
        for x in self:
            if x.is_err():
                return Err(x.err().expect("an error"))
            out.push(x.expect("a value"))
        return Ok(out)

# The address-sized integers and `Sized` (03, "Numbers" and "Auto
# traits"), appended as R137's were (stage 1's RULES.md, R153).

## The signed integer as wide as an address, for foreign interfaces only
## (03: `int` is the index type everywhere else): on every target Sisu
## builds for now, an `i64`.
type ptrsize = i64

## The unsigned integer as wide as an address, for foreign interfaces only:
## on every target Sisu builds for now, a `u64`.
type uptrsize = u64

## Values whose size is known where they are held (03, "Auto traits"):
## every type but a `dyn` one, which is held behind `ref` or in a `Box`
## (`E0395`), so a bound `T: Sized` is met by every type argument.
@marker
trait Sized:
    pass
