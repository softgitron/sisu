## What a finished program left: its exit status and its output.
struct ProcOutput:
    status: int
    stdout: String
    stderr: String

## The operations of the process capability.
trait ProcOps:
    ## Runs `program` with `args` to its end, with no input. A blocking point.
    def run(self, program: str, args: list[str]) -> ProcOutput ! ProcError

impl ProcOps for Proc:
    @intrinsic("cap.forward")
    def run(self, program: str, args: list[str]) -> ProcOutput ! ProcError

impl Proc:
    @intrinsic("cap.lend")
    def lend(self) -> Lent[Proc]
    ## A fake that runs the programs named in `outputs`, each printing its
    ## text and exiting with status 0; any other program is `NotFound`.
    def fake(outputs: dict[str, str] = {}) -> Proc:
        return cap.FakeProc.new(outputs)

impl ProcOps for HostProc:
    @intrinsic("host.proc.run")
    def run(self, program: str, args: list[str]) -> ProcOutput ! ProcError

impl[T: ProcOps + Copy] ProcOps for Lent[T]:
    @intrinsic("cap.forward")
    def run(self, program: str, args: list[str]) -> ProcOutput ! ProcError

## The operations of the standard input capability.
trait StdinOps:
    ## The next line, without its line break; `None` at the end of the
    ## input. A blocking point.
    def read_line(self) -> String?

impl StdinOps for Stdin:
    @intrinsic("cap.forward")
    def read_line(self) -> String?

impl Stdin:
    @intrinsic("cap.lend")
    def lend(self) -> Lent[Stdin]
    ## A fake that gives these lines, then the end of the input (17).
    def fake(lines: list[str] = []) -> Stdin:
        return cap.FakeStdin.new(lines)

impl StdinOps for HostStdin:
    @intrinsic("host.stdin.read_line")
    def read_line(self) -> String?

impl[T: StdinOps + Copy] StdinOps for Lent[T]:
    @intrinsic("cap.forward")
    def read_line(self) -> String?

impl System:
    ## A test's capability set in one value (17, "Isolation and
    ## parallelism"): an empty in-memory `Fs`, a `Net` that reaches
    ## nothing, the run's test clock, `Rand.seeded(seed)`, an `Env` without
    ## arguments or variables, a `Proc` that runs nothing and an empty
    ## standard input. Each call makes a fresh set; a test that declares a
    ## `System` receives the real one instead.
    def fake(seed: int) -> System:
        return System.assemble(
            fs=Fs.in_memory(),
            net=cap.NoNet(),
            clock=Clock.fake(),
            rand=Rand.seeded(seed),
            env=Env.fake(),
            proc=Proc.fake(),
            stdin=Stdin.fake(),
        )
    ## The `sim` profile's system (17, "Simulation and replay"), which
    ## `sisu test --sim` gives a test that declares a `System`: a
    ## crash-consistent file system (`cap.SimFs`), an in-process network
    ## (`cap.SimNetwork`),
    ## the run's test clock, `Rand.seeded(seed)`, and fakes of the
    ## environment, processes and standard input.
    def sim(seed: int) -> System:
        return System.assemble(
            fs=cap.SimFs.new(),
            net=cap.SimNetwork.new(),
            clock=Clock.fake(),
            rand=Rand.seeded(seed),
            env=Env.fake(),
            proc=Proc.fake(),
            stdin=Stdin.fake(),
        )
    @internal
    @intrinsic("System.assemble")
    def assemble(
        own fs: Fs,
        own net: Net,
        own clock: Clock,
        own rand: Rand,
        own env: Env,
        own proc: Proc,
        own stdin: Stdin,
    ) -> System

## What a transcript test's runs of `main` share (17, "Snapshots and
## transcripts"): an in-memory `Fs` holding the transcript's fixture
## files, a clock frozen at the epoch, and `Rand.seeded(0)`; each `$` line
## runs with these and its own arguments and standard input.
struct TranscriptWorld:
    fs: Fs
    clock: Clock
    rand: Rand

@internal
def transcript_world(own files: list[(str, str)]) -> TranscriptWorld:
    var d: dict[str, str] = dict()
    for path, text in files:
        _ = d.insert(path, text)
    return TranscriptWorld(
        fs=Fs.in_memory(d), clock=Clock.frozen_at(DateTime.epoch()), rand=Rand.seeded(0)
    )

@internal
def transcript_system(
    own world: TranscriptWorld, own args: list[str], own stdin: list[str]
) -> System:
    return System.assemble(
        fs=world.fs,
        net=cap.NoNet(),
        clock=world.clock,
        rand=world.rand,
        env=Env.fake(args),
        proc=Proc.fake(),
        stdin=Stdin.fake(stdin),
    )

## The revoker of a caretaker (`Fs.revocable`): a `Copy` handle on the
## flag every copy of the caretaker checks.
@derive(Copy)
struct Revoker:
    flag: Cap[Mutex[bool]]

impl Revoker:
    pure def new() -> Revoker:
        return Revoker(flag=Cap(Mutex(False)))
    ## Every copy of the caretaker fails with `Revoked` from now on.
    def revoke(self):
        var g = self.flag.get().lock()
        g.value = True
    def is_revoked(self) -> bool:
        return self.flag.get().lock().value

impl[T] Cap[T]:
    @intrinsic("Cap.new")
    pure def new(own value: T) -> Cap[T]
    ## The shared value.
    @intrinsic("Cap.get")
    pure def get(self) -> ref T

impl[T] Debug for Cap[T]:
    @intrinsic("structural.debug")
    pure def fmt_debug(self, mut f: Formatter)

impl[T] Debug for Lent[T]:
    @intrinsic("structural.debug")
    pure def fmt_debug(self, mut f: Formatter)

# ------------------------------------------------------------------ the traits of the builtin types
# The leaf types (`int`, `f64`, `f32`, `bool`, `char`, `str`, `String`,
# `Path`, `DateTime`, `()`) and tuples of up to six elements implement
# `Display`, `Debug`, `Eq`, `PartialOrd`, `Ord` and `Hash` (the floats
# neither of the last two) in the generated module
# `<std>/builtin_impls.sisu` (see
# compiler/crates/sisu-resolve/src/std_sources.rs), with the intrinsics
# `structural.*`, whose contracts are written there.

impl[T: Debug] Debug for list[T]:
    pure def fmt_debug(self, mut f: Formatter):
        f.write("[")
        f.depth += 1
        var first = True
        for x in self:
            if not first:
                f.write(", ")
            first = False
            x.fmt_debug(mut f)
        f.depth -= 1
        f.write("]")

impl[T: Debug] Display for list[T]:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl[T: Eq] Eq for list[T]:
    pure def eq(self, other: list[T]) -> bool:
        if len(self) != len(other):
            return False
        for i in range(len(self)):
            if self[i] != other[i]:
                return False
        return True

impl[T: PartialOrd] PartialOrd for list[T]:
    pure def partial_cmp(self, other: list[T]) -> Ordering?:
        var i = 0
        while i < len(self) and i < len(other):
            let c = self[i].partial_cmp(other[i])
            if c != Some(Equal):
                return c
            i += 1
        return Some(len(self).cmp(len(other)))

impl[T: Ord] Ord for list[T]:
    pure def cmp(self, other: list[T]) -> Ordering:
        var i = 0
        while i < len(self) and i < len(other):
            let c = self[i].cmp(other[i])
            if c != Equal:
                return c
            i += 1
        return len(self).cmp(len(other))

impl[T: Hash] Hash for list[T]:
    pure def hash(self, mut h: Hasher):
        h.write_int(len(self))
        for x in self:
            x.hash(mut h)

impl[T] Len for list[T]:
    @intrinsic("len")
    pure def len(self) -> int

impl[T: Eq] Contains[T] for list[T]:
    pure def contains(self, x: T) -> bool:
        for v in self:
            if v == x:
                return True
        return False

impl[T: Debug, const N: int] Debug for Array[T, N]:
    pure def fmt_debug(self, mut f: Formatter):
        f.write("[")
        f.depth += 1
        for i in range(N):
            if i > 0:
                f.write(", ")
            self[i].fmt_debug(mut f)
        f.depth -= 1
        f.write("]")

impl[T: Debug, const N: int] Display for Array[T, N]:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl[T: Eq, const N: int] Eq for Array[T, N]:
    pure def eq(self, other: Array[T, N]) -> bool:
        for i in range(N):
            if self[i] != other[i]:
                return False
        return True

impl[T: Hash, const N: int] Hash for Array[T, N]:
    pure def hash(self, mut h: Hasher):
        for i in range(N):
            self[i].hash(mut h)

impl[T, const N: int] Len for Array[T, N]:
    pure def len(self) -> int:
        return N

impl[T: Debug] Debug for set[T]:
    pure def fmt_debug(self, mut f: Formatter):
        if len(self) == 0:
            f.write("set()")
            return
        f.write("{{")
        f.depth += 1
        var first = True
        for x in self:
            if not first:
                f.write(", ")
            first = False
            x.fmt_debug(mut f)
        f.depth -= 1
        f.write("}}")

impl[T: Debug] Display for set[T]:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl[T: Hash] Eq for set[T]:
    pure def eq(self, other: set[T]) -> bool:
        if len(self) != len(other):
            return False
        for x in self:
            if not other.contains(x):
                return False
        return True

impl[T] Len for set[T]:
    @intrinsic("len")
    pure def len(self) -> int

impl[T: Hash] Contains[T] for set[T]:
    pure def contains(self, x: T) -> bool:
        return x in self

impl[K: Debug, V: Debug] Debug for dict[K, V]:
    pure def fmt_debug(self, mut f: Formatter):
        f.write("{{")
        f.depth += 1
        var first = True
        for k, v in self:
            if not first:
                f.write(", ")
            first = False
            k.fmt_debug(mut f)
            f.write(": ")
            v.fmt_debug(mut f)
        f.depth -= 1
        f.write("}}")

impl[K: Debug, V: Debug] Display for dict[K, V]:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl[K: Hash, V: Eq] Eq for dict[K, V]:
    pure def eq(self, other: dict[K, V]) -> bool:
        if len(self) != len(other):
            return False
        for k, v in self:
            let Some(w) = other.get(k) else:
                return False
            if v != w:
                return False
        return True

impl[K, V] Len for dict[K, V]:
    @intrinsic("len")
    pure def len(self) -> int

impl[K: Hash, V] Contains[K] for dict[K, V]:
    pure def contains(self, key: K) -> bool:
        return key in self

impl[T: Debug] Display for T?:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl[T: Debug, E: Debug] Display for Result[T, E]:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl Display for Ordering:
    pure def fmt(self, mut f: Formatter):
        self.fmt_debug(mut f)

impl[T: Debug] Debug for Box[T]:
    pure def fmt_debug(self, mut f: Formatter):
        self.boxed.fmt_debug(mut f)

impl[T: Display] Display for Box[T]:
    pure def fmt(self, mut f: Formatter):
        self.boxed.fmt(mut f)

impl[T] Iterator for Iter[T]:
    type Item = T
    @intrinsic("Iter.next")
    @keeps(self)
    pure def next(mut self) -> T?

impl[T] Debug for Iter[T]:
    @intrinsic("structural.debug")
    pure def fmt_debug(self, mut f: Formatter)

impl[T] Display for Iter[T]:
    @intrinsic("structural.display")
    pure def fmt(self, mut f: Formatter)

impl[K, V] Debug for Entry[K, V]:
    @intrinsic("structural.debug")
    pure def fmt_debug(self, mut f: Formatter)

impl FromLiteral[str] for String:
    @intrinsic("str.to_string")
    pure def from_literal(literal: str) -> String

impl FromLiteral[str] for Path:
