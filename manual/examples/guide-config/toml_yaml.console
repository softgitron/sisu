$ sisu eval services.sisu --to toml
REGION = "eu-north"
SERVICES = [{ name = "web", port = 8080, replicas = 3, tier = "Free" }, { name = "api", port = 9000, replicas = 1, tier = { Paid = { seats = 40 } } }]
$ sisu eval services.sisu --to yaml
REGION: "eu-north"
SERVICES:
  - name: "web"
    port: 8080
    replicas: 3
    tier: "Free"
  - name: "api"
    port: 9000
    replicas: 1
    tier:
      Paid:
        seats: 40
