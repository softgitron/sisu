# The constant read through a type, whose impl gives its value.
trait Stove:
    const MAX_HEAT: int

struct WoodStove:
    logs: int

impl Stove for WoodStove:
    const MAX_HEAT: int = 110

def hottest[T: Stove](stove: T) -> int:
    return T.MAX_HEAT

def main():
    print("{WoodStove.MAX_HEAT} {hottest(WoodStove(4))}")
