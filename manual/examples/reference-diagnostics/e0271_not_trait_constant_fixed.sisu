# The impl names the trait's constant as the trait spells it.
trait Stove:
    const MAX_HEAT: int
    const WARM_UP: int = 30

struct WoodStove:
    logs: int

impl Stove for WoodStove:
    const MAX_HEAT: int = 110
    const WARM_UP: int = 60

def main():
    print("{WoodStove.MAX_HEAT} {WoodStove.WARM_UP}")
