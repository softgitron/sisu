# A type parameter bounded by the trait.
trait Priced:
    def price(self) -> int

struct Bun:
    filling: String

impl Priced for Bun:
    def price(self) -> int:
        return 280

def show[T: Priced](item: T) -> String:
    return "{item.price()} cents"

def main():
    print(show(Bun("cardamom")))
