# Counts the vowels of three words, a task for each.

## The number of vowels in `word`.
def vowels(word: str) -> int:
    var n = 0
    for c in word.chars():
        if c in ['a', 'e', 'i', 'o', 'u', 'y', 'ä', 'ö']:
            n += 1
    return n

def main() -> ! TaskError:
    let words = ["sauna", "löyly", "vihta"]
    let counts = task.scope do s:
        let handles = [s.spawn(() -> vowels(w)) for w in words]
        var out: list[int] = []
        for h in handles:
            out.push(h.join()?)
        return Ok(out)
    print(counts?)
    return Ok(())
