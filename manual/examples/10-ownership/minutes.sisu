# A function that only reads a list borrows it.
struct Song:
    title: String
    seconds: int

def minutes(songs: list[Song]) -> int:
    return sum([song.seconds for song in songs]) // 60

def main():
    let songs = [Song("Northern Lights", 245), Song("Lake Song", 187)]
    print("{minutes(songs)} minutes:")
    for song in songs:
        print("  {song.title}")
