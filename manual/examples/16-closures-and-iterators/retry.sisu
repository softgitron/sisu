# A trailing `do` block is a closure whose body is a block.
def retry(times: int, attempt: (int) -> bool) -> bool:
    for n in range(1, times + 1):
        if attempt(n):
            return True
    return False

def main():
    let ok = retry(3) do n:
        print("attempt {n}")
        return n == 2
    print("succeeded: {ok}")
    var total = 0
    let found = retry(5) do n:
        total += n
        return total > 100
    print("{found} after adding up to {total}")
