# A generator gives its items with `yield`, one each time it is asked.
def fibonacci() -> Iter[int]:
    var a = 0
    var b = 1
    while True:
        yield a
        a, b = b, a + b

def main():
    print(fibonacci().take(10).collect())
    print(fibonacci().filter(it % 2 == 0).take(4).collect())
    for f in fibonacci():
        if f > 1000:
            print("the first above 1000 is {f}")
            break
