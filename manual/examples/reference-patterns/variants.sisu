# Variant patterns take apart unit, tuple and record variants.
enum Shape:
    Dot
    Circle(f64)
    Rect(w: f64, h: f64)

def area(shape: Shape) -> f64:
    return match shape:
        case Dot: 0.0
        case Circle(r): 3.0 * r * r
        case Rect(w, h): w * h

def main():
    for shape in [Dot, Circle(1.0), Rect(w=2.0, h=3.0)]:
        print(area(shape))
