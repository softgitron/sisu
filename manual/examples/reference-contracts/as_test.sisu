# `sisu test` checks each function's contract on cases it makes.
def clamp(n: int, low: int, high: int) -> int:
    requires low <= high
    ensures low <= result <= high
    if n < low:
        return low
    if n > high:
        return high
    return n

test "clamps from above":
    assert clamp(30, 0, 24) == 24
