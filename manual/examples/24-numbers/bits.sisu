# Bits: and, or, exclusive or, not, and the shifts.
const READ: u8 = 0b100
const WRITE: u8 = 0b010
const RUN: u8 = 0b001

def main():
    let mode = READ | WRITE
    print("{mode:03b} {(mode & WRITE) != 0} {(mode & RUN) != 0}")
    print("{mode ^ WRITE:03b} {~mode:08b}")
    let colour: u32 = 0xFF8800
    let byte = 8
    print("{colour >> 16} {(colour >> byte) & 0xFF} {colour & 0xFF}")
