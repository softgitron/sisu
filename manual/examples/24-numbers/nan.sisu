# NaN is equal to nothing, itself included, and has no order.
def main():
    let nan = 0.0 / 0.0
    print("{nan == nan} {nan < 1.0} {nan >= 1.0} {nan.is_nan()}")
    print("{1.0 / 0.0} {-1.0 / 0.0}")
    var temps = [21.5, 19.0, 23.25]
    temps.sort_by((a, b) -> a.cmp(b))
    print(temps)
    temps.push(nan)
    temps.sort_by((a, b) -> a.cmp(b))
    print(temps)
