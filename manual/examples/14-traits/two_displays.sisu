# Two impls of one trait for one type.
struct Money:
    cents: int

impl Display for Money:
    def fmt(self, mut f: Formatter):
        f.write("{self.cents // 100},{self.cents % 100:02} €")

impl Display for Money:
    def fmt(self, mut f: Formatter):
        f.write("€{self.cents // 100}.{self.cents % 100:02}")

def main():
    print(Money(1250))
