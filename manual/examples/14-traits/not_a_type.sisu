# A trait named where a type goes.
trait Priced:
    def price(self) -> int

struct Coffee:
    cups: int

struct Bun:
    filling: String

impl Priced for Coffee:
    def price(self) -> int:
        return 350 * self.cups

impl Priced for Bun:
    def price(self) -> int:
        return 280

def together(a: Priced, b: Priced) -> int:
    return a.price() + b.price()

def main():
    let coffee = Coffee(2)
    let bun = Bun("cardamom")
    print("coffee {coffee.price()}, bun {bun.price()}")
    print("together {together(coffee, bun)} cents")
