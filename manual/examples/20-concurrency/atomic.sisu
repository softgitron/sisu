# An `Atomic` changes without a lock; a `task.Once` runs a function once.
def main():
    let bathers = Atomic(0)
    let heating = task.Once()
    task.scope do s:
        for _ in range(5):
            s.spawn do:
                heating.call_once(() -> print("the stove is lit, once"))
                _ = bathers.fetch_add(1)
    print("{bathers.load()} bathers")
