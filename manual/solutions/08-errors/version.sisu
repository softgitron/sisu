##! Exercise 8.4, a version number: the solution.
##!
##! Each way the text can be wrong gets its own `return Err(...)`, in
##! the order the tests need: an empty text before the count of parts,
##! and the count before the numbers. `number` turns a part into an
##! `int` or a `NotANumber`, so that `?` can pass the error on.

error VersionError:
    Empty
    WrongCount(found: int)
    NotANumber(part: String)

@derive(Copy, Eq, Ord)
struct Version:
    major: int
    minor: int
    patch: int

## The version that `text` spells; spaces around it do not count.
def parse_version(text: str) -> Version ! VersionError:
    let trimmed = text.trim()
    if trimmed.is_empty():
        return Err(Empty)
    let parts = [part for part in trimmed.split(".")]
    if len(parts) != 3:
        return Err(WrongCount(len(parts)))
    return Ok(Version(number(parts[0])?, number(parts[1])?, number(parts[2])?))

## `part` as a number, or the error that says it is not one.
def number(part: str) -> int ! VersionError:
    let n = part.parse_int() else:
        return Err(NotANumber(part.to_string()))
    return Ok(n)

test "versions":
    assert parse_version("2.10.1") == Ok(Version(2, 10, 1))
    assert parse_version(" 0.9.0 ") == Ok(Version(0, 9, 0))

test "an empty text":
    assert parse_version("") == Err(Empty)
    assert parse_version("   ") == Err(Empty)

test "the wrong number of parts":
    assert parse_version("1.2") == Err(WrongCount(2))
    assert parse_version("1.2.3.4") == Err(WrongCount(4))

test "a part that is not a number":
    assert parse_version("1.x.3") == Err(NotANumber("x"))
    assert parse_version("1..3") == Err(NotANumber(""))

test "versions in order":
    let older = parse_version("1.9.0").or(Version(0, 0, 0))
    let newer = parse_version("1.10.0").or(Version(0, 0, 0))
    assert older < newer
