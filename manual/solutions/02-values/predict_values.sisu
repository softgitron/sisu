##! Exercise 2.1, predict the values: the solution.
##!
##! `//` rounds down, towards minus infinity, so -3.4 becomes -4, and
##! `%` takes the sign of the divisor, so that `(a // b) * b + a % b`
##! is `a`.
##! `**` groups from the right: `2 ** 3 ** 2` is `2 ** 9`. Neither 0.1
##! nor 0.2 is exact in binary floating point, and their sum is
##! 0.30000000000000004. A chain holds when every pair in it holds, and
##! `5 <= 4` does not. `not` applies to the whole comparison after it.
##! `+%` wraps at the width of `u8`: 300 is 256 + 44.

const QUOTIENT: int = -4
const REMAINDER: int = 3
const POWER: int = 512
const EXACT: bool = False
const CHAIN: bool = False
const NEGATION: bool = True
const WRAPPED: u8 = 44

test "floor division of a negative number":
    assert (-17) // 5 == QUOTIENT

test "the remainder of a negative number":
    assert (-17) % 5 == REMAINDER

test "a power of a power":
    assert 2 ** 3 ** 2 == POWER

test "adding tenths":
    assert (0.1 + 0.2 == 0.3) == EXACT

test "a chain of comparisons":
    assert (1 < 5 <= 4) == CHAIN

test "what `not` applies to":
    assert (not 2 + 2 == 5) == NEGATION

test "wrapping a byte":
    assert 200u8 +% 100 == WRAPPED
