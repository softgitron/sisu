# The same work as speed.py: price N generated orders with discounts, in
# whole cents, and print a checksum that must match Python's.

pure def run(n: int) -> int:
    var x = 42
    var total = 0
    for _ in range(n):
        x = (x * 1103515245 + 12345) % 2147483648
        let quantity = x % 7 + 1
        let price = x // 7 % 5000 + 99
        let discount = x // 35000 % 4 * 5
        let gross = quantity * price
        let net = gross - gross * discount // 100
        total = (total * 31 + net) % 1000000007
    return total

def main(sys: System):
    let args = sys.env.args()
    let n = if len(args) > 0: args[0].parse_int() ?? 5000000 else: 5000000
    print("checksum {run(n)}")
